<?xml version="1.0"?>

<!DOCTYPE project [
    <!--
      Entity "common" identifies the file containing the common ant elements
      needed both here and in subproject build.xml files.  Ant elements other
      than property are NOT inherited when ant calls itself for a subproject.

      The file common.xml is a collection of common targets useful to all
      subprojects.
    -->
    <!ENTITY common SYSTEM "file:../../common.xml">
]>

<project name="junit" default="compile">

    <description>
        Unit Tests designed to test the CDB.
    </description>


    <!--
        Establish a reference to the project root directory.
      -->
    <property name="projectRoot" location="../.."/>

    <!--
        This property is set by CVS checkout -r ...
        It is used for distribution build purposes.
    -->
    <property name="stickyTag" value="$$Name:  $$"/>

    <!-- base properties -->
    <property name="build" value="build"/>

    <property name="buildJavaDoc" value="${build}/javadoc"/>
    <property name="buildClasses" value="${build}/classes"/>
    <property name="junitReportDir" value="junit_report"/>
    <property name="testDbDir" value="testDbDir"/>
    <property name="build.sysclasspath" value="ignore"/>
    <property name="jdbcDir" location="${projectRoot}/common/pgjdbc"/>
    <property name="cdbCommonsDir" location="${projectRoot}/common/cdb-commons"/>
    <property name="cdbCommonsBuild" value="${build}"/>
    <property name="log4jDir" value="${cdbCommonsDir}/lib"/>
    <property name="cdbLoaderDir" location="${projectRoot}/cdb-loader"/>
    <property name="cdbLoaderLib" location="${cdbLoaderDir}/lib"/>
    <property name="cdbLoaderBuild" value="${build}"/>


    <!--
        Insert common properties and targets.
        The common targets are generally called from the init target.
      -->
    &common;

    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="init"
            depends="-init,-setCCompiler,-setMake">

        <mkdir  dir="${build}"/>

        <!-- Locations for generated Java sources, and Java classes. -->
        <mkdir dir="${buildJavaDoc}"/>
        <mkdir dir="${buildClasses}"/>



        <path id="test.class.path">
            <pathelement location="${buildClasses}"/>


            <fileset dir="${jdbcDir}">
                <include name="postgres-jdbc3.jar"/>
            </fileset>

            <fileset dir="${cdbCommonsDir}/${cdbCommonsBuild}">
                <include name="cdb-commons.jar"/>
            </fileset>

            <fileset dir="${toolsLib}">
                <include name="junit.jar"/>
            </fileset>

            <fileset dir="${log4jDir}">
                 <include name="log4j-1.2.9.jar"/>
             </fileset>

             <fileset dir="${cdbLoaderLib}">
                 <include name="antlrall.jar"/>
                 <include name="concurrent.jar"/>
             </fileset>


            <fileset dir="${cdbLoaderDir}/${cdbLoaderBuild}">
                 <include name="cdb-loader.jar"/>
             </fileset>


        </path>

        <echo level="info">
            ========================================================================

            Building Junit for ${releaseTag}

            ========================================================================
        </echo>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="clean" description="cleans up build and results">
        <delete dir="${junitReportDir}"/>
        <delete dir="${buildJavaDoc}"/>
        <delete dir="${buildClasses}"/>
        <delete failonerror="false">
            <fileset dir="${build}">
                <or>
                    <filename name="*.jar"/>
                    <filename name="*.so"/>
                </or>
            </fileset>
        </delete>
    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="compile"
            depends="init,compileJava"
            description="Performs all code-gen and compilation steps." />


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Performs Java source compilation.                              -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="compileJava"
            depends="init,-makeCDBCommons,-makeCDBLoader">

        <!-- Build Java code. -->
        <javac srcdir="src"
               destdir="${buildClasses}"
               target="1.4"
               includeAntRuntime="no"
               debug="yes"
               failonerror="yes">

            <classpath refid="test.class.path"/>

            <exclude name="native/**"/>
            <exclude name="**/doc-files/**"/>
            <include name="**/*.java"/>
        </javac>

        <!-- Copy over other necessary resources. -->
        <copy todir="${buildClasses}" preservelastmodified="true">
            <fileset dir="src">
                <include name="**/*.properties"/>
            </fileset>

        </copy>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Generate common pgutils routine libraries                          -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-makeCDBCommons"
            depends="init"
            unless="pgUtilsDone">

        <!-- Invoke ANT recursively to make the common subproject -->
        <ant antfile="build.xml"
             dir="${projectRoot}/common/cdb-commons"
             target="package">
            <property name="build" value="${cdbCommonsBuild}"/>
            <!-- omit passing "releaseX" variables here -->
        </ant>

        <property name="pgUtilsDone" value="true"/>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Generate cdb-loader jar                          -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-makeCDBLoader"
            depends="init"
            unless="cdbLoaderDone">

        <!-- Invoke ANT recursively to make the common subproject -->
        <ant antfile="build.xml"
             dir="${projectRoot}/cdb-loader"
             target="package">
            <property name="build" value="${cdbLoaderBuild}"/>
            <!-- omit passing "releaseX" variables here -->
        </ant>

        <property name="cdbLoaderDone" value="true"/>

    </target>

    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Run test-cases                                                 -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="adminschema"
            depends="init,compile"
            description="Run the Admin schema test-cases.">

        <mkdir dir="${junitReportDir}"/>


        <!-- Setup some properties -->
        <property name="metapa.cdb.pg_inst_dir" value="${testDbDir}"/>
        <property name="metapa.cdb.pg_inst_port" value="5000"/>
        <property name="metapa.cdb.pg_opts" value="-i -N 8 -B 16 -c cdb_session_role=utility"/>
        <property name="metapa.cdb.pg_user" value="${user.name}"/>
        <property name="metapa.cdb.pg_dbname" value="test1"/>


        <echo>Creating and starting a CDB Segment Database</echo>
        <java classname="com.metapa.commons.pgutils.StandUpDb" classpathref="test.class.path" >
            <sysproperty key="metapa.cdb.pg_inst_dir" value="${metapa.cdb.pg_inst_dir}"/>
            <sysproperty key="metapa.cdb.pg_inst_port" value="${metapa.cdb.pg_inst_port}"/>
            <sysproperty key="metapa.cdb.pg_opts" value="${metapa.cdb.pg_opts}"/>
            <sysproperty key="metapa.cdb.pg_user" value="${metapa.cdb.pg_user}"/>
            <sysproperty key="metapa.cdb.pg_dbname" value="${metapa.cdb.pg_dbname}"/>
        </java>


        <junit fork="true" printsummary="true">
            <classpath refid="test.class.path"/>

            <jvmarg value="-Dmetapa.cdb.pg_inst_dir=${metapa.cdb.pg_inst_dir}" />
            <jvmarg value="-Dmetapa.cdb.pg_inst_port=${metapa.cdb.pg_inst_port}" />
            <jvmarg value="-Dmetapa.cdb.pg_opts=${metapa.cdb.pg_opts}" />
            <jvmarg value="-Dmetapa.cdb.pg_user=${metapa.cdb.pg_user}" />
            <jvmarg value="-Dmetapa.cdb.pg_dbname=${metapa.cdb.pg_dbname}" />

            <formatter type="plain"/>

            <batchtest todir="${junitReportDir}">
                <fileset dir="${buildClasses}">
                    <include name="**/Test*.class"/>
                </fileset>
            </batchtest>
        </junit>

        <echo>Teardown and Cleanup Segment Database</echo>
        <java classname="com.metapa.commons.pgutils.StopDb" classpathref="test.class.path" >
            <sysproperty key="metapa.cdb.pg_inst_dir" value="${metapa.cdb.pg_inst_dir}"/>
            <sysproperty key="metapa.cdb.pg_inst_port" value="${metapa.cdb.pg_inst_port}"/>
            <sysproperty key="metapa.cdb.pg_opts" value="${metapa.cdb.pg_opts}"/>
            <sysproperty key="metapa.cdb.pg_user" value="${metapa.cdb.pg_user}"/>
            <sysproperty key="metapa.cdb.pg_dbname" value="${metapa.cdb.pg_dbname}"/>
        </java>
        <delete dir="${testDbDir}"/>
    </target>

    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Run Cdb-Loader test-cases                                                 -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="cdbloader"
            depends="init,compile"
            description="Run the test-cases.">

        <property name="cdbLoaderTestsDir" value="src/com/metapa/test/loader"/>

        <mkdir dir="${junitReportDir}"/>

        <!-- get loader test properties -->
        <property file="${cdbLoaderTestsDir}/test.properties" prefix="test."/>
        <script language="beanshell"><![CDATA[
            /**
             * Adds project properties beginning "test.*" to each junit
             * task in this target as system properties (including the
             * "test." prefix.
             */

            import org.apache.tools.ant.taskdefs.optional.junit.JUnitTask;
            import org.apache.tools.ant.types.Environment;
            import org.apache.tools.ant.Task;
            import org.apache.tools.ant.Project;

            ArrayList propList = new ArrayList();
            for ( Iterator it = project.getProperties().entrySet().iterator(); it.hasNext(); )
            {
                Map.Entry entry = (Map.Entry) it.next();
                String key = entry.getKey();
                if ( key.startsWith("test.") )
                {
                    Environment.Variable ev = new Environment.Variable();
                    ev.setKey(key.substring(5));
                    ev.setValue(entry.getValue());
                    propList.add(ev);
                }
            }
            Environment.Variable[] props = propList.toArray(new Environment.Variable[propList.size()]);
            propList = null;

            Task[] tasks = self.getOwningTarget().getTasks();
            for ( int i = 0; i < tasks.length; i++ )
            {
                if ( tasks[i] instanceof JUnitTask )
                {
                    JUnitTask task = (JUnitTask) tasks[i];
                    for ( int j = 0; j < props.length; j++ )
                    {
                        task.addSysproperty(props[j]);
                        self.log("Adding " + props[j].getKey() + "=" + props[j].getValue()
                                + " to task " + task.getTaskName() + " in " + task.getLocation().toString(),
                                Project.MSG_DEBUG);
                    }
                }
            }
            ]]>
        </script>


        <junit fork="true" printsummary="true">
            <classpath refid="test.class.path"/>

            <formatter type="plain"/>

            <batchtest todir="${junitReportDir}">
                <fileset dir="${buildClasses}">
                    <include name="**/*Test.class"/>
                </fileset>
            </batchtest>
        </junit>

        <echo>IMPORTANT NOTE: If any of the above tests FAILED, please make sure that you followed</echo>
        <echo>all the instructions in README.txt. This is necessary until cluster creation and configuration will be automated.</echo>
    </target>

</project>
