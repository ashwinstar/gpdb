<?xml version="1.0" ?>
<!-- The include attribute can be a test-config file to reuse -->
<test-config name="Test Suite for cdb2" include="/testconfig.xml">    
	<!-- Logger configuration file -->    
	<logger configFile="log4j.properties" />
	<nodes>
		<node name="cdb2-dispatch" type="cdbDispatcherNode" class="com.metapa.cdbunit.nodes.CDBHeadNode">
			<params>
				<param name="host" value="127.0.0.1"/>
				<param name="port" value="10000"/>
				<param name="dbname" value="cdbunit0"/>
				<param name="username" value="cdb2"/>
				<param name="password" value=""/>
			</params>
		</node>
		<node name="raw-db" type="pgsql" class="com.metapa.cdbunit.nodes.PostgreSqlNode">
			<params>
				<param name="host" value="127.0.0.1"/>
				<param name="port" value="5432"/>
				<param name="dbname" value="cdbunit"/>
				<param name="username" value="postgres"/>
				<param name="password" value=""/>
			</params>
		</node>
	</nodes>
	<pre-nodes>
		<exec cmd="/opt/damagecontrol/work/cdb2/checkout/scripts/nightly/nightly.sh"/>
	</pre-nodes>    
	<pre-test>    
	</pre-test>    
	<post-test>    
	</post-test>  
</test-config>