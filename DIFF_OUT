+void
+ExecCdbTraceNode(PlanState *node, bool entry, TupleTableSlot *result)
+{
+	bool willReScan = FALSE;
+	bool willReturnTuple = FALSE;
+	Plan *plan = NULL;
+	const char *nameTag = NULL;
+	const char *extraTag = "";
+	char extraTagBuffer[20];
