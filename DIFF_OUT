+					break;
+				case EOL_CRNL:
+					appendStringInfo(&line_buf, "%s", "\r\n");
+					break;
+				case EOL_UNKNOWN:
+				default:
+					ereport(ERROR,
+							(errcode(ERRCODE_CDB_INTERNAL_ERROR),
+							 errmsg("Unresolved EOL for COPY when trying to send data line to segment databases.")));
