+	pfree(values);
+	pfree(nulls);
+
+	pfree(in_functions);
+	pfree(typioparams);
+	pfree(defmap);
+	pfree(defexprs);
+	pfree(constraintexprs);
+	pfree(force_notnull);
+
+	ExecDropTupleTable(tupleTable, true);
+
+	ExecCloseIndices(resultRelInfo);
+
+	FreeExecutorState(estate);
+}
