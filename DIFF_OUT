+static int
+FastCopyGetData(void *databuf, int datasize)
+{
+	size_t bytesread = 0;
+	
+	switch (copy_dest)
+	{
+		case COPY_FILE:
+			bytesread = fread(databuf, 1, datasize, copy_file);
+			if (feof(copy_file))
