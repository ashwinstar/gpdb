+			
+			if (defexpr != NULL)
+			{
+				defexprs[num_defaults] = ExecPrepareExpr((Expr *) defexpr,
+														 estate);
+				defmap[num_defaults] = attnum - 1;
+				num_defaults++;
+			}
+		}
