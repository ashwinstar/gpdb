<?xml version="1.0"?>

<!--

    build.xml


    @version $Id$

-->

<!DOCTYPE project [
  <!--
      Entity "common" identifies the file containing the common ant elements 
      needed both here and in subproject build.xml files.  Ant elements other 
      than property are NOT inherited when ant calls itself for a subproject.

      The file common.xml is a collection of common targets useful to all
      subprojects.
    -->
  <!ENTITY common SYSTEM "file:./common.xml">
]>

<project name="cdb"
         default="compile">

    <description>
  CDB Project

      -Dport=&lt;default_port&gt; can be specified to configure PostgreSQL.
      The default port is set to 10000.

      Use -DinstallRoot=&lt;install_path&gt; to designate an installation target
      other than $HOME/cdb.

      Use -Dcdb.enableDtx=true to include distributed transactions in the build.
      (A "distclean" is required for this configuration-change to take effect.)

      Use -Dcdb.enableInsert=true to include the insert-hook in the build
      (A "distclean" is required for this configuration-change to take effect.)
    </description>

    <!--
        Establish a reference to the project root directory.
      -->
    <property name="projectRoot" value="${basedir}"/>
  
    <!-- this property is set by CVS checkout -r ...
         It is used for distribution build purposes.
      -->
    <!-- <property name="stickyTag" value="$$Name:  $$"/> -->
    <property name="stickyTag" value="$$Name:  $$"/>

    <!-- base properties -->
    <property name="dist" value="dist"/>

    <property name="build.sysclasspath" value="ignore"/>

    <!--
        Insert common properties and targets.  
        The common targets are generally called from the init target.
      -->
    &common;


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="init"
            depends="-init,-setMake,-setCCompiler">

        <!-- base properties -->
        <property name="build" value="build"/>
        <property name="buildJavaDoc" value="${build}/javadoc"/>

        <path id="doc.class.path">

            <!-- All the jars files we can find -->
            <fileset dir=".">
                <include name="**/*.jar"/>
            </fileset>

            <pathelement location="${cdbCommonsBuild}/cdb-commons.jar"/>
            <pathelement location="${cdbMgmtBuild}/classes"/>
            <pathelement location="${cdbLoaderBuild}/classes"/>

            <!-- toolsLib is set up in common.xml -->
            <fileset dir="${toolsLib}">
                <include name="junit.jar"/>
                <include name="ydoc.jar"/>
                <include name="class2svg.jar"/>
                <include name="styleed.jar"/>
            </fileset>

            <pathelement location="${tools}/ydoc-2.1_05/resources"/>
        </path>

        <echo level="info">
========================================================================

Building CDB for ${releaseTag}
    into release-directory ${releaseDir}

Using tools=${tools}
Using toolsLib=${toolsLib}

========================================================================
        </echo>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Ensure that all required command line options are provided.    -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-checkOptions">

        <fail unless="port" message="Variable port must be set (use -Dport=&lt;port&gt;)"/>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Perform a distribution-level clean of the project.             -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="distclean"
            depends="init"
            description="Clean the project of distribution and build materials">

        <delete dir="${dist}"/>

        <!-- Perform a "regular" cleaning ... -->
        <antcall target="clean"/>
            
        <!-- Scrub configure and build output from the postgresql subproject. -->
        <ant antfile="build.xml"
             dir="cdb-pg"
             target="distclean">
        </ant>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Perform a build-level cleaning of the project                  -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="clean"
            depends="init"
            description="Clean the project of build materials">

        <!-- Remove build output from the postgresql subproject. -->
        <ant antfile="build.xml"
             dir="cdb-pg"
             target="clean">
        </ant>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Compile the CDB subprojects                                    -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="compile"
            depends="init"
            description="Compile all subprojects of CDB">

        <!--
            Build PostgreSQL
          -->
        <ant antfile="build.xml"
             dir="cdb-pg"
             target="compile">
        </ant>

        <!--
            Build common subproject
          -->
        <ant antfile="build.xml"
             dir="common/cdb-commons"
             target="package">
        </ant>


        <!--
            Build commands subproject
          -->
        <ant antfile="build.xml"
             dir="cdb-loader"
             target="package">
            <property name="build" value="build"/>
            <property name="commonDone" value="true"/>
            <property name="jdbcDone" value="true"/>
        </ant>


    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Generate the CDB documentation.                                -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="makeDoc"
            depends="init,apidoc"
            description="Generate product documentation (requires special tools)">

        <!--
            Build PostgreSQL documentation
          -->
        <ant antfile="build.xml"
             dir="cdb-pg"
             target="makeDoc">
        </ant>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Create the javadocs                                            -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="apidoc"
        depends="init, -makeCDBManagement, -makeCDBLoader"
        description="Generate the javadocs">

        <javadoc
            destdir="${buildJavaDoc}"
            author="true"
            additionalparam="-breakiterator"
            bottom="Copyright (c) 2004 - 2005 Metapa, Inc. All Rights Reserved."
            verbose="no"
            docletpathref="doc.class.path"
            classpathref="doc.class.path">

            <sourcepath>
                <pathelement location="cdb-management/src" />
                <pathelement location="common/cdb-commons/src" />
                <pathelement location="cdb-loader/src" />
            </sourcepath>

            <package name="com.metapa.*" />

            <doclet name="ydoc.doclets.YStandard">
                <param name="-generic"/>
                <param name="-umlautogen"/>
                <param name="-tag" value="pre"/>
                <param name="-tag" value="post"/>
                <param name="-tag" value="design"/>
                <param name="-tag" value="param"/>
                <param name="-tag" value="return"/>
                <param name="-tag" value="see"/>
                <param name="-tag" value="todo"/>
            </doclet>
        </javadoc>
    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Install CDB for development testing                            -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="install"
            depends="init,-checkDevoInstall,distclean,compile"
            description="Install CDB for development testing">

        <!--
            Call install subroutine with "dist" set for
            distribution build.
          -->


        <antcall target="-install">
            <param name="target" value="install"/>
            <param name="Idist" value=""/>
            <param name="IcdbdocDir" location="${installRoot}/cdb-pgsql/docs"/>
            <param name="IcdbjreDir" location="${installRoot}/cdb-pgsql/jre"/>
            <param name="IcdbbinDir" location="${installRoot}/cdb-pgsql/bin"/>
            <param name="IcdbmanDir" location="${installRoot}/cdb-pgsql/man"/>
            <param name="IcdbserverDir" location="${installRoot}/cdb-pgsql/server"/>
            <param name="IcdbtoolsDir" location="${installRoot}/cdb-pgsql/tools"/>
            <param name="IcdbdemoDir" location="${installRoot}/cdb-pgsql/demo"/>
            <param name="IcdbclientDir" location="${installRoot}/cdb-client"/>
        </antcall>

    </target>

    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Install CDB for development testing                            -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="build-pgsql"
            depends="init,-checkDevoInstall"
            description="Install CDB for development testing">

        <!--
            Call install subroutine with "dist" set for
            distribution build.
          -->


        <antcall target="-install">
            <param name="target" value="build-pgsql"/>
            <param name="Idist" value=""/>
            <param name="IcdbdocDir" location="${installRoot}/cdb-pgsql/docs"/>
            <param name="IcdbjreDir" location="${installRoot}/cdb-pgsql/jre"/>
            <param name="IcdbbinDir" location="${installRoot}/cdb-pgsql/bin"/>
            <param name="IcdbmanDir" location="${installRoot}/cdb-pgsql/man"/>
            <param name="IcdbserverDir" location="${installRoot}/cdb-pgsql/server"/>
            <param name="IcdbtoolsDir" location="${installRoot}/cdb-pgsql/tools"/>
            <param name="IcdbdemoDir" location="${installRoot}/cdb-pgsql/demo"/>
            <param name="IcdbclientDir" location="${installRoot}/cdb-client"/>
        </antcall>

    </target>

    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Perform Postgres 8.0 regression testing                        -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="pgsql-check"
            description="Perform Postgres 8.0 regression testing">

        <!--
            Call install subroutine with "dist" set for
            distribution build.
          -->
        <antcall target="-pgsql-check">
            <param name="target" value="pgsql-check"/>
        </antcall>

    </target>

    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Fail install if *not* performing a development install.        -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-checkDevoInstall"
            depends="-init"
            unless="devoBuild">
        <fail>
The "install" target is allowed for devo builds only.  Use the
"dist" target to prepare distribution builds.
        </fail>
    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Perform a distribution build.                                  -->
    <!--                                                                -->
    <!-- The result of this target is a tarball in the ${dist}          -->
    <!-- directory.                                                     -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="dist"
            depends="init,-installRootWarning,distclean,compile,makeDoc"
            description="Prepare a distribution package for CDB">

        <mkdir dir="${dist}"/>

        <!--
            Call install subroutine with "dist" set for
            distribution build.
          -->
        <antcall target="-install">
            <param name="target" value="installWithDoc"/>
            <param name="Idist" location="${dist}"/>
            <param name="IcdbdocDir" location="${installRoot}/cdb-pgsql-${releaseDir}/docs"/>
            <param name="IcdbjreDir" location="${installRoot}/cdb-pgsql-${releaseDir}/jre"/>
            <param name="IcdbbinDir" location="${installRoot}/cdb-pgsql-${releaseDir}/bin"/>
            <param name="IcdbmanDir" location="${installRoot}/cdb-pgsql-${releaseDir}/man"/>
            <param name="IcdbserverDir" location="${installRoot}/cdb-pgsql-${releaseDir}/server"/>
            <param name="IcdbtoolsDir" location="${installRoot}/cdb-pgsql-${releaseDir}/tools"/>
            <param name="IcdbdemoDir" location="${installRoot}/cdb-pgsql-${releaseDir}/demo"/>
            <param name="IcdbclientDir" location="${installRoot}/cdb-client"/>
        </antcall>


        <!--
            Create a tarball for distribution
          -->
        <tar destfile="${dist}/cdb-${releaseDir}.tar.bz2"
             compression="bzip2">
            <tarfileset dir="${dist}" username="cdb" group="cdb">
                <or>
                    <filename name="**/bin/*" negate="true"/>
                    <filename name="**/bin/*.sql"/>
                </or>
            </tarfileset>
            <tarfileset dir="${dist}" username="cdb" group="cdb" mode="755">
                <and>
                    <filename name="**/bin/*"/>
                    <filename name="**/bin/*.sql" negate="true"/>
                </and>
            </tarfileset>
        </tar>

    </target>

    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Issue a message warning of use of default installRoot if       -->
    <!-- we're not producing a development build.                       -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-installRootWarning"
            depends="-init"
            if="installRootDefaulted"
            unless="devoBuild">
        <echo level="warning">
            *************************************************************************

            -DinstallRoot=&lt;install_target_directory&gt; was not specified!  
            
            This build is not suitable for customer installations.

            *************************************************************************
            
        </echo>
        <input/>
    </target>

    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Perform installation tasks (common with dist and devo install) -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-pgsql-check">

        <!--
            Build and "install" PostgreSQL
          -->
        <ant antfile="build.xml"
             dir="cdb-pg"
             target="${target}">
            <property name="DESTDIR" value="${Idist}"/>
        </ant>
    </target>

    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Perform installation tasks (common with dist and devo install) -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-install">

        <delete dir="${installRoot}/cdb-pgsql"/>

        <!--
            Build and "install" PostgreSQL
          -->

        <ant antfile="build.xml"
             dir="cdb-pg"
             target="${target}">
            <property name="DESTDIR" value="${Idist}"/>
        </ant>

        <mkdir dir="${IcdbdocDir}"/>
        <mkdir dir="${IcdbjreDir}"/>
        <mkdir dir="${IcdbmanDir}"/>

        <mkdir dir="${IcdbtoolsDir}"/>
        <mkdir dir="${IcdbtoolsDir}/management"/>
        <mkdir dir="${IcdbtoolsDir}/scripts"/>

        <mkdir dir="${IcdbdemoDir}"/>

        <symlink link="cdb-pgsql" resource="${installRoot}/cdb-pgsql"/>
        <symlink link="cdb-pgsql/bin" resource="server/bin"/>
        <symlink action="delete" link="cdb-pgsql"/> 
<!--
        <move todir="${IcdbserverDir}">
          <fileset dir="${installRoot}/cdb-pgsql/server"/>
        </move>

        <delete dir="${installRoot}/cdb-pgsql"/>
        <symlink link="cdb-pgsql" resource="${installRoot}/cdb-pgsql-${releaseDir}"/>
        <symlink link="cdb-pgsql/bin" resource="server/bin"/>
        <symlink link="metapa" resource="${installRoot}"/>
        <symlink link="metapa/cdb-pgsql" resource="cdb-pgsql-${releaseDir}"/>
        <symlink action="delete" link="cdb-pgsql"/> 
        <symlink action="delete" link="metapa"/>

-->

        <!-- Set LD_LIBRARY_PATH -->
        <junit fork="yes">
          <sysproperty key="LD_LIBRARY_PATH" value="${installRoot}/cdb-pgsql/lib"/>
        </junit>

        <!--
            Created directories for the CDB Client
          -->

        <mkdir dir="${IcdbclientDir}"/> 
        <mkdir dir="${IcdbclientDir}/docs"/> 
        <mkdir dir="${IcdbclientDir}/bin"/> 
        <mkdir dir="${IcdbclientDir}/jre"/> 

        <!--
            Copy the necessary JAR files for the CDB-Loader
          -->

        <mkdir dir="${IcdbclientDir}/cdb-loader"/> 
        <mkdir dir="${IcdbclientDir}/cdb-loader/bin"/> 
        <mkdir dir="${IcdbclientDir}/cdb-loader/lib"/> 
        <mkdir dir="${IcdbclientDir}/cdb-loader/conf"/> 

        <copy todir="${IcdbclientDir}/cdb-loader/bin"
              preservelastmodified="true">
            <fileset dir="cdb-loader/bin">
              <or>
                 <filename name="loader.sh"/>
              </or>
            </fileset>
        </copy>

        <copy todir="${IcdbclientDir}/cdb-loader/conf"
              preservelastmodified="true">
            <fileset dir="cdb-loader/conf">
              <or>
                 <filename name="*.properties"/>
              </or>
            </fileset>
        </copy>

        <copy todir="${IcdbclientDir}/cdb-loader/lib"
              preservelastmodified="true">
            <fileset dir="common/cdb-commons/build">
                <or>
                    <filename name="cdb-commons.jar"/>
                </or>
            </fileset>
            <fileset dir="common/cdb-commons/lib">
                <or>
                    <filename name="log4j*.jar"/>
                </or>
            </fileset>
            <fileset dir="cdb-loader/lib">
                <or>
                    <filename name="antlrall.jar"/>
                    <filename name="concurrent.jar"/>
                </or>
            </fileset>
            <fileset dir="cdb-loader/build">
                <or>
                    <filename name="cdb-loader.jar"/>
                    <filename name="libloader.so"/>
                    <filename name="libloader.jnilib"/>
                </or>
            </fileset>
        </copy>

        <!--
