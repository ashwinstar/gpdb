            Copy (generated) jar files to mgmt library directory
          -->
        <!--
        <copy todir="${ImgmtDir}/lib"
              preservelastmodified="true">
            <fileset dir="mgmt/build">
                <or>
                    <filename name="cdb-mgmt.jar"/>
                    <filename name="cdb-agent.jar"/>
                </or>
            </fileset>
        </copy>
        -->

        <!--
            Copy command executables
          -->
        <!--
        <copy todir="${ImgmtDir}/bin"
              preservelastmodified="true">
            <fileset dir="mgmt">
                <or>
