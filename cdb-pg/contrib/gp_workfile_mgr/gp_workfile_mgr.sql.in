-- Adjust this setting to control where the objects get created.
\set WORKFILE_SCHEMA workfile

CREATE SCHEMA :WORKFILE_SCHEMA;

SET search_path = :WORKFILE_SCHEMA;
BEGIN;

-- Register the functions.
     
CREATE OR REPLACE FUNCTION gp_workfile_entries()
RETURNS SETOF record
AS 'MODULE_PATHNAME', 'gp_workfile_mgr_cache_entries'
LANGUAGE C IMMUTABLE;

CREATE VIEW gp_workfile_entries AS
    SELECT C.*
          FROM gp_toolkit.__gp_localid, gp_workfile_entries() AS C (
            segid int, 
            path text, 
            hash int, 
            size bigint, 
            utility int, 
            state int, 
            workmem int,
            optype text, 
            slice int,
            sessionid int, 
            commandid int
          )
    UNION ALL
    SELECT C.*
          FROM gp_toolkit.__gp_masterid, gp_workfile_entries() AS C (
            segid int, 
            path text, 
            hash int, 
            size bigint, 
            utility int, 
            state int, 
            workmem int,
            optype text, 
            slice int,
            sessionid int, 
            commandid int
          );


CREATE OR REPLACE FUNCTION gp_workfile_cache_clear_f(content int)
    RETURNS SETOF int
AS 'MODULE_PATHNAME', 'gp_workfile_mgr_clear_cache' LANGUAGE C IMMUTABLE;

CREATE FUNCTION gp_workfile_cache_clear_segment(content int)
RETURNS SETOF int
AS
$$
 SELECT C.* FROM gp_toolkit.__gp_localid, gp_workfile_cache_clear_f($1) as C
 UNION ALL
 SELECT C.* FROM gp_toolkit.__gp_masterid, gp_workfile_cache_clear_f($1) as C;
$$
LANGUAGE SQL;

CREATE FUNCTION gp_workfile_cache_clear()
RETURNS SETOF int
AS
$$
  SELECT * from gp_workfile_cache_clear_segment(-2)
$$
LANGUAGE SQL; 

CREATE OR REPLACE FUNCTION gp_workfile_mgr_test(testname text)
RETURNS setof bool
AS 'MODULE_PATHNAME', 'gp_workfile_mgr_test_harness_wrapper' LANGUAGE C IMMUTABLE;

CREATE FUNCTION gp_workfile_mgr_test_allsegs(testname text)
RETURNS SETOF BOOL
AS
$$
 SELECT C.* FROM gp_toolkit.__gp_localid, gp_workfile_mgr_test($1) as C
 UNION ALL
 SELECT C.* FROM gp_toolkit.__gp_masterid, gp_workfile_mgr_test($1) as C;
$$
LANGUAGE SQL;


CREATE OR REPLACE FUNCTION gp_workfile_usage_per_segment_f()
    RETURNS record
AS 'MODULE_PATHNAME', 'gp_workfile_mgr_used_diskspace' LANGUAGE C IMMUTABLE;

CREATE VIEW gp_workfile_usage_per_segment AS
 SELECT C.* FROM gp_toolkit.__gp_localid as id, gp_workfile_usage_per_segment_f() as C (segid int, bytes bigint)
 UNION ALL
 SELECT C.* FROM gp_toolkit.__gp_masterid as id, gp_workfile_usage_per_segment_f() as C  (segid int, bytes bigint);

CREATE VIEW gp_workfile_usage_per_query AS
SELECT dbname, username, sessionid, commandid, segid, sum(size) AS size 
FROM gp_workfile_entries 
GROUP BY (sessionid, commandid, dbname, username, segid);

COMMIT;
