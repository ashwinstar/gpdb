-- Adjust this setting to control where the objects get created.
SET search_path = public;


-- Register the functions.
CREATE OR REPLACE FUNCTION gp_workfile_mgr_cache_stats()
RETURNS SETOF RECORD
AS 'MODULE_PATHNAME', 'gp_workfile_mgr_cache_stats'
LANGUAGE C IMMUTABLE;

create view gp_workfile_mgr_cache_stats AS
    select C.* from gp_toolkit.__gp_localid, gp_workfile_mgr_cache_stats() as C (
       cachename text,
       segno int,
       
       lookups int, 
       inserts int, 
       evicts int, 
    
       hits int, 
       compares int, 
       
       pinnedentries int, 
       cachedentries int, 
       deletedentries int, 
       acquiredentries int, 
       freeentries int, 
       
       totalsize bigint,
       
       entriesscanned int, 
       maxentriesscanned int, 
       wraparound int, 
       maxwraparound int, 
       
       timeinserts bigint, 
       timelookups bigint, 
       timeevicts bigint, 
       maxtimeinsert bigint,
       maxtimelookup bigint, 
       maxtimeevict bigint 
    )
    
    UNION ALL
     select C.* from gp_toolkit.__gp_masterid, gp_workfile_mgr_cache_stats() as C (
       cachename text,
       segno int,
       
       lookups int, 
       inserts int, 
       evicts int, 
    
       hits int, 
       compares int, 
       
       pinnedentries int, 
       cachedentries int, 
       deletedentries int, 
       acquiredentries int, 
       freeentries int, 
       
       totalsize bigint,
       
       entriesscanned int, 
       maxentriesscanned int, 
       wraparound int, 
       maxwraparound int, 
       
       timeinserts bigint, 
       timelookups bigint, 
       timeevicts bigint, 
       maxtimeinsert bigint,
       maxtimelookup bigint, 
       maxtimeevict bigint 
    );
        

CREATE OR REPLACE FUNCTION gp_workfile_mgr_cache_entries()
RETURNS SETOF record
AS 'MODULE_PATHNAME', 'gp_workfile_mgr_cache_entries'
LANGUAGE C IMMUTABLE;

CREATE VIEW gp_workfile_mgr_cache_entries AS
    SELECT C.*
          FROM gp_toolkit.__gp_localid, gp_workfile_mgr_cache_entries() AS C (
            segid int, 
            path text, 
            hash int, 
            size bigint, 
            utility int, 
            state int, 
            workmem int,
            optype text, 
            slice int,
            sessionid int, 
            commandid int,
            dbname text, 
            username text, 
            sessionstart timestamptz
          )
    UNION ALL
    SELECT C.*
          FROM gp_toolkit.__gp_masterid, gp_workfile_mgr_cache_entries() AS C (
            segid int, 
            path text, 
            hash int, 
            size bigint, 
            utility int, 
            state int, 
            workmem int,
            optype text, 
            slice int,
            sessionid int, 
            commandid int,
            dbname text, 
            username text,
            sessionstart timestamptz  
          );


CREATE OR REPLACE FUNCTION gp_workfile_mgr_clear()
    RETURNS int
AS 'MODULE_PATHNAME', 'gp_workfile_mgr_clear_cache' LANGUAGE C IMMUTABLE;

CREATE FUNCTION gp_workfile_mgr_clear_allsegs()
RETURNS SETOF int
AS
$$
 SELECT C.* FROM gp_toolkit.__gp_localid, gp_workfile_mgr_clear() as C
 UNION ALL
 SELECT C.* FROM gp_toolkit.__gp_masterid, gp_workfile_mgr_clear() as C;
$$
LANGUAGE SQL;


CREATE OR REPLACE FUNCTION gp_workfile_mgr_test(testname text)
RETURNS setof bool
AS 'MODULE_PATHNAME', 'gp_workfile_mgr_test_harness_wrapper' LANGUAGE C IMMUTABLE;

CREATE FUNCTION gp_workfile_mgr_test_allsegs(testname text)
RETURNS SETOF BOOL
AS
$$
 SELECT C.* FROM gp_toolkit.__gp_localid, gp_workfile_mgr_test($1) as C
 UNION ALL
 SELECT C.* FROM gp_toolkit.__gp_masterid, gp_workfile_mgr_test($1) as C;
$$
LANGUAGE SQL;


CREATE OR REPLACE FUNCTION gp_workfile_mgr_used_diskspace()
    RETURNS record
AS 'MODULE_PATHNAME', 'gp_workfile_mgr_used_diskspace' LANGUAGE C IMMUTABLE;

CREATE VIEW gp_workfile_mgr_diskspace AS
 SELECT C.* FROM gp_toolkit.__gp_localid as id, gp_workfile_mgr_used_diskspace() as C (segid int, bytes bigint)
 UNION ALL
 SELECT C.* FROM gp_toolkit.__gp_masterid as id, gp_workfile_mgr_used_diskspace() as C  (segid int, bytes bigint);

    
