
-- Drop aggregates
drop aggregate if exists sum(int2[]) cascade;
drop aggregate if exists sum(int4[]) cascade;
drop aggregate if exists sum(int8[]) cascade;
drop aggregate if exists sum(float8[]) cascade;

drop aggregate if exists pivot_sum(text[], text, int4) cascade;
drop aggregate if exists pivot_sum(text[], text, int8) cascade;
drop aggregate if exists pivot_sum(text[], text, float8) cascade;

drop aggregate if exists mregr_coef(float8, float8[]) cascade;
drop aggregate if exists mregr_R2(float8, float8[]) cascade;
drop aggregate if exists nb_classify(text[], int8[], int8[]) cascade;

drop aggregate if exists array_accum(anyelement) cascade;

-- Drop functions
drop function if exists matrix_transpose(anyarray) cascade;

drop function if exists matrix_multiply(int2[], int2[]) cascade;
drop function if exists matrix_multiply(int4[], int4[]) cascade;
drop function if exists matrix_multiply(int8[], int8[]) cascade;
drop function if exists matrix_multiply(float8[], float8[]) cascade;

drop function if exists matrix_multiply(int8[], int8) cascade;
drop function if exists matrix_multiply(float8[], float8) cascade;

drop function if exists matrix_add(int2[],int2[]) cascade;
drop function if exists matrix_add(int4[],int4[]) cascade;
drop function if exists matrix_add(int8[],int2[]) cascade;
drop function if exists matrix_add(int8[],int4[]) cascade;
drop function if exists matrix_add(int8[],int8[]) cascade;
drop function if exists matrix_add(float8[],float8[]) cascade;

drop function if exists unpivot(float8[], text[]) cascade;
drop function if exists unpivot(int4[], text[]) cascade;
drop function if exists unpivot(text[], text[]) cascade;

drop function if exists pivot_accum(int4[], text[], text, int4) cascade;
drop function if exists pivot_accum(int8[], text[], text, int8) cascade;
drop function if exists pivot_accum(float8[], text[], text, float8) cascade;

drop function if exists nb_classify_accum(nb_classification_type, text[], int8[], int8[]) cascade;
drop function if exists nb_classify_combine(nb_classification_type, nb_classification_type) cascade;
drop function if exists nb_classify_final(nb_classification_type) cascade;

-- drop types
drop type if exists unpivot_record_float8 cascade;
drop type if exists unpivot_record_int4 cascade;
drop type if exists unpivot_record_text cascade;
drop type if exists nb_classification_type cascade;