drop aggregate sum(int8[]) cascade;

drop aggregate pivot_sum(text[], text, int4) cascade;
drop aggregate pivot_sum(text[], text, int8) cascade;
drop aggregate pivot_sum(text[], text, float8) cascade;

drop aggregate array_accum(anyelement) cascade;

drop function matrix_transpose(anyarray) cascade;

drop function matrix_multiply(int2[], int2[]) cascade;
drop function matrix_multiply(int4[], int4[]) cascade;
drop function matrix_multiply(int8[], int8[]) cascade;
drop function matrix_multiply(float8[], float8[]) cascade;

drop function matrix_multiply(int8[], int8) cascade;

drop function matrix_add(int4[],int4[]) cascade;
drop function matrix_add(int8[],int8[]) cascade;
drop function matrix_add(float8[],float8[]) cascade;

drop function unpivot(float8[], text[]) cascade;
drop function unpivot(int4[], text[]) cascade;

drop function pivot_accum(int4[], text[], text, int4) cascade;
drop function pivot_accum(int8[], text[], text, int8) cascade;
drop function pivot_accum(float8[], text[], text, float8) cascade;

drop function regr_R(float8[], float8[]) cascade;
drop function regr_R2(float8[], float8[]) cascade;

drop type unpivot_record_float8 cascade;
drop type unpivot_record_int4 cascade;



--
--  MATRIX_TRANSPOSE
--
create or replace function matrix_transpose(anyarray) returns anyarray as
'MODULE_PATHNAME', 'matrix_transpose' LANGUAGE C
IMMUTABLE STRICT;


--
--  MATRIX_MULTIPLY  M x N
--

create or replace function matrix_multiply(int2[],int2[]) returns int2[] as
'MODULE_PATHNAME', 'matrix_multiply' LANGUAGE C
IMMUTABLE STRICT;

create or replace function matrix_multiply(int4[],int4[]) returns int4[] as
'MODULE_PATHNAME', 'matrix_multiply' LANGUAGE C
IMMUTABLE STRICT;

create or replace function matrix_multiply(int8[],int8[]) returns int8[] as
'MODULE_PATHNAME', 'matrix_multiply' LANGUAGE C
IMMUTABLE STRICT;

create or replace function matrix_multiply(float8[],float8[]) returns float8[] as
'MODULE_PATHNAME', 'matrix_multiply' LANGUAGE C
IMMUTABLE STRICT;


--
--  MATRIX_MULTIPLY  M x s
--
create or replace function matrix_multiply(int8[],int8) returns int8[] as
'MODULE_PATHNAME', 'int8_matrix_smultiply' LANGUAGE C
IMMUTABLE STRICT;


--
--  addition over arrays
--
create or replace function matrix_add(int4[],int4[]) returns int4[] as
'MODULE_PATHNAME', 'int4_matrix_add' LANGUAGE C IMMUTABLE;
create or replace function matrix_add(int8[],int8[]) returns int8[] as
'MODULE_PATHNAME', 'int8_matrix_add' LANGUAGE C IMMUTABLE;
create or replace function matrix_add(float8[],float8[]) returns float8[] as
'MODULE_PATHNAME', 'float8_matrix_add' LANGUAGE C IMMUTABLE;
create aggregate sum(int8[]) ( 
   sfunc = matrix_add, prefunc = matrix_add, stype = int8[]
);



--
--  UNPIVOT (values[], labels[])
--
create type unpivot_record_float8 as (attr text, attr_value float8);
create or replace function unpivot(float8[],text[]) returns setof unpivot_record_float8 
as '
  SELECT $2[i] as attr, $1[i] as attr_value 
  FROM generate_series(array_lower($1,1),array_upper($1,1)) x(i)
' language 'sql' STRICT IMMUTABLE;

create type unpivot_record_int4 as (attr text, attr_value int4);
create or replace function unpivot(int4[],text[]) returns setof unpivot_record_int4 
as '
  SELECT $2[i] as attr, $1[i] as attr_value 
  FROM generate_series(array_lower($1,1),array_upper($1,1)) x(i)
' language 'sql' STRICT IMMUTABLE;


--
-- PIVOT (labels[], label, sum(value))
--
create or replace function pivot_accum(int4[], text[], text, int4) 
returns int4[] as
'MODULE_PATHNAME', 'int4_pivot_accum' language C;
create or replace function pivot_accum(int8[], text[], text, int8) 
returns int8[] as
'MODULE_PATHNAME', 'int8_pivot_accum' language C;
create or replace function pivot_accum(float8[], text[], text, float8) 
returns float8[] as
'MODULE_PATHNAME', 'float8_pivot_accum' language C;
create aggregate pivot_sum(text[], text, int4) (
  sfunc = pivot_accum,
  stype = int4[],
  prefunc = matrix_add
);
create aggregate pivot_sum(text[], text, int8) (
  sfunc = pivot_accum,
  stype = int8[],
  prefunc = matrix_add
);
create aggregate pivot_sum(text[], text, float8) (
  sfunc = pivot_accum,
  stype = float8[],
  prefunc = matrix_add
);




--
--  regr_R - Multiple Linear Regression finalizer
--
create or replace function regr_R(float8[],float8[]) returns float8[] as '
  library(corpcor)    # get pseudoinverse
  return(as.vector(pseudoinverse(arg1) %*% t(arg2)))
' language 'plr';

create or replace function regr_R2(float8[],float8[]) returns float8[] as '
  slicerange = function (x2) { 
    return((max(c(-Inf,x2), na.rm=TRUE) - 
            min(c(Inf,x2), na.rm=TRUE)) > 0.0000000001)
  }
  findkeep = function(X) { 
    r = nrow(X)              # assume input is a square array
    keep = rep(TRUE,r)       # initialze to keep everything
    for (i in seq(1:(r-1)))  # loop through every row
      if (keep[i])           # if keeping this row remove rows that are multiples
        keep[(i+1):r] = (keep & apply(X/X[i,],2,slicerange))[(i+1):r]
    return(keep)
  }
  reassemble = function(k,b) {
    r = c(); j = 1                  # initialize
    for (i in seq(1,length(k))) {   # for everything in our result
      if (k[i]) {                   # if we kept this variable
         r = append(r,b[j])         #   extract from beta
         j = j+1
      } else { r = append(r,NA) }   # otherwise add a NULL
    }
    return(r)
  }
  A = arg1
  b = arg2
  keep = findkeep(A)
  beta = solve(A[keep,keep]) %*% b[keep]
  return(reassemble(keep,beta))
' language 'plr';

--
-- Array accumulator
--
create aggregate array_accum(anyelement) (
  sfunc = array_append,
  stype = anyarray,
  initcond = '{}'
);

