--
--  addition over arrays
--
create or replace function matrix_add(int2[],int2[]) returns int2[] as
'MODULE_PATHNAME', 'matrix_add' LANGUAGE C IMMUTABLE;
create or replace function matrix_add(int2[],int4[]) returns int4[] as
'MODULE_PATHNAME', 'matrix_add' LANGUAGE C IMMUTABLE;
create or replace function matrix_add(int2[],int8[]) returns int8[] as
'MODULE_PATHNAME', 'matrix_add' LANGUAGE C IMMUTABLE;
create or replace function matrix_add(int4[],int2[]) returns int4[] as
'MODULE_PATHNAME', 'matrix_add' LANGUAGE C IMMUTABLE;
create or replace function matrix_add(int4[],int4[]) returns int4[] as
'MODULE_PATHNAME', 'matrix_add' LANGUAGE C IMMUTABLE;
create or replace function matrix_add(int4[],int8[]) returns int8[] as
'MODULE_PATHNAME', 'matrix_add' LANGUAGE C IMMUTABLE;
create or replace function matrix_add(int8[],int2[]) returns int8[] as
'MODULE_PATHNAME', 'matrix_add' LANGUAGE C IMMUTABLE;
create or replace function matrix_add(int8[],int4[]) returns int8[] as
'MODULE_PATHNAME', 'matrix_add' LANGUAGE C IMMUTABLE;
create or replace function matrix_add(int8[],int8[]) returns int8[] as
'MODULE_PATHNAME', 'matrix_add' LANGUAGE C IMMUTABLE;
create or replace function matrix_add(float4[],float4[]) returns float4[] as
'MODULE_PATHNAME', 'matrix_add' LANGUAGE C IMMUTABLE;
create or replace function matrix_add(float8[],float8[]) returns float8[] as
'MODULE_PATHNAME', 'matrix_add' LANGUAGE C IMMUTABLE;
create aggregate sum(int2[]) (
   sfunc = matrix_add, prefunc = matrix_add, stype = int8[]
);
create aggregate sum(int4[]) (
   sfunc = matrix_add, prefunc = matrix_add, stype = int8[]
);
create aggregate sum(int8[]) ( 
   sfunc = matrix_add, prefunc = matrix_add, stype = int8[]
);
create aggregate sum(float8[]) ( 
   sfunc = matrix_add, prefunc = matrix_add, stype = float8[]
);


--
-- pseudoinverse
--
create or replace function pinv(float8[]) returns float8[] as
'MODULE_PATHNAME', 'pseudoinverse' LANGUAGE C STRICT IMMUTABLE;

--
--  UNPIVOT (values[], labels[])
--
create type unpivot_record_float8 as (attr text, attr_value float8);
create or replace function unpivot(float8[],text[]) returns setof unpivot_record_float8 
as '
  SELECT $2[i] as attr, $1[i] as attr_value 
  FROM generate_series(array_lower($1,1),array_upper($1,1)) x(i)
' language 'sql' STRICT IMMUTABLE;

create type unpivot_record_int4 as (attr text, attr_value int4);
create or replace function unpivot(int4[],text[]) returns setof unpivot_record_int4 
as '
  SELECT $2[i] as attr, $1[i] as attr_value 
  FROM generate_series(array_lower($1,1),array_upper($1,1)) x(i)
' language 'sql' STRICT IMMUTABLE;

create type unpivot_record_text as (attr text, attr_value text);
create or replace function unpivot(text[], text[]) returns setof unpivot_record_text
as 'MODULE_PATHNAME', 'text_text_unpivot' language C strict immutable;


--
-- PIVOT (labels[], label, sum(value))
--
create or replace function pivot_accum(int4[], text[], text, int4) 
returns int4[] as
'MODULE_PATHNAME', 'int4_pivot_accum' language C;
create or replace function pivot_accum(int8[], text[], text, int8) 
returns int8[] as
'MODULE_PATHNAME', 'int8_pivot_accum' language C;
create or replace function pivot_accum(float8[], text[], text, float8) 
returns float8[] as
'MODULE_PATHNAME', 'float8_pivot_accum' language C;
create aggregate pivot_sum(text[], text, int4) (
  sfunc = pivot_accum,
  stype = int4[],
  prefunc = matrix_add
);
create aggregate pivot_sum(text[], text, int8) (
  sfunc = pivot_accum,
  stype = int8[],
  prefunc = matrix_add
);
create aggregate pivot_sum(text[], text, float8) (
  sfunc = pivot_accum,
  stype = float8[],
  prefunc = matrix_add
);



--
--  Multiple Linear Regression, finalizers handled in PL/R
--
CREATE LANGUAGE plr;

create or replace function float8_mregr_accum(float8[], float8, float8[]) returns float8[] as
'MODULE_PATHNAME', 'float8_mregr_accum' language C
STRICT IMMUTABLE;

create or replace function float8_mregr_combine(float8[], float8[]) returns float8[] as
'MODULE_PATHNAME', 'float8_mregr_combine' language C
STRICT IMMUTABLE;

create or replace function float8_mregr_coef(float8[]) returns float8[] as '
  library(corpcor)               # get pseudoinverse
  if (length(arg1) < 6)
	return(NULL)
  len = arg1[1]
  b = arg1[5:(4+len)]
  X = arg1[(5+len):length(arg1)]
  dim(X) = c(len,len)
  return(as.vector(pseudoinverse(X) %*% b))
' language 'plr'
STRICT IMMUTABLE;

create or replace function float8_mregr_r2(float8[]) returns float8 as '
  library(corpcor)    # get pseudoinverse
  if (length(arg1) < 6)
	return(NULL)
  len = arg1[1]
  c   = arg1[2]
  sy  = arg1[3]
  syy = arg1[4]
  b   = arg1[5:(4+len)]
  X   = arg1[(5+len):length(arg1)]
  dim(X) = c(len,len)
  coef = as.vector(pseudoinverse(X) %*% b)
  ssr  = (coef %*% b) - sy*sy/c
  tss  = syy - sy*sy/c
  return(ssr/tss)
' language 'plr'
STRICT IMMUTABLE;

create aggregate mregr_coef(float8, float8[]) (
  stype     = float8[],
  initcond  = '{0}',
  sfunc     = float8_mregr_accum,
  prefunc   = float8_mregr_combine,
  finalfunc = float8_mregr_coef
);

create aggregate mregr_r2(float8, float8[]) (
  stype     = float8[],
  initcond  = '{0}',
  sfunc     = float8_mregr_accum,
  prefunc   = float8_mregr_combine,
  finalfunc = float8_mregr_r2
);


--
-- Naive Bayes Classifier
--
create type nb_classification_type as (classes text[], accum float8[], apriori int8[]);

create or replace function nb_classify_accum(
  state       nb_classification_type, 
  classes     text[], 
  attr_count  int8, 
  class_count int8[], 
  apriori     int8[]) returns nb_classification_type
as 'MODULE_PATHNAME', 'nb_classify_accum' LANGUAGE C IMMUTABLE;

create or replace function nb_classify_combine(
  state1      nb_classification_type, 
  state2      nb_classification_type) returns nb_classification_type
as 'MODULE_PATHNAME', 'nb_classify_combine' LANGUAGE C IMMUTABLE;

create or replace function nb_classify_final(nb_classification_type) returns text
as 'MODULE_PATHNAME', 'nb_classify_final' LANGUAGE C IMMUTABLE STRICT;

create aggregate nb_classify(text[], int8, int8[], int8[]) (
  stype     = nb_classification_type,
  sfunc     = nb_classify_accum,
  prefunc   = nb_classify_combine,
  finalfunc = nb_classify_final
);


--
-- Array accumulator
--
create aggregate array_accum(anyelement) (
  sfunc = array_append,
  stype = anyarray,
  initcond = '{}'
);

