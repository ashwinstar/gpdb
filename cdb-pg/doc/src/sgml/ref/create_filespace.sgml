 <refnamediv>
  <refname>CREATE FILESPACE</refname>
  <refpurpose>define a new filespace</refpurpose>
 </refnamediv>

 <indexterm zone="sql-createfilespace">
  <primary>CREATE FILESPACE</primary>
 </indexterm>

 <refsynopsisdiv>
<synopsis>

CREATE FILESPACE filespacename [OWNER rolename] (
        dbid:'/filesystem_dir/seg_datadir_name',
        ... )

</synopsis>
 </refsynopsisdiv>

