--
-- map/reduce tests, derived from external tables 1.  Short and simple
-- functional tests. The full set of tests exists in cdbunit.
--
-- Some notes: the PATH variable doesn't necessarily work correctly in
-- the regression context, so use the "gpwhich" token to get the full
-- path from your environment (see gpstringsubs for more details).  And
-- to make this work correctly with gpsourcify, you need to add your
-- gpwhich token to gptokencheck.

-- start_ignore
drop external web table if exists check_mapred;
CREATE EXTERNAL WEB TABLE check_mapred (x text)
execute E'( @gpwhich_gpmapreduce@ --help regression)'
on SEGMENT 0
format 'text';

select * from check_mapred;

create language plperl;

drop external web table if exists grep1_mapred;
drop external web table if exists check_ps;
drop table if exists a1_grep;

select * from pg_pltemplate;
select * from pg_language;


-- end_ignore

-- make sure plperl is really installed:
--      select tmplname, tmpllibrary from pg_pltemplate
--
-- to find directory.
--
-- if not, you might need to set PG_LANG = true in your environment
-- and rebuild
select lanname, lanispl, lanpltrusted from pg_language where lanname = 'plperl';

create table a1_grep (aa text);

insert into a1_grep values ('GET http://joebob.com/joe1.html HTTP');
insert into a1_grep values ('GET http://joebob.com/joe2.html HTTP');
insert into a1_grep values ('GET http://jimbob.com/joe3.html HTTP');
insert into a1_grep values ('GET http://jimbob.com/joe4.html HTTP');

-- start_ignore
-- complain about missing file
--
-- Note: use trick of redirecting stderr to stdout and 
-- piping thru "cat" to avoid "Resource temporarily unavailable" error.

drop external web table if exists grep1_mapred;
CREATE EXTERNAL WEB TABLE grep1_mapred (x text)
--execute E'( @gpwhich_gpmapreduce@ --f @abs_srcdir@/data/1_grep.yml regression -p $GP_MASTER_PORT )'
execute E'( @gpwhich_gpmapreduce@ --f nosuchfile regression -p $GP_MASTER_PORT    2>&1 | cat)'
on SEGMENT 0
format 'text';

select * from grep1_mapred;

-- end_ignore

-- complain about bad database
drop external web table if exists grep1_mapred;
CREATE EXTERNAL WEB TABLE grep1_mapred (x text)
execute E'( @gpwhich_gpmapreduce@ --f @abs_srcdir@/data/1_grep.yml nosuchdatabase $USER -p $GP_MASTER_PORT 2>&1 | cat )'
on SEGMENT 0
format 'text';

select * from grep1_mapred;

-- start_ignore
-- complain about missing user
drop external web table if exists grep1_mapred;
CREATE EXTERNAL WEB TABLE grep1_mapred (x text)
execute E'( @gpwhich_gpmapreduce@ --f @abs_srcdir@/data/1_grep.yml regression -p $GP_MASTER_PORT 2>&1 | cat )'
on SEGMENT 0
format 'text';

select * from grep1_mapred;
-- end_ignore

drop external web table if exists grep1_mapred;
CREATE EXTERNAL WEB TABLE grep1_mapred (kkey text, vval text)
execute E'( (@gpwhich_gpmapreduce@ --f @abs_srcdir@/data/1_grep.yml regression $USER -p $GP_MASTER_PORT 2>&1 ) | grep aa  )'
on SEGMENT 0
format 'text' (delimiter '|');

select * from grep1_mapred;


-- start_ignore
-- --------------------------------------
-- check platform
-- --------------------------------------
drop external web table if exists check_ps;
CREATE EXTERNAL WEB TABLE check_ps (x text)
execute E'( (ps -ef || ps -aux) | grep gpfdist | grep -v grep)'
on SEGMENT 0
format 'text';

drop external web table if exists check_env;
CREATE EXTERNAL WEB TABLE check_env (x text)
execute E'( env | sort)'
on SEGMENT 0
format 'text';

select * from check_ps;
select * from check_env;

-- end_ignore


-- --------------------------------------
-- 'gpfdist' protocol
-- --------------------------------------

CREATE EXTERNAL WEB TABLE gpfdist_status (x text)
execute E'( python $GPHOME/bin/lib/gppinggpfdist.py localhost:7070 2>&1 || echo) '
on SEGMENT 0
FORMAT 'text' (delimiter '|');

CREATE EXTERNAL WEB TABLE gpfdist_start (x text)
execute E'((@gpwhich_gpfdist@ -p 7070 -d @abs_srcdir@/data  </dev/null >/dev/null 2>&1 &); sleep 2; echo "starting...") '
on SEGMENT 0
FORMAT 'text' (delimiter '|');

CREATE EXTERNAL WEB TABLE gpfdist_stop (x text)
execute E'(/bin/pkill gpfdist || killall gpfdist) > /dev/null 2>&1; echo "stopping..."'
on SEGMENT 0
FORMAT 'text' (delimiter '|');

-- start_ignore
select * from gpfdist_stop;
select * from gpfdist_status;
select * from gpfdist_start;
select * from gpfdist_status;
-- end_ignore

CREATE EXTERNAL TABLE EXT_NATION  ( N_NATIONKEY  INTEGER ,
                            N_NAME       CHAR(25) ,
                            N_REGIONKEY  INTEGER ,
                            N_COMMENT    VARCHAR(152))
location ('gpfdist://@hostname@:7070/nation.tbl' )
FORMAT 'text' (delimiter '|');
CREATE EXTERNAL TABLE EXT_REGION  (LIKE REG_REGION)
location ('gpfdist://@hostname@:7070/region.tbl' )
FORMAT 'text' (delimiter '|');

SELECT * FROM EXT_NATION;
SELECT * FROM EXT_REGION;
SELECT * FROM EXT_REGION as r, EXT_NATION as n WHERE n.N_REGIONKEY = r.R_REGIONKEY;

-- start_ignore
select * from gpfdist_status;
select * from gpfdist_stop;
select * from gpfdist_status;
-- end_ignore

-- drop tables
DROP EXTERNAL TABLE EXT_NATION;
DROP EXTERNAL TABLE EXT_REGION;

--
-- gpfdist in csv (mpp-1519, etc)
--
CREATE EXTERNAL WEB TABLE gpfdist_csv_start (x text)
execute E'((@gpwhich_gpfdist@ -p 7070 -d @abs_srcdir@/data  </dev/null >/dev/null 2>&1 &); sleep 2; echo "starting...") '
on SEGMENT 0
FORMAT 'text' (delimiter '|');
-- 
-- "
-- (end the double quote so emacs highlighting works correctly)
--
-- start_ignore
select * from gpfdist_status;
select * from gpfdist_stop;
select * from gpfdist_status;
select * from gpfdist_csv_start;
select * from gpfdist_status;
-- end_ignore

