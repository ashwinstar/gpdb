--
-- GPFusion regression suite 
--
-- Section 1: Test HDFS type syntax and data read.
-- Section 2: Test HBASE type syntax and data read.
--
-- Prerequisites:
--
--   Must have a running hdfs with REST service on port 50070
--   Must have a running hbase with REST service on port 8080
--   Must have HADOOP_HOME and HBASE_HOME set.
--
-- TODO: test gpdbwritable write/read when it is enabled.
-- TODO: test PB, AVRO, THRIFT when it is enabled (read only, with pre formatted files).
-- TODO: test protocol validator for gpfusion once written.
-- TODO: test parameter passing, filter passing
-- TODO: test file masks (/yyy/*) paths when it is available.

--------------------------------------------------------------------------------
-- GPHDFS
--------------------------------------------------------------------------------
--
-- syntax validations
--
CREATE READABLE EXTERNAL TABLE gphdfs_in(a int, b text, c bytea)
LOCATION ('gpfusion://@hostname@:50070/hdfs/gpdb_regression_data?nosuchopt=nosuchtype')
FORMAT 'CUSTOM' (formatter='gpfusionwritable_import'); -- negative

CREATE READABLE EXTERNAL TABLE gphdfs_in(a int, b text, c bytea)
LOCATION ('gpfusion://@hostname@:50070/shnitzel/gpdb_regression_data?nosuchopt=nosuchtype')
FORMAT 'CUSTOM' (formatter='gpfusionwritable_import'); -- negative

CREATE READABLE EXTERNAL TABLE gphdfs_in1(a int, b text, c bytea)
LOCATION ('gpfusion://@hostname@:50070/hdfs/gpdb_regression_data?accessor=SequenceFileAccessor&resolver=AvroResolver&schema=MySchema')
FORMAT 'CUSTOM' (formatter='gpfusionwritable_import'); -- positive

CREATE READABLE EXTERNAL TABLE gphdfs_in2(a int, b text, c bytea)
LOCATION ('gpfusion://@hostname@:50070/hdfs/gpdb_regression_data/*')
FORMAT 'CUSTOM' (formatter='gpfusionwritable_import'); -- positive

DROP EXTERNAL TABLE gphdfs_in1;
DROP EXTERNAL TABLE gphdfs_in2;

--
-- Load HDFS with test data
--
CREATE EXTERNAL WEB TABLE copy_data_to_hdfs(confirm text)
EXECUTE '${HADOOP_HOME}/bin/hadoop fs -copyFromLocal @abs_srcdir@/data/gphdfs/writable_inside_sequence.tbl /gpdb_regression_data/writable_inside_sequence.tbl; ${HADOOP_HOME}/bin/hadoop fs -copyFromLocal @abs_srcdir@/data/gphdfs/avro_inside_sequence.tbl /gpdb_regression_data/avro_inside_sequence.tbl; ${HADOOP_HOME}/bin/hadoop fs -copyFromLocal @abs_srcdir@/data/gphdfs/avroformat_inside_avrofile.avro /gpdb_regression_data/avroformat_inside_avrofile.avro; ${HADOOP_HOME}/bin/hadoop fs -copyFromLocal @abs_srcdir@/data/gphdfs/text_data.csv /gpdb_regression_data/text_data.csv;  ${HADOOP_HOME}/bin/hadoop fs -copyFromLocal @abs_srcdir@/data/gphdfs/protobuf_data.tbl /gpdb_regression_data/protobuf_data.tbl'
ON SEGMENT 0 FORMAT 'text';
SELECT * FROM copy_data_to_hdfs;
DROP EXTERNAL TABLE copy_data_to_hdfs;

--
-- Test TEXT format on a file with many fields
--
CREATE EXTERNAL TABLE bigtext (s1 text, 
                               s2 text, 
							   s3 text, 
							   d1 timestamp, 
							   n1 int, 
							   n2 int, 
							   n3 int, 
							   n4 int, 
							   n5 int, 
							   n6 int, 
							   n7 int,
                               s11 text, 
							   s12 text, 
							   s13 text, 
							   d11 timestamp, 
							   n11 int, 
							   n12 int, 
							   n13 int, 
							   n14 int, 
							   n15 int, 
							   n16 int, 
							   n17 int)
LOCATION ('gpfusion://@hostname@:50070/hdfs/gpdb_regression_data/text_data.csv')
FORMAT 'TEXT' (DELIMITER ',');
SELECT n1, n2, n3, n4, n5, s1, s2, s3, d1 FROM bigtext ORDER BY n1;
SELECT n11, n12, n13, n14, n15, s11, s12, s13, d11 FROM bigtext ORDER BY n11;
DROP EXTERNAL TABLE bigtext;

--
-- Test Writable data inside a SequenceFile (read only).
--

CREATE EXTERNAL TABLE seqwr(tmp1  timestamp, 
                            num1  integer, 
                            num2  integer, 
                            num3  integer, 
                            num4  integer,
                            t1    text, 
                            t2    text, 
                            t3    text, 
                            t4    text, 
                            t5    text, 
                            t6    text, 
                            dub1  double precision, 
                            dub2  double precision, 
                            dub3  double precision, 
                            ft1   real, 
                            ft2   real, 
                            ft3   real, 
                            ln1   bigint, 
                            ln2   bigint, 
                            ln3   bigint, 
                            bt    bytea)
LOCATION ('gpfusion://@hostname@:50070/hdfs/gpdb_regression_data/writable_inside_sequence.tbl?accessor=SequenceFileAccessor&resolver=WritableResolver&schema=CustomWritable')
FORMAT 'custom' (formatter='gpfusionwritable_import');
SELECT tmp1, num1, num2, num3, num4, ln1, ln2, ln3, bt FROM seqwr ORDER BY num1;
SELECT num1, t1, t2, t3 FROM seqwr ORDER BY num1;
DROP EXTERNAL TABLE seqwr;
--
-- Test Avro data inside a SequenceFile (read only).
--
CREATE EXTERNAL TABLE seqav(tmp1 timestamp, 
                            num1  integer, 
                            num2  integer, 
                            num3  integer, 
                            num4  integer,
                            t1    text,
                            t2    text,
                            t3    text,
                            t4    text,
                            t5    text,
                            t6    text,
                            dub1  double precision,
                            dub2  double precision, 
                            dub3  double precision, 
                            ft1   real, 
                            ft2   real, 
                            ft3   real, 
                            ln1   bigint, 
                            ln2   bigint, 
                            ln3   bigint, 
                            bt    bytea)
LOCATION ('gpfusion://@hostname@:50070/hdfs/gpdb_regression_data/avro_inside_sequence.tbl?accessor=SequenceFileAccessor&resolver=AvroResolver&schema=regressGPFusionCustomAvro.avsc')
FORMAT 'custom' (formatter='gpfusionwritable_import');
SELECT tmp1, num1, num2, num3, num4, ln1, ln2, ln3, bt FROM seqav ORDER BY num1;
SELECT num1, t1, t2, t3 FROM seqav ORDER BY num1;
DROP EXTERNAL TABLE seqav;

--
-- Test Avro data inside an AvroFile (read only).
--
CREATE EXTERNAL TABLE avfav(tmp1 timestamp, 
                            num1  integer, 
                            num2  integer, 
                            num3  integer, 
                            num4  integer,
                            t1    text,
                            t2    text,
                            t3    text,
                            t4    text,
                            t5    text,
                            t6    text,
                            dub1  double precision,
                            dub2  double precision, 
                            dub3  double precision, 
                            ft1   real, 
                            ft2   real, 
                            ft3   real, 
                            ln1   bigint, 
                            ln2   bigint, 
                            ln3   bigint, 
                            bt    bytea)
LOCATION ('gpfusion://@hostname@:50070/hdfs/gpdb_regression_data/avroformat_inside_avrofile.avro?accessor=AvroFileAccessor&resolver=AvroResolver')
FORMAT 'custom' (formatter='gpfusionwritable_import');
SELECT tmp1, num1, num2, num3, num4, ln1, ln2, ln3, bt FROM avfav ORDER BY num1;
SELECT num1, t1, t2, t3 FROM avfav ORDER BY num1;
DROP EXTERNAL TABLE avfav;

--
-- Test Protocol-Buffers (read only).
--
-- create the external table for the protocol-buffers and query the data
CREATE EXTERNAL TABLE pb(s1 text, 
                         num1 int, 
						 s2 text, 
						 s3 text, 
						 num2 int)
LOCATION ('gpfusion://@hostname@:50070/hdfs/gpdb_regression_data/protobuf_data.tbl?accessor=ProtobufFileAccessor&resolver=ProtobufResolver&schema=pbgp.desc') 
FORMAT 'custom' (formatter='gpfusionwritable_import');
SELECT s1, num1, s2, s3, num2 from pb ORDER BY num1;
DROP EXTERNAL TABLE pb;

--
-- Cleanup: delete all data that was copied into hdfs
--
CREATE EXTERNAL WEB TABLE delete_data_from_hdfs(confirm text)
EXECUTE '${HADOOP_HOME}/bin/hadoop fs -rmr /gpdb_regression_data' ON SEGMENT 0
FORMAT 'text';
-- start_ignore
SELECT * FROM delete_data_from_hdfs;
-- end_ignore
--------------------------------------------------------------------------------
-- HBASE
--------------------------------------------------------------------------------
--
-- syntax validations
--
CREATE READABLE EXTERNAL TABLE gphbase_in(a int, b text, c bytea)
LOCATION ('gpfusion://@hostname@:8080/hbase/hbasetable?accessor=SequenceFileAccessor')
FORMAT 'CUSTOM' (formatter='gpfusionwritable_import'); -- negative

CREATE READABLE EXTERNAL TABLE gphbase_in(a int, b text, c bytea)
LOCATION ('gpfusion://@hostname@:8080/hbase/hbasetable')
FORMAT 'CUSTOM' (formatter='gpfusionwritable_import');

CREATE READABLE EXTERNAL TABLE gphbase_in(a int, b text, c bytea)
LOCATION ('gpfusion://@hostname@:8080/hbasetable')
FORMAT 'CUSTOM' (formatter='gpfusionwritable_import');

CREATE WRITABLE EXTERNAL TABLE gphbase_out(a int, b text, c bytea)
LOCATION ('gpfusion://@hostname@:8080/hbase/hbasetable')
FORMAT 'CUSTOM' (formatter='gpdbwritable_export');

DROP EXTERNAL TABLE gphbase_in;

-- Setup
CREATE EXTERNAL WEB TABLE compile_java(confirm text)
EXECUTE 'javac -cp `echo ${HBASE_HOME}/hbase-*.jar`:`echo ${HADOOP_HOME}/hadoop-core*.jar`:`echo ${HADOOP_HOME}/lib/log4j-*.jar` @abs_srcdir@/helpers/HBaseCreateTable.java' ON SEGMENT 0 FORMAT 'TEXT';
SELECT * FROM compile_java;
DROP EXTERNAL WEB TABLE compile_java;

CREATE EXTERNAL WEB TABLE run_java(confirm text)
EXECUTE 'java -cp @abs_srcdir@/helpers:`echo ${HBASE_HOME}/hbase-*.jar`:`echo ${HADOOP_HOME}/hadoop-core*.jar`:`echo ${HADOOP_HOME}/lib/log4j-*.jar`:`echo ${HADOOP_HOME}/lib/commons-logging-[1-9]*.jar`:`echo ${ZOOKEEPER_HOME}/zookeeper-*.jar` HBaseCreateTable' ON SEGMENT 0 FORMAT 'TEXT';
SELECT * FROM run_java;
DROP EXTERNAL WEB TABLE run_java;

set gp_hadoop_enable_filter_pushdown = on;
-- Test
CREATE EXTERNAL TABLE gphbase_select(hbaserowkey TEXT, 
                                     "cf1:q1" VARCHAR, 
                                     "cf1:q2" TEXT, 
                                     "cf1:q3" INT, 
                                     q4 BYTEA, 
                                     "cf1:q5" REAL, 
                                     "cf1:q6" FLOAT, 
                                     "cf1:q7" CHAR, 
                                     "cf1:q8" SMALLINT, 
                                     "cf1:q9" BIGINT) 
LOCATION ('gpfusion://@hostname@:8080/hbase/gphbase_test')
FORMAT 'CUSTOM' (formatter='gpfusionwritable_import');

SELECT * FROM gphbase_select ORDER BY hbaserowkey ASC;
SELECT * FROM gphbase_select WHERE gp_segment_id = 0 ORDER BY HBASEROWKEY ASC;
SELECT * FROM gphbase_select WHERE hbaserowkey > 'row00000090' AND hbaserowkey <= 'row00000103' ORDER BY hbaserowkey ASC;
SELECT * FROM gphbase_select WHERE hbaserowkey = 'row00000100';
SELECT * FROM gphbase_select WHERE hbaserowkey != 'row00000090' AND hbaserowkey <= 'row00000103' ORDER BY hbaserowkey ASC;
SELECT * FROM gphbase_select WHERE hbaserowkey != 'row00000090' AND hbaserowkey <= 'row00000095' AND "cf1:q7" > 'o' ORDER BY hbaserowkey ASC;
SELECT * FROM gphbase_select WHERE "cf1:q1" > 'ASCII00000090' AND q4 <= 'lookup00000198' ORDER BY hbaserowkey ASC;
SELECT * FROM gphbase_select WHERE "cf1:q2" > 'UTF8_計算機用語_00000090' AND "cf1:q3" <= 990000 ORDER BY hbaserowkey ASC;
SELECT * FROM gphbase_select WHERE "cf1:q5" > 91.92 AND "cf1:q6" <= 99999999.99 ORDER BY hbaserowkey ASC;
SELECT * FROM gphbase_select WHERE "cf1:q8" > 97 AND "cf1:q9" <= 9702990000000099 ORDER BY hbaserowkey ASC;
SELECT * FROM gphbase_select WHeRE "cf1:q9" < -7000000000000000 ORDER BY hbaserowkey ASC;
SELECT * FROM gphbase_select WHERE hbaserowkey > 'row00000090' AND hbaserowkey <= 'row00000103' OR hbaserowkey = 'row00000105' ORDER BY hbaserowkey ASC;
SELECT * FROM gphbase_select WHERE hbaserowkey != 'row00000099' AND "cf1:q8" > 97 AND "cf1:q9" <= 9702990000000099 ORDER BY hbaserowkey ASC;
SELECT * FROM gphbase_select WHERE "cf1:q9" <= 9702990000000099 AND hbaserowkey != 'row00000099' AND "cf1:q8" > 97 ORDER BY hbaserowkey ASC;
set gp_hadoop_enable_filter_pushdown = off;
SELECT * FROM gphbase_select WHERE "cf1:q9" <= 9702990000000099 AND hbaserowkey != 'row00000099' AND "cf1:q8" > 97 ORDER BY hbaserowkey ASC;
set gp_hadoop_enable_filter_pushdown = on;
DROP EXTERNAL TABLE gphbase_select;

CREATE EXTERNAL TABLE gphbase_error(hbaserowkey int)
LOCATION ('gpfusion://@hostname@:8080/hbase/gphbase_test')
FORMAT 'CUSTOM' (formatter='gpfusionwritable_import');
SELECT * FROM gphbase_error;
DROP EXTERNAL TABLE gphbase_error;

-- Cleanup
CREATE EXTERNAL WEB TABLE compile_java(confirm text)
EXECUTE 'javac -cp `echo ${HBASE_HOME}/hbase-*.jar`:`echo ${HADOOP_HOME}/hadoop-core*.jar`:`echo ${HADOOP_HOME}/lib/log4j-*.jar` @abs_srcdir@/helpers/HBaseDropTable.java' ON SEGMENT 0 FORMAT 'TEXT';
SELECT * FROM compile_java;
DROP EXTERNAL WEB TABLE compile_java;

CREATE EXTERNAL WEB TABLE run_java(confirm text)
EXECUTE 'java -cp @abs_srcdir@/helpers:`echo ${HBASE_HOME}/hbase-*.jar`:`echo ${HADOOP_HOME}/hadoop-core*.jar`:`echo ${HADOOP_HOME}/lib/log4j-*.jar`:`echo ${HADOOP_HOME}/lib/commons-logging-[1-9]*.jar`:`echo ${ZOOKEEPER_HOME}/zookeeper-*.jar` HBaseDropTable' ON SEGMENT 0 FORMAT 'TEXT';
SELECT * FROM run_java;
DROP EXTERNAL WEB TABLE run_java;
