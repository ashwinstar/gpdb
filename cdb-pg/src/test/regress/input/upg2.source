  public.pg_shdepend,
  public.pg_rewrite,
  public.pg_class_v33,
  public.pg_attribute_v33,
  public.pg_type_v33,
  public.pg_index_v33,
  public.pg_aggregate_v33,
  public.pg_proc_v33,
  public.pg_namespace_v33,
  public.pg_conversion_v33,
  public.pg_description_v33,
  public.pg_depend_v33,
  public.pg_shdescription_v33,
