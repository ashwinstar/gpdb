--
-- table splitting
--

DROP EXTERNAL TABLE gpfdist_start;
DROP EXTERNAL TABLE gpfdist_stop;

CREATE EXTERNAL WEB TABLE splitsetup (x text)
execute E'((rm -rf @abs_builddir@/results/exttab1dir; mkdir  @abs_builddir@/results/exttab1dir;  mkdir @abs_builddir@/results/exttab1dir/splitlineitem; cp @abs_srcdir@/data/lineitem.tbl @abs_builddir@/results/exttab1dir; ( cd @abs_builddir@/results/exttab1dir; split -l 1000 lineitem.tbl x; mv x* splitlineitem )); echo "setup...") '
on SEGMENT 0
FORMAT 'text' (delimiter '|');

-- point gpfdist at the results directory, not the data directory
CREATE EXTERNAL WEB TABLE gpfdist_start (x text)
execute E'((@gpwhich_gpfdist@ -p 8080 -d @abs_builddir@/results  </dev/null >/dev/null 2>&1 &); sleep 5; echo "starting...") '
on SEGMENT 0
FORMAT 'text' (delimiter '|');

CREATE EXTERNAL WEB TABLE gpfdist_stop (x text)
execute E'(@ps_pidfirst@ | grep gpfdist |  grep \'@abs_builddir@/results\' | 
grep -v grep | awk \'{print "kill "$1}\' | sh ) ; echo "stopping..."'
on SEGMENT 0
FORMAT 'text' (delimiter '|');

select * from splitsetup;
select * from gpfdist_stop;
select * from gpfdist_start;

--
-- look at lineitem 3 ways, and check that always get the same answer
--
CREATE EXTERNAL TABLE EXT_LINEITEM ( L_ORDERKEY    INTEGER ,
                             L_PARTKEY     INTEGER ,
                             L_SUPPKEY     INTEGER ,
                             L_LINENUMBER  INTEGER ,
                             L_QUANTITY    DECIMAL(15,2) ,
                             L_EXTENDEDPRICE  DECIMAL(15,2) ,
                             L_DISCOUNT    DECIMAL(15,2) ,
                             L_TAX         DECIMAL(15,2) ,
                             L_RETURNFLAG  CHAR(1) ,
                             L_LINESTATUS  CHAR(1) ,
                             L_SHIPDATE    DATE ,
                             L_COMMITDATE  DATE ,
                             L_RECEIPTDATE DATE ,
                             L_SHIPINSTRUCT CHAR(25) ,
                             L_SHIPMODE     CHAR(10) ,
                             L_COMMENT      VARCHAR(44) )
location ('file://@hostname@@abs_srcdir@/data/lineitem.tbl' )
FORMAT 'text' (delimiter '|');


CREATE EXTERNAL WEB TABLE EXT_LINEITEM1 ( L_ORDERKEY    INTEGER ,
                             L_PARTKEY     INTEGER ,
                             L_SUPPKEY     INTEGER ,
                             L_LINENUMBER  INTEGER ,
