location ('gpfdist://@hostname@:8080/whois.csv' )
format 'csv' ( quote as '"');
-- "
-- no header option because we specified it for gpfdist_csv...

select count(*) from ext_whois;

-- --------------------------------------
-- some negative tests
-- --------------------------------------

--
-- bad csv (quote must be a single char)
--
create external table bad_whois (
source_lineno			int,
domain_name			varchar(350)
)
location ('gpfdist://@hostname@:8080/whois.csv' )
format 'csv' ( header quote as 'ggg');
select count(*) from bad_whois;
drop external table bad_whois;

select * from gpfdist_stop;

--
-- try a bad location
--
create external table badt1 (x text) 
location ('file://@hostname@@abs_srcdir@/data/no/such/place/badt1.tbl' )
format 'text' (delimiter '|');
select * from badt1;
drop external table badt1;

--
-- try a bad protocol
--
create external table badt2 (x text) 
location ('bad_protocol://@hostname@@abs_srcdir@/data/no/such/place/badt2.tbl' )
format 'text' (delimiter '|');

--
-- get an error for missing gpfdist
--
select count(*) from ext_whois;

drop external table ext_whois;

drop external table gpfdist_start;
drop external table gpfdist_csv_start;
drop external table gpfdist_stop;

-- --------------------------------------
-- Single row error handling tests
-- --------------------------------------

-- here we want to test rejecting all bad records, without error table
CREATE EXTERNAL TABLE EXT_NUMBERS (a int, b int, c int)
LOCATION ('file://@hostname@@abs_srcdir@/data/bad_data1.data', 
'file://@hostname@@abs_srcdir@/data/bad_data2.data' )
FORMAT 'text' (delimiter '|')
SEGMENT REJECT LIMIT 1000;

SELECT * FROM EXT_NUMBERS ORDER BY a;
DROP EXTERNAL TABLE EXT_NUMBERS;

-- here we want to test reaching the segment reject limit and aborting
CREATE EXTERNAL TABLE EXT_NUMBERS (a int, b int, c int)
LOCATION ('file://@hostname@@abs_srcdir@/data/bad_data1.data', 
'file://@hostname@@abs_srcdir@/data/bad_data2.data' )
FORMAT 'text' (delimiter '|')
SEGMENT REJECT LIMIT 3;

SELECT * FROM EXT_NUMBERS ORDER BY a;
DROP EXTERNAL TABLE EXT_NUMBERS;
