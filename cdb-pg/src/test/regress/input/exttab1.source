-- do the csv copy tests (adapted from copy.source)

--- test copying in CSV mode with various styles
--- of embedded line ending characters

CREATE EXTERNAL WEB TABLE gpfdist_start (x text)
execute E'((@gpwhich_gpfdist@ -p 8080 -d @abs_builddir@/results -q \'z\' -x \'Z\' </dev/null >/dev/null 2>&1 &); sleep 5; echo "starting...") '
on SEGMENT 0
FORMAT 'text' (delimiter '|');

CREATE EXTERNAL WEB TABLE gpfdist_stop (x text)
execute E'(@ps_pidfirst@ | grep gpfdist |  grep \'@abs_builddir@/results\' |
grep -v grep | awk \'{print "kill "$1}\' | sh ) ; echo "stopping..."'
on SEGMENT 0
FORMAT 'text' (delimiter '|');

select * from gpfdist_stop;
select * from gpfdist_start;

create temp table extcpytest (
	style	text,
	test 	text,
	filler	int);

insert into extcpytest values('DOS',E'abc\r\ndef',1);
insert into extcpytest values('Unix',E'abc\ndef',2);
insert into extcpytest values('Mac',E'abc\rdef',3);
insert into extcpytest values(E'esc\\ape',E'a\\r\\\r\\\n\\nb',4);

copy extcpytest to '@abs_builddir@/results/extcpytest.csv' csv;

---- create temp table extcpytest2 (like extcpytest);

---- copy extcpytest2 from '@abs_builddir@/results/extcpytest.csv' csv;

---- select * from extcpytest except select * from extcpytest2 order by 1,2,3;

----- same test but with an escape char different from quote char

copy extcpytest to '@abs_builddir@/results/extcpytest.csv' csv quote 'z' escape E'Z';

create external table  extcpytest2 (
	style	text,
	test 	text,
	filler	int)
location ('gpfdist://@hostname@:8080/extcpytest.csv')
format 'csv' ( quote as 'z' escape as 'Z');

select * from extcpytest except select * from extcpytest2 order by 1,2,3;

drop external table extcpytest2;

