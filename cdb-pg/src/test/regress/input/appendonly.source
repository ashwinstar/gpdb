CREATE TABLE tenk_heap (
	unique1 	int4,
	unique2 	int4,
	two 	 	int4,
	four 		int4,
	ten			int4,
	twenty 		int4,
	hundred 	int4,
	thousand 	int4,
	twothousand int4,
	fivethous 	int4,
	tenthous	int4,
	odd			int4,
	even		int4,
	stringu1	name,
	stringu2	name,
	string4		name
) with (appendonly=false);

CREATE TABLE tenk_ao1 (
	unique1 	int4,
	unique2 	int4,
	two 	 	int4,
	four 		int4,
	ten			int4,
	twenty 		int4,
	hundred 	int4,
	thousand 	int4,
	twothousand int4,
	fivethous 	int4,
	tenthous	int4,
	odd			int4,
	even		int4,
	stringu1	name,
	stringu2	name,
	string4		name
) with (appendonly=true,compression=false);

CREATE TABLE tenk_ao2 (
	unique1 	int4,
	unique2 	int4,
	two 	 	int4,
	four 		int4,
	ten			int4,
	twenty 		int4,
	hundred 	int4,
	thousand 	int4,
	twothousand int4,
	fivethous 	int4,
	tenthous	int4,
	odd			int4,
	even		int4,
	stringu1	name,
	stringu2	name,
	string4		name
) with (appendonly=true, compression=true);

CREATE TABLE tenk_ao3 (
	unique1 	int4,
	unique2 	int4,
	two 	 	int4,
	four 		int4,
	ten			int4,
	twenty 		int4,
	hundred 	int4,
	thousand 	int4,
	twothousand int4,
	fivethous 	int4,
	tenthous	int4,
	odd			int4,
	even		int4,
	stringu1	name,
	stringu2	name,
	string4		name
) with (appendonly=true, compression=true, compresslevel=6);

-------------------- 
-- catalog checks
--------------------

-- check reloptions
SELECT relkind, reloptions FROM pg_class WHERE relname LIKE 'tenk_ao%' ORDER BY relname;

-- check pg_appendonly for correct number of entries
SELECT count(*) FROM pg_appendonly;

-- make sure relfilenode is the same in pg_class and pg_appendonly for all tables
SELECT count(*) FROM pg_class c, pg_appendonly a WHERE c.relkind='a' AND  c.relfilenode=a.relfilenode;

-- TRUNCATE and make sure new relfilenode is updated in pg_appendonly
TRUNCATE tenk_ao1;
SELECT count(*) FROM pg_class c, pg_appendonly a WHERE c.relkind='a' AND  c.relfilenode=a.relfilenode;

-------------------- 
-- supported sql
--------------------

-- COPY
COPY tenk_heap FROM '@abs_srcdir@/data/tenk.data';
COPY tenk_ao1 FROM '@abs_srcdir@/data/tenk.data';
COPY tenk_ao2 FROM '@abs_srcdir@/data/tenk.data';
COPY tenk_ao3 FROM '@abs_srcdir@/data/tenk.data';

-- SELECT
SELECT count(*) FROM tenk_heap;
SELECT count(*) FROM tenk_ao1;
SELECT count(*) FROM tenk_ao2;
SELECT count(*) FROM tenk_ao3;

-- INSERT SELECT
INSERT INTO tenk_ao1 SELECT * FROM tenk_heap;
INSERT INTO tenk_ao2 SELECT * FROM tenk_heap;
INSERT INTO tenk_ao3 SELECT * FROM tenk_heap;

-- mix and match some
INSERT INTO tenk_ao1 SELECT * FROM tenk_ao1;
INSERT INTO tenk_ao2 SELECT * FROM tenk_ao3;
INSERT INTO tenk_ao3 SELECT * FROM tenk_ao2;

-- SELECT
SELECT count(*) FROM tenk_heap;
SELECT count(*) FROM tenk_ao1;
SELECT count(*) FROM tenk_ao2;
SELECT count(*) FROM tenk_ao3;

--
-- Test that the catalog eof entry doesn't change even if the file gets
-- larger due to bad data that isn't cleaned up until the next VACUUM. 
-- make sure the SELECT stops at eof (count is the same). 
-- The first row is good (so it grows the file), the second is bad.
--
COPY tenk_ao1 FROM STDIN;
88888800	0	0	0	0	0	0	800	800	3800	8800	0	1	MAAAAA	AAAAAA	AAAAxx
bad data row
\.
COPY tenk_ao2 FROM STDIN;
88888800	0	0	0	0	0	0	800	800	3800	8800	0	1	MAAAAA	AAAAAA	AAAAxx
bad data row
\.
COPY tenk_ao3 FROM STDIN;
88888800	0	0	0	0	0	0	800	800	3800	8800	0	1	MAAAAA	AAAAAA	AAAAxx
bad data row
\.
SELECT count(*) FROM tenk_ao1;
SELECT count(*) FROM tenk_ao2;
SELECT count(*) FROM tenk_ao3;

-- DROP
DROP TABLE tenk_ao1;
DROP TABLE tenk_ao2;
DROP TABLE tenk_ao3;

-- CTAS
CREATE TABLE tenk_ao1 with(appendonly=true, compression=false) AS SELECT * FROM tenk_heap;
CREATE TABLE tenk_ao2 with(appendonly=true, compression=true) AS SELECT * FROM tenk_heap;
CREATE TABLE tenk_ao3 with(appendonly=true, compression=true, compresslevel=6) AS SELECT * FROM tenk_heap;
SELECT relkind, reloptions FROM pg_class WHERE relname LIKE 'tenk_ao%' ORDER BY relname;
SELECT count(*) FROM tenk_ao1;
SELECT count(*) FROM tenk_ao2;
SELECT count(*) FROM tenk_ao3;

-- VACUUM
VACUUM tenk_ao1;
VACUUM tenk_ao2;
VACUUM tenk_ao3;
VACUUM FULL tenk_ao1;
ANALYZE tenk_ao2;
VACUUM ANALYZE tenk_ao3;

SELECT count(*) FROM tenk_ao1;
SELECT count(*) FROM tenk_ao2;
SELECT count(*) FROM tenk_ao3;

-- JOIN
SELECT count(*) FROM tenk_ao1 t1, tenk_ao2 t2 where t1.unique1 = t2.unique2;
SELECT count(*) FROM tenk_ao1 t1, tenk_heap t2 where t1.unique1 = t2.unique2;

-- TRUNCATE
TRUNCATE tenk_ao2;

-------------------- 
-- unsupported sql 
--------------------

-- DELETE (not supported)
DELETE FROM tenk_ao2 WHERE unique2 = 1;

-- UPDATE (not supported)
UPDATE tenk_ao2 SET unique2 = 1 WHERE unique2 = 2;

-- CREATE INDEX (not supported)
CREATE INDEX tenk_ao1_unique1 ON tenk_ao1 USING btree(unique1 int4_ops);

-- ALTER
ALTER TABLE tenk_ao1 RENAME TO tenk_renamed;
ALTER TABLE tenk_renamed ADD COLUMN newcol int default 10;
ALTER TABLE tenk_renamed ALTER COLUMN twothousand SET NOT NULL;
ALTER TABLE tenk_renamed ADD COLUMN newcol2 int NOT NULL; -- should fail
SELECT count(*) FROM tenk_renamed;
ALTER TABLE tenk_renamed RENAME TO tenk_ao1;

-------------------- 
-- supported sql 
--------------------
DROP TABLE tenk_heap;
DROP TABLE tenk_ao1;
DROP TABLE tenk_ao2;
DROP TABLE tenk_ao3;

-------------------- 
-- catalog check 
--------------------
SELECT count(*) FROM pg_appendonly;
