--
-- map/reduce tests, derived from external tables 1.  Short and simple
-- functional tests. The full set of tests exists in cdbunit.
--
drop external web table if exists check_mapred;
NOTICE:  external table "check_mapred" does not exist, skipping
CREATE EXTERNAL WEB TABLE check_mapred (x text)
execute E'( gpmapreduce --? )'
on SEGMENT 0
format 'text';
