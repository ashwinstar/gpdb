create table a1_grep (aa text);
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause -- Using column named 'aa' as the Greenplum Database data distribution key for this table.
HINT:  The 'DISTRIBUTED BY' clause determines the distribution of data. Make sure column(s) chosen are the optimal data distribution key to minimize skew.
insert into a1_grep values ('GET http://joebob.com/joe1.html HTTP');
insert into a1_grep values ('GET http://joebob.com/joe2.html HTTP');
insert into a1_grep values ('GET http://jimbob.com/joe3.html HTTP');
insert into a1_grep values ('GET http://jimbob.com/joe4.html HTTP');
-- start_ignore
-- complain about missing file
--
-- Note: use trick of redirecting stderr to stdout and 
-- piping thru "cat" to avoid "Resource temporarily unavailable" error.
drop external web table if exists grep1_mapred;
NOTICE:  external table "grep1_mapred" does not exist, skipping
CREATE EXTERNAL WEB TABLE grep1_mapred (x text)
--execute E'( @gpwhich_gpmapreduce@ --f @abs_srcdir@/data/1_grep.yml regression -p $GP_MASTER_PORT )'
execute E'( @gpwhich_gpmapreduce@ --f nosuchfile regression -p $GP_MASTER_PORT    2>&1 | cat)'
on SEGMENT 0
format 'text';
select * from grep1_mapred;
                    x                    
-----------------------------------------
 Error: Could not open file 'nosuchfile'
(1 row)

-- end_ignore
-- complain about bad database
drop external web table if exists grep1_mapred;
CREATE EXTERNAL WEB TABLE grep1_mapred (x text)
execute E'( @gpwhich_gpmapreduce@ --f @abs_srcdir@/data/1_grep.yml nosuchdatabase $USER -p $GP_MASTER_PORT 2>&1 | cat )'
on SEGMENT 0
format 'text';
select * from grep1_mapred;
                        x                         
--------------------------------------------------
 FATAL:  database "nosuchdatabase" does not exist
(1 row)

-- start_ignore
-- complain about missing user
drop external web table if exists grep1_mapred;
CREATE EXTERNAL WEB TABLE grep1_mapred (x text)
execute E'( @gpwhich_gpmapreduce@ --f @abs_srcdir@/data/1_grep.yml regression -p $GP_MASTER_PORT 2>&1 | cat )'
on SEGMENT 0
format 'text';
select * from grep1_mapred;
                              x                              
-------------------------------------------------------------
