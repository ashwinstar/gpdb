(1 row)

-- end_ignore
drop external web table if exists grep1_mapred;
CREATE EXTERNAL WEB TABLE grep1_mapred (kkey text, vval text)
execute E'( (@gpwhich_gpmapreduce@ --f @abs_srcdir@/data/1_grep.yml regression $USER -p $GP_MASTER_PORT 2>&1 ) | grep aa  )'
on SEGMENT 0
format 'text' (delimiter '|');
select * from grep1_mapred;
 kkey | vval  
------+-------
 aa   | bb   
 aa   | bb   
 aa   | bb   
 aa   | bb   
(4 rows)

