CREATE OR REPLACE FUNCTION public.utf8_to_koi8u (INTEGER, INTEGER, CSTRING, INTERNAL, INTEGER) RETURNS VOID AS '$libdir/utf8_and_cyrillic', 'utf8_to_koi8u' LANGUAGE C STRICT;
CREATE OR REPLACE FUNCTION public.koi8u_to_utf8 (INTEGER, INTEGER, CSTRING, INTERNAL, INTEGER) RETURNS VOID AS '$libdir/utf8_and_cyrillic', 'koi8u_to_utf8' LANGUAGE C STRICT;
insert into public.pg_conversion values('euc_jis_2004_to_shift_jis_2004', '11', '10', '5', '41', 'euc_jis_2004_to_shift_jis_2004', 't'); 
insert into public.pg_conversion values('euc_jis_2004_to_utf8', '11', '10', '5', '6', 'euc_jis_2004_to_utf8', 't'); 
insert into public.pg_conversion values('koi8_u_to_utf8', '11', '10', '34', '6', 'koi8u_to_utf8', 't'); 
insert into public.pg_conversion values('utf8_to_koi8_u', '11', '10', '6', '34', 'utf8_to_koi8u', 't'); 
insert into public.pg_conversion values('shift_jis_2004_to_utf8', '11', '10', '41', '6', 'shift_jis_2004_to_utf8', 't'); 
insert into public.pg_conversion values('shift_jis_2004_to_euc_jis_2004', '11', '10', '41', '5', 'shift_jis_2004_to_euc_jis_2004', 't'); 
insert into public.pg_conversion values('utf8_to_euc_jis_2004', '11', '10', '6', '5', 'utf8_to_euc_jis_2004', 't');
insert into public.pg_conversion values('utf8_to_shift_jis_2004', '11', '10', '6', '41', 'utf8_to_shift_jis_2004', 't');
insert into public.pg_depend select 2607, oid, 0, 1255, conproc, 0, 'n' from pg_catalog.pg_conversion where conname in('euc_jis_2004_to_shift_jis_2004', 'euc_jis_2004_to_utf8', 'koi8_u_to_utf8', 'utf8_to_koi8_u', 'shift_jis_2004_to_utf8', 'shift_jis_2004_to_euc_jis_2004', 'utf8_to_euc_jis_2004', 'utf8_to_shift_jis_2004');
-- these fill fail during regression testing but succeed for the upgrade
update public.gp_version_at_initdb SET productversion = substring(version(), 'Greenplum Database ([^)]*)');
