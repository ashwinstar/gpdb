--
-- upgrade 2
--
-- save the catalog info for previous revision
-- COPY pg_attribute 
--   to '@abs_srcdir@/data/pg_attribute32.data'  csv header;
-- COPY pg_class 
--   to '@abs_srcdir@/data/pg_class32.data' with oids csv header;
-- COPY pg_type 
--   to '@abs_srcdir@/data/pg_type32.data' with oids csv header;
-- build "old" catalog tables
create table old_attribute (like pg_attribute) ;
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause -- Using column named 'attrelid' as the Greenplum Database data distribution key for this table.
HINT:  The 'DISTRIBUTED BY' clause determines the distribution of data. Make sure column(s) chosen are the optimal data distribution key to minimize skew.
create table old_class (like pg_class) with oids;
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause -- Using column named 'relname' as the Greenplum Database data distribution key for this table.
HINT:  The 'DISTRIBUTED BY' clause determines the distribution of data. Make sure column(s) chosen are the optimal data distribution key to minimize skew.
create table old_type (like pg_type) with oids;
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause -- Using column named 'typname' as the Greenplum Database data distribution key for this table.
HINT:  The 'DISTRIBUTED BY' clause determines the distribution of data. Make sure column(s) chosen are the optimal data distribution key to minimize skew.
-- load the "old" catalog
COPY old_attribute 
  from '@abs_srcdir@/data/pg_attribute32.data'  csv header;
NOTICE:  HEADER means that each one of the data files has a header row.
COPY old_class 
  from '@abs_srcdir@/data/pg_class32.data' with oids csv header;
NOTICE:  HEADER means that each one of the data files has a header row.
COPY old_type 
  from '@abs_srcdir@/data/pg_type32.data' with oids csv header;
NOTICE:  HEADER means that each one of the data files has a header row.
-- begin_equivalent 
-- compare old vs new catalog tables
select c.relname, a.attname, a.attnum, t.typname, t.typlen, a.atttypmod
from old_attribute a,
old_class c,
old_type t
where c.oid = a.attrelid and a.attnum > 0
and t.oid = a.atttypid
and c.oid < 16384
and c.relkind = 'r'
order by c.relname, a.attnum;
