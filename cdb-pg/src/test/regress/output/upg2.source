--
-- upgrade 2
--
--
-- Load in data which represents the difference between the 3.2 catalog
-- and 3.3 catalog
--
--
-- save the catalog info for previous revision
-- COPY pg_attribute 
--   to '@abs_srcdir@/data/pg_attribute32.data'  csv header;
-- COPY pg_class 
--   to '@abs_srcdir@/data/pg_class32.data' with oids csv header;
-- COPY pg_type 
--   to '@abs_srcdir@/data/pg_type32.data' with oids csv header;
--
-- build "old" catalog tables
create table old_attribute_v32 (like pg_attribute) ;
create table old_class_v32 (like pg_class) with oids;
create table old_type_v32 (like pg_type) with oids;
create table old_index_v32 (like pg_index);
-- load the "old" catalog
COPY old_attribute_v32 
  from '@abs_srcdir@/data/pg_attribute32.data'  csv header;
COPY old_class_v32 
  from '@abs_srcdir@/data/pg_class32.data' with oids csv header;
COPY old_type_v32 
  from '@abs_srcdir@/data/pg_type32.data' with oids csv header;
COPY old_index_v32
  from '@abs_srcdir@/data/pg_index32.data' csv header;
create table public.pg_class(like pg_catalog.pg_class) with oids;
create table public.pg_attribute(like pg_catalog.pg_attribute);
create table public.pg_type(like pg_catalog.pg_type) with oids;
create table public.pg_index(like pg_catalog.pg_index);
create view old_class as
select oid, relname, relnamespace, reltype, relowner,
	   relam, relfilenode, reltablespace,
	   /* relpages, reltuples, -- these can differ */
	   reltoastrelid, reltoastidxid, relaosegrelid, relaosegidxid,
	   relhasindex, relisshared, relkind, relstorage, relnatts, relchecks,
	   reltriggers, relukeys, relfkeys, relrefs, relhasoids, relhaspkey,
	   relhasrules, relhassubclass, /* relfrozenxid -- different */
	   relacl, reloptions from old_class_v32
union all
select oid, relname, relnamespace, reltype, relowner,
	   relam, relfilenode, reltablespace,
	   /* relpages, reltuples, -- these can differ */
	   reltoastrelid, reltoastidxid, relaosegrelid, relaosegidxid,
	   relhasindex, relisshared, relkind, relstorage, relnatts, relchecks,
	   reltriggers, relukeys, relfkeys, relrefs, relhasoids, relhaspkey,
	   relhasrules, relhassubclass, /* relfrozenxid -- different */
	   relacl, reloptions from public.pg_class;
create view old_attribute as 
select attrelid, attname, atttypid, /* attstattarget, -- can differ */ 
	   attlen, attnum, attndims, attcacheoff, atttypmod, attbyval, attstorage, 
	   attalign, attnotnull,
	   atthasdef, attisdropped, attislocal, attinhcount from old_attribute_v32
union all
select  attrelid, attname, atttypid, /* attstattarget, -- can differ */
	   attlen, attnum, attndims, attcacheoff, atttypmod, attbyval, attstorage, 
	   attalign, attnotnull,
	   atthasdef, attisdropped, attislocal, attinhcount from public.pg_attribute;
create view old_type as select oid, * from old_type_v32 union all
select oid, * from public.pg_type;
create view old_index as select * from old_index_v32 union all
select * from public.pg_index;
-- new tables and attributes. 
-- AOCS
\i @abs_srcdir@/data/upg2_pg_class_toadd.data
copy public.pg_class from stdin oids null E'\\N' csv delimiter '|' header;
reindex table pg_aocs;
\i @abs_srcdir@/data/upg2_pg_attribute_toadd.data
copy public.pg_attribute from stdin csv delimiter '|' header;
\i @abs_srcdir@/data/upg2_pg_type_toadd.data
copy public.pg_type from stdin csv delimiter '|' header;
\i @abs_srcdir@/data/upg2_pg_index_toadd.data
copy public.pg_index from stdin null as E'\\N' csv delimiter '|' header;
-- begin_equivalent 
-- compare old vs new catalog tables
select c.relname, a.attname, a.attnum, t.typname, t.typlen, a.atttypmod
from old_attribute a,
old_class c,
old_type t
where c.oid = a.attrelid and a.attnum > 0
and t.oid = a.atttypid
and c.oid < 10000
and c.relkind = 'r'
order by c.relname, a.attnum;
         relname          |              attname              | attnum |     typname     | typlen | atttypmod 
