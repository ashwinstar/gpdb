 CREATE TYPE upg_catalog.regclass;
 CREATE TYPE upg_catalog.regoper;
 CREATE TYPE upg_catalog.regoperator;
 CREATE TYPE upg_catalog.regproc;
 CREATE TYPE upg_catalog.regprocedure;
