   );
   CREATE TABLE gp_segment_configuration
   (
   dbid              smallint   , -- up to 32767 segment databases
   content           smallint   , -- up to 32767 contents -- only 16384 usable with mirroring (see dbid)
   role              "char"     ,
   preferred_role    "char"     ,
   mode              "char"     ,
   status            "char"     ,
   port              integer    ,
   hostname          text       ,
   address           text       ,
