DROP TYPE if exists upg_toolkit.gp_param_setting_t cascade;
DROP FUNCTION if exists upg_toolkit.__gp_param_local_setting(varchar) cascade;
DROP FUNCTION if exists upg_toolkit.gp_param_setting(varchar) cascade;
DROP FUNCTION if exists upg_toolkit.gp_param_settings()  cascade;
DROP VIEW if exists upg_toolkit.gp_param_settings_seg_value_diffs cascade;
DROP VIEW if exists upg_toolkit.gp_pgdatabase_invalid  cascade;
