-- end_equiv
-- Compare pg_attribute (Tables, Views, Indexes)
-- start_equiv
SELECT
    c.relname, a.attnum, a.attname, t.typname, a.atttypmod, a.attbyval, 
    a.attstorage, a.attalign
    -- , a.attndims
    -- , a.attnotnull
    , atthasdef, attislocal, attinhcount
FROM
    pg_class c
	join pg_attribute a on (a.attrelid = c.oid)
    join pg_type t on (a.atttypid = t.oid)
    join pg_namespace n on (n.oid = c.relnamespace)
WHERE a.attnum > 0 and nspname = 'upg_catalog' and c.relkind != 'i'
ORDER BY c.relname, a.attnum;
            relname            | attnum |                      attname                      |   typname   | atttypmod | attbyval | attstorage | attalign | atthasdef | attislocal | attinhcount 
-------------------------------+--------+---------------------------------------------------+-------------+-----------+----------+------------+----------+-----------+------------+-------------
 gp_configuration              |      1 | content                                           | int2        |        -1 | t        | p          | s        | f         | t          |           0
 gp_configuration              |      2 | definedprimary                                    | bool        |        -1 | t        | p          | c        | f         | t          |           0
 gp_configuration              |      3 | dbid                                              | int2        |        -1 | t        | p          | s        | f         | t          |           0
 gp_configuration              |      4 | isprimary                                         | bool        |        -1 | t        | p          | c        | f         | t          |           0
 gp_configuration              |      5 | valid                                             | bool        |        -1 | t        | p          | c        | f         | t          |           0
 gp_configuration              |      6 | hostname                                          | name        |        -1 | f        | p          | i        | f         | t          |           0
 gp_configuration              |      7 | port                                              | int4        |        -1 | t        | p          | i        | f         | t          |           0
