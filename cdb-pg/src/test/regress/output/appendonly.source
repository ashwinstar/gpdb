-- catalog checks
--------------------
-- check pg_appendonly
SELECT c.relname, c.relkind, a.blocksize, a.compresslevel FROM pg_class c, pg_appendonly a WHERE c.relname LIKE 'tenk_ao%' AND c.oid=a.relid ORDER BY c.relname;
 relname  | relkind | blocksize | compresslevel 
----------+---------+-----------+---------------
 tenk_ao1 | a       |     32768 |             0
 tenk_ao2 | a       |    262144 |             0
 tenk_ao3 | a       |   1048576 |             6
(3 rows)

