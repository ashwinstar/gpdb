-- cleanup
DROP TABLE sreh_copy;
DROP TABLE sreh_constr;
DROP TABLE sreh_copy_errtbl;
-- ###########################################################
-- External Tables 
-- ###########################################################
CREATE EXTERNAL WEB TABLE gpfdist_start (x text)
execute E'((@gpwhich_gpfdist@ -p 8080 -d @abs_srcdir@/data  </dev/null >/dev/null 2>&1 &); sleep 7; echo "starting...") '
on SEGMENT 0
FORMAT 'text' (delimiter '|');
CREATE EXTERNAL WEB TABLE gpfdist_stop (x text)
execute E'(@ps_pidfirst@ | grep gpfdist |  grep \'@abs_srcdir@/data\' | 
grep -v grep | awk \'{print "kill "$1}\' | sh ) ; echo "stopping..."'
on SEGMENT 0
FORMAT 'text' (delimiter '|');
select * from gpfdist_stop;
      x      
-------------
 stopping...
(1 row)

select * from gpfdist_start;
      x      
-------------
 starting...
(1 row)

