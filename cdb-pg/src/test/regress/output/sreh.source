ERROR:  duplicate key violates unique constraint "sreh_constr_a_key"  (seg0 @hostname@:11001 pid=14901)
CONTEXT:  COPY sreh_constr, line 5: "9"
SELECT * FROM sreh_copy_errtbl; -- should exist and be empty
