 formatting.c:00000517: #define DCH_S_FM 0x01 
 formatting.c:00000518: #define DCH_S_TH 0x02 
 formatting.c:00000519: #define DCH_S_th 0x04 
 formatting.c:00000520: #define DCH_S_SP 0x08 
 formatting.c:00000521: #define DCH_S_TM 0x10 
 formatting.c:00000522:  
 formatting.c:00000523: /* ---------- 
 formatting.c:00000524:  * Suffix tests 
 formatting.c:00000525:  * ---------- 
 formatting.c:00000526:  */ 
 formatting.c:00000527: #define S_THth(_s) ((((_s) & DCH_S_TH) *PIPE**PIPE* ((_s) & DCH_S_th)) ? 1 : 0) 
 formatting.c:00000528: #define S_TH(_s) (((_s) & DCH_S_TH) ? 1 : 0) 
 formatting.c:00000529: #define S_th(_s) (((_s) & DCH_S_th) ? 1 : 0) 
 formatting.c:00000530: #define S_TH_TYPE(_s) (((_s) & DCH_S_TH) ? TH_UPPER : TH_LOWER) 
 formatting.c:00000531:  
 formatting.c:00000532: #define S_FM(_s) (((_s) & DCH_S_FM) ? 1 : 0) 
 formatting.c:00000533: #define S_SP(_s) (((_s) & DCH_S_SP) ? 1 : 0) 
 formatting.c:00000534: #define S_TM(_s) (((_s) & DCH_S_TM) ? 1 : 0) 
