 sysv_shmem.c:00000098:  ereport(FATAL, 
 sysv_shmem.c:00000099:  (errmsg("could not create shared memory segment: %m"), 
 sysv_shmem.c:00000100:  errdetail("Failed system call was shmget(key=%lu, size=%lu, 0%o).", 
 sysv_shmem.c:00000101:  (unsigned long) memKey, (unsigned long) size, 
 sysv_shmem.c:00000102:  IPC_CREAT *PIPE* IPC_EXCL *PIPE* IPCProtection), 
 sysv_shmem.c:00000103:  (errno == EINVAL) ? 
 sysv_shmem.c:00000104:  errhint("This error usually means that PostgreSQL's request for a shared memory " 
 sysv_shmem.c:00000105:  "segment exceeded your kernel's SHMMAX parameter. You can either " 
 sysv_shmem.c:00000106:  "reduce the request size or reconfigure the kernel with larger SHMMAX. " 
 sysv_shmem.c:00000107:  "To reduce the request size (currently %lu bytes), reduce " 
 sysv_shmem.c:00000108:  "PostgreSQL's shared_buffers parameter (currently %d) and/or " 
 sysv_shmem.c:00000109:  "its max_connections parameter (currently %d).
 " 
 sysv_shmem.c:00000110:  "If the request size is already small, it's possible that it is less than " 
 sysv_shmem.c:00000111:  "your kernel's SHMMIN parameter, in which case raising the request size or " 
 sysv_shmem.c:00000112:  "reconfiguring SHMMIN is called for.
 " 
 sysv_shmem.c:00000113:  "The PostgreSQL documentation contains more information about shared " 
 sysv_shmem.c:00000114:  "memory configuration.", 
 sysv_shmem.c:00000115:  (unsigned long) size, NBuffers, MaxBackends) : 0, 
 sysv_shmem.c:00000116:  (errno == ENOMEM) ? 
 sysv_shmem.c:00000117:  errhint("This error usually means that PostgreSQL's request for a shared " 
 sysv_shmem.c:00000118:  "memory segment exceeded available memory or swap space. " 
 sysv_shmem.c:00000119:  "To reduce the request size (currently %lu bytes), reduce " 
 sysv_shmem.c:00000120:  "PostgreSQL's shared_buffers parameter (currently %d) and/or " 
 sysv_shmem.c:00000121:  "its max_connections parameter (currently %d).
 " 
 sysv_shmem.c:00000122:  "The PostgreSQL documentation contains more information about shared " 
 sysv_shmem.c:00000123:  "memory configuration.", 
 sysv_shmem.c:00000124:  (unsigned long) size, NBuffers, MaxBackends) : 0, 
 sysv_shmem.c:00000125:  (errno == ENOSPC) ? 
 sysv_shmem.c:00000126:  errhint("This error does *not* mean that you have run out of disk space. " 
 sysv_shmem.c:00000127:  "It occurs either if all available shared memory IDs have been taken, " 
 sysv_shmem.c:00000128:  "in which case you need to raise the SHMMNI parameter in your kernel, " 
 sysv_shmem.c:00000129:  "or because the system's overall limit for shared memory has been " 
 sysv_shmem.c:00000130:  "reached. If you cannot increase the shared memory limit, " 
 sysv_shmem.c:00000131:  "reduce PostgreSQL's shared memory request (currently %lu bytes), " 
 sysv_shmem.c:00000132:  "by reducing its shared_buffers parameter (currently %d) and/or " 
 sysv_shmem.c:00000133:  "its max_connections parameter (currently %d).
 " 
 sysv_shmem.c:00000134:  "The PostgreSQL documentation contains more information about shared " 
 sysv_shmem.c:00000135:  "memory configuration.", 
 sysv_shmem.c:00000136:  (unsigned long) size, NBuffers, MaxBackends) : 0)); 
