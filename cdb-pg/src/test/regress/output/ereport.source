 faba: formatting:00000517: #define DCH_S_FM 0x01 
 faba: formatting:00000518: #define DCH_S_TH 0x02 
 faba: formatting:00000519: #define DCH_S_th 0x04 
 faba: formatting:00000520: #define DCH_S_SP 0x08 
 faba: formatting:00000521: #define DCH_S_TM 0x10 
 faba: formatting:00000522:  
 faba: formatting:00000523: /* ---------- 
 faba: formatting:00000524:  * Suffix tests 
 faba: formatting:00000525:  * ---------- 
 faba: formatting:00000526:  */ 
 faba: formatting:00000527: #define S_THth(_s) ((((_s) & DCH_S_TH) *PIPE**PIPE* ((_s) & DCH_S_th)) ? 1 : 0) 
 faba: formatting:00000528: #define S_TH(_s) (((_s) & DCH_S_TH) ? 1 : 0) 
 faba: formatting:00000529: #define S_th(_s) (((_s) & DCH_S_th) ? 1 : 0) 
 faba: formatting:00000530: #define S_TH_TYPE(_s) (((_s) & DCH_S_TH) ? TH_UPPER : TH_LOWER) 
 faba: formatting:00000531:  
 faba: formatting:00000532: #define S_FM(_s) (((_s) & DCH_S_FM) ? 1 : 0) 
 faba: formatting:00000533: #define S_SP(_s) (((_s) & DCH_S_SP) ? 1 : 0) 
 faba: formatting:00000534: #define S_TM(_s) (((_s) & DCH_S_TM) ? 1 : 0) 
 faba: formatting:00000535:  
 faba: formatting:00000536: /* ---------- 
 faba: formatting:00000537:  * Suffixes definition for DATE-TIME TO/FROM CHAR 
 faba: formatting:00000538:  * ---------- 
 faba: formatting:00000539:  */ 
 faba: formatting:00000540: static KeySuffix DCH_suff[] = { 
