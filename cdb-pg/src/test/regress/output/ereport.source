 caah: cdbdisp:00000456:  * It should not longjmp out via elog(ERROR, ...), ereport(ERROR, ...), 
 caah: cdbdisp:00000457:  * PG_THROW, CHECK_FOR_INTERRUPTS, etc. 
 caah: cdbdisp:00000458:  * 
 caah: cdbdisp:00000459:  * Note: the maxSlices argument is used to allocate the parameter 
 caah: cdbdisp:00000460:  * blocks for dispatch, it should be set to the maximum number of 
 caah: cdbdisp:00000461:  * slices in a plan. For dispatch of single commands (ie most uses of 
 caah: cdbdisp:00000462:  * cdbdisp_dispatchToGang()), setting it to 1 is fine. 
 caah: cdbdisp:00000463:  */ 
 caah: cdbdisp:00000464: void 
 caah: cdbdisp:00000465: cdbdisp_dispatchToGang(struct CdbDispatcherState *ds, 
 caah: cdbdisp:00000466:  GpDispatchCommandType mppDispatchCommandType, 
 caah: cdbdisp:00000467:  void *commandTypeParms, 
 caah: cdbdisp:00000468:  struct Gang *gp, 
 caah: cdbdisp:00000469:  int sliceIndex, 
 caah: cdbdisp:00000470:  unsigned int maxSlices, 
 caah: cdbdisp:00000471:  CdbDispatchDirectDesc *disp_direct) 
 caah: cdbdisp:00000472: { 
 caah: cdbdisp:00000473:  struct CdbDispatchResults *dispatchResults = ds->primaryResults; 
 caah: cdbdisp:00000736:  ereport(FATAL, (errcode(ERRCODE_INTERNAL_ERROR), 
 caah: cdbdisp:00000737:  errmsg("dispatchToGang: failed to create thread %d of %d", i + 1, newThreads), 
 caah: cdbdisp:00000738:  errdetail("pthread_create() failed with err %d", pthread_err), 
 caah: cdbdisp:00000739:  errhint("gp_connections_per_thread controls the number of threads created during parallel dispatch, current setting is %d increase the setting to spawn fewer threads", gp_connections_per_thread))); 
 caah: cdbdisp:00001138:  ereport(ERROR, (errcode(ERRCODE_OUT_OF_MEMORY), 
