--
-- csv (mpp-1519, etc)
--
CREATE EXTERNAL TABLE gpfdist_csv_start (x text)
execute E'((@gpwhich_gpfdist@ -p 8080 -d @abs_srcdir@/data  -q \'"\' -h  </dev/null >/dev/null 2>&1 &); echo "starting...") '
on SEGMENT 0
FORMAT 'text' (delimiter '|');
