SELECT 
'TPCH QUERY 03', l_orderkey, sum(l_extendedprice*(1-l_discount)) as revenue,o_orderdate, o_shippriority
FROM
ext_customer, ext_orders, ext_lineitem 
WHERE 
c_mktsegment = 'BUILDING' and 
c_custkey = o_custkey and 
l_orderkey = o_orderkey and 
o_orderdate < date '15-mar-1995' and l_shipdate > date '15-mar-1995' 
GROUP BY l_orderkey, o_orderdate, o_shippriority
ORDER BY revenue desc, o_orderdate limit 10;
   ?column?    | l_orderkey |   revenue   | o_orderdate | o_shippriority 
