CREATE OPERATOR @gpupgradeschemaname@./ (PROCEDURE = int28div, LEFTARG = "int2", RIGHTARG = "int8", OID=327);

-- MPP-16121
-- When commutator/negator is specified, we need to define ones with greater OID first,
-- otherwise installcheck fails.  This is because the backend creates a shell operator
-- first with a smaller OID but the catdump dumps the commutator option in only the
-- operators with the smaller OIDs.  For the actual upgrade, this order doesn't matter
-- because the OID is fixed by the OID option.
CREATE OPERATOR @gpupgradeschemaname@.* (PROCEDURE = int28mul, LEFTARG = "int2", RIGHTARG = "int8", OID=326, COMMUTATOR=OPERATOR(@gpupgradeschemaname@.*));

CREATE OPERATOR @gpupgradeschemaname@.- (PROCEDURE = int28mi, LEFTARG = "int2", RIGHTARG = "int8", OID=325);

CREATE OPERATOR @gpupgradeschemaname@.+ (PROCEDURE = int28pl, LEFTARG = "int2", RIGHTARG = "int8", OID=324, COMMUTATOR=OPERATOR(@gpupgradeschemaname@.+));

CREATE OPERATOR @gpupgradeschemaname@./ (PROCEDURE = int82div, LEFTARG = "int8", RIGHTARG = "int2", OID=323);

CREATE OPERATOR @gpupgradeschemaname@.* (PROCEDURE = int82mul, LEFTARG = "int8", RIGHTARG = "int2", OID=322, COMMUTATOR=OPERATOR(@gpupgradeschemaname@.*));

CREATE OPERATOR @gpupgradeschemaname@.- (PROCEDURE = int82mi, LEFTARG = "int8", RIGHTARG = "int2", OID=321);

CREATE OPERATOR @gpupgradeschemaname@.+ (PROCEDURE = int82pl, LEFTARG = "int8", RIGHTARG = "int2", OID=320, COMMUTATOR=OPERATOR(@gpupgradeschemaname@.+));

--    pg_cast    --
-- Create a special schema for use by the pg_cast_load external table.
-- We cannot use gpupgradeschemaname (pg_catalog), as that will see the external
-- table executed on the master only.
CREATE SCHEMA __@gpupgradeschemaname@_gpmigrator;

\set pg_cast_datafile `echo "'$GPHOME/share/postgresql/upgrade/pg_cast.data'"`

-- Add entries to the master.
COPY @gpupgradeschemaname@.pg_cast FROM
	:pg_cast_datafile WITH OIDS DELIMITER ',';

CREATE EXTERNAL WEB TABLE
	__@gpupgradeschemaname@_gpmigrator.pg_cast_load(database text,
													port text,
													status text)
	EXECUTE E' PGOPTIONS=''-c gp_session_role=utility'' \\
		psql -q --set ON_ERROR_STOP=ON -p $GP_SEG_PORT \\
		--command "copy @gpupgradeschemaname@.pg_cast from \\
		''$GPHOME/share/postgresql/upgrade/pg_cast.data'' with oids csv" \\
		$GP_DATABASE $GP_USER && echo "$GP_DATABASE, $GP_SEG_PORT, done";'
	FORMAT 'csv';

SELECT * FROM __@gpupgradeschemaname@_gpmigrator.pg_cast_load;

DROP EXTERNAL WEB TABLE __@gpupgradeschemaname@_gpmigrator.pg_cast_load;

DROP SCHEMA __@gpupgradeschemaname@_gpmigrator;

