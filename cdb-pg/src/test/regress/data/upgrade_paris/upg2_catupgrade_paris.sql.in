	AS 'complex_send' WITH (OID=9029);
COMMENT ON FUNCTION @gpupgradeschemaname@.complex_send(@gpupgradeschemaname@.complex)  IS 'IO';

CREATE TYPE @gpupgradeschemaname@.complex(
   INPUT = @gpupgradeschemaname@.complex_in,
   OUTPUT = @gpupgradeschemaname@.complex_out,
   RECEIVE = @gpupgradeschemaname@.complex_recv,
   SEND = @gpupgradeschemaname@.complex_send,
   INTERNALLENGTH = 16,
   STORAGE = plain,
   DELIMITER = ',',
   ALIGNMENT = double,
   TYPTYPE = 'b',
   SHADOWOID = 2972
);
COMMENT ON TYPE @gpupgradeschemaname@.complex IS 'double-precision floating point complex number, 16-byte storage';

