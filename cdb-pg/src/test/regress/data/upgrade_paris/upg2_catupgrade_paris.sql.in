-- MPP-17173/ MPP-17183 - eliminate NULLs in pg_extprotocol's OID columns
SELECT catDML(
'UPDATE pg_extprotocol
 SET ptcreadfn = CASE WHEN ptcreadfn IS NULL THEN 0 ELSE ptcreadfn END,
     ptcwritefn = CASE WHEN ptcwritefn IS NULL THEN 0 ELSE ptcwritefn END,
     ptcvalidatorfn = CASE WHEN ptcvalidatorfn IS NULL THEN 0 ELSE ptcvalidatorfn END'
);

-- MPP-17634 add pg_window.winnulltreatment
ALTER TABLE @gpupgradeschemaname@.pg_window
    ADD COLUMN winnulltreatment boolean;
SELECT catDML(
'UPDATE @gpupgradeschemaname@.pg_window SET winnulltreatment = ''t''
 FROM pg_proc WHERE pg_proc.oid = pg_window.winfnoid AND
      (pg_proc.proname = ''first_value'' OR pg_proc.proname = ''last_value'')
      AND pg_proc.oid < 10000'
);
SELECT catDML(
'UPDATE @gpupgradeschemaname@.pg_window SET winnulltreatment = ''f''
 WHERE winnulltreatment IS NULL'
);
ALTER TABLE @gpupgradeschemaname@.pg_window
    ALTER COLUMN winnulltreatment SET NOT NULL;

-- MPP-17860 add pg_window.winframemakerfunc
ALTER TABLE @gpupgradeschemaname@.pg_window
    ADD COLUMN winframemakerfunc regproc;
SELECT catDML(
'UPDATE @gpupgradeschemaname@.pg_window SET winframemakerfunc = 5081
 FROM pg_proc WHERE pg_proc.oid = pg_window.winfnoid AND
      (pg_proc.proname = ''lead'' OR pg_proc.proname = ''lag'')
      AND pg_proc.oid < 10000'
);
SELECT catDML(
'UPDATE @gpupgradeschemaname@.pg_window SET winframemakerfunc = 0
 WHERE winframemakerfunc IS NULL'
);
ALTER TABLE @gpupgradeschemaname@.pg_window
    ALTER COLUMN winframemakerfunc SET NOT NULL;

