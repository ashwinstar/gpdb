----------------------------------------
--  Put a PIN on all the newly created catalog objs*
--     *note: we're only dealing with pg_proc becauase in this release
--            the only new objects are functions.
----------------------------------------
BEGIN;
-- Use this pl/pgsql function and the fake web tab to execute DML on cat tab on all segs
create or replace function public.catDML(stmt text) returns int as $$
begin
  execute stmt;
  return 1;
end;
$$ language 'plpgsql';

create external web table public.fake_web_t1(c1 text) execute 'echo $GP_SEGMENT_ID'
format 'TEXT';

select catDML('INSERT INTO pg_depend SELECT 0,0,0, tableoid,oid,0, ''p'' FROM pg_proc
        where (tableoid,oid) not in (Select refclassid, refobjid from pg_depend)
          and pronamespace = 11');

drop function public.catDML(stmt text);
drop external web table public.fake_web_t1;
commit;
