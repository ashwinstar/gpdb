--
-- OLAP_GROUP - Test OLAP GROUP BY extensions
--
-- Syntactic equivalents --
--begin equivalent
select count(*) from sale;
 count 
-------
    12
(1 row)

select count(*) from sale group by ();
 count 
-------
    12
(1 row)

--end equivalent
--begin equivalent
select cn, count(*) from sale group by cn;
 cn | count 
----+-------
  3 |     3
  1 |     5
  4 |     2
  2 |     2
(4 rows)

select cn, count(*) from sale group by (), cn;
 cn | count 
----+-------
  3 |     3
  1 |     5
  4 |     2
  2 |     2
(4 rows)

select cn, count(*) from sale group by cn, ();
 cn | count 
----+-------
  3 |     3
  1 |     5
  4 |     2
  2 |     2
(4 rows)

--end equivalent
--begin equivalent
select cn, vn, count(*) from sale group by cn, vn;
 cn | vn | count 
----+----+-------
  1 | 10 |     1
  1 | 20 |     1
  3 | 30 |     2
  1 | 30 |     2
  3 | 40 |     1
  1 | 50 |     1
