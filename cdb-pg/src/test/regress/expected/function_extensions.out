  _a   | _c  
-------+-----
 Hello | 100
(1 row)

select * from dfunc(c => 100, a => 'Hello');
  _a   | _c  
-------+-----
 Hello | 100
(1 row)

select * from dfunc('Hello');
  _a   | _c 
-------+----
 Hello |   
(1 row)

select * from dfunc('Hello', c => 100);
  _a   | _c  
-------+-----
 Hello | 100
(1 row)

select * from dfunc(c => 100);
  _a   | _c  
-------+-----
 def a | 100
(1 row)

