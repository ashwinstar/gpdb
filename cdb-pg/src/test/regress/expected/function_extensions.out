returns record as $$
  select $1, $2;
$$ language sql;
select (dfunc()).*;
  _a   | _c 
-------+----
 def a |   
(1 row)

select * from dfunc();
  _a   | _c 
-------+----
 def a |   
(1 row)

select * from dfunc('Hello', 100);
  _a   | _c  
-------+-----
