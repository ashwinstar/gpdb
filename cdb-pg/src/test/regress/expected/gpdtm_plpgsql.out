abort;
DROP TABLE foo;
-- try to guarantee race-condition failures on the tests below.
SET GP_ENABLE_SLOW_CURSOR_TESTMODE=on;
BEGIN;
SET TRANSACTION ISOLATION LEVEL SERIALIZABLE;
CREATE TABLE foo (a int, b int);
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause -- Using column named 'a' as the Greenplum Database data distribution key for this table.
HINT:  The 'DISTRIBUTED BY' clause determines the distribution of data. Make sure column(s) chosen are the optimal data distribution key to minimize skew.
INSERT INTO foo VALUES (0, 1);
DECLARE c1 NO SCROLL CURSOR FOR SELECT b FROM foo;
UPDATE foo SET b = 2;
FETCH ALL FROM c1;
 b 
---
 1
(1 row)

COMMIT;
DROP TABLE foo;
BEGIN;
SET TRANSACTION ISOLATION LEVEL SERIALIZABLE;
CREATE TABLE foo (a int, b int);
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause -- Using column named 'a' as the Greenplum Database data distribution key for this table.
HINT:  The 'DISTRIBUTED BY' clause determines the distribution of data. Make sure column(s) chosen are the optimal data distribution key to minimize skew.
INSERT INTO foo VALUES (0, 1);
UPDATE foo SET b = 2;
DECLARE c1 NO SCROLL CURSOR FOR SELECT b FROM foo;
UPDATE foo SET b = 3;
FETCH ALL FROM c1;
 b 
---
 2
(1 row)

COMMIT;
DROP TABLE foo;
BEGIN;
SET TRANSACTION ISOLATION LEVEL SERIALIZABLE;
CREATE TABLE foo (a int, b int);
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause -- Using column named 'a' as the Greenplum Database data distribution key for this table.
HINT:  The 'DISTRIBUTED BY' clause determines the distribution of data. Make sure column(s) chosen are the optimal data distribution key to minimize skew.
INSERT INTO foo VALUES (0, 1);
UPDATE foo SET b = 2;
DECLARE c1 NO SCROLL CURSOR FOR SELECT b FROM foo;
DELETE FROM foo;
INSERT INTO foo VALUES (0, 3);
UPDATE foo SET b = 4;
INSERT INTO foo VALUES (0, 5);
FETCH ALL FROM c1;
 b 
---
 2
(1 row)

COMMIT;
