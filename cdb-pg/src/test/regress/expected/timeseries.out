insert into gapinput values
     (0, 0, -1, -1, timestamp '2012-07-07');
 
-- start_equiv
select qk, sk, b
from gapinput
sequence q as (
	order by sk
	with qk every interval '2 months' between timestamp '2012-04-01' and timestamp '2012-08-31' )
order by qk, sk, b;
            qk            |            sk            | b 
--------------------------+--------------------------+---
 Sun Apr 01 00:00:00 2012 |                          |  
 Fri Jun 01 00:00:00 2012 | Sat Jul 07 00:00:00 2012 | 0
 Wed Aug 01 00:00:00 2012 |                          |  
(3 rows)

with
	sequence_parameters as (
		select step, start, stop
		from (values (interval '2 months', timestamp '2012-04-01', timestamp '2012-08-31'))
			sequence_parameters(step, start, stop)
		),
	clock as (
		select start + i * step as qk
		from generate_series(0, 10) i(i), sequence_parameters
		where start + i * step <= stop
	),
	augmented as (
		select b, pk1, pk2, sk, interval_bound(sk, step, 0, start) as qk
		from gapinput, sequence_parameters
		),
	filled as (
		select b, pk1, pk2, sk, coalesce(a.qk, c.qk) as qk
		from 
			augmented a
				full outer join
				clock c
				using (qk)
		),
	some_rows as (
		select null as dummy
		from gapinput
		having count(*) > 0
	)
select qk, sk, b
from filled, some_rows
order by qk, sk, b;
            qk            |            sk            | b 
--------------------------+--------------------------+---
 Sun Apr 01 00:00:00 2012 |                          |  
 Fri Jun 01 00:00:00 2012 | Sat Jul 07 00:00:00 2012 | 0
 Wed Aug 01 00:00:00 2012 |                          |  
(3 rows)

-- end_equiv
 
-- start_equiv mvd 1,2->3
select pk1, pk2, qk, sk, b
from gapinput
sequence q as (
	partition by pk1, pk2
	order by sk
	with qk every interval '2 months' between timestamp '2012-04-01' and timestamp '2012-08-31' )
order by pk1, pk2, qk, sk, b;
 pk1 | pk2 |            qk            |            sk            | b 
-----+-----+--------------------------+--------------------------+---
  -1 |  -1 | Sun Apr 01 00:00:00 2012 |                          |  
  -1 |  -1 | Fri Jun 01 00:00:00 2012 | Sat Jul 07 00:00:00 2012 | 0
  -1 |  -1 | Wed Aug 01 00:00:00 2012 |                          |  
(3 rows)

with
	sequence_parameters as (
		select step, start, stop
		from (values (interval '2 months', timestamp '2012-04-01', timestamp '2012-08-31'))
			sequence_parameters(step, start, stop)
		),
	clock as (
		select start + i * step as qk
		from generate_series(0, 10) i(i), sequence_parameters
		where start + i * step <= stop
	),
	keys as (
		select distinct pk1, pk2
		from gapinput
		),
	partitioned_clock as (
		select pk1, pk2, qk
		from keys, clock
		),
	augmented as (
		select b, pk1, pk2, sk, interval_bound(sk, step, 0, start) as qk
		from gapinput, sequence_parameters
		),
	filled as (
		select b, pk1, pk2, sk, coalesce(a.qk, c.qk) as qk
		from 
			augmented a
				full outer join
				partitioned_clock c
				using (pk1, pk2, qk)
		),
	some_rows as (
		select pk1, pk2
		from gapinput
		group by pk1, pk2
		having count(*) > 0
	)
select pk1, pk2, qk, sk, b
from filled
	natural join
	some_rows
order by pk1, pk2, qk, sk, b;
 pk1 | pk2 |            qk            |            sk            | b 
-----+-----+--------------------------+--------------------------+---
  -1 |  -1 | Sun Apr 01 00:00:00 2012 |                          |  
  -1 |  -1 | Fri Jun 01 00:00:00 2012 | Sat Jul 07 00:00:00 2012 | 0
  -1 |  -1 | Wed Aug 01 00:00:00 2012 |                          |  
(3 rows)

-- end_equiv
 
select 
    qk, sk, b,
    sequence_index() over (q) as si,
    count(*) over (q) as cq,
    count(*) over () as cn,
    rank() over (q) as rk,
    dense_rank() over (q) as dr
from gapinput
