    interval_bound(v, w) as "normal", 
    interval_bound(v, w, s) as "shifted s",
    interval_bound(v, w, s, r) as "and registered to r"
from ( values
        (timestamptz '2012-01-12 10:00:10', interval '1 week', timestamptz '2012-04-02 00:00:00 US/Eastern', 4),
        (timestamptz '1929-10-29 22:33:44.55', interval '1 year', timestamptz '1991-01-17 02:34:56.78', null),
        (timestamptz '1991-01-17 02:34:56.78', interval '1 year -1 month', timestamptz '1776-07-04 12:34:56 US/Eastern', -1),
        (timestamptz '2100-03-01 11:11:11.11 UTC', interval '100 days', timestamptz '1929-10-29 22:33:44.55', 1),
        (timestamptz '1776-07-04 12:34:56', interval '1 month', timestamptz '2012-04-01 00:00:00 UTC', 1)
    ) r(v,w,r,s);
                v                |     w      |                r                | s  |            normal            |          shifted s           |       and registered to r       
---------------------------------+------------+---------------------------------+----+------------------------------+------------------------------+---------------------------------
 Thu Jan 12 10:00:10 2012 PST    | @ 7 days   | Sun Apr 01 21:00:00 2012 PDT    |  4 | Wed Jan 11 16:00:00 2012 PST | Wed Feb 08 16:00:00 2012 PST | Sun Feb 05 21:00:00 2012 PST
 Tue Oct 29 22:33:44.55 1929 PST | @ 1 year   | Thu Jan 17 02:34:56.78 1991 PST |    | Mon Dec 31 16:00:00 1928 PST | Mon Dec 31 16:00:00 1928 PST | Thu Jan 17 02:34:56.78 1929 PST
 Thu Jan 17 02:34:56.78 1991 PST | @ 11 mons  | Thu Jul 04 09:38:00 1776 LMT    | -1 | Wed Feb 28 16:00:00 1990 PST | Fri Mar 31 16:00:00 1989 PST | Sun Feb 04 09:38:00 1990 PST
 Mon Mar 01 03:11:11.11 2100 PST | @ 100 days | Tue Oct 29 22:33:44.55 1929 PST |  1 | Mon Jan 18 16:00:00 2100 PST | Wed Apr 28 16:00:00 2100 PDT | Tue May 25 22:33:44.55 2100 PDT
 Thu Jul 04 12:34:56 1776 LMT    | @ 1 mon    | Sat Mar 31 17:00:00 2012 PDT    |  1 | Sun Jun 30 16:00:00 1776 LMT | Wed Jul 31 16:00:00 1776 LMT | Wed Jul 31 17:00:00 1776 LMT
(5 rows)

-- Gap-filling
drop table if exists gapinput cascade; -- ignore
NOTICE:  table "gapinput" does not exist, skipping
create table gapinput
(
	a int, 
	b int, 
	pk1 int,
	pk2 int,
	sk int
)
distributed randomly;
delete from gapinput; -- ignore
 
-- start_equiv
select qk, sk, b
from gapinput
sequence q as (
	order by sk
	with qk every 2 between 4 and 8 )
order by qk, sk, b;
 qk | sk | b 
----+----+---
(0 rows)

with
	sequence_parameters as (
		select step, start, stop
		from (values (2, 4, 8))
			sequence_parameters(step, start, stop)
		),
	clock as (
		select start + i * step as qk
		from generate_series(0, 10) i(i), sequence_parameters
		where start + i * step <= stop
	),
	augmented as (
		select b, pk1, pk2, sk, interval_bound(sk, step, 0, start) as qk
		from gapinput, sequence_parameters
		),
	filled as (
		select b, pk1, pk2, sk, coalesce(a.qk, c.qk) as qk
		from 
			augmented a
				full outer join
				clock c
				using (qk)
		),
	some_rows as (
		select null as dummy
		from gapinput
		having count(*) > 0
	)
select qk, sk, b
from filled, some_rows
order by qk, sk, b;
 qk | sk | b 
----+----+---
(0 rows)

-- end_equiv
 
-- start_equiv mvd 1,2->3
select pk1, pk2, qk, sk, b
from gapinput
sequence q as (
	partition by pk1, pk2
	order by sk
	with qk every 2 between 4 and 8 )
order by pk1, pk2, qk, sk, b;
 pk1 | pk2 | qk | sk | b 
-----+-----+----+----+---
(0 rows)

with
	sequence_parameters as (
		select step, start, stop
		from (values (2, 4, 8))
			sequence_parameters(step, start, stop)
		),
	clock as (
		select start + i * step as qk
		from generate_series(0, 10) i(i), sequence_parameters
		where start + i * step <= stop
	),
	keys as (
		select distinct pk1, pk2
		from gapinput
		),
	partitioned_clock as (
		select pk1, pk2, qk
		from keys, clock
		),
	augmented as (
		select b, pk1, pk2, sk, interval_bound(sk, step, 0, start) as qk
		from gapinput, sequence_parameters
		),
	filled as (
		select b, pk1, pk2, sk, coalesce(a.qk, c.qk) as qk
		from 
			augmented a
				full outer join
				partitioned_clock c
				using (pk1, pk2, qk)
		),
	some_rows as (
		select pk1, pk2
		from gapinput
		group by pk1, pk2
		having count(*) > 0
	)
select pk1, pk2, qk, sk, b
from filled
	natural join
	some_rows
order by pk1, pk2, qk, sk, b;
 pk1 | pk2 | qk | sk | b 
-----+-----+----+----+---
(0 rows)

-- end_equiv
 
select 
    qk, sk, b,
    sequence_index() over (q) as si,
    count(*) over (q) as cq,
    count(*) over () as cn,
    rank() over (q) as rk,
    dense_rank() over (q) as dr
from gapinput
sequence q as (
	order by sk
	with qk every 2 between 4 and 8 )
order by si, qk, sk, b;
 qk | sk | b | si | cq | cn | rk | dr 
----+----+---+----+----+----+----+----
(0 rows)

select 
    pk1, pk2, qk, sk, b, 
    sequence_index() over (q) as si,
    count(*) over (q) as cq, 
    count(*) over (partition by pk1, pk2) as cp, 
    count(*) over () as cn,
    rank() over (q) as rk,
    dense_rank() over (q) as dr
from gapinput
sequence q as (
	partition by pk1, pk2
	order by sk
	with qk every 2 between 4 and 8 )
order by pk1, pk2, qk, si, sk, b;
 pk1 | pk2 | qk | sk | b | si | cq | cp | cn | rk | dr 
-----+-----+----+----+---+----+----+----+----+----+----
(0 rows)

delete from gapinput; -- ignore
insert into gapinput values
     (0, 0, -1, -1, 7);
 
