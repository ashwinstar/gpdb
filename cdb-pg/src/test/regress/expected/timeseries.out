select pk1, pk2, qk, sk, b
from gapinput
sequence q as (
	partition by pk1, pk2
	order by sk
	with qk every 2 between 4 and 8 )
order by pk1, pk2, qk, sk, b;
 pk1 | pk2 | qk | sk | b 
-----+-----+----+----+---
  -1 |  -1 |  0 |  1 | 0
  -1 |  -1 |  4 |    |  
  -1 |  -1 |  6 |    |  
  -1 |  -1 |  8 |    |  
(4 rows)

with
	sequence_parameters as (
		select step, start, stop
		from (values (2, 4, 8))
			sequence_parameters(step, start, stop)
		),
	clock as (
		select start + i * step as qk
		from generate_series(0, 10) i(i), sequence_parameters
		where start + i * step <= stop
	),
	keys as (
		select distinct pk1, pk2
		from gapinput
		),
	partitioned_clock as (
		select pk1, pk2, qk
		from keys, clock
		),
	augmented as (
		select b, pk1, pk2, sk, interval_bound(sk, step, 0, start) as qk
		from gapinput, sequence_parameters
		),
	filled as (
		select b, pk1, pk2, sk, coalesce(a.qk, c.qk) as qk
		from 
			augmented a
				full outer join
				partitioned_clock c
				using (pk1, pk2, qk)
		),
	some_rows as (
		select pk1, pk2
		from gapinput
		group by pk1, pk2
		having count(*) > 0
	)
select pk1, pk2, qk, sk, b
from filled
	natural join
	some_rows
order by pk1, pk2, qk, sk, b;
 pk1 | pk2 | qk | sk | b 
-----+-----+----+----+---
  -1 |  -1 |  0 |  1 | 0
  -1 |  -1 |  4 |    |  
  -1 |  -1 |  6 |    |  
  -1 |  -1 |  8 |    |  
(4 rows)

-- end_equiv
 
select 
    qk, sk, b,
    sequence_index() over (q) as si,
    count(*) over (q) as cq,
    count(*) over () as cn,
    rank() over (q) as rk,
    dense_rank() over (q) as dr
from gapinput
sequence q as (
	order by sk
	with qk every 2 between 4 and 8 )
order by si, qk, sk, b;
 qk | sk | b | si | cq | cn | rk | dr 
----+----+---+----+----+----+----+----
  0 |  1 | 0 |  1 |  4 |  4 |  1 |  1
  4 |    |   |  1 |  4 |  4 |  1 |  1
  6 |    |   |  1 |  4 |  4 |  1 |  1
  8 |    |   |  1 |  4 |  4 |  1 |  1
(4 rows)

select 
    pk1, pk2, qk, sk, b, 
    sequence_index() over (q) as si,
    count(*) over (q) as cq, 
    count(*) over (partition by pk1, pk2) as cp, 
    count(*) over () as cn,
    rank() over (q) as rk,
    dense_rank() over (q) as dr
from gapinput
sequence q as (
	partition by pk1, pk2
	order by sk
	with qk every 2 between 4 and 8 )
order by pk1, pk2, qk, si, sk, b;
 pk1 | pk2 | qk | sk | b | si | cq | cp | cn | rk | dr 
-----+-----+----+----+---+----+----+----+----+----+----
  -1 |  -1 |  0 |  1 | 0 |  1 |  4 |  4 |  4 |  1 |  1
  -1 |  -1 |  4 |    |   |  1 |  4 |  4 |  4 |  1 |  1
  -1 |  -1 |  6 |    |   |  1 |  4 |  4 |  4 |  1 |  1
  -1 |  -1 |  8 |    |   |  1 |  4 |  4 |  4 |  1 |  1
(4 rows)

