CREATE EXTERNAL WEB TABLE get_tc (x text)
execute E'(find /Users/jcohen/dev/cdb2/main/cdb-pg/src/test/regress/../../include/catalog -name \'pg_*.h\'  | xargs perl /Users/jcohen/dev/cdb2/main/cdb-pg/src/test/regress/../../include/catalog/tidycat.pl -sql /Users/jcohen/dev/cdb2/main/cdb-pg/src/test/regress/data/tidyddl.sql 2>&1 > /dev/null ; sleep 3; perl -i -ple \' s/^\\s*with\\s*\\(.*\\)\\s*//gm \' /Users/jcohen/dev/cdb2/main/cdb-pg/src/test/regress/data/tidyddl.sql ; sleep 3)' 
FORMAT 'text' (delimiter '|');
select * from get_tc order by 1;
