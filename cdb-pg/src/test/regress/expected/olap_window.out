-- Test for MPP-1756, the planner should create just the one key level
explain select cn,
sum(qty) over (order by cn rows between 1 preceding and 1 following),
sum(qty) over (order by cn rows between 1 preceding and 1 following)
from sale;
                              QUERY PLAN                              
----------------------------------------------------------------------
 Window  (cost=1.02..1.05 rows=1 width=8)
   Order By: cn
   ->  Gather Motion 2:1  (slice1)  (cost=1.02..1.04 rows=1 width=8)
         Merge Key: cn
         ->  Sort  (cost=1.02..1.02 rows=1 width=8)
               Sort Key: cn
               ->  Seq Scan on sale  (cost=0.00..1.01 rows=1 width=8)
(7 rows)

