---- X -- Miscellaneous (e.g. old bugs, etc.) ----
select 
    cn*100 + row_number() over (), 
    cname, 
    row_number() over () - 1, 
    cn 
from customer; -- mvd 4->1,3
 ?column? |    cname     | ?column? | cn 
----------+--------------+----------+----
      101 | Macbeth      |        0 |  1
      302 | Lady Macbeth |        1 |  3
      203 | Duncan       |        2 |  2
      404 | Witches, Inc |        3 |  4
(4 rows)

