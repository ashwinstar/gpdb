------------+-----+----+----+------------+------+------+--------------+--------------+-----------+-----------
          1 | 300 |  1 | 30 | 05-02-1401 |    1 |    0 | Macbeth      | Inverness    | Castle    | Grey
          2 | 400 |  1 | 50 | 06-01-1401 |    1 |    0 | Macbeth      | Inverness    | Justice   | Clear
          3 | 500 |  1 | 30 | 06-01-1401 |   12 |    5 | Macbeth      | Inverness    | Donuts    | Plain
          4 | 500 |  3 | 30 | 06-01-1401 |   12 |    5 | Lady Macbeth | Inverness    | Donuts    | Plain
          5 | 400 |  2 | 50 | 06-01-1401 |    1 |    0 | Duncan       | Forres       | Justice   | Clear
          6 | 800 |  4 | 40 | 06-01-1401 |    1 |    1 | Witches, Inc | Lonely Heath | Fries     | Grey
          7 | 100 |  2 | 40 | 01-01-1401 | 1100 | 2400 | Duncan       | Forres       | Sword     | Black
          8 | 700 |  4 | 40 | 06-01-1401 |    1 |    1 | Witches, Inc | Lonely Heath | Hamburger | Grey
          9 | 200 |  1 | 10 | 03-01-1401 |    1 |    0 | Macbeth      | Inverness    | Dream     | Black
         10 | 200 |  3 | 40 | 04-01-1401 |    1 |    0 | Lady Macbeth | Inverness    | Dream     | Black
         11 | 100 |  1 | 20 | 05-01-1401 |    1 |    0 | Macbeth      | Inverness    | Sword     | Black
         12 | 600 |  3 | 30 | 06-01-1401 |   12 |    5 | Lady Macbeth | Inverness    | Donuts    | Chocolate
(12 rows)

select row_number() over (), vn, count(*), sum(qty*prc) as amt
from sale group by vn; --xxxmvd -> 1
 row_number | vn | count |   amt   
------------+----+-------+---------
          1 | 50 |     2 |       0
          2 | 40 |     4 | 2640002
          3 | 30 |     4 |     180
          4 | 20 |     1 |       0
          5 | 10 |     1 |       0
(5 rows)

select row_number() over (), name, loc
from (select vname, vloc from vendor union select cname, cloc from customer) r(name,loc); --xxxmvd -> 1
 row_number |     name     |     loc      
------------+--------------+--------------
          1 | Lady Macbeth | Inverness
          2 | Macbeth      | Inverness
          3 | Duncan       | Forres
          4 | Macduff      | Fife
          5 | Witches, Inc | Lonely Heath
(5 rows)

select row_number() over (), s 
from generate_series(1,3) r(s); --xxxmvd -> 1
 row_number | s 
------------+---
          1 | 1
          2 | 2
          3 | 3
(3 rows)

select row_number() over (), u, v
from ( values (1,2),(3,4),(5,6) ) r(u,v); --xxxmvd -> 1
 row_number | u | v 
------------+---+---
          1 | 1 | 2
          2 | 3 | 4
          3 | 5 | 6
(3 rows)

---- 2 -- Exercise WINDOW Clause ----
select row_number() over (w), * from sale window w as ()
order by 1 desc; --xxxmvd -> 1
 row_number | cn | vn | pn  |     dt     | qty  | prc  
------------+----+----+-----+------------+------+------
         12 |  4 | 40 | 700 | 06-01-1401 |    1 |    1
         11 |  3 | 30 | 500 | 06-01-1401 |   12 |    5
         10 |  1 | 30 | 500 | 06-01-1401 |   12 |    5
          9 |  1 | 50 | 400 | 06-01-1401 |    1 |    0
          8 |  1 | 30 | 300 | 05-02-1401 |    1 |    0
          7 |  2 | 40 | 100 | 01-01-1401 | 1100 | 2400
          6 |  4 | 40 | 800 | 06-01-1401 |    1 |    1
          5 |  3 | 30 | 600 | 06-01-1401 |   12 |    5
          4 |  2 | 50 | 400 | 06-01-1401 |    1 |    0
          3 |  1 | 20 | 100 | 05-01-1401 |    1 |    0
          2 |  3 | 40 | 200 | 04-01-1401 |    1 |    0
          1 |  1 | 10 | 200 | 03-01-1401 |    1 |    0
(12 rows)

select row_number() over (w), * from sale
order by 1 desc
window w as (); --error - window can't follow order by
ERROR:  syntax error at or near "window"
LINE 3: window w as ();
        ^
select * from customer
window
    w1 as (),
    w2 as (w1 partition by cn); --error - can't partition if referencing ordering window
 cn |    cname     |     cloc     
----+--------------+--------------
  1 | Macbeth      | Inverness
  3 | Lady Macbeth | Inverness
  2 | Duncan       | Forres
  4 | Witches, Inc | Lonely Heath
(4 rows)

select * from customer
window
    w1 as (partition by a order by b),
    w2 as (w1 order by cn); --error - can't reorder the ordering window
ERROR:  column "a" does not exist
LINE 3:     w1 as (partition by a order by b),
                                ^
select * from customer
window 
    w1 as (order by cn rows unbounded preceding),
    w2 as (w1); --error - ordering window can't specify framing
 cn |    cname     |     cloc     
----+--------------+--------------
  1 | Macbeth      | Inverness
  3 | Lady Macbeth | Inverness
  2 | Duncan       | Forres
  4 | Witches, Inc | Lonely Heath
(4 rows)

select * from sale
window 
    w as (partition by pn),
    wa as (w order by cn),
    wb as (w order by vn),
    waf as (wa rows between 2 preceding and 3 preceding),
    wbf as (wb range between 2 preceding and 3 preceding);
ERROR:  unrecognized node type: 803 (clauses.c:3572)
    
select * from customer
window 
    w as (partition by cn), 
    w as (w order by cname); --error - can't refer to window in its definition
 cn |    cname     |     cloc     
----+--------------+--------------
  2 | Duncan       | Forres
  4 | Witches, Inc | Lonely Heath
  1 | Macbeth      | Inverness
  3 | Lady Macbeth | Inverness
(4 rows)

select * from customer
window w as (w order by cname); --error - can't refer to window in its definition
 cn |    cname     |     cloc     
----+--------------+--------------
  1 | Macbeth      | Inverness
  3 | Lady Macbeth | Inverness
  2 | Duncan       | Forres
  4 | Witches, Inc | Lonely Heath
(4 rows)

---- 3 -- Partitioned, non-ordered window specifications -- OVER (PARTTION BY ...) ----
select row_number() over (partition by cn), cn, pn from sale; --xxxmvd 2 -> 1
 row_number | cn | pn  
------------+----+-----
          1 |  1 | 200
          2 |  1 | 300
          3 |  1 | 400
          4 |  1 | 500
          5 |  1 | 100
          1 |  3 | 200
          2 |  3 | 500
          3 |  3 | 600
          1 |  2 | 400
          2 |  2 | 100
          1 |  4 | 800
          2 |  4 | 700
(12 rows)

select row_number() over (partition by pn, cn), cn, pn from sale; --xxxmvd 2,3 -> 1
 row_number | cn | pn  
------------+----+-----
          1 |  1 | 100
          1 |  1 | 200
          1 |  3 | 200
          1 |  2 | 400
          1 |  3 | 600
          1 |  4 | 800
          1 |  2 | 100
          1 |  1 | 300
          1 |  1 | 400
          1 |  1 | 500
          1 |  3 | 500
          1 |  4 | 700
(12 rows)

select rank() over (partition by cn), cn, pn from sale; --error - rank requires partitioning
ERROR:  window function "rank" requires a window specification with an ordering clause
select dense_rank() over (partition by cn), cn, pn from sale; --error - dense_rank requires partitioning
ERROR:  window function "dense_rank" requires a window specification with an ordering clause
select row_number() over (partition by pname, cname), pname, cname
