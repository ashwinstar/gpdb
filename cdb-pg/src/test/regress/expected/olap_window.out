------------+----+-------
          1 | 10 |     1
          1 | 20 |     1
          1 | 30 |     4
          1 | 40 |     4
          1 | 50 |     2
(5 rows)

select row_number() over (partition by count(*)), vn, count(*)
from sale 
group by vn; -- mvd 3->1
