 9 | 0.50000000000000000000 | 9.0000000000000000 | 1.00000000000000000000
 9 | 0.50000000000000000000 | 9.0000000000000000 | 1.00000000000000000000
(4 rows)

-- end equivalent
drop table olap_tmp;
