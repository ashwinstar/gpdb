------------+----+-----
          1 |  2 | 400
          2 |  2 | 100
          1 |  4 | 800
          2 |  4 | 700
          1 |  1 | 200
          2 |  1 | 300
          3 |  1 | 400
          4 |  1 | 500
          5 |  1 | 100
          1 |  3 | 200
          2 |  3 | 500
          3 |  3 | 600
(12 rows)

select row_number() over (partition by pn, cn), cn, pn 
from sale; -- mvd 2,3->1
