--
-- Test without inheritance guc
--
set gp_enable_inheritance = false;
drop schema if exists inherit cascade;
NOTICE:  schema "inherit" does not exist, skipping
create schema inherit;
set search_path=inherit;
create table parent(a int);
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause -- Using column named 'a' as the Greenplum Database data distribution key for this table.
HINT:  The 'DISTRIBUTED BY' clause determines the distribution of data. Make sure column(s) chosen are the optimal data distribution key to minimize skew.
create table child() inherits (parent); -- should error out
ERROR:  INHERITANCE support deprecated
--
-- Support inheritance by setting the guc
--
set gp_enable_inheritance = true;
--
-- Test inheritance features
--
CREATE TABLE a (dummy serial, aa TEXT);
NOTICE:  CREATE TABLE will create implicit sequence "a_dummy_seq" for serial column "a.dummy"
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause -- Using column named 'dummy' as the Greenplum Database data distribution key for this table.
HINT:  The 'DISTRIBUTED BY' clause determines the distribution of data. Make sure column(s) chosen are the optimal data distribution key to minimize skew.
CREATE TABLE b (bb TEXT) INHERITS (a);
NOTICE:  Table has parent, setting distribution columns to match parent table
CREATE TABLE c (cc TEXT) INHERITS (a);
NOTICE:  Table has parent, setting distribution columns to match parent table
CREATE TABLE d (dd TEXT) INHERITS (b,c,a);
NOTICE:  Table has parent, setting distribution columns to match parent table
NOTICE:  merging multiple inherited definitions of column "dummy"
NOTICE:  merging multiple inherited definitions of column "aa"
NOTICE:  merging multiple inherited definitions of column "dummy"
NOTICE:  merging multiple inherited definitions of column "aa"
INSERT INTO a(aa) VALUES('aaa');
INSERT INTO a(aa) VALUES('aaaa');
INSERT INTO a(aa) VALUES('aaaaa');
INSERT INTO a(aa) VALUES('aaaaaa');
INSERT INTO a(aa) VALUES('aaaaaaa');
INSERT INTO a(aa) VALUES('aaaaaaaa');
