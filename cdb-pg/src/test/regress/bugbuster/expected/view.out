							T41 DT230
						INNER JOIN
							T83 DT232
						ON
							DT230.C465 > DT232.C1007
						)
					INNER JOIN
						T92 DT229
					ON
						DT230.C456 = DT229.C1125
					)
				INNER JOIN
					T11 DT231
				ON
