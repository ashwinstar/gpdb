						DT229.C1122 > DT230.C456
					)
				)
				AND
				(
					(
						DT229.C1132 = DT230.C454
					)
					AND
					(
						DT229.C1121 = DT230.C459
					)
				)
			GROUP BY
				DT230.C456
				, DT229.C1119
				, DT229.C1124
			ORDER BY
				DT229.C1124
				, AVG( DT230.C456 )
			LIMIT 217
			)  DT233 ( C1427, C1428 ) 
		INNER JOIN
			T98 DT239
		ON
			DT233.C1427 <> DT239.C1202
		)
	INNER JOIN
		(
			(
				T70 DT240
			INNER JOIN
				T76 DT238
			ON
				DT240.C844 = DT238.C945
			)
		INNER JOIN
			(
			SELECT
				DT234.C1193
				, DT235.C657
			FROM
				(
					(
						T97 DT234
					LEFT OUTER JOIN
						T54 DT235
					ON
						DT234.C1192 = DT235.C657
					)
				INNER JOIN
					T99 DT236
				ON
					DT234.C1191 = DT236.C1205
				)
			WHERE
				(
					(
						DT234.C1196 > DT234.C1199
					)
					OR
					(
						DT235.C654 = DT234.C1190
					)
				)
				AND
