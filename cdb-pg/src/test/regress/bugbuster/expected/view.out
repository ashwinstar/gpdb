CREATE VIEW view_DeepSlicedqueries_AOtables07 (col1,col2,col3,col4) AS
SELECT
	DT186.C721
	, AVG( DT186.C720 )
	, DT186.C720
	, DT184.C1297
FROM
	(
		(
			(
				T53 DT187
			INNER JOIN
				T60 DT186
			ON
				DT187.C638 = DT186.C720
			)
		INNER JOIN
			(
			SELECT
				DT183.C812
			FROM
				(
					T67 DT183
				INNER JOIN
					T3 DT182
				ON
					DT183.C814 = DT182.C50
				)
			WHERE
				(
					(
						(
							DT182.C50 <> DT182.C47
						)
						AND
						(
							(
								(
									DT182.C52 = DT182.C41
								)
								AND
								(
									(
										DT182.C39 <> DT182.C44
									)
									AND
									(
										DT182.C35 > DT182.C52
									)
								)
							)
							OR
							(
								DT182.C38 = DT182.C42
							)
						)
					)
					AND
					(
						DT182.C45 = DT182.C32
					)
				)
				AND
				(
					DT182.C45 = DT183.C818
				)
			GROUP BY
				DT182.C33
				, DT182.C44
				, DT183.C812
				, DT182.C42
				, DT183.C814
			ORDER BY
				DT183.C812
			LIMIT 590
			) AS DT184 ( C1297 ) 
		ON
			DT187.C651 = DT184.C1297
		)
	INNER JOIN
		T41 DT185
	ON
		DT186.C724 <> DT185.C464
	)
WHERE
	(
		(
			(
				DT185.C465 <> DT187.C648
			)
			AND
			(
				(
					DT184.C1297 = DT187.C647
				)
				OR
				(
					DT185.C470 = DT187.C650
				)
			)
		)
		AND
		(
			(
				(
					DT186.C723 <> DT187.C651
				)
				OR
				(
					DT185.C456 < DT187.C647
				)
			)
			AND
			(
				DT187.C639 > DT185.C453
			)
		)
	)
	AND
	(
		(
			DT187.C653 = DT185.C472
		)
		AND
		(
			DT185.C458 <> DT185.C460
		)
	)
GROUP BY
	DT184.C1297
	, DT186.C720
	, DT185.C461
	, DT185.C460
	, DT186.C721
ORDER BY
	DT186.C721
	, AVG( DT186.C720 )
	, DT186.C720
	, DT184.C1297
LIMIT 260;
