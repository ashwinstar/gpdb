	$(CDB_BACKEND_DIR)/utils/adt/datum.o $(CDB_BACKEND_DIR)/utils/init/globals.o $(CDB_BACKEND_DIR)/storage/page/itemptr.o \
	$(CDB_BACKEND_DIR)/lib/stringinfo.o $(CDB_BACKEND_DIR)/access/transam/filerepdefs.o $(CDB_PORT_DIR)/qsort.o $(CDB_PORT_DIR)/strlcpy.o
	
	