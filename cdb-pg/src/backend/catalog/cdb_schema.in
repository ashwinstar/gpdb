-- --------------------------------------------------------------------
--
-- cdb_schema.sql
--
-- Define CDB administrative schema and several SQL functions to aid 
-- in maintaining the CDB administrative schema.  
--
-- This is version 2 of the schema.
--
-- TODO Error checking is rudimentary and needs improvment.
--
-- $Id$
--
-- --------------------------------------------------------------------

set log_min_messages = 'WARNING';

-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
--
-- Create the schema and ensure PUBLIC access
--
-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
CREATE SCHEMA cdb;
COMMENT ON SCHEMA cdb
    IS 'repository for CDB service functions and related schema objects';
GRANT USAGE ON SCHEMA cdb TO PUBLIC;


-- Add PL/PGSQL to the database
CREATE FUNCTION plpgsql_call_handler () 
		RETURNS language_handler 
		AS '@pkglibdir@/plpgsql@dlsuffix@'
		LANGUAGE 'C';
		
-- PIN the function to the database
INSERT INTO pg_depend SELECT 0,0,0, tableoid, oid, 0, 'p' FROM pg_proc WHERE proname = 'plpgsql_call_handler';

CREATE TRUSTED LANGUAGE 'plpgsql' 
		HANDLER plpgsql_call_handler
		LANCOMPILER 'PL/pgSQL';

-- PIN the language to the database
INSERT INTO pg_depend SELECT 0,0,0, tableoid, oid, 0, 'p' FROM pg_language WHERE lanname = 'plpgsql';


-- A row of table HOST represents a host machine in the CDB.
--
-- Attribute hostid is a system-assigned identifier.
--
-- Attribute hostname is a component of the URL for PostgreSQL databases
-- (segment databases) served by listeners that run on the host machine.
--
-- This table is populated only on an entry database.

create table CDB.HOST
(
	hostid integer,
	hostname text not null,
	
	primary key (hostid),
	unique (hostname)
);

COMMENT ON TABLE cdb.host IS 'a host machine within the CDB';

-- A row of table LISTENER represents a listener (postmaster process) used
-- by the running CDB. 
--
-- Attribute port is a component of the URL for PostgreSQL databases 
-- (segment databases) served by the listener.
--
-- This table is populated only on an entry database.

create table CDB.LISTENER
(
	listenerid integer,
	hostid integer not null,
	port integer not null,
	datadir text not null,
	cdbsuperuser text not null,
	cdbsuperpswd text,
	
	primary key (listenerid),
	foreign key (hostid) references CDB.host
);

COMMENT ON TABLE cdb.listener IS 'a listener (database group) within the CDB';


-- A row of table PGDATABASE represents a component database of the CDB.
--
-- For a segment database, the attribute content is a value from the
-- interval  0..(N-1) where N is the number of segments in the CDB.
--
-- For an entry database, the attribute content is -1.
--
-- This table is populated only on an entry database.

create table CDB.PGDATABASE
(
	dbid integer,
	isprimary boolean,
	dbname text not null,
	content integer not null,
	listenerid integer not null,
	
	primary key (dbid),
	unique (content, isprimary),
	unique (dbname, listenerid),
	foreign key (listenerid) references CDB.listener(listenerid)
);

COMMENT ON TABLE cdb.pgdatabase IS 'a component database of the CDB';


-- A row of POLICY corresponds to a partitioned table in the CDB and
-- describes the policy under which table data is distributed to segment
-- databases.
--
-- (Note that POLICY might better be noted by altering pg_class.)
--
-- This table is populated only on an entry database.

create table CDB.POLICY
(
	localoid oid,
	attrnums smallint[],
	
	primary key (localoid) -- logically, a foreign key to pg_class
);

COMMENT ON TABLE cdb.policy IS 'a partitioned table in the CDB';


-- The sole row of table CDB represents (1) the CDB as a whole and (2) the
-- segment database in which it appears.
--
-- This table is populated on all component databases and all component 
-- databases in a given CDB have the same values for attributes cdbName 
-- and numSegments.  The remaining attributes describe the component database 
-- in which the table resides.
--
-- No two segment databases in a given CDB can match on the attribute
-- dbid.  The content attribute must agree with content attribute specified
-- for the database in the cdb.pgdatabase table on the entry database for 
-- the CDB.

create table CDB.CDB
(
	cdbname name not null,
	numsegments integer not null,
	dbid integer not null,
	content integer not null
);

COMMENT ON TABLE cdb.cdb IS 'the affiliation of this database with its CDB';



-- The sole row of table VERSION identifies the version of the CDB schema.
--
-- This table is populated on every database.

create table CDB.VERSION
(
    schemaversion integer
);

-- 1 is the initial version defined in 2004 and never released.
-- 2 is the version defined in Feb 2005.

INSERT INTO CDB.VERSION(schemaversion) VALUES ( 2 );

COMMENT ON TABLE cdb.version IS 'vintage of schema "cdb" in this database';



create type cdb.table_descriptor as 
(
    oid         oid,
    schema_name name,
    table_name  name,
    kind        "char" 
);
COMMENT ON TYPE cdb.table_descriptor
    IS 'used internally by CDB for service functions';


-- Sequence used to assign group ids within the Query Dispatcher
create sequence cdb.group_seq start with 1;

COMMENT ON SEQUENCE cdb.group_seq
	IS 'used to assign group id by the Query Dispatcher';

-- AMS won't let people connect if they can't use this sequence. BUG?	
GRANT SELECT ON cdb.group_seq TO PUBLIC;
GRANT UPDATE ON cdb.group_seq TO PUBLIC;


--
-- used to add a host to the cdb.host table
--
CREATE OR REPLACE FUNCTION cdb.add_host(cdb.host.hostname%TYPE) RETURNS VOID
	AS '
		DECLARE
			host_name 	ALIAS FOR $1;
			host_row	cdb.host%ROWTYPE;
			lastid      cdb.host.hostid%TYPE;
		BEGIN
		
			--
			-- Perform a little validation on the input parameters
			--
			IF host_name IS NULL OR host_name = ''''
			THEN
				RAISE EXCEPTION ''Host name must be specificed'';
			END IF;			
			
			--
			-- Ensure the hostname is not already in use in this CDB.
			--
			SELECT INTO host_row
					*
				FROM cdb.host h
				WHERE h.hostname = host_name;
				
			IF FOUND
			THEN
				RAISE EXCEPTION ''% is already represented as hostid %'', host_name, host_row.hostid;
			END IF;
			
			--
			-- Determine the next hostid to be used
			--
			SELECT INTO lastid
					hostid
				FROM cdb.host
				ORDER BY hostid DESC
				LIMIT 1;
			
			IF NOT FOUND
			THEN
				lastid := 1;
			ELSE
				lastid := lastid + 1;
			END IF;
			
			-- 
			-- Add an entry to the cdb.host table for this host.
			--
			INSERT INTO cdb.host(hostid,hostname) VALUES ( lastid, host_name );
			
			RETURN;
		END;
	
	' LANGUAGE 'plpgsql';

COMMENT ON FUNCTION cdb.add_host(cdb.host.hostname%TYPE) IS 'Adds a host to the hosts table';

									
--
-- Used to add a listener to the cdb.listener table
--
CREATE OR REPLACE FUNCTION cdb.add_listener(cdb.host.hostname%TYPE,
										    cdb.listener.port%TYPE,
										    cdb.listener.datadir%TYPE,
										    cdb.listener.cdbsuperuser%TYPE,
										    cdb.listener.cdbsuperpswd%TYPE) 
	RETURNS void
	AS '
		DECLARE
			arg_hostname	ALIAS FOR $1;
			arg_port  		ALIAS FOR $2;
			arg_datadir  	ALIAS FOR $3;
			arg_superuser	ALIAS FOR $4;
			arg_superpswd   ALIAS FOR $5;
			host_row  		cdb.host%ROWTYPE;
			f_hostid 	 	cdb.host.hostid%TYPE;
			lastid   		cdb.listener.listenerid%TYPE;

		BEGIN
			--
		   	-- Perform a little validation on the input parameters
		   	--
		   	IF arg_hostname IS NULL OR arg_hostname = ''''
		   	THEN
		    	RAISE EXCEPTION ''hostname must be specified'';
		   	END IF;
		   	
		   	IF arg_port IS NULL OR arg_port < 1 OR arg_port > 65535
			THEN
				RAISE EXCEPTION ''Listener port number must be specified and between 1 and 65535'';
			END IF;
			
			IF arg_datadir IS NULL OR arg_datadir = ''''
			THEN
				RAISE EXCEPTION ''datadir must be specified'';
			END IF;
			
			IF arg_superuser IS NULL OR arg_superuser = ''''
			THEN
				RAISE EXCEPTION ''superuser must be specified'';
			END IF;
			
			
			--
			-- Look up the hostid for the specified hostname
			--
			SELECT INTO host_row
					*
				FROM cdb.host h
				WHERE h.hostname = arg_hostname;
				
			IF FOUND
			THEN
				f_hostid := host_row.hostid;
			ELSE
				RAISE EXCEPTION ''% is not in the cdb.host table'', arg_hostname;
			END IF;						
			
			
			--
			-- Determine the next listenerid to use
			--
			SELECT INTO lastid
					listenerid
				FROM cdb.listener
				ORDER BY listenerid DESC
				LIMIT 1;
				
			IF NOT FOUND
			THEN
				lastid := 1;
			ELSE
				lastid := lastid + 1;
			END IF;
			
			
			--
			-- Add an entry to cdb.listener table for this listener
			--
			INSERT INTO cdb.listener(listenerid, hostid, port, datadir, cdbsuperuser, cdbsuperpswd)
			VALUES ( lastid, f_hostid, arg_port, arg_datadir, arg_superuser, arg_superpswd );
			
			RETURN;
		END;
	' LANGUAGE 'plpgsql';

COMMENT ON FUNCTION cdb.add_listener(cdb.host.hostname%TYPE,
			 					     cdb.listener.port%TYPE,
									 cdb.listener.datadir%TYPE,
									 cdb.listener.cdbsuperuser%TYPE,
									 cdb.listener.cdbsuperpswd%TYPE) 
	IS 'used to add a listener';
	
--
-- Used to add a Database to the CDB
--
CREATE OR REPLACE FUNCTION cdb.add_segment_database( cdb.pgdatabase.dbname%TYPE,
											         cdb.host.hostname%TYPE,
			 					     		         cdb.listener.port%TYPE, 
											         cdb.pgdatabase.isprimary%TYPE,
					   						         cdb.pgdatabase.content%TYPE)
	RETURNS void 
	AS '
		DECLARE
			arg_dbname			ALIAS FOR $1;
			arg_hostname		ALIAS FOR $2;
			arg_port			ALIAS FOR $3;
			arg_isprimary   	ALIAS FOR $4;
			arg_content         ALIAS FOR $5;
			host_row			cdb.host%ROWTYPE;			
			db_row				cdb.pgdatabase%ROWTYPE;			
			f_hostid			cdb.host.hostid%TYPE;
			f_listenerid		cdb.listener.listenerid%TYPE;
			lastid   			cdb.pgdatabase.dbid%TYPE;
		
		BEGIN
			--
			-- Perform a little validation on the input parameters
			--
			IF arg_dbname IS NULL OR arg_dbname = ''''
			THEN
				RAISE EXCEPTION ''dbname must be specified'';
			END IF;
			
			IF arg_hostname IS NULL or arg_hostname = ''''
			THEN
				RAISE EXCEPTION ''hostname must be specified'';
			END IF;
			
			IF arg_port IS NULL OR arg_port < 1 OR arg_port > 65535
			THEN
				RAISE EXCEPTION ''Listener port number must be specified and between 1 and 65535'';
			END IF;
			
			IF arg_isprimary IS NULL 
			THEN
				RAISE EXCEPTION ''isprimary must be specified'';
			END IF;
			
			IF arg_content IS NULL OR arg_content < -1 OR arg_content > 1023
			THEN
				RAISE EXCEPTION ''content must be specified and between -1 and 1023'';
			END IF;
			
			--
			-- Look up the hostid for the specified hostname
			--
			SELECT INTO host_row
					*
				FROM cdb.host h
				WHERE h.hostname = arg_hostname;
				
			IF FOUND
			THEN
				f_hostid := host_row.hostid;
			ELSE
				RAISE EXCEPTION ''% is not in the cdb.host table'', arg_hostname;
			END IF;	
			
			--
			-- Look up the listener id for the specified hostid, port
			--
			SELECT INTO f_listenerid
					l.listenerid
				FROM cdb.listener l
				WHERE l.hostid = f_hostid AND l.port = arg_port;
				
			IF NOT FOUND
			THEN
				RAISE EXCEPTION ''Listener %:% is not in the cdb.listener table'', arg_hostname, arg_port;
			END IF;
			
			--
			-- Make sure the database name is available on the listener.
			--
			SELECT INTO db_row
					*
				FROM cdb.pgdatabase WHERE pgdatabase.dbname = arg_dbname
				AND pgdatabase.listenerid = f_listenerid;
				
			IF FOUND
			THEN
				RAISE EXCEPTION ''Database % on listener %:% is already in the cdb.pgdatabase table'', arg_dbname, arg_hostname, arg_port;
			END IF;
			
			--
			-- Make sure the content and primary is available in the CDB.
			--
			SELECT INTO db_row
					*
				FROM cdb.pgdatabase WHERE pgdatabase.content = arg_content
				AND pgdatabase.isprimary = arg_isprimary;
				
			IF FOUND
			THEN
				IF arg_content = -1
				THEN
					RAISE EXCEPTION ''An entry database with isprimary = % is already recorded in table cdb.pgdatabase'', arg_isprimary ;
				ELSE
					RAISE EXCEPTION ''A database for segment % with isprimary = % is already recorded in table cdb.pgdatabase'', arg_content, arg_isprimary;
				END IF;
			END IF;
			
			
			--
			-- Determine the next dbid to use
			--
			SELECT INTO lastid
					dbid
				FROM cdb.pgdatabase
				ORDER BY dbid DESC
				LIMIT 1;
				
			IF NOT FOUND
			THEN
				lastid := 1;
			ELSE
				lastid := lastid + 1;
			END IF;
			
			--
			-- Add an entry to cdb.pgdatabase table
			--
			INSERT INTO cdb.pgdatabase(dbid, isprimary, dbname, content, listenerid)
			VALUES ( lastid, arg_isprimary, arg_dbname, arg_content, f_listenerid );
			
			RETURN;
		END;
	' LANGUAGE 'plpgsql';
			
COMMENT ON FUNCTION cdb.add_segment_database( cdb.pgdatabase.dbname%TYPE,
											  cdb.host.hostname%TYPE,
			 					     		  cdb.listener.port%TYPE, 
											  cdb.pgdatabase.isprimary%TYPE,
											  cdb.pgdatabase.content%TYPE)
	IS 'adds a segment or entry database to the CDB';
	
	
--
-- Used to add an Entry Database to the CDB
--
CREATE OR REPLACE FUNCTION cdb.add_entry_database( cdb.pgdatabase.dbname%TYPE,
												   cdb.host.hostname%TYPE,
			 					     			   cdb.listener.port%TYPE, 
												   cdb.pgdatabase.isprimary%TYPE)
	RETURNS void
	AS '
		DECLARE
			dbname			ALIAS FOR $1;
			hostname		ALIAS FOR $2;
			port			ALIAS FOR $3;
			isprimary   	ALIAS FOR $4;
		
		BEGIN
			--
			-- Just call add_segment_database to do the work.
			--

			PERFORM cdb.add_segment_database( dbname, hostname, port, isprimary, -1 );
			
			RETURN;
		END;
	' LANGUAGE 'plpgsql';
			
COMMENT ON FUNCTION cdb.add_entry_database( cdb.pgdatabase.dbname%TYPE,
											cdb.host.hostname%TYPE,
			 					     		cdb.listener.port%TYPE, 
											cdb.pgdatabase.isprimary%TYPE)
	IS 'adds an entry database to the CDB';
	


-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
--
-- Obtains information about the designated class (table) and ensures
-- the table is manageable by CDB.  To be manageable, the table:
--
--     1) must be a base table (kind = 'r');
--     2) must NOT be a system table.
--
-- No table locks are required by this routine.
--
-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
create or replace function cdb.get_table_info( regclass )
    returns cdb.table_descriptor
    as '
        DECLARE

            class_name_or_oid   ALIAS FOR $1;
           
            table_info          cdb.table_descriptor; 
            lastsysoid          pg_catalog.pg_database.datlastsysoid%TYPE;

        BEGIN

            IF class_name_or_oid IS NULL 
            THEN
                RAISE EXCEPTION ''Table identifier cannot be NULL or empty.'';
            END IF;
           
            -- force a conversion from regclass to oid
            table_info.oid := class_name_or_oid::oid;

            --
            -- Determine the type of relation the caller gave us
            --
            SELECT INTO table_info.table_name, table_info.kind, table_info.schema_name
                    c.relname, c.relkind, n.nspname
                FROM pg_catalog.pg_class c, pg_catalog.pg_namespace n
                WHERE 
                        c.oid = table_info.oid
                    AND n.oid = c.relnamespace;
            IF NOT FOUND
            THEN
                RAISE EXCEPTION ''Table identifier ''''%'''' is not a table.'', class_name_or_oid;
            END IF;

            --
            -- Perform CDB acceptance tests on this table ...
            --

            -- If the relation was not a table, abandon this procedure
            IF table_info.kind IS NULL OR table_info.kind <> ''r''
            THEN
                RAISE EXCEPTION ''Relation "%.%" (oid=%) has kind=''''%''''; expecting ''''r''''.'', 
                        table_info.schema_name, 
                        table_info.table_name, 
                        table_info.oid,
                        table_info.kind;
            END IF;

            -- Lastly, ensure that we are not trying to play with a system table.
            SELECT INTO lastsysoid
                    datlastsysoid
                FROM pg_catalog.pg_database
                WHERE datname = current_database();
            IF table_info.oid <= lastsysoid
            THEN
                RAISE EXCEPTION ''CDB cannot manage table %.% (oid=%); it is a system table'', 
                        table_info.schema_name, 
                        Table_info.table_name, 
                        table_info.oid;
            END IF;
           
            RETURN table_info;

        END;
    ' language 'plpgsql';
COMMENT ON FUNCTION cdb.get_table_info( regclass )
    IS 'Returns table information by table name or oid';



-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
--
-- Removes a table from the CDB management tables.  While the table is
-- checked to ensure manageability by CDB, no check is performed to 
-- ensure that the table was actually managed by CDB.
--
-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
create or replace function cdb.reset_table( regclass )
    returns oid
    as '
        --
        -- oid = reset_table( table_name_or_oid );
        --
        DECLARE
            table_name_or_oid   ALIAS FOR $1;
            table_info          cdb.table_descriptor;
            removed             boolean := false;
        BEGIN

           

            -- Get the oid for the named table
            SELECT INTO table_info * FROM cdb.get_table_info( table_name_or_oid );
            IF table_info.oid IS NULL
            THEN
                RAISE WARNING ''Identifier "%" is not a CDB manageable table.'', table_name_or_oid;
                RETURN NULL;
            END IF;



			DELETE FROM cdb.policy WHERE localoid = table_info.oid;
			
			IF FOUND THEN
				removed := true;
			END IF;
			
            RETURN table_info.oid;               
        END;
    ' language 'plpgsql';
COMMENT ON FUNCTION cdb.reset_table( regclass )
    IS 'Discards CDB schema data about a table by name or oid';
    

--
-- Marks a table as partitioned on its primary key
--
CREATE OR REPLACE FUNCTION cdb.partition_table( regclass )
	RETURNS oid
	AS '
		DECLARE
			table_name_or_oid    ALIAS FOR $1;
			attr_nums			 cdb.policy.attrnums%TYPE;
			table_info           cdb.table_descriptor;
		BEGIN
		
			--
			-- Get the oid for the named table
			-- 
			SELECT INTO table_info * FROM cdb.get_table_info( table_name_or_oid );
            IF table_info.oid IS NULL
            THEN
                RAISE EXCEPTION ''Table "%" is not defined.'', table_name_or_oid;
            END IF;
            
            --
            -- Delete any pre-existing row in cdb_policy to ensure no confusion.
            --
            PERFORM cdb.reset_table( table_info.oid );
            
            --
			-- Get the primary key
			--
			SELECT INTO attr_nums
					conkey
				FROM pg_constraint
				WHERE contype =  ''p''  AND conrelid = table_info.oid;
				
			IF NOT FOUND
			THEN
				RAISE EXCEPTION ''Table "%" has no primary key on which to partition'', table_name_or_oid;
			END IF;
	
			--
			-- Add a row to Policy table
			INSERT INTO cdb.policy(localoid, attrnums) 
			VALUES ( table_info.oid, attr_nums );
			
			RETURN table_info.oid;
            
        END;
	' LANGUAGE 'plpgsql';
	
COMMENT ON FUNCTION cdb.partition_table( regclass )
	IS 'used to mark as table as being partitioned on its primary key';


--
-- Marks a table as a partitioned table
--
CREATE OR REPLACE FUNCTION cdb.partition_table( regclass, cdb.policy.attrnums%TYPE )
	RETURNS oid
	AS '
		DECLARE
			table_name_or_oid    ALIAS FOR $1;
			attr_nums			 ALIAS FOR $2;
			pk_nums				 pg_constraint.conkey%TYPE;
			table_info           cdb.table_descriptor;
		BEGIN
		
			--
			-- Get the oid for the named table
			-- 
			SELECT INTO table_info * FROM cdb.get_table_info( table_name_or_oid );
            IF table_info.oid IS NULL
            THEN
                RAISE EXCEPTION ''Table "%" is not defined.'', table_name_or_oid;
            END IF;
            
            --
            -- Delete any pre-existing rows in cdb_basetable, cdb_policy,
            -- and cdb_assignment to ensure no confusion.
            --
            PERFORM cdb.reset_table( table_info.oid );
            
            --
			-- Get the primary key
			--
			SELECT INTO pk_nums
					conkey
				FROM pg_constraint
				WHERE contype =  ''p''  AND conrelid = table_info.oid;
				
			IF FOUND
			THEN
				IF pk_nums != attr_nums 
				THEN
					RAISE EXCEPTION ''Supplied attributes conflict with primary key of table "%"'', table_name_or_oid;
				END IF;
			END IF;
				
			--
			-- Add a row to Policy table
			INSERT INTO cdb.policy(localoid, attrnums) 
			VALUES ( table_info.oid, attr_nums );
			
			RETURN table_info.oid;
            
        END;
	' LANGUAGE 'plpgsql';
	
COMMENT ON FUNCTION cdb.partition_table( regclass, cdb.policy.attrnums%TYPE )
	IS 'used to mark as table as being partitioned';




CREATE OR REPLACE FUNCTION cdb.cdb_set_identity( cdb.cdb.cdbname%TYPE,
												 cdb.cdb.numsegments%TYPE,
												 cdb.cdb.dbid%TYPE,
			 					     			 cdb.cdb.content%TYPE	 
												)
	RETURNS void
	AS '
		DECLARE
			arg_cdbname			ALIAS FOR $1;
			arg_numsegments		ALIAS FOR $2;
			arg_dbid			ALIAS FOR $3;
			arg_content			ALIAS FOR $4;
			content_max			cdb.cdb.content%TYPE;
			
		BEGIN		
			--
			-- Perform a little validation on the input parameters
			--
			IF arg_cdbname IS NULL OR arg_cdbname = ''''
			THEN
				RAISE EXCEPTION ''cdbname must be specified'';
			END IF;
			
			IF arg_numsegments IS NULL OR arg_numsegments < 1 OR arg_numsegments > 1024
			THEN
				RAISE EXCEPTION ''numsegments must be specified and between 1 and 1024'';
			END IF;
			
			IF arg_dbid IS NULL or arg_dbid < 1
			THEN
				RAISE EXCEPTION ''dbid must be specified and postive'';
			END IF;
			
			content_max := arg_numsegments - 1;
			
			IF arg_content IS NULL OR arg_content < -1 OR arg_content > content_max
			THEN
				RAISE EXCEPTION ''content must be specified and between -1 and %'', content_max;
			END IF;
			
		
			--
			-- Add a row to cdb.cdb
			--
			DELETE FROM cdb.cdb;
			INSERT INTO cdb.cdb(cdbname, numsegments, dbid, content)
			VALUES ( arg_cdbname, arg_numsegments, arg_dbid, arg_content );
			IF NOT FOUND
			THEN
				RAISE EXCEPTION ''Failed to set identity'';
			END IF;
			
			RETURN;
		END;
	' LANGUAGE 'plpgsql';
	
COMMENT ON FUNCTION cdb.cdb_set_identity( cdb.cdb.cdbname%TYPE,
										  cdb.cdb.numsegments%TYPE,
										  cdb.cdb.dbid%TYPE,
										  cdb.cdb.content%TYPE	 ) 
	IS 'used to set the identity of a component database of the CDB';




CREATE OR REPLACE VIEW cdb.component_database
		
	AS SELECT d.content as "segindex", d.dbname as "dbname", 
			  d.isprimary as "isprimary", h.hostname as "hostname", 
			  l.port as "port", l.datadir as "datadir"
	   FROM cdb.host h, cdb.listener l, cdb.pgdatabase d
	   WHERE h.hostid = l.hostid AND l.listenerid = d.listenerid;

COMMENT ON VIEW cdb.component_database
	IS 'CDB component databases registered in this database';


CREATE OR REPLACE VIEW cdb.segment_database
	AS SELECT coalesce(generate_series, segindex) as "segindex", dbname, 
			  isprimary, hostname, port, datadir, true as "isvalid"
		FROM generate_series(0, (select numsegments from cdb.cdb)) 
		     FULL OUTER JOIN cdb.component_database
		     ON generate_series = segindex
		WHERE segindex >= 0
		ORDER BY segindex, isprimary DESC;
		
COMMENT ON VIEW cdb.segment_database
	IS ' returns info about all segment databases within the cdb';

-- legacy 
CREATE OR REPLACE VIEW cdb.cdb_get_segdbs
	AS SELECT * FROM cdb.segment_database
		ORDER BY segindex, isprimary DESC;
		
COMMENT ON VIEW cdb.cdb_get_segdbs
	IS ' returns info about all segment databases within the cdb';

set log_min_messages to DEFAULT;































