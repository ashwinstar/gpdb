%YAML 1.1
---
VERSION:         1.0.0.1

DEFINE:
  - MAP:
      NAME:      badpy_map
      LANGUAGE:  python
      FUNCTION:  |
        'syntax error at compile time

EXECUTE:
  - RUN:
      SOURCE:    inDirectory
      MAP:       badpy_map
        
---
VERSION:         1.0.0.1
DEFINE:
  - INPUT:
      NAME:      inDirectory
      FILE:
        - @hostname@:@abs_srcdir@/data/access_log
        - @hostname@:@abs_srcdir@/data/access_log2
      DELIMITER: '|'

  - MAP:
      NAME:      badpy_map
      LANGUAGE:  python
      FUNCTION:  |
        raise "error at runtime"
      
EXECUTE:
  - RUN:
      SOURCE:    inDirectory
      MAP:       badpy_map
