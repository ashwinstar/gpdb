%YAML 1.1
---  
VERSION:   1.0.0.1
USER:      @db_user@

DEFINE:
  - INPUT:
      NAME:      weblog
      FILE:
        - @hostname@:@abs_srcdir@/data/access_log
        - @hostname@:@abs_srcdir@/data/access_log2

  - OUTPUT:
      NAME:     out_1
      FILE:     @abs_srcdir@/output/access_frequency.1

  - MAP:
      NAME:     myMap
      LANGUAGE: perl
      FUNCTION:     |
        return {} unless ($_[1] =~ m/GET ([^ ?,]+)/);
        return {"key" => $1, "value" => 1}

  - TRANSITION:
      NAME:     myTransition
      LANGUAGE: perl
      FUNCTION: return $_[0] + $_[1];

  - REDUCER:
      NAME:       myReduce
      INITIALIZE: '0'
      TRANSITION: myTransition
      COMBINER:   myTransition

EXECUTE:
  - RUN:
     SOURCE:   weblog
     MAPPER:   myMap
     REDUCER:  myReduce
     TARGET:   out_1
