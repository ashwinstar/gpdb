%YAML 1.1
---  
VERSION:   1.0.0.1
USER:      @db_user@

DEFINE:
  - INPUT:
      NAME:      weblog
      FILE:
        - @hostname@:@abs_srcdir@/data/access_log
        - @hostname@:@abs_srcdir@/data/access_log2
      COLUMNS:
        - ip       text
        - rfc      text
        - uname    text
        - date     text
        - timezone text
        - method   text
        - url      text
        - protocol text
        - status   integer
        - bytes    integer
      DELIMITER: ' '
        
  - OUTPUT:
      NAME:     out_1
      FILE:     @abs_srcdir@/output/columns.1
      DELIMITER: '|'
      MODE:     REPLACE

  - OUTPUT:
      NAME:     out_2
      FILE:     @abs_srcdir@/output/columns.1
      DELIMITER: '|'
      MODE:     APPEND
      
  - MAP:
      NAME:     myMap
      LANGUAGE: perl
      PARAMETERS:
        - key text
        - ip text
        - url text
      RETURNS:
        - ip text
        - url text
        - count integer
      FUNCTION: |
        my ($key, $ip, $url) = @_;
        return [] unless ($url =~ m/$key/);
        return [{"ip" => $ip, "url" => $url, "count" => 1}]
        
# test both "keys" and built in transition/consolidate functions
#  - REDUCE:
#      NAME:        myReduce
#      INITIALIZE:  '0'
#      TRANSITION:  int4_sum
#      CONSOLIDATE: int8pl
#      KEYS:        [ip]
        
  - TRANSITION:
      NAME:      myTransition
      LANGUAGE:  perl
      PARAMETERS:
        - state integer
        - count integer
      RETURNS:
        - state integer
      FUNCTION:     return $_[0] + $_[1];

  - REDUCE:
      NAME:        myReduce
      INITIALIZE:  '0'
      TRANSITION:  myTransition
      CONSOLIDATE: myTransition
      KEYS:        [ip]

EXECUTE:
  - RUN:
     SOURCE:   weblog
     MAP:      myMap
     TARGET:   out_1

  - RUN:
     SOURCE:   weblog
     MAP:      myMap
     REDUCE:   myReduce
     TARGET:   out_2
     
     