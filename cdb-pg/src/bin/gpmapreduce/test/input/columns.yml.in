%YAML 1.1
---  
VERSION:   1.0.0.1
USER:      @db_user@

DEFINE:
  - INPUT:
      NAME:      weblog
      FILE:      @hostname@:@abs_srcdir@/data/access_log_fake
      COLUMNS:
        - ip       text
        - rfc      text
        - uname    text
        - date     text
        - timezone text
        - method   text
        - url      text
        - protocol text
        - status   integer
        - bytes    integer
      DELIMITER: '|'
        
  - OUTPUT:
      NAME:     out_1
      FILE:     @abs_srcdir@/output/columns.1
        
  - MAP:
      NAME:     myMap
      LANGUAGE: perl
      PARAMETERS:
        - key text
        - ip text
        - url text
      RETURNS:
        - ip text
        - count integer
      FUNCTION:     |
        return {} unless ($_[2] =~ m/$_[0]/);
        return {"ip" => $_[1], "count" => 1}

  - TRANSITION:
      NAME:      myTransition
      LANGUAGE:  perl
      PARAMETERS:
        - state integer
        - count integer
      RETURNS:
        - state integer
      FUNCTION:     return $_[0] + $_[1];

  - REDUCE:
      NAME:        myReduce
      INITIALIZE:  '0'
      TRANSITION:  myTransition
      CONSOLIDATE: myTransition

EXECUTE:
  - RUN:
     SOURCE:   weblog
     MAP:      myMap
     REDUCE:   myReduce
     TARGET:   out_1
