%YAML 1.1
---  
VERSION:   1.0.0.1
DATABASE:  postgres
USER:      @db_user@

DEFINE:

# 1) Access log
  - INPUT:
      NAME:      weblog
      FILE:      @hostname@:@abs_srcdir@/data/access_log

  - OUTPUT:
      NAME:     out_1
      FILE:     @abs_srcdir@/output/join.1
     
  - MAP:
      NAME:     myMap
      LANGUAGE: perl
      FUNCTION:     |
        return {} unless ($_[1] =~ m/GET ([^ ?,]+)/);
        return {"key" => $1, "value" => 1}

  - TRANSITION:
      NAME:     myTransition
      LANGUAGE: perl
      FUNCTION:     return $_[0] + $_[1];

  - REDUCER:
      NAME:       myReduce
      INITIALIZE: '0'
      TRANSITION: myTransition
      COMBINER:   myTransition

  - TASK:
      NAME:     access_count
      SOURCE:   weblog
      MAPPER:   myMap
      REDUCER:  myReduce

# 2) Network graph
  - INPUT:
      NAME:      network
      FILE:      @hostname@:@abs_srcdir@/data/www.small.dat
      COLUMNS:
        - key text
        - value text
      DELIMITER: '|'

  - MAP:
      NAME:     reverse
      LANGUAGE: python
      FUNCTION:     |
        return {'key': value, 'value': key}

  - TASK:
      NAME:     reverse_network
      SOURCE:   network
      MAPPER:   reverse


# 3) SQL join

  - INPUT:
      NAME:   reverse_access_count
      QUERY: |
        SELECT a.key, sum(b.value::integer) as value
        FROM   reverse_network a, access_count b
        WHERE  a.key = b.key
        GROUP BY a.key
        
EXECUTE:
  - RUN:
      SOURCE: reverse_access_count
      TARGET: out_1