%YAML 1.1
---
VERSION:         1.0.0.1
DATABASE:        @db_user@
USER:            @db_user@

DEFINE:
  - INPUT:
      NAME:      email
      FILE:
        - @hostname@:@abs_srcdir@/data/email/mailfiles

  - OUTPUT:
      NAME:     out_1
      FILE:     @abs_srcdir@/output/wordcount.1
      DELIMITER: '|'
      
  - MAP:
      NAME:      wordsplit_python
      FUNCTION:  |
        from email import message_from_file
        import nltk
        tokenizer = nltk.WordTokenizer()
        stemmer   = nltk.PorterStemmer()
        stopwords = nltk.corpus.stopwords.words()
        text      = message_from_file(open(value)).get_payload()
        stems     = map(lambda(x): stemmer.stem(x.lower()), tokenizer.tokenize(text))
        words     = filter(lambda(x): x not in stopwords and not x.isdigit(), stems)
        return map(lambda(x): [x, 1], words)
      LANGUAGE:   python
      OPTIMIZE:   STRICT IMMUTABLE
      PARAMETERS: value text
      RETURNS:
        - key text
        - value integer

  - MAP:
      NAME:      reverse_python
      FUNCTION:  |
        return (value, key)
      LANGUAGE:  python
      OPTIMIZE:  STRICT IMMUTABLE
      MODE:      SINGLE
      RETURNS:
        - key integer
        - value text
      
  - TASK:
      NAME:      email_histogram
      SOURCE:    email
      MAP:       wordsplit_python
      REDUCE:    SUM
        
EXECUTE:
  - RUN:
      SOURCE:    email_histogram
      MAP:       reverse_python
      TARGET:    out_1