-- start_matchsubs
-- m/mapreduce_\d+_run/
-- s/mapreduce_\d+/mapreduce_DUMMY/
-- m/'file:[^']*'/
-- s/'file:[^']*'/'file:DUMMY'/
-- m/'EXECUTE '[^']*'/
-- s/'EXECUTE '[^']*'/EXECUTE 'DUMMY'/
-- end_matchsubs
CREATE TYPE myMap_rtype as (key text, value text);

-- INPUT weblog
CREATE EXTERNAL TABLE weblog(value text)
  LOCATION('file://maple/Users/cwelton/dev/cdb2/main/cdb-pg/src/bin/gpmapreduce/test/data/access_log',
           'file://maple/Users/cwelton/dev/cdb2/main/cdb-pg/src/bin/gpmapreduce/test/data/access_log2')
  FORMAT 'TEXT';

-- MAP myMap
CREATE FUNCTION myMap(key text, value text)
RETURNS myMap_rtype LANGUAGE plperl AS
$$
return {} unless ($_[1] =~ m/GET ([^ ?,]+)/);
return {"key" => $1, "value" => 1}
$$;

-- TRANSITION myTransition
CREATE FUNCTION myTransition(state text, value text)
RETURNS text LANGUAGE plperl AS
$$
return $_[0] + $_[1];
$$;

-- REDUCER myReduce
CREATE AGGREGATE myReduce (text) (
  stype = text,
  initcond = '0',
  sfunc = myTransition,
  prefunc = myTransition
);

-- EXECUTION
CREATE VIEW mapreduce_62868_run_1 AS
SELECT key, myReduce(value) as value
FROM (SELECT key(m), value(m)
FROM (SELECT myMap('clar'::text, value) as m FROM weblog) mapxq
WHERE m is not null) mapsubq
GROUP BY key;


DROP TYPE IF EXISTS myMap_rtype CASCADE;
DROP EXTERNAL TABLE IF EXISTS weblog CASCADE;
DROP FUNCTION IF EXISTS myMap(text, text) CASCADE;
DROP FUNCTION IF EXISTS myTransition(text, text) CASCADE;
DROP AGGREGATE IF EXISTS myReduce(text) CASCADE;
DROP VIEW IF EXISTS mapreduce_62868_run_1 CASCADE;

