-- start_matchsubs
-- m/mapreduce_\d+_run/
-- s/mapreduce_\d+/mapreduce_DUMMY/
-- m/'file:[^']*'/
-- s/'file:[^']*'/'file:DUMMY'/
-- m/'EXECUTE '[^']*'/
-- s/'EXECUTE '[^']*'/EXECUTE 'DUMMY'/
-- end_matchsubs
CREATE TYPE reverse_python_rtype as (key integer, value text);

CREATE TYPE wordsplit_python_rtype as (key text, value integer);

-- INPUT email
CREATE EXTERNAL TABLE email(value text)
  LOCATION('file://maple/Users/cwelton/dev/cdb2/main/cdb-pg/src/bin/gpmapreduce/test/data/email/mailfiles')
  FORMAT 'TEXT';

-- MAP wordsplit_python
CREATE FUNCTION wordsplit_python(value text)
RETURNS SETOF wordsplit_python_rtype LANGUAGE plpythonu AS
$$
from email import message_from_file
import nltk
tokenizer = nltk.WordTokenizer()
stemmer   = nltk.PorterStemmer()
stopwords = nltk.corpus.stopwords.words()
text      = message_from_file(open(value)).get_payload()
stems     = map(lambda(x): stemmer.stem(x.lower()), tokenizer.tokenize(text))
words     = filter(lambda(x): x not in stopwords and not x.isdigit(), stems)
return map(lambda(x): [x, 1], words)
$$;

-- MAP reverse_python
CREATE FUNCTION reverse_python(key text, value text)
RETURNS reverse_python_rtype LANGUAGE plpythonu AS
$$
return (value, key)
$$;

-- TASK email_histogram
CREATE VIEW email_histogram AS
SELECT key, SUM(value) as value
FROM (SELECT key(m), value(m) FROM (SELECT wordsplit_python(value) as m FROM email) mapxq
) mapsubq
GROUP BY key;

-- EXECUTION
CREATE VIEW mapreduce_10633_run_1 AS
SELECT key(m), value(m) FROM (SELECT reverse_python(key, value) as m FROM email_histogram) mapxq
WHERE m is not null;


DROP TYPE IF EXISTS reverse_python_rtype CASCADE;
DROP TYPE IF EXISTS wordsplit_python_rtype CASCADE;
DROP EXTERNAL TABLE IF EXISTS email CASCADE;
DROP FUNCTION IF EXISTS wordsplit_python(text) CASCADE;
DROP FUNCTION IF EXISTS reverse_python(text, text) CASCADE;
DROP VIEW IF EXISTS email_histogram CASCADE;
DROP VIEW IF EXISTS mapreduce_10633_run_1 CASCADE;

