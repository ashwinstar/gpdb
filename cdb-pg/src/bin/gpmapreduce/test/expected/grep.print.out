-- start_matchsubs
-- m/mapreduce_\d+_run/
-- s/mapreduce_\d+/mapreduce_DUMMY/
-- m/'file:[^']*'/
-- s/'file:[^']*'/'file:DUMMY'/
-- m/'EXECUTE '[^']*'/
-- s/'EXECUTE '[^']*'/EXECUTE 'DUMMY'/
-- end_matchsubs
CREATE TYPE grep_map_rtype as (key text, value text);

-- INPUT inDirectory
CREATE EXTERNAL TABLE inDirectory(value text)
  LOCATION('file://maple/Users/cwelton/dev/cdb2/main/cdb-pg/src/bin/gpmapreduce/test/data/access_log',
           'file://maple/Users/cwelton/dev/cdb2/main/cdb-pg/src/bin/gpmapreduce/test/data/access_log2')
  FORMAT 'TEXT';

-- MAP grep_map
CREATE FUNCTION grep_map(key text, value text)
RETURNS grep_map_rtype LANGUAGE plperl AS
$$
return {"key" => $_[0], "value" => $_[1]} if ($_[1] =~/$_[0]/);
return {};
$$;

-- TASK grep_task
CREATE VIEW grep_task AS
SELECT key(m), value(m)
FROM (SELECT grep_map('clar'::text, value) as m FROM inDirectory) mapxq
WHERE m is not null;

-- EXECUTION
CREATE VIEW mapreduce_63071_run_1 AS
SELECT * FROM grep_task;


DROP TYPE IF EXISTS grep_map_rtype CASCADE;
DROP EXTERNAL TABLE IF EXISTS inDirectory CASCADE;
DROP FUNCTION IF EXISTS grep_map(text, text) CASCADE;
DROP VIEW IF EXISTS grep_task CASCADE;
DROP VIEW IF EXISTS mapreduce_63071_run_1 CASCADE;

