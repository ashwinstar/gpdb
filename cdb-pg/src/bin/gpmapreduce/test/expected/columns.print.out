-- start_matchsubs
-- m/mapreduce_\d+_run/
-- s/mapreduce_\d+/mapreduce_DUMMY/
-- m/'file:[^']'/
-- s/'file:[^']'/'file:DUMMY'/
-- end_matchsubs
CREATE TYPE myMap_rtype as (ip text, count integer);

-- INPUT weblog
CREATE EXTERNAL TABLE weblog(ip text, rfc text, uname text, date text, timezone text, method text, url text, protocol text, status integer, bytes integer)
  LOCATION('file://maple/Users/cwelton/Desktop/mapred3/test/data/access_log_fake')
  FORMAT 'TEXT' (DELIMITER '|');

-- MAPPER myMap
CREATE FUNCTION myMap(key text, ip text, url text)
RETURNS myMap_rtype LANGUAGE plperl AS
$$
return {} unless ($_[2] =~ m/$_[0]/);
return {"ip" => $_[1], "count" => 1}
$$;

-- TRANSITION myTransition
CREATE FUNCTION myTransition(state integer, count integer)
RETURNS integer LANGUAGE plperl AS
$$
return $_[0] + $_[1];
$$;

-- REDUCER myReduce
CREATE AGGREGATE myReduce (integer) (
  stype = integer,
  initcond = '0',
  sfunc = myTransition,
  prefunc = myTransition
);

-- EXECUTION
CREATE VIEW mapreduce_45852_run_1 AS
SELECT ip, myReduce(count) as state
FROM (SELECT ip(m), count(m) FROM (SELECT myMap('clar'::text, ip, url) as m FROM weblog) mapxq
WHERE m is not null) mapsubq
GROUP BY ip;


DROP TYPE IF EXISTS myMap_rtype CASCADE;
DROP EXTERNAL TABLE IF EXISTS weblog CASCADE;
DROP FUNCTION IF EXISTS myMap(text, text, text) CASCADE;
DROP FUNCTION IF EXISTS myTransition(integer, integer) CASCADE;
DROP AGGREGATE IF EXISTS myReduce(integer) CASCADE;
DROP VIEW IF EXISTS mapreduce_45852_run_1 CASCADE;

