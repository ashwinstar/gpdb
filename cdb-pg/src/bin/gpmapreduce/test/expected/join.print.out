-- start_matchsubs
-- m/mapreduce_\d+_run/
-- s/mapreduce_\d+/mapreduce_DUMMY/
-- m/'file:[^']*'/
-- s/'file:[^']*'/'file:DUMMY'/
-- m/'EXECUTE '[^']*'/
-- s/'EXECUTE '[^']*'/EXECUTE 'DUMMY'/
-- end_matchsubs
CREATE TYPE reverse_rtype as (key integer, value integer);

CREATE TYPE myMap_rtype as (key text, value integer);

-- INPUT weblog
CREATE EXTERNAL TABLE weblog(value text)
  LOCATION('file://maple/Users/cwelton/dev/cdb2/main/cdb-pg/src/bin/gpmapreduce/test/data/access_log')
  FORMAT 'TEXT';

-- MAP myMap
CREATE FUNCTION myMap(value text)
RETURNS myMap_rtype LANGUAGE plperl AS
$$
return {} unless ($_[0] =~ m/GET ([^ ?,]+)/);
return {"key" => $1, "value" => 1}
$$;

-- TRANSITION myTransition
CREATE FUNCTION myTransition(state integer, value integer)
RETURNS integer LANGUAGE plperl AS
$$
return $_[0] + $_[1];
$$;

-- REDUCER myReduce
CREATE AGGREGATE myReduce (integer) (
  stype = integer,
  initcond = '0',
  sfunc = myTransition,
  prefunc = myTransition
);

-- TASK access_count
CREATE VIEW access_count AS
SELECT key, myReduce(value) as value
FROM (SELECT key(m), value(m) FROM (SELECT myMap(value) as m FROM weblog) mapxq
WHERE m is not null) mapsubq
GROUP BY key;

-- INPUT network
CREATE EXTERNAL TABLE network(key integer, value integer)
  LOCATION('file://maple/Users/cwelton/dev/cdb2/main/cdb-pg/src/bin/gpmapreduce/test/data/www.small.dat')
  FORMAT 'TEXT' ( DELIMITER '|' );

-- MAP reverse
CREATE FUNCTION reverse(key integer, value integer)
RETURNS reverse_rtype LANGUAGE plpythonu AS
$$
return {'key': value, 'value': key}
$$;

-- TASK reverse_network
CREATE VIEW reverse_network AS
SELECT key(m), value(m) FROM (SELECT reverse(key, value) as m FROM network) mapxq
WHERE m is not null;

-- INPUT reverse_access_count
CREATE VIEW reverse_access_count AS
SELECT a.key as akey, b.key as bkey, sum(b.value::integer) as value
FROM   reverse_network a, access_count b
WHERE  a.key != b.key
GROUP BY a.key, b.key
;

-- EXECUTION
CREATE VIEW mapreduce_54089_run_1 AS
SELECT * FROM reverse_access_count;


DROP TYPE IF EXISTS reverse_rtype CASCADE;
DROP TYPE IF EXISTS myMap_rtype CASCADE;
DROP EXTERNAL TABLE IF EXISTS weblog CASCADE;
DROP FUNCTION IF EXISTS myMap(text) CASCADE;
DROP FUNCTION IF EXISTS myTransition(integer, integer) CASCADE;
DROP AGGREGATE IF EXISTS myReduce(integer) CASCADE;
DROP VIEW IF EXISTS access_count CASCADE;
DROP EXTERNAL TABLE IF EXISTS network CASCADE;
DROP FUNCTION IF EXISTS reverse(integer, integer) CASCADE;
DROP VIEW IF EXISTS reverse_network CASCADE;
DROP VIEW IF EXISTS reverse_access_count CASCADE;
DROP VIEW IF EXISTS mapreduce_54089_run_1 CASCADE;

