-- start_matchsubs
-- m/mapreduce_\d+_run/
-- s/mapreduce_\d+/mapreduce_DUMMY/
-- m/'file:[^']*'/
-- s/'file:[^']*'/'file:DUMMY'/
-- m/'EXECUTE '[^']*'/
-- s/'EXECUTE '[^']*'/EXECUTE 'DUMMY'/
-- end_matchsubs
CREATE TYPE reverse_rtype as (key integer, value integer);

-- INPUT network
CREATE EXTERNAL TABLE network(key integer, value integer)
  LOCATION('file://maple/Users/cwelton/dev/cdb2/main/cdb-pg/src/bin/gpmapreduce/test/data/www.small.dat')
  FORMAT 'TEXT' ( DELIMITER '|' );

-- MAPPER reverse
CREATE FUNCTION reverse(key integer, value integer)
RETURNS reverse_rtype LANGUAGE plpythonu AS
$$
return {'key': value, 'value': key}
$$;

-- TRANSITION pcount
CREATE FUNCTION pcount(state integer, value integer)
RETURNS integer LANGUAGE plpythonu AS
$$
return state + 1
$$;

-- REDUCER traverse
CREATE AGGREGATE traverse (integer) (
  stype = integer,
  initcond = '0',
  sfunc = pcount
);

-- EXECUTION
CREATE VIEW mapreduce_99890_run_1 AS
SELECT key, traverse(value) as state
FROM network
GROUP BY key;

-- EXECUTION
CREATE VIEW mapreduce_99890_run_2 AS
SELECT key, traverse(value) as state
FROM (SELECT key(m), value(m) FROM (SELECT reverse(key, value) as m FROM network) mapxq
WHERE m is not null) mapsubq
GROUP BY key;

-- EXECUTION
CREATE VIEW mapreduce_99890_run_3 AS
SELECT * FROM network;


DROP TYPE IF EXISTS reverse_rtype CASCADE;
DROP EXTERNAL TABLE IF EXISTS network CASCADE;
DROP FUNCTION IF EXISTS reverse(integer, integer) CASCADE;
DROP FUNCTION IF EXISTS pcount(integer, integer) CASCADE;
DROP AGGREGATE IF EXISTS traverse(integer) CASCADE;
DROP VIEW IF EXISTS mapreduce_99890_run_1 CASCADE;
DROP VIEW IF EXISTS mapreduce_99890_run_2 CASCADE;
DROP VIEW IF EXISTS mapreduce_99890_run_3 CASCADE;

