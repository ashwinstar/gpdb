--- CREATING OBJECTS --- 
CREATE EXTERNAL TABLE access_log(value text)
  LOCATION('file://@hostname@@abs_srcdir@/data/access_log',
           'file://@hostname@@abs_srcdir@/data/access_log2')
  FORMAT 'text';

--- RUN QUERIES --- 
SELECT value
FROM access_log
ORDER BY value;

--- CLEANUP OBJECTS --- 
DROP EXTERNAL TABLE IF EXISTS access_log CASCADE;
