DROP FUNCTION IF EXISTS grep_map(text, text) CASCADE;
DROP TYPE IF EXISTS MapReduceType_grep_map CASCADE;
DROP EXTERNAL TABLE IF EXISTS inDirectory CASCADE;
CREATE EXTERNAL TABLE inDirectory(value text)
  LOCATION('file://maple/Users/cwelton/GPMapReduce/example/data/access_log')
  FORMAT 'text';
CREATE TYPE MapReduceType_grep_map as (key text, value text);
CREATE FUNCTION grep_map(key text, value text)
RETURNS MapReduceType_grep_map AS $$
return {"key" => $_[0], "value" => $_[1]} if ($_[1] =~/$_[0]/);
return {};

$$ LANGUAGE plperl STRICT IMMUTABLE;
SELECT key(m), value(m)
FROM (SELECT grep_map('admin', value) as m
      FROM inDirectory) q1
WHERE m is not null
ORDER BY key, value;
DROP FUNCTION IF EXISTS grep_map(text, text) CASCADE;
DROP TYPE IF EXISTS MapReduceType_grep_map CASCADE;
DROP EXTERNAL TABLE IF EXISTS inDirectory CASCADE;

