--- CREATING OBJECTS --- 
CREATE EXTERNAL TABLE weblog(ip       text, rfc      text, uname    text, date     text, timezone text, method   text, url      text, protocol text, status   integer, bytes    integer)
  LOCATION('file://@hostname@@abs_srcdir@/data/access_log_fake')
  FORMAT 'text' (DELIMITER '|');

CREATE FUNCTION myMap(IN key text, IN ip text, IN url text, OUT ip text, OUT count integer) AS $$
{
    return {} unless $_[2] =~ /$_[0]/;
    return {'ip', $_[1], 'count', 1};
}
$$ LANGUAGE plperl;

CREATE FUNCTION myTransition(IN state integer, IN count integer, OUT state integer) AS $$
{
    return $_[0] + $_[1];
}
$$ LANGUAGE plperl;

CREATE AGGREGATE myReduce(integer) (
  stype = integer,
  initcond = '0',
  sfunc = myTransition,
  prefunc = myTransition
);

--- RUN QUERIES --- 
SELECT ip, myReduce(count) as value
FROM (SELECT ip(m), count(m) FROM (SELECT myMap('admin'::text, ip, url) as m FROM weblog) q1
WHERE m is not null) q2
GROUP BY ip
ORDER BY ip, value;

--- CLEANUP OBJECTS --- 
DROP AGGREGATE IF EXISTS myReduce(integer) CASCADE;
DROP FUNCTION IF EXISTS myMap(text, text, text) CASCADE;
DROP FUNCTION IF EXISTS myTransition(integer, integer) CASCADE;
DROP EXTERNAL TABLE IF EXISTS weblog CASCADE;
