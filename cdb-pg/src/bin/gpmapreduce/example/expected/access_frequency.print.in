--- CREATING OBJECTS --- 
CREATE EXTERNAL TABLE weblog(value text)
  LOCATION('file://@hostname@@abs_srcdir@/data/access_log',
           'file://@hostname@@abs_srcdir@/data/access_log2')
  FORMAT 'text';

CREATE TYPE myMap_Return as (key text, value text);
CREATE FUNCTION myMap(key text, value text) RETURNS myMap_Return AS $$
{
    return {} unless $_[1] =~ /GET ([^ ?,]+)/;
    return {'key', $1, 'value', 1};
}
$$ LANGUAGE plperl;

CREATE FUNCTION myTransition(state text, value text) RETURNS text AS $$
{
    return $_[0] + $_[1];
}
$$ LANGUAGE plperl;

CREATE AGGREGATE myReduce(text) (
  stype = text,
  initcond = '0',
  sfunc = myTransition,
  prefunc = myTransition
);

--- RUN QUERIES --- 
SELECT key, myReduce(value) as value
FROM (SELECT key(m), value(m) FROM (SELECT myMap('admin'::text, value) as m FROM weblog) q1
WHERE m is not null) q2
GROUP BY key
ORDER BY key, value;

--- CLEANUP OBJECTS --- 
DROP AGGREGATE IF EXISTS myReduce(text) CASCADE;
DROP FUNCTION IF EXISTS myMap(text, text) CASCADE;
DROP TYPE IF EXISTS myMap_Return CASCADE;
DROP FUNCTION IF EXISTS myTransition(text, text) CASCADE;
DROP EXTERNAL TABLE IF EXISTS weblog CASCADE;
