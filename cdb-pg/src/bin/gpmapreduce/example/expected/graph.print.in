--- CREATING OBJECTS --- 
CREATE EXTERNAL TABLE network(key integer, value integer)
  LOCATION('file://@hostname@@abs_srcdir@/data/www.small.dat')
  FORMAT 'text' (DELIMITER '|');

CREATE TYPE reverse_Return as (key integer, value integer);
CREATE FUNCTION reverse(key integer, value integer) RETURNS reverse_Return AS $$
return {'key': value, 'value': key}
$$ LANGUAGE plpythonu;

CREATE FUNCTION pcount(state integer, value integer) RETURNS integer AS $$
return state + 1
$$ LANGUAGE plpythonu;

CREATE AGGREGATE traverse(integer) (
  stype = integer,
  initcond = '0',
  sfunc = pcount
);

--- RUN QUERIES --- 
SELECT key, traverse(value) as value
FROM network
GROUP BY key
ORDER BY key, value;

SELECT key, traverse(value) as value
FROM (SELECT key(m), value(m) FROM (SELECT reverse(key, value) as m FROM network) q1
WHERE m is not null) q2
GROUP BY key
ORDER BY key, value;

SELECT key, value
FROM network
ORDER BY key, value;

--- CLEANUP OBJECTS --- 
DROP AGGREGATE IF EXISTS traverse(integer) CASCADE;
DROP FUNCTION IF EXISTS reverse(integer, integer) CASCADE;
DROP TYPE IF EXISTS reverse_Return CASCADE;
DROP FUNCTION IF EXISTS pcount(integer, integer) CASCADE;
DROP EXTERNAL TABLE IF EXISTS network CASCADE;
