%YAML 1.1
---
VERSION:         1.0.0.1
DATABASE:        postgres
USER:            @db_user@

DEFINE:
  - INPUT:
      NAME:      inDirectory
      SOURCE:    file://@hostname@@abs_srcdir@/data/access_log
  - MAP:
      NAME:      grep_map
      BODY:  |
        return {"key" => $_[0], "value" => $_[1]} if ($_[1] =~/$_[0]/);
        return {};
      LANGUAGE:  perl
      OPTIMIZE:  STRICT IMMUTABLE

EXECUTE:
  - RUN:
      SOURCE:    inDirectory
      MAPPER:    grep_map
      REDUCER:   IDENTITY
      TARGET:    STDOUT
