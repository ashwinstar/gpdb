%YAML 1.1
---
VERSION:         1.0.0.1
DATABASE:        postgres
USER:            @db_user@

DEFINE:
  - INPUT:
      NAME:      inDirectory
      FILE:
        - @hostname@:@abs_srcdir@/data/access_log
        - @hostname@:@abs_srcdir@/data/access_log2

  - MAP:
      NAME:      grep_map
      FUNCTION:  |
        return {"key" => $_[0], "value" => $_[1]} if ($_[1] =~/$_[0]/);
        return {};
      LANGUAGE:  perl
      OPTIMIZE:  STRICT IMMUTABLE

  - TASK:
      NAME:      grep_task
      SOURCE:    inDirectory
      MAPPER:    grep_map
      REDUCER:   IDENTITY
      
EXECUTE:
  - RUN:         grep_task

