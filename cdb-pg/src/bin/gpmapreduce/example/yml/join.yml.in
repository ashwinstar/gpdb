%YAML 1.1
---  
VERSION:   1.0.0.1
DATABASE:  postgres
USER:      <USER>

DEFINE:

 # 1) Access log
    - INPUT:
        NAME:      weblog
        SOURCE:    file://<DATA_DIRECTORY>/access_log

    - MAP:
         NAME:     myMap
         LANGUAGE: perl
         BODY:     |
           return {} unless ($_[1] =~ m/GET ([^ ?,]+)/);
           return {"key" => $1, "value" => 1}

    - TRANSITION:
         NAME:     myTransition
         LANGUAGE: perl
         BODY:     return $_[0] + $_[1];

    - REDUCER:
         NAME:       myReduce
         INITIALIZE: '0'
         TRANSITION: myTransition
         COMBINE:    myTransition

    - JOB:
        NAME:     access_count
        SOURCE:   weblog
        MAPPER:   myMap
        REDUCER:  myReduce

# 2) Network graph

    - INPUT:
        NAME:      network
        SOURCE:    file://<DATA_DIRECTORY>/www.dat
        COLUMNS:   [key text, value text]
        DELIMITER: '|'

    - MAP:
        NAME:     reverse
        LANGUAGE: python
        BODY:     |
          return {'key': value, 'value': key}

    - JOB:
        NAME:     reverse_network
        SOURCE:   network
        MAPPER:   reverse


# 3) SQL join

    - INPUT:
        NAME:   reverse_access_count
        QUERY: |
          SELECT a.key, sum(b.value)
          FROM   reverse_network a, access_count b
          WHERE  a.key = b.key
          GROUP BY a.key
         
EXECUTE:
  - RUN:
      INPUT: reverse_access_count