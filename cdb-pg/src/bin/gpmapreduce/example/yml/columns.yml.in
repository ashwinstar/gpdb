%YAML 1.1
---  
VERSION:   1.0.0.1
DATABASE:  postgres
USER:      <USER>

DEFINE:
    - INPUT:
        NAME:      weblog
        SOURCE:    file://<DATA_DIRECTORY>/access_log_fake
        COLUMNS:
          - ip       text
          - rfc      text
          - uname    text
          - date     text
          - timezone text
          - method   text
          - url      text
          - protocol text
          - status   integer
          - bytes    integer
        DELIMITER: '|'
        
    - MAP:
         NAME:     myMap
         LANGUAGE: perl
         PARAMETERS: [key text, ip text, url text]
         RETURNS:    [ip text, count integer]
         BODY:     |
           return {} unless ($_[2] =~ m/$_[0]/);
           return {"ip" => $_[1], "count" => 1}

    - TRANSITION:
         NAME:      myTransition
         LANGUAGE:  perl
         PARAMETERS:
           - state integer
           - count integer
         BODY:     return $_[0] + $_[1];

    - REDUCER:
         NAME:       myReduce
         INITIALIZE: '0'
         TRANSITION: myTransition
         COMBINE:    myTransition

EXECUTE:
  - RUN:
     SOURCE:   weblog
     MAPPER:   myMap
     REDUCER:  myReduce
     TARGET:   STDOUT
