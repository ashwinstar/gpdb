<?xml version="1.0"?>

<!--

    build.xml

    This file is the CDB-PG subproject build driver.  It's main
    job is to take care of configuring a build for CDB's PostgreSQL.


    @version $Id$

-->

<!DOCTYPE project [
  <!--
      Entity "common" identifies the file containing the common ant elements 
      needed both here and in subproject build.xml files.  Ant elements other 
      than property are NOT inherited when ant calls itself for a subproject.

      The file common.xml is a collection of common targets useful to all
      subprojects.
    -->
  <!ENTITY common SYSTEM "file:../common.xml">
]>

<project name="cdb-pg"
         default="compile">

    <description>
      CDB PostgreSQL Subproject

    The default listener port for Postgres must be configured.  (A default has
    not been chosen for CDB.)  To provide the value, specify "-Dport=&lt;portnum&gt;"
    so it is available during the "configure" target.

    To set the directory into which Postgres "wants" to install itself, specify
    "-DinstallRoot=&lt;target-directory&gt;" so it is available during the 
    "configure" target.

    This subsystem can be configured for debugging builds by specifying
    "-Ddebug=true" for the "configure" target.  Debug options are included by
    default for builds performed against non-tagged working directories.  To
    override this, specify "-Dnodebug=true" for the "configure" target.

    Any of the build targets may cause a "distclean" if configuration conditions
    are deemed to have changed.  In this case, the value of the -Dport option is
    remembered from the prior configuration.

    (All build targets depend on the "configure" target.)

      Optional CDB Features

    CDB features that are controlled with compile-time switches may be
    optionally included in the build by specifying properties to the "configure"
    target.  The features and their corresponding properties are as follows:
      -Dcdb.enableDtx=true     Enable distributed transaction support
      -Dcdb.enableInsert=true  Enable CDB insert-hook for CDB-managed tables
    Specifying these flags does NOT force a reconfigure.  Thus, a "distclean"
    build will be required to force the reconfigure step when these flags are
    specified.
    </description>

    <!--
        Establish a reference to the project root directory.
      -->
    <property name="projectRoot" value=".."/>
  
    <!-- 
         This property is set by CVS checkout -r ...
         It is used for distribution build purposes.
      -->
    <property name="stickyTag" value="$$Name:  $$"/>

    <!--
        "Fink" locations for readline libraries and included on Mac OsX 
      -->
    <property name="osx.withincludes" value="/sw/include"/>
    <property name="osx.withlibraries" value="/sw/lib"/>

    <!--
        External headers that are necessary for CDB-specific components.
      -->
    <property name="cdb.withincludes" location="${projectRoot}/common/include" />

    <!--
        Documentation tools properties:
            D2MDIR is location of "docbook2man-spec.pl
      -->
    <property name="D2MDIR" value="/usr/local/bin"/>


    <property name="build.sysclasspath" value="ignore"/>


    <!--
        Insert common properties and targets.  
        The common targets are generally called from the init target.
      -->
    &common;


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Extablish preconditions for subproject build targets.          -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="init"
            depends="-init,-setMake,-setCCompiler,-setAr,-setObjcopy">

        <echo level="info">
            ========================================================================

            Building CDB PostgreSQL for ${releaseTag}

            Using tools=${tools}
            Using toolsLib=${toolsLib}

            ========================================================================
        </echo>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Perform a distribution-level clean of the project.             -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="distclean"
            depends="init,-checkDistcleanAllowed,-checkCrippledMake"
            if="distcleanAllowed"
            description="Clean the subproject of distribution materials">

        <!-- Clean build product too -->
        <antcall target="clean"/>
            
        <!-- Scrub configure output from the postgresql subproject. -->
        <exec executable="${make}"
              failonerror="false">
            <env key="LC_ALL" value="C"/>
            <arg line="${makeCleanOptions} distclean"/>
        </exec>

        <!-- Remove doc "enabling" links -->
        <antcall target="-cleanDoc"/>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Check to see if it's OK to run diskclean.                      -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-checkDistcleanAllowed"
            depends="-haveGNUmakefile">

        <condition property="distcleanAllowed">
            <and>
                <!-- distclean fails unless GNUmakefile exists -->
                <isset property="haveGNUmakefile"/>
                
                <or>
                    <isset property="distcleanRequired"/>
                    <not>
                        <isset property="distcleanChecked"/>
                    </not>
                </or>
            </and>
        </condition>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Check for the existence of GNUmakefile.                        -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-haveGNUmakefile" unless="haveGNUmakefile">
        <available property="haveGNUmakefile" file="GNUmakefile" filepath="${basedir}" type="file"/>
    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- make clean may fail if we've switched hosts.                   -->
    <!-- Among the problems is a missing src/Makefile.port and a bad    -->
    <!-- ANT reference.  Here, we try to re-establish these things.     -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-checkCrippledMake"
            depends="-setHostport,-setAntOption"
            unless="makeCleanOptions">

        <condition property="makeCleanOptions" value="${antOption}">
            <isset property="antOption"/>
        </condition>
        <property name="makeCleanOptions" value=""/>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Re-establish the current configuration's Makefile.port if the  -->
    <!-- symbolic link is broken.                                       -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-setHostport"
            depends="-extractConfigProperties,-checkMakefilePort"
            if="makefilePortMissing"
            unless="hostportOption">

        <!-- 
            Since Makefile.port is a symbolic link, a broken one is
            invisible to most ANT (Java) methods.  We need to resort
            to rm to delete it.
          -->
        <exec executable="rm"
              dir="src"
              failonerror="false">
            <arg value="Makefile.port"/>
        </exec>

        <!-- TODO: This should probably become a copy or something -->
        <exec executable="ln"
              dir="src"
              failonerror="false">
            <arg line="-f -s"/>
            <arg value="makefiles/Makefile.${config.PORTNAME}"/>
            <arg value="Makefile.port"/>
        </exec>

	<property name="hostportOption" value=""/>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Check to see if Makefile.port is available.  This is typically -->
    <!-- a symbolic link and appears missing if the link is broken.     -->
    <!-- The Makefile.port is considered missing only if we have a      -->
    <!-- GNUmakefile.                                                   -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-checkMakefilePort" 
            depends="-haveGNUmakefile"
            unless="makefilePortMissing">

        <condition property="makefilePortMissing">
            <and>
                <not>
                    <available file="Makefile.port" filepath="src" type="file"/>
                </not>
                <isset property="haveGNUmakefile"/>
            </and>
        </condition>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- If the configured ANT is pointing to space somewhere, force    -->
    <!-- use of the one for the project.                                -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-setAntOption"
            depends="-extractConfigProperties"
            if="haveMakefileGlobal"
            unless="antOption">

        <condition property="antOption" value="ANT=&quot;${toolsAnt}&quot;">
            <not>
                <available file="${config.ANT}" type="file"/>
            </not>
        </condition>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Clean the build output from the subproject.                    -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="clean"
            depends="init,-haveGNUmakefile,-checkCrippledMake"
            if="haveGNUmakefile"
            description="Remove the build output">

        <!-- Scrub build output from the postgresql subproject. -->
        <exec executable="${make}"
              failonerror="false">
            <arg line="${makeCleanOptions} clean"/>
        </exec>

        <!-- Remove doc "enabling" links -->
        <antcall target="-cleanDoc"/>

    </target>


    <target name="-configureOptionalFeatures">
	<!-- If cdb.enableDtx is set to "true", enable dtx in the build. -->
	<condition property="cdb.cflag.dtx" value="-DCDB_ENABLE_DTX">
	    <equals arg1="${cdb.enableDtx}" arg2="true" casesensitive="false" />
	</condition>
	<!-- Set cdb.cflag.dtx to empty-string if user didn't request DTX. -->
	<condition property="cdb.cflag.dtx" value="">
	    <not>
		<equals arg1="${cdb.enableDtx}" arg2="true" casesensitive="false" />
	    </not>
	</condition>

	<!-- If cdb.enableInsert is set to "true", enable insert in the build. -->
	<condition property="cdb.cflag.insert" value="-DCDB_ENABLE_INSERT_HOOK">
	    <equals arg1="${cdb.enableInsert}" arg2="true" casesensitive="false" />
	</condition>
	<!-- Set cdb.cflag.insert to empty-string if user didn't request insert. -->
	<condition property="cdb.cflag.insert" value="">
	    <not>
		<equals arg1="${cdb.enableInsert}" arg2="true" casesensitive="false" />
	    </not>
	</condition>

	<!-- Combine all the CDB CFLAGS values into one place. -->
	<property name="cdb.feature.cflags" value="${cdb.cflag.dtx} ${cdb.cflag.insert}" />
	
	<echo>
	      cdb.cflag.insert=${cdb.cflag.insert}
	         cdb.cflag.dtx=${cdb.cflag.dtx}
	OPTIONAL-FEATURE FLAGS=${cdb.feature.cflags}
	</echo>
    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Prepare PostgreSQL source tree for building.                   -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="configure"
            depends="init,-checkOptions,-checkDistcleanRequired,distclean,-checkConfigured,-checkReadline,-configureOptionalFeatures"
            unless="configured"
            description="Configure PostgreSQL source tree for building">

        <!-- 
            Options for debugging needed for PostgreSQL CONFIGURE 

            These are separated into options that need to appear in the CFLAGS
            property, and other options that need to be passed as arguments to
            the configure script.
          -->
        <condition property="CdebugOptions"
                   value="--enable-cassert">
            <or>
                <isset property="debug"/>
                <and>
                    <isset property="devoBuild"/>
                    <not>
                        <isset property="nodebug"/>
                    </not>
                </and>
            </or>
        </condition>
        <property name="CdebugOptions" value=""/>

        <condition property="cdb.debug.cflags" value="-O0">
            <or>
                <isset property="debug"/>
                <and>
                    <isset property="devoBuild"/>
                    <not>
                        <isset property="nodebug"/>
                    </not>
                </and>
            </or>
        </condition>
        <property name="cdb.debug.cflags" value=""/>

        <!-- 
            Set thread support option for supported platforms 
          -->
        <condition property="enableThreading" value="--enable-thread-safety">
            <or>
                <isset property="osIsLinux"/>
                <isset property="osIsSolaris"/>
            </or>
            <!-- Do not set for cygwin -->
            <!-- Do not set for darwin/MacOsX -->
        </condition>
        <property name="enableThreading" value=""/>

        <!-- 
            Set thread support option for supported platforms 
          -->
        <condition property="enableThreading" value="--enable-thread-safety">
            <or>
                <isset property="osIsLinux"/>
                <isset property="osIsSolaris"/>
            </or>
            <!-- Do not set for cygwin -->
            <!-- Do not set for darwin/MacOsX -->
        </condition>
        <property name="enableThreading" value=""/>

        <!--
            Configure for a PostgreSQL Build
          -->
        <exec executable="bash"
              failonerror="true">
            <env key="LC_ALL" value="C"/>
            <arg file="configure"/>
            <arg line="${CdebugOptions} --enable-debug"/>
            <arg line="CFLAGS='${platformCFLAGS} ${cdb.debug.cflags} ${cdb.feature.cflags}'"/>
            <arg line="--with-CC=${CCompiler} --with-CXX=${CxxCompiler}"/>
            <arg line="${enableThreading} ${readlineSupport} --with-java --with-perl"/>
            <arg value="--enable-multibyte=UNICODE"/>
            <arg value="--with-maxbackends=1024"/>
            <arg value="--with-docdir=${installRoot}/${releaseDir}/doc"/>
            <arg value="--mandir=${installRoot}/${releaseDir}/man"/>
            <arg value="--prefix=${installRoot}/${releaseDir}/pgsql"/>
            <arg value="--with-pgport=${port}"/>

        </exec>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Determine configure options for readline support.              -->
    <!--                                                                -->
    <!-- The supporting libraries and includes for readline are usually -->
    <!-- found by configure.  However, Mac OsX, readline is not         -->
    <!-- distributed by a usual source; it is generally obtained by way -->
    <!-- of "fink" - and configure can't find it.                       -->
    <!--                                                                -->
    <!-- This routine confirms the "fink" location of readline and sets -->
    <!-- configure options accordingly.                                 -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-checkReadline"
            depends="-init"
            unless="readlineSupport">

        <!-- Make sure common headers are available, since we need them! -->
        <ant antfile="${projectRoot}/common/build.xml"
             dir="${projectRoot}/common"
             target="expandHeaders" />

        <!--
            If includes and libraries are installed in the expected place
            on a MacOsX platform, set "readlineSupport" to the proper
            values to include the support.  Otherwise, set "readlineSupport"
            to disable readline support and warn the user.
          -->
        <condition property="readlineSupport" 
                   value="--with-includes=&quot;${cdb.withincludes}:${osx.withincludes}&quot; 
                          --with-libraries=&quot;${osx.withlibraries}&quot;">
            <and>
                <isset property="osIsMacosx"/>
                <available file="readline.h" filepath="${osx.withincludes}/readline" type="file"/>
                <available file="libreadline.a" filepath="${osx.withlibraries}" type="file"/>
            </and>
        </condition>
        <condition property="readlineIsMissing">
            <and>
                <isset property="osIsMacosx"/>
                <not>
                    <isset property="readlineSupport"/>
                </not>
            </and>
        </condition>
        <condition property="readlineSupport"
                   value="--with-includes=&quot;${cdb.withincludes}&quot; 
                          --without-readline">
            <and>
                <isset property="osIsMacosx"/>
                <not>
                    <isset property="readlineSupport"/>
                </not>
            </and>
        </condition>
        <antcall target="-macNoReadline"/>

        <!-- Default value is empty string -->
        <condition property="readlineSupport"
                   value="--with-includes=&quot;${cdb.withincludes}&quot;">
            <not>
                <isset property="readlineSupport"/>
            </not>
        </condition>
        
    </target>

    <target name="-macNoReadline" if="readlineIsMissing">
        <echo level="warning">
            ***********************************************************

            Readline not found in expected location:
                lib=${osx.withlibraries}
                include=${osx.withincludes}

            Specify 
                "-Dosx.withlibraries=&lt;lib-location&gt;" 
            and
                "-Dosx.withincludes=&lt;include-location&gt;" 
            to enable readline support.

            Configuring without readline support.

            ***********************************************************
        </echo>
    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Ensure that all required command line options are provided.    -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-checkOptions"
            depends="-setPort">

        <fail unless="port" message="Variable port must be set (use -Dport=&lt;port&gt;)"/>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Determine the currently configured port.                       -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-setPort" 
            depends="-extractConfigProperties"
            unless="port">
        
        <condition property="port" value="${DEF_PGPORT}">
            <isset property="DEF_PGPORT"/>
        </condition>
        
    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Extract certain build properties out of src/Makefile.global.   -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-extractConfigProperties" 
            depends="-haveMakefileGlobal"
            if="haveMakefileGlobal">
    
        <loadproperties srcFile="src/Makefile.global">
            <filterchain>
                <linecontainsregexp>
                    <regexp pattern="^DEF_PGPORT\p{Space}*="/>
                </linecontainsregexp>
            </filterchain>
        </loadproperties>
    
        <loadproperties srcFile="src/Makefile.global">
            <filterchain>
                <linecontainsregexp>
                    <regexp pattern="^host_tuple\p{Space}*="/>
                </linecontainsregexp>
                <prefixlines prefix="config."/>
            </filterchain>
        </loadproperties>
    
        <loadproperties srcFile="src/Makefile.global">
            <filterchain>
                <linecontainsregexp>
                    <regexp pattern="^ANT\p{Space}*="/>
                </linecontainsregexp>
                <prefixlines prefix="config."/>
            </filterchain>
        </loadproperties>
    
        <loadproperties srcFile="src/Makefile.global">
            <filterchain>
                <linecontainsregexp>
                    <regexp pattern="^PORTNAME\p{Space}*="/>
                </linecontainsregexp>
                <prefixlines prefix="config."/>
            </filterchain>
        </loadproperties>
    
        <loadproperties srcFile="src/Makefile.global">
            <filterchain>
                <linecontainsregexp>
                    <regexp pattern="^prefix\p{Space}*:="/>
                </linecontainsregexp>
                <prefixlines prefix="temp."/>
            </filterchain>
        </loadproperties>

        <loadproperties srcFile="src/Makefile.global">
	    <filterchain>
	        <linecontainsregexp>
		    <regexp pattern="^CFLAGS\p{Space}*="/>
		</linecontainsregexp>
		<prefixlines prefix="config."/>
	    </filterchain>
	</loadproperties>

        <loadproperties srcFile="src/Makefile.global">
	    <filterchain>
	        <linecontainsregexp>
		    <regexp pattern="^CPPFLAGS\p{Space}*="/>
		</linecontainsregexp>
		<prefixlines prefix="config."/>
	    </filterchain>
	</loadproperties>

        <script language="beanshell"><![CDATA[
            /**
             * "Fixes" prefix value (removes leading " = " caused
             * by Makefile's ":=".  Also determines and sets value
             * of "config.installRoot" from "prefix".
             */
            String prefix = project.getProperty("temp.prefix");
            String configPrefix = prefix.replaceFirst("\\p{Space}*=\\p{Space}*", "");
            configPrefix = configPrefix.trim();
            project.setNewProperty("config.prefix", configPrefix);

            /*
             * The expectation is that "prefix" from Makefile.global has
             * two qualifiers trailing "installRoot".  If we find fewer than
             * two qualifiers, then "installRoot" is presumed to have been
             * empty.
             */
            String configInstallRoot = "";
            int p;
            if ( (p = configPrefix.lastIndexOf('/')) > -1 )
            {
                if ( (p = configPrefix.lastIndexOf('/', p - 1)) > -1 )
                    configInstallRoot = configPrefix.substring(0, p);
            }
            project.setNewProperty("config.installRoot", configInstallRoot);
            ]]>
        </script>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Check for the existence of src/Makefile.global.                -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-haveMakefileGlobal" unless="haveMakefileGlobal">
        <available property="haveMakefileGlobal" file="Makefile.global" filepath="${basedir}/src" type="file"/>
    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- check to see if conditions have changed rendering the current  -->
    <!-- configuration unsuitable.                                      -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-checkDistcleanRequired"
            depends="-checkHostChange,-checkInstallRootChange,-checkIncludesAreMissing">

        <condition property="distcleanRequired">
            <or>
                <isset property="hostIsChanged"/>
                <isset property="installRootIsChanged"/>
                <isset property="includesAreMissing"/>
            </or>
        </condition>

        <property name="distcleanChecked" value="true"/>
    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Check to see if the configured install root is not longer      -->
    <!-- current.                                                       -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-checkInstallRootChange"
            depends="-extractConfigProperties">

        <condition property="installRootIsChanged">
            <not>
                <equals trim="true" arg1="${installRoot}" arg2="${config.installRoot}"/>
            </not>
        </condition>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Check to see if the configured build host is no longer         -->
    <!-- current.                                                       -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-checkHostChange"
            depends="-extractConfigProperties">
            
        <!--
            Ask the configuration utility to tell us what type of system
            we're running on.  While this isn't exactly what PostgreSQL
            uses for a port identifier, it's as close as we get without
            copying all of the code that maps this to the port identifier.
          -->
        <exec executable="bash"
              outputproperty="current.host_tuple"
              resultproperty="current.host_tuple.code"
              failonerror="false">
            <env key="LC_ALL" value="C"/>
            <arg file="config/config.guess"/>
        </exec>

        <!--
            The configured build host is considered to have changed if
            either the configured host type identifier (config.host_tuple)
            or the current host type identifier (current.host_tuple) is
            not set or if they aren't equal.
          -->
        <condition property="hostIsChanged">
            <or>
                <not>
                    <isset property="config.host_tuple"/>
                </not>
                <not>
                    <isset property="current.host_tuple"/>
                </not>
                <not>
                    <equals trim="true" arg1="${config.host_tuple}" arg2="${current.host_tuple}"/>
                </not>
            </or>
        </condition>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Check to see if the CDB include directory is missing from the  -->
    <!-- Makefile.global -I... list.  This is in CPPFLAGS.              -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-checkIncludesAreMissing"
            depends="-extractConfigProperties">
	<condition property="includesAreMissing">
	    <not>
	        <contains string="${config.CPPFLAGS}" substring="common/include" />
	    </not>
	</condition>
    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Check configuration conditions.                                -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-checkConfigured" unless="configured">

        <condition property="configured">
            <and>
                <available file="GNUmakefile" filepath="${basedir}" type="file"/>
                <available file="Makefile.port" filepath="${basedir}/src" type="file"/>
            </and>
        </condition>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Remove the links that enable/force doc generation.             -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-cleanDoc">

        <!-- Discard the LINKs required for doc build -->
        <exec executable="rm"
              dir="doc"
              failonerror="false">
            <arg value="man.tar.gz"/>
            <arg value="postgres.tar.gz"/>
        </exec>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Build the PostgreSQL documentation.                            -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="makeDoc"
            depends="init,configure,-checkDocTools"
            if="docToolsAvailable"
            description="Build man pages for PostgreSQL (requires special tools)">

        <!--
            Build the PostgreSQL documentation
          -->
        <exec executable="${make}"
              dir="doc/src"
              failonerror="true">
             <env key="LC_ALL" value="C"/>
             <env key="D2MDIR" value="${D2MDIR}"/>
             <arg value="man.tar.gz"/>
             <arg value="postgres.tar.gz"/>
        </exec>
        <exec executable="ln"
              dir="doc"
              failonerror="false">
             <arg line="-s src/man.tar.gz"/>
        </exec>
        <exec executable="ln"
              dir="doc"
              failonerror="false">
             <arg line="-s src/postgres.tar.gz"/>
        </exec>
        
    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Issue message if documentation tools are unavailable.          -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-checkDocTools"
            depends="-checkAllDocTools"
            unless="docToolsAvailable">

        <echo level="warning">
            ***********************************************************
            One or more tools is missing for document generation -- bypassed!
            ***********************************************************
        </echo>

        <!-- Remove doc "enabling" links to prevent install failures -->
        <antcall target="-cleanDoc"/>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Check availability of documentation tools                      -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="-checkAllDocTools"
            unless="docToolsAvailable">

        <condition property="haveDocbook2man">
            <available file="docbook2man-spec.pl" filepath="${D2MDIR}" type="file"/>
        </condition>

        <condition property="docToolsAvailable">
            <and>
                <isset property="haveDocbook2man"/>
            </and>
        </condition>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Compile PostgreSQL using configured options.                   -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="compile"
            depends="init,configure"
            description="Compile all &quot;supported&quot; parts of CDB&apos;s PostgreSQL">

        <!--
            Build PostgreSQL
          -->
        <exec executable="${make}"
              failonerror="true">
            <env key="LC_ALL" value="C"/>
            <arg value="--jobs=4"/>
        </exec>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Compile and install PostgreSQL.                                -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="install"
            depends="init,compile"
            description="Install &quot;supported&quot; parts of CDB&apos;s PostgreSQL">

        <!-- "Default" value for DESTDIR is empty string -->
        <condition property="DESTDIR" value="">
            <not>
                <isset property="DESTDIR"/>
            </not>
        </condition>

        <!--
            Build PostgreSQL
          -->
        <exec executable="${make}"
              failonerror="true">
            <env key="LC_ALL" value="C"/>
            <env key="DESTDIR" value="${DESTDIR}"/>
            <arg value="install"/>
        </exec>

    </target>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Compile and install PostgreSQL with documentation.             -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="installWithDoc"
            depends="init,makeDoc,install"
            description="Install documentation and other &quot;supported&quot; parts of CDB&apos;s PostgreSQL"/>


    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <!-- Generate ctags for the project.                                -->
    <!-- =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- -->
    <target name="ctags"
            depends="-checkBash"
            description="Generate ctags for cdb-pg source tree">

        <exec executable="bash"
              dir="src"
              failonerror="true">
            <env key="LC_ALL" value="C"/>
            <arg file="src/tools/make_ctags"/>
        </exec>

    </target>

</project>

