#!/bin/bash
#	Filename:-		gprebuildsystem
#	Version:-		$Revision$
#	Updated:-		$Date$
#	Status:-		Released.
#	Author:-		G Coombe
#	Contact:-		gcoombe@greenplum.com
#	Release date:-		March 2006
#	Release stat:-		Greenplum Co internal
#                               Copyright (c) Metapa 2005. All Rights Reserved.
#                               Copyright (c) Greenplum 2005. All Rights Reserved
#	Brief descn:-		Rebuilds a MPP instance from a SQL dump file.
#******************************************************************************
# Update History
#******************************************************************************
# Ver	Date		Who		Update
#******************************************************************************
# Detailed Description
#******************************************************************************
#
#******************************************************************************
# Prep Code
# Source required functions file, this required for script to run
# exit if cannot locate this file. Change location of FUNCTIONS variable
# as required.
WORKDIR=`dirname $0`
FUNCTIONS=$WORKDIR/lib/gp_bash_functions.sh
if [ -f $FUNCTIONS ]; then
		. $FUNCTIONS
else
		echo "[FATAL:]-Cannot source $FUNCTIONS file Script Exits!"
		exit 2
fi
#******************************************************************************
# Location Variables
#******************************************************************************

#******************************************************************************
# Command Variables
#******************************************************************************

#******************************************************************************
# Script Specific Variables
#******************************************************************************
INTERACTIVE=1
STOP_BUILD=0
VERBOSE=1
WAIT="-w"
MODE=smart
TIME=`$DATE +%H%M%S`
CUR_DATE=`$DATE +%Y%m%d`
PROG_NAME=`$BASENAME $0`
HELP_DOC_NAME=`$ECHO $PROG_NAME|$AWK -F'.' '{print $1}'`_help
QD_NAME=`hostname`
EXIT_STATUS=0
TEMP_PORT=55555
ENCODING=UNICODE
CHECK_POINT_SEGMENTS=8
START_GPSYNC=1
NOCREATEDB=0
TMP_PG_HBA=/tmp/pg_hba_conf_master.$$
#******************************************************************************
# Functions
#******************************************************************************
#
USAGE () {
	if [ -f ${GPDOCDIR}/$HELP_DOC_NAME ] && [ x"" == x"$SCRIPT_USAGE" ];then
		$MORE ${GPDOCDIR}/$HELP_DOC_NAME
	exit 0
	else
		$ECHO	
		$ECHO "      `basename $0 `"
		$ECHO
		$ECHO "      Re-constructs an MPP instance from a secured catalogue SQL file."
		$ECHO "      Will build a Master database and all segment instances detailed"
		$ECHO "      in the SQL file. Upon completion, the instance will be operational"
		$ECHO "      and ready for a user data restore."
		$ECHO "      Script will not rebuild a default database i.e. template1, it must"
		$ECHO "      be a user created database. Should this be the case use the"
		$ECHO "      gpcreatesystem.sh script with the required configuration file to"
		$ECHO "      rebuild the MPP instance to a pre user database creation state."
		$ECHO
		$ECHO "      Usage:"
		$ECHO "      $0 [OPTIONS]"
		$ECHO
		$ECHO "      General options:"
		$ECHO "      -?, display this help message & exit" 
		$ECHO "      -v, display version information & exit"
		$ECHO
		$ECHO "      Logging options:"
		$ECHO "      -q, quiet mode, do not log progress to screen [default:- verbose output to screen]"
		$ECHO "      -l, <logfile directory> alternative logfile directory [optional]"
		$ECHO "      -a, don't ask to confirm re-build [default:- ask]"
		$ECHO "      -D, set log output to debug level, shows all function calls"
		$ECHO
		$ECHO "      Rebuild options:"
		$ECHO "      -s, /<directory>/<sql catalog dump file name> [mandatory]"
		$ECHO "          example file name gp_catalog_1_1_20060512103500"
		$ECHO "      -d, <temporary data directory name> directory where a temporary database can be created"
		$ECHO "          to allow parsing of <sql source file name> [mandatory]"
		$ECHO "          Directory name supplied must exist."
		$ECHO "      -c, value of checkpoint segments [default:-$CHECK_POINT_SEGMENTS]"
		$ECHO "      -m, build master instance only [default:- build complete instance]"
		$ECHO "          Use this option if you wish to change the names of the segment"
		$ECHO "          instance hosts"
		$ECHO "      -o, override hostname check and set master hostname to current host"
		$ECHO "      -x, do not create database if *cdatabase* file exists in same directory as the"
		$ECHO "          <sql source file name> file [default create database if file exists]"
		$ECHO "      -i, alternative IP allow for pg_hba.conf [default:-$DEFAULT_IP_ALLOW]"
		$ECHO "      -n, <locale setting> locale setting when database initialized [dafeult:-$DEFAULT_LOCALE_SETTING]"
		$ECHO "      -p, set temporary database port number [default $TEMP_PORT]"
		$ECHO
		$ECHO "      Return codes:"
		$ECHO "      0 No problems encountered with requested operation"
		$ECHO "      1 Warning generated, but master database operational"
		$ECHO "      2 Fatal error, database not rebuilt, or in an inconsistent state"
		$ECHO
		exit $EXIT_STATUS
	fi
}

UNKNOWN_OPTION () {
		$ECHO
		$ECHO "[ERROR]:-Unknown option $1"
		USAGE
}


CREATE_TEMP_DB () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Creating temporary parsing database" 1
	MASTER_IP_ADDRESS=(`$IFCONFIG -a |$GREP "inet "|$GREP -v "127."|$AWK '{print $2}'|$CUT -d: -f2`)	
	RUN_COMMAND "$INITDB -E $ENCODING --locale=$LOCALE_SETTING -D ${TEMP_DATA_DIRECTORY}/parsetemp"
	LOG_MSG "[INFO]:-Successfully initialized temporary parsing database" 1
	LOG_MSG "[INFO]:-Setting temporary port number to $TEMP_PORT" 1
	ED_FILE ${TEMP_DATA_DIRECTORY}/parsetemp/$PG_CONF "#port" port=$TEMP_PORT 0
	ERROR_CHK $? "set temporary instance port = $TEMP_PORT" 2
	LOG_MSG "[INFO]:-Configuring Master $PG_HBA" 1
	BUILD_MASTER_PG_HBA_FILE $TEMP_DATA_DIRECTORY/parsetemp $DEFAULT_IP_ALLOW
	LOG_MSG "[INFO]:-Starting temporary database" 1
	export PGPORT=$TEMP_PORT;$PG_CTL -w -D ${TEMP_DATA_DIRECTORY}/parsetemp -l ${TEMP_DATA_DIRECTORY}/parsetemp.log -o "-i -p $TEMP_PORT" start 
	ERROR_CHK $? "start of temporary database ${TEMP_DATA_DIRECTORY} port = $TEMP_PORT" 2
	LOG_MSG "[INFO]:-Loading Greenplum Database metadata" 1
	env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT $DEFAULTDB -f $SQL_FILE
	ERROR_CHK $? "load schema file $SQL_FILE into $DEFAULTDB database" 2
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

PARSE_SQL_FILE () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Processing $SQL_FILE to obtain re-build parameters"
	MASTER_HOST=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -A -t -p $TEMP_PORT $DEFAULTDB -c "select hostname from $CONFIG_TABLE where content=-1 and dbid=1;"`
	if [ $? -ne 0 ] || [ ! $MASTER_HOST ];then STOP_BUILD=1;MASTER_HOST=FAILED;fi
	LOG_MSG "[INFO]:-Obtained Master instance hostname $MASTER_HOST" 1
	MASTER_DATA_DIRECTORY=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -A -t -p $TEMP_PORT $DEFAULTDB -c "select datadir from $CONFIG_TABLE where content=-1 and dbid=1;"`
	if [ $? -ne 0 ] || [ ! $MASTER_DATA_DIRECTORY ];then STOP_BUILD=1;MASTER_DATA_DIRECTORY=FAILED;fi
	LOG_MSG "[INFO]:-Obtained Master instance data directory $MASTER_DATA_DIRECTORY" 1
	MASTER_PORT=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -A -t -p $TEMP_PORT $DEFAULTDB -c "select port from $CONFIG_TABLE where content=-1 and dbid=1;"`
	if [ $? -ne 0 ] || [ ! $MASTER_PORT ];then STOP_BUILD=1;MASTER_PORT=FAILED;fi
	LOG_MSG "[INFO]:-Obtained Master instance port $MASTER_PORT" 1
	MASTER_MPP_NAME=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -A -t -p $TEMP_PORT $DEFAULTDB -c "select gpname from $GP_ID_TABLE ;"`
	if [ $? -ne 0 ] || [ ! "$MASTER_MPP_NAME" ];then STOP_BUILD=1;MASTER_MPP_NAME=FAILED;fi
	LOG_MSG "[INFO]:-Obtained Greenplum array name $MASTER_MPP_NAME" 1
	REBUILD_ARRAY=(`env PGOPTIONS="-c gp_session_role=utility" $PSQL -A -t -p $TEMP_PORT $DEFAULTDB -c "select hostname, port, datadir, dbid, content, definedprimary from $CONFIG_TABLE where content<>-1;"`)
	if [ $? -ne 0 ] || [ ! $REBUILD_ARRAY ];then STOP_BUILD=1;fi
	MASTER_IP_ADDRESS_ALL=(`$IFCONFIG -a |$GREP "inet "|$GREP -v "127."|$AWK '{print $2}'|$CUT -d: -f2`)	
	ERROR_CHK $? "get master host IP details" 2
	MASTER_IP_ADDRESS=(`$ECHO ${MASTER_IP_ADDRESS_ALL[@]}|$TR ' ' '\n'|$SORT -u|$TR '\n' ' '`)
	MASTER_TOTAL_SEG=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -A -t -p $TEMP_PORT $DEFAULTDB -c "select numsegments from $GP_ID_TABLE;"`
	if [ $? -ne 0 ] || [ ! $MASTER_TOTAL_SEG ];then STOP_BUILD=1;fi
	STANDBY_ACTIVE=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -A -t -p $TEMP_PORT $DEFAULTDB -c "select count(*)-1 from $CONFIG_TABLE where content=-1;"`
	if [ $? -ne 0 ] || [ ! $STANDBY_ACTIVE ];then STOP_BUILD=1;STANDBY_ACTIVE=FAILED;fi
	LOG_MSG "[INFO}:-Obtained Master instance standby count $STANDBY_ACTIVE" 1
	if [ $STANDBY_ACTIVE -eq 1 ];then
	STANDBY_HOST_DETAILS=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -A -t -p $TEMP_PORT $DEFAULTDB -c"select hostname, datadir, port from $CONFIG_TABLE where content=-1 and dbid<>1 ;"`
	if [ $? -ne 0 ] || [ x"" = x"$STANDBY_HOST_DETAILS" ];then STOP_BUILD=1;STANDBY_HOST_DETAILS=FAILED;fi
	fi
	LOG_MSG "[INFO]:-Obtained standby master details $STANDBY_HOST_DETAILS" 1
	REBUILD_KEY=`$BASENAME $SQL_FILE|$AWK -F"_" '{print $NF}'`
	RECOVER_FILE_DIR=`$DIRNAME $SQL_FILE`
	CREATE_DB=`$LS ${RECOVER_FILE_DIR}/*cdatabase*${REBUILD_KEY}|$WC -l` 
	RESTORE_FILE_COUNT=`$LS ${RECOVER_FILE_DIR}/*_dump_*${REBUILD_KEY}|$WC -l|$AWK '{print $1}'`
	if [ $STOP_BUILD -eq 1 ];then 
		DELETE_TEMP_DB
		ERROR_EXIT "[FATAL]:-Failed in Function $FUNCNAME, check log for error(s)" 2
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}
CHECK_QES () {
        LOG_MSG "[INFO]:-Start Function $FUNCNAME"
        for SEG_INFO in "${REBUILD_ARRAY[@]}"
        do
                SET_VAR $SEG_INFO
                #Check hosts can be reached
                PING_HOST $SEG_HOSTNAME
                #Check that we do not already have segment directory
                CHK_DIR $SEG_DATADIR $SEG_HOSTNAME
                if [ $EXISTS -eq 0 ];then
                        ERROR_EXIT "[FATAL]:-Segment directory $SEG_DATADIR exists on $SEG_HOSTNAME" 2
                fi
        done
        LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

CHK_PARAM () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Commencing parameter checks" 1
	if [ x"" == x"$OVERRIDE_MASTER_HOSTNAME" ];then
		if [ `$HOSTNAME` != $MASTER_HOST ];then
			LOG_MSG "[WARN]:-Rebuild script not called on Master host $MASTER_HOST" 1
			STOP_BUILD=1
		fi
	else
		LOG_MSG "[INFO]:-Will override Master hostname" 1
		PREV_MASTER_HOST=$MASTER_HOST
		MASTER_HOST=`$HOSTNAME`
		if [ $STANDBY_ACTIVE -ne 0 ];then
		#Need to ensure that the new hostname is not the same as that of the standby host
			STANDBY_HOST=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -A -t -p $TEMP_PORT $DEFAULTDB -c"select hostname from $CONFIG_TABLE where content=-1 and dbid not in (select min(dbid) from $CONFIG_TABLE where content=-1);"`
			ERROR_CHK $? "obtain hostname of standby host" 2
			if [ "$MASTER_HOST" == "$STANDBY_HOST" ];then
				DELETE_TEMP_DB
				ERROR_EXIT "[FATAL]:-New master hostname and standby hostname the same" 2
			fi
		fi
		LOG_MSG "[INFO]:-Reset Master hostname from $PREV_MASTER_HOST to $MASTER_HOST" 1
	fi
	if [ -d $MASTER_DATA_DIRECTORY ]; then
		LOG_MSG "[WARN]:-Master database directory $MASTER_DATA_DIRECTORY exists" 1
		STOP_BUILD=1
	fi
	if [ $STOP_BUILD -ne 0 ];then
		DELETE_TEMP_DB
		ERROR_EXIT "[FATAL]:-One or more errors encountered, please review log and correct." 2
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

DISPLAY_PARAM () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Greenplum rebuild parameters" 1
	LOG_MSG "[INFO]:-----------------------" 1
	LOG_MSG "[INFO]:-Greenplum rebuild key                = $REBUILD_KEY" 1
	LOG_MSG "[INFO]:-Greenplum recover directory          = $RECOVER_FILE_DIR" 1
	if [ $CREATE_DB -eq 1 ] && [ $NOCREATEDB -eq 0 ];then
	LOG_MSG "[INFO]:-Greenplum create database            = Configured" 1
	else
	LOG_MSG "[INFO]:-Greenplum create database            = Not configured" 1
	fi
	LOG_MSG "[INFO]:-Greenplum restore file count         = $RESTORE_FILE_COUNT" 1
	if [ x"" != x"$MASTER_ONLY" ];then
	LOG_MSG "[INFO]:-Greenplum Master build only          = On" 1
	else
	LOG_MSG "[INFO]:-Greenplum Master build only          = Off" 1
	fi
	LOG_MSG "[INFO]:-Greenplum Master hostname            = $MASTER_HOST" 1
	if [ x"" == x"$OVERRIDE_MASTER_HOSTNAME" ];then
	LOG_MSG "[INFO]:-Greenplum Master change name         = Off" 1
	else
	LOG_MSG "[INFO]:-Greenplum Master change name         = On" 1
	LOG_MSG "[INFO]:-Greenplum previous host name         = $PREV_MASTER_HOST" 1
	fi
	LOG_MSG "[INFO]:-Greenplum Master data directory      = $MASTER_DATA_DIRECTORY" 1
	LOG_MSG "[INFO]:-Greenplum Master port                = $MASTER_PORT" 1
	LOG_MSG "[INFO]:-Greenplum array name                 = $MASTER_MPP_NAME" 1
	LOG_MSG "[INFO]:-Greenplum total primary segments     = $MASTER_TOTAL_SEG" 1
	if [ $STANDBY_ACTIVE -ne 0 ];then
		LOG_MSG "[INFO]:-Greenplum Standby Master             = Configured" 1
		if [ x"" == x"$START_GPSYNC" ];then
			LOG_MSG "[INFO]:-Greenplum start sync process         = Off" 1
		else
			LOG_MSG "[INFO]:-Greenplum start sync process         = On" 1
		fi
	else
		LOG_MSG "[INFO]:-Greenplum Standby Master             = Not Configured" 1
	fi 
		LOG_MSG "[INFO]:-Greenplum Master IP Allow            = $DEFAULT_IP_ALLOW" 1
	if [ x"" != x"$MASTER_ONLY" ];then
		LOG_MSG "[INFO]:-Segment build = OFF -m option supplied" 1
		LOG_MSG "[INFO]:---------------------------------------" 1
	else
		LOG_MSG "[INFO]:-Below segments will also be built" 1
		LOG_MSG "[INFO]:-----------------------------------" 1
	fi	
	LOG_MSG "[INFO]:-Greenplum Segment instance list" 1
	LOG_MSG "[INFO]:--------------------------" 1
	if [ x"" != x"$MASTER_ONLY" ];then
		LOG_MSG "[INFO]:-NOTE:-List supplied for information only" 1
		LOG_MSG "[INFO]:-----------------------------------------" 1
	fi
	for I in "${REBUILD_ARRAY[@]}"
	do
		SET_VAR $I
		if [ "$SEG_DEFINED" == "t" ]; then
			SEG_DEFINED="Primary"
		else
			SEG_DEFINED="Mirror"
		fi
		LOG_MSG "[INFO]:-$SEG_HOSTNAME $SEG_DATADIR $SEG_PORT $SEG_DEFINED" 1
	done
	if [ $INTERACTIVE ]; then
		$ECHO  "Continue with Greenplum Database system rebuild Yy/Nn>"
		read REPLY
		if [ -z $REPLY ]; then
			LOG_MSG "[WARN]:-User abort requested, Script Exits!" 1
			EXIT_STATUS=1
			DELETE_TEMP_DB
			exit $EXIT_STATUS
		fi
		if [ $REPLY != Y ] && [ $REPLY != y ]; then
			LOG_MSG "[WARN]:-User abort requested, Script Exits!" 1
			EXIT_STATUS=1
			DELETE_TEMP_DB
			exit $EXIT_STATUS
		fi
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

BUILD_MPP_MASTER () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Commencing rebuild of Greenplum Database instance" 1
	LOG_MSG "[INFO]:-Creating Master database" 1
	RUN_COMMAND "$INITDB -E $ENCODING --locale=$LOCALE_SETTING  -D $MASTER_DATA_DIRECTORY"
	BACKOUT_COMMAND "$RM -Rf $MASTER_DATA_DIRECTORY"
	BACKOUT_COMMAND "$ECHO \"Removing Master instance directory\""
	LOG_MSG "[INFO]:-Setting the Master port to $MASTER_PORT" 1
	ED_FILE ${MASTER_DATA_DIRECTORY}/$PG_CONF "#port" port=$MASTER_PORT 0
	ERROR_CHK $? "setting master port in $PG_CONF to $MASTER_PORT" 2
	LOG_MSG "[INFO]:-Configuring Master $PG_HBA" 1
###	for MASTER_IP in "${MASTER_IP_ADDRESS[@]}"
###	do
###		IP_ALLOW="`$ECHO $MASTER_IP|$CUT -d. -f1-3`.0/24"
###		LOG_MSG "[INFO]:-Adding $IP_ALLOW to $PG_HBA file"
###		$ECHO "host    all         all         $IP_ALLOW        trust" >> ${MASTER_DATA_DIRECTORY}/$PG_HBA
###	done
	BUILD_MASTER_PG_HBA_FILE ${MASTER_DATA_DIRECTORY}
	LOG_MSG "[INFO]:-Starting the Master database" 1
	export PGPORT=$MASTER_PORT;$PG_CTL -w -D $MASTER_DATA_DIRECTORY -l ${MASTER_DATA_DIRECTORY}.log -o "-i -p $MASTER_PORT" start 2>> $LOG_FILE
	if [ $? -ne 0 ]; then
		$CAT ${MASTER_DATA_DIRECTORY}.log|$TEE -a $LOG_FILE
		ERROR_EXIT "[FATAL]:-Failed to start the Master database" 2
	fi
	BACKOUT_COMMAND "$RM -f /tmp/.s.PGSQL.${MASTER_PORT}*"
	BACKOUT_COMMAND "$ECHO Removing Master lock files"
	BACKOUT_COMMAND "export PGPORT=$MASTER_PORT;$PG_CTL -D $MASTER_DATA_DIRECTORY stop"
	BACKOUT_COMMAND "$ECHO Commencing shutdown of Master instance"
	LOG_MSG "[INFO]:-Loading Greenplum metadata" 1
	env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $MASTER_PORT $DEFAULTDB -f $SQL_FILE
	ERROR_CHK $? "loading mpp catalog data into $DEFAULTDB on master instance" 2
	LOG_MSG "[INFO]:-Deleting temporary database" 1
	DELETE_TEMP_DB
	if [ x"" != x"$OVERRIDE_MASTER_HOSTNAME" ];then
		LOG_MSG "[INFO]:-Changing master hostname to $MASTER_HOST in gp_configuration table" 1
		#Check to see if we have a hostname in $CONFIG_TABLE with the new hostname
		HOSTNAME_COUNT=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $MASTER_PORT $DEFAULTDB -A -t -c"select count(*) from $CONFIG_TABLE where hostname='${MASTER_HOST}' and content=-1 and definedprimary='t';"`
		ERROR_CHK $? "obtain hostname count for ${MASTER_HOST}" 2
		if [ $HOSTNAME_COUNT -eq 0 ];then
			#We don't have this hostname so update the master hostname that has been loaded
			LOG_MSG "[INFO]:-This is a new Master hostname, updating gp_configuration catalog" 1
			env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $MASTER_PORT $DEFAULTDB -A -t -c"update $CONFIG_TABLE set hostname='${MASTER_HOST}' where content=-1 and definedprimary='t';"
			ERROR_CHK $? "update $CONFIG_TABLE for ${MASTER_HOST}" 2
		fi	
	fi
	if [ x"" == x"$MASTER_ONLY" ];then
		LOG_MSG "[INFO]:-Commencing shutdown of Master database" 1
		export PGPORT=$MASTER_PORT;$PG_CTL -w -D $MASTER_DATA_DIRECTORY -l ${MASTER_DATA_DIRECTORY}.log -o "-i -p $MASTER_PORT" stop 2>> $LOG_FILE 
		ERROR_CHK $? "shutdown of master instance $MASTER_DATA_DIRECTORY port = $MASTER_PORT" 2
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

SET_VAR () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	SEG_HOSTNAME=`$ECHO $1|$CUT -d"|" -f1`
	SEG_PORT=`$ECHO $1|$CUT -d"|" -f2`
	SEG_DATADIR=`$ECHO $1|$CUT -d"|" -f3`
	SEG_DBID=`$ECHO $1|$CUT -d"|" -f4`
	SEG_CONTENT=`$ECHO $1|$CUT -d"|" -f5`
	SEG_DEFINED=`$ECHO $1|$CUT -d"|" -f6`
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

BUILD_SEGMENT_INSTANCES () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Creating segment instance databases" 1
	for SEG_INFO in "${REBUILD_ARRAY[@]}"
	do
		SET_VAR $SEG_INFO
		LOG_MSG "[INFO]:-Processing segment host $SEG_HOSTNAME port $SEG_PORT data directory $SEG_DATADIR" 1
		RUN_COMMAND_REMOTE ${SEG_HOSTNAME} "${EXPORT_LIB_PATH};$INITDB -E $ENCODING --locale=$LOCALE_SETTING -D $SEG_DATADIR"
		BACKOUT_COMMAND "$TRUSTED_SHELL ${SEG_HOSTNAME} \"$RM -rf $SEG_DATADIR\""
		BACKOUT_COMMAND "$ECHO \"removing directory $SEG_DATADIR on $SEG_HOSTNAME\""
		LOG_MSG "[INFO]:-Configuring segment $PG_CONF" 1
		ED_FILE ${SEG_DATADIR}/$PG_CONF "#port" port=$SEG_PORT 0 $SEG_HOSTNAME
		ED_FILE ${SEG_DATADIR}/$PG_CONF listen_addresses listen_addresses=\'*\' 0  $SEG_HOSTNAME
		ED_FILE ${SEG_DATADIR}/$PG_CONF checkpoint_segments checkpoint_segments=$CHECK_POINT_SEGMENTS 0 $SEG_HOSTNAME
		LOG_MSG "[INFO]:-Configuring segment $PG_HBA" 1
		for MASTER_IP in "${MASTER_IP_ADDRESS[@]}"		
		do
			RUN_COMMAND_REMOTE ${SEG_HOSTNAME} "$ECHO host  all     all     ${MASTER_IP}/32 trust >> ${SEG_DATADIR}/$PG_HBA"
		done
		LOG_MSG "[INFO]:-Starting instance on segment ${SEG_HOSTNAME}" 1
		$TRUSTED_SHELL ${SEG_HOSTNAME} "${EXPORT_LIB_PATH};export PGPORT=${SEG_PORT}; $PG_CTL -w -D $SEG_DATADIR -l ${SEG_DATADIR}.log -o \"-i -p ${SEG_PORT}\" start" >> $LOG_FILE 2>&1
		if [ $? -ne 0 ]; then
			BACKOUT_COMMAND "$TRUSTED_SHELL $SEG_HOSTNAME \"$RM -f ${SEG_DATADIR}.log\""
			BACKOUT_COMMAND "$ECHO \"Removing segment log file ${SEG_DATADIR}.log on segment $SEG_HOSTNAME\""
			BACKOUT_COMMAND "$TRUSTED_SHELL $SEG_HOSTNAME \"$RM -Rf ${SEG_DATADIR}\""
			BACKOUT_COMMAND "$ECHO \"Removing segment data directory $SEG_DATADIR\""
			$TRUSTED_SHELL ${SEG_HOSTNAME} "$CAT ${SEG_DATADIR}.log "|$TEE -a $LOG_FILE
			ERROR_EXIT "[FATAL]:-Failed to start segment instance database" 2
		fi
		BACKOUT_COMMAND "$TRUSTED_SHELL $SEG_HOSTNAME \"$RM -f ${SEG_DATADIR}.log\""
		BACKOUT_COMMAND "$ECHO \"Removing segment log file ${SEG_DATADIR}.log on segment $SEG_HOSTNAME\""
		BACKOUT_COMMAND "$TRUSTED_SHELL $SEG_HOSTNAME \"$RM -Rf ${SEG_DATADIR}\""
		BACKOUT_COMMAND "$ECHO \"Removing segment data directory $SEG_DATADIR\""
		BACKOUT_COMMAND "$TRUSTED_SHELL $SEG_HOSTNAME \"${EXPORT_LIB_PATH};export PGPORT=${SEG_PORT}; $PG_CTL -w -D $SEG_DATADIR -l ${SEG_DATADIR}.log -o \"-i -p ${SEG_PORT}\" -m immediate  stop\""
		BACKOUT_COMMAND "$ECHO \"Stopping segment instance\""
		LOG_MSG "[INFO]:-Successfully started segment instance on $SEG_HOSTNAME" 1
		LOG_MSG "[INFO]:-Updating segment gp_id system table" 1
		RUN_COMMAND_REMOTE $SEG_HOSTNAME "${EXPORT_LIB_PATH};env PGOPTIONS=\"-c gp_session_role=utility\" $PSQL -p $SEG_PORT $DEFAULTDB -c \"insert into $GP_ID_TABLE values ('${MASTER_MPP_NAME}',${MASTER_TOTAL_SEG},${SEG_DBID},${SEG_CONTENT});\"" 
		LOG_MSG "[INFO]:-Successfully updated $SEG_HOSTNAME gp_id system table" 1
		LOG_MSG "[INFO]:-Commencing shutdown of segment instance on $SEG_HOSTNAME" 1
		$TRUSTED_SHELL ${SEG_HOSTNAME} "${EXPORT_LIB_PATH};export PGPORT=${SEG_PORT}; $PG_CTL -w -D $SEG_DATADIR -l ${SEG_DATADIR}.log -o \"-i -p ${SEG_PORT}\" stop" 
		ERROR_CHK $? "shutdown of instance on port $SEG_PORT data directory $SEG_DATADIR host $SEG_HOSTNAME" 2
	done	
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

DELETE_TEMP_DB () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Stopping temporary database" 1
	export PGPORT=$TEMP_PORT;$PG_CTL -w -D ${TEMP_DATA_DIRECTORY}/parsetemp -l ${TEMP_DATA_DIRECTORY}/parsetemp.log -o "-i -p $TEMP_PORT" stop 
	ERROR_CHK $? "shutdown of temporary database on port $TEMP_PORT data directory $TEMP_DATA_DIRECTORY" 1
	LOG_MSG "[INFO]:-Removing temporary database directory" 1
	$RM -Rf ${TEMP_DATA_DIRECTORY}/parsetemp
	LOG_MSG "[INFO]:-Deleting temporary database log file" 1
	$RM -Rf ${TEMP_DATA_DIRECTORY}/parsetemp.log
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

CREATE_DATABASE () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Obtaining database create file name" 1
	CREATE_DB_FILE=`$LS ${RECOVER_FILE_DIR}/*cdatabase*${REBUILD_KEY}` 
	if [ $? -ne 0 ];then
		LOG_MSG "[WARN]:-Issue with obtain create database filename" 1
	else
		LOG_MSG "[INFO]:-Obtained create database file name as $CREATE_DB_FILE, processing" 1
		$PSQL -p $MASTER_PORT $DEFAULTDB -f $CREATE_DB_FILE
		ERROR_CHK $? "load of create database file $CREATE_DB_FILE" 1
	fi	
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

STANDBY_ACTIVATE () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	STANDBY_HOSTNAME=`$ECHO $STANDBY_HOST_DETAILS|$CUT -d"|" -f1`
	STANDBY_DIR=`$ECHO $STANDBY_HOST_DETAILS|$CUT -d"|" -f2`
	STANDBY_PORT=`$ECHO $STANDBY_HOST_DETAILS|$CUT -d"|" -f3`
	LOG_MSG "[INFO]:-Issuing sync on disk sub-system $MASTER_DATA_DIRECTORY" 1
	C_DIR=`pwd`;cd ${MASTER_DATA_DIRECTORY};sync;cd $C_DIR	
	$TRUSTED_COPY -pr $MASTER_DATA_DIRECTORY ${STANDBY_HOSTNAME}:${STANDBY_DIR} 2>>$LOG_FILE
	ERROR_CHK $? "remote copy of $MASTER_DATA_DIRECTORY to $STANDBY_HOSTNAME" 2
	BACKOUT_COMMAND "$TRUSTED_SHELL $STANDBY_HOSTNAME \"$RM -Rf ${STANDBY_DIR}.log\""
	BACKOUT_COMMAND "$ECHO \"Removing standby data directory log file\""
	BACKOUT_COMMAND "$TRUSTED_SHELL $STANDBY_HOSTNAME \"$RM -Rf ${STANDBY_DIR}\""
	BACKOUT_COMMAND "$ECHO \"Removing standby data directory ${STANDBY_DIR}\""
	if [ x"" != x"$START_GPSYNC" ];then
		LOG_MSG "[INFO]:-Starting gpsyncmaster on standby host ${STANDBY_HOSTNAME}" 1
		$TRUSTED_SHELL ${STANDBY_HOSTNAME} "${EXPORT_LIB_PATH};$GPSYNCMASTER -D ${STANDBY_DIR} -p $STANDBY_PORT -S"
		ERROR_CHK $? "initialize gpsyncmaster on ${STANDBY_HOSTNAME}" 1
		BACKOUT_COMMAND "$TRUSTED_SHELL $STANDBY_HOSTNAME \"${EXPORT_LIB_PATH};$PG_CTL stop -D ${STANDBY_DIR} -m immediate\""
		BACKOUT_COMMAND "$ECHO \"Stopping sync process on $STANDBY_HOSTNAME\""
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
} 

UPDATE_BACKOUT_FILE () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	$ECHO "$RM -f $BACKOUT_FILE" >> $BACKOUT_FILE
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

START_ARRAY () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	CHK_FILE $GPSTART
	if [ $EXISTS -ne 0 ];then
		ERROR_EXIT "[FATAL]:-Could not locate $GPSTART to start MPP instance" 2
	else
		LOG_MSG "[INFO]:-Starting the Greenplum Database instance" 1
		$GPSTART -d $MASTER_DATA_DIRECTORY -a
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

DISPLAY_INFO () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	if [ x"" = x"$MASTER_ONLY" ];then
		LOG_MSG "[INFO]:-------------------------------------------------" 1
		LOG_MSG "[INFO]:-The Greenplum Database instance has been successfully rebuilt" 1
		LOG_MSG "[INFO]:-Status information reports it is now operational" 1
	else
		LOG_MSG "[INFO]:-------------------------------------------------" 1
		LOG_MSG "[INFO]:-The Greenplum master instance has been rebuilt" 1
		LOG_MSG "[INFO]:-Use gprebuildseg to continue the rebuild process" 1
		LOG_MSG "[INFO]:-To shutdown the master use gpstop -m" 1
		LOG_MSG "[INFO]:-To start the master use gpstart -m" 1
		LOG_MSG "[INFO]:-To access the instance set PGOPTIONS for utility mode" 1
	fi
	LOG_MSG "[INFO]:-Rebuild details" 1
	LOG_MSG "[INFO]:-Master database host       = $MASTER_HOST" 1
	LOG_MSG "[INFO]:-Master data directory      = $MASTER_DATA_DIRECTORY" 1
	LOG_MSG "[INFO]:-Master database port       = $MASTER_PORT" 1
	LOG_MSG "[INFO]:-To remove this Greenplum instance run gpdeletesystem.sh" 1
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

#******************************************************************************
# Main Section
#******************************************************************************
trap 'DELETE_TEMP_DB;ERROR_EXIT "[FATAL]:-Recieved INT or TERM signal" 2' INT TERM
if [ $# -ne 0 ]; then
	while getopts ":vt'?'axp:qi:on:mc:s:l:d:D!" opt;do
		case $opt in
			v ) VERSION_INFO ;;
			'?' ) USAGE ;;
			! ) SCRIPT_USAGE=1
			    USAGE ;;
			d ) TEMP_DATA_DIRECTORY=$OPTARG ;;
			a ) unset INTERACTIVE ;;
			x ) NOCREATEDB=1 ;;
			q ) unset VERBOSE ;;
			l ) LOG_DIR=$OPTARG ;;
			s ) SQL_FILE=$OPTARG ;;
			c ) CHECK_POINT_SEGMENTS=$OPTARG ;;
			i ) DEFAULT_IP_ALLOW=$OPTARG ;;
			p ) TEMP_PORT=$OPTARG ;;
##			i ) unset START_GPSYNC ;;
			m ) MASTER_ONLY=1 
			    NOCREATEDB=1 ;;
			n ) LOCALE_SETTING=$OPTARG ;;
			o ) OVERRIDE_MASTER_HOSTNAME=1 ;;
			D ) DEBUG_LEVEL=1 ;;
			* ) USAGE ;;
		esac
	done	
fi
if [ x"" != x"$LOG_DIR" ];then
	CHK_DIR $LOG_DIR
	if [ $EXISTS -eq 1 ]; then
		LOG_MSG "[WARN]:-Log directory $LOG_DIR does not exist, using default log directory" 1
		EXIT_STATUS=1
		BACKOUT_FILE=$DEFLOGDIR/backout_${PROG_NAME}_${USER_NAME}_${CUR_DATE}_$TIME
	else
		LOG_FILE=$LOG_DIR/${PROG_NAME}_${CUR_DATE}.log
		BACKOUT_FILE=$LOG_DIR/backout_${PROG_NAME}_${USER_NAME}_${CUR_DATE}_$TIME
	fi
else
	BACKOUT_FILE=$DEFLOGDIR/backout_${PROG_NAME}_${USER_NAME}_${CUR_DATE}_$TIME
fi
LOG_MSG "[INFO]:-Start Main"
LOG_MSG "[INFO]:-Command line options passed to utility = $*"
if [ x"" = x"$SQL_FILE" ] || [ x"" = x"$TEMP_DATA_DIRECTORY" ]; then
	ERROR_EXIT "[FATAL]:-Must supply file name of sql file and temporary database directory" 2
fi
if [ x"" == x"$LOCALE_SETTING" ];then
	LOCALE_SETTING=$DEFAULT_LOCALE_SETTING
	LOG_MSG "[INFO]:-Set locale to default value $LOCALE_SETTING" 1
fi
CHK_FILE $SQL_FILE
if [ $EXISTS -ne 0 ]; then
	ERROR_EXIT "[FATAL]:-Issue with sql source file $SQL_FILE, check file and retry" 2
fi
CHK_DIR $TEMP_DATA_DIRECTORY
if [ $EXISTS -ne 0 ]; then
	ERROR_EXIT "[FATAL]:-Issue with temporary database directory $TEMP_DATA_DIRECTORY" 2
fi
CREATE_TEMP_DB
PARSE_SQL_FILE
CHK_PARAM
CHECK_QES
DISPLAY_PARAM
BUILD_MPP_MASTER
if [ x"" == x"$MASTER_ONLY" ];then
	BUILD_SEGMENT_INSTANCES
	if [ $STANDBY_ACTIVE -ne 0 ];then
		STANDBY_ACTIVATE
	fi
	UPDATE_BACKOUT_FILE
	START_ARRAY
	if [ $CREATE_DB -eq 1 ] && [ $NOCREATEDB -eq 0 ];then
		CREATE_DATABASE
	fi
else
	UPDATE_BACKOUT_FILE
fi
DISPLAY_INFO
LOG_MSG "[INFO]:-End Main"
$RM -f $BACKOUT_FILE
exit $EXIT_STATUS
