#                               Copyright (c) Metapa 2005. All Rights Reserved.
#                               Copyright (c) Greenplum 2005. All Rights Reserved
#	Brief descn:-		Rebuilds a MPP instance from a SQL dump file.
#******************************************************************************
# Update History
#******************************************************************************
# Ver	Date		Who		Update
#******************************************************************************
# Detailed Description
#******************************************************************************
#
#******************************************************************************
# Prep Code
# Source required functions file, this required for script to run
# exit if cannot locate this file. Change location of FUNCTIONS variable
# as required.
WORKDIR=`dirname $0`
FUNCTIONS=$WORKDIR/lib/gp_bash_functions.sh
if [ -f $FUNCTIONS ]; then
		. $FUNCTIONS
else
		echo "[FATAL:]-Cannot source $FUNCTIONS file Script Exits!"
		exit 2
fi
#******************************************************************************
# Location Variables
#******************************************************************************

#******************************************************************************
# Command Variables
#******************************************************************************

#******************************************************************************
# Script Specific Variables
#******************************************************************************
INTERACTIVE=1
STOP_BUILD=0
VERBOSE=1
WAIT="-w"
MODE=smart
TIME=`$DATE +%H%M%S`
CUR_DATE=`$DATE +%Y%m%d`
PROG_NAME=`$BASENAME $0`
HELP_DOC_NAME=`$ECHO $PROG_NAME|$AWK -F'.' '{print $1}'`_help
QD_NAME=`hostname`
EXIT_STATUS=0
TEMP_PORT=55555
ENCODING=UNICODE
CHECK_POINT_SEGMENTS=8
START_GPSYNC=1
NOCREATEDB=0
TMP_PG_HBA=/tmp/pg_hba_conf_master.$$
CHANGE_SEG_DETAILS=0
GP_INIT_FILE=/tmp/gp_init_rebuild.$$
GP_HOST_FILE=/tmp/gp_host_rebuild.$$
GP_MIR_FILE=/tmp/gp_mir_file.$$
MIRROR_TYPE=0
#******************************************************************************
# Functions
#******************************************************************************
#
USAGE () {
	if [ -f ${GPDOCDIR}/$HELP_DOC_NAME ] && [ x"" == x"$SCRIPT_USAGE" ];then
		$LESSCMD ${GPDOCDIR}/$HELP_DOC_NAME
	exit 0
	else
		$ECHO	
		$ECHO "      `basename $0 `"
		$ECHO
		$ECHO "      Re-constructs a Greenplum instance from a secured catalogue SQL file."
		$ECHO "      Will build a Master database and a warm Master standby (If configured)"
		$ECHO "      as well as all segment instances detailed in the catalog file"
		$ECHO "      Upon completion, the instance will be operational"
		$ECHO "      and ready for a user data restore, via use of gpdbrestore utility."
		$ECHO "      This utility creates a temporary parsing database into which the"
		$ECHO "      database catalog file is loaded, this information is then processed"
		$ECHO "      and a new set of configuration files are built, which are then passed"
		$ECHO "      to the gpinitsystem utility, which will rebuild the array"
		$ECHO
		$ECHO "      Usage:"
		$ECHO "      $0 [OPTIONS]"
		$ECHO
		$ECHO "      General options:"
		$ECHO "      -?, display this help message & exit" 
		$ECHO "      -v, display version information & exit"
		$ECHO
		$ECHO "      Logging options:"
		$ECHO "      -q, quiet mode, do not log progress to screen [default:- verbose output to screen]"
		$ECHO "      -l, <logfile directory> alternative logfile directory [optional]"
		$ECHO "      -a, don't ask to confirm re-build [default:- ask]"
		$ECHO "      -D, set log output to debug level, shows all function calls"
		$ECHO
		$ECHO "      Rebuild options:"
		$ECHO "      -f, </<directory>/<sql catalog dump file name> [mandatory]"
		$ECHO "          example file name gp_catalog_1_1_20060512103500"
		$ECHO "      -d, <temporary data directory name> directory where a temporary database can be created"
		$ECHO "          to allow parsing of <sql source file name> [mandatory]"
		$ECHO "          Directory name supplied must exist."
		$ECHO "      -c, change the segment instance meta data information, if this option supplied, utility"
		$ECHO "          will enter interactive mode to allow changes to be made to the array configuration"
		$ECHO "          meta data"
		$ECHO "      -s, if mirroring enabled within catalog dump file, configure rebuild for Spread mirroring"
		$ECHO "          [default:- Group]"
		$ECHO "      -x, do not create database if *cdatabase* file exists in same directory as the"
		$ECHO "          <sql catalog dump file name> [default create database if file exists]"
		$ECHO "      -p, set temporary database port number [default $TEMP_PORT]"
		$ECHO "      -C, <#> alternative number of check point segments [default $CHECK_POINT_SEGMENTS]"
		$ECHO
		$ECHO "      Return codes:"
		$ECHO "      0 No problems encountered with requested operation"
		$ECHO "      1 Warning generated, but master database operational"
		$ECHO "      2 Fatal error, array not rebuilt, or in an inconsistent state"
		$ECHO
		exit $EXIT_STATUS
	fi
}

UNKNOWN_OPTION () {
		$ECHO
		$ECHO "[ERROR]:-Unknown option $1"
		USAGE
}

VALIDATE_PARAM () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	if [ x"" = x"$SQL_FILE" ] || [ x"" = x"$TEMP_DATA_DIRECTORY" ]; then
		ERROR_EXIT "[FATAL]:-Must supply file name of sql file and temporary database directory" 2
	fi
	if [ x"" == x"$LOCALE_SETTING" ];then
		LOCALE_SETTING=$DEFAULT_LOCALE_SETTING
		LOG_MSG "[INFO]:-Set locale to default value $LOCALE_SETTING" 1
	fi
	CHK_FILE $SQL_FILE
	if [ $EXISTS -ne 0 ]; then
		ERROR_EXIT "[FATAL]:-Issue with catalog dump file $SQL_FILE, check file and retry" 2
	fi
	FILE_NAME=`$ECHO $SQL_FILE|$AWK -F"/" '{print $NF}'`
	if [ `$ECHO $FILE_NAME|$GREP -c "catalog"` -eq 0 ];then
		ERROR_EXIT "[FATAL]:-File $FILE_NAME, does not appear to be a database dump catalog file" 2
	fi
	REBUILD_KEY=`$ECHO $FILENAME|$AWK -F"_" '{print $NF}'`
	CHK_DIR $TEMP_DATA_DIRECTORY
	if [ $EXISTS -ne 0 ]; then
		ERROR_EXIT "[FATAL]:-Issue with temporary database directory $TEMP_DATA_DIRECTORY" 2
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

CREATE_TEMP_DB () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Creating temporary parsing database, please wait..." 1
	MASTER_IP_ADDRESS=(`$IFCONFIG -a |$GREP "inet "|$GREP -v "127."|$AWK '{print $2}'|$CUT -d: -f2`)	
	RUN_COMMAND "$INITDB -E $ENCODING --locale=$LOCALE_SETTING -D ${TEMP_DATA_DIRECTORY}/parsetemp" >/dev/null 2>&1
	LOG_MSG "[INFO]:-Successfully initialized temporary parsing database" 1
	LOG_MSG "[INFO]:-Setting temporary port number to $TEMP_PORT" 1
	ED_FILE ${TEMP_DATA_DIRECTORY}/parsetemp/$PG_CONF "#port" port=$TEMP_PORT 0
	ERROR_CHK $? "set temporary instance port = $TEMP_PORT" 2
	LOG_MSG "[INFO]:-Configuring Master $PG_HBA" 1
	BUILD_MASTER_PG_HBA_FILE $TEMP_DATA_DIRECTORY/parsetemp $DEFAULT_IP_ALLOW
	LOG_MSG "[INFO]:-Starting temporary database" 1
	export PGPORT=$TEMP_PORT;$PG_CTL -w -D ${TEMP_DATA_DIRECTORY}/parsetemp -o "-i -p $TEMP_PORT" start  >/dev/null 2>&1
	RETVAL=$?
	if [ $RETVAL -ne 0 ];then
		$RM -Rf ${TEMP_DATA_DIRECTORY}/parsetemp
		ERROR_EXIT "[FATAL]:-Failed to start temporary parsing database" 2
	fi
	LOG_MSG "[INFO]:-Loading Greenplum Database metadata" 1
	DUMP_DIR=`$DIRNAME $SQL_FILE`
	env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -f $SQL_FILE >/dev/null 2>&1
	RETVAL=$?
	if [ $RETVAL -ne 0 ];then
		DELETE_TEMP_DB
		ERROR_EXIT "[FATAL]:-Failed to load Greenplum Database metadata" 2
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

DISPLAY_WARNING () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	SEP="      "
	$ECHO "${SEP}-----------------------------------------------------------------"
	$ECHO "${SEP}                          -------"
	$ECHO "${SEP}                    ****  WARNING ****"
	$ECHO "${SEP}                          -------"
	$ECHO "${SEP}-----------------------------------------------------------------"
	$ECHO "${SEP}Invalid changes to the GPDB array metadata can have"
	$ECHO "${SEP}unpredictable results if incorrect changes are made."
	$ECHO "${SEP}If unsure about this procedure, please contact Greenplum"
	$ECHO "${SEP}Support for assistance."
	$ECHO "${SEP}If making changes, please ensure the following..."
	$ECHO "${SEP}1. Hostnames are valid and can be reached on the network"
	$ECHO "${SEP}2. Port numbers are correct and are the minimum number to support"
	$ECHO "${SEP}   the revised array"
	$ECHO "${SEP}3. Data directories are correct and there are the correct number"
	$ECHO "${SEP}   per host"
	$ECHO "${SEP}If changes are made, ensure the following are correct in the"
	$ECHO "${SEP}\"Greenplum Database rebuild parameters\" display section"
	$ECHO "${SEP}before continuing with the array rebuild process."
	$ECHO "${SEP}1. Mirror array type has not changed, unless as expected" 
	$ECHO "${SEP}2. Mirror type has not changed, unless as expected"
	$ECHO "${SEP}3. Total number of data directories is the same as original"
	$ECHO "${SEP}If the array configuration is incorrect, the rebuild process"
	$ECHO "${SEP}may well complete without error, but, a restore of dump files"
	$ECHO "${SEP}via use of gpdbrestore could fail."
	$ECHO "${SEP} If in doubt, (q)uit from meta data update procedure"
	$ECHO "${SEP}---------------------------------------------------------------"
	$ECHO "${SEP}Press any key to continue     >"
	read $WARN
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}
UPDATE_SEG_DETAILS () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	DISPLAY_WARNING
	REPLY="L"
	while [ $REPLY != "q" ]
	do
		env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -F'	' -A -c"select dbid, hostname, datadir, port, definedprimary from $CONFIG_TABLE order by dbid;"
		$ECHO "Enter DBID# to change or q to exit >"
		read REPLY
		if [ x"" == x"$REPLY" ]|| [ $REPLY == "q" ];then break;fi
		$ECHO "Enter p(port), h(hostname) d(datadir) to change or q to exit    >"
		read NEW_DATA
		if [ x"" == x"$NEW_DATA" ]|| [ $NEW_DATA == "q" ];then break;fi
		case $NEW_DATA in 
		h)
		$ECHO "Enter new hostname     >"
		read NEW_DATA
		if [ x"" != x"$NEW_DATA" ]|| [ $NEW_DATA != "q" ];then
		env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -A -t -c"update $CONFIG_TABLE set hostname='${NEW_DATA}' where dbid=${REPLY};" 
		fi ;;
		p)
		$ECHO "Enter new port #       >"
		read NEW_DATA
		if [ x"" != x"$NEW_DATA" ]|| [ $NEW_DATA != "q" ];then
		env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -A -t -c"update $CONFIG_TABLE set port=${NEW_DATA} where dbid=${REPLY};"
		fi ;;
		d )
		$ECHO "Enter new datadir      >"
		read NEW_DATA
		if [ x"" != x"$NEW_DATA" ]|| [ $NEW_DATA != "q" ];then
		env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -A -t -c"update $CONFIG_TABLE set datadir='${NEW_DATA}' where dbid=${REPLY};"
		fi ;;
		*) break ;;
		esac
	done
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

PARSE_SQL_FILE () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Processing $SQL_FILE to obtain re-build parameters"
	ARRAY_NAME=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -A -t -c"select gpname from $GP_ID_TABLE;"`
	LOG_MSG "[INFO]:-Obtained Array Name $ARRAY_NAME"
	SEG_PREFIX=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -A -t -c"select datadir from $CONFIG_TABLE where dbid=1 and content=-1;"|$AWK -F"/" '{print $NF}'|$SED -e s/-1//g`
	LOG_MSG "[INFO]:-Obtained Segment Prefix $SEG_PREFIX"
	PORT_BASE=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -A -t -c"select min(port)-1 from $CONFIG_TABLE where definedprimary='t' and content<>-1;"`
	LOG_MSG "[INFO]:-Obtained Primary port base $PORT_BASE"
	PRIMARY_HOST_ARRAY=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -A -t -c"select distinct(hostname) from $CONFIG_TABLE where content<>-1 and definedprimary='t' order by hostname;"|tr '\n' ' '`
	LOG_MSG "[INFO]:-Obtained Primary hostname list ${PRIMARY_HOST_ARRAY[@]}" 
	SEG_PER_HOST=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -A -t -c"select count(distinct port) from $CONFIG_TABLE where content<>-1 and definedprimary='t';"`
	LOG_MSG "[INFO]:-Obtained number of segments per host as $SEG_PER_HOST"
	DATA_DIRECTORY=(`env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -A -t -c"select datadir from $CONFIG_TABLE where content<>-1 and definedprimary='t';"|$SED -e s/\\\/${SEG_PREFIX}[0-9][0-9]*//g|$SORT -u|$TR '\n' ' '`)
	MASTER_HOSTNAME=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -A -t -c"select hostname from $CONFIG_TABLE where content=-1 and dbid=1;"`
	LOG_MSG "[INFO]:-Obtained Master hostname $MASTER_HOSTNAME"
	MASTER_DIRECTORY=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -A -t -c"select datadir from $CONFIG_TABLE where content=-1 and dbid=1;"|$SED -e s/\\\/${SEG_PREFIX}-1//g`
	LOG_MSG "[INFO]:-Obtained Master datadir $MASTER_DIRECTORY"
	MASTER_PORT=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -A -t -c"select port from $CONFIG_TABLE where content=-1 and dbid=1;"`
	LOG_MSG "[INFO]:-Obtained Master port $MASTER_PORT"
	ENCODING=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -A -t -c"show server_encoding;"`
	LOG_MSG "[INFO]:-Obtained Server encoding $ENCODING"
	MASTER_MAX_CONNECT=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -A -t -c"show max_connections;"`
	LOG_MSG "[INFO]:-Obtained Max connections $MASTER_MAX_CONNECT"	
	#Check to see if we have mirrors configured
	MIR_NUM=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -A -t -c"select count(*) from $CONFIG_TABLE where definedprimary='f' and content<>-1;"`
	SEP_HOSTS=0
	if [ $MIR_NUM -ne 0 ];then
		#Have mirrors configured
		#DDD MIRROR_HOST_ARRAY=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -A -t -c"select hostname from $CONFIG_TABLE where content<>-1 and definedprimary='f';"|$TR '\n' ' '`
		MIRROR_HOST_ARRAY=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -A -t -c"select distinct(hostname) from $CONFIG_TABLE where content<>-1 and definedprimary='f' order by hostname;"|$TR '\n' ' '`
		LOG_MSG "[INFO]:-Obtained Mirror host list ${MIRROR_HOST_ARRAY[@]}"
		MIRROR_DATA_DIRECTORY=(`env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -A -t -c"select datadir from $CONFIG_TABLE where content<>-1 and definedprimary='f';"|$SED -e s/\\\/${SEG_PREFIX}[0-9][0-9]*//g|$SORT -u|$TR '\n' ' '`)
		#Get the mirror port base	
		MIRROR_PORT_BASE=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -A -t -c"select min(port)-1 from $CONFIG_TABLE where definedprimary='f' and content<>-1;"`
		LOG_MSG "[INFO]:-Obtained Mirror port base $MIRROR_PORT_BASE"
		#See if we have mirroring on separate hosts
		#Check to see if we have a primary hostname which appears in the mirror array
		MATCH=0
		for I in ${PRIMARY_HOST_ARRAY[@]}
		do
			if [ `$ECHO ${MIRROR_HOST_ARRAY[@]}|$TR ' ' '\n'|$GREP -c $I` -ne 0 ];then
				((MATCH=$MATCH+1))
			fi
		done
		 ##SEP_COUNT=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -A -t -c"select count(distinct hostname)/(select count(distinct hostname) from $CONFIG_TABLE where definedprimary='t' and content<>-1) from $CONFIG_TABLE where content<>-1;"`
		if [ $MATCH -eq `$ECHO ${PRIMARY_HOST_ARRAY[@]}|$TR ' ' '\n'|$WC -l` ];then
			LOG_MSG "[INFO]:-Mirror type is shared array"
			TYPE_TXT="Shared array"
			SEP_HOSTS=0
		else
			LOG_MSG "[INFO]:-Mirror type is separate array"
			TYPE_TXT="Separate array"
			SEP_HOSTS=1
		fi
	fi
	LOCALE_SETTING=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -A -t -c"show lc_ctype;"`
	LOG_MSG "[INFO]:-Obtained Locale type $LOCALE_SETTING"
	#Check for a warm master standby server
	STANDBY_HOSTNAME=`env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $TEMP_PORT -d $DEFAULTDB -A -t -c"select hostname from $CONFIG_TABLE where content=-1 and definedprimary='f';"`
	if [ $NOCREATEDB -eq 0 ];then
		if [ -f ${DUMP_DIR}/gp_cdatabase*$REBUILD_KEY ];then
			DATABASE=`$GREP "CREATE DATABASE" ${DUMP_DIR}/gp_cdatabase*$REBUILD_KEY|$AWK '{print $3}'`
		else
			LOG_MSG "[WARN]:-Could not locate ${DUMP_DIR}/gp_cdatabase*$REBUILD_KEY, turning off create database" 1
			NOCREATEDB=1
		fi
	fi
	#Check if multi-home array
	T_SEG_ARRAY=()
	for MHOST in ${PRIMARY_HOST_ARRAY[@]}
	do
	    PING_HOST $MHOST
	    SEG_HOSTNAME=`$TRUSTED_SHELL $MHOST "$HOSTNAME"`
	    if [ $? -ne 0 ];then
		ERROR_EXIT "[FATAL]:-Unable to get hostname output for $MHOST" 2
	    fi	    
	    if [ `$ECHO ${T_SEG_ARRAY[@]}|$TR ' ' '\n'|$GREP -c "^${SEG_HOSTNAME}$"` -eq 0 ];then
		T_SEG_ARRAY=(${T_SEG_ARRAY[@]} $SEG_HOSTNAME)
	    fi
	done	    

	NUM_HOSTNAME=${#T_SEG_ARRAY[@]}
	((MULTIPLE=${#PRIMARY_HOST_ARRAY[@]} / $NUM_HOSTNAME))
	if [ $MULTIPLE -eq 1 ] ; then
	    MULTI_HOME=0
	    ARRAY_TXT="Single-home"
	else
	    MULTI_HOME=1
	    ARRAY_TXT="Multi-home"
	fi


	((NUM_DUPLICATE=$SEG_PER_HOST / ${#DATA_DIRECTORY[@]}))
	HOME_COUNT=1
	FAKE_DATA_DIRECTORY=(${DATA_DIRECTORY[@]})
	FAKE_MIRROR_DATA_DIRECTORY=(${MIRROR_DATA_DIRECTORY[@]})

	while [ $HOME_COUNT -lt $NUM_DUPLICATE ] 
	do
	    FAKE_DATA_DIRECTORY=(${FAKE_DATA_DIRECTORY[@]} ${DATA_DIRECTORY[@]})
	    if [ $MIR_NUM -ne 0 ] ; then
		FAKE_MIRROR_DATA_DIRECTORY=(${FAKE_MIRROR_DATA_DIRECTORY[@]} ${MIRROR_DATA_DIRECTORY[@]})
	    fi
	    ((HOME_COUNT=$HOME_COUNT+1))
	done
	
	DATA_DIRECTORY=()
	MIRROR_DATA_DIRECTORY=()
	for DIR in ${FAKE_DATA_DIRECTORY[@]}
	do
	    DATA_DIRECTORY=(${DATA_DIRECTORY[@]} $DIR)
	    LOG_MSG "[INFO]:-Obtained Primary data directory $DIR"
	done

	if [ $MIR_NUM -ne 0 ] ; then
	    for DIR in ${FAKE_MIRROR_DATA_DIRECTORY[@]}
	    do
		MIRROR_DATA_DIRECTORY=(${MIRROR_DATA_DIRECTORY[@]} $DIR)
	    LOG_MSG "[INFO]:-Obtained Mirror data directory $DIR"
	    done
	fi

	DELETE_TEMP_DB	
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

DISPLAY_PARAM () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Greenplum Database rebuild parameters" 1
	LOG_MSG "[INFO]:--------------------------------------" 1
	LOG_MSG "[INFO]:-Dump file rebuild key                = $REBUILD_KEY" 1
	if [ $NOCREATEDB -eq 0 ];then
	LOG_MSG "[INFO]:-Create database                      = $DATABASE" 1
	else
	LOG_MSG "[INFO]:-Create database                      = Off" 1
	fi
	LOG_MSG "[INFO]:-Array name                           = $ARRAY_NAME" 1
	LOG_MSG "[INFO]:-Array interconnect type              = $ARRAY_TXT" 1
	LOG_MSG "[INFO]:-Server encoding                      = $ENCODING" 1
	LOG_MSG "[INFO]:-Locale setting                       = $LOCALE_SETTING" 1
	LOG_MSG "[INFO]:-Master max connections               = $MASTER_MAX_CONNECT" 1
	LOG_MSG "[INFO]:-Check point segments                 = $CHECK_POINT_SEGMENTS" 1
	LOG_MSG "[INFO]:-Greenplum array segment prefix       = $SEG_PREFIX" 1
	LOG_MSG "[INFO]:-Master hostname                      = $MASTER_HOSTNAME" 1
	LOG_MSG "[INFO]:-Master data directory                = $MASTER_DIRECTORY" 1
	LOG_MSG "[INFO]:-Master port                          = $MASTER_PORT" 1
	if [ x"" == x"$STANDBY_HOSTNAME" ];then
	LOG_MSG "[INFO]:-Warm master standby                  = Not configured" 1
	else
	LOG_MSG "[INFO]:-Warm master standby hostname         = $STANDBY_HOSTNAME" 1
	fi
	LOG_MSG "[INFO]:--------------------------------------" 1
	LOG_MSG "[INFO]:-Primary segment configuration" 1
	LOG_MSG "[INFO]:--------------------------------------" 1
	LOG_MSG "[INFO]:-Primary hostname list                = ${PRIMARY_HOST_ARRAY[@]}" 1
	LOG_MSG "[INFO]:-Primary data directory list          =" 1
	for DIR in ${DATA_DIRECTORY[@]}
	do
	    LOG_MSG "[INFO]:-                                       $DIR" 1
	done
	LOG_MSG "[INFO]:-Primary port base                    = $PORT_BASE" 1	
	LOG_MSG "[INFO]:--------------------------------------" 1
	LOG_MSG "[INFO]:-Mirror segment configuration" 1
	LOG_MSG "[INFO]:--------------------------------------" 1
	if [ $MIR_NUM -ne 0 ];then
	LOG_MSG "[INFO]:-Mirror array type                    = $TYPE_TXT" 1
	if [ $MIRROR_TYPE -eq 0 ];then
	LOG_MSG "[INFO]:-Mirror type                          = Group" 1
	else
	LOG_MSG "[INFO]:-Mirror type                          = Spread" 1
	fi
	LOG_MSG "[INFO]:-Mirror hostname list                 = ${MIRROR_HOST_ARRAY[@]}" 1
	LOG_MSG "[INFO]:-Mirror data directory list           =" 1
	for DIR in ${MIRROR_DATA_DIRECTORY[@]}
	do
	    LOG_MSG "[INFO]:-                                       $DIR" 1
	done
	LOG_MSG "[INFO]:-Mirror port base                     = $MIRROR_PORT_BASE" 1

	else
	LOG_MSG "[INFO]:-Mirroring not configured" 1
	fi	
	if [ $INTERACTIVE ]; then
		$ECHO  "Continue with Greenplum Database system rebuild Yy/Nn>"
		read REPLY
		if [ -z $REPLY ]; then
			LOG_MSG "[WARN]:-User abort requested, Script Exits!" 1
			EXIT_STATUS=1
			exit $EXIT_STATUS
		fi
		if [ $REPLY != Y ] && [ $REPLY != y ]; then
			LOG_MSG "[WARN]:-User abort requested, Script Exits!" 1
			EXIT_STATUS=1
			exit $EXIT_STATUS
		fi
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

BUILD_CONFIG_FILES () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Building array configuration file, please wait..." 1
	for PRI in ${PRIMARY_HOST_ARRAY[@]}
	do
		$ECHO $PRI >> $GP_HOST_FILE
	done	
	$ECHO "ARRAY_NAME=\"${ARRAY_NAME}\"" > $GP_INIT_FILE
	if [ $NOCREATEDB -eq 0 ];then
		$ECHO "DATABASE_NAME=$DATABASE" >> $GP_INIT_FILE
	fi
	$ECHO "PORT_BASE=$PORT_BASE" >> $GP_INIT_FILE
	$ECHO "SEG_PREFIX=$SEG_PREFIX" >> $GP_INIT_FILE
	$ECHO "MASTER_DIRECTORY=$MASTER_DIRECTORY" >> $GP_INIT_FILE
	$ECHO "MACHINE_LIST_FILE=$GP_HOST_FILE" >> $GP_INIT_FILE
	$ECHO "declare -a DATA_DIRECTORY=(`$ECHO ${DATA_DIRECTORY[@]}`)" >> $GP_INIT_FILE
	$ECHO "MASTER_HOSTNAME=$MASTER_HOSTNAME" >> $GP_INIT_FILE
	$ECHO "MASTER_PORT=$MASTER_PORT" >> $GP_INIT_FILE
	$ECHO "MASTER_MAX_CONNECT=$MASTER_MAX_CONNECT" >> $GP_INIT_FILE
	$ECHO "TRUSTED_SHELL=ssh" >> $GP_INIT_FILE
	$ECHO "ENCODING=$ENCODING" >> $GP_INIT_FILE
	$ECHO "LOCALE_SETTING=$LOCALE_SETTING" >> $GP_INIT_FILE
	$ECHO "CHECK_POINT_SEGMENTS=$CHECK_POINT_SEGMENTS" >> $GP_INIT_FILE
	if [ $MIR_NUM -ne 0 ];then
		if [ $SEP_HOSTS -eq 0 ];then
			#Shared array	
			$ECHO "MIRROR_PORT_BASE=$MIRROR_PORT_BASE" >> $GP_INIT_FILE
			$ECHO "declare -a MIRROR_DATA_DIRECTORY=(`$ECHO ${MIRROR_DATA_DIRECTORY[@]}`)" >> $GP_INIT_FILE
		else
			#Separate array, build a mirror hostname:data dir pair set and build file for gpaddmirrors
			if [ $MULTI_HOME -eq 0 ];then
				for M_HOST in ${MIRROR_HOST_ARRAY[@]}
				do
					for M_DIR in ${MIRROR_DATA_DIRECTORY[@]}
					do
						$ECHO "${M_HOST}:${M_DIR}" >> $GP_MIR_FILE
					done
				done
			else
				J=0
				for M_HOST in ${MIRROR_HOST_ARRAY[@]}
				do
					$ECHO "${M_HOST}:${MIRROR_DATA_DIRECTORY[$J]}" >> $GP_MIR_FILE
					if [ $J -eq ${#MIRROR_DATA_DIRECTORY[@]} ];then
						J=0
					else
						((J=$J+1))
					fi
				done	
			fi
		fi
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

RM_TMPFILES () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	$RM -f $GP_INIT_FILE
	$RM -f $GP_MIR_FILE
	$RM -f $GP_HOST_FILE
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

PROCESS_REBUILD () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Calling rebuild utilities, please wait..." 1
	if [ $SEP_HOSTS -eq 0 ];then
		if [ $MIRROR_TYPE -eq 0 ];then
			if [ x"" == x"$STANDBY_HOSTNAME" ];then
				$GPINITSYSTEM -c $GP_INIT_FILE -a
				RETVAL=$?
			else
				$GPINITSYSTEM -c $GP_INIT_FILE -a -s $STANDBY_HOSTNAME
				RETVAL=$?
			fi
		else
			if [ x"" == x"$STANDBY_HOSTNAME" ];then
				$GPINITSYSTEM -c $GP_INIT_FILE -a -S
				RETVAL=$?
			else
				$GPINITSYSTEM -c $GP_INIT_FILE -a -S -s $STANDBY_HOSTNAME
				RETVAL=$?
			fi
		fi
		if [ $RETVAL -eq 2 ];then
			LOG_MSG "[FATAL]:-$GPINITSYSTEM failed, review $GPINITSYSTEM log file for failure cause" 1
			DUMP_CONFIG_FILES
			RM_TMPFILES
			ERROR_EXIT "[FATAL]:-Unable to continue" 2
		fi
			RM_TMPFILES
	else
		if [ x"" == x"$STANDBY_HOSTNAME" ];then
			$GPINITSYSTEM -c $GP_INIT_FILE -a
			RETVAL=$?
		else
			$GPINITSYSTEM -c $GP_INIT_FILE -a -s $STANDBY_HOSTNAME
			RETVAL=$?
		fi
		if [ $RETVAL -eq 2 ];then
			DUMP_CONFIG_FILES
			RM_TMPFILES
			LOG_MSG "[FATAL]:-$GPINITSYSTEM failed, review $GPINITSYSTEM log file for failure cause" 1
			ERROR_EXIT "[FATAL]:-Unable to continue" 2
		fi
		if [ $MIRROR_TYPE -eq 0 ];then
			$GPADDMIRRORS -m $GP_MIR_FILE -a
			RETVAL=$?
		else
			$GPADDMIRRORS -m $GP_MIR_FILE -s -a
			RETVAL=$?
		fi
		if [ $RETVAL -eq 2 ];then
			DUMP_CONFIG_FILES
			RM_TMPFILES
			LOG_MSG "[FATAL]:-$GPADDMIRRORS failed, review $GPADDMIRRORS log file for failure cause"1
			LOG_MSG "[INFO]:-$GPINITSYSTEM completed without error, correct reason for failure and re-call" 1
			LOG_MSG "[INFO]:-$GPADDMIRRORS with appropriate options" 1
			ERROR_EXIT "[FATAL]:-Unable to continue" 2
		fi
		RM_TMPFILES
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

DUMP_CONFIG_FILES () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Dumping contents of temporary configuration files to $LOG_FILE for help with diagnostics" 1
	$ECHO "----------------gpinitsystem configuration file Contents-------------------" >> $LOG_FILE
	$CAT $GP_INIT_FILE >> $LOG_FILE
	$ECHO "----------------gpinitsystem host file Contents----------------------------" >> $LOG_FILE
	$CAT $GP_HOST_FILE >> $LOG_FILE
	$ECHO "----------------gpddmirrors configuration file Contents (May be null)------" >> $LOG_FILE
	$CAT $GP_MIR_FILE >> $LOG_FILE
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}	
DELETE_TEMP_DB () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Stopping temporary database" 1
	export PGPORT=$TEMP_PORT;$PG_CTL -w -D ${TEMP_DATA_DIRECTORY}/parsetemp -o "-i -p $TEMP_PORT" stop 
	ERROR_CHK $? "shutdown of temporary database on port $TEMP_PORT data directory $TEMP_DATA_DIRECTORY" 1
	LOG_MSG "[INFO]:-Removing temporary database directory" 1
	$RM -Rf ${TEMP_DATA_DIRECTORY}/parsetemp
	LOG_MSG "[INFO]:-Deleting temporary database log file" 1
	$RM -Rf ${TEMP_DATA_DIRECTORY}/parsetemp.log
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

POST_REBUILD_INFO () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-The Greenplum array rebuild has completed" 1
	LOG_MSG "[INFO]:-Please complete the following checks" 1
	LOG_MSG "[INFO]:-1. Review the master instance postgresql.conf settings to ensure correct" 1
	LOG_MSG "[INFO]:-2. Review the master instance pg_hba.conf settings to ensure correct" 1
	LOG_MSG "[INFO]:-3. To restore data, review options to gpdbrestore" 1
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

#******************************************************************************
# Main Section
#******************************************************************************
trap 'DELETE_TEMP_DB;RM_TMP_FILES;ERROR_EXIT "[FATAL]:-Recieved INT or TERM signal" 2' INT TERM
if [ $# -ne 0 ]; then
	while getopts ":vt'?'axp:qscf:l:d:C:D!" opt;do
		case $opt in
			v ) VERSION_INFO ;;
			'?' ) USAGE ;;
			! ) SCRIPT_USAGE=1
			    USAGE ;;
			d ) TEMP_DATA_DIRECTORY=$OPTARG ;;
			a ) unset INTERACTIVE ;;
			x ) NOCREATEDB=1 ;;
			q ) unset VERBOSE ;;
			s ) MIRROR_TYPE=1 ;;
			l ) LOG_DIR=$OPTARG ;;
			f ) SQL_FILE=$OPTARG ;;
			p ) TEMP_PORT=$OPTARG ;;
			c ) CHANGE_SEG_DETAILS=1 ;;
			C ) CHECK_POINT_SEGMENTS=$OPTARG ;;
			D ) DEBUG_LEVEL=1 ;;
			* ) USAGE ;;
		esac
	done	
fi
if [ x"" != x"$LOG_DIR" ];then
	CHK_DIR $LOG_DIR
	if [ $EXISTS -eq 1 ]; then
		LOG_MSG "[WARN]:-Log directory $LOG_DIR does not exist, using default log directory" 1
		EXIT_STATUS=1
	else
		LOG_FILE=$LOG_DIR/${PROG_NAME}_${CUR_DATE}.log
	fi
fi
LOG_MSG "[INFO]:-Start Main"
LOG_MSG "[INFO]:-Command line options passed to utility = $*"
CHK_GPDB_ID
VALIDATE_PARAM
CREATE_TEMP_DB
if [ $CHANGE_SEG_DETAILS -eq 1 ];then 
	UPDATE_SEG_DETAILS
fi
PARSE_SQL_FILE
DISPLAY_PARAM
BUILD_CONFIG_FILES
PROCESS_REBUILD
POST_REBUILD_INFO
LOG_MSG "[INFO]:-End Main"
exit $EXIT_STATUS
