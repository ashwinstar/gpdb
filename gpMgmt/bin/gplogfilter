#!/usr/bin/env python
#
# $Id: $

# Standard Python library
import copy
import os
import os.path
import re
import sys
from optparse import Option, OptionGroup, OptionParser, OptionValueError, SUPPRESS_USAGE

# GPDB
from lib.datetimeutils import str_to_datetime, str_to_duration, DatetimeValueError
from lib.logfilter import filterOneLogFile, spiffInterval


description = ("""
Extracts GPDB log entries from inputfile and writes them to stdout
if they fulfill all of the criteria you specify.  If inputfile is a
directory, the suffix ".log" is appended to obtain the input file name.
To read from standard input, specify "-" for inputfile.  To write the
log entries to a file other than stdout, use the --out option.
""")

class OptParser(OptionParser):
    # OptionParser's help text formatter removes paragraph breaks and
    # preserves excess spaces.  Override its (undocumented) format_help
    # method so our help can have paragraphs.
    _help = ["""
        In the input file, each log entry starts with a timestamp
        "YYYY-MM-DD HH:MM:SS[.fraction]" at the beginning of a line.
        Any following lines are considered to belong to the same entry,
        up to the next line having a different timestamp.
        ""","""
        --begin and --end values can be specified as either
        "YYYY-MM-DD[ HH:MM[:SS]]" or "YYYYMMDD[ HHMM[SS]]".  Between date
        and time, either a space or the letter "T" is required.  When only
        the date is given, 00:00:00 is used for the time.
        Specify --duration as "[hours][:minutes[:seconds]]";
        it is unused if both --begin and --end are given.
        ""","""
        The ending date and time can be given by --end, or computed as
        --begin plus --duration.  The beginning date and time can be
        given by --begin, or computed as --end minus --duration, or
        computed as the current date and time minus --duration.
        ""","""
        Log entries are skipped unless they fulfill all of the criteria
        you specify.  For example, if you specify two occurrences of the
        --select option, log entries must contain both of the strings.
        ""","""
        Example:
        gplogfilter --duration=2 --select=ERROR: $MASTER_DATA_DIRECTORY
        # view error messages timestamped within the past two hours
        """]
    def format_help(self, *args):
        msg = OptionParser.format_help(self, *args)
        help = [self.formatter.format_description(' '.join(s.split()))
                for s in self._help]
        msg = '\n'.join([msg] + help)
        return msg

class OptChecker(Option):
    # Teach optparse to accept types 'datetime', 'duration', 'regex', 'search'
    def datetimeCheck(option, opt, value):
        try:
            return str_to_datetime(value)
        except DatetimeValueError, e:
            raise OptionValueError('"%s %s" ... %s' % (opt, value, e.description))
    def durationCheck(option, opt, value):
        try:
            return str_to_duration(value, signed=False)
        except DatetimeValueError, e:
            raise OptionValueError('"%s %s" ... %s' % (opt, value, e.description))
    def regexCheck(option, opt, value):
        global _case
        flags = re.LOCALE
        if _case and _case.startswith('i'):
            flags |= re.IGNORECASE
        try:
            return re.compile(value, flags)
        except Exception, e:
            raise OptionValueError('"%s %s" ... %s' % (opt, value, e))
    def searchCheck(option, opt, value):
        return option.regexCheck(opt, re.escape(value))
    case = 'respect'
    TYPES = Option.TYPES + ('datetime', 'duration', 'regex', 'search')
    TYPE_CHECKER = copy.copy(Option.TYPE_CHECKER)
    TYPE_CHECKER['datetime'] = datetimeCheck
    TYPE_CHECKER['duration'] = durationCheck
    TYPE_CHECKER['regex'] = regexCheck
    TYPE_CHECKER['search'] = searchCheck

_case = 'respect'
def _setcase(option, opt, value, parser):
    global _case
    _case = value


# Declare the command line options
parser = OptParser(option_class=OptChecker,
                   description=' '.join(description.split()))
parser.set_usage('%prog [options] inputfile')
parser.remove_option('-h')

optgrp = OptionGroup(parser, '\n  Timestamp range',
                     'Use any two of these options to impose lower and '
                     'upper bounds on timestamps; or use any one option to '
                     'bound the timestamp range on just one side. ')
optgrp.add_option('-b', '--begin',    type='datetime', metavar='datetime',
                  help='beginning date and time: "YYYY-MM-DD[ HH:MM[:SS]"')
optgrp.add_option('-e', '--end',      type='datetime', metavar='datetime',
                  help='ending date and time')
optgrp.add_option('-d', '--duration', type='duration', metavar='[h][:m[:s]]',
                  help='duration from beginning to end')
parser.add_option_group(optgrp)

optgrp = OptionGroup(parser, 'Pattern and string matching',
                     'Log entries can be chosen depending on whether '
                     'they contain a match for a pattern (regular '
                     'expression) or string. Matching of alphabetic '
                     'characters is case-sensitive unless preceded '
                     'by --case=ignore. These options can be used as many '
                     'times as needed to apply multiple restrictions. '
                     'Regular expression syntax is documented at '
                     'http://docs.python.org/lib/re-syntax.html')
optgrp.add_option('-s', '--select',   dest='match', type='search', action='append', metavar='string',
                  help='omit log entries which do not contain the string')
optgrp.add_option('-r', '--reject',   dest='nomatch', type='search', action='append', metavar='string',
                  help='omit log entries containing the string')
optgrp.add_option('-m', '--match',    type='regex', action='append', metavar='regex',
                  help='omit log entries in which the regex does not match')
optgrp.add_option('-n', '--nomatch',  type='regex', action='append', metavar='regex',
                  help='omit log entries containing a match for the regex')
parser.add_option_group(optgrp)

optgrp = OptionGroup(parser, 'Mode flags',
                     'These flags affect the behavior of other options '
                     'specified to their right.  They can be used '
                     'as many times as needed.')
optgrp.add_option('-c', '--case',     type='choice', choices=['i', 'ignore', 'r', 'respect'],
                  metavar='i[gnore]|r[espect]',
                  action='callback', callback=_setcase,
                  help=('either ignore or respect the distinction '
                        'between upper and lower case letters in '
                        'subsequent pattern and string matching options'))
parser.add_option_group(optgrp)

optgrp = OptionGroup(parser, 'Output options')
optgrp.add_option('-o', '--out',      type='string', metavar='outputfile',
                  help='write output to outputfile (default is stdout)')
optgrp.add_option('-q', '--quiet',    dest='verbose', action='store_false',
                  help='suppress status messages')
optgrp.add_option('-h', '--help',     action='help',
                  help='show this help message and exit')
parser.add_option_group(optgrp)

parser.set_defaults(verbose=True)

# Parse the command line options
(options, args) = parser.parse_args()
parser.set_usage(SUPPRESS_USAGE)

# Determine timestamp range
begin, end = spiffInterval(options.begin, options.end, options.duration)
if begin:
    begin = begin.replace(microsecond=0)
if end:
    end = end.replace(microsecond=0)

if len(args) <> 1:
    parser.error('Exactly one input file must be specified (or "-" for stdin).  '
                 'Use --help for more info.')

try:
    fileIn = fileOut = None
    try:
        # Open input file, unless reading from stdin
        if args[0] <> '-':
            ifn = os.path.abspath(args[0])
            # In case a master or segment instance's data directory name
            # was given, append '.log' to get the instance's log file name
            # (by gpdb convention).
            if (not os.path.isfile(ifn) and
                os.path.isdir(ifn)):
                ifn += '.log'
            fileIn = open(ifn, 'rU')
            if options.verbose:
                print >>sys.stderr, '---------- ', ifn, '---------- '

        # Open output file, unless writing to stdout
        if options.out:
            ofn = os.path.abspath(options.out)
            if not os.access(ofn, os.W_OK):
                raise IOError('Unable to write to output location %s' % `ofn`)
            fileOut = open(ofn, 'w')

        # Copy selected lines from input to output
        filterOneLogFile(fileIn or sys.stdin,
                         fileOut=fileOut or sys.stdout,
                         begin=begin,
                         end=end,
                         include=options.match,
                         exclude=options.nomatch,
                         verbose=options.verbose)
    finally:
        if fileIn:
            fileIn.close()
        if fileOut:
            fileOut.close()
except IOError, msg:
    parser.error(msg)
