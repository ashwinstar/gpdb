# GPSANITIZE DOES NOT SUPPORT THIS OPERATION YET.
################
#   config file 
#   mirrorN=host:port:data_dir

def parseMirrorConfig():
    file = None
    lines = []
    try:
        file = open(opt['-i'], 'r')
        lines = file.readlines()
    except Exception, e:
        gpmlib.error('Read file %s error' % opt['-i'])
    finally:
        if file:
            file.close()

    mirrors = []
    for l in lines:
        l = l.strip()
        if l == '':
            continue
        param = l.split('=')
        if len(param) != 2:
            gpmlib.error('Mirror config format error')
        mirror = param[1].split(':')
        if len(mirror) != 3:
            gpmlib.error('Mirror config format error')
        m = {}
        m['hostname'] = mirror[0]
        m['port'] = int(mirror[1])
        m['datadir'] = mirror[2]
        mirrors.append(m)
        
    return mirrors

################
def update_gp_conf(db, mirrors):
    system_filespace = 3052

    # update Greenplum database configuration
    for m in mirrors:
        history_message = "GPADDMIRRORS: content %d, dbid %d, hostname %s, port %s, datadir %s" % (m['content'], m['dbid'], m['hostname'], m['port'], m['datadir'])
        db.execute("insert into gp_configuration_history values(now(), $1, $2)", m['dbid'], history_message)
        db.execute("insert into gp_configuration values($1, $2, $3, $4, $5, $6, $7, null)",
                   m['content'], False, m['dbid'], False, True, 
                   m['hostname'], m['port'])
        db.execute("insert into pg_filespace_entry values($1, $2, $3)",
                   system_filespace, m['dbid'], m['datadir'])

################                                      
# Fetch the storage-group name using the powermt command via the wwn.
#
def get_sgname_by_wwn(host, gp_mount_agent_cmd, powermt_cmd, wwn):
    (ok, out) = gpmlib.run('%s %s --storagegroup %s' % (gplib.ssh_prefix(host=v['host']), gp_mount_agent_cmd, powermt_cmd))
    if not ok:
        gpmlib.log_error('failed to run powerpath management tool on remote host %s' % host)

    matchstr = wwn.upper()

    # we get output which looks like:
    # [ . . . ]
    # CLARiiON ID=<identifier> [SG_NAME]
    # Logical device ID=<WWN> [LUN_ID]
    # [ . . . ]
    # We want to match on the WWN, and extract the SG_NAME, so we're walking a set
    # of lines, keeping track of the previous line.
    prev = ''
    for l in out:

        # Find a line with our match on it -- we'll store the previous
        # line as we go.
        # 
        # we could use a regexp here, would that be faster ?
        if l.rfind(matchstr) == -1:
            # not found
            prev = l
            continue

        # we have a line like "CLARiiON ID=APM00091400579 [<storage group name>]
        x = prev.partition('[')
        if x[2] == '':
            prev = l
            continue

        y = x[2].partition(']')
        if y[0] == '':
            prev = l
            continue

        # we got a line that looks right.
        return y[0]

    return ''

# Given a host and a command, verify that the command is setuid-root.
# THIS DOESN'T WORK PROPERLY
def verify_setuid_root(host, command):
    (ok, out) = gpmlib.run('%s %s %s' % (gplib.ssh_prefix(host=host), ENV.STAT, command))
    if not ok:
        return False
    else:
        # NOTE: we don't actually check for SUID here "/usr/bin/stat" has different output on different
        # platforms, and parsing isn't as straightforward as I'd expected. Python has some appropriate
        # functions.
        #
        # So despite its name, this method actually only verifies that the command exists.
        return True

# Given a set of segment-mountpoints, we need to find out where to fail them over
def get_failover_info(devmap):
    san_config = {}

    for k, v in devmap.iteritems():
        config_key = (v['host'], v['mountpoint'])

        # We only want to find a failover for a mountpoint one time.
        if config_key not in san_config:
            print 'Enter failover host and mountpoint for primary mountpoint %s:%s >' % (v['host'], v['mountpoint'])
            line = sys.stdin.readline() 
            line = line.strip()

            if line == '':
                gpmlib.error('Null value entered for failover')
            words = line.split(':')
            if len(words) != 2:
                gpmlib.error('Invalid value entered for failover, expected <host>:<mountpoint>')

            san_config[config_key] = {'primaryhost':v['host'], 'failoverhost':words[0], 'primarymp':v['mountpoint'], 'failovermp':words[1]}

    return san_config

################
coverage = GpCoverage()
coverage.start()

try:
    parseCommandLine()

    ENV.chk_environ()

    master_port = gpmlib.get_master_port(opt['-d'])

    if gpmlib.chk_on_passive_standby(master_port):
        gpmlib.fatal('Unable to process requested command')

    if ENV.GP_MOUNT_AGENT == '':
        if ENV.GPHOME == '':
            gpmlib.error('Cannot locate GPDB mount mangement utility')
        else:
            ENV.GP_MOUNT_AGENT = '%s/bin/gp_mount_agent' % ENV.GPHOME

    if opt['-t'] == 'e':
        if ENV.INQ == '':
            gpmlib.error('Cannot locate SCSI-Inquiry utility for use in EMC Clariion scan.')
        if ENV.NAVISECCLI == '':
            gpmlib.error('Cannot locate EMC management naviseccli utility for use in EMC Clariion scan.')
        if ENV.POWERMT == '':
            gpmlib.error('Cannot locate EMC PowerPath powermt utility for storage-group lookup')

    dburl = dbconn.DbURL(port=master_port, dbname='template1')
    gparray = GpArray.initFromCatalog(dburl, utility=True)

    if gparray.get_mirroring_enabled():
        gpmlib.error('System already has mirrors. SAN-mirroring cannot coexist with mirrors.')

    qes = None
    new_addr = []

    try:
        qes = gparray.getSegDbList()
        qe_hosts = [ x.getSegmentHostName() for x in qes ]

        # Google tells me that this is the fastest way to unique-ify a list
        # in Python, it is a weird construct: convert list->set->list
        hosts = list(set(qe_hosts))

        # We have the qe-details (root filespace with dbids and so on)

        ########################
        # Some systems' "mount" returns "dev on mp" and other return "mp on dev"
        devfirst = True
        if ENV.SYSTEM == 'sunos':
            devfirst = False
        elif ENV.SYSTEM == 'darwin':
            devfirst = True
        elif ENV.SYSTEM == 'linux':
            devfirst = True
        elif ENV.SYSTEM == 'freebsd':
            devfirst = True

        ########################
        # Check the permissions on the utilities that we need.
        if opt['-t'] == 'e':
            for host in hosts:
                if not verify_setuid_root(host, ENV.GP_MOUNT_AGENT):
                    gpmlib.error('Host %s has invalid permissions for %s' % (host, ENV.GP_MOUNT_AGENT))
                if not verify_setuid_root(host, ENV.INQ):
                    gpmlib.error('Host %s has invalid permissions for %s' % (host, ENV.INQ))


        ########################
        # Get the raw mountpoint info for every host.
        mountpoints = {}
        for host in hosts:
            (ok, out) = gpmlib.run('%s %s' % (gplib.ssh_prefix(host=host), ENV.MOUNT))
            if not ok:
                error('failed to run mount on remote host')

            # we have a list of strings, find the dev and mp.
            mps = []
            for l in out:
                x = l.strip().split()
                if devfirst:
                    thismp = (x[0], x[2])
                else:
                    thismp = (x[2], x[0])
                mps.append(thismp)

            # save the output for this
            mountpoints[host] = mps

        # What we have here is a dictionary indexed by host, with each value being
        # a list containing our mountpoints

        # loop over the qes, figuring out which mount-devices are used by each data-directory.
        # We're generating a new dictionary, where the keys are dictionaries labelling fields.
        #
        # the new dictionary is going to be our main datastructure for the rest of our SAN calculations.
        max_dbid = 0

        devmap = {}
        for qe in qes:
            h = qe.getSegmentHostName()
            content = qe.getSegmentContentId()
            d = qe.getSegmentDataDirectory()
            primary_port = qe.getSegmentPort()
            mirror_port = primary_port + opt['-p']
            id = qe.getSegmentDbId()

            if id >= max_dbid:
                max_dbid = id

            mplist = mountpoints[h]

            matchdir = ''
            matchdev = ''
            for (dev, mountdir) in mplist:
                if d.startswith(mountdir):
                    if len(mountdir.split('/')) >= len(matchdir.split('/')):
                        matchdir = mountdir
                        matchdev = dev

            devmap[id] = {'content':content, 'host':h, 'datadir':d, 'device':matchdev, 'mountpoint':matchdir, 'primaryport':primary_port, 'mirrorport':mirror_port}

        if opt['-t'] == 'n':
            bad_device_count = 0
            gpmlib.log_info('Scanning mount-devices in NFS-mode.')
            for k, v in devmap.iteritems():
                if len(v['device'].split(':')) != 2:
                    gpmlib.log_info('dbid %d on %s has data-dir on %s (%s): Does not appear to be NFS share' % (k, v['host'], v['mountpoint'], v['device']))
                    bad_device_count = bad_device_count + 1
            if bad_device_count > 0:
                gpmlib.error('Database system has %d segments which are not on NFS, cannot proceed in NFS-mode' % bad_device_count)

        # If we're in EMC/Clariion-mode, we need to find the WWNs for the devices so we
        # can figure out which hosts have access to them.
        #
        # It would be nice if we could run INQ once for each host, but resolving multiple
        # segments per host to hostnames properly is a little weird here -- so for now
        # we're going to issue way more INQ requests than necessary (by a factor given
        # by the number of segments/host).
        if opt['-t'] == 'e':
            gpmlib.log_info('Scanning mount-devices in EMC/Clariion-mode.')

            wwn_sgname_map = {} # cache the storage-group names associated with each WWN.

            missing_wwn = False
            for k, v in devmap.iteritems():
                found = False
                # gpmlib.log_info('%s %s -clar_wwn -no_dots' % (gplib.ssh_prefix(host=v['host']), ENV.INQ))
                (ok, out) = gpmlib.run('%s %s -clar_wwn -no_dots' % (gplib.ssh_prefix(host=v['host']), ENV.INQ))
                if not ok:
                    gpmlib.error('failed to run inquiry-tool on remote host %s' % host)

                # We're parsing the output of the "inq" utility here.
                # lines of interest look like:
                # "/dev/emcpowerbp  APM00091400579   B  172.16.10.6     0x006f   600601607e62220093afcb43752ddf11"
                # Where the last entry on that line is the WWN.
                for l in out:
                    x = l.strip().split()

                    if len(x) == 6 and x[0].startswith('/') and x[0] == v['device']:
                        # got the entry we want.
                        WWN = x[5]
                        SPIP = x[3]

                        v['SPIP'] = SPIP
                        v['WWN'] = WWN

                        # if we don't have the storage group name already, try to get it.
                        #
                        # We'll fill it into out main configuration-map later, cache it here.
                        if not wwn_sgname_map.has_key(WWN):
                            sg_name = get_sgname_by_wwn(v['host'], ENV.GP_MOUNT_AGENT, ENV.POWERMT, WWN)
                            if not sg_name == '':
                                gpmlib.log_info('Got sgname %s for wwn %s' % (sg_name, WWN))
                                wwn_sgname_map[WWN] = sg_name

                        found = True
                        break

                if not found:
                    missing_wwn = True
                    gpmlib.log_info('dbid %d on host %s could not find WWN for device %s' % (k, v['host'], v['device']))

            if missing_wwn:
                gpmlib.log_error('Could not find some WWN entries')
                gpmlib.error('Cannot resolve shared-storage location for EMC-SAN')

            # At this point we have all of the information we need (except possibly the Storage-group names).
            #
            # If we got the storage-group name, we fill it in here.
            for k, v in devmap.iteritems():
                WWN = v['WWN']
                if not wwn_sgname_map.has_key(WWN):
                    gpmlib.log_info('dbid %d on %s has data-dir on %s (%s) EMC %s @ %s' % (k, v['host'], v['mountpoint'], v['device'], v['WWN'], v['SPIP']))
                else:
                    v['SG_NAME'] = wwn_sgname_map[WWN]
                    gpmlib.log_info('dbid %d on %s has data-dir on %s (%s) EMC %s @ %s SG %s' % (k, v['host'], v['mountpoint'], v['device'], v['WWN'], v['SPIP'], v['SG_NAME']))

        ########################

        if opt['-i']:
            gpmlib.error('PARSING FAILOVER INPUT NOT SUPPORTED YET')

        # So now we need to retrieve our failover mappings.
        san_config = get_failover_info(devmap)

        # For each host/mountpoint in devmap, we should now have a failover host/mountpoint in san_config.
        # Now we need to verify that each of the new mountpoints exists.
        for k, v in san_config.iteritems():
            tmpfile = os.path.join(v['failovermp'], 'gptmpfile')
            gpmlib.log_info('verifying host %s failovermp %s tmpfile %s' % (v['failoverhost'], v['failovermp'], tmpfile))

            (ok, out) = gpmlib.run_warn('%s "%s %s"' % (gplib.ssh_prefix(host=v['failoverhost']), ENV.TOUCH, tmpfile))
            if ok:
                (ok, out) = gpmlib.run('%s "%s -f %s"' % (gplib.ssh_prefix(host=v['failoverhost']), ENV.RM, tmpfile))            
            else:
                gpmlib.error('Cannot find mountpoint %s on failover host %s' % (v['failovermp'], v['failoverhost']))

        # Now we have all of the information we need for gp_san_configuration, build a final dictionary
        # to store our work. As we go, we're going to add the failover-data-directory to devmap.
        final_map = {}
        map_id = 0
        
        for k, v in devmap.iteritems():
            san_key = (v['host'], v['mountpoint'])

            if not san_config.has_key(san_key):
                gpmlib.error('Resolving final config: cannot find configuration for %s:%s' % (v['host'], v['mountpoint']))

            san_val = san_config[san_key]
            
            primaryhost = san_val['primaryhost']
            primarymp = san_val['primarymp']
            failoverhost = san_val['failoverhost']
            failovermp = san_val['failovermp']

            # figure out the data-directory for this segment by substituting the failover
            # mountpoint prefix for the primary mountpoint.
            primary_datadir = v['datadir']
            v['failover_host'] = failoverhost
            v['failover_datadir'] = failovermp + primary_datadir[len(primarymp):]
            v['san_mount'] = map_id

            if opt['-t'] == 'n':
                device = v['device']
            elif opt['-t'] == 'e':
                # build up the device string from our pieces.

                device = 'WWN=' + v['WWN'] + ',SP=' + v['SPIP']

                if v.has_key('SG_NAME'):
                    new_device = device + ',SG_NAME=' + v['SG_NAME']
                    device = new_device
                # Got the entire device string
            else:
                gpmlib.error('Unknown device-type %s' % opt['-t'])

            final_map[map_id] = {'primaryhost':primaryhost, 'primarymp':primarymp, 'failoverhost':failoverhost, 'failovermp':failovermp, 'device':device}
            map_id = map_id + 1

        gpmlib.log_info('Success.')

        # We now have two top-level dictionaries:
        # 
        # devmap is indexed by dbid and contains all of the specifics to the segment
        #   info for gp_segment_configuration *and* pg_filespace_entries indexed by dbid
        #   and references the other map by "map_id"
        #
        # final_map has all of the contents for gp_san_configuration. indexed by "id"
        #   as reference from devmap.

        # First: emit the san-configuration info.
        for k, v in final_map.iteritems():
            print('INSERT INTO GP_SAN_CONFIGURATION VALUES (%d, \'p\', \'%s\', \'%s\', \'%s\', \'%s\', \'%s\', \'%s\', \'%s\');' %
                            (k, opt['-t'], v['primaryhost'], v['primarymp'], v['device'], v['failoverhost'], v['failovermp'], v['device']))

        # THE NEXT TWO STEPS COULD BE DONE IN ONE LOOP -- BUT THAT SEEMS LIKE IT WOULD BE LESS CLEAR

        # Second: update the existing segments.
        for k, v in devmap.iteritems():
            print('UPDATE GP_SEGMENT_CONFIGURATION SET san_mounts = \'%s\' WHERE dbid=%d ;' % (v['san_mount'], k))

        # Third: add the new segments, along with their filespace-locations.
        new_dbid = max_dbid
        for k, v in devmap.iteritems():
            new_dbid = new_dbid + 1
            print('INSERT INTO GP_SEGMENT_CONFIGURATION VALUES (%d, %d, \'m\', \'m\', \'s\', \'u\', %d, \'%s\', \'%s\', NULL, \'%d\');' %
                            (new_dbid, v['content'], v['mirrorport'], v['failover_host'], v['failover_host'], v['san_mount']))
            print('INSERT INTO PG_FILESPACE_ENTRY SELECT fsefsoid, %d, \'%s\' FROM PG_FILESPACE_ENTRY WHERE fsedbid = %d ;' % (new_dbid, v['failover_datadir'], k))

        # Fourth: Modify the gp_fault_strategy setting.
        print('UPDATE GP_FAULT_STRATEGY SET fault_strategy = \'s\' ;')

        ########################
    except Exception,e:
        gpmlib.error(e)

    sys.exit(0)

except KeyboardInterrupt:
    sys.exit('\nUser Interrupted')
finally:
    coverage.stop()
    coverage.generate_report()



