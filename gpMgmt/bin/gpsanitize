#!/usr/bin/env python

'''

Helps an administrator configure Greenplum Database with shared-storage ("san") failover

gpsanitize -- helper for generated SAN-failover configuration information.

Usage: gpsanitize [--version] [-?aq] [-D] [-d master_data_dir] [-l log_dir] [-p port_offset] [-o outfile] [-s] [-t <n|e>] [-i mirror_config] [-m mirror_datadir_config] [-B number]
           
          --version : print version information
          -?        : print this help screen
          -D        : set logging output to debug level
          -q        : quiet mode, do not log progress to screen [default: verbose output to screen]
          -a        : non-interactive mode [default: interactive mode]
          -d        : master data directory
          -l        : <log directory> alternative log file directory [optional]
          -o        : file to output configuration
          -i        : mirror configuration file
          -s        : spread mirror mode
          -t        : "type" of shared-storage technology (e: EMC Clariion, n: NFS).
          -p        : mirror offset, if not supplied, script will calculate a suitable
                      port offset for the mirror segment instances, range 7000 - 61000
                      current offset value is 1000
          -m        : mirror data directory config file
          -B        : number of parallel process to spawn to process mirror creation


          Format of the input configuration file:
          mirror[N]=host:port:data_dir
          where N is content in gp_configuration table

          Format of the mirror data directory config file:
          data_dir1
          data_dir2
          ...
          data_dirN
          where N is the number of segment data directory per host
'''

from __future__ import with_statement
import os, sys, getopt, socket
from threading import Thread
from datetime import date, datetime, timedelta

from gppylib.db import *
from gppylib.gparray import *
from gppylib.gpcoverage import GpCoverage

sys.path.append(sys.path[0] + '/lib')

# Apparently the gpmlib and gplib stuff was supposed to be deprecated, but 
# I cannot find the equivalent functionality anywhere else -- I need to
# walk through results returned by shell commands digging for information
# this isn't as easy as I'd like.
import gplib
import gpmlib
from gpmlib import ENV

script_name = os.path.split(__file__)[-1]
opt = {}
opt['-q'] = False
opt['-d'] = None
opt['-m'] = None
opt['-B'] = 64
opt['-a'] = False
opt['-s'] = False
opt['-i'] = None
opt['-o'] = None
opt['-p'] = 1000
opt['-l'] = None
opt['-D'] = False
opt['-t'] = 'e'

arg = {}
arg['exit'] = 0

################
def usage(exitarg):
    print gplib.cli_help() or __doc__
    sys.exit(exitarg)

################
def print_version():
    print '%s version $Revision$' % script_name
    sys.exit(0)

################
def parseCommandLine():
    global opt
    try:
        (options, args) = getopt.getopt(sys.argv[1:], '?vqasi:o:d:m:B:p:l:Dc:T:t:', ['version'])
    except Exception, e:
        usage(str(e))

    for (switch, val) in options:
        if (switch == '-?'):          usage(0)
        elif (switch == '-v'):        print_version()
        elif (switch == '--version'): print_version()
        elif (switch == '-q'):        opt[switch] = True
        elif (switch == '-m'):        opt[switch] = val
        elif (switch == '-t'):        opt[switch] = val
        elif (switch == '-B'):        opt[switch] = int(val)
        elif (switch == '-a'):        opt[switch] = True
        elif (switch == '-s'):        opt[switch] = True
        elif (switch == '-i'):        opt[switch] = val
        elif (switch == '-o'):        opt[switch] = val
        elif (switch == '-p'):        opt[switch] = int(val)
        elif (switch == '-d'):        opt[switch] = val
        elif (switch == '-l'):        opt[switch] = val
        elif (switch == '-D'):        opt[switch] = True
        elif (switch == '-T'):        gpmlib.log_info('Option -T is obsolete.  This option will be ignored')

    gpmlib.log_set_module(script_name)

    if opt['-q']:
        gpmlib.log_set_verbose(False)

    if opt['-l']:
        if not gpmlib.directory_exists(opt['-l']):
            gpmlib.error('Log directory %s does not exist' % opt['-l'])

        opt['-l'] = os.path.join(opt['-l'], '%s_%s.log' % (script_name, date.today().strftime('%Y%m%d')))
        gpmlib.log_set_file(opt['-l'])
    else:
        logdir = os.path.join(os.environ.get('HOME'), 'gpAdminLogs')
        if not gpmlib.directory_exists(logdir):
            try:
                os.mkdir(logdir)
            except OSError, e:
                gpmlib.error('Make directory %s error' % logdir)

        opt['-l'] = os.path.join(logdir, '%s_%s.log' % (script_name, date.today().strftime('%Y%m%d')))
        gpmlib.log_set_file(opt['-l'])

    if opt['-i'] and not os.path.isfile(opt['-i']):
        usage('Input configuration file %s does not exist' % opt['-i'])

    if not opt['-d']:
        opt['-d'] = os.getenv('MASTER_DATA_DIRECTORY')
        if not opt['-d']:
            gpmlib.error('MASTER_DATA_DIRECTORY not set')
    else:
        os.environ['MASTER_DATA_DIRECTORY'] = opt['-d']

    if opt['-i'] and opt['-p']:
        gpmlib.log_warn('-p option not valid when used with -i option.  -p will be ignored')

    if not os.path.isdir(opt['-d']):
        gpmlib.error('MASTER_DATA_DIRECTORY %s does not exist or is not a directory' % opt['-d'])

    if opt['-t'] == 'e':
        gpmlib.log_info('Will attempt to scan EMC Clariion devices')
    elif opt['-t'] == 'n':
        gpmlib.log_info('Will attempt to find NFS shares')
    else:
        gpmlib.log_error('\"%s\" is not a supported failover type' % opt['t'])

################
def yesorno(msg, abortmsg):
    print msg
    line = sys.stdin.readline()
    line = line.strip().lower()
    if line == 'y':
        return True
    print abortmsg
    return False


