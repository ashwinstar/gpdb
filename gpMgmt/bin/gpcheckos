#!/usr/bin/env python
"""
    USAGE: gpcheckos  [-d]|[[-m SRC_HOST][-r REF_HOST] [-s HOST | -f HOST_FILE]]
    where
    SRC_HOST =  is the ntpserver used for ntp checks, defaults to master host of greenplum cluster   
    REF_HOST = is the reference host to create a baseline numbers for consistency check
    HOST_FILE = a file containing all the segment host names
    HOST      = name of the host
    -d        = run gpcheckos against a live database. No other arguments are needed.
                In addtition to the stand OS level checks, it also checks GUC settings 
  
"""

import os, sys
from gppylib.gpcheckosCmd import *
from gppylib.utils import *
from gppylib.stringUtil import *
from gppylib.commands.gpcheckosUnix import *
from gppylib.gpcheckosSql import *
from socket import gethostname

progname = os.path.split(sys.argv[0])[-1]

DEFAULT_NUM_WORKERS=16


if sys.version_info < (2, 5, 0):
    sys.exit(
'''Error: %s is supported on Python versions 2.5 or greater
Please upgrade python installed on this machine.''' % progname)

import time
from optparse import Option, OptionGroup, OptionParser, OptionValueError, SUPPRESS_USAGE



try:
    import figleaf

    from gppylib.db import dbconn
    from gppylib.gpparseopts import OptParser, OptChecker
    from gppylib.gplog import *
    from gppylib.db import dbconn
    from gppylib import gparray
    from gppylib import gphostcache
    from gppylib import userinput
    from gppylib.db import catalog
    from gppylib.commands import unix
    from gppylib.commands import gp
    from gppylib.commands import base
    from gppylib.commands import pg
    from gppylib import pgconf
except ImportError, e:
    sys.exit('Cannot import modules.  Please check that you have sourced greenplum_path.sh.  Detail: ' + str(e))

class Gpcheckos():
    def __init__(self, gphosts, srcHost, parallel=DEFAULT_NUM_WORKERS, quiet=False):
        self.pool=None
        self.gphosts=gphosts
        self.parallel=parallel
        self.srcHost=srcHost
        self.quiet=quiet
        self.numSegmentPerHost=0
        logger=get_default_logger()
        #setup_tool_logging()
        self.baseline = Baseline()
        if len(gphosts) == 0:
            self.createHostnamesFromDb()
            
        logger.info("Setting level of parallelism to : %s" % (self.parallel) )
        pass
  
    def check_hosts(self, logger,pool):
        ''' go through all of the gphosts and try and ping all of the hosts.  if any fail
        then go back to using the interface names for those segments.
        throws an Exception if still can't ping on the interface names.
        '''
        failed_hosts=[]

    def create_baseline(self,refHost):
        global baselineFile
        baselineFile= "/tmp/.BASELINE"
        touchFile(baselineFile)
        cmdStrs = {}
        cmdStrs["memoryTotal"] =nixCheckRefHostMemoryTotal
        cmdStrs["dataMounts"]=nixGetXfsMounts
        cmdStrs["cpuMHz"]=nixGetCpuMHz
        cmdStrs["coreCount"]=nixGetCpuCoreCount
        for cmdKey, cmdStr in cmdStrs.iteritems():
            cmd=anyCommand("get Baseline from ref host %s"%(refHost),cmdStr, 
                           ctxt=REMOTE, remoteHost=refHost)
            cmd.run()
            if cmdKey == "memoryTotal":
                if cmd.get_results().rc != 0 :
                    print cmd.get_results().stderr
                else: 
                    self.baseline.memoryTotal = cmd.get_results().stdout.split(":")[1].split()[0]
                
            elif cmdKey == "dataMounts":
                for i in cmd.get_results().stdout.rstrip('\n').split('\n'):
                    self.baseline.dataMounts.append(i)
            
                    
            elif cmdKey == "cpuMHz" :
                self.baseline.cpuMHz = cmd.get_results().stdout.rstrip('\n').split('\n')
                    
            elif cmdKey == "coreCount":
                self.baseline.coreCount = cmd.get_results().stdout.rstrip('\n')
                
            self.baseline.serializeToFile(cmdKey,baselineFile)
        self.baseline.printBaseline()
        
    def _start_checkos(self):
        for gphost in self.gphosts:
            gph=gphost.rstrip()
            if not isNone(gph):
                scp_cmd=RemoteCopy("copy baseline",baselineFile,gph,baselineFile)            
                self.pool.addCommand(scp_cmd)
                self.pool.join()        
                self.pool.check_results()        
      
        for gphost in self.gphosts:
            cmd=GpCheckosCmd("starting gpcheckos on host %s"%(gphost),gphost, self.srcHost,ctxt=REMOTE,remoteHost=gphost )
            self.pool.addCommand(cmd)
        self.pool.join()
        cmds=self.pool.getCompletedItems()
        for cmd in cmds:
            if cmd.get_results().rc == 0:
                logger.info( "%s"%(cmd.get_results().stdout))
            else:
                logger.info( "%s"%(cmd.get_results().stderr))
        self.pool.haltWork()
        self.pool.joinWorkers()
    
    def createHostnamesFromDb(self):
        gphostnames = []
        try:
            hostsQueue =WorkerPool()
            dburl = dbconn.DbURL(gethostname(), username='gpadmin')
            gparray = createGPDBFromDB(dburl,utility=True)
            hostCache = GpHostCache(gparray, hostsQueue)
            failedPings = hostcache.ping_hosts(hostsQueue)
            self.gphosts = hostCache.get_hostnames()
            self.numSegmentPerHost =   gparray.numPrimarySegments / len(self.gphosts)
            hostsQueue.join
            hostsQueue.haltWork()
            hostsQueue.joinWorkers()
        except DatabaseError, ex:
            logger.error(ex.__str__())
            logger.error('Failed to connect to database, exiting...')
            sys.exit(1)
        
        
    def checkGpBackoffProcPerSegment(self):
        rows=[]
        try:  
            dburl = dbconn.DbURL(gethostname(), username='gpadmin')
            conn = dbconn.connect(dburl,True)
            rows = dbconn.execSQL(conn, SqlCommands().getSqlCmd("gpBackoffProcPerSegment"))
            
        
        except DatabaseError, ex:        
            logger.error(ex.__str__())
            logger.error('database exception. exiting...')
            sys.exit(1)       
        coresPerSegments = int(self.baseline.coreCount) / self.numSegmentPerHost
        backOffValue =int(self.baseline.coreCount) / self.numSegmentPerHost
        if (coresPerSegments)  > backOffValue:
            print "processor to number of segments per host is %s and gp_Backoff_Proc_PER_Segment value is %s"% \
                  (coresPerSegments, backOffValue)
        else:
            print "processor to segments ratio on a single host is %s... [OK]"%(coresPerSegments)
        
    def _start_check_GUC(self):
        print "\nCheck database settings ..."
        self.checkGpBackoffProcPerSegment()
        
    
def parseargs():
    parser = OptParser(option_class=OptChecker, usage=__doc__)
    parser.remove_option('-h')
  
    parser.add_option('-h', '-?', '--help', action='store_true')
   
    parser.add_option('-m', '--mhost', action="append", type="string", dest="srcHost" ,
                        help='specify ntp server defaults to master host')
    parser.add_option('-s', '--host', action="append", type="string", dest="hostnames" ,
                        help='specify a single or multiple hosts')
    parser.add_option('-f', '--file',  type="string", dest="hostfile" ,
                        help='specify location of the file containing hosts to be checked')
    parser.add_option('-r', '--rhost', action="append", type="string", dest="refHost" ,
                        help='specify reference segment host defaults to sdw1')
    parser.add_option('-d', '--database', action='store_true')
    parser.add_option('--debug', action='store_true')

    (options,args) = parser.parse_args()

#sanity check
    if not options.hostnames and not options.hostfile and not options.database:
        print "    ***************************************************************************"
        print "    *****missing hosts                                                    *****"
        print "    *****please specified either individual hosts or file containing hosts*****"
        print "    ***************************************************************************"
        print __doc__
        parser.exit()
   
    if not options.srcHost and not options.database:
        print "default source host to mdw"
        options.srcHost = "mdw" 
    elif options.database:
        options.srcHost = createMasterFromDb()
    else:
        options.srcHost=' '.join(options.srcHost)

    if not options.refHost and not options.database:
        print "default reference host to sdw1"
        options.refHost = "sdw1"
    else:
        options.refHost = ' '.join(options.refHost)
    if options.debug:
        enable_verbose_logging() 

    if options.help:
        print __doc__
        sys.exit(0)

    return options, args



def createMasterFromDb():
    rows=[]
    try:  
        dburl = dbconn.DbURL(gethostname(), username='gpadmin')
        conn = dbconn.connect(dburl,True)
        rows = dbconn.execSQL(conn, SqlCommands().getSqlCmd("gpMasterHost"))
        
    except DatabaseError, ex:        
        logger.error(ex.__str__())
        logger.error('database exception, exiting...')
        sys.exit(1)       
    return "".join(rows.fetchone())
        

#------------------------------- Mainline --------------------------------
def main():
    gphosts=[]
    options,args=parseargs() 
    if options.hostnames:
        gphosts=options.hostnames
    if options.hostfile:
        gphosts=createFromSingleHostFile(options.hostfile)
        
    gpc=Gpcheckos(gphosts,options.srcHost)
    
    if options.database :
        options.refHost = gpc.gphosts[0]
      
        
    gpc.pool = WorkerPool(gpc.parallel)
    gpc.create_baseline(options.refHost)
    gpc._start_checkos()
    if options.database:
        gpc._start_check_GUC()
    else:
        print "-d is not specified, GUC checks skipped."

if __name__ == '__main__':
    main()
