#!/usr/bin/env python

'''
gpcheckos -- check os for consistency and compatibility with GPDB.

Usage: gpcheckos [--version] [-?v] [-p port] [-u user] [-h host] [-f hostfile] 


          --version : print version information
          -?        : print this help screen
          -v        : verbose mode
          -p port   : ssh port to use 
          -u user   : the user to run command
          -h host   : the host to connect to (multiple -h is okay)
          -f file   : a file listing all hosts to connect to

'''

import os, sys, getopt, popen2, pickle

sys.path.append(sys.path[0] + '/lib')
try:
    import gplib
except ImportError, e:
    sys.exit('Error: unable to import module: ' + str(e))

script_name = os.path.split(__file__)[-1]
opt = {}
opt['-v'] = False
opt['-p'] = None
opt['-u'] = os.environ.get('LOGNAME') or os.environ.get('USER')
opt['-h'] = []
opt['-f'] = False
GPHOME = os.environ.get('GPHOME')
if not GPHOME:
    sys.exit('GPHOME env not set')

################
def usage(exitarg):
    print gplib.cli_help() or __doc__
    sys.exit(exitarg)


#############
def print_version():
    print '%s version $Revision$' % script_name
    sys.exit(0)

#############
def parseCommandLine():
    global opt, argcmd
    try:
	(options, args) = getopt.getopt(sys.argv[1:], '?evp:u:h:f:', ['version'])
    except Exception, e:
	usage('Error: ' + str(e))

    for (switch, val) in options:
	if (switch == '-?'):	      usage(0)
	elif (switch[1] in 'v'):      opt[switch] = True
	elif (switch[1] in 'uf'):     opt[switch] = val
	elif (switch == '-h'):        opt[switch].append(val)
	elif (switch == '-p'):        opt[switch] = gplib.parse_port(val)
        elif (switch == '--version'): print_version()

    if opt['-p'] != None:
        if not opt['-p'] > 0: usage('Error: please specify port number for -p switch')

    hf = (len(opt['-h']) and 1 or 0) + (opt['-f'] and 1 or 0)
    if hf != 1:
	usage('Error: please specify at least one of -h or -f args, but not both')

    if (len(args) >= 1):
	argcmd = " ".join(args)


##########
def sshGpSys():
    session = []
    for (user, host, port) in opt['-h']:
        peer = user and ('%s@%s' % (user, host)) or host
        cmd = ('export PATH=%s && export LD_LIBRARY_PATH=%s && %s/bin/lib/gpsys.py -p' % (os.getenv('PATH'), os.getenv('LD_LIBRARY_PATH'), GPHOME))
        ssh = gplib.ssh_prefix(user, host, port)
	ssh = ssh + ' eval  \'%s\' ' % cmd
        if opt['-v']: print '[INFO %s] %s' % (peer, cmd)
        p = popen2.Popen4(ssh)
        p.x_user = h[0] or ''; p.x_host = h[1]
	p.x_cmd = cmd;   p.x_ssh = ssh
	p.x_peer = peer
	p.tochild.close()
	session.append(p)

    return session

def waitSession(session):
    errmsg = None
    permissionDenied = False
    for p in session:
        p.x_res = p.fromchild.read()
        i = p.x_res.find("BEGINDUMP")
        if i >= 0: p.x_res = p.x_res[i+10:]
        try:
            p.x_res = pickle.loads(p.x_res)
        except KeyboardInterrupt:
            raise
        except:
            if opt['-v']: print p.x_res
            permissionDenied = (p.x_res.find('Permission denied') >= 0)
            if permissionDenied:
                errmsg = '[ERROR %s] ssh permission denied while %s' % (p.x_peer, p.x_ssh)
            else:
                noSuchFile = (p.x_res.find('No such file') >= 0)
                if noSuchFile:
                    errmsg = '[ERROR %s] no such file error while %s' % (p.x_peer, p.x_ssh)
                else:
                    errmsg = '[ERROR %s] bad output while %s' % (p.x_peer, p.x_ssh)
            print errmsg
        if opt['-v']: print p.x_res
	status = p.wait()
	if status:
	    errmsg = '[ERROR %s] Command failed. Exit status = %s. Command = %s' % (p.x_peer, status, p.x_ssh)
	    print errmsg
		
    if permissionDenied:
	print
	print 'hint: check if the host is alive'
	print 'hint: use gpssh-exkeys to setup public-key authentication between hosts'
	print
    if errmsg: sys.exit(1)


def perr(host, s):
    print '   ERROR: on %s - %s' % (host, s)
    

errors = {}
def error(host, key, value):
    global errors

    if host not in errors:
        errors[host] = {}

    index = key.find('.')
    if index == -1:
        type = 'others'
    else:
        type = key[0:index]
        key = key[index+1:]
    
    if type == 'sysctl' and key == 'vm.overcommit_memory':
        type = 'vm'

    if not type in errors[host]:
        errors[host][type] = []

    errors[host][type].append((key, value))


def print_fix():
    global errors

    print ''
    for h in errors.keys():

        if 'vm' in errors[h]:
	    print
            print '[FIX %s] please execute the following command(s)' % h
	    for (key, value) in errors[h]['vm']:
                print '/sbin/sysctl -w %s=%s' % (key, value)
            
        if 'sysctl' in errors[h]:
	    print
            print '[FIX %s] please add/modify the following line(s) in /etc/sysctl.conf' % h
            for (key, value) in errors[h]['sysctl']:
                print '%s = %s' % (key, value)

        if 'env' in errors[h]:
	    print
            for (key, value) in errors[h]['env']:
                print '[FIX %s] please set the %s environment variable' % (h, key)
            
        if 'postgres' in errors[h]:
	    print
            print '[FIX %s] please check the software version or installation' % h
            for (key, value) in errors[h]['postgres']:
                print 'check %s = %s' % (key, value)

        if 'ndd' in errors[h]:
	    print
            print '[FIX %s] please add/modify the following line(s) in /etc/rc2.d/S*gpdb_ndd' % h
            for (key, value) in errors[h]['ndd']:
                print '/usr/sbin/ndd -set /dev/tcp %s %s' % (key, value)

        if 'platform' in errors[h]:
	    print
            print '[FIX %s] please valid the OS configuration' % h
            for (key, value) in errors[h]['platform']:
                print 'check %s = %s' % (key, value)

        if 'system' in errors[h]:
	    print
            print '[FIX %s] please add/modify the following line(s) in /etc/system'  % h
            for (key, value) in errors[h]['system']:
                print 'set %s=%s' % (key, value)

        if 'ulimit' in errors[h]:
	    print
            print '[FIX %s] please add/modify the following line(s) in /etc/security/limits.conf' % h
            for (key, value) in errors[h]['ulimit']:
                print 'soft %s %s' % (key, value)
                print 'hard %s %s' % (key, value)

        if 'others' in errors[h]:
	    print
            print '[FIX %s] please add/modify the line(s)' % h
            for (key, value) in errors[h]['others']:
                print '%s = %s' % (key, value)
            
                    
def match(session, key, value):
    ok = True
    print 'checking: %s = %s' % (key, value)
    for p in session:
        v = p.x_res.get(key, '')
        p.x_match = (v == value)
        if not p.x_match: 
            perr(p.x_peer, '%s mismatch (value %s should == %s)' % (key, v, value))
            error(p.x_peer, key, value)
            ok = False
    return ok

def matchList(session, key, value):
    ok = True
    print 'checking: %s = %s' % (key, value)
    vs = value.split()
    for p in session:
	v = p.x_res.get(key, '')
	l = v.split()
        p.x_match = (l == vs)
        if not p.x_match:
            perr(p.x_peer, '%s mismatch (value %s should == %s)' % (key, str(l), str(vs)))
            error(p.x_peer, key, value)
            ok = False
    return ok

def matchMore(session, key, value):
    ok = True
    print 'checking: %s >= %s' % (key, value)
    value = int(value)
    for p in session:
        v = int(p.x_res.get(key, 0))
        p.x_match = (v >= value)
        if not p.x_match:
            perr(p.x_peer, '%s invalid (value %s should be >= %s)' % (key, v, value))
            error(p.x_peer, key, value)

try:
    parseCommandLine()
    tab = []
    for h in opt['-h']: 
	h = gplib.parse_hostline(h, opt['-u'], opt['-p'])
	if h: tab.append(h)
        else: usage('Error: invalid -h argument')

    tab.extend(gplib.read_hostfile(opt['-f'], opt['-u'], opt['-p']))
    if len(tab) == 0:
        usage('Error: missing hosts in -h and/or -f arguments')

    opt['-h'] = tab
    session = sshGpSys()
    waitSession(session)

    p0 = session[0]
    # check gphome
    key = 'env.GPHOME'
    for p in session:
        value = p.x_res.get(key)
        if not value:
            perr(p.x_peer, 'GPHOME not set')
            error(p.x_peer, key, 'GPHOME not set')
            
    # check postgres 
    key = 'postgres.md5'
    value = p0.x_res.get(key)
    if not value: 
        perr(p0.x_peer, 'postgres binaries unavailable')
    else:
        match(session, key, value)
        # check postgres version
        key = 'postgres.version'
        value = p0.x_res.get(key)
        if not value: 
            perr(p0.x_peer, 'postgres version unavailable')
        else:
            match(session, key, value)

    key = 'platform.system'
    value = p0.x_res.get(key)
    print 'checking: %s = linux or sunos' % key
    if value == 'linux' and match(session, key, 'linux'):
        key = 'platform.release'
        v = session[0].x_res['platform.release']
        if v.find('2.6') != 0:
            perr(p.x_peer, 'Linux version (version %s should be >= 2.6)' % v)
        elif match(session, key, v):
            # check shm
            key = 'sysctl.kernel.shmmax'
            matchMore(session, key, 500000000)
            key = 'sysctl.kernel.shmmni'
            matchMore(session, key, 4096)
            key = 'sysctl.kernel.shmall'
            matchMore(session, key, 4000000000)

            # check sem
            key = 'sysctl.kernel.sem'
            matchList(session, key, '250 64000 100 512')

            # check net
            key = 'sysctl.net.ipv4.tcp_tw_recycle'
            matchMore(session, key, 1)
            key = 'sysctl.net.ipv4.tcp_max_syn_backlog'
            match(session, key, '4096')
            key = 'sysctl.net.core.netdev_max_backlog'
            match(session, key, '10000')

            # check overcommit memory
            key = 'sysctl.vm.overcommit_memory'
            match(session, key, '2')

            # check ulimit
            key = 'ulimit.nofile'
            matchMore(session, key, 65536)
            key = 'ulimit.nproc'
            matchMore(session, key, 131072)
	
	    print_fix()

    elif value == 'sunos' and match(session, key, 'sunos'):
        key = 'platform.release'
        v = session[0].x_res['platform.release']
        if v.find('5.10') != 0:
            perr(p.x_peer, 'Solaris version (version %s should be >= 5.10)' % v)
        elif match(session, key, v):
            # check ndd
            key = 'ndd.tcp_conn_req_max_q'
            match(session, key, '4096')

            key = 'ndd.tcp_conn_req_max_q0'
            match(session, key, '4096')

            key = 'ndd.tcp_largest_anon_port'
            match(session, key, '65535')
            
            key = 'ndd.tcp_smallest_anon_port'
            match(session, key, '4096')

            key = 'ndd.tcp_time_wait_interval'
            match(session, key, '100')

            # check system
            key = 'system.rlim_fd_max'
            match(session, key, '262144')
            
            key = 'system.rlim_fd_cur'
            match(session, key, '65536')

            key = 'system.shmsys:shminfo_shmmax'
            matchMore(session, key, 0x2000000)

            key = 'system.semsys:seminfo_semmi'
            match(session, key, '1024')
    
            print_fix()
    else:
        perr(p0.x_peer, 'unknown system (key %s should be either Linux or SunOS)' % key)

    

except KeyboardInterrupt:
    sys.exit('\nInterrupted ...')
