#!/bin/bash

if [ $# -lt 3 ]; then
   echo usage: $0 DB_admin_user DB_master_hostname AdminDatabaseName
   exit 1
fi

DBADMIN=$1
DBMASTER=$2
ADBNAME=$3
PSQL="psql -h $DBMASTER -U $DBADMIN"

echo Total database sizes without indexes
echo "DBSize           DBName"
echo "---------------- ------------------"
$PSQL $ADBNAME -t -c "SELECT datname FROM pg_database WHERE datname NOT IN ('postgres','template0','template1')" |
while read dbname
do
   if [ $dbname"x" != "x" ]
   then
      $PSQL $dbname -t -c "SELECT pg_size_pretty(sum(pg_relation_size(tablename))::int8) AS TotalTableSize,'$dbname' FROM pg_tables WHERE schemaname = 'public'"
   fi
done
