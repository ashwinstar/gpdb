# Detailed Description
#******************************************************************************
#
#******************************************************************************
# Prep Code
# Source required functions file, this required for script to run
# exit if cannot locate this file. Change location of FUNCTIONS variable
# as required.
WORKDIR=`dirname $0`
FUNCTIONS=$WORKDIR/lib/gp_bash_functions.sh
if [ -f $FUNCTIONS ]; then
                . $FUNCTIONS
else
                echo "[FATAL:]-Cannot source $FUNCTIONS file Script Exits!"
                exit 2
fi
#******************************************************************************
# Location Variables
#******************************************************************************

#******************************************************************************
# Command Variables
#******************************************************************************

#******************************************************************************
# Script Specific Variables
#******************************************************************************
INTERACTIVE=1
VERBOSE=1
TIME=`$DATE +%H":"%M":"%S`
CUR_DATE=`$DATE +%Y%m%d`
PROG_NAME=`$BASENAME $0`
HELP_DOC_NAME=`$ECHO $PROG_NAME|$AWK -F'.' '{print $1}'`_help
QD_NAME=`hostname`
EXIT_STATUS=0
FAULT_TEXT="readonly"
SINGLE_STEP=0
MOVE_HOST_MIRROR_COUNT=0
DUMP_SUB_DIR=db_dumps
EXPAND_DATE=$CUR_DATE
MPP_TBL=gp_id
MASTER_HOSTNAME=`$HOSTNAME`
TEMP_DB_SUFFIX=expandtmp
SEG_TAR_FILE=seg_template.tar.z
TMP_BASE_DIR=base_tmp_dir
TMP_PIPE=/tmp/transfer_fifo
TMP_DUMP_DIR=/tmp/expand_dump_dir
FORCE_NO_BACKUP=0
DUMP_CHK_FILE_PREFIX=gp_cdatabase_1_1_
IS_RUNNING=/tmp/${PROG_NAME}_is_running
KEEP_ONLINE=0
WAIT_SWITCH=1
PORT_TXT="port"
WARN_DUMP=0
TMP_COUNT=/tmp/${PROG_NAME}_tmp_count.$$
BATCH_DEFAULT=4
COPY_BATCH_DEFAULT=4
GPSEGEXPAND=${WORKDIR}/lib/gpsegexpand.sh
PARALLEL_STATUS_FILE=/tmp/${PROG_NAME}_parallel_status_file.$$
SCHEMA_PREFIX="expand_$$"
RANDOM_REDISTRIB=0
KEEP_SCHEMA=0
#******************************************************************************
# Functions
#******************************************************************************
USAGE () {
                $ECHO
                $ECHO "      `basename $0`"
                $ECHO
                $ECHO "      Adds additional host or hosts to a GPDB array"
                $ECHO "      Will abort processing if mirroring is not enabled on the array, use"
                $ECHO "      gpaddmirrors to add mirrors to the GPDB array"
                $ECHO "      The parameter gp_fault_action must be set to readonly, if not process will"
                $ECHO "      abort with an error message requesting that value to changed"
                $ECHO "      If the GPDB array has mirror segment instances on separate hosts, must supply"
                $ECHO "      a mirror host file containing a list of hostnames, see -m option below"
                $ECHO "      It is strongly advised that a complete dump of all user databases is undertaken"
                $ECHO "      before running this utility, see -b option"
		$ECHO "      As at this release of gpexpandsystem, the database must be quiescent, no connections"
		$ECHO "      to the database are allowed during the expansion process"
                $ECHO
                $ECHO "      Usage:"
                $ECHO "      $0 [OPTIONS]"
                $ECHO
                $ECHO "      General options:"
                $ECHO "      -?, display this help message & exit"
                $ECHO "      -v, display version information & exit"
                $ECHO "      -i, display additional help information"
                $ECHO
                $ECHO "      Logging options:"
                $ECHO "      -q, quiet mode, do not log progress to screen [default:- verbose output to screen]"
                $ECHO "      -l, <logfile directory> alternative logfile directory [optional]"
                $ECHO "      -a, don't ask to confirm GPDB array expansion [default:- ask]"
                $ECHO "      -D, set log output to debug level, shows all function calls"
                $ECHO
                $ECHO "      Connection options:"
                $ECHO "      -d, <Master instance directory> name of alternative Master instance to expand [optional]"
                $ECHO
                $ECHO "      Expand array options:"
                $ECHO "      -h, <hostfile> file containing a list of hostnames that are to be added to the array"
                $ECHO "          [mandatory]"
                $ECHO "      -m, <mirror hostfile> file containing a list of hostnames that will be used for the"
                $ECHO "          mirror hosts where mirror segments on separate dedicated hosts"
		$ECHO "      -r, do not re-distribute tables defined with random distribution [default:- re-distribute]"
                #$ECHO "      -f  force a single step table data transfer to be undertaken. Use this option if utility"
                #$ECHO "          reports that there is insufficient space for a single step database data transfer"
                #$ECHO "          Use this option with care for the following reasons:"
                #$ECHO "          1. As each table is successfully transferred, it will be truncated in the original database"
                #$ECHO "          2. User database access should be denied during processing as database will"
                #$ECHO "             be inconsistent during data transfer process"
                $ECHO "      -b, force utility to continue if no database backup files located, use this option"
                $ECHO "          with care"
                $ECHO "      -k, keep temporary expand schema's on line and do not delete. If this option selected, will"
                $ECHO "          need to manually delete these for each database"
                #$ECHO "      -w, do not wait for database switch over [default wait]"
                #$ECHO "          Default is to pause and wait for DBA confirmation before old database dropped"
                #$ECHO "          and new database renamed, if -w option supplied, will not wait for DBA"
                #$ECHO "          confirmation"
		$ECHO "      -B, <number> run this batch of expand segment host check processes in parallel [default:- $BATCH_DEFAULT]"
		$ECHO "      -C, <number> run this batch of parallel table record transfer processes in parallel"
		$ECHO "          [default:- $COPY_BATCH_DEFAULT]"
                $ECHO
                $ECHO "      Return codes:"
                $ECHO "      0 No problems encountered with requested operation"
                $ECHO "      1 Warning generated, but expansion completed and database operational"
                $ECHO "      2 Fatal error, unable to complete expansion, database could be in an inconsistent state"
                $ECHO
                exit $EXIT_STATUS
}

UNKNOWN_OPTION () {
                $ECHO
                $ECHO "[ERROR]:-Unknown option $1"
                USAGE
}

ADDITIONAL_INFO () {
                $ECHO
                $ECHO "    Tasks to be completed before running gpexpandsystem"
                $ECHO "    ------------------------------------------------------"
                $ECHO
                $ECHO "    1. Ensure correct version of GPDB software has been installed on each new host"
                $ECHO "    2. Required segment instance directories exist and user $USER has write access"
                $ECHO "    3. ssh access has been setup from the Master host to the new hosts"
                $ECHO "    4. Inter host ssh access from current hosts to new hosts has been configured"
                $ECHO "    5. Ensure that a database backup is completed prior to running this utility"
                $ECHO
                $ECHO "    Utility overview"
                $ECHO "    ----------------"
                $ECHO
                $ECHO "    The following provides a high level overview of the tasks that will be undertaken"
                $ECHO "    1. New hosts checked to ensure can be accessed and have correct software installed"
                $ECHO "    2. Current hosts are checked to see if they have sufficient space to hold a complete"
                $ECHO "       copy of all user databases"
                $ECHO "       If insufficient space and -f option not supplied, utility will exit with an error message"
                $ECHO "   3.  New hosts are checked to ensure have sufficient space for user databases"
                $ECHO "   4.  Current hosts are checked to see if they contain database dump files, if no dump files"
                $ECHO "       located and -b option not supplied, utility will exit with an error message"
                $ECHO "   5.  GPDB metadata obtained and re-configured to support new hosts"
                $ECHO "   6.  Checks made to see if any current mirrors need to be relocated"
                $ECHO "   7.  If -a option not supplied, current and new configuration information displayed and user"
                $ECHO "       prompted to continue or abort process"
                $ECHO "   8.  Checks made to see if any updates being made to database, if updates in progress, utility"
                $ECHO "       will exit with an error message"
                $ECHO "   9.  Schema dumps obtained of all user databases"
                $ECHO "   10. If any mirrors need to be relocated, these now processed"
                $ECHO "   11. Copy of a mirror segment transferred to one of the new host"
                $ECHO "   12. Temporary segment instance started on new host and all user tables cleared down"
                $ECHO "   13. Tar file created of this empty schema and secured"
                $ECHO "   14. New hosts added to the array and built using the empty schema template"
                $ECHO "   15. Temporary transfer databases created, one for each user database"
                $ECHO "   16. Schema dump files restored to each temporary transfer database"
                $ECHO "   17. For each user database, each table that has >0 records is copied from existing database"
                $ECHO "       to the temporary transfer database"
                $ECHO "   18. If insufficient space to keep a complete copy of existing databases online and -f"
                $ECHO "       option supplied existing table is truncated"
                $ECHO "   19. If sufficient space and -k option not supplied, when database transfer complete"
                $ECHO "       original database dropped"
                $ECHO "       Temporary transfer database renamed to original database name"
                $ECHO "       Analyze run against new database"
                $ECHO "   20. If -k option supplied, original databases and temporary transfer databases will remain"
                $ECHO "       online. If this option used, note the following"
                $ECHO "       a) Any changes applied to the original databases will make temporary transfer databases"
                $ECHO "          inconsistent copies"
                $ECHO "       b) To complete manual switch over:"
                $ECHO "          i)  Drop original database (> drop database <database name>;)"
                $ECHO "          ii) Rename temporary transfer database (> alter database <current name> rename to"
                $ECHO "              <original name>;)"
                $ECHO "   21. If transfer completes successfully, post transfer notes displayed"
        exit $EXIT_STATUS
}

CLEAR_FILES () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	$ECHO "**************************START BACKOUT FILE***********************" >> $LOG_FILE
	$CAT $BACKOUT_FILE >> $LOG_FILE
	$ECHO "****************************END BACKOUT FILE***********************" >> $LOG_FILE
	$RM -f $BACKOUT_FILE >/dev/null 2>&1
	$RM $IS_RUNNING > /dev/null 2>&1
	$RM -Rf $TMP_DUMP_DIR > /dev/null 2>&1
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

VALIDATE_OPTIONS () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	if [ -f $IS_RUNNING ];then
		LOG_MSG "[FATAL]:-Found $IS_RUNNING flag file, if utility not running delete file" 1
		ERROR_EXIT "[FATAL]:-Appears utility already running" 2
	else
		LOG_MSG "[INFO]:-Creating a run flag in /tmp" 1
		$TOUCH $IS_RUNNING
		BACKOUT_COMMAND "$RM -f $IS_RUNNING"
	fi
	if [ x"" == x"$HOST_FILE" ];then
		CLEAR_FILES
		ERROR_EXIT "[FATAL]:-Mandatory parameter -h <host file name> not supplied" 2;fi
	if [ ! -s $HOST_FILE ];then
		CLEAR_FILES
		ERROR_EXIT "[FATAL]:-File $HOST_FILE has zero size" 2;fi
	if [ `$HEAD -1 $HOST_FILE|$WC -w|$AWK '{print $1}'` -ne 1 ];then
		ERROR_EXIT "[FATAL]:-Issue with first line of $HOST_FILE, please check contents" 2
	fi
	NEW_PRIMARY_HOST_LIST=(`$CAT $HOST_FILE|$TR '\n' ' '`)
	#Check that these hosts are not already in use
	for HOST in ${NEW_PRIMARY_HOST_LIST[@]}
	do
		USED=`${EXPORT_LIB_PATH};$PSQL -q -p $MASTER_PORT $DEFAULTDB -A -t -c"select count(*) from $CONFIG_TABLE where hostname='${HOST}' and content<>-1;"`	
		if [ $USED -ne 0 ];then
			USED_ARRAY=(${USED_ARRAY[@]} $HOST)
		fi
	done
	if [ ${#USED_ARRAY[@]} -ne 0 ];then
		LOG_MSG "[FATAL]:-The following hosts are already part of the current GPDB array" 1
		for HOST in ${USED_ARRAY[@]}
		do
			LOG_MSG "[INFO]:-Host $HOST" 1
		done
		CLEAR_FILES
		ERROR_EXIT "[FATAL]:-Some new hosts already in use, unable to continue" 2
	else
		LOG_MSG "[INFO]:-New hosts not currently in use for this GPDB array, will continue process" 1
	fi
	NEW_PRIMARY_HOST_COUNT=${#NEW_PRIMARY_HOST_LIST[@]}
	#Check gp_fault_action, needs to be read-only
	FAULT_ACTION=`${EXPORT_LIB_PATH};$PSQL -q -p $MASTER_PORT $DEFAULTDB -A -t -c"show gp_fault_action;"`
	ERROR_CHK $? "obtain fault gp_fault_action for the array" 2
	if [ $FAULT_ACTION != $FAULT_TEXT ];then
		CLEAR_FILES
		LOG_MSG "[FATAL]:-Parameter gp_fault_action=$FAULT_ACTION" 1
		LOG_MSG "[FATAL]:-Change to gp_fault_action=$FAULT_TEXT in the master $PG_CONF file and restart database" 1
		ERROR_EXIT "[FATAL]:-Unable to continue" 2
	else
		LOG_MSG "[INFO]:-Parameter gp_fault_action=$FAULT_ACTION, can continue with process" 1
	fi
	#See if we have any segment instances failures
	GET_TRANS_READ
	if [ $TRANS_STATE == "on" ];then
		CLEAR_FILES
		LOG_MSG "[FATAL]:-Identified possible segment instance failure(s)" 1
		LOG_MSG "[INFO]:-Run gpstate to check status of the GPDB database" 1
		LOG_MSG "[INFO]:-If failures reported, run gprecoverseg to recover failed segment(s)" 1
		ERROR_EXIT "[FATAL]:-GPDB database in read-only state, unable to continue" 2
	fi
	GET_MIRROR_TYPE
	if [ $MIR_TYPE_NUM -eq 0 ];then
		CLEAR_FILES
		LOG_MSG "[FATAL]:-No mirroring has been configured on this array" 1
		LOG_MSG "[INFO]:-Use gpaddmirrors to create mirror instances" 1
		ERROR_EXIT "[FATAL]:-Unable expand this GPDB array without mirrors enabled, unable to continue" 2
	else
		LOG_MSG "[INFO]:-Obtained mirror type as $MIR_TYPE for this GPDB array" 1
	fi
	CHK_MULTI_HOME FULL
	if [ $MULTI_HOME -eq 0 ];then
		NUM_HOSTS=`${EXPORT_LIB_PATH};$PSQL -q -p $MASTER_PORT $QD_DBNAME -A -t -c"select count(distinct hostname) from $CONFIG_TABLE where content<>-1 and definedprimary='t';"`
		EXPAND_ERROR_CHK $? "obtain primary host count from database" 2
	else
		#This is multi-home array
		if [ $SEP_COUNT -eq 2 ];then
			#Mirrors on separate hosts
			((NUM_HOSTS=$REMOTE_HOST_COUNT/2))
		else
			NUM_HOSTS=$REMOTE_HOST_COUNT
		fi
	fi
	if [ $SEP_COUNT -eq 2 ];then	
		SEP_MIR_HOST=1
		if [ x"" == x"$MIRROR_HOST_FILE" ];then
			CLEAR_FILES
			ERROR_EXIT "[FATAL]:-GPDB array has mirrors on separate hosts, -m <mirror hostlist> not supplied" 2
		fi
		if [ ! -s $MIRROR_HOST_FILE ];then
			CLEAR_FILES
			ERROR_EXIT "[FATAL]:-Mirror host file $MIRROR_HOST_FILE is zero size" 2
		fi
		if [ `$WC -l $HOST_FILE|$AWK '{print $1}'` -ne `$WC -l $MIRROR_HOST_FILE|$AWK '{print $1}'` ];then
			CLEAR_FILES
			ERROR_EXIT "[FATAL]:-Host counts not the same in $HOST_FILE and $MIRROR_HOST_FILE" 2
		fi
		if [ `$HEAD -1 $MIRROR_HOST_FILE|$WC -w|$AWK '{print $1}'` -ne 1 ];then
			CLEAR_FILES
			ERROR_EXIT "[FATAL]:-Issue with first line of $MIRROR_HOST_FILE, please check contents" 2
		fi
		NEW_MIRROR_HOST_LIST=(`$CAT $MIRROR_HOST_FILE|$TR '\n' ' '`)
		for I in "${NEW_MIRROR_HOST_LIST[@]}"
		do
			if [ `$ECHO ${NEW_PRIMARY_HOST_LIST[@]}|$GREP -c $I` -ne 0 ];then
				CLEAR_FILES
				ERROR_EXIT "[FATAL]:-Hostname duplication, for separate mirror hosts, must be unique for both files" 2
			fi
		done
	else
		LOG_MSG "[INFO]:-Completed initial separate host mirror checks" 1
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

EXPAND_ERROR_CHK () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	if [ $1 -ne 0 ];then
		if [ $3 -eq 2 ];then
			CLEAR_FILES
			ERROR_EXIT "[FATAL]:-Failed to $2, unable to continue" 2
		fi
		if [ $3 -eq 1 ];then
			LOG_MSG "[WARN]:-Issue with $2, however, will continue" 1
			EXIT_STATUS=1
		fi
	else
		LOG_MSG "[INFO]:-Completed $2" 
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

VAR_SEG_WARN () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-*************************************************************" 1
	LOG_MSG "[WARN]:-Detected a variance number of $SEG_WARN_TXT segments per host" 1
	LOG_MSG "[INFO]:-This could be due to previous use of gprecoverseg" 1
	LOG_MSG "[INFO]:-with -s or -p options" 1
	LOG_MSG "[INFO]:-This array expansion will continue the imballance that has" 1
	LOG_MSG "[INFO]:-been detected" 1
	LOG_MSG "[INFO]:-*************************************************************" 1
	EXIT_STATUS=1
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

GET_GP_PARAMS () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	GET_QE_DETAILS
	LOG_MSG "[INFO]:-Identified ${#QE_ARRAY[@]} segment instances in this array" 1
	LOG_MSG "[INFO]:-Obtaining GPDB database parameters, please wait.."
	PRIMARY_PORT_BASE=`${EXPORT_LIB_PATH};$PSQL -q -p $MASTER_PORT $QD_DBNAME -A -t -c"select min(port) from $CONFIG_TABLE where content<>-1 and definedprimary='t';"`	
	EXPAND_ERROR_CHK $? "obtain primary port base from database" 2
	ENCODING=`${EXPORT_LIB_PATH};$PSQL -q -p $MASTER_PORT $QD_DBNAME -A -t -c"show server_encoding;"`
	EXPAND_ERROR_CHK $? "obtain server_encoding from database" 2
	LOCALE=`${EXPORT_LIB_PATH};$PSQL -q -p $MASTER_PORT $QD_DBNAME -A -t -c"show lc_messages;"`	
	EXPAND_ERROR_CHK $? "obtain locale value from database" 2
	ARRAY_NAME=`${EXPORT_LIB_PATH};$PSQL -q -p $MASTER_PORT $QD_DBNAME -A -t -c"select gpname from $GP_ID_TABLE;"`	
	EXPAND_ERROR_CHK $? "obtain array name from database" 2
	MIRROR_PORT_BASE=`${EXPORT_LIB_PATH};$PSQL -q -p $MASTER_PORT $QD_DBNAME -A -t -c"select min(port) from $CONFIG_TABLE where content<>-1 and definedprimary='f';"`
	EXPAND_ERROR_CHK $? "obtain mirror port base from database" 2
	MIRROR_DATADIR=(`${EXPORT_LIB_PATH};$PSQL -q -p $MASTER_PORT $QD_DBNAME -R" " -A -t -c"select datadir from $CONFIG_TABLE where content<>-1 and definedprimary='f' order by content;"`)
	EXPAND_ERROR_CHK $? "obtain mirror directory list from database" 2
	for I in "${MIRROR_DATADIR[@]}"
	do
		J=`$DIRNAME $I`
		if [ `$ECHO ${MIRROR_DATA_DIRECTORY[@]}|$GREP -c $J` -eq 0 ];then
			MIRROR_DATA_DIRECTORY=(${MIRROR_DATA_DIRECTORY[@]} $J);fi
	done
	MAX_CONTENT=`${EXPORT_LIB_PATH};$PSQL -q -p $MASTER_PORT $QD_DBNAME -A -t -c"select max(content) from $CONFIG_TABLE;"`
	EXPAND_ERROR_CHK $? "obtain maximum content value from database" 2
	MAX_DBID=`${EXPORT_LIB_PATH};$PSQL -q -p $MASTER_PORT $QD_DBNAME -A -t -c"select max(dbid) from $CONFIG_TABLE ;"`
	EXPAND_ERROR_CHK $? "obtain maximum dbid value from database" 2
	MIR_MAX_DBID=`${EXPORT_LIB_PATH};$PSQL -q -p $MASTER_PORT $QD_DBNAME -A -t -c"select max(dbid) from $CONFIG_TABLE where content<>-1;"`
	EXPAND_ERROR_CHK $? "obtain maximum mirror dbid value from database" 2
	SEG_PER_HOST=`${EXPORT_LIB_PATH};$PSQL -q -p $MASTER_PORT $QD_DBNAME -R" " -A -t -c"select count(distinct port) from $CONFIG_TABLE where definedprimary='t' and content<>-1;"`
	#Now check if multi-home that we have correct multiple of hostnames
	if [ $MULTI_HOME -eq 1 ];then
		if [ `$ECHO ${NEW_PRIMARY_HOST_COUNT}:$SEG_PER_HOST|$AWK 'BEGIN {FS=":"} {print $1/$2}'|$AWK 'BEGIN {FS="."} {print NF}'` -ne 1 ];then
			CLEAR_FILES
			LOG_MSG "[FATAL]:-Incorrect number of new hosts for multi-home array" 1
			LOG_MSG "[INFO]:-Expect total new hosts to be a multiple of number of primary segments per host" 1
			ERROR_EXIT "[FATAL]:-Unable to continue" 2
		fi
	fi	
	EXPAND_ERROR_CHK $? "obtain number of segments per host from database" 2
	PRIMARY_DATADIR=(`${EXPORT_LIB_PATH};$PSQL -q -p $MASTER_PORT $QD_DBNAME -R" " -A -t -c"select datadir from $CONFIG_TABLE where content<>-1 and definedprimary='t' order by content;"`)
	EXPAND_ERROR_CHK $? "obtain primary directory list from database" 2
	for I in "${PRIMARY_DATADIR[@]}"
	do
		J=`$DIRNAME $I`
		if [ `$ECHO ${PRIMARY_DIR_BASE[@]}|$GREP -c $J` -eq 0 ];then
			PRIMARY_DIR_BASE=(${PRIMARY_DIR_BASE[@]} `$DIRNAME $I`);fi
	done
	if [ x"" != x"$SEP_MIR_HOST" ];then
		SEP_MIR_HOSTS=(`${EXPORT_LIB_PATH};$PSQL -q -p $MASTER_PORT $QD_DBNAME -R" " -A -t -c"select distinct(hostname) from $CONFIG_TABLE where content<>-1 and definedprimary='f';"`)	
		EXPAND_ERROR_CHK $? "obtain separate mirror hostnames from database" 2
	fi
	SEG_HOSTNAME_LIST=(`${EXPORT_LIB_PATH};$PSQL -q -p $MASTER_PORT $QD_DBNAME -R" " -A -t -c"select distinct(hostname) from $CONFIG_TABLE where content<>-1;"`)
	EXPAND_ERROR_CHK $? "obtain distinct hostnames from database" 2
	#Now check to see if there is a variance in number of segments per host
	SEG_PRI_COUNT_WARN=0;SEG_MIR_COUNT_WARN=0
	for SEG_CHK_HOST in ${SEG_HOSTNAME_LIST[@]}
	do
		SEG_PRI_COUNT=`${EXPORT_LIB_PATH};$PSQL -q -p $MASTER_PORT $QD_DBNAME -R" " -A -t -c"select count(port) from $CONFIG_TABLE where hostname='${SEG_CHK_HOST}' and definedprimary='t' and content<>-1;"`
		EXPAND_ERROR_CHK $? "obtain port count for $SEG_CHK_HOST from database" 2
		if [ $SEG_PRI_COUNT -ne $SEG_PER_HOST ] && [ $MULTI_HOME -eq 0 ] && [ $SEP_COUNT -ne 2 ];then
			SEG_PRI_COUNT_WARN=1
		fi
		SEG_MIR_COUNT=`${EXPORT_LIB_PATH};$PSQL -q -p $MASTER_PORT $QD_DBNAME -R" " -A -t -c"select count(port) from $CONFIG_TABLE where hostname='${SEG_CHK_HOST}' and definedprimary='f' and content<>-1;"`
		EXPAND_ERROR_CHK $? "obtain mirror port count for $SEG_CHK_HOST from database" 2
		if [ $SEG_MIR_COUNT -ne $SEG_PER_HOST ] && [ $MULTI_HOME -eq 0 ] && [ $SEP_COUNT -ne 2 ];then
			SEG_MIR_COUNT_WARN=1
		fi
	done
	if [ $SEG_PRI_COUNT_WARN -eq 1 ];then
		SEG_WARN_TXT=primary
		VAR_SEG_WARN
	fi
	if [ $SEG_MIR_COUNT_WARN -eq 1 ];then
		SEG_WARN_TXT=mirror
		VAR_SEG_WARN
	fi
	PREV_TOTAL_SEG=`${EXPORT_LIB_PATH};$PSQL -q -p $MASTER_PORT $QD_DBNAME -R" " -A -t -c"select numsegments from $GP_ID_TABLE;"`
	EXPAND_ERROR_CHK $? "obtain number of segments from database" 2
	((TOTAL_SEG=${#PRIMARY_DATADIR[@]}*2))
	LOG_MSG "[INFO]:-Total segments including mirrors = $TOTAL_SEG" 1
	((TOTAL_PRI_SEG=${#PRIMARY_DATADIR[@]}))
	LOG_MSG "[INFO]:-Total primary segments           = $TOTAL_PRI_SEG" 1
	if [ $MULTI_HOME -eq 0 ];then
		((TOTAL_NEW_SEG=$SEG_PER_HOST*$NEW_PRIMARY_HOST_COUNT))
	else
		TOTAL_NEW_SEG=$NEW_PRIMARY_HOST_COUNT
	fi
	LOG_MSG "[INFO]:-Total new primary segments       = $TOTAL_NEW_SEG" 1
	((FINAL_TOTAL_SEG=$TOTAL_PRI_SEG+$TOTAL_NEW_SEG))
	LOG_MSG "[INFO]:-Total expanded primary segments  = $FINAL_TOTAL_SEG" 1
	SEG_PREFIX=`$BASENAME $MASTER_DATA_DIRECTORY|$CUT -d"-" -f1`
	LOG_MSG "[INFO]:-Array segment instance prefix    = $SEG_PREFIX" 1
	GET_DB_LIST
	#Check to see if template1 database contains any user tables, if not remove from list of databases to process
	CHK_TEMPLATE_DB
	LOG_MSG "[INFO]:-Database list to process         = `$ECHO ${DB_ARRAY[@]}|$TR '\n' ' '`" 1
	#Now check to see if we need to relocate current mirrors
	MIRROR_MOVE=0
	#Re-adjust array for multi-home
	if [ $MULTI_HOME -eq 1 ];then
		((HOSTCOUNT=$NEW_PRIMARY_HOST_COUNT/$SEG_PER_HOST))
	else
		HOSTCOUNT=$NEW_PRIMARY_HOST_COUNT
	fi
	#If mirroring on seperate hosts, don't need to relocate any mirrors
	if [ x"" == x"$SEP_MIR_HOST" ];then
		#Mirror is group and only adding one host
		if [ $MIR_TYPE_NUM -eq 1 ] && [ $HOSTCOUNT -eq 1 ];then
			MIRROR_MOVE=1
			MOVE_HOST_MIRROR_COUNT=1
		fi
		#Mirror is spread and adding less new hosts than number of segments per host
		if [ $MIR_TYPE_NUM -eq 2 ] && [ $SEG_PER_HOST -ge $HOSTCOUNT ];then
			MIRROR_MOVE=2
			#Now identify how many current array mirror segment we need to move
			((MOVE_HOST_MIRROR_COUNT=$SEG_PER_HOST-$HOSTCOUNT+1))
		fi
		if [ $MIR_TYPE_NUM -eq 4 ] && [ $SEG_PER_HOST -ge $HOSTCOUNT ];then
			MIRROR_MOVE=2
			#Now identify how many current array mirror segment we need to move
			((MOVE_HOST_MIRROR_COUNT=$SEG_PER_HOST-$HOSTCOUNT+1))
		fi
		#Have only one host, which is mirrored
		if [ $NUM_HOSTS -eq 1 ] && [ $MIR_TYPE_NUM -eq 1 ];then
			MIRROR_MOVE=3
		fi
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

CHK_TEMPLATE_DB () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	KEEP_TEMPLATE=0
	LOG_MSG "[INFO]:-Checking to see if $DEFAULTDB has any user defined tables with data, please wait..." 1
	SCHEMA_ARRAY=(`${EXPORT_LIB_PATH};$PSQL -A -t -F"|" -p $MASTER_PORT $DEFAULTDB -c "select oid, nspname from pg_namespace where nspname not in ('information_schema', 'pg_catalog', 'pg_toast', 'pg_temp_1');"`)
	ERROR_CHK $? "obtained schema data for $DEFAULTDB" 2
	for SCHEMA_ITEM in ${SCHEMA_ARRAY[@]}
	do
		S_OID=`$ECHO $SCHEMA_ITEM|$CUT -d"|" -f1`
		S_NAME=`$ECHO $SCHEMA_ITEM|$CUT -d"|" -f2`
		LOG_MSG "[INFO]:-Processing schema $S_NAME" 1
		TABLE_ARRAY=(`${EXPORT_LIB_PATH};$PSQL -A -t -F"|" -p $MASTER_PORT $DEFAULTDB -c "select relname from pg_class where relnamespace=$S_OID and relkind='r';"`)
		ERROR_CHK $? "obtain table list for schema $S_NAME" 2
		LOG_MSG "[INFO]:-Processing user tables in schema $S_NAME, please wait .." 1
		for TABLE_NAME in ${TABLE_ARRAY[@]}
		do
			PG_SIZE=`$EXPORT_LIB_PATH;$PSQL -A -t -p $MASTER_PORT $DEFAULTDB -c"select ${PG_SIZE_FUNC}('${S_NAME}.${TABLE_NAME}');"|$AWK '{print $1}'`
			ERROR_CHK $? "get $PG_SIZE_FUNC size for table $TABLE_NAME" 2
			if [ $PG_SIZE -ne 0 ];then
				KEEP_TEMPLATE=1
			fi
		done
	done
	if [ $KEEP_TEMPLATE -eq 0 ];then
		#There are no tables with data to process in template1 database
		NEW_DB_ARRAY=(`$ECHO ${DB_ARRAY[@]}|$TR ' ' '\n'|$GREP -v "$DEFAULTDB$"|$TR '\n' ' '`)
		DB_ARRAY=(${NEW_DB_ARRAY[@]})
		LOG_MSG "[INFO]:-Database $DEFAULTDB does not contain any tables with data, have removed from list to process" 1
	else
		LOG_MSG "[INFO]:-Database $DEFAULTDB contains user tables with data, will process" 1
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

GET_PARAM () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	MASTER_OS_TYPE=$OS_TYPE
	LOG_MSG "[INFO]:-Master instance host OS          = $MASTER_OS_TYPE" 1
	MASTER_ARCH_TYPE=`$HOST_ARCH_TYPE`
	LOG_MSG "[INFO]:-Master host architecture         = $MASTER_ARCH_TYPE"  1
	MASTER_INITDB_VERSION=`$INITDB -V`
	LOG_MSG "[INFO]:-Master instance initdb version   = $MASTER_INITDB_VERSION" 1
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}
	
CHK_CONNECTIONS () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Checking number of connections to GPDB database" 1
	CUR_CONNECT=`${EXPORT_LIB_PATH};$PSQL -q -p $MASTER_PORT $QD_DBNAME -R" " -A -t -c"select count(*) from $ACTIVITY_TABLE where procpid != pg_backend_pid();"`
	EXPAND_ERROR_CHK $? "obtain number of connections to database" 2
	if [ $CUR_CONNECT -ne 0 ];then
		CLEAR_FILES
		LOG_MSG "[FATAL]:-Identified $CUR_CONNECT connections to GPDB database" 1	
		ERROR_EXIT "[FATAL]:-Unable to continue processing, remove all connections and re-run this utility" 2
	else
		LOG_MSG "[INFO]:-Identified $CUR_CONNECT connections to GPDB database, can continue expansion process" 1
		LOG_MSG "[INFO]:-Commencing lock of external database access" 1
		$MV ${MASTER_DATA_DIRECTORY}/$PG_HBA ${MASTER_DATA_DIRECTORY}/${PG_HBA}_expand_secure
		$CAT ${MASTER_DATA_DIRECTORY}/${PG_HBA}_expand_secure|$GREP $GPDB_ID|$GREP local > ${MASTER_DATA_DIRECTORY}/$PG_HBA
		BACKOUT_COMMAND "if [ -f ${MASTER_DATA_DIRECTORY}/${PG_HBA}_expand_secure ];then $MV ${MASTER_DATA_DIRECTORY}/${PG_HBA}_expand_secure ${MASTER_DATA_DIRECTORY}/$PG_HBA;fi"
	fi	
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

CHK_FOR_DB_DUMP () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Checking for current database backup set, please wait..." 1
	#Here make the assumption that will just need to check the master for dump files
	CHK_DIR ${MASTER_DATA_DIRECTORY}/$DUMP_SUB_DIR/$CUR_DATE
	if [ $EXISTS -ne 0 ];then 
		WARN_DUMP=1
	else
		#Have a current dump directory, check if we have database dumps for the user databases
		for DB in ${DB_ARRAY[@]}
		do
			for I in `ls ${MASTER_DATA_DIRECTORY}/$DUMP_SUB_DIR/$CUR_DATE/${DUMP_CHK_FILE_PREFIX}*`
			do
				if [ `$GREP -c "CREATE DATABASE $DB" $I` -eq 0 ];then
					LOG_MSG "[WARN]:-Could not locate a catalog dump file for database $DB in file $I" 
				else
					LOG_MSG "[INFO]:-Located catalog dump file for database $DB" 1
					DB_DUMP_FOUND=(${DB_DUMP_FOUND[@]} ${DB}:FOUND)
				fi
			done	
		done
	fi
	for DB in ${DB_ARRAY[@]}
	do
		if [ `$ECHO ${DB_DUMP_FOUND[@]}|$TR ' ' '\n'|$GREP -c $DB` -eq 0 ];then
			LOG_MSG "[WARN]:-No database dump file located for $DB" 1
			WARN_DUMP=1
		fi
	done
	if [ $FORCE_NO_BACKUP -eq 0 ] && [ $WARN_DUMP -eq 1 ];then
		CLEAR_FILES
		LOG_MSG "[FATAL]:-Missing database dump files for $CUR_DATE and -b option not supplied" 1
		LOG_MSG "[INFO]:-Either run a database dump for all user databases [preferred]" 1
		LOG_MSG "[INFO]:-or, force expansion without recent dump files with -b option" 1
		ERROR_EXIT "[FATAL]:-Unable to continue" 2
	fi
	if [ $FORCE_NO_BACKUP -eq 1 ] && [ $WARN_DUMP -eq 1 ];then
		LOG_MSG "[WARN]:-No database dump files located for $CUR_DATE, -b option supplied" 1
		LOG_MSG "[WARN]:-Will continue with expansion without dump files for $CUR_DATE" 1
		EXIT_STATUS=1
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

CHK_HOSTS () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	M_HOST_ARRAY_PRIMARY=()
	M_HOST_ARRAY_MIRROR=()
	LOG_MSG "[INFO]:-Commencing checks of new hosts, please wait..." 1
	if [ $SEP_COUNT -eq 2 ];then
		#Mirrors on separate hosts, add these to the list of systems to be checked
		HOST_LIST=("${NEW_PRIMARY_HOST_LIST[@]}" "${NEW_MIRROR_HOST_LIST[@]}")
	else
		HOST_LIST=("${NEW_PRIMARY_HOST_LIST[@]}")
		DIR_PREFIX_ARRAY=("${PRIMARY_DIR_BASE[@]}" "${MIRROR_DATA_DIRECTORY[@]}")
	fi
	BATCH_LIMIT=${#HOST_LIST[@]}
	if [ $BATCH_DEFAULT -gt $BATCH_LIMIT ];then
		RESET_BATCH_VALUE
	fi
	export MASTER_PORT
	export QD_DBNAME
	export MASTER_OS_TYPE
	export GPHOME
	export SEG_PREFIX
	export SEP_COUNT
	export MASTER_INITDB_VERSION
	export PORT_TXT
	PARALLEL_SETUP  $PARALLEL_STATUS_FILE	
	for NEW_HOST in ${HOST_LIST[@]}
	do
		if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $NOLINE_ECHO ".\c";fi
		if [ $SEP_COUNT -eq 2 ] && [ `$GREP -c $NEW_HOST $MIRROR_HOST_FILE` -eq 0 ];then
			DIR_PREFIX_ARRAY=("${PRIMARY_DIR_BASE[@]}")
		else
			DIR_PREFIX_ARRAY=("${MIRROR_DATA_DIRECTORY[@]}")
		fi
		$GPSEGEXPAND $$ 2 $INST_COUNT $LOG_FILE $PARALLEL_STATUS_FILE $NEW_HOST `$ECHO ${DIR_PREFIX_ARRAY[@]}|$TR ' ' '~'` &
		PARALLEL_COUNT $BATCH_LIMIT $BATCH_DEFAULT
	done
	if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $ECHO;fi
	PARALLEL_SUMMARY_STATUS_REPORT $PARALLEL_STATUS_FILE
	RESTORE_BATCH_VALUE
	if [ $REPORT_FAIL -ne 0 ];then
		$CAT $PARALLEL_STATUS_FILE >> $LOG_FILE
		$RM -f $PARALLEL_STATUS_FILE
		$RM -f $IS_RUNNING
		ERROR_EXIT "[FATAL]:-Check of new expand hosts failed, unable to continue" 2
	fi
	$RM -f $PARALLEL_STATUS_FILE
	LOG_MSG "[INFO]:-Processing IP addresses" 1
	for NEW_HOST in ${HOST_LIST[@]}
	do
		IP_ADDRESSES=(`$TRUSTED_SHELL $NEW_HOST "$IFCONFIG $IFCONFIG_TXT |$GREP \"inet \"|$GREP -v \"127.0.0\"|$AWK '{print \\$2}'|$CUT -d: -f2|$TR '\n' ' '"`)
		EXPAND_ERROR_CHK $? "obtain IP addresses of $NEW_HOST" 2
		NEW_IP_ARRAY=(${NEW_IP_ARRAY[@]} ${IP_ADDRESSES[@]})
		if [ `$TRUSTED_SHELL $NEW_HOST "$GREP $NEW_HOST $HOSTFILE|$GREP -c localhost"` -ne 0 ];then
			LOG_MSG "[WARN]:-----------------------------------------------------------" 1
			LOG_MSG "[WARN]:-Host $NEW_HOST is assigned as localhost in $HOSTFILE" 1
			LOG_MSG "[WARN]:-This will cause segment->master communication failures" 1
			LOG_MSG "[WARN]:-Remove $NEW_HOST from local host line in /etc/hosts" 1
			CLEAR_FILES
			ERROR_EXIT "[FATAL]:-Unable to continue" 2
		fi
		SEG_HOSTNAME=`$TRUSTED_SHELL $NEW_HOST "$HOSTNAME"`
		EXPAND_ERROR_CHK $? "obtain hostname on $NEW_HOST" 2
		if [ $SEP_COUNT -eq 2 ] && [ `$GREP -c "$NEW_HOST$" $MIRROR_HOST_FILE` -eq 0 ];then
			#This is a primary host
			M_HOST_ARRAY_PRIMARY=(${M_HOST_ARRAY_PRIMARY[@]} ${NEW_HOST}:$SEG_HOSTNAME)
		fi
		if [ $SEP_COUNT -eq 2 ] && [ `$GREP -c "$NEW_HOST$" $MIRROR_HOST_FILE` -eq 1 ];then
			#This is a mirror host
			M_HOST_ARRAY_MIRROR=(${M_HOST_ARRAY_MIRROR[@]} ${NEW_HOST}:$SEG_HOSTNAME)
		fi
		if [ $SEP_COUNT -ne 2 ];then
			M_HOST_ARRAY_PRIMARY=(${M_HOST_ARRAY_PRIMARY[@]} ${NEW_HOST}:$SEG_HOSTNAME)
		fi
	done
	#Now check to see if there is a mismatch between current array multi-home type and the new hostnames supplied
	NEW_SEG_HOST_COUNT=`$ECHO ${M_HOST_ARRAY_PRIMARY[@]}|$TR ' ' '\n'|$AWK -F":" '{print $1}'|$SORT -u|wc -l`
	NEW_REMOTE_HOST_COUNT=`$ECHO ${M_HOST_ARRAY_PRIMARY[@]}|$TR ' ' '\n'|$AWK -F":" '{print $2}'|$SORT -u|wc -l`
	if [ $NEW_SEG_HOST_COUNT -eq $NEW_REMOTE_HOST_COUNT ];then
		NEW_MULTI_HOME=0
		NEW_MULTI_TXT="Standard"
	else
		NEW_MULTI_HOME=1
		NEW_MULTI_TXT="Multi-home"
	fi
	TYPE_CHK $NEW_MULTI_HOME $NEW_MULTI_TXT Primary
	if [ $SEP_COUNT -eq 2 ];then
		NEW_MIR_SEG_HOST_COUNT=`$ECHO ${M_HOST_ARRAY_MIRROR[@]}|$TR ' ' '\n'|$AWK -F":" '{print $1}'|$SORT -u|wc -l`
		NEW_MIR_REMOTE_HOST_COUNT=`$ECHO ${M_HOST_ARRAY_MIRROR[@]}|$TR ' ' '\n'|$AWK -F":" '{print $2}'|$SORT -u|wc -l`
		if [ $NEW_MIR_SEG_HOST_COUNT -eq $NEW_MIR_REMOTE_HOST_COUNT ];then
			NEW_MIR_MULTI_HOME=0
			NEW_MIR_MULTI_TXT="Standard"
		else
			NEW_MIR_MULTI_HOME=1
			NEW_MIR_MULTI_TXT="Multi-home"
		fi
		TYPE_CHK $NEW_MIR_MULTI_HOME $NEW_MIR_MULTI_TXT Mirror
	fi	
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

TYPE_CHK () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	if [ $1 -ne $MULTI_HOME ];then
		LOG_MSG "[FATAL]:-Current GPDB array is type $MULTI_TXT, new $3 hosts are type $2" 1
		LOG_MSG "[INFO]:-Adjust hostnames to match current GPDB array type of $MULTI_TXT" 1
		CLEAR_FILES
		ERROR_EXIT "[FATAL]:-Unable to continue" 2
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

CHK_SEG_SPACE () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Checking current space allocated to user databases, please wait..." 1
	MAX_SIZE=0
	SPACE_WARN=0
	FREE_SPACE_TOTAL=0
	for DB in ${DB_ARRAY[@]}
	do
		LOG_MSG "[INFO]:-Checking space allocated for database $DB" 1
		DB_FULL_SIZE=`$GPSIZECALC -x $DB -q|$TAIL -1|$AWK -F"." '{print $1}'`
		TOTAL_SIZE_ARRAY=(${TOTAL_SIZE_ARRAY[@]} "${DB}:${DB_FULL_SIZE}")
		((FREE_SPACE_TOTAL=$FREE_SPACE_TOTAL+$DB_FULL_SIZE))
		if [ $DB_FULL_SIZE -gt $MAX_SIZE ];then
			MAX_SIZE=$DB_FULL_SIZE
			MAX_SIZE_DB=$DB
		fi
		LOG_MSG "[INFO]:-Database $DB has total space allocated of $DB_FULL_SIZE KBytes" 1
	done
	((MIN_SPACE_PER_SEG=$FREE_SPACE_TOTAL/$TOTAL_SEG))
	LOG_MSG "[INFO]:-The largest space allocated is $MAX_SIZE KBytes for database $DB" 1
	LOG_MSG "[INFO]:-Total space allocated to all databases is $FREE_SPACE_TOTAL KBytes" 1
	LOG_MSG "[INFO]:-Minimum space required per segment directory = $MIN_SPACE_PER_SEG KBytes" 1
	DIR_CHK_ARRAY=(${PRIMARY_DIR_BASE[@]} ${MIRROR_DATA_DIRECTORY[@]})
	LOG_MSG "[INFO]:-Checking available space on current GPDB array hosts, please wait..." 1
	for HOST in ${SEG_HOSTNAME_LIST[@]}
	do
		if [ $SEP_COUNT -eq 2 ] && [ `$ECHO ${SEP_MIR_HOSTS[@]}|$GREP -c $HOST` -eq 0 ];then
			#Separate mirror hosts and this is a primary segment host
			DIR_CHK_ARRAY=("${PRIMARY_DIR_BASE[@]}")
		elif [ $SEP_COUNT -eq 2 ];then
			#Separate mirror hosts and this is a mirror segment host
			DIR_CHK_ARRAY=("${MIRROR_DATA_DIRECTORY[@]}")
		else
			#Shared array
			DIR_CHK_ARRAY=(${PRIMARY_DIR_BASE[@]} ${MIRROR_DATA_DIRECTORY[@]})
		fi
		for DIR in ${DIR_CHK_ARRAY[@]}
		do
			LOG_MSG "[INFO]:-Obtaining disk utilization for $DIR on $HOST" 
			if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $NOLINE_ECHO ".\c";fi
			SEGMENT_SPACE=`$TRUSTED_SHELL $HOST "$DF -k $DIR"|$TAIL -1|$AWK '{print $1":"$4":"$6":"$2}'`
			ACTUAL_SPACE_ARRAY=(${ACTUAL_SPACE_ARRAY[@]} ${HOST}:$SEGMENT_SPACE)
		done
		SEP_PARTITION_COUNT_ARRAY=(${SEP_PARTITION_COUNT_ARRAY[@]} `$ECHO ${ACTUAL_SPACE_ARRAY[@]}|$TR ' ' '\n'|$AWK '{print $1}'|$SORT -u|$WC -l`)
	done
	if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $ECHO;fi
	MIN_SEP=`$ECHO ${SEP_PARTITION_COUNT_ARRAY[@]}|$TR ' ' '\n'|$SORT -n |$HEAD -1`
	if [ $SEP_COUNT -eq 2 ];then
		((ALL_SEG_PER_HOST=$SEG_PER_HOST))
	else
		((ALL_SEG_PER_HOST=$SEG_PER_HOST*2))
	fi
	if [ $MIN_SEP -ne $ALL_SEG_PER_HOST ];then
		LOG_MSG "[INFO]:-Re-configuring disk allocation for shared partitions" 1
	fi	
	((INCREASE_FACTOR=$ALL_SEG_PER_HOST/$MIN_SEP))
	((SPACE_NEEDED=$MIN_SPACE_PER_SEG*$INCREASE_FACTOR))
	LOG_MSG "[INFO]:-Processing space utilization data, please wait..." 1
	for SPACE_USED in ${ACTUAL_SPACE_ARRAY[@]}
	do
		HOST=`$ECHO $SPACE_USED|$CUT -d":" -f1`
		PARTITION=`$ECHO $SPACE_USED|$CUT -d":" -f2`
		FREE_KB=`$ECHO $SPACE_USED|$CUT -d":" -f3`
		SEG_NAME=`$ECHO $SPACE_USED|$CUT -d":" -f4`
		if [ $SPACE_NEEDED -gt $FREE_KB ] && [ $SINGLE_STEP -ne 1 ];then
			CLEAR_FILES
			LOG_MSG "[FATAL]:-Host $HOST partition $PARTITION segment $SEGNAME has insufficient free space" 1
			LOG_MSG "[FATAL]:-Use -f option to force single step table data transfer" 1
			ERROR_EXIT "[FATAL]:-Unable to continue" 2
		else
			if [ $SPACE_NEEDED -gt $FREE_KB ];then
				((SPACE_WARN=$SPACE_WARN+1))		
			else
				LOG_MSG "[INFO]:-Host $HOST $PARTITION free = $FREE_KB KB needed = $SPACE_NEEDED KB"
			fi
		fi
	done
	LOG_MSG "[INFO]:-Checking new hosts directory sizing, please wait..." 1
	SIZE_CHK_ARRAY=(`$ECHO ${ACTUAL_SPACE_ARRAY[@]}|$TR ' ' '\n'|$CUT -d":" -f4,5|$SORT -t":" -k1 -u|$TR '\n' ' '`)
	if [ $SEP_COUNT -eq 2 ];then
		#Mirrors are on separate hosts, so add these to the list to be checked
		HOST_LIST=("${NEW_PRIMARY_HOST_LIST[@]}" "${NEW_MIRROR_HOST_LIST[@]}")
	else
		HOST_LIST=("${NEW_PRIMARY_HOST_LIST[@]}")
	fi
	for HOST in "${HOST_LIST[@]}"
	do
		if [ $SEP_COUNT -eq 2 ] && [ `$GREP -c $NEW_HOST $MIRROR_HOST_FILE` -eq 0 ];then
			#Primary segment host
			DIR_PREFIX_ARRAY=("${PRIMARY_DIR_BASE[@]}")
		elif [ $SEP_COUNT -eq 2 ];then
			#Mirror segment host
			DIR_PREFIX_ARRAY=(${MIRROR_DATA_DIRECTORY[@]})
		else
			#Shared
			IR_PREFIX_ARRAY=("${PRIMARY_DIR_BASE[@]}" "${MIRROR_DATA_DIRECTORY[@]}")
		fi
		SIZE_VECTOR=0
		for DIR in "${DIR_PREFIX_ARRAY[@]}"
		do
			if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $NOLINE_ECHO ".\c";fi
			ACTUAL_SPACE=`$TRUSTED_SHELL $HOST "$DF -k $DIR"|$TAIL -1|$AWK '{print $1":"$4":"$6":"$2}'`
			SIZE=`$ECHO $ACTUAL_SPACE|$CUT -d":" -f4`
			SEG_NAME=`$ECHO $ACTUAL_SPACE|$CUT -d":" -f3`
			FREE_KB=`$ECHO $ACTUAL_SPACE|$CUT -d":" -f2`
			PARTITION=`$ECHO $ACTUAL_SPACE|$CUT -d":" -f1`
			if [ $SIZE -ne `$ECHO ${SIZE_CHK_ARRAY[@]}|$TR ' ' '\n'|$GREP $SEG_NAME|$CUT -d":" -f2` ];then
				LOG_MSG "[WARN]:-Host $HOST $PARTITION has size variation" 1
				EXIT_STATUS=1
			else
				LOG_MSG "[INFO]:-Host $HOST $PARTITION size check passed at $SIZE KB"
			fi
			if [ $SPACE_NEEDED -gt $FREE_KB ] && [ $SINGLE_STEP -ne 1 ];then
				CLEAR_FILES
				LOG_MSG "[FATAL]:-Host $HOST partition $PARTITION segment $SEGNAME has insufficient free space" 1
				LOG_MSG "[FATAL]:-Use -f option to force single step table data transfer" 1
				ERROR_EXIT "[FATAL]:-Unable to continue" 2
			else
				if [ $SPACE_NEEDED -gt $FREE_KB ];then
					((SPACE_WARN=$SPACE_WARN+1))
				else
					LOG_MSG "[INFO]:-Host $HOST $PARTITION free = $FREE_KB KB needed = $SPACE_NEEDED KB"
				fi
			fi
		done
	done
	if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $ECHO;fi
	if [ $SPACE_WARN -eq 0 ];then
		LOG_MSG "[INFO]:-Sufficient space, will use single database data transfer mode" 1
	else
		if [ $KEEP_ONLINE -eq 1 ];then
			CLEAR_FILES
			ERROR_EXIT "[FATAL]:-Insufficient space to be able to keep all schemas online" 2
		fi
		LOG_MSG "[WARN]:-Insufficient space, will use single step table data transfer mode" 1
		EXIT_STATUS=1
	fi

	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

BUILD_NEW_HOST_ARRAY () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Building array for new hosts, please wait..." 1
	LOG_MSG "[INFO]:-Building primary array, please wait..." 1
	((DBID_COUNT=$MAX_DBID+1))
	((CONTENT_COUNT=$MAX_CONTENT+1))
	((PORT_BASE=$PRIMARY_PORT_BASE-1))
	((MIRROR_PORT_BASE=$MIRROR_PORT_BASE-1))
	DATA_DIRECTORY=(${PRIMARY_DIR_BASE[@]})
	PORT_COUNT=0
	LAST_HOST=X
	SEG_DIR_VECTOR=0
	MIR_COUNT=-1
	#If single home need to add more elements to M_HOST_ARRAY_PRIMARY
	if [ $MULTI_HOME -eq 0 ];then
		I=1
		FAKE_M_HOST_ARRAY=(${M_HOST_ARRAY_PRIMARY[@]})
		while [ $I -lt $SEG_PER_HOST ]
		do
			FAKE_M_HOST_ARRAY=(${FAKE_M_HOST_ARRAY[@]} ${M_HOST_ARRAY_PRIMARY[@]})
			((I=$I+1))
		done
		M_HOST_ARRAY_PRIMARY=(`$ECHO ${FAKE_M_HOST_ARRAY[@]}|$TR ' ' '\n'|$SORT |$TR '\n' ' '`)
		I=1
		FAKE_M_HOST_ARRAY=(${M_HOST_ARRAY_MIRROR[@]})
		while [ $I -lt $SEG_PER_HOST ]
		do
			FAKE_M_HOST_ARRAY=(${FAKE_M_HOST_ARRAY[@]} ${M_HOST_ARRAY_MIRROR[@]})
			((I=$I+1))
		done
		M_HOST_ARRAY_MIRROR=(`$ECHO ${FAKE_M_HOST_ARRAY[@]}|$TR ' ' '\n'|$SORT |$TR '\n' ' '`)
	fi
	for QE_PAIR in ${M_HOST_ARRAY_PRIMARY[@]}
	do
		if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $NOLINE_ECHO ".\c";fi
		QE_NAME=`$ECHO $QE_PAIR|$AWK -F":" '{print $1}'`
		QE_HOST=`$ECHO $QE_PAIR|$AWK -F":" '{print $2}'`
		if [ $LAST_HOST == $QE_HOST ];then
			((PORT_COUNT=$PORT_COUNT+1))
		else
			SEG_DIR_VECTOR=0;PORT_COUNT=1
		fi
		((GP_PORT=$PORT_BASE+$PORT_COUNT))	
		GP_DIR=${DATA_DIRECTORY[$SEG_DIR_VECTOR]}
		QE_PRIMARY_ARRAY=(${QE_PRIMARY_ARRAY[@]} ${QE_NAME}:${GP_PORT}:${GP_DIR}/${SEG_PREFIX}${CONTENT_COUNT}:${DBID_COUNT}:${CONTENT_COUNT}:t:t:t:${QE_HOST})
		((DBID_COUNT=$DBID_COUNT+1))
		((CONTENT_COUNT=$CONTENT_COUNT+1))
		((SEG_DIR_VECTOR=$SEG_DIR_VECTOR+1))
		LAST_HOST=$QE_HOST
	done
	if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $ECHO;fi
	#Now build the mirror array
	((MIRROR_OFFSET=$MIRROR_PORT_BASE-$PORT_BASE))
	case $MIR_TYPE_NUM in
		1|3 ) CREATE_GROUP_MIRROR ;;
		2|4 ) CREATE_SPREAD_MIRROR ;;
	esac
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

CREATE_GROUP_MIRROR () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Building group mirror array, please wait..." 1
	DIR_VECTOR=0
	NUM_DATADIR=$SEG_PER_HOST
	QE_CHOICE_ARRAY=(${QE_PRIMARY_ARRAY[@]} ${QE_PRIMARY_ARRAY[@]})
	QE_CHOICE_HOSTS=(${M_HOST_ARRAY_PRIMARY[@]} ${M_HOST_ARRAY_PRIMARY[@]})
	QE_CHOICE_SEP_HOSTS=(${M_HOST_ARRAY_MIRROR[@]} ${M_HOST_ARRAY_MIRROR[@]})
	SEG_PROCESSED=0
	for QE_LINE in ${QE_PRIMARY_ARRAY[@]}
	do
		if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $NOLINE_ECHO ".\c";fi
		((VECTOR=$NUM_DATADIR+$SEG_PROCESSED))
		PRI_HOSTNAME=`$ECHO ${QE_CHOICE_HOSTS[$SEG_PROCESSED]}|$AWK -F":" '{print $2}'`
		NEW_QE_PRI_NAME=`$ECHO $QE_LINE|$CUT -d":" -f1`
		if [ $SEP_COUNT -ne 2 ];then
			MIR_HOSTNAME=`$ECHO ${QE_CHOICE_HOSTS[$VECTOR]}|$AWK -F":" '{print $2}'`
			QE_M_NAME=`$ECHO ${QE_CHOICE_ARRAY[$VECTOR]}|$AWK -F":" '{print $1}'`
		else
			MIR_HOSTNAME=`$ECHO ${QE_CHOICE_SEP_HOSTS[$SEG_PROCESSED]}|$AWK -F":" '{print $2}'`
			QE_M_NAME=`$ECHO ${QE_CHOICE_SEP_HOSTS[$SEG_PROCESSED]}|$AWK -F":" '{print $1}'`
		fi
		QEP_PORT=`$ECHO $QE_LINE|$AWK 'BEGIN {FS=":"} {print $2}'`
		((QE_PORT=$QEP_PORT+$MIRROR_OFFSET))
		if [ $PRI_HOSTNAME == $MIR_HOSTNAME ];then
			#Select an active mirror segment to move at a later stage in processing
			MOVE_DATA=`$EXPORT_LIB_PATH;$PSQL -q -p $MASTER_PORT $QD_DBNAME -F":" -A -t -c"select hostname, port, datadir, dbid, content from $CONFIG_TABLE where definedprimary='f'  and port=${QE_PORT} and dbid in (select min(dbid) from $CONFIG_TABLE where definedprimary='f' and port=${QE_PORT} and content<>-1);"`
			MOVE_DATA="${MOVE_DATA}:$NEW_QE_PRI_NAME"
			MOVE_MIRROR_ARRAY=(${MOVE_MIRROR_ARRAY[@]} $MOVE_DATA)
			QE_M_NAME=`$ECHO $MOVE_DATA|$CUT -d":" -f1`
			if [ $? -ne 0 ];then
				CLEAR_FILES
				ERROR_EXIT "[FATAL]:-Failed to select mirror relocation host" 2
			fi
		fi
		QEP_DIR=`$ECHO $QE_LINE|$AWK 'BEGIN {FS=":"} {print $3}'`
		QE_SEG=`$BASENAME $QEP_DIR`
		QE_DIR="${MIRROR_DATA_DIRECTORY[$DIR_VECTOR]}/$QE_SEG"
		QE_DBID=$DBID_COUNT
		QE_CONTENT=`$ECHO $QE_LINE|$AWK 'BEGIN {FS=":"} {print $5}'`
		QE_MIRROR_ARRAY=(${QE_MIRROR_ARRAY[@]} ${QE_M_NAME}:${QE_PORT}:${QE_DIR}:${QE_DBID}:${QE_CONTENT}:f:f:t)
		((DBID_COUNT=$DBID_COUNT+1))
		((DIR_VECTOR=$DIR_VECTOR+1))
		((SEG_PROCESSED=$SEG_PROCESSED+1))
		if [ $DIR_VECTOR -eq ${#MIRROR_DATA_DIRECTORY[@]} ];then
			DIR_VECTOR=0
		fi
	done
	if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $ECHO;fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

CREATE_SPREAD_MIRROR () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Building spread mirror array, please wait..." 1
	USED_VECTOR=0
	USED_MIRROR_LIST=()
	USED_PRIMARY_LIST=()
	USED_DIR_LIST=()
	NUM_DATADIR=$SEG_PER_HOST
	((MAX_ARRAY=${#QE_PRIMARY_ARRAY[@]}-1))
	SEG_OFFSET=0
	LOOP=1
	SEG_PROCESSED=0
	DIR_VECTOR=0
	if [ $SEP_COUNT -eq 2 ];then
		#Dealing with separate hosts
		#1. Change QE_CHOICE_HOSTS
		QE_CHOICE_HOSTS=(${M_HOST_ARRAY_MIRROR[@]} ${M_HOST_ARRAY_MIRROR[@]})
		#2. Overload the QE_CHOICE_ARRAY
		QE_MIRROR_ARRAY=(${QE_PRIMARY_ARRAY[@]})
		VECTOR=0
		for QE_LINE in ${QE_MIRROR_ARRAY[@]}
		do
			QE_NAME=`$ECHO ${QE_CHOICE_HOSTS[$VECTOR]}|$AWK -F":" '{print $1}'`
			LINE=`$ECHO $QE_LINE|$AWK -F":" '{print $2":"$3":"$4":"$5}'`
			QE_NEW_ARRAY[$VECTOR]="${QE_NAME}:$LINE"
			QE_MIRROR_ARRAY[$VECTOR]=""
			((VECTOR=$VECTOR+1))
		done
		QE_SAVED=(${QE_PRIMARY_ARRAY[@]})
		QE_PRIMARY_ARRAY=(${QE_NEW_ARRAY[@]})
		QE_CHOICE_ARRAY=(${QE_PRIMARY_ARRAY[@]} ${QE_PRIMARY_ARRAY[@]})
	else
		QE_CHOICE_ARRAY=(${QE_PRIMARY_ARRAY[@]})
		QE_CHOICE_HOSTS=(${M_HOST_ARRAY_PRIMARY[@]})
	fi
	for QE_LINE in ${QE_PRIMARY_ARRAY[@]}
	do
		if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $NOLINE_ECHO ".\c";fi
		GP_PRI_HOSTNAME=`$ECHO $QE_LINE|$AWK -F":" '{print $1}'`	#GPDB hostname within config table
		OS_PRI_HOSTNAME=`$ECHO $QE_LINE|$AWK -F":" '{print $NF}'`	#Actual OS hostname
		P_PORT=`$ECHO $QE_LINE|$AWK -F":" '{print $2}'`
		((GP_M_PORT=$P_PORT+$MIRROR_OFFSET))
		#Check to see if there is another host within this primary array that we can use
		OS_MIRROR_LIST=(`$ECHO ${QE_PRIMARY_ARRAY[@]}|$TR ' ' '\n'|$GREP ":${P_PORT}:"|$GREP -v ":${OS_PRI_HOSTNAME}"|$AWK -F":" '{print$1":"$NF}'|$TR '\n' ' '`)
		#Now make sure name does not appear in the used list
		V=0
		AVAILABLE_OS_MIRROR_LIST=""
		COPY_OS_MIRROR_LIST=${OS_MIRROR_LIST[@]}
		for MIR_CHK in ${COPY_OS_MIRROR_LIST[@]}
		do
			MIR_OS_NAME=`$ECHO $MIR_CHK|$AWK -F":" '{print $2}'`
			if [ `$ECHO ${NEW_HOST_MIRROR_LIST[@]}|$TR ' ' '\n'|$GREP -c "${OS_PRI_HOSTNAME}:${MIR_OS_NAME}"` -ne 0 ];then
				OS_MIRROR_LIST[$V]=""
			else
				AVAILABLE_OS_MIRROR_LIST=$MIR_CHK
				NEW_HOST_MIRROR_LIST=(${NEW_HOST_MIRROR_LIST[@]} "${OS_PRI_HOSTNAME}:${MIR_OS_NAME}")
				break
			fi
			((V=$V+1))
		done
		if [ x"" != x"${AVAILABLE_OS_MIRROR_LIST}" ];then
			#Have a new host which can act as a mirror for this primary
			QE_M_NAME=`$ECHO ${AVAILABLE_OS_MIRROR_LIST[0]}|$AWK -F":" '{print $1}'` 
			OS_MIR_HOSTNAME=`$ECHO ${AVAILABLE_OS_MIRROR_LIST[0]}|$AWK -F":" '{print $NF}'`
		else
			#Now select a suitable active mirror that will be relocated to make way for this mirror
			MOVE_LIST=(`$EXPORT_LIB_PATH;$PSQL -q -p $MASTER_PORT $QD_DBNAME -F":" -A -t -c"select hostname from $CONFIG_TABLE where port=${GP_M_PORT} and definedprimary='f' and content<>-1 order by dbid;"`)
			#Now make sure that the primary for this mirror has not been used before
			MOVE_LIST_COPY=${MOVE_LIST[@]}
			for CHK_HOST in ${MOVE_LIST_COPY[@]}
			do
				PRI_HOST=`$EXPORT_LIB_PATH;$PSQL -q -p $MASTER_PORT $QD_DBNAME -F":" -A -t -c"select hostname from $CONFIG_TABLE where content in (select content from $CONFIG_TABLE where hostname='${CHK_HOST}' and port=${GP_M_PORT} and definedprimary='f' and content<>-1) and definedprimary='t';"`
				#Now get the actual hostname for this segment
				CHK_PRI_HOST=`$TRUSTED_SHELL $PRI_HOST "$HOSTNAME"|$AWK '{print $1}'`	
				if [ `$ECHO ${USED_PRIMARY_LIST[@]}|$TR ' ' '\n'|$GREP -c $CHK_PRI_HOST` -eq 0 ];then
					#We can use this as host
					QE_M_NAME=$CHK_HOST
					break
				else
					CHK_ARRAY=(`$ECHO ${MOVE_LIST[@]}|$TR ' ' '\n'|$GREP -v $CHK_HOST|$TR '\n' ' '`)
					MOVE_LIST=(${CHK_ARRAY[@]})
				fi
			done
			MOVE_LIST_COPY=${MOVE_LIST[@]}
			for CHK_HOST in ${MOVE_LIST_COPY[@]}
			do
				CHK_MIR_HOST=`$TRUSTED_SHELL $CHK_HOST "$HOSTNAME"`
				CHK_PRI_HOST=`$TRUSTED_SHELL $PRI_HOST "$HOSTNAME"|$AWK '{print $1}'`	
				
				if [ `$ECHO ${USED_MIRROR_LIST[@]}|$TR ' ' '\n'|$GREP -c $CHK_MIR_HOST` -ne 0 ];then
					CHK_ARRAY=(`$ECHO ${MOVE_LIST[@]}|$TR ' ' '\n'|$GREP -v $CHK_HOST|$TR '\n' ' '`)
					MOVE_LIST=(${CHK_ARRAY[@]})
				fi
				#Now get the datadir which will be moved
				DATADIR_MOVE=`$EXPORT_LIB_PATH;$PSQL -q -p $MASTER_PORT $QD_DBNAME -F":" -A -t -c"select datadir from $CONFIG_TABLE where port=${GP_M_PORT} and hostname='${CHK_HOST}' and definedprimary='f';"`
				if [ `$ECHO ${USED_DIR_LIST[@]}|$TR ' ' '\n'|$GREP -c $DATADIR_MOVE` -ne 0 ];then
					CHK_ARRAY=(`$ECHO ${MOVE_LIST[@]}|$TR ' ' '\n'|$GREP -v $CHK_HOST|$TR '\n' ' '`)
					MOVE_LIST=(${CHK_ARRAY[@]})
				fi
			done
			QE_M_NAME=${MOVE_LIST[0]}
			MOVE_DATA=`$EXPORT_LIB_PATH;$PSQL -q -p $MASTER_PORT $QD_DBNAME -F":" -A -t -c"select hostname, port, datadir, dbid, content from $CONFIG_TABLE where definedprimary='f'  and port=${GP_M_PORT} and hostname='$QE_M_NAME';"`
			USED_DIR=`$ECHO $MOVE_DATA|$AWK -F":"  '{print $3}'`
			MOVE_DATA=${MOVE_DATA}:$GP_PRI_HOSTNAME
			MOVE_MIRROR_ARRAY=(${MOVE_MIRROR_ARRAY[@]} $MOVE_DATA)
			OS_MIR_HOSTNAME=`$TRUSTED_SHELL $QE_M_NAME "$HOSTNAME"|$AWK '{print $1}'`
			USED_MIRROR_LIST=(${USED_MIRROR_LIST[@]} $OS_MIR_HOSTNAME)
			#Now we have reached this stage, can add the primary hostname to the used list
			PRI_HOST=`$EXPORT_LIB_PATH;$PSQL -q -p $MASTER_PORT $QD_DBNAME -F":" -A -t -c"select hostname from $CONFIG_TABLE where content in (select content from $CONFIG_TABLE where hostname='${QE_M_NAME}' and port=${GP_M_PORT} and definedprimary='f' and content<>-1) and definedprimary='t';"`
			CHK_PRI_HOST=`$TRUSTED_SHELL $PRI_HOST "$HOSTNAME"|$AWK '{print $1}'`	
			USED_PRIMARY_LIST=(${USED_PRIMARY_LIST[@]} $CHK_PRI_HOST)
			((USED_VECTOR=$USED_VECTOR+1))
		fi
		M_CONTENT=`$ECHO $QE_LINE|$AWK -F":" '{print $5}'`
		M_SEG=`$ECHO $QE_LINE|$AWK -F":" '{print $3}'|$AWK -F"/" '{print $NF}'`
		GP_M_DIR=${MIRROR_DATA_DIRECTORY[$DIR_VECTOR]}
		QE_MIRROR_ARRAY=(${QE_MIRROR_ARRAY[@]} ${QE_M_NAME}:${GP_M_PORT}:${GP_M_DIR}/${M_SEG}:${DBID_COUNT}:${M_CONTENT}:f:f:t)
		USED_DIR_LIST=(${USED_DIR_LIST[@]} $USED_DIR)
		((DBID_COUNT=$DBID_COUNT+1))
		((SEG_PROCESSED=$SEG_PROCESSED+1))
		((LOOP=$LOOP+1))
		if [ $LOOP -gt $NUM_DATADIR ];then
			LOOP=1
			USED_PRIMARY_LIST=()
			USED_MIRROR_LIST=()
		fi
		((DIR_VECTOR=$DIR_VECTOR+1))
		if [ $DIR_VECTOR -eq $NUM_DATADIR ];then
			DIR_VECTOR=0
		fi
	done
	if [ $SEP_COUNT -eq 2 ];then
		QE_PRIMARY_ARRAY=(${QE_SAVED[@]})
	fi
	if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $ECHO;fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

PROMPT_CONTINUE () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	GET_MAX_LEN
	LOG_MSG "[INFO]:--------------------------------------------" 1
	LOG_MSG "[INFO]:-GPDB Array Expansion Parameters" 1
	LOG_MSG "[INFO]:--------------------------------------------" 1
	if [ $MULTI_HOME -ne 0 ];then
		H_TEXT="Multi-home"
	else
		H_TEXT="Single-home"
	fi
	LOG_MSG "[INFO]:-GPDB segment interconnect type            = $H_TEXT" 1
	LOG_MSG "[INFO]:-GPDB Array name                           = $ARRAY_NAME" 1
	LOG_MSG "[INFO]:-Master segment operating system           = $MASTER_OS_TYPE" 1
	LOG_MSG "[INFO]:-Master segment architecture               = $MASTER_ARCH_TYPE" 1
	LOG_MSG "[INFO]:-Master initdb version                     = `$ECHO $MASTER_INITDB_VERSION|$AWK '{print $NF}'`" 1
	LOG_MSG "[INFO]:-User database list to be processed        = `$ECHO ${DB_ARRAY[@]}|$TR '\n' ' '`" 1
	LOG_MSG "[INFO]:-Database server encoding                  = $ENCODING" 1
	LOG_MSG "[INFO]:-Database locale                           = $LOCALE" 1
	LOG_MSG "[INFO]:-GPDB segment prefix                       = $SEG_PREFIX" 1
	LOG_MSG "[INFO]:-Parallel insert batch count               = $COPY_BATCH_DEFAULT" 1
	LOG_MSG "[INFO]:-Segment instances per host                = $NUM_DATADIR" 1
	LOG_MSG "[INFO]:-Primary port base                         = $PORT_BASE" 1
	LOG_MSG "[INFO]:-Primary directories                       = `$ECHO ${PRIMARY_DIR_BASE[@]}`" 1
	LOG_MSG "[INFO]:-Mirror port base                          = $MIRROR_PORT_BASE" 1
	LOG_MSG "[INFO]:-Mirror directories                        = `$ECHO ${MIRROR_DATA_DIRECTORY[@]}`" 1
	case $MIR_TYPE_NUM in
		1|3 ) M_TEXT=Group ;;
		2|4 ) M_TEXT=Spread ;;
	esac	
	LOG_MSG "[INFO]:-Mirror configuration                      = $M_TEXT" 1
	if [ $SEP_COUNT -eq 2 ];then
		S_TEXT="Separate hosts"
	else
		S_TEXT="Shared"
	fi
	LOG_MSG "[INFO]:-Mirror type                               = $S_TEXT" 1
	if [ $RANDOM_REDISTRIB -eq 0 ];then RAN_TXT=On;else RAN_TXT=Off;fi
	LOG_MSG "[INFO]:-Re-distribute random distributed tables   = $RAN_TXT" 1
	if [ $KEEP_SCHEMA -eq 0 ];then KEEP_TXT=Off;else KEEP_TXT=On;fi
	LOG_MSG "[INFO]:-Keep temporary expand schema's            = $KEEP_TXT" 1
	if [ ${#MOVE_MIRROR_ARRAY[@]} -eq 0 ];then
	LOG_MSG "[INFO]:-Relocate current array mirrors            = Off" 1
	else
	LOG_MSG "[INFO]:--------------------------------------------" 1
	LOG_MSG "[INFO]:-Following mirror segments will be relocated" 1
	LOG_MSG "[INFO]:--------------------------------------------" 1
	HEADER=`$ECHO "Mirror:Datadir:New Host"|$AWK -F":" '{printf "%-'"${LEN_ARRAY[0]}"'s %-'"${LEN_ARRAY[2]}"'s %-'"${LEN_ARRAY[0]}"'s\n", $1, $2, $3}'`
	LOG_MSG "[INFO]:-$HEADER" 1
	for M_LINE in ${MOVE_MIRROR_ARRAY[@]}
	do
		TXT=`$ECHO $M_LINE|$AWK -F":" '{printf "%-'"${LEN_ARRAY[0]}"'s %-'"${LEN_ARRAY[2]}"'s %-'"${LEN_ARRAY[0]}"'s",$1, $3, $6}'`
		LOG_MSG "[INFO]:-$TXT" 1
	done
	fi
	LOG_MSG "[INFO]:--------------------------------------------" 1
	LOG_MSG "[INFO]:-New Primary Array" 1
	LOG_MSG "[INFO]:--------------------------------------------" 1
	HEADER=`$ECHO "Host:Datadir:Port"|$AWK -F":" '{printf "%-'"${LEN_ARRAY[0]}"'s %-'"${LEN_ARRAY[2]}"'s %-'"${LEN_ARRAY[1]}"'s\n", $1, $2, $3}'`
	LOG_MSG "[INFO]:-$HEADER" 1
	for I in ${QE_PRIMARY_ARRAY[@]}
	do
		TXT=`$ECHO $I|$AWK -F":" '{printf "%-'"${LEN_ARRAY[0]}"'s %-'"${LEN_ARRAY[2]}"'s %-'"${LEN_ARRAY[1]}"'s",$1, $3, $2}'`
		LOG_MSG "[INFO]:-$TXT" 1
	done
	LOG_MSG "[INFO]:--------------------------------------------" 1
	LOG_MSG "[INFO]:-New Mirror Array" 1
	LOG_MSG "[INFO]:--------------------------------------------" 1
	HEADER=`$ECHO "Host:Datadir:Port"|$AWK -F":" '{printf "%-'"${LEN_ARRAY[0]}"'s %-'"${LEN_ARRAY[2]}"'s %-'"${LEN_ARRAY[1]}"'s\n", $1, $2, $3}'`
	LOG_MSG "[INFO]:-$HEADER" 1
	for I in ${QE_MIRROR_ARRAY[@]}
	do
		TXT=`$ECHO $I|$AWK -F":" '{printf "%-'"${LEN_ARRAY[0]}"'s %-'"${LEN_ARRAY[2]}"'s %-'"${LEN_ARRAY[1]}"'s",$1, $3, $2}'`
		LOG_MSG "[INFO]:-$TXT" 1
	done
	LOG_MSG "[INFO]:--------------------------------------------" 1
	if [ $EXIT_STATUS -eq 0 ];then
	LOG_MSG "[INFO]:-Current utility status                    = Normal" 1
	else
	LOG_MSG "[INFO]:-Current utility status                    = Warn $WARN_MARK" 1
	fi
	if [ $SPACE_WARN -eq 0 ];then
	LOG_MSG "[INFO]:-Space warnings generated                  = No" 1
	else
	LOG_MSG "[INFO]:-Space warnings generated                  = Yes $WARN_MARK" 1
	fi	
	$ECHO "Continue with GPDB array expansion yY|nN >"
	read REPLY
	if [ -z $REPLY ]; then
		LOG_MSG "[WARN]:-User abort requested, Script Exits!" 1
		CLEAR_FILES
		exit 1
	fi
	if [ $REPLY != Y ] && [ $REPLY != y ]; then
		LOG_MSG "[WARN]:-User abort requested, Script Exits!" 1
		CLEAR_FILES
		exit 1
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

SET_VAR () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	HOST=`$ECHO $1|$CUT -d":" -f1`
	PORT=`$ECHO $1|$CUT -d":" -f2`
	DATADIR=`$ECHO $1|$CUT -d":" -f3`
	DBID=`$ECHO $1|$CUT -d":" -f4`
	CONTENT=`$ECHO $1|$CUT -d":" -f5`
	DEF_PRIMARY=`$ECHO $1|$CUT -d":" -f6`
	IS_PRIMARY=`$ECHO $1|$CUT -d":" -f7`
	VALID=`$ECHO $1|$CUT -d":" -f8`
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

CREATE_BASE_TEMPLATE_DB () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Selecting a mirror segment for base processing" 1
	MIR_INFO=`$EXPORT_LIB_PATH;$PSQL -q -p $MASTER_PORT $QD_DBNAME -F":" -A -t -c"select hostname,datadir,port from $CONFIG_TABLE where content=${MAX_CONTENT} and definedprimary='f';"`
	ERROR_CHK $? "select mirror segment for base processing" 2
	MIR_HOST=`$ECHO $MIR_INFO|$CUT -d: -f1`
	MIR_DATADIR=`$ECHO $MIR_INFO|$CUT -d: -f2`
	MIR_PORT=`$ECHO $MIR_INFO|$CUT -d: -f3`
	LOG_MSG "[INFO]:-Closing down mirror segment instance on $MIR_HOST port $MIR_PORT $MIR_DATADIR" 1
	$TRUSTED_SHELL $MIR_HOST "${EXPORT_LIB_PATH};$PG_CTL stop -D $MIR_DATADIR -m fast"
	ERROR_CHK $? "shutdown mirror segment $MIR_HOST port $MIR_PORT" 2
	$TRUSTED_SHELL $MIR_HOST "$RM -f ${MIR_DATADIR}/postmaster.pid"
	BASE_BUILD_LINE=${QE_PRIMARY_ARRAY[0]}
	SET_VAR $BASE_BUILD_LINE
	LOG_MSG "[INFO]:-Creating tempory holding directory on $HOST" 1
	BASE_DATADIR=`$DIRNAME $DATADIR`
	TMP_BASE_DIR=$BASE_DATADIR/$TMP_BASE_DIR
	$TRUSTED_SHELL $HOST "if [ ! -d $TMP_BASE_DIR ];then $MKDIR $TMP_BASE_DIR ;fi"
	ERROR_CHK $? "$MKDIR $TMP_BASE_DIR on $HOST" 2
	BACKOUT_COMMAND "$TRUSTED_SHELL $HOST \"$RM -Rf $TMP_BASE_DIR\""
	BACKOUT_COMMAND "$ECHO \"Removing $TMP_BASE_DIR on $HOST\""
	$TRUSTED_SHELL $HOST "chmod 700 $TMP_BASE_DIR"
	ERROR_CHK $? "chmod 700 $TMP_BASE_DIR on $HOST" 2
	#Get list of directories that need to be transferred
	OBJECT_LIST=(`$TRUSTED_SHELL ${MIR_HOST} "ls ${MIR_DATADIR}|$GREP -v db_dumps|$TR '\n' ' '"`)
	if [ $? -ne 0 ];then
		ERROR_EXIT "[FATAL]:-Failed to obtain directory list of ${MIR_DATADIR} on ${MIR_HOST}" 2
	fi
	LOG_MSG "[INFO]:-Commencing $TAR  of $MIR_DATADIR on $MIR_HOST to $HOST" 1
	LOG_MSG "[INFO]:-Please wait..." 1
	$TRUSTED_SHELL $MIR_HOST "cd $MIR_DATADIR;$TAR cf - ${OBJECT_LIST[@]} |$TRUSTED_SHELL ${HOST} \"cd $TMP_BASE_DIR; $TAR xf -\""
	RETVAL=$?
	if [ $RETVAL -ne 0 ];then
		BACKOUT_COMMAND "$TRUSTED_SHELL $MIR_HOST \"${EXPORT_LIB_PATH};$PG_CTL start -D $MIR_DATADIR -l ${MIR_DATADIR}.log\""
		BACKOUT_COMMAND "$ECHO \"Restarting mirror instance on $MIR_HOST\""
		ERROR_EXIT  "[FATAL]:-Failed to $TAR cf STDOUT on $MIR_HOST to $HOST" 2
	fi
	LOG_MSG "[INFO]:-Restarting mirror instance on $MIR_HOST" 1
	$TRUSTED_SHELL $MIR_HOST "${EXPORT_LIB_PATH};$PG_CTL start -w -D $MIR_DATADIR -o \"-i -p ${MIR_PORT}\" -l ${MIR_DATADIR}.log"
	ERROR_CHK $? "$PG_CTL start -D $MIR_DATADIR -l ${MIR_DATADIR}.log on $MIR_HOST" 2
	BACKOUT_COMMAND "$TRUSTED_SHELL $HOST \"$RM -Rf $TMP_BASE_DIR\""
	BACKOUT_COMMAND "$ECHO \"Removing $TMP_BASE_DIR on $HOST\""
	LOG_MSG "[INFO]:-Configuring $PG_CONF on $HOST" 1
	$TRUSTED_SHELL $HOST "$CAT $TMP_BASE_DIR/$PG_CONF|$GREP -v \"port=\" > /tmp/${HOST}_$PG_CONF.$$"
	ERROR_CHK $? "Process $PG_CONF on $HOST" 2
	$TRUSTED_SHELL $HOST "$MV -f /tmp/${HOST}_$PG_CONF.$$ $TMP_BASE_DIR/$PG_CONF"
	ERROR_CHK $? "$MV -f /tmp/${HOST}_$PG_CONF.$$ $TMP_BASE_DIR/$PG_CONF on $HOST" 2
	ED_FILE $TMP_BASE_DIR/$PG_CONF "$PORT_TXT" port=$PORT 0 $HOST
	LOG_MSG "[INFO]:-Starting temporary instance on $HOST"   1
	$TRUSTED_SHELL $HOST "${EXPORT_LIB_PATH};$PG_CTL start -w -D $TMP_BASE_DIR -l ${TMP_BASE_DIR}.log"
	ERROR_CHK $? "$PG_CTL start -D $TMP_BASE_DIR -l ${TMP_BASE_DIR}.log on $HOST" 2
	BACKOUT_COMMAND "if [ -f ${TMP_BASE_DIR}/postmaster.pid} ];then $TRUSTED_SHELL $HOST \"${EXPORT_LIB_PATH};$PG_CTL stop -D $TMP_BASE_DIR -m fast\";fi"
	BACKOUT_COMMAND "$ECHO \"Stopping temporary instance on $HOST\""
	LOG_MSG "[INFO]:-Obtaining database table lists" 1
	for DB in ${DB_ARRAY[@]}
	do
		LOG_MSG "[INFO]:-Processing database $DB" 1
		LOG_MSG "[INFO]:-Obtaining a list of non-system schema names" 1
		SCHEMA_ARRAY=(`$TRUSTED_SHELL $HOST "$EXPORT_LIB_PATH;env PGOPTIONS=\"-c gp_session_role=utility\" $PSQL -A -t -F\"|\" -p $PORT $DB -c \"select oid, nspname from pg_namespace where nspname not in ('information_schema', 'pg_catalog', 'pg_toast', 'pg_temp_1');\""`)	
		ERROR_CHK $? "obtained schema data for $DB" 2
		for SCHEMA_ITEM in ${SCHEMA_ARRAY[@]}
		do
			S_OID=`$ECHO $SCHEMA_ITEM|$CUT -d"|" -f1`
			S_NAME=`$ECHO $SCHEMA_ITEM|$CUT -d"|" -f2`
			LOG_MSG "[INFO]:-Processing schema $S_NAME in database $DB" 1
			TABLE_ARRAY=(`$TRUSTED_SHELL $HOST "$EXPORT_LIB_PATH;env PGOPTIONS=\"-c gp_session_role=utility\" $PSQL -A -t -F\"|\" -p $PORT $DB -c \"select relname from pg_class where relnamespace=$S_OID and relkind='r';\""`)
			ERROR_CHK $? "obtain table list for schema $S_NAME in database $DB" 2	
			LOG_MSG "[INFO]:-Clear tables for database $DB, please wait..." 1
			for TABLE_NAME in ${TABLE_ARRAY[@]}
			do
				LOG_MSG "[INFO]:-Clearing table ${S_NAME}.$TABLE_NAME"
				if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $NOLINE_ECHO ".\c";fi
				$TRUSTED_SHELL $HOST "$EXPORT_LIB_PATH;env PGOPTIONS=\"-c gp_session_role=utility\" $PSQL -A -t -F\"|\" -p $PORT $DB -c\"delete from ${S_NAME}.$TABLE_NAME;\"" >> $LOG_FILE 2>&1
				ERROR_CHK $? "delete from table ${S_NAME}.$TABLE_NAME" 2
			done
			if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $ECHO;fi
		done
		if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $ECHO;fi
		LOG_MSG "[INFO]:-Commencing vacuum of $DB database, please wait..." 1
		$TRUSTED_SHELL $HOST "$EXPORT_LIB_PATH;env PGOPTIONS=\"-c gp_session_role=utility\" $PSQL -A -t -F\"|\" -p $PORT $DB -c\"vacuum;\""	>> $LOG_FILE 2>&1
	done
	LOG_MSG "[INFO]:-Closing down temporary instance on $HOST" 1
	$TRUSTED_SHELL $HOST "${EXPORT_LIB_PATH};$PG_CTL stop -D $TMP_BASE_DIR -m fast"
	ERROR_CHK $? "$PG_CTL stop -D $TMP_BASE_DIR on $HOST" 2
	LOG_MSG "[INFO]:-Configuring $PG_CONF on $HOST" 1
	$TRUSTED_SHELL $HOST "$CAT $TMP_BASE_DIR/$PG_CONF|$GREP -v \"port=\" > /tmp/${HOST}_$PG_CONF.$$"
	ERROR_CHK $? "Process $PG_CONF on $HOST" 2
	$TRUSTED_SHELL $HOST "$MV -f /tmp/${HOST}_$PG_CONF.$$ $TMP_BASE_DIR/$PG_CONF"
	ERROR_CHK $? "$MV -f /tmp/${HOST}_$PG_CONF.$$ $TMP_BASE_DIR/$PG_CONF on $HOST" 2
	LOG_MSG "[INFO]:-Creating new tar file on $HOST" 1
	$TRUSTED_SHELL $HOST "cd $TMP_BASE_DIR;$TAR cf $BASE_DATADIR/$SEG_TAR_FILE ./* >/dev/null 2>&1"
	ERROR_CHK $? "$TAR cf $SEG_TAR_FILE ./* on $HOST" 2
	LOG_MSG "[INFO]:-Removing temporary instance directory" 1
	$TRUSTED_SHELL $HOST "$RM -Rf $TMP_BASE_DIR"
	LOG_MSG "[INFO]:-Removing postgres log file on $HOST" 1
	$TRUSTED_SHELL $HOST "$RM -f ${TMP_BASE_DIR}.log"
	BASE_HOST=$HOST
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

RELOCATE_MIRRORS () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Commencing mirror relocation process, please wait..." 1
	for MOVE_SEG in ${MOVE_MIRROR_ARRAY[@]}
	do
		SET_VAR $MOVE_SEG
		TARGET_HOST=`$ECHO $MOVE_SEG|$AWK -F":" '{print $NF}'`
		#Now update the mirror array to update hostname
		LOG_MSG "[INFO]:-Preparing to move $DATADIR from $HOST to $TARGET_HOST"  1
		LOG_MSG "[INFO]:-Commencing shutdown of mirror segment $DATADIR on $HOST" 1
		$TRUSTED_SHELL $HOST "${EXPORT_LIB_PATH};$PG_CTL stop -D $DATADIR -m fast" >> $LOG_FILE 2>&1
		ERROR_CHK $? "shutdown $HOST $DATADIR" 2
		BACKOUT_COMMAND "$TRUSTED_SHELL $HOST \"$EXPORT_LIB_PATH;$PG_CTL start -w  -D $DATADIR -l ${DATADIR}.log\""
		BACKOUT_COMMAND "$ECHO \"Starting segment instance $DATADIR on $HOST\""
		LOG_MSG "[INFO]:-Making directory $DATADIR on $TARGET_HOST"
		$TRUSTED_SHELL $TARGET_HOST "$MKDIR $DATADIR;chmod 700 $DATADIR"
		ERROR_CHK $? "$MKDIR $DATADIR;chmod 700 $DATADIR on $TARGET_HOST" 2
		LOG_MSG "[INFO]:-Commencing copy of $DATADIR from $HOST to $TARGET_HOST, please wait.." 1		
		$TRUSTED_SHELL $HOST "cd ${DATADIR};$TAR cf - *|$TRUSTED_SHELL ${TARGET_HOST} \"cd ${DATADIR};$TAR xf -\"">> $LOG_FILE 2>&1
		ERROR_CHK $? "remote transfer $DATADIR from $HOST to ${TARGET_HOST}" 2
		BACKOUT_COMMAND "$TRUSTED_SHELL $TARGET_HOST \"$RM -Rf $DATADIR\""
		BACKOUT_COMMAND "$ECHO \"Deleting $DATADIR on $TARGET_HOST\""
		LOG_MSG "[INFO]:-Commencing copy of ${DATADIR}.log from $HOST to $TARGET_HOST" 1
		$TRUSTED_SHELL $HOST "$SCP -p ${DATADIR}.log ${TARGET_HOST}:${DATADIR}.log"
		ERROR_CHK $? "remote log copy from from $HOST to $TARGET_HOST" 1
		BACKOUT_COMMAND "$TRUSTED_SHELL $TARGET_HOST \"$RM -f ${DATADIR}.log\""
		BACKOUT_COMMAND "$ECHO \"Deleting ${DATADIR}.log on $TARGET_HOST\""
		LOG_MSG "[INFO]:-Deleting ${DATADIR} on $HOST" 1
		$TRUSTED_SHELL $HOST "$RM -Rf $DATADIR ${DATADIR}.log"
		ERROR_CHK $? "delete $DATADIR on $HOST" 2
		BACKOUT_COMMAND "$TRUSTED_SHELL $TARGET_HOST \"$SCP -pr $DATADIR ${HOST}:$DATADIR\""
		BACKOUT_COMMAND "$ECHO \"Starting copy of $DATADIR from $TARGET_HOST to $HOST\""
		LOG_MSG "[INFO]:-Starting segment instance on $DATADIR ${TARGET_HOST}" 1
		$TRUSTED_SHELL $TARGET_HOST "$EXPORT_LIB_PATH;$PG_CTL start -w -D $DATADIR -l ${DATADIR}.log" >> $LOG_FILE 2>&1
		ERROR_CHK $? "start postmaster $DATADIR on $TARGET_HOST" 2
		BACKOUT_COMMAND "$TRUSTED_SHELL $TARGET_HOST \"${EXPORT_LIB_PATH};$PG_CTL stop -D $DATADIR -m fast\""
		BACKOUT_COMMAND "$ECHO \"Stopping segment instance $DATADIR on $TARGET_HOST\""
		LOG_MSG "[INFO]:-Updating $CONFIG_TABLE" 1
		$EXPORT_LIB_PATH;env PGOPTIONS="-c gp_session_role=utility" $PSQL -q -p $MASTER_PORT $QD_DBNAME  -A -t -c"update $CONFIG_TABLE set hostname='${TARGET_HOST}' where content=$CONTENT and dbid=$DBID;" >> $LOG_FILE 2>&1
		ERROR_CHK $? "update $CONFIG_TABLE for dbid=$DBID" 2
		BACKOUT_COMMAND "$EXPORT_LIB_PATH;env PGOPTIONS=\"-c gp_session_role=utility\" $PSQL -q -p $MASTER_PORT $QD_DBNAME  -A -t -c\"update $CONFIG_TABLE set hostname='$HOST' where content=$CONTENT and dbid=$DBID;\""
		BACKOUT_COMMAND "$ECHO \"Updating $CONFIG_TABLE for dbid=$DBID\""
	done
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

ADD_NEW_HOSTS () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Commencing to add new hosts to the GPDB array" 1
	SEG_TO_ADD=0
	BUILD_ARRAY=("${QE_PRIMARY_ARRAY[@]}" "${QE_MIRROR_ARRAY[@]}")
	BATCH_LIMIT=${#BUILD_ARRAY[@]}
	if [ $BATCH_DEFAULT -gt $BATCH_LIMIT ];then
		RESET_BATCH_VALUE
	fi
	LOG_MSG "[INFO]:-Commencing parallel add of new segment instances, please wait..." 1
	PARALLEL_SETUP  $PARALLEL_STATUS_FILE
	for QE_LINE in ${BUILD_ARRAY[@]}
	do
		SET_VAR $QE_LINE
		if [ $DEF_PRIMARY == 't' ];then
			((SEG_TO_ADD=$SEG_TO_ADD+1))
		fi
		export MASTER_PORT
		export QD_DBNAME
		if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $NOLINE_ECHO ".\c";fi
		$GPSEGEXPAND $$ 1 $INST_COUNT $LOG_FILE $PARALLEL_STATUS_FILE $HOST $PORT $BASE_HOST $BASE_DATADIR \
$SEG_TAR_FILE $DATADIR `$ECHO $ARRAY_NAME|$TR ' ' '~'` \
$FINAL_TOTAL_SEG $DBID $CONTENT $DEF_PRIMARY $IS_PRIMARY $VALID `$ECHO ${NEW_IP_ARRAY[@]}|$TR ' ' '~'`	&
		PARALLEL_COUNT $BATCH_LIMIT $BATCH_DEFAULT
	done	
	if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $ECHO;fi
	RESTORE_BATCH_VALUE
	PARALLEL_SUMMARY_STATUS_REPORT $PARALLEL_STATUS_FILE
	#Build composite backout file
	LOG_MSG "[INFO]:-Building composite backout file, please wait..." 1
	$MV $BACKOUT_FILE ${BACKOUT_FILE}_composite_pre
	SEG_BACKOUT_PREFIX=`$BASENAME ${GPSEGEXPAND}`
	for SEG_BACK_FILE in /tmp/${SEG_BACKOUT_PREFIX}_backout*
	do	
		$CAT $SEG_BACK_FILE >> $BACKOUT_FILE
		$RM -f $SEG_BACK_FILE
	done
	$CAT ${BACKOUT_FILE}_composite_pre >> $BACKOUT_FILE
	$RM -f ${BACKOUT_FILE}_composite_pre
	LOG_MSG "[INFO]:-Completed build of composite backout file" 1	
	if [ $REPORT_FAIL -ne 0 ];then
		$CAT $PARALLEL_STATUS_FILE >> $LOG_FILE
		$RM -f $PARALLEL_STATUS_FILE
		$RM -f $IS_RUNNING
		ERROR_EXIT "[FATAL]:-Add new expand hosts failed, unable to continue" 2
	fi
	$RM -f $PARALLEL_STATUS_FILE
	LOG_MSG "[INFO]:-Updating total number of segments on master instance will add $SEG_TO_ADD"
	${EXPORT_LIB_PATH};env PGOPTIONS="-c gp_session_role=utility" $PSQL -q -p $MASTER_PORT $QD_DBNAME  -A -t -c"update $GP_ID_TABLE set numsegments=numsegments+${SEG_TO_ADD};"
	ERROR_CHK $? "add $SEG_TO_ADD to numsegments in $GP_ID_TABLE on master instance" 2
	BACKOUT_COMMAND "${EXPORT_LIB_PATH};env PGOPTIONS=\"-c gp_session_role=utility\" $PSQL -q -p $MASTER_PORT $QD_DBNAME  -A -t -c\"update $GP_ID_TABLE set numsegments=numsegments-${SEG_TO_ADD};\""
	BACKOUT_COMMAND "$ECHO \"Decrementing numsegments on $GP_ID_TABLE on Master\""
	LOG_MSG "[INFO]:-Updating $GP_ID_TABLE for the array, please wait..." 1
	MPP_UPDATE_ARRAY=`${EXPORT_LIB_PATH};env PGOPTIONS="-c gp_session_role=utility" $PSQL -q -p $MASTER_PORT $QD_DBNAME  -A -t -c"select hostname, port, datadir from $CONFIG_TABLE where content<>-1 and DBID<=$MAX_DBID;"` >> $LOG_FILE 2>&1
	for UPDATE_MPP_ITEM in ${MPP_UPDATE_ARRAY[@]}
	do
		if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $NOLINE_ECHO ".\c";fi
		MPP_HOST=`$ECHO $UPDATE_MPP_ITEM|$CUT -d"|" -f1`
		MPP_PORT=`$ECHO $UPDATE_MPP_ITEM|$CUT -d"|" -f2`
		MPP_DATADIR=`$ECHO $UPDATE_MPP_ITEM|$CUT -d"|" -f3`
		LOG_MSG "[INFO]:-Updating number of segments in $GP_ID_TABLE for host $MPP_HOST port $MPP_PORT"
		$TRUSTED_SHELL $MPP_HOST "$EXPORT_LIB_PATH;env PGOPTIONS=\"-c gp_session_role=utility\" $PSQL -p $MPP_PORT $DEFAULTDB -c \"update $GP_ID_TABLE set numsegments=${FINAL_TOTAL_SEG};\"" >> $LOG_FILE 2>&1
		ERROR_CHK $? "update $GP_ID_TABLE for host $MPP_HOST port $MPP_PORT" 2
		BACKOUT_COMMAND "${EXPORT_LIB_PATH};env PGOPTIONS=\"-c gp_session_role=utility\" $PSQL -h $MPP_HOST -q -p $MPP_PORT $QD_DBNAME  -A -t -c\"update $GP_ID_TABLE set numsegments=${PREV_TOTAL_SEG};\""
		ADD_NEW_IP_ADDRESSES $MPP_HOST $MPP_DATADIR
	done
	if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $ECHO;fi
	LOG_MSG "[INFO]:-Removing template tar file on  $BASE_HOST"
	$TRUSTED_SHELL $BASE_HOST "$RM -f ${BASE_DATADIR}/$SEG_TAR_FILE"
	ERROR_CHK $? "$RM -f ${BASE_DATADIR}/$SEG_TAR_FILE on $BASE_HOST" 1
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

ADD_NEW_IP_ADDRESSES () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	ADD_HOST=$1;ADD_DATA_DIR=$2
	LOG_MSG "[INFO]:-Adding new IP addresses to $PG_HBA on $ADD_HOST"
	for IP_ADDRESS in ${NEW_IP_ARRAY[@]}	
	do
		THERE=`$TRUSTED_SHELL ${ADD_HOST} "$GREP -c \"$IP_ADDRESS\" ${ADD_DATA_DIR}/$PG_HBA"`
		if [ $THERE -eq 0 ];then
			$TRUSTED_SHELL $ADD_HOST "$ECHO host  all     all     ${IP_ADDRESS}/32 trust >> ${ADD_DATA_DIR}/$PG_HBA" >> $LOG_FILE 2>&1
			ERROR_CHK $? "Add IP address to ${ADD_DATA_DIR}/$PG_HBA on $ADD_HOST" 2
		fi
	done
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

DATA_TRANSFER () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Commencing data re-distribution process" 1
	for DB in ${DB_ARRAY[@]}
	do
		LOG_MSG "[INFO]:-Processing database $DB, please wait..." 1
		LOG_MSG "[INFO]:-Obtaining a list of non-system schema names"
		SCHEMA_ARRAY=(`${EXPORT_LIB_PATH};$PSQL -A -t -F"|" -p $MASTER_PORT $DB -c "select oid, nspname from pg_namespace where nspname not in ('information_schema', 'pg_catalog', 'pg_toast', 'pg_temp_1');"`)
		ERROR_CHK $? "obtained schema data for $DB" 2
		for SCHEMA_ITEM in ${SCHEMA_ARRAY[@]}
		do
			S_OID=`$ECHO $SCHEMA_ITEM|$CUT -d"|" -f1`
			S_NAME=`$ECHO $SCHEMA_ITEM|$CUT -d"|" -f2`
			LOG_MSG "[INFO]:-Processing schema $S_NAME" 1
			TABLE_ARRAY=(`${EXPORT_LIB_PATH};$PSQL -A -t -F"|" -p $MASTER_PORT $DB -c "select relname from pg_class where relnamespace=$S_OID and relkind='r';"`)
			ERROR_CHK $? "obtain table list for schema $S_NAME" 2
			LOG_MSG "[INFO]:-Processing user tables in schema $S_NAME, please wait .." 1
			TRANS_ARRAY=()
			for TABLE_NAME in ${TABLE_ARRAY[@]}
			do
				LOG_MSG "[INFO]:-Checking $PG_SIZE_FUNC size for table $TABLE_NAME" 1
				PG_SIZE=`$EXPORT_LIB_PATH;$PSQL -A -t -p $MASTER_PORT $DB -c"select ${PG_SIZE_FUNC}('${S_NAME}.${TABLE_NAME}');"|$AWK '{print $1}'`
				ERROR_CHK $? "get $PG_SIZE_FUNC size for table $TABLE_NAME" 2
				if [ $PG_SIZE -eq 0 ];then
					LOG_MSG "[INFO]:-Table $TABLE_NAME zero size, will skip processing" 1
				else
					if [ $RANDOM_REDISTRIB -eq 1 ];then
						#Check to see if table is distributed randomly
						GET_DISTRIB_COLS ${S_NAME}.${TABLE_NAME} $MASTER_PORT $DB
						if [ x"" != x"$DISTRIB_COLS" ];then
							TRANS_ARRAY=(${TRANS_ARRAY[@]} "${S_NAME}.${TABLE_NAME}")
						else
							LOG_MSG "[INFO]:-Table ${S_NAME}.${TABLE_NAME} in database $DB has random distribution" 1
							LOG_MSG "[INFO]:-Option -r supplied, will not re-distribute" 1
						fi
					else
						TRANS_ARRAY=(${TRANS_ARRAY[@]} "${S_NAME}.${TABLE_NAME}")
					fi
				fi
			done
			if [ ${#TRANS_ARRAY[@]} -ne 0 ];then
				LOG_MSG "[INFO]:-Have found ${#TRANS_ARRAY[@]} tables with data, will commence data redistribution" 1
				DISTRIB_TABLES
			else
				LOG_MSG "[INFO]:-No user tables found to contain data in schema $S_NAME database $DB" 1
			fi
			LOG_MSG "[INFO]:-Completed processing of schema $S_NAME" 1
		done
		LOG_MSG "[INFO]:-Commencing vacuum analyze of $DB, please wait.." 1
		$EXPORT_LIB_PATH;$PSQL -A -t -p $MASTER_PORT $DB -c"vacuum analyze;" >> $LOG_FILE 2>&1
		LOG_MSG "[INFO]:-Completed processing database $DB" 1
	done
	LOG_MSG "[INFO]:-Unlocking remote database access" 1
	$MV ${MASTER_DATA_DIRECTORY}/${PG_HBA}_expand_secure ${MASTER_DATA_DIRECTORY}/$PG_HBA
	ERROR_CHK $? "unlock remote database access" 2
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

DISTRIB_TABLES () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:-Createing temporary holding schema"
	$EXPORT_LIB_PATH;$PSQL -A -t -p $MASTER_PORT $DB -c"create schema ${SCHEMA_PREFIX}_${S_NAME};" >> $LOG_FILE 2>&1
	ERROR_CHK $? "create schema ${SCHEMA_PREFIX}_${S_NAME};" 2
	BATCH_DEFAULT=$COPY_BATCH_DEFAULT
	BATCH_LIMIT=${#TRANS_ARRAY[@]}
	if [ $BATCH_DEFAULT -gt $BATCH_LIMIT ];then
		RESET_BATCH_VALUE
	fi
	PARALLEL_SETUP  $PARALLEL_STATUS_FILE
	export MASTER_PORT
	for TRAN_TABLE in ${TRANS_ARRAY[@]}
	do
		S_NAME=`$ECHO $TRAN_TABLE|$AWK -F"." '{print $1}'`
		TABLE_NAME=`$ECHO $TRAN_TABLE|$AWK -F"." '{print $2}'`	
		if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $NOLINE_ECHO ".\c";fi
		$GPSEGEXPAND $$ 3 $INST_COUNT $LOG_FILE $PARALLEL_STATUS_FILE $TABLE_NAME $S_NAME $DB ${SCHEMA_PREFIX}_${S_NAME} \
$KEEP_SCHEMA  &
		PARALLEL_COUNT $BATCH_LIMIT $BATCH_DEFAULT
	done
	if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $ECHO;fi
	PARALLEL_SUMMARY_STATUS_REPORT $PARALLEL_STATUS_FILE
	if [ $REPORT_FAIL -ne 0 ];then
		$CAT $PARALLEL_STATUS_FILE >> $LOG_FILE
		$RM -f $PARALLEL_STATUS_FILE
		$RM -f $IS_RUNNING
		ERROR_EXIT "[FATAL]:-Data restribution for schema $S_NAME in database $DB failed, see log file" 2
	fi
	$CAT $PARALLEL_STATUS_FILE >> $LOG_FILE
	$RM -f $PARALLEL_STATUS_FILE
	if [ $KEEP_SCHEMA -eq 0 ];then
		LOG_MSG "[INFO]:-Dropping temporary holding schema ${SCHEMA_PREFIX}_${S_NAME}" 1
		$EXPORT_LIB_PATH;$PSQL -A -t -p $MASTER_PORT $DB -c"drop schema ${SCHEMA_PREFIX}_${S_NAME};" >> $LOG_FILE 2>&1
		ERROR_CHK $? "drop schema ${SCHEMA_PREFIX}_${S_NAME};" 1
	else
		LOG_MSG "[INFO]:-Keeping temporary schema ${SCHEMA_PREFIX}_${S_NAME}, as -k option supplied" 1
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

END_INFO () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:------------------------------------------------" 1
	LOG_MSG "[INFO]:-The GPDB array has been successfully expanded" 1
	LOG_MSG "[INFO]:-New hosts have been added to the array" 1
	LOG_MSG "[INFO]:-All user tables have been re-distributed" 1
	LOG_MSG "[INFO]:-To view the new array configuration" 1
	LOG_MSG "[INFO]:-Run gpstate -c" 1
	LOG_MSG "[INFO]:------------------------------------------------" 1
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}
#******************************************************************************
# Main Section
#******************************************************************************
trap '$RM -f $IS_RUNNING;ERROR_EXIT "[FATAL]:-Recieved INT or TERM signal" 2' INT TERM
if [ $# -ne 0 ]; then
	while getopts ":v'?'iaql:d:h:m:bDBC:rk" opt;do
		case $opt in
			v ) VERSION_INFO ;;
			'?' ) USAGE ;;
			i ) ADDITIONAL_INFO ;;
			d ) MASTER_DATA_DIRECTORY=$OPTARG ;;
			a ) unset INTERACTIVE ;;
			q ) unset VERBOSE ;;
			l ) LOG_DIR=$OPTARG ;;
			h ) HOST_FILE=$OPTARG ;;
			m ) MIRROR_HOST_FILE=$OPTARG ;;
			b ) FORCE_NO_BACKUP=1 ;;
			D ) DEBUG_LEVEL=1 ;;
			B ) BATCH_DEFAULT=$OPTARG ;;
			C ) COPY_BATCH_DEFAULT=$OPTARG ;;
			r ) RANDOM_REDISTRIB=1 ;;
			k ) KEEP_SCHEMA=1 ;;
			* ) USAGE ;;
		esac
	done
else
	USAGE
fi
if [ x"" != x"$LOG_DIR" ];then
        CHK_DIR $LOG_DIR
        if [ $EXISTS -eq 1 ]; then
                LOG_MSG "[WARN]:-Log directory $LOG_DIR does not exist, using default log directory" 1
		BACKOUT_FILE=${DEFLOGDIR}/backout_${PROG_NAME}_$EXPAND_DATE
        else
                LOG_FILE=$LOG_DIR/${PROG_NAME}_${CUR_DATE}.log
		BACKOUT_FILE=${LOG_DIR}/backout_${PROG_NAME}_$EXPAND_DATE
        fi
else
	BACKOUT_FILE=${DEFLOGDIR}/backout_${PROG_NAME}_$EXPAND_DATE
fi
LOG_MSG "[INFO]:-Start Main"
LOG_MSG "[INFO]:-Command line options passed to utility = $*"
GET_QD_DB_NAME
CHK_GPDB_ID
if [ x"" == x"$CHK_STANDBY" ];then
        CHK_ON_PASSIVE_STANDBY
fi
if [ x"" != x"$GPHOME" ];then
        APP_PATH=${GPHOME}/bin
else
	ERROR_EXIT "[FATAL]:-Environment variable \$GPHOME unset" 2
fi
GET_MASTER_PORT $MASTER_DATA_DIRECTORY
CHK_DB_RUNNING
VALIDATE_OPTIONS
GET_GP_PARAMS
GET_PARAM
CHK_FOR_DB_DUMP
CHK_HOSTS
CHK_SEG_SPACE
BUILD_NEW_HOST_ARRAY
if [ x"" != x"$INTERACTIVE" ];then
	PROMPT_CONTINUE
fi
CHK_CONNECTIONS
CREATE_BASE_TEMPLATE_DB
if [ ${#MOVE_MIRROR_ARRAY[@]} -ne 0 ];then
	RELOCATE_MIRRORS
fi
ADD_NEW_HOSTS
DATA_TRANSFER
CLEAR_FILES
END_INFO
LOG_MSG "[INFO]:-End Main"
