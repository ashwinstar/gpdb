#!/usr/bin/env python
'''
USAGE:   gpclusterinstall -f|--file HOSTFILE -u|--user USER 
         where HOSTFILE lists all the hosts to install the software on
         where USER will be the user to install the software as
'''

import os, sys, re
import subprocess, warnings, logging
warnings.simplefilter('ignore', DeprecationWarning)

try:
    import paramiko, getpass
    from optparse import Option, OptionParser 
    from gppylib.gpparseopts import OptParser, OptChecker
    from gppylib.gplog import get_default_logger, setup_tool_logging
    from gppylib.commands.unix import getLocalHostname, getUserName
    from gppylib.commands.base import WorkerPool, Command, NakedExecutionPasswordMap, NAKED
except ImportError, e:    
    sys.exit('Cannot import modules.  Please check that you have sourced greenplum_path.sh.  Detail: ' + str(e))

EXECNAME = os.path.split(__file__)[-1]

logger = get_default_logger()
setup_tool_logging(EXECNAME,getLocalHostname(),getUserName()) 
hosts = dict() # hostname to Host object
uniquehosts = set()
options = None
passwordMap = None
nullFile = logging.FileHandler('/dev/null')
logging.getLogger('paramiko.transport').addHandler(nullFile)
pool = None

class Host:
    def __init__(self, address):
        self.address = address
        self.hostname = None
        
    
# True is an error
def run_command(cmdstr):

    logger.info(cmdstr)
    p = subprocess.Popen(cmdstr, shell=True, executable="/bin/bash")
    sts = os.waitpid(p.pid, 0)[1]
    if sts:
        logger.error("error on cmd " + cmdstr)
        return True

    return False



# True is an error
def parseargs():

    global options

    parser = OptParser(option_class=OptChecker)
    parser.remove_option('-h')
    parser.add_option('-h', '-?', '--help', action='store_true')
    parser.add_option('-f', '--file', type='string')
    parser.add_option('-u', '--user', type='string', default='gpadmin')
    (options, args) = parser.parse_args()

    if options.help:
        print __doc__
        return True

    gphome = os.environ.get('GPHOME')
    if not gphome:
        logger.error("GPHOME not set")
        return True

    if not options.file:
        logger.error("--file must be specified")
        return True

    if not os.path.exists(options.file):
        logger.error("file %s does not exist" % options.file)
        return True

    return False

# True is an error
def readHostList():

    try:
        for line in open(options.file, "r"):
            hostname = line.rstrip()
            hosts[hostname] = Host(hostname)
    except Exception, e:
        logger.error("Error while reading file: %s" % options.file)
        logger.error(e.__str__())
        return True

    if not len(hosts.keys()):
        logger.error("No hosts read from hostfile: %s" % options.file)
        return True

    return False

# True is an error
def discoverPasswordMap():

    try:    
        passwordMap = NakedExecutionPasswordMap(hosts.keys())
        passwordMap.discover()
    except Exception, e:
        logger.error(e.__str__())
        return True

    return False

# True is an error
def dedupeHosts():
    try:
        for host in hosts.keys():
            cmd = Command(host, "hostname", NAKED, host, passwordMap=passwordMap)
            pool.addCommand(cmd)

        pool.join()
        items = pool.getCompletedItems()
        for i in items:
            print i
    except Exception, e:
        print "error %s" %e.__str__()
        return False

def earlyExit():
    if pool:
        pool.join()
        pool.haltWork()
        pool.joinWorkers()

    sys.exit(1)

# True is an error
#def createUserOnCluster():


if (parseargs()):
    earlyExit()

if (readHostList()):
    earlyExit()

if (discoverPasswordMap()):
    earlyExit()

pool = WorkerPool()

if (dedupeHosts()):
    earlyExit()

