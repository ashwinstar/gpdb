#!/usr/bin/env python
'''
USAGE:   gpclusterinstall -f|--file HOSTFILE -u|--user USER 
         where HOSTFILE lists all the hosts to install the software on
         where USER will be the user to install the software as. default is gpadmin
'''

import os, sys, re
import subprocess, warnings, logging
warnings.simplefilter('ignore', DeprecationWarning)

try:
    import paramiko, getpass
    from optparse import Option, OptionParser 
    from gppylib.gpparseopts import OptParser, OptChecker
    from gppylib.gplog import get_default_logger, setup_tool_logging
    from gppylib.commands.unix import getLocalHostname, getUserName
    from gppylib.commands.base import WorkerPool, Command, NakedExecutionPasswordMap, NAKED
except ImportError, e:    
    sys.exit('Cannot import modules.  Please check that you have sourced greenplum_path.sh.  Detail: ' + str(e))

EXECNAME = os.path.split(__file__)[-1]

logger = get_default_logger()
setup_tool_logging(EXECNAME,getLocalHostname(),getUserName()) 
hosts = dict() # address to HostMapping object
uniquehosts = dict() # hostname to UniqueHost object
options = None
passwordMap = None
nullFile = logging.FileHandler('/dev/null')
logging.getLogger('paramiko.transport').addHandler(nullFile)
pool = None

class HostMapping:
    def __init__(self, address):
        self.address = address
        self.hostname = None

    def debugStr(self):
        return "address %s hostname %s" % (self.address, self.hostname)

class UniqueHost:
    def __init__(self, address, hostname):
        self.address = address
        self.hostname = hostname
        self.userExists = False
    
    def debugStr(self):
        return "address %s hostname %s userExists %s" % (self.address, self.hostname, self.userExists)
    
# True is an error
def run_command(cmdstr):

    logger.info(cmdstr)
    p = subprocess.Popen(cmdstr, shell=True, executable="/bin/bash")
    sts = os.waitpid(p.pid, 0)[1]
    if sts:
        logger.error("error on cmd " + cmdstr)
        return True

    return False



# True is an error
def parseargs():

    global options

    parser = OptParser(option_class=OptChecker)
    parser.remove_option('-h')
    parser.add_option('-h', '-?', '--help', action='store_true')
    parser.add_option('-f', '--file', type='string')
    parser.add_option('-u', '--user', type='string', default='gpadmin')
    (options, args) = parser.parse_args()

    if options.help:
        print __doc__
        return True

    gphome = os.environ.get('GPHOME')
    if not gphome:
        logger.error("GPHOME not set")
        return True

    if not options.file:
        logger.error("--file must be specified")
        return True

    if not os.path.exists(options.file):
        logger.error("file %s does not exist" % options.file)
        return True

    return False

# True is an error
def readHostList():

    try:
        for line in open(options.file, "r"):
            hostname = line.rstrip()
            hosts[hostname] = HostMapping(hostname)
    except Exception, e:
        logger.error("Error while reading file: %s" % options.file)
        logger.error(e.__str__())
        return True

    if not len(hosts.keys()):
        logger.error("No hosts read from hostfile: %s" % options.file)
        return True

    return False

# True is an error
def discoverPasswordMap():

    global passwordMap

    try:    
        passwordMap = NakedExecutionPasswordMap(hosts.keys())
        passwordMap.discover()
    except Exception, e:
        logger.error(e.__str__())
        return True

    if passwordMap.complete:
        return False
    else:
        return True

# True is an error
def dedupeHosts():
    try:
        for host in hosts.keys():
            cmd = Command(host, "hostname", NAKED, host, passwordMap=passwordMap)
            pool.addCommand(cmd)

        pool.join()
        items = pool.getCompletedItems()
        for i in items:
            address = i.remoteHost
            if i.results.rc or i.results.halt or not i.results.completed:
                logger.error("error obtaining information from host %s" % address)
                return True
            hostname = i.results.stdout[0].strip()
            hosts[address].hostname = hostname
    except Exception, e:
        logger.error("%s" % e.__str__())
        return True

    global uniquehosts
    for k in hosts.keys():
        hostname = hosts[k].hostname
        address = hosts[k].address
        if hostname in uniquehosts:
            continue
        uniquehosts[hostname] = UniqueHost(address, hostname)

    return False

def checkUsernames():

    try:
        for k in uniquehosts.keys():
            uh = uniquehosts[k]
            cmd = Command(uh.address, "id %s" % options.user, NAKED, uh.address, passwordMap=passwordMap)
            pool.addCommand(cmd)
        pool.join()
        items = pool.getCompletedItems()
        for i in items:
            if not i.results.rc:
                address = i.remoteHost
                hostname = hosts[address].hostname
                uniquehosts[hostname].userExists = True
    except Exception, e:
        logger.error("%s" % e.__str__())
        return True

    return False

def addUserIfRequired():

    failedToAddUser = set() # set of address's where useradd failed

    try:
        for k in uniquehosts.keys():
            uh = uniquehosts[k]
            if uh.userExists:
                continue

            cmd = Command(uh.address, "useradd -m %s" % options.user, NAKED, uh.address, passwordMap=passwordMap)
            pool.addCommand(cmd)
        pool.join()
        items = pool.getCompletedItems()
        for i in items:
            address = i.remoteHost
            if not i.results.rc:
                hostname = hosts[address].hostname
                uniquehosts[hostname].userExists = True
            else:
                failedToAddUser.add(address)
                
    except Exception, e:
        logger.error("%s" % e.__str__())
        return True

    if len(failedToAddUser):
        for h in failedToAddUser:
            logger.error("could not create user %s on host %s" % (options.user, h))
        return True

    return False

def earlyExit():
    logger.fatal("early exit from gpclusterinstall")
    if pool:
        pool.join()
        pool.haltWork()
        pool.joinWorkers()

    sys.exit(1)

if (parseargs()):
    earlyExit()

if (readHostList()):
    earlyExit()

logger.info("check access to cluster")
if (discoverPasswordMap()):
    earlyExit()

pool = WorkerPool()

logger.info("dedupe hostnames")
if (dedupeHosts()):
    earlyExit()

logger.info("check user %s exists" % options.user)
if (checkUsernames()):
    earlyExit()

logger.info("add user %s to cluster" % options.user)
if (addUserIfRequired()):
    earlyExit()

earlyExit()
