#!/usr/bin/env python

'''

Helps an administrator configure Greenplum Database with shared-storage ("san") failover

gpsetupsanfailover -- helper for generated SAN-failover configuration information.

Usage: gpsetupsanfailover [--version] [-?] [-D] [-d master_data_dir] [-l log_dir] [-p port_offset] [-t <n|e>]
           
          --version : print version information
          -?        : print this help screen
          -D        : set logging output to debug level
          -d        : master data directory
          -l        : <log directory> alternative log file directory [optional]
          -p        : mirror offset, if not supplied, script will calculate a suitable
                      port offset for the mirror segment instances, range 7000 - 61000
                      current offset value is 1000
'''

from __future__ import with_statement

import os, sys, getopt
from datetime import date

from gppylib import pgconf
from gppylib.db import *
from gppylib.gparray import *
from gppylib.gplog import *
from gppylib.gpparseopts import OptParser
from gppylib.commands.gp import getSyncmasterPID
from gppylib.commands.unix import FileGetOwnerUid
from gppylib.commands.unix import FileTestSuid
from gppylib.commands.unix import FileDirExists
from gppylib.commands.unix import getLocalHostname, getUserName
from gppylib.commands.unix import Touch, RemoveFiles
from gppylib.commands.unix import SYSTEM
from gppylib.commands.san import Mount, Inq, GpMountAgentStorageGroup
from gppylib.util.san_utils import SAN_CMDS
from gppylib.gpcoverage import GpCoverage


EXECNAME = os.path.split(__file__)[-1]
opt = {}
opt['-d'] = None
opt['-p'] = 1000
opt['-l'] = None
opt['-D'] = False
opt['-t'] = 'e'

arg = {}
arg['exit'] = 0

################
def usage(exitarg):
    parser = OptParser()
    try:
        parser.print_help()
    except:
        print __doc__
    sys.exit(exitarg)

################
def print_version():
    print '%s version $Revision$' % EXECNAME
    sys.exit(0)

################
def parseCommandLine():
    global opt, logger
    try:
        (options, args) = getopt.getopt(sys.argv[1:], '?vd:p:l:Dt:', ['version'])
    except Exception, e:
        usage(str(e))

    for (switch, val) in options:
        if (switch == '-?'):          usage(0)
        elif (switch == '-v'):        print_version()
        elif (switch == '--version'): print_version()
        elif (switch == '-t'):        opt[switch] = val
        elif (switch == '-s'):        opt[switch] = True
        elif (switch == '-i'):        opt[switch] = val
        elif (switch == '-p'):        opt[switch] = int(val)
        elif (switch == '-d'):        opt[switch] = val
        elif (switch == '-l'):        opt[switch] = val
        elif (switch == '-D'):        opt[switch] = True
        # Had to move the warning down to a point after the logger
        # is created.  So just fill in a bogus value we'll check for later
        elif (switch == '-T'):        opt[switch] = 'bogus_value'        
            
    if opt['-l']:
        logger = setup_tool_logging(EXECNAME, 
                                    getLocalHostname(), 
                                    getUserName(), 
                                    logdir=opt['-l'])
    else:
        logger = get_default_logger()

    if opt.has_key('-T'):
        logger.info('Option -T is obsolete.  This option will be ignored')

    if not opt['-d']:
        opt['-d'] = os.getenv('MASTER_DATA_DIRECTORY')
        if not opt['-d']:
            logger.error('MASTER_DATA_DIRECTORY not set')
            exit(1)
    else:
        os.environ['MASTER_DATA_DIRECTORY'] = opt['-d']

    if not os.path.isdir(opt['-d']):
        logger.error('MASTER_DATA_DIRECTORY %s does not exist or is not a directory' % opt['-d'])
        sys.exit(1)

    if opt['-t'] == 'e':
        logger.info('Will attempt to scan EMC Clariion devices')
    elif opt['-t'] == 'n':
        logger.info('Will attempt to find NFS shares')
    else:
        logger.error('\"%s\" is not a supported failover type' % opt['t'])

################
def yesorno(msg, abortmsg):
    print msg
    line = sys.stdin.readline()
    line = line.strip().lower()
    if line == 'y':
        return True
    print abortmsg
    return False


#####
# GPSANITIZE DOES NOT SUPPORT THIS OPERATION YET.
################
#   config file 
#   mirrorN=host:port:data_dir

def parseMirrorConfig():
    file = None
    lines = []
    try:
        file = open(opt['-i'], 'r')
        lines = file.readlines()
    except Exception, e:
        logger.error('Read file %s error' % opt['-i'])
        sys.exit(1)
    finally:
        if file:
            file.close()

    mirrors = []
    for l in lines:
        l = l.strip()
        if l == '':
            continue
        param = l.split('=')
        if len(param) != 2:
            logger.error('Mirror config format error')
            sys.exit(1)
        mirror = param[1].split(':')
        if len(mirror) != 3:
            logger.error('Mirror config format error')
            sys.exit(1)
        m = {}
        m['hostname'] = mirror[0]
        m['port'] = int(mirror[1])
        m['datadir'] = mirror[2]
        mirrors.append(m)
        
    return mirrors

################
def update_gp_conf(db, mirrors):
    system_filespace = 3052

    # update Greenplum database configuration
    for m in mirrors:
        history_message = "GPADDMIRRORS: content %d, dbid %d, hostname %s, port %s, datadir %s" % (m['content'], m['dbid'], m['hostname'], m['port'], m['datadir'])
        db.execute("insert into gp_configuration_history values(now(), $1, $2)", m['dbid'], history_message)
        db.execute("insert into gp_configuration values($1, $2, $3, $4, $5, $6, $7, null)",
                   m['content'], False, m['dbid'], False, True, 
                   m['hostname'], m['port'])
        db.execute("insert into pg_filespace_entry values($1, $2, $3)",
                   system_filespace, m['dbid'], m['datadir'])

################                                      
# Fetch the storage-group name using the powermt command via the wwn.
#
def get_sgname_by_wwn(host, gp_mount_agent_cmd, powermt_cmd, wwn):
    cmd = GpMountAgentStorageGroup.remote('gp_mount_agent', host)
    out = cmd.get_results().stdout.split('\n')

    matchstr = wwn.upper()

    # we get output which looks like:
    # [ . . . ]
    # CLARiiON ID=<identifier> [SG_NAME]
    # Logical device ID=<WWN> [LUN_ID]
    # [ . . . ]
    # We want to match on the WWN, and extract the SG_NAME, so we're walking a set
    # of lines, keeping track of the previous line.
    prev = ''
    for l in out:

        # Find a line with our match on it -- we'll store the previous
        # line as we go.
        # 
        # we could use a regexp here, would that be faster ?
        if l.rfind(matchstr) == -1:
            # not found
            prev = l
            continue

        # we have a line like "CLARiiON ID=APM00091400579 [<storage group name>]
        x = prev.partition('[')
        if x[2] == '':
            prev = l
            continue

        y = x[2].partition(']')
        if y[0] == '':
            prev = l
            continue

        # we got a line that looks right.
        return y[0]

    return ''

# Given a host and a command, verify that the command is setuid-root.
def verify_setuid_root(host, command):
    owner = FileGetOwnerUid.remote('verify owner', host, command)
    if owner != 0:
        return False
    return FileTestSuid.remote('verify suid', host, command)

# Given a set of segment-mountpoints, we need to find out where to fail them over
def get_failover_info(devmap):
    san_config = {}

    for k, v in devmap.iteritems():
        config_key = (v['host'], v['mountpoint'])

        # We only want to find a failover for a mountpoint one time.
        if config_key not in san_config:
            print 'Enter failover host and mountpoint for primary mountpoint %s:%s >' % (v['host'], v['mountpoint'])
            line = sys.stdin.readline() 
            line = line.strip()

            if line == '':
                logger.error('Null value entered for failover')
                sys.exit(1)
            words = line.split(':')
            if len(words) != 2:
                logger.error('Invalid value entered for failover, expected <host>:<mountpoint>')
                sys.exit(1)

            san_config[config_key] = {'primaryhost':v['host'], 'failoverhost':words[0], 'primarymp':v['mountpoint'], 'failovermp':words[1]}

    return san_config

################
coverage = GpCoverage()
coverage.start()

logger=None

try:
    parseCommandLine()

    master_port=int(os.getenv('PGPORT', 5432))
    try:
        master_port = pgconf.readfile(defaultpath=opt['-d'])['port'].int()
    except:
        # Ignore and use what was picked up in env or default gp port.
        pass

    if getSyncmasterPID('localhost', opt['-d']) != -1:
        logger.fatal('Unable to process requested command')
        sys.exit(2)

    if not SAN_CMDS.GP_MOUNT_AGENT:
        logger.error('Cannot locate GPDB mount management utility')
        raise Exception("Cannot locate GPDB mount management utility")

    logger.info('Using mount agent: %s' % SAN_CMDS.GP_MOUNT_AGENT)

    if opt['-t'] == 'e':
        if not SAN_CMDS.INQ:
            logger.error('Cannot locate SCSI-Inquiry utility for use in EMC Clariion scan.')
            raise Exception("Cannot locate SCSI-Inquiry utility for use in EMC Clariion scan.")
        if not SAN_CMDS.NAVISECCLI:
            logger.error('Cannot locate EMC management naviseccli utility for use in EMC Clariion scan.')
            raise Exception("Cannot locate EMC management naviseccli utility for use in EMC Clariion scan.")
        if not SAN_CMDS.POWERMT:
            logger.error('Cannot locate EMC PowerPath powermt utility for storage-group lookup')
            raise Exception("Cannot locate EMC PowerPath powermt utility for storage-group lookup")

    dburl = dbconn.DbURL(port=master_port, dbname='template1')
    gparray = GpArray.initFromCatalog(dburl, utility=True)

    if gparray.get_mirroring_enabled():
        logger.error('System already has mirrors. SAN-mirroring cannot coexist with mirrors.')
        raise Exception("System already has mirrors.")

    qes = None
    new_addr = []

    try:
        qes = gparray.getSegDbList()
        qe_hosts = [ x.getSegmentHostName() for x in qes ]

        # Google tells me that this is the fastest way to unique-ify a list
        # in Python, it is a weird construct: convert list->set->list
        hosts = list(set(qe_hosts))

        # We have the qe-details (root filespace with dbids and so on)

        ########################
        # Some systems' "mount" returns "dev on mp" and other return "mp on dev"
        devfirst = SYSTEM.getMountDevFirst()

        ########################
        # Check the permissions on the utilities that we need.
        for host in hosts:
            if not FileDirExists.remote('verifying existence', host, SAN_CMDS.GP_MOUNT_AGENT):
                raise Exception('Host %s doesn\'t have %s' % (host, SAN_CMDS.GP_MOUNT_AGENT))
            if not verify_setuid_root(host, SAN_CMDS.GP_MOUNT_AGENT):
                raise Exception('Host %s has invalid permissions for %s' % (host, SAN_CMDS.GP_MOUNT_AGENT))

            if opt['-t'] == 'e':
                if not FileDirExists.remote('verifying existence', host, SAN_CMDS.INQ):
                    raise Exception('Host %s doesn\'t have %s' % (host, SAN_CMDS.INQ))
                if not verify_setuid_root(host, SAN_CMDS.INQ):
                    raise Exception('Host %s has invalid permissions for %s' % (host, SAN_CMDS.INQ))

        ########################
        # Get the raw mountpoint info for every host.
        mountpoints = {}
        for host in hosts:
            # we have a list of strings, find the dev and mp.
            cmd = Mount.remote('list mount points', host, devfirst)
            mps = cmd.get_mount_points()
            # save the output for this
            mountpoints[host] = mps

        # What we have here is a dictionary indexed by host, with each value being
        # a list containing our mountpoints

        # loop over the qes, figuring out which mount-devices are used by each data-directory.
        # We're generating a new dictionary, where the keys are dictionaries labelling fields.
        #
        # the new dictionary is going to be our main datastructure for the rest of our SAN calculations.
        max_dbid = 0

        devmap = {}
        for qe in qes:
            h = qe.getSegmentHostName()
            content = qe.getSegmentContentId()
            d = qe.getSegmentDataDirectory()
            primary_port = qe.getSegmentPort()
            mirror_port = primary_port + opt['-p']
            id = qe.getSegmentDbId()

            if id >= max_dbid:
                max_dbid = id

            mplist = mountpoints[h]

            matchdir = ''
            matchdev = ''
            for (dev, mountdir) in mplist:
                if d.startswith(mountdir):
                    if len(mountdir.split('/')) >= len(matchdir.split('/')):
                        matchdir = mountdir
                        matchdev = dev

            devmap[id] = {'content':content, 'host':h, 'datadir':d, 'device':matchdev, 'mountpoint':matchdir, 'primaryport':primary_port, 'mirrorport':mirror_port}

        if opt['-t'] == 'n':
            bad_device_count = 0
            logger.info('Scanning mount-devices in NFS-mode.')
            for k, v in devmap.iteritems():
                if len(v['device'].split(':')) != 2:
                    logger.info('dbid %d on %s has data-dir on %s (%s): Does not appear to be NFS share' % (k, v['host'], v['mountpoint'], v['device']))
                    bad_device_count = bad_device_count + 1
            if bad_device_count > 0:
                raise Exception('Database system has %d segments which are not on NFS, cannot proceed in NFS-mode' % bad_device_count)

        # If we're in EMC/Clariion-mode, we need to find the WWNs for the devices so we
        # can figure out which hosts have access to them.
        #
        # It would be nice if we could run INQ once for each host, but resolving multiple
        # segments per host to hostnames properly is a little weird here -- so for now
        # we're going to issue way more INQ requests than necessary (by a factor given
        # by the number of segments/host).
        if opt['-t'] == 'e':
            logger.info('Scanning mount-devices in EMC/Clariion-mode.')

            wwn_sgname_map = {} # cache the storage-group names associated with each WWN.

            missing_wwn = False
            for k, v in devmap.iteritems():
                found = False
                
                # This parsing should be done in the command class, but it requires too much external info
                cmd = Inq.remote('inq', v['host'])
 
                out = cmd.get_results().stdout.split('\n')
 
                # We're parsing the output of the "inq" utility here.
                # lines of interest look like:
                # "/dev/emcpowerbp  APM00091400579   B  172.16.10.6     0x006f   600601607e62220093afcb43752ddf11"
                # Where the last entry on that line is the WWN.
                for l in out:
                    x = l.strip().split()

                    if len(x) == 6 and x[0].startswith('/') and x[0] == v['device']:
                        # got the entry we want.
                        WWN = x[5]
                        SPIP = x[3]

                        v['SPIP'] = SPIP
                        v['WWN'] = WWN

                        # if we don't have the storage group name already, try to get it.
                        #
                        # We'll fill it into out main configuration-map later, cache it here.
                        if not wwn_sgname_map.has_key(WWN):
                            sg_name = get_sgname_by_wwn(v['host'], SAN_CMDS.GP_MOUNT_AGENT, SAN_CMDS.POWERMT, WWN)
                            if not sg_name == '':
                                logger.info('Got sgname %s for wwn %s' % (sg_name, WWN))
                                wwn_sgname_map[WWN] = sg_name

                        found = True
                        break

                if not found:
                    missing_wwn = True
                    logger.info('dbid %d on host %s could not find WWN for device %s' % (k, v['host'], v['device']))

            if missing_wwn:
                logger.error('Could not find some WWN entries')
                raise Exception("Cannot resolve shared-storage location for EMC-SAN")

            # At this point we have all of the information we need (except possibly the Storage-group names).
            #
            # If we got the storage-group name, we fill it in here.
            for k, v in devmap.iteritems():
                WWN = v['WWN']
                if not wwn_sgname_map.has_key(WWN):
                    logger.info('dbid %d on %s has data-dir on %s (%s) EMC %s @ %s' % (k, v['host'], v['mountpoint'], v['device'], v['WWN'], v['SPIP']))
                else:
                    v['SG_NAME'] = wwn_sgname_map[WWN]
                    logger.info('dbid %d on %s has data-dir on %s (%s) EMC %s @ %s SG %s' % (k, v['host'], v['mountpoint'], v['device'], v['WWN'], v['SPIP'], v['SG_NAME']))

        ########################

        # So now we need to retrieve our failover mappings.
        san_config = get_failover_info(devmap)

        # For each host/mountpoint in devmap, we should now have a failover host/mountpoint in san_config.
        # Now we need to verify that each of the new mountpoints exists.
        for k, v in san_config.iteritems():
            tmpfile = os.path.join(v['failovermp'], 'gptmpfile')
            logger.info('verifying host %s failovermp %s tmpfile %s' % (v['failoverhost'], v['failovermp'], tmpfile))

            try:
                Touch.remote('check permissions', tmpfile, v['failoverhost'])
            except:
                raise Exception('Cannot find mountpoint %s on failover host %s' % (v['failovermp'], v['failoverhost']))
            
            try:
                RemoveFiles.remote('remove tmpfile', v['failoverhost'], tmpfile)
            except:
                pass

        #
        # MPP-10374:
        # If we are on a SAN, we need to verify that the failover hosts in san_config
        # have the WWN "device" of interest available to them.
        #
        # This is basically a repeat of the device loop above, but doing the opposite direction
        # lookup: we know we have a failoverhost/failovermp pair that looks valid, but does
        # the *device* map properly from primaryhost -> failoverhost.
        #
        # We skip this for NFS -- essentially making an assumption: a flat network.
        if opt['-t'] == 'e':
            missing_wwn = False
            for k, v in devmap.iteritems():
                san_key = (v['host'], v['mountpoint'])

                if not san_config.has_key(san_key):
                    raise Exception('Resolving final config: cannot find configuration for %s:%s' % (v['host'], v['mountpoint']))

                san_val = san_config[san_key]

                primaryhost = san_val['primaryhost']            
                failoverhost = san_val['failoverhost']
                failoverwwn = v['WWN']

                found = False
                
                # This parsing should be done in the command class, but it requires too much external info
                cmd = Inq.remote('inq', failoverhost)
                out = cmd.get_results().stdout.split('\n')
 
                # We're parsing the output of the "inq" utility here.
                # lines of interest look like:
                # "/dev/emcpowerbp  APM00091400579   B  172.16.10.6     0x006f   600601607e62220093afcb43752ddf11"
                # Where the last entry on that line is the WWN.
                for l in out:
                    x = l.strip().split()

                    if len(x) == 6 and x[0].startswith('/') and x[5] == failoverwwn:
                        found = True
                        break

                if not found:
                    missing_wwn = True
                    logger.info('Could not find WWN %s on failover host %s (primary host %s)' % (failoverwwn, failoverhost, primaryhost))

            if missing_wwn:
                logger.error('Could not find some WWN entries on failover hosts: invalid mapping.')
                raise Exception("Cannot resolve shared-storage location for failover on EMC-SAN")

        # At this point, all of the configuration information has been verified.

        # Now we have all of the information we need for gp_san_configuration, build a final dictionary
        # to store our work. As we go, we're going to add the failover-data-directory to devmap.
        final_map = {}
        map_id = 0
        
        for k, v in devmap.iteritems():
            san_key = (v['host'], v['mountpoint'])

            if not san_config.has_key(san_key):
                raise Exception('Resolving final config: cannot find configuration for %s:%s' % (v['host'], v['mountpoint']))

            san_val = san_config[san_key]
            
            primaryhost = san_val['primaryhost']
            primarymp = san_val['primarymp']
            failoverhost = san_val['failoverhost']
            failovermp = san_val['failovermp']

            # figure out the data-directory for this segment by substituting the failover
            # mountpoint prefix for the primary mountpoint.
            primary_datadir = v['datadir']
            v['failover_host'] = failoverhost
            v['failover_datadir'] = failovermp + primary_datadir[len(primarymp):]
            v['san_mount'] = map_id

            if opt['-t'] == 'n':
                device = v['device']
            elif opt['-t'] == 'e':
                # build up the device string from our pieces.

                device = 'WWN=' + v['WWN'] + ',SP=' + v['SPIP']

                if v.has_key('SG_NAME'):
                    new_device = device + ',SG_NAME=' + v['SG_NAME']
                    device = new_device
                # Got the entire device string
            else:
                raise Exception('Unknown device-type %s' % opt['-t'])

            final_map[map_id] = {'primaryhost':primaryhost, 'primarymp':primarymp, 'failoverhost':failoverhost, 'failovermp':failovermp, 'device':device}
            map_id = map_id + 1

        logger.info('Success.')

        # We now have two top-level dictionaries:
        # 
        # devmap is indexed by dbid and contains all of the specifics to the segment
        #   info for gp_segment_configuration *and* pg_filespace_entries indexed by dbid
        #   and references the other map by "map_id"
        #
        # final_map has all of the contents for gp_san_configuration. indexed by "id"
        #   as reference from devmap.

        # First: emit the san-configuration info.
        for k, v in final_map.iteritems():
            print('INSERT INTO GP_SAN_CONFIGURATION VALUES (%d, \'p\', \'%s\', \'%s\', \'%s\', \'%s\', \'%s\', \'%s\', \'%s\');' %
                            (k, opt['-t'], v['primaryhost'], v['primarymp'], v['device'], v['failoverhost'], v['failovermp'], v['device']))

        # THE NEXT TWO STEPS COULD BE DONE IN ONE LOOP -- BUT THAT SEEMS LIKE IT WOULD BE LESS CLEAR

        # Second: update the existing segments.
        for k, v in devmap.iteritems():
            print('UPDATE GP_SEGMENT_CONFIGURATION SET san_mounts = \'%s\' WHERE dbid=%d ;' % (v['san_mount'], k))

        # Third: add the new segments, along with their filespace-locations.
        new_dbid = max_dbid
        for k, v in devmap.iteritems():
            new_dbid = new_dbid + 1
            print('INSERT INTO GP_SEGMENT_CONFIGURATION VALUES (%d, %d, \'m\', \'m\', \'s\', \'u\', %d, \'%s\', \'%s\', NULL, \'%d\');' %
                            (new_dbid, v['content'], v['mirrorport'], v['failover_host'], v['failover_host'], v['san_mount']))
            print('INSERT INTO PG_FILESPACE_ENTRY SELECT fsefsoid, %d, \'%s\' FROM PG_FILESPACE_ENTRY WHERE fsedbid = %d ;' % (new_dbid, v['failover_datadir'], k))

        # Fourth: Modify the gp_fault_strategy setting.
        print('UPDATE GP_FAULT_STRATEGY SET fault_strategy = \'s\' ;')

        ########################
    except Exception, e:
        logger.error(e)

    sys.exit(0)

except KeyboardInterrupt:
    sys.exit('\nUser Interrupted')
finally:
    coverage.stop()
    coverage.generate_report()



