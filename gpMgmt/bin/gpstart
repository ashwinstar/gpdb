import os, sys

progname = os.path.split(sys.argv[0])[-1]

if sys.version_info < (2, 5, 0):
    sys.exit(
'''Error: %s is supported on Python versions 2.5 or greater
Please upgrade python installed on this machine.''' % progname)
    
import time
from optparse import Option, OptionGroup, OptionParser, OptionValueError, SUPPRESS_USAGE

try:
    import figleaf
    import pickle
    
    from gppylib.db import dbconn
    from gppylib.gpparseopts import OptParser, OptChecker
    from gppylib.gparray import GpArray
    from gppylib.gplog import *
    from gppylib import gphostcache
    from gppylib import userinput
    from gppylib.db import catalog
    from gppylib.commands import unix
    from gppylib.commands import gp
    from gppylib.commands import base
    from gppylib.commands import pg
    from gppylib import pgconf
    from gppylib.operations.startSegments import *
except ImportError, e:    
    sys.exit('Cannot import modules.  Please check that you have sourced greenplum_path.sh.  Detail: ' + str(e))



description = (""" 
Starts a GPDB Array.
""")

_help = [""" """]

EXECNAME = os.path.split(__file__)[-1]

DEFAULT_NUM_WORKERS=64

#---------------------------------------------------------------
class GpStartError(Exception): pass

#---------------------------------------------------------------
class GpStart:

    ######
    def __init__(self, restricted, start_standby, master_datadir,
                 parallel=DEFAULT_NUM_WORKERS,
                 quiet=False,
                 masteronly=False,
                 interactive=False):
        self.restricted=restricted
        self.start_standby=start_standby        
        self.pool = None
        self.parallel=parallel
        self.attempt_standby_start=False
        self.quiet=quiet
        self.masteronly=masteronly
        self.master_datadir=master_datadir
        self.interactive=interactive

        self.gpversion=None
        self.gparray=None
        self.port=None
        self.gphome=None
        self.dburl=None
        self.lc_collate=None
        self.lc_monetary=None
        self.lc_numeric=None
        logger.debug("Setting level of parallelism to: %d" % self.parallel)
        pass

    ######
    def system_start(self):
        self._prepare()

        self._startMaster()    
        logger.info("Master Started...")

        if not self.masteronly:
            logger.info("Shutting down master")
            cmd=gp.GpStop("Shutting down master", masterOnly=True, 
                          fast=True, quiet=logging_is_quiet(),
                          verbose=logging_is_verbose(),
                          datadir=self._get_master_datadir())
            cmd.run()
            logger.debug("results of forcing master shutdown: %s" % cmd)
            #TODO: check results of command.

            if self.interactive:
                self._summarize_actions()
                check_to_continue()

        if self.masteronly:
            pass                        
        else:
            success=self._start()

            if not success:
                return False

        return True

    ######
    def recover(self):
        ''' 
        Attempts to start any downed segments and bring them back into the GPDB 
        array.
        
        This is only to be used in read-only mode.          
        
        '''

        # Recover only worked in read-only mode, and thus is not really apropriate
        # with 3.4 filerep, and/or it needs to be reworked for the new method.
        #
        # Todo: determine the fate of this function and either remove the dead code
        # or rework to a new method.
        #
        # review source control from before 1/21/2010 to see the previous code
        #
        raise Exception("gpstart --recover no longer supported")

    ######
    def cleanup(self):
        if self.pool:
            self.pool.haltWork()

#------------------------------- Internal Helper --------------------------------

    ######
    def _prepare(self):
        logger.info("Gathering information and validating the environment...")
        self._basic_setup()

        if not self.masteronly:              
            gp.standby_check(self.master_datadir)

        self._check_version()
        self._check_master_running()

        if not os.path.exists(self.master_datadir + '/pg_log'):
            os.mkdir(self.master_datadir + '/pg_log')

    ######
    def _basic_setup(self):
        self.gphome=gp.get_gphome()
        if self.master_datadir is None:
            self.master_datadir=gp.get_masterdatadir()
        self.user=gp.get_user()                                    
        gp.check_permissions(self.user)                    
        self._read_postgresqlconf()

    ######
    def _get_master_datadir(self):
        return self.master_datadir

    ######
    def _read_postgresqlconf(self):
        logger.debug("Obtaining master's port from master data directory")
        pgconf_dict = pgconf.readfile(self.master_datadir + "/postgresql.conf")        
        self.port = pgconf_dict.int('port')        
        logger.debug("Read from postgresql.conf port=%s" % self.port)   
        self.max_connections = pgconf_dict.int('max_connections') 
        logger.debug("Read from postgresql.conf max_connections=%s" % self.max_connections)

    ######
    def _check_version(self):    
        self.gpversion=gp.GpVersion.local('local GP software version check',self.gphome)
        logger.info("local Greenplum Version: '%s'" % self.gpversion)

    ######
    def _check_master_running(self):
        logger.debug("Check if Master is already running...")
        if os.path.exists(self.master_datadir + '/postmaster.pid'):
            logger.warning("postmaster.pid file exists on Master, checking if recovery startup required")
            self._recovery_startup()

        self._remove_postmaster_tmpfile(self.port)

    ######
    def _recovery_startup(self):
        logger.info("Commencing recovery startup checks")

        lockfile="/tmp/.s.PGSQL.%s" % self.port
        tmpfile_exists = os.path.exists(lockfile)

        netstat_port_active = unix.PgPortIsActive.local('check netstat for master port',
                                                        lockfile, self.port)
        if tmpfile_exists and netstat_port_active:
            logger.info("Have lock file %s and a process running on port %s" % (lockfile,self.port))
            raise GpStartError("Master instance process running")
        elif tmpfile_exists and not netstat_port_active:
            logger.info("Have lock file %s but no process running on port %s" % (lockfile,self.port))            
        elif not tmpfile_exists and netstat_port_active:
            logger.info("No lock file %s but a process running on port %s" % (lockfile,self.port))
            pass
        elif not tmpfile_exists and not netstat_port_active:
            logger.info("No socket connection or lock file in /tmp found for port=%s" % self.port)

        logger.info("No Master instance process, entering recovery startup mode")

        if tmpfile_exists:
            logger.info("Clearing Master instance lock files")        
            os.remove(lockfile)

        postmaster_pid_file = "%s/postmaster.pid" % self.master_datadir
        if os.path.exists(postmaster_pid_file): 
            logger.info("Clearing Master instance pid file")
            os.remove("%s/postmaster.pid" % self.master_datadir)

        self._startMaster()

        logger.info("Commencing forced instance shutdown")

        gp.GpStop.local("forcing master shutdown", masterOnly=True, verbose=logging_is_verbose,
                        quiet=self.quiet, fast=False, 
                        force=True, datadir=self.master_datadir)

    ######
    def _remove_postmaster_tmpfile(self,port):
        lockfile="/tmp/.s.PGSQL.%s" % port
        tmpfile_exists = os.path.exists(lockfile)

        if tmpfile_exists:
            logger.info("Clearing Master instance lock files")
            os.remove(lockfile)
        pass

    ######
    def _summarize_actions(self):
        logger.info("--------------------------")
        logger.info("Master instance parameters")
        logger.info("--------------------------")
        logger.info("Database                 = %s" % self.dburl.pgdb )
        logger.info("Master Port              = %s" % self.port )
        logger.info("Master directory         = %s" % self.master_datadir )
        if self.gparray.standbyMaster:
            if self.start_standby:
                logger.info("Master standby start     = On")
            else:
                logger.info("Master standby start     = Off")
        else:
            logger.info("Master standby           = Off ")

        logger.info("--------------------------------------")
        logger.info("Segment instances that will be started")
        logger.info("--------------------------------------")

        format_string=self._get_format_string()
        logger.info(format_string % ("Host","Datadir","Port","Status"))
        for db in self.gparray.getSegDbList():
            hostname = db.getSegmentHostName()
            datadir = db.getSegmentDataDirectory()
            port = db.getSegmentPort()
            status = db.getSegmentStatus()
            logger.info(format_string % (hostname, datadir, port, status))

    ######
    def _get_format_string(self):
        host_len=0
        dir_len=0
        port_len=0
        for db in self.gparray.getSegDbList():
            if len(db.hostname) > host_len:
                host_len=len(db.hostname)
            if len(db.datadir) > dir_len:
                dir_len=len(db.datadir)
            if len(str(db.port)) > port_len:
                port_len=len(str(db.port))

        return "%-" + str(host_len) + "s  %-" + str(dir_len) + "s  %-" + str(port_len) + "s  %s"

    ######
    def _startMaster(self):    
        logger.info("Starting Master instance in admin mode")
        dbid = -1
        numContentsInCluster = 0
        cmd=gp.MasterStart('master in utility mode',self.master_datadir,self.port,dbid, numContentsInCluster,utilityMode=True)
        cmd.run()

        if cmd.get_results().rc != 0:
            logger.fatal("Failed to start Master instance in admin mode")
            cmd.validate()

        logger.info("Obtaining Greenplum Master catalog information")

        logger.info("Obtaining Segment details from master...")
        self.dburl = dbconn.DbURL(port=self.port,dbname='template1')
        self.gparray = GpArray.initFromCatalog(self.dburl, utility=True)

        logger.debug("Gathering collation settings...")
        self.conn = dbconn.connect(self.dburl, utility=True)
        (self.lc_collate,self.lc_monetary,self.lc_numeric)=catalog.getCollationSettings(self.conn)

        self.ftsmode = catalog.getSessionGUC(self.conn,'gp_fault_action')
        logger.debug("FTS Mode: %s" % self.ftsmode)

        self.conn.close()
        pass

    ######
    def _start(self):     
        """ starts the standby master, all of the segments, and the master
            
            returns whether all segments were started successfully 
        """
        workers=min(len(self.gparray.get_hostlist()),self.parallel)
        self.pool = base.WorkerPool(numWorkers=workers)

        if os.path.exists(self.master_datadir + "/gpexpand.status") and not self.restricted:            
            raise GpStartError("Found a System Expansion Setup in progress. Please run 'gpexpand --rollback'")

        self.standby_was_started = self._start_standby()
        (segmentsToStart, invalidSegments, inactiveSegments) = self._prepare_segment_start()

        strategy = self.gparray.strategy[0]
        logger.debug("Strategy in gparray is %s" % strategy)

        # todo: MIRRROING: push _prepare_segment_start behavior into StartSegmentsOperation???
        # The SAN ('s') failover strategy leaves the mirrors shutdown until they're needed.
        # so we don't want to start them -- SAN-start works just like a mirror-less start.
        if self.gparray.get_mirroring_enabled() and strategy != 's':
            startMode = START_AS_PRIMARY_OR_MIRROR
        else: startMode = START_AS_MIRRORLESS

        segmentStartResult = StartSegmentsOperation(self.pool,self.quiet,
                [self.lc_collate,self.lc_monetary,self.lc_numeric], self.gpversion,
                self.gphome, self.master_datadir
                ).startSegments(self.gparray, segmentsToStart, startMode)

        # process the result of segment startup
        self._print_segment_start(segmentStartResult, invalidSegments, inactiveSegments )

        # make sure we have at least one segment per content
        # todo MIRRORING: what is right check in mirror mode?  See code before 1/21/2010
        if not self._verify_enough_segments(segmentStartResult,self.gparray):
            # go through and remove any segments that we did start so that we keep everything
            # shutdown cleanly
            self._shutdown_segments(segmentStartResult)
            raise GpStartError("Do not have enough valid segments to start the array.")

        hadSegmentFailuresOrInactive = len(segmentStartResult.getFailureReasons()) > 0 or \
                                       len(invalidSegments ) > 0
        self._start_final_master(hadSegmentFailuresOrInactive)
        self.cleanup()

        if len(segmentStartResult.getFailedSegments()) == 0:
            return True
        else:
            return False

    ######
    def _prepare_segment_start(self):
        segs = self.gparray.get_valid_segdbs()

        logger.debug("gp_segment_configuration indicates following valid segments")
        for seg in segs:
            logger.debug("SegDB: %s" % seg)

        # segments marked down
        invalid_segs=self.gparray.get_invalid_segdbs() 
        for seg in invalid_segs:
            hostname = seg.getSegmentHostName()
            datadir = seg.getSegmentDataDirectory()
            logger.warning("Skipping startup of segdb on %s directory %s marked invalid <<<<<" % (hostname, datadir)) 

        # mirrors that should not be started
        inactive_mirrors=self.gparray.get_inactive_mirrors_segdbs()
        if len(inactive_mirrors) > 0:
            logger.debug("Found %d inactive mirrors, skipping" % len(inactive_mirrors))

        # now produce the list of segments to actually start
        dbIdsToNotStart = {}
        for segment in invalid_segs:
            dbIdsToNotStart[segment.getSegmentDbId()] = True
        for segment in inactive_mirrors:
            dbIdsToNotStart[segment.getSegmentDbId()] = True

        logger.debug("dbIdsToNotStart has %d entries" % len(dbIdsToNotStart))

        toStart = [seg for seg in segs if dbIdsToNotStart.get(seg.getSegmentDbId()) is None]
        return (toStart, invalid_segs, inactive_mirrors)

    ####    
    def _verify_enough_segments(self,startResult,gparray):
        contentDict = GpArray.getSegmentsByContentId(startResult.getSuccessfulSegments())

        for seg in gparray.getSegDbList():
            if contentDict.get(seg.getSegmentContentId()) is None:
                logger.error("No segment started for content: %d." % seg.getSegmentContentId())
                logger.info("dumping success segments: %s" % [s.__str__() for s in startResult.getSuccessfulSegments()])
                return False
        return True

    ######
    def _get_invalid_segments(self):
        invalid_segs = self.gparray.get_invalid_segdbs()

        if len(invalid_segs) == 0:
            logger.info("No segments marked as invalid")
        else:
            for db in invalid_segs:
                logger.warning("Skipping segment as its marked invalid. Segment has "
                               "dbid=%s content=%s on host=%s with datadir=%s " %\
                               (db.dbid,db.content,db.hostname,db.datadir) )
        return invalid_segs        

    ######  
    def _shutdown_segments(self,segmentStartResult):

        # todo MIRRORING: this needs to shutdown in proper order (call fn from gpstop)
        logger.info("Commencing parallel segment instance shutdown, please wait...")

        segmentsByHost = GpArray.getSegmentsByHostName(segmentStartResult.getSuccessfulSegments())
        dispatch_count=0
        for hostName, segments in segmentsByHost.iteritems():
            #TODO:  future optimization would be to only stop the segments that we actually started.
            logger.debug("Dispatching command to shutdown segments on host: %s" % hostName)
            cmd=gp.GpSegStopCmd("remote segment starts on host '%s'" % hostName, self.gphome,self.gpversion,
                                mode='immediate', dbs=segments, verbose=logging_is_verbose(),ctxt=base.REMOTE, remoteHost=hostName)
            self.pool.addCommand(cmd)
            dispatch_count+=1

        self.pool.wait_and_printdots(dispatch_count,self.quiet)    
        pass

    ######
    def _print_segment_start(self, segmentStartResult, invalidSegments, inactiveSegments):
        """
        Print the results of segment startup

        segmentStartResult is the StartSegmentsResult from the actual start
        invalidSegments are those that we didn't even try to start because they are marked as down or should otherwise
           not be started
        """
        failedSegments = segmentStartResult.getFailedSegments()
        failureReasons = segmentStartResult.getFailureReasons()

        started = len(segmentStartResult.getSuccessfulSegments())
        failed = len(failedSegments)
        totalTriedToStart = started + failed

        if failed > 0 or logging_is_verbose():             
            logger.info("----------------------------------------------------")
            if failed > 0:
                for i in range(len(segmentStartResult.getFailedSegments())):
                    segment = failedSegments[i]
                    reason = failureReasons[i]
                    logger.info("DBID:%d  FAILED  host:'%s' datadir:'%s' with reason:'%s'" % (
                                segment.getSegmentDbId(), segment.getSegmentHostName(),
                                segment.getSegmentDataDirectory(), reason))
            for segment in segmentStartResult.getSuccessfulSegments():
                logger.debug("DBID:%d  STARTED" % segment.getSegmentDbId())
            logger.info("----------------------------------------------------\n\n")

        flag=""
        if failed > 0:
            flag="<<<<<"
        logger.info("----------------------------------------------------")
        logger.info("Total processes marked as completed             = %d" % started)
        logger.info("Total processes marked as failed                = %d %s" % (failed,flag))
        logger.info("----------------------------------------------------")
        if len(invalidSegments ) > 0:
            logger.warning("Total instances marked invalid and bypassed  = %d <<<<< " % len(invalidSegments))
        else:
            logger.info("Total instances marked invalid and bypassed     = 0 ")

        logger.info("Successfully started %d of %d segment instances %s" % (started,totalTriedToStart,flag))
        logger.info("----------------------------------------------------")

        if failed > 0:
            logger.warning("Segment instance startup failures reported")
            logger.warning("Failed start %d of %d segment instances %s" % (failed,totalTriedToStart,flag))
            logger.warning("A total of %d errors were encountered" % failed)
            logger.warning("Review %s" % get_logfile())
            logger.warning("For more details on segment startup failure(s)")
            logger.warning("Run gpstate to review current segment instance status")
            logger.info("----------------------------------------------------")
        if len(invalidSegments) > 0:
            logger.warning("****************************************************************************")
            logger.warning("There are        %d segment(s) marked as invalid" % len(invalidSegments))
            logger.warning("The GPDB gp_fault_action parameter is set to continue in the event of failure")
            logger.warning("To recover from this current invalid state, review usage of gprecoverseg")
            logger.warning("management utility, which will recover failed segment instance databases")
            logger.warning("As gp_fault_action is set to continue, recovery will need to shutdown the")
            logger.warning("GPDB database to ensure a consistent recovery can be completed")
            logger.warning("****************************************************************************")


    ######
    def _start_final_master(self, hadSegmentFailuresOrInactive):
        ''' Last item in the startup sequence is to start the master. 

            After starting the master we connect to it.  This is done both as a check that the system is 
            actually started but its also done because certain backend processes don't get kickstarted
            until the first connection.  The DTM is an example of this and it allows those initialization
            messages to end up in the gpstart log as opposed to the user's psql session.
        '''
        if self.restricted:
            restrict_txt = "in RESTRICTED mode"
        else:
            restrict_txt = ""
        logger.info("Starting Master instance %s directory %s %s" % (self.gparray.master.hostname, self.master_datadir, restrict_txt))

        numContentsInCluster = self.gparray.getNumSegmentContents()
        gp.MasterStart.local("Starting Master instance",self.master_datadir,self.port,
                             self.gparray.master.dbid, numContentsInCluster,
                             restrictedMode=self.restricted,max_connections=self.max_connections,
                             disableMasterMirror=(not self.start_standby) )

        if pg.DbStatus.local('master instance',self.gparray.master):
            logger.info("Command pg_ctl reports Master %s instance active" % self.gparray.master.hostname)

            try:
                masterconn = dbconn.connect(self.dburl)
                masterconn.close()
            except Exception,e:
                ''' we do nothing here since certain fts scenarios will trigger initial connection failures
                    and other goodies.
                '''
                logger.debug("Encountered problem while connecting to master: %s" % str(e))
                pass

            standby_failure=not self.standby_was_started and self.attempt_standby_start

            if standby_failure:
                logger.warning("Standby Master could not be started")
            if standby_failure or hadSegmentFailuresOrInactive:
                logger.warning("Database started but warnings generated       <<<<<")
                logger.info("Check status of database with gpstate utility")
            else:            
                logger.info("Database successfully started with no errors reported")
        else:
            logger.warning("Command pg_ctl reports Master %s on port %d not running" % (self.gparray.master.datadir,self.gparray.master.port)) 


    ######
    def _start_standby(self):
        ''' used to start the standbymaster if necessary.  
                
            returns if the standby master was started or not
        '''
        if self.start_standby and self.gparray.standbyMaster is not None:
            try:
                self.attempt_standby_start=True
                host=self.gparray.standbyMaster.hostname
                datadir=self.gparray.standbyMaster.datadir
                port=self.gparray.standbyMaster.port
                return gp.start_standbymaster(host,datadir,port)                                    
            except base.ExecutionError, e:
                logger.warning("Error occured while starting the standby master: %s" % e)
                return False
        else:
            logger.info("No standby master configured.  skipping...")
            return False

#----------------------- Command line option parser ----------------------
def parseargs():
    parser = OptParser(option_class=OptChecker,
                description=' '.join(description.split()),
                version='%prog version $Revision$')
    parser.setHelp(_help)
    parser.set_usage('%prog [--help] [--version] [--usage] [options] ')
    parser.remove_option('-h')

    parser.add_option('-h', '-?', '--help', action='help',
                        help='show this help message and exit')
    parser.add_option('-v','--verbose', action='store_true',
                        help='debug output.')
    parser.add_option('--usage', action="briefhelp")

    optgrp2 = OptionGroup(parser, 'Logging options: ')
    parser.add_option_group(optgrp2)
    optgrp2.add_option('-a', dest="interactive" , action='store_false',default=True,
                        help="quiet mode, do not log progress to screen"\
                             "[default:- verbose output to screen]")                          
    optgrp2.add_option('-q', '--quiet', action='store_true',
                        help='suppress status messages')

    optgrp2.add_option('-l', '--logfile_directory', type='string', default=None,
                       help="The directory to write the log file. Defaults to ~/gpAdminLogs.")

    optgrp4 = OptionGroup(parser, 'Connection options: ')
    parser.add_option_group(optgrp4)
    optgrp4.add_option('-d', '--master_data_directory', type='string', default=None, metavar="<DATA DIRECTORY>",
                       help="Optional. The master host data directory. If not specified, the value set"\
                            "for $MASTER_DATA_DIRECTORY will be used.")
    optgrp4.add_option('--recover', action="store_true", default=False, 
                        help="attempt to start any downed segments if in read-only mode")

    optgrp3 = OptionGroup(parser, 'Database startup options: ')
    parser.add_option_group(optgrp3)
    optgrp3.add_option('-m', '--master_only', action='store_true',
                        help='start master instance only in maintenance mode')    
    optgrp3.add_option('-y', '--no_standby', dest="start_standby", action='store_false',default=True,
                        help='do not start master standby server')
    optgrp3.add_option('-B', '--parallel', type="int", default=64, metavar="<parallel_processes>",
                        help='number of segment hosts to run in parallel. Default is %d' % DEFAULT_NUM_WORKERS)    
    optgrp3.add_option('-R', '--restricted', action='store_true',
                        help='start in restricted mode. Only users with superuser privilege are allowed to connect.')

    parser.set_defaults(verbose=False, filters=[], slice=(None, None))

    # Parse the command line arguments
    (options, args) = parser.parse_args()

    proccount=os.environ.get('GP_MGMT_PROCESS_COUNT')    
    if options.parallel == 64 and proccount is not None:
        options.parallel = int(proccount)

    #-n sanity check
    if options.parallel > 128 or options.parallel < 1:
        parser.print_help()
        parser.exit()

    if len(args) > 0:
        parser.print_help()
        parser.exit()

    return options, args

#------------------------------- Mainline --------------------------------
def check_to_continue():    
    msg = "\nContinue with Greenplum instance startup"                
    ans = userinput.ask_yesno(None,msg,'N')    

    if not ans:
        logger.info("User abort requested, Exiting...")
        sys.exit(4)
    pass

def main():
    options_parsed=False
    use_figleaf=os.getenv('USE_FIGLEAF', None)

    if use_figleaf:
        figleaf.start()

    gpstart = None
    try:
        options, args = parseargs()
        options_parsed=True
        setup_tool_logging(EXECNAME, unix.getLocalHostname(), unix.getUserName(), options.logfile_directory)

        if options.verbose:
            enable_verbose_logging()

        if options.quiet:
            quiet_stdout_logging()

        if options.master_data_directory:
            options.master_data_directory=os.path.abspath(options.master_data_directory)

        logger.info("Starting gpstart with args: '%s'" % ' '.join(sys.argv[1:]))

        gpstart = GpStart(options.restricted,
                          options.start_standby,
                          master_datadir=options.master_data_directory,
                          parallel=options.parallel,
                          quiet=options.quiet,
                          masteronly=options.master_only,
                          interactive=options.interactive)

        if options.recover:
            gpstart.recover()
            sys.exit(0)
        else:
            if gpstart.system_start():
                sys.exit(0)
            else:
                sys.exit(1)

    except base.ExecutionError, e:
        logger.fatal("Error occurred: %s\n Command was: '%s'\n"
                     "rc=%d, stdout='%s', stderr='%s'" %\
                     (e.summary,e.cmd.cmdStr, e.cmd.results.rc, e.cmd.results.stdout,
                     e.cmd.results.stderr ))
        sys.exit(4)
    except Exception, e:                
        if not options_parsed:
            logger.exception("gpstart failed. exiting...")
        else:
            if options.verbose:
                logger.exception("gpstart failed.  exiting..." )
            else:
                logger.fatal("gpstart failed. (Reason='%s') exiting..." % e)

        if gpstart:
            gpstart.cleanup()
        sys.exit(3)
    except KeyboardInterrupt:
        if gpstart:
            gpstart.cleanup()        
        sys.exit('\nUser Interrupted')
    finally:
        if use_figleaf:
            figleaf.stop()
            figleaf.write_coverage(os.path.expanduser("~") + '/.figleaf',append=True)


logger = get_default_logger()
if __name__ == '__main__':
    main()
