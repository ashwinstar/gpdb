#!/usr/bin/env python
'''
Usage: gpdetective <option> [dbname]

	-? 
	-h host	   : DB host name
	-p port    : DB port number
	-P passwd  : DB password
	-U uname   : DB User Name

'''
#============================================================
import sys, os, glob, tempfile, subprocess, re, getopt
VERSION = '$Revision$'
sys.path.append(sys.path[0] + '/lib')
try: 
    import pg8000
except ImportError, e:
    sys.exit('Error: unable to import module: ' + str(e))

#============================================================
def usage(exitarg = None):
    '''
    Print usage information and exit
    '''
    print __doc__
    sys.exit(exitarg)

#============================================================
class GPDetective():
    '''
    GPDetecive main class
    '''
    opt    = {}         # Command line options
    db     = 'postgres' # Default database
    master = None       # Database connection to master
    olddir = None       # Directory script was executed from
    logdir = None       # Temporary directory
    errlog = None       # Error log

    # Configuration information
    masterdir = None
    hosts     = []
    segments  = []
    mirrors   = []
    databases = []

    #------------------------------------------------------------
    def __init__(self): 
        '''
        Initialize the Greenplum Detective
          1) Extract command line arguments
          2) Establish connection to master database
          3) Create Logging Directory
          4) Create error file
        '''
        self.olddir = os.getcwd()
        if not os.access('.', os.W_OK):
            sys.exit("No write permission to current directory")

        # Get default option values from enviornment
        self.opt = {
            '-h': os.environ.get('PGHOST') or 'localhost',
            '-P': os.environ.get('PGPASSWORD'),
            '-U': os.environ.get('USER'),
            '-p': os.environ.get('PGPORT'),
            }

        # Override defaults based on command line options
        try:
            (options, args) = getopt.getopt(sys.argv[1:], '?h:p:P:U')
            for (switch, val) in options:
                if   switch == '-?':	   usage(0)
                elif switch[1] in 'hpPU':  self.opt[switch] = val
        except Exception, e:
            usage('Error: ' + str(e))

        # If still no default port, resort to other methods
        if not self.opt['-p']:
            psql = subprocess.Popen(['psql', '-?'], stdout=subprocess.PIPE)
            port = subprocess.Popen(['grep', 'PORT'], stdin=psql.stdout,
                                    stdout=subprocess.PIPE)
            line = port.communicate()[0]
            port_re = re.compile('.*default: "(\d+)"')
            m = port_re.match(line)
            if not m: exit('Error: Could not determine PORT')
            self.opt['-p'] = m.group(1)

        # Make sure port is actually an integer
        try: self.opt['-p'] = int(self.opt['-p'])
        except ValueError: exit('Error: Could not determine PORT')

        # Connect to master
        self.master = self.connect(db=self.db)

        # Setup the log directory
        self.logdir = tempfile.mkdtemp()
        os.chdir(self.logdir)
        self.errlog = open('error.log', 'w')

    #------------------------------------------------------------
    def __del__(self):
        '''
        Cleanup open connections and remove temporary files
        '''
        if self.olddir: os.chdir(self.olddir)
        if self.master: self.master.close()
        if self.errlog: self.errlog.close()
        if self.logdir: subprocess.call(['rm', '-rf', self.logdir])


    #------------------------------------------------------------
    def connect(self, user=None, password=None,host=None, port=None, db=None):
        '''
        Establish a connection to the Greenplum database
        '''
        user = user or self.opt['-U']
        host = host or self.opt['-h']
        port = port or self.opt['-p']
        db   = db   or self.opt['-U']
        return pg8000.Connection(user=user, password=password, 
                                 host=host, port=port, database=db)

    #------------------------------------------------------------
    def writeCmd(self, filename, cmd):
        '''
        Execute a shell command and dumps the results to the
        specified file.
        '''
        self.errlog.write('CMD: ')
        for i in cmd:
            self.errlog.write(str(i) + ' ')
        self.errlog.write("\n")
        self.errlog.flush()

        if filename:
            path = "%s/%s" % (self.logdir, filename)
            file = open(path, 'w')
        else:
            file = self.errlog
        try:
            x = subprocess.call(cmd, stdout=file, stderr=self.errlog)
        except Exception, e:
            self.errlog.write("Error: " + str(e) + "\n");
            self.errlog.flush()

        if filename: 
            file.close()

    #------------------------------------------------------------  
    def writeSelect(self, filename, query):
        '''
        Execute a sql query and dump the results to the specified file.
        '''
        self.errlog.write('SQL: ' + query)
        self.errlog.flush()

        try:
            self.master.execute(query)
        except Exception, e:
            self.errlog.write("Error: " + str(e) + "\n");
            self.errlog.flush()
            return

        d = self.master.row_description
        path = "%s/%s" % (self.logdir, filename)
        file = open(path, 'w')
        for column in d:
            file.write(column['name'] + " |")
        file.write("\n")
        for tuple in self.master.iterate_tuple():
            for item in tuple:
                file.write(str(item))
                file.write(" |")
            file.write("\n")
        file.close()

   #------------------------------------------------------------  
    def writeArray(self, filename, itemlist):
        '''
        Writes an array to a specified file
        '''
        path = "%s/%s" % (self.logdir, filename)
        file = open(path, 'w')
        for item in itemlist:
            file.write(str(item) + "\n")
        file.close()

    #------------------------------------------------------------  
    def select(self, query):
        '''
        Execute a SQL query and return an array of result rows
           + Single columns will be returned as an array of values
           + Multiple columns will be returned as an array of tuples
        '''
        rows = []
        self.master.execute(query)
        for tuple in self.master.iterate_tuple():
            if len(tuple) == 1: 
                rows.append(tuple[0])
            else: 
                rows.append(tuple)
        return rows
    
    #------------------------------------------------------------  
    def getConfiguration(self):
        '''
        Collect configuration information
        '''
        print('  + Configuration ')

        # Master directory
        rows = self.select(
        '''
           SELECT datadir 
           FROM   gp_configuration 
           WHERE  content = -1  AND  definedprimary
        ''')
        self.masterdir = rows[0]

        # List of hosts
        self.hosts = self.select(
        '''
           SELECT distinct hostname
           FROM   gp_configuration
           WHERE  content >= 0
        ''')

        # list of segments
        self.segments = self.select(
        '''
           SELECT hostname || ':' || datadir FROM gp_configuration
           WHERE  content >= 0  AND  definedprimary
        ''')

        # list of mirrors
        self.mirrors = self.select(
        '''
           SELECT hostname || ':' || datadir FROM gp_configuration
           WHERE  content >= 0  AND  not definedprimary
        ''')

        # list of databases
        self.databases = self.select(
        '''
           SELECT datname FROM pg_database
           WHERE  datname not in ('template0', 'template1')
        ''')

        self.writeArray('hosts', self.hosts)
        self.writeSelect('config.log', 
        '''
           SELECT * from gp_configuration
        ''')



    #------------------------------------------------------------
    def copyLogs(self):
        '''
        1. Copy logfiles from master and all segments
        2. Copy postgresql.conf from master and all segments
        3. Remove duplicate postgresql.conf files
        '''
        print('  + Logfiles')

        # Grab master log and postgresql.conf
        path_rx = re.compile('.*/([^/]*)')
        m = path_rx.match(self.masterdir)
        self.writeCmd(None, ['cp', 
                             '%s.log' % self.masterdir, 
                             'master_%s.log' % m.group(1)])
        self.writeCmd(None, ['cp', 
                             '%s/postgresql.conf' % self.masterdir, 
                             'postgresql_master.conf'])

        # Grab segment logs and postgresql.conf        
        host_rx = re.compile('(.*)\:.*/([^/]*)')
        for seg in self.segments:
            m = host_rx.match(seg)
            self.writeCmd(None, ['scp', '-q', 
                                 '%s.log' % seg, 
                                 '%s_%s.log' % m.group(1,2)])
            self.writeCmd(None, ['scp', '-q', 
                                 '%s/postgresql.conf' % seg,
                                 'postgresql_%s_%s.conf' % m.group(1,2)])
        
        # Remove duplicate postgresql.conf files
        files = glob.glob(self.logdir+'/postgresql*.conf')
        conf = []
        for f in files:
            m = 0
            for c in conf:
                x = subprocess.Popen(['diff', '-q', f, c], 
                                     stdout=subprocess.PIPE)
                d = x.communicate()[0]
                if not d:
                    subprocess.call(['rm', f])
                    m = 1
                    break
            if m == 0:
                conf.append(f)


    #------------------------------------------------------------
    def systemInfo(self):
        '''
        1. Run gpstate
        2. Run gpcheckos
        '''
        print "  + Run gpstate";
        self.writeCmd('gpstate_mirrors.log',        ['gpstate', '-m'])
        self.writeCmd('gpstate_standby_master.log', ['gpstate', '-f'])
        self.writeCmd('gpstate_master.log',         ['gpstate', '-d'])
    
        print "  + Run gpcheckos";
        self.writeCmd('gpcheckos_master.log',   ['gpcheckos', '-m'])
        self.writeCmd('gpcheckos_segments.log', ['gpcheckos', '-f', 'hosts'])


    #------------------------------------------------------------
    def checkCatalog(self):
        '''
        1. Run gpcheckcat
        2. pg_dump all databases
        3. Run other catalog queries
        '''
        print "  + Catalog tables";

        self.writeCmd('gpcheckcat.log', ['gpcheckcat'])

        for db in self.databases:
            self.writeCmd('pg_dump_' + db, ['pg_dump', '-s', db])

        self.writeSelect('catalog_q1.log', 
        '''
           SELECT nspname || '.' || relname, attname, s.* 
           FROM   pg_class c, 
                  pg_namespace n, 
                  pg_attribute a, 
                  pg_statistic s 
           WHERE  n.oid = c.relnamespace 
             AND  c.oid = a.attrelid 
             AND  c.oid = s.starelid 
             AND  a.attnum = s.staattnum 
          ORDER BY 1, 2
        ''')

    #------------------------------------------------------------
    def crashReport(self):
        '''
        Find core files and extract useful information
           + Stack Traces
           + Local variables of current stack frame
           + Offending statement
        '''
        pass
    
    #------------------------------------------------------------
    def runExtensions(self):
        '''
        Run any extensions in $GPHOME/share/gpdetective
           + Skips tests if the directory is word writeable
           + Skips any test that is word writeable
           + Runs any .sql file on the master database
           + Executes any executable file
              * stdout is directed to 'ext_file.log'
              * stderr is directed to self.errlog
        '''
        print "  + Run extensions"
        gphome = os.environ.get('GPHOME')
        if not gphome:
            print "    - skipped: env{GPHOME} not set"
            return
        ext  = gphome + '/share/gpdetective'
        try:
            stat_info = os.stat(ext)
            files     = os.listdir(ext)
        except OSError:
            return     # directory doesn't exist
        if stat_info.st_mode & 0x002:
            print "    - skipped: a+w on " + ext
            return
        re_sql = re.compile('(.*)\.sql')
        for f in files:
            path = ext + '/' + f
            stat_info = os.stat(path)
            if stat_info.st_mode & 0x002:
                print "    - %s [skipped]: global write permission" % f
                continue
            if not os.access(path, os.R_OK):
                print "    - %s [skipped]: no execute permission" % f
                continue
            m = re_sql.match(f)
            if m:
                print "    + " + f
                self.writeCmd('ext_' + f + '.log',
                         ['psql', '-aX', '-d', self.db,
                          '-U', self.opt['-U'],
                          '-h', self.opt['-h'],
                          '-p', self.opt['-p'],
                          '-f', path])
                continue
            if not os.access(path, os.X_OK):
                print "    - %s [skipped]: no execute permission" % f
                continue
            print "    + " + f
            self.writeCmd('ext_' + f + '.log', [path])

    #------------------------------------------------------------
    def makeTar(self):
        '''
        Creates a tar archive from the files in the temporary logdir
        '''
        self.errlog.close();
        self.errlog = None

        x = subprocess.Popen(['date', '+%Y%m%d%H%M%S'], stdout=subprocess.PIPE)
        timestamp = x.communicate()[0]
        tarfile = 'gpdetective' + timestamp.strip() + '.tar'
        print "  + Producing " + tarfile
        tarcmd = ['tar', '-cjf', tarfile];
        tarcmd.extend(os.listdir('.'))
        x = subprocess.call(tarcmd)
        x = subprocess.call(['cp', tarfile, self.olddir])

#================================================================

d = GPDetective()
print 'Collecting information'
d.getConfiguration()
d.copyLogs()
d.systemInfo()
d.checkCatalog()
d.crashReport()
d.runExtensions()
d.makeTar()
print 'Done'

exit(0);
