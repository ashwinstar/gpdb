#!/usr/bin/perl

use strict;
use warnings;

=head1 NAME

B<gpdetective> - Greenplum diagnostic detective

=head1 SYNOPSIS

B<gpdetective> [OPTIONS] -c gp_config_file 

=head1 OPTIONS

=over 8

=item B<-help>             : Print a brief help message and exits.

=item B<-man>              : Print the manual page and exits.

=item B<-c gp_config_file> : The Greenplum configuration file

=back

=head1 DESCRIPTION

Runs a collection of scripts and utilities to capture information about
an installation for diagnostic analysis.

Produces a file name gpdetective.tar.gz in the current directory.

=cut

# Version updated by CVS
my $version = '$Revision$';
$version =~ s/.*\#(\d*).*/$1/;
$version = (100+$version)/100.0;

my $debug = 1;

# ---------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------
my ($help, $man, $config, $askversion);
use Pod::Usage;
use Getopt::Long;
use File::Copy;
use Cwd;
use POSIX qw(tmpnam);

GetOptions('help|?' => \$help,
	       'man' => \$man,
		   'version' => \$askversion,
		   'c=s' => \$config)
or pod2usage(2);
pod2usage(-exitstatus => 1) if $help;
pod2usage(-exitstatus => 0, -verbose => 2) if $man;
if ($askversion) {
	print "gpdetective version: $version\n";
	exit(0);
}

# ---------------------------------------------------------------------
# Check input for problems
# ---------------------------------------------------------------------
die "No write permission for output: ./\n" unless (-w '.');
die "Please specify a configurationn file: -c gp_config_file\n" unless ($config);
die "$config does not exist\n" unless (-e $config);
die "$config is not a file\n" unless (-f $config);
die "Can not read file: $config\n" unless (-r $config);

my $gphome = $ENV{GPHOME};
die "Enviornment variable GPHOME is not set\n" unless (defined $gphome);
my $PSQL      = "$gphome/bin/psql";
my $PG_DUMP   = "$gphome/bin/pg_dump";
my $GPSTATE   = "$gphome/bin/gpstate";
my $GPCHECKOS = "$gphome/bin/gpcheckos";
my $GPSSH     = "$gphome/bin/gpssh";
my $GPSCP     = "$gphome/bin/gpscp";

print "Collecting information:\n";

# ---------------------------------------------------------------------
# read the config file and extract useful stuff.
# ---------------------------------------------------------------------
my ($hostfile, $prefix, $master, @segment);
{
	print "  + configuration file\n";
	open CONFIG, "<$config";
	while (<CONFIG>) {
		next if (/^\s*(\#.*)?$/);  # blank lines, comment lines
		$hostfile = $1 if (/^\s*MACHINE_LIST_FILE=(.*)$/);
		$prefix = $1 if (/^\s*SEG_PREFIX=(.*)$/);
		$master = $1 if (/^\s*MASTER_DIRECTORY=(.*)$/);
		if (/DATA_DIRECTORY=\(([^\)]*)(\)?)\s*$/) {
			my $segments = $1;
			chomp($segments);
			while ($2 ne ")" and $_ = <CONFIG>) {
				$segments .= " $1" if (/\s*([^\)]*)(\)?)\s*$/);
				chomp($segments);
			}
			@segment = split(" ", $segments);
		}
	}
	close CONFIG;
}

if ($debug) {
	print "HOSTFILE = $hostfile\n";
	print "PREFIX = $prefix\n";
	print "MASTER = $master\n";
	print "SEGMENTS = $#segment [@segment]\n";
}


# ---------------------------------------------------------------------
# Get the list of hosts
# ---------------------------------------------------------------------
my @host;
{
	print "  + hostfile\n";
	die "Can not read hostfile: $hostfile\n" unless (-r $hostfile);
	open HOSTFILE, "<$hostfile";
	while (<HOSTFILE>) {
		chomp;
		push @host, $_;
	}
	if ($debug) {
		print "HOSTS = $#host [@host]\n";
	}
	close HOSTFILE;
}

# ---------------------------------------------------------------------
# From now on we don't want to die without cleaning up
# ---------------------------------------------------------------------
my $logs = tmpnam();
my $cwd  = cwd();
mkdir $logs;
chdir $logs;
copy($config,$logs);
copy($hostfile,$logs);


# ---------------------------------------------------------------------
# General
# 1) Grab log files from all segments
# 2) postgresql.conf from master + 1 segment
# 3) postgresql.conf from segments with different files
# ---------------------------------------------------------------------

# Grab log file and postgres.conf from master
{
	print "  + master_$prefix-1.log\n";
	copy("$master/$prefix-1.log", "$logs/master_$prefix-1.log");
	copy("$master/$prefix-1/postgresql.conf", "$logs/postgresql_master.conf");
}

# Grab files from segments
{
	print "  + segment_$prefix.log\n";
	foreach my $host (@host) {
		for (my $d = 0; $d <= $#segment; $d++) {
			my $seg = $segment[$d];
			
			# Grab log file
			system(qq[scp -q $host:$seg/$prefix$d.log ] .
				   qq[$logs/$host\_$prefix$d.log ] .
				   qq[2>>$logs/error.log]);
			
			# Grab postgresql.conf file
			system(qq[scp -q $host:$seg/$prefix$d/postgresql.conf ] .
				   qq[$logs/postgresql\_$host\_$prefix$d.conf ] .
				   qq[2>>$logs/error.log]);
		}
	}
}

# ---------------------------------------------------------------------
# Run diffs on postgresql.conf files
# ---------------------------------------------------------------------
{
	print "  + postgres.conf\n";
	my $i;
	my @conf = ();
	my @files = <$logs/*.conf>;
	foreach my $file (@files) {
		for ($i = 0; $i <= $#conf; $i++) {
			my $d = `diff -q $file $conf[$i]`;
			if ($d =~ /^\s*$/) {
				unlink($file); # delete matching postgresql.conf file
				last;
			}
		}

		# If it didn't match any files, add it to the list of files to
		# compare against.
		push @conf, $file if ($i > $#conf);
	}
}

# ---------------------------------------------------------------------
# Catalog
# ---------------------------------------------------------------------
{
	print "  + catalog tables\n";
	system(qq[ $PG_DUMP -s postgres > $logs/pg_dump.log ]  .
		   qq[2>>$logs/error.log]);
	my $query = 
		qq[select nspname || '.' || relname, attname, s.* ] .
		qq[from pg_class c, pg_namespace n, pg_attribute a, pg_statistic s ] .
		qq[where n.oid = c.relnamespace and c.oid = a.attrelid and ] .
		qq[c.oid = s.starelid and a.attnum = s.staattnum order by 1, 2];
	system(qq[$PSQL -aX -d postgres -c "$query"  > $logs/catalog_q1.log] .
		   qq[ 2>> $logs/error.log]);
}




# ---------------------------------------------------------------------
# System
# 5) postgres executable size, checksum, version from master
# 6) kernel and filesytem information from master
# 7) cpu type and memory size from master
# ---------------------------------------------------------------------
{
	print "  + gpstate\n";
	system(qq[ $GPSTATE -m > $logs/gpstate_mirrors.log ]  .
		   qq[2>>$logs/error.log]);
	system(qq[ $GPSTATE -f > $logs/gpstate_standby_master.log ]  .
		   qq[2>>$logs/error.log]);
	system(qq[ $GPSTATE -d > $logs/gpstate_master.log ]  .
		   qq[2>>$logs/error.log]);

	print "  + gpcheckos\n";
	system(qq[ $GPCHECKOS -h $master > $logs/gpcheckos_master.log ] .
		   qq[2>>$logs/error.log]);
	system(qq[ $GPCHECKOS -f $hostfile > $logs/gpcheckos_segments.log ] .
		   qq[2>>$logs/error.log]);
}


# ---------------------------------------------------------------------
# Crashes
# 8) Stack Traces
# 9) Local Variables of current stack frame
# 10) Offending statement
# ---------------------------------------------------------------------
{
	# Where the stack traces?
	print "  + Crash Report\n";
}



# ---------------------------------------------------------------------
# Special
# 11) Run all scripts in $GPHOME/share/gpdetective
#     Skip test if directory is world writable
# ---------------------------------------------------------------------
{
	sub inlist($@) {
		my $i = shift;
		my @list = @_;
		foreach my $elem (@list) {
			return $elem if ($elem eq $i);
		}
		return undef;
	}

	my $extension = qq[$gphome/share/gpdetective];

	print "  + Extensions\n";

	if (-d $extension) 
	{
		my @badwrite = `/usr/bin/find $extension -perm +002 -print`;
		chomp @badwrite;
		my @files = glob("$extension/*");
	
		if (inlist($extension, @badwrite)) 
		{
			system("echo Skipping Extensions: global write permission " .
				   " >> $logs/error.name");
			print "WARNING global write permission to $extension - skipping\n";
		}
		else
		{
			foreach my $file (@files) {
				if ($file =~ /^$extension\/(.*?)(\.\w+)?$/)
				{
					my ($name, $type) = ($1, $2);
					$type = "" unless (defined($type));
					
					if (inlist($file, @badwrite)) 
					{
						system("echo SKIPPED: $file \\(a+w\\) >> $logs/error.name");
						print "    + $name$type (skipped a+w)\n";
					}
					elsif ($type eq ".sql") 
					{
						system("$PSQL -aX -d postgres -f $file > $logs/$name.log" .
							   " 2>> $logs/error.log");
						print "    + $name$type\n";
					} 
					elsif (-x $file) 
					{
						system("$file -c $config -d $logs > $logs/$name.log" .
							   " 2>> $logs/error.log");
						print "    + $name$type\n";
					} 
					else 
					{
						system("echo SKIPPED: $file >> $logs/error.log");
						print "    + $name$type (skipped)\n";
					}
				}
			}
		}
	}
}



# ---------------------------------------------------------------------
# Cleanup
# ---------------------------------------------------------------------
print "  + error.log\n" if (-s "$logs/error.log");

my $timestamp = `date "+%Y%m%d%H%M%S"`;
chomp($timestamp);
system("echo tar -cf gpdetective$timestamp.tar *");
system("tar -cf gpdetective$timestamp.tar *");
system("tar -tf gpdetective$timestamp.tar") if ($debug);
system("gzip -f gpdetective$timestamp.tar");
copy("gpdetective$timestamp.tar.gz", $cwd);
chdir $cwd;
system("rm -rf $logs");

print "Done\n";
print "Created gpdetective$timestamp.tar.gz\n";
exit(0);
