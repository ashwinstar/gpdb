#!/usr/bin/env python
"""
gpkillall -- kill all processes by name

Usage: gpkillall <option> procname
     -version     : print version information
     -?           : print this help text
     -v           : enable verbose
     -V           : enable very verbose
"""

import commands, os, sys, getopt, signal

if sys.version_info < (2, 3):
    sys.exit("Error: gpkillall is supported on Python versions 2.3 or greater\n"
             + "Please upgrade python installed on this machine.")

def usage(exitarg):
    help_path = os.path.join(sys.path[0], '..', 'docs', 'cli_help', os.path.split(__file__)[-1] + '_help');
    try:
	f = open(help_path);
	for line in f: 
	    print line,
    except:
        print __doc__
    sys.exit(exitarg)

script_name = os.path.split(__file__)[-1]
opt = {}
opt['-v'] = False
opt['-V'] = False

username = os.environ.get('LOGNAME') or os.environ.get('USER')
procname = None

def print_version():
    print '%s version $Revision$' %script_name
    sys.exit(0)

def parseCommandLine():
    global opt, procname
    try:
        (options, args) = getopt.getopt(sys.argv[1:], '?vV', ['version'])
    except Exception, e:
        usage('Error: ' + str(e))

    for (switch , val) in options:
        if (switch == '-?'):        usage(0)
        elif (switch == '-v'):      opt[switch] = True

    if opt['-V']: opt['-v'] = True

    if len(args) > 1:
        sys.exit('Error: too many arguments')

    procname = args[0]

try:
    
    parseCommandLine()
    OS = os.uname()
    PS = None
    if OS[0] == 'SunOS':
        PS = 'ps -ef -o user,pid,comm'
    else:
        PS = 'ps -axc -o user,pid,command'
        
        
    output = commands.getoutput('%s | grep %s | grep -v grep' % (PS, procname))
    jobs = output.split('\n')
    for j in jobs:
        j = j.strip()
        if j == '':
            continue
        job = j.split()
        user = job[0]
        if user == username:
            pid = int(job[1])
            if opt['-v']: print 'kill %d' % pid
            os.kill(pid, signal.SIGTERM)

except KeyboardInterrupt:
    print '[Abort] Keyboard Interrupt ...'
