#!/usr/bin/env python
import sys, os
gphome = os.getenv('GPHOME', '')
if not gphome:
    mypath = os.path.dirname(__file__)
    gphome = os.path.join(mypath, '..' )
    gphome = os.path.abspath(gphome)
    if not os.access(os.path.join(gphome, 'bin', 'postgres'), 
			os.X_OK):
	gphome = ''

print gphome,
