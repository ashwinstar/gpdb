#!/bin/bash
#	Filename:-		gpskew
#	Version:-		$Revision$	
#	Updated:-		$Date$
#	Status:-		Released
#	Author:-		G L Coombe
#	Contact:-		gcoombe@greenplum.com
#	Release date:-		March 2006
#	Release stat:-		Greenplum Co Internal
#                               Copyright (c) Metapa 2005. All Rights Reserved.
#                               Copyright (c) Greenplum 2005. All Rights Reserved
#	Brief descn:-		Calculates table skew on a per node basis
#******************************************************************************
# Update History
#******************************************************************************
# Ver	Date		Who		Update
#******************************************************************************
# Detailed Description
#******************************************************************************
# Script checks to ensure that table entered as parameter exists.
# If table name exists calls Get_Node_Count function which does the following;
# 1. Obtains port number, host and database name for all nodes in the instance
# 2. Issues a non-blocking select count(*) for table to each node
# 3. Waits for a response from all nodes in the instance
# 4. Displays table of data obtained
# 5. Computes maximum and minimum row counts and variance
# 6. Displays calculated output  
#******************************************************************************
# Prep Code
#******************************************************************************
WORKDIR=`dirname $0`
FUNCTIONS=$WORKDIR/lib/gp_bash_functions.sh
if [ -f $FUNCTIONS ];then
	. $FUNCTIONS
else
	echo "FATAL:-Cannot source $FUNCTIONS"
	exit 2;fi
#******************************************************************************
# Location Variables
#******************************************************************************

#******************************************************************************
# Command Variables
#******************************************************************************
#
#******************************************************************************
# Script Specific Variables
#******************************************************************************
TMPFILE=/tmp/gpskew.tmp.$$
NODELIST=/tmp/nodelist.tmp.$$
PROG_NAME=`$BASENAME $0`
PROG_NAME=`$BASENAME $0`
HELP_DOC_NAME=`$ECHO $PROG_NAME|$AWK -F'.' '{print $1}'`_help
TIME=`$DATE +%H":"%M":"%S`
CUR_DATE=`$DATE +%Y%m%d`
MASTER_HOSTNAME=`hostname`
EXIT_STATUS=0
FULL_DISPLAY=0
DISTRIB=0
SEG_TYPE=0
DO_CHILD=0
RESPONSE_TIME=0
PARALLEL_STATUS_FILE=/tmp/gpskew_parallel_status_file.$$
GPSEGSKEW=$WORKDIR/lib/gpsegskew.sh
WAIT_LIMIT=300
#******************************************************************************
# Functions
#******************************************************************************
USAGE () {
if [ -f ${GPDOCDIR}/$HELP_DOC_NAME ] && [ x"" == x"$SCRIPT_USAGE" ];then
	$MORE ${GPDOCDIR}/$HELP_DOC_NAME
	exit 0
else
	GET_QD_DB_NAME >/dev/null 2>&1
	$ECHO
        $ECHO "      `basename $0`"
	$ECHO
        $ECHO "      Reports the data skew for a table within a Greenplum database."
	$ECHO "      Displays the segments with the most and least number of records,"
	$ECHO "      calculates the variance of records between these two segments,"
	$ECHO "      and reports the elapsed response time for the segment host."
        $ECHO
        $ECHO "      Usage:"
        $ECHO "      $0 [OPTIONS]"
        $ECHO
        $ECHO "      General options:"
        $ECHO "      -?, display this help message & exit"
        $ECHO "      -v, display version information & exit"
	$ECHO
	$ECHO "      Connection options:"
        $ECHO "      -d, <master instance directory> name of alternative master instance to connect [optional]"
	$ECHO
	$ECHO "      Logging options:"
	$ECHO "      -l, <logfile directory> alternative logfile directory [optional]"
	$ECHO "      -q, quiet mode, only useful where -f option also used"
	$ECHO "      -D, set log output to debug level, shows all function calls"
	$ECHO
	$ECHO "      Skew options:"
	$ECHO "      -t, <schema name>.<table name> [mandatory]"
	$ECHO "      -a, <database name> alternative database name [default ${QD_DBNAME}]"
	$ECHO "      -f, display full results output [default summary]"
	$ECHO "      -c, display information for table, do not compute skew"
	$ECHO "      -m, use mirror segment hosts for skew analysis [default primary segments]"
	$ECHO "      -h, display skew of child tables if -t <table name> is a partitioned table"
	$ECHO "      -r, display segment instance response times"
	$ECHO "      -w, \"<where clause text>\" apply a where clause to the count on each segment"
	$ECHO "          Note use of \" to surround text"
	$ECHO "          Example -w \"invoice_date >= '2007-01-01' and invoice_date < '2007-02-1'\""
	$ECHO "          The text must be syntatically correct, otherwise will fail to execute"
	$ECHO "          The utility will automatically build the complete line of SQL"
	$ECHO "      -B, <number> run this batch of skew segment processes in parallel [default $BATCH_DEFAULT]"
        $ECHO
        $ECHO "      Return codes:"
        $ECHO "      0 No problems encountered with requested operation"
        $ECHO "      1 Warning generated"
        $ECHO "      2 Fatal error, unable to continue requested operation"
	$ECHO
        exit $EXIT_STATUS
fi
}

BUILD_QUERY () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	QUERY_TEXT="select count(*) from $1 where ${WHERE_CLAUSE};"
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

VALIDATE_QUERY () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	$PSQL -q -p $MASTER_PORT $QD_DBNAME  -A -t -c"explain $QUERY_TEXT" > /dev/null 2>&1
	if [ $? -ne 0 ];then
		LOG_MSG "[FATAL]:-Validation of $WHERE_CLAUSE failed" 1
		ERROR_EXIT "[FATAL]:-Unable to continue" 2
	else
		LOG_MSG "[INFO]:-Where clause $WHERE_CLAUSE validated" 1
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

GET_DISTRIB_INFO () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	GET_TABLE_TYPE $TARGETTBL $MASTER_PORT $QD_DBNAME
	PARENT_TAB_TYPE=$TAB_TYPE
	PARENT_TAB_PARENT_NAME=$TAB_PARENT_NAME
	if [ $DISTRIB_COLS != "0" ];then
		LOG_MSG "[INFO]:-Obtaining OID for $TABLENAME on Master instance"
		TABLE_OID=`$PSQL -q -p $MASTER_PORT $QD_DBNAME -A -t -c"select oid from pg_class where relname='$TABLENAME' and relkind='r' and relnamespace in (select oid from pg_namespace where nspname='$SCHEMA_NAME');"`
		if [ $? -ne 0 ];then
		ERROR_EXIT "[FATAL]:-Failed obtain table oid value" 2;fi
	TOTAL_COLS=`$PSQL -q -p $MASTER_PORT $QD_DBNAME -A -t -c"select max(attnum) from pg_attribute where attrelid=${TABLE_OID};"`
	if [ $? -ne 0 ];then
	ERROR_EXIT "[FATAL]:-Failed to obtain table column count" 2;fi
	LOG_MSG "[INFO]:-------------------------------------------" 1
	LOG_MSG "[INFO]:-Table name              = $TARGETTBL" 1
	COLNUM=0
	for ATT_NUM in `echo $DISTRIB_COLS|$TR -d '{'|$TR -d '}'|$TR ',' ' '`
	do
		DIS_COL_NAME=`$PSQL -q -p $MASTER_PORT $QD_DBNAME -A -t -c"select attname from pg_attribute where attrelid=${TABLE_OID} and attnum=${ATT_NUM};"`
		((COLNUM=$COLNUM+1))
#	LOG_MSG "[INFO]:-Distrib col  = $COLNUM at DDL position $ATT_NUM is named $DIS_COL_NAME"
	LOG_MSG "[INFO]:-Distrib column count    = $COLNUM" 1
	LOG_MSG "[INFO]:-Distrib column name     = $DIS_COL_NAME" 1
	LOG_MSG "[INFO]:-Distrib column position = $ATT_NUM" 1
	done
	LOG_MSG "[INFO]:-Total columns           = $TOTAL_COLS" 1
	LOG_MSG "[INFO]:-Table is type           = $TAB_TYPE_TXT" 1
	if [ $PARTITIONED == 't' ];then
		PARENT_TABLE_COUNT=`$PSQL -p $MASTER_PORT -A -t $QD_DBNAME -c"select count(*) from only $TARGETTBL;"`
		LOG_MSG "[INFO]:-Physical record count   = $PARENT_TABLE_COUNT"	 1
		LOG_MSG "[INFO]:-Table type              = Partitioned" 1
		GET_CHILD_NAMES
		LOG_MSG "[INFO]:-------------------------------------------" 1
		LOG_MSG "[INFO]:-Child table details" 1
		LOG_MSG "[INFO]:-------------------------------------------" 1
		for C_NAME in ${CHILD_NAME_ARRAY[@]}
		do
			GET_DISTRIB_COLS ${SCHEMA_NAME}.$C_NAME $MASTER_PORT $QD_DBNAME
			GET_TABLE_TYPE ${SCHEMA_NAME}.$C_NAME $MASTER_PORT $QD_DBNAME
			LOG_MSG "[INFO]:-$C_NAME distribution columns=$DISTRIB_COLS" 1
		done	
		LOG_MSG "[INFO]:-------------------------------------------" 1
		if [ $PARENT_TAB_TYPE -eq 1 ];then
			LOG_MSG "[INFO]:-Table $TABLENAME is also a child table" 1
			LOG_MSG "[INFO]:-Parent table name      =  $PARENT_TAB_PARENT_NAME" 1
		fi
	fi
	else
		LOG_MSG "[INFO]:-Distribution columns are of type special" 1
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

GET_CHILD_NAMES () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
		PARENT_TABLE_RELFILENODE=`$PSQL -p $MASTER_PORT -A -t $QD_DBNAME -c"select oid from pg_class where relname='$TABLENAME' and relkind='r' and relnamespace in (select oid from pg_namespace where nspname='$SCHEMA_NAME');"`
		CHILD_NAME_ARRAY=(`$PSQL -p $MASTER_PORT -A -t $QD_DBNAME -c"select relname from pg_class where relkind='r' and oid in (select inhrelid from pg_inherits where inhparent=$PARENT_TABLE_RELFILENODE);"|$TR '\n' ' '`)
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

GET_NODE_COUNT () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	REC_COUNT=0
	if [ `$ECHO $TARGETTBL|$GREP -c "\."` -eq 1 ];then
		SCHEMA_NAME=`$ECHO $TARGETTBL|$CUT -d. -f1`
		T_NAME=`$ECHO $TARGETTBL|$CUT -d. -f2`
	fi
	SEGCOUNT=0
	DIS_COL_ARRAY=(`$PSQL -p $MASTER_PORT  $QD_DBNAME -R" " -A -t -c "select  a.attname from pg_class c,  gp_distribution_policy d, pg_attribute a where c.oid = d.localoid and a.attrelid = d.localoid and  a.attnum = ANY ( d.attrnums ) and c.relname='$T_NAME' and c.relnamespace in (select oid from pg_namespace where nspname='$SCHEMA_NAME');"`)
	NUM_SEGMENTS=`$PSQL -p $MASTER_PORT  $QD_DBNAME -A -t -c "select count(*) from $CONFIG_TABLE where content<>-1 and isprimary='t';"`
	ERROR_CHK $? "obtain number of segment instances" 2
	RELPAGE_NUM_PER_SEG_WAIT=`$PSQL -p $MASTER_PORT  $QD_DBNAME -R" " -A -t -c "select relpages/${NUM_SEGMENTS}/800 from pg_class where relname='$T_NAME' and relnamespace in (select oid from pg_namespace where nspname='$SCHEMA_NAME');"`
	ERROR_CHK $? "obtain relpages for $T_NAME" 2
	if [ $RELPAGE_NUM_PER_SEG_WAIT -ge $WAIT_LIMIT ];then
		LOG_MSG "[INFO]:-Reset default time out from $WAIT_LIMIT to $RELPAGE_NUM_PER_SEG_WAIT seconds" 1
		WAIT_LIMIT=$RELPAGE_NUM_PER_SEG_WAIT
	else
		LOG_MSG "[INFO]:-Using default time out value of $WAIT_LIMIT seconds"
	fi
	if [ $NUM_SEGMENTS = 1 ];then
		ERROR_EXIT "[FATAL]:-Only one node in instance, skew not applicable" 2
	fi 
	if [ $SEG_TYPE -eq 0 ];then
		GET_QE_PRIMARY_DETAILS
		QE_ARRAY=(${QE_PRIMARY_ARRAY[@]})
	else
		GET_QE_MIRROR_DETAILS
		QE_ARRAY=(${QE_MIRROR_ARRAY[@]})
	fi
	if [ x"" != x"$ALT_DBNAME" ];then
		QD_DBNAME=$ALT_DBNAME;fi
	PARALLEL_SETUP  $PARALLEL_STATUS_FILE
	if [ `$ECHO $TARGETTBL|$GREP -c "\."` -eq 0 ];then
		TARGETTBL="${SCHEMA_NAME}.$TARGETTBL"
	fi
	BATCH_LIMIT=${#QE_ARRAY[@]}
	for QNODE in "${QE_ARRAY[@]}"
	do
		QE_NAME=`$ECHO $QNODE|$CUT -d"|" -f1`
		QE_DIR=`$ECHO $QNODE|$CUT -d"|" -f2`
		QE_PORT=`$ECHO $QNODE|$CUT -d"|" -f3`
		QE_VALID=`$ECHO $QNODE|$CUT -d"|" -f4`
		QE_PRIMARY=`$ECHO $QNODE|$CUT -d"|" -f5`
		if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $NOLINE_ECHO ".\c";fi
		if [ x"" == x"$QUERY_TEXT" ];then
		$GPSEGSKEW $$ $QE_NAME $QE_PORT $QE_DIR $QE_VALID $QE_PRIMARY $INST_COUNT $LOG_FILE $QD_DBNAME $TARGETTBL 0 &
		else
		$GPSEGSKEW $$ $QE_NAME $QE_PORT $QE_DIR $QE_VALID $QE_PRIMARY $INST_COUNT $LOG_FILE $QD_DBNAME $TARGETTBL "${WHERE_CLAUSE}" &
		fi	
		PARALLEL_COUNT $BATCH_LIMIT $BATCH_DEFAULT
	done
	for RECS in `cat $PARALLEL_STATUS_FILE|$CUT -d'|' -f2`
	do
		((REC_COUNT=$REC_COUNT+$RECS))
	done
	REPORT_FAIL=0
	MinSkew=10000000000000
	MaxSkew=-1
	KILLED_COUNT=`$GREP -c KILLED $PARALLEL_STATUS_FILE`
	FAILED_COUNT=`$GREP -c FAILED $PARALLEL_STATUS_FILE`
	COMPLETED_COUNT=`$GREP -c COMPLETED $PARALLEL_STATUS_FILE`
	LOG_MSG "[INFO]:---------------------------------------" 1
	LOG_MSG "[INFO]:-Parallel process exit status" 1
	LOG_MSG "[INFO]:---------------------------------------" 1
	LOG_MSG "[INFO]:-Total processes marked as completed  = $COMPLETED_COUNT" 1
	if [ $KILLED_COUNT -ne 0 ];then
	LOG_MSG "[WARN]:-Total processes marked as killed     = $KILLED_COUNT $WARN_MARK" 1
	REPORT_FAIL=1
	else
	LOG_MSG "[INFO]:-Total processes marked as killed     = 0" 1
	fi
	if [ $FAILED_COUNT -ne 0 ];then
	LOG_MSG "[WARN]:-Total processes marked as failed     = $FAILED_COUNT $WARN_MARK" 1
	REPORT_FAIL=1
	else
	LOG_MSG "[INFO]:-Total processes marked as failed     = 0" 1
	fi
	LOG_MSG "[INFO]:---------------------------------------" 1
	while read DATA
	do
		Port=`$ECHO $DATA|$TAIL -1|$CUT -d'|' -f3`
		Skew=`$ECHO $DATA|$TAIL -1|$CUT -d'|' -f2`
		Seg=`$ECHO $DATA|$TAIL -1|$CUT -d'|' -f4`
		Host=`$ECHO $DATA|$TAIL -1|$CUT -d'|' -f5`
		if [ $Skew -gt $MaxSkew ];then
			MaxSkew=$Skew
			MaxSeg=$Seg
			MaxHost=$Host
			MaxPort=$Port
		fi
		if [ $Skew -lt $MinSkew ];then
			MinSkew=$Skew
			MinSeg=$Seg
			MinHost=$Host
			MinPort=$Port
		fi
	done < $PARALLEL_STATUS_FILE
	let RecDiff=$MaxSkew-$MinSkew
	if [ $RESPONSE_TIME -eq 1 ];then
	LOG_MSG "[INFO]:---------------------------------------" 1
	LOG_MSG "[INFO]:-Response results for $TYPE_TEXT" 1
	while read LINE
	do
		STATUS=`$ECHO $LINE|$CUT -d '|' -f1`
		Host=`$ECHO $LINE|$CUT -d '|' -f5`
		Time=`$ECHO $LINE|$CUT -d '|' -f6`
		Seg=`$ECHO $LINE|$CUT -d '|' -f4`
		Port=`$ECHO $LINE|$CUT -d '|' -f3`
		if [ $STATUS == "COMPLETED" ];then
			LOG_MSG "[INFO]:-$Host $Seg $Port time = $Time" 1
		else
			LOG_MSG "[INFO]:-$Host $Seg $Port time = $STATUS $WARN_MARK" 1
		fi
	done < $PARALLEL_STATUS_FILE
	fi
	if [ $FULL_DISPLAY -eq 1 ] || [ x"" = x"$VERBOSE" ];then
		$ECHO "Skew for table $TARGETTBL" | $TEE -a $LOG_FILE
		$CAT $PARALLEL_STATUS_FILE|$SORT | $TEE -a $LOG_FILE
	else
		$CAT $PARALLEL_STATUS_FILE|$SORT >> $LOG_FILE
	fi
	LOG_MSG "[INFO]:---------------------------------------" 1
	LOG_MSG "[INFO]:-Results for table name               = $TARGETTBL" 1
	if [ x"" == x"$WHERE_CLAUSE" ];then
	LOG_MSG "[INFO]:-Where clause                         = Off" 1
	else
	LOG_MSG "[INFO]:-Where clause                         = $WHERE_CLAUSE" 1
	fi
	LOG_MSG "[INFO]:-Database                             = $QD_DBNAME" 1
	if [ $PARTITIONED == 't' ];then
	LOG_MSG "[INFO]:-Table type                           = Partitioned and $TAB_TYPE_TXT"
		PARENT_TABLE_COUNT=`$PSQL -p $MASTER_PORT -A -t $QD_DBNAME -c"select count(*) from only $TARGETTBL;"`
		TOTAL_TXT="(inc child tables)"
	LOG_MSG "[INFO]:-Parent table physical record count   = $PARENT_TABLE_COUNT"	 1
	else
	LOG_MSG "[INFO]:-Table type                           = Un-Partitioned and $TAB_TYPE_TXT" 1
		TOTAL_TXT="                  "
	fi
	if [ $TAB_TYPE -eq 1 ];then
	LOG_MSG "[INFO]:-Parent table list                    = ${TAB_PARENT_NAME[@]}" 1
	fi
	if [ $REPORT_FAIL -ne 0 ];then
		HILITE=$WARN_MARK
	else
		HILITE=""
	fi
	LOG_MSG "[INFO]:---------------------------------------" 1
	LOG_MSG "[INFO]:-Number of Distribution Column(s)     = $DISTRIB_COLS" 1
	LOG_MSG "[INFO]:-Distribution Column Name(s)          = `$ECHO ${DIS_COL_ARRAY[@]}`" 1
	LOG_MSG "[INFO]:---------------------------------------" 1
	LOG_MSG "[INFO]:-Total records $TOTAL_TXT     = $REC_COUNT $HILITE" 1
	LOG_MSG "[INFO]:---------------------------------------" 1
	LOG_MSG "[INFO]:-Skew calculation target type         = $TYPE_TEXT" 1
	LOG_MSG "[INFO]:---------------------------------------" 1
	LOG_MSG "[INFO]:-Skew result" 1
	LOG_MSG "[INFO]:-Maximum Record Count                 = $MaxSkew $HILITE" 1
	LOG_MSG "[INFO]:-Segment instance hostname            = $MaxHost" 1
	LOG_MSG "[INFO]:-Segment instance name                = $MaxSeg" 1
	LOG_MSG "[INFO]:-Minimum Record Count                 = $MinSkew $HILITE" 1
	LOG_MSG "[INFO]:-Segment instance hostname            = $MinHost" 1
	LOG_MSG "[INFO]:-Segment instance name                = $MinSeg" 1
	LOG_MSG "[INFO]:-Record count variance                = $RecDiff $HILITE" 1
	if [ $REPORT_FAIL -ne 0 ];then
	LOG_MSG "[INFO]:-Partial value due to failures" 1
	fi
	LOG_MSG "[INFO]:---------------------------------------" 1
	rm -f $PARALLEL_STATUS_FILE
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}
#******************************************************************************
# Main Section
#******************************************************************************
trap '$RM -f $TMPFILE $PARALLEL_STATUS_FILE;ERROR_EXIT "[FATAL]:-Recieved INT or TERM signal" 2' INT TERM
CHK_DB_QD_SET
if [ $# -ne 0 ];then
        while getopts ":a:vmcqft:'?'d:l:!hrDB:w:" opt;do
        case $opt in
                v ) VERSION_INFO ;;
                t ) TARGETTBL=`$ECHO $OPTARG|$TR '[A-Z]' '[a-z]'` ;;
                '?' ) USAGE ;;
		! ) SCRIPT_USAGE=1
		    USAGE ;;
                d ) MASTER_DATA_DIRECTORY=$OPTARG ;;
		m ) SEG_TYPE=1 ;;
		l ) LOG_DIR=$OPTARG ;;
		a ) ALT_DBNAME=$OPTARG ;;
		c ) DISTRIB=1 ;;
		f ) FULL_DISPLAY=1 ;;
		q ) unset VERBOSE ;;
		h ) DO_CHILD=1 ;;
		r ) RESPONSE_TIME=1 ;;
		D ) DEBUG_LEVEL=1 ;;
		B ) BATCH_DEFAULT=$OPTARG ;;
		w ) WHERE_CLAUSE="$OPTARG" ;;
                * ) USAGE ;;
        esac
        done
	CHK_ON_PASSIVE_STANDBY
else
	CHK_ON_PASSIVE_STANDBY
	USAGE
fi
if [ x"" != x"$LOG_DIR" ];then
	CHK_DIR $LOG_DIR
	if [ $EXISTS -eq 1 ]; then
		LOG_MSG "[WARN]:-Log directory $LOG_DIR does not exist, using default log directory"
		EXIT_STATUS=1
else
	LOG_FILE=$LOG_DIR/${PROG_NAME}_${CUR_DATE}.log
	fi
fi
CHK_DB_RUNNING
LOG_MSG "[INFO]:-Start Main"
LOG_MSG "[INFO]:-Command line options passed to utility = $*"
READ_CHK
if [ $READ_COUNT -ne 0 ];then
        ERROR_EXIT "[FATAL]:-This script cannot be used on a read-only Master instance" 2
fi
if [ $SEG_TYPE -eq 1 ];then
	#Check to see that mirrors are configured
	CHK_MIRRORS_CONFIGURED
	if [ $MIRROR_COUNT -ne 2 ];then
		ERROR_EXIT "[FATAL]:-No mirror segments configured, -m option invalid" 2
	else
		LOG_MSG "[INFO]:-Mirror segments exist for use of -m option"
		TYPE_TEXT="Mirror Segments"
	fi
else
		TYPE_TEXT="Primary Segments"
fi
if [ x"" != x"$TARGETTBL" ];then
	GET_QD_DB_NAME
	if [ x"" != x"$ALT_DBNAME" ];then
        	QD_DBNAME=$ALT_DBNAME
	fi
	CHK_EXISTS_TABLE $TARGETTBL $MASTER_PORT $QD_DBNAME
	if [ $EXISTS -ne 0 ];then
		ERROR_EXIT "[FATAL]:-Table $TARGETTBL does not exist" 2
	else
		if [ x"" != x"$WHERE_CLAUSE" ];then
			BUILD_QUERY $TARGETTBL
			VALIDATE_QUERY
		fi
		GET_DISTRIB_COLS $TARGETTBL $MASTER_PORT $QD_DBNAME
		if [ $DISTRIB -eq 1 ];then
			GET_DISTRIB_INFO
		else
			GET_TABLE_TYPE $TARGETTBL $MASTER_PORT $QD_DBNAME
			GET_NODE_COUNT
		fi
		if [ $DO_CHILD -eq 1 ] && [ $PARTITIONED == 't' ];then
			GET_CHILD_NAMES			
			LOG_MSG "[INFO]:-Processing child tables"
			for CHILD_TABLE_NAME in ${CHILD_NAME_ARRAY[@]}
			do
				TARGETTBL=${SCHEMA_NAME}.$CHILD_TABLE_NAME
				CHK_EXISTS_TABLE $TARGETTBL $MASTER_PORT $QD_DBNAME
				GET_DISTRIB_COLS $TARGETTBL $MASTER_PORT $QD_DBNAME
				if [ $DISTRIB -eq 1 ];then
					GET_DISTRIB_INFO
				else
					GET_TABLE_TYPE $TARGETTBL $MASTER_PORT $QD_DBNAME
					GET_NODE_COUNT
				fi
			done
		fi
	fi
else
	USAGE
fi
LOG_MSG "[INFO]:-End Main"
exit $EXIT_STATUS
