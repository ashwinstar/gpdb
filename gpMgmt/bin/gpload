#!/usr/bin/env python

import sys
if sys.hexversion<0x2040400:
    sys.stderr.write("gpload needs python version at least 2.4.4\n")
    sys.exit(2)

try:
    import yaml
except ImportError:
    sys.stderr.write("gpload needs pyyaml.  You can get it from http://pyyaml.org.\n")
    sys.exit(2)

sys.path.append(sys.path[0]+'/lib')

try:
    import pg8000
except ImportError:
    sys.stderr.write("gpload needs pg8000.\n")
    sys.exit(2)
 
import getpass,os,signal,socket,subprocess,threading,time,traceback

class CatThread(threading.Thread):
    def __init__(self,gpload,fd):
	threading.Thread.__init__(self)
	self.gpload = gpload
	self.fd = fd
    def run(self):
	while 1:
	    line = self.fd.readline()
	    if line=='':
		break
	    self.gpload.log(line.strip('\n'))

class Progress(threading.Thread):
    def __init__(self,gpload,ports):
	threading.Thread.__init__(self)
	self.gpload = gpload
	self.ports = ports
    def get(self,port):
	s = socket.socket(socket.AF_INET,socket.SOCK_STREAM)
	s.connect(('127.0.0.1',port))
	s.sendall('GET gpfdist/status HTTP/1.0\r\n\r\n')
	f = s.makefile()
	s.close()
	read_bytes = -1
	total_bytes = -1
	total_sessions = -1
	for line in f:
	    a = line.split(' ')
	    if not a:
		continue
	    if a[0]=='read_bytes':
		read_bytes = int(a[1])
	    elif a[0]=='total_bytes':
		total_bytes = int(a[1])
	    elif a[0]=='total_sessions':
		total_sessions = int(a[1])
	f.close()
	return read_bytes,total_bytes,total_sessions
    def get1(self):
	read_bytes = 0
	total_bytes = 0
	for port in self.ports:
	    a = self.get(port)
	    if a[2]<1:
		return
	    read_bytes += a[0]
	    if a[1]==-1:
		total_bytes = -1
	    elif total_bytes!=-1:
		total_bytes += a[1]
	if total_bytes==-1:
	    self.gpload.log('Transfered %d bytes.'%read_bytes)
	    self.gpload.log('The total number of bytes is not available because a file was compressed.')
	else:
	    self.gpload.log('Transfered %d of %d bytes.'%(read_bytes,total_bytes))
    def run(self):
	while 1:
	    try:
		self.get1()
	    except socket.error:
		break
	    time.sleep(1)

def usage():
    sys.stderr.write("%s [-h hostname] [-p port] [-U username] [-d databasename] [-W] configfile\n"%sys.argv[0])
    sys.exit(2)

def quote(a):
    return "'"+a.replace("'","''").replace('\\','\\\\')+"'"

class options:
    pass

class gpload:

    def __init__(self,argv):
	self.threads = []
	self.exitValue = 0
	self.options = options()
	self.options.h = None
	self.options.p = None
	self.options.U = None
	self.options.W = False
	self.options.d = None
	self.name = 'gpload%s_%d'%(str(time.time()).replace('.','_'),os.getpid())
	self.cleanupSql = []
	while argv:
	    try:
		try:
		    if argv[0]=='-h':
			self.options.h = argv[1]
			argv = argv[2:]
		    elif argv[0]=='-p':
			self.options.p = int(argv[1])
			argv = argv[2:]
		    elif argv[0]=='-W':
			self.options.W = True
			argv = argv[1:]
		    elif argv[0]=='-U':
			self.options.U = argv[1]
			argv = argv[2:]
		    elif argv[0]=='-d':
			self.options.d = argv[1]
			argv = argv[2:]
		    else:
			break
		except IndexError:
		    sys.stderr.write("Option %s needs a parameter.\n"%argv[0])
		    sys.exit(2)
	    except ValueError:
		sys.stderr.write("Parameter for option %s must be an integer.\n"%argv[0])
		sys.exit(2)
	if len(argv)!=1:
	    usage()
	try:
	    f = open(argv[0],'r')
	except IOError,e:
	    sys.stderr.write("Could not open the config file.\n%s\n"%e)
	    sys.exit(2)
	try:
	    self.config = yaml.load(f.read())
	except yaml.scanner.ScannerError,e:
	    sys.stderr.write("YAML error in config file.\n%s\n"%e)
	    sys.exit(2)
	f.close()
	self.logfile = None
	self.subprocesses = []
	logfile = self.getconfig('gpload:logfile',str,None)
	if logfile!=None:
	    self.logfile = open(logfile,'a')

    def log(self,a):
	a += '\n'
	if self.logfile:
	    self.logfile.write(a)
	    self.logfile.flush()
	sys.stdout.write(a)

    def getconfig(self,a,typ=None,default='error',config=None,prefix=''):
	s = a.split(':')
	b = []
	config = config or self.config
	for i in xrange(len(s)):
	    if type(config)!=dict or s[i] not in config:
		if default=='error':
		    self.log("Configuration must contain %s."%(prefix+a))
		    sys.exit(2)
		return default
	    config = config[s[i]]
	if typ!=None and type(config)!=typ:
	    if typ==list:
		self.log("This configuration must be a sequence--%s."%(prefix+a))
	    elif typ==dict:
		self.log("This configuration must be a mapping--%s."%(prefix+a))
	    elif typ==str:
		self.log("This configuration must be a string--%s."%(prefix+a))
	    elif typ==int:
		self.log("This configuration must be an integer--%s."%(prefix+a))
	    else:
		assert 0
	    self.log("It is %s"%type(config))
	    sys.exit(2)
	return config

    def read_config(self):
	self.table = self.getconfig('gpload:into:connection:table',str)
	if self.options.h==None:
	    self.options.h = self.getconfig('gpload:into:connection:hostname',str)
	if self.options.p==None:
	    self.options.p = self.getconfig('gpload:into:connection:port',int)
	if self.options.U==None:
	    self.options.U = self.getconfig('gpload:into:connection:username',str)
	if self.options.d==None:
	    self.options.d = self.getconfig('gpload:into:connection:database',str)

    def start_gpfdists(self):
	self.locations = []
	sources = self.getconfig('gpload:from:source')
	if type(sources)!=list:
	    sources = [sources]
	ports = []
	for source in sources:
	    ipaddr = self.getconfig('ipaddr',str,socket.gethostname(),source,'gpload:from:source:')
	    if type(ipaddr)!=list:
		ipaddr = [ipaddr]
	    if 'port' in source:
		startPort = endPort = self.getconfig('port',int,'error',source,'gpload:from:source:')
	    elif 'portrange' in source:
		portrange = self.getconfig('portrange',list,'error',source,'gpload:from:source:')
		try:
		    startPort = int(portrange[0])
		    endPort = int(portrange[1])
		except (IndexError,ValueError):
		    self.log("gpload:from:source:portrange must be a sequence of two integers.")
		    sys.exit(2)
	    else:
		startPort = 8000
		endPort = 9000
	    infile = self.getconfig('infile',None,'error',source,'gpload:from:source:')
	    if type(infile)!=list:
		infile = [infile]
	    for i in infile:
		if type(i)!=str:
		    self.log("gpload:from:source:infile must be a string or a sequence of strings.")
		    sys.exit(2)
	    a = subprocess.Popen(['gpfdist','-p',str(startPort),'-P',str(endPort),'-f',' '.join(infile)],stdout=subprocess.PIPE,stderr=subprocess.PIPE,close_fds=True)
	    self.subprocesses.append(a)
	    t = CatThread(self,a.stderr)
	    t.start()
	    self.threads.append(t)
	    while 1:
		line = a.stdout.readline()
		if line=='':
		    self.log('Failed to start gpfdist.')
		    sys.exit(2)
		line = line.strip('\n')
		self.log(line)
		if line.startswith('Serving HTTP on port '):
		    port = int(line[21:line.index(',')])
		    break
	    self.log('gpfdist is running on port %d'%port)
	    ports.append(port)
	    CatThread(self,a.stdout).start()
	    for a in ipaddr:
		self.locations.append('gpfdist://%s:%d/%s'%(a,port,'%20'.join(infile)))
	t = Progress(self,ports)
	t.start()
	self.threads.append(t)

    def setup_connection(self):
	password = self.getconfig('gpload:into:connection:password',str,None)
	if self.options.W:
	    password = getpass.getpass()
	try:
	    self.pg8000 = pg8000.Connection(user=self.options.U,host=self.options.h,port=self.options.p,database=self.options.d,password=password)
	except pg8000.errors.InterfaceError,e:
	    self.log("Could not connect to database.\n%s"%e)
	    sys.exit(2)

    def read_columns(self):
	columns = self.getconfig('gpload:from:columns',list,None)
	if columns!=None:
	    self.from_columns = []
	    for d in columns:
		if type(d)!=dict:
		    self.log("gpload:from:columns must be a sequence of mappings.")
		    sys.exit(2)
		key = d.keys()[0].lower()
		self.from_columns.append([key,d[key],None])
	else:
	    self.from_columns = self.into_columns
	self.log('from columns are--')
	self.log('')
	for name,typ,mapto in self.from_columns:
	    self.log('%s: %s'%(name,typ))
	self.log('')

    def read_table_metadata(self):
	self.pg8000.execute("select * from information_schema.columns where table_name=$1 order by ordinal_position",self.table)
	count = 0
	self.into_columns = []
	self.into_columns_dict = dict()
	for row in self.pg8000.iterate_dict():
	    count += 1
	    ct = str(row['data_type'])
	    if ct=='numeric':
		stuff = ('numeric_precision','numeric_scale')
	    elif ct=='character' or ct=='character varying':
		stuff = ('character_maximum_length',)
	    else:
		stuff = ()
	    stuff = map(lambda x:str(row[x]),stuff)
	    if stuff:
		ct += '('+','.join(stuff)+')'
	    name = str(row['column_name']).lower()
	    i = [name,ct,None]
	    self.into_columns.append(i)
	    self.into_columns_dict[name] = i
	if count==0:
	    self.log('Table %s does not exist.'%self.table)
	    sys.exit(2)

    def read_mapping(self):
	mapping = self.getconfig('gpload:into:mapping',dict,None)
	if mapping==None:
	    for a in self.into_columns:
		if a[0] in map(lambda a:a[0],self.from_columns):
		    a[2] = a[0]
	else:
	    for key,value in mapping.iteritems():
		if type(key)!=str or type(value)!=str:
		    self.log('gpload:into:mapping must be a mapping from strings to strings.')
		    sys.exit(2)
		try:
		    i = map(lambda a:a[0],self.into_columns).index(key.lower())
		except ValueError:
		    self.log('%s in mapping is not in table %s:.'%(key,self.table))
		    sys.exit(2)
		self.into_columns[i][2] = value.lower()
	self.log('table %s columns are--'%self.table)
	self.log('')
	for name,typ,mapto in self.into_columns:
	    self.log('%s: %s = %s'%(name,typ,mapto))
	self.log('')

    def create_external_table(self):
	self.cleanupSql.append('drop table if exists ext_%s'%self.name)
	self.cleanupSql.append('drop table if exists ext_%s_errors'%self.name)
	format = self.getconfig('gpload:from:format:format',str,'text').lower()
	sql = "create external table ext_%s"%self.name
	sql += "(%s)"%','.join(map(lambda a:'%s %s'%(a[0],a[1]),self.from_columns))
	sql += "location(%s)"%','.join(map(quote,self.locations))
	sql += "format%s("%quote(format)
	sql += "delimiter%s"%quote(self.getconfig('gpload:from:format:delimiter',str))
	if self.getconfig('gpload:from:format:header',bool,False):
	    sql += "header "
	if format=='csv':
	    sql += "quote as%s"%quote(self.getconfig('gpload:from:format:quote',str))
	    sql += "escape as%s"%quote(self.getconfig('gpload:from:format:escape',str))
	force_not_null_columns = self.getconfig('gpload:from:format:force_not_null_columns',list,[])
	if force_not_null_columns:
	    for i in force_not_null_columns:
		if type(i)!=str:
		    self.log('gpload:from:format:force_not_null_columns must be a sequence of strings.')
		    sys.exit(2)
	    sql += "force not null %s "%','.join(force_not_null_columns)
	sql += ")"
	sql += "encoding%s"%quote(self.getconfig('gpload:from:format:encoding',str))
	sql += "log errors into ext_%s_errors "%self.name
	limit = self.getconfig('gpload:errors:segment_limit',str,None)
	if limit!=None:
	    sql += "segment reject limit %s "%limit
	self.log(sql)
	self.pg8000.execute(sql)

    def read_errors(self):
	self.pg8000.execute('select * from ext_%s_errors'%self.name)
	rows = list(self.pg8000.iterate_dict())
	if len(rows):
	    self.log(len(rows)==1 and '1 bad row' or "%d bad rows"%len(rows))
	    self.exitValue = 1
	    try:
		f = open(self.getconfig('gpload:errors:errorfile',str),'w')
	    except IOError,e:
		sys.stderr.write("Could not open the error file.\n%s\n"%e)
		sys.exit(2)
	    f.write(self.format_rows(rows))
	    f.close()
	else:
	    self.log("no bad rows")

    def format_rows(self,rows):
	sb = []
	if len(rows)!=0:
	    r = sorted(rows[0].keys())
	    size = map(len,r)
	    for i in xrange(len(size)):
		size[i] = max(size[i],*map(lambda a:len(str(a[r[i]])),rows))
	    for i in xrange(len(size)):
		if i:
		    sb.append('|')
		sb.append('%*s'%(size[i],r[i]))
	    sb.append('\n')
	    sb.append('%s\n'%'+'.join(map(lambda i:'-'*i,size)))
	    for row in rows:
		for i in xrange(len(size)):
		    if i:
			sb.append('|')
		    sb.append('%*s'%(size[i],row[r[i]]))
		sb.append('\n')
	sb.append(len(rows)==1 and '1 row' or '%d rows'%len(rows))
	return ''.join(sb)

    def do_insert(self,dest):
	cols = filter(lambda a:a[2]!=None,self.into_columns)
	sql = 'insert into %s'%dest
	sql += '(%s)'%','.join(map(lambda a:a[0],cols))
	sql += 'select %s '%','.join(map(lambda a:a[2],cols))
	sql += 'from ext_%s'%self.name
	self.log(sql)
	self.pg8000.execute(sql)
	self.read_errors()

    def do_method_insert(self):
	self.create_external_table()
	self.do_insert(self.table)

    def map_stuff(self,config,format,index):
	lis = []
	for i in self.getconfig(config,list):
	    if type(i)!=str:
		self.log('%s must be a sequence of strings.'%config)
		sys.exit(2)
	    j = self.into_columns_dict.get(i.lower())
	    if not j:
		self.log('Column %s in %s does not exist.'%(i,config))
		sys.exit(2)
	    if not j[index]:
		self.log('There is no mapping from the column %s in %s.'%(i,config))
		sys.exit(2)
	    lis.append(format(j[0],j[index]))
	return lis

    def do_update(self,fromname,index):
	sql = 'update %s into_table '%self.table
	sql += 'set %s '%','.join(self.map_stuff('gpload:into:method:update_cols',lambda x,y:'%s=from_table.%s'%(x,y),index))
	sql += 'from %s from_table '%fromname
	match = self.map_stuff('gpload:into:method:match_columns',lambda x,y:'into_table.%s=from_table.%s'%(x,y),index)
	update_condition = self.getconfig('gpload:into:method:update_condition',str,None)
	if update_condition:
	    match.append(update_condition)
	sql += 'where %s '%' and '.join(match)
	self.log(sql)
	self.pg8000.execute(sql)

    def do_method_update(self):
# Direct update doesn't work, so we copy data into temp table first.
	self.cleanupSql.append('drop temp table if exists temp_%s'%self.name)
	sql = 'create temp table temp_%s(like %s)'%(self.name,self.table)
	self.log(sql)
	self.pg8000.execute(sql)
	self.create_external_table()
	self.do_insert('temp_%s'%self.name)
	self.do_update('temp_%s'%self.name,0)
# This doesn't work.
#	self.create_external_table()
#	self.do_update('ext_%s'%self.name,2)
#	self.read_errors()

    def do_method_merge(self):
	self.cleanupSql.append('drop temp table if exists temp_%s'%self.name)
	sql = 'create temp table temp_%s(like %s)'%(self.name,self.table)
	self.log(sql)
	self.pg8000.execute(sql)
	self.create_external_table()
	self.do_insert('temp_%s'%self.name)
	self.do_update('temp_%s'%self.name,0)
	sql = 'insert into %s('%self.table
	sql += 'select %s '%','.join(map(lambda a:'from_table.%s'%a[0],self.into_columns))
	sql += 'from temp_%s from_table '%self.name
	sql += 'left outer join %s into_table '%self.table
	match = self.map_stuff('gpload:into:method:match_columns',lambda x,y:'into_table.%s=from_table.%s'%(x,y),0)
	sql += 'on %s '%' and '.join(match)
	where = self.map_stuff('gpload:into:method:match_columns',lambda x,y:'into_table.%s is null'%x,0)
	sql += 'where %s '%' and '.join(where)
	sql += ')'
	self.log(sql)
	self.pg8000.execute(sql)

    def show_result(self):
	self.pg8000.execute('select * from %s'%self.table)
	self.log(self.format_rows(list(self.pg8000.iterate_dict())))

    def do_method(self):
	method = self.getconfig('gpload:into:method:method',str,'insert').lower()
	if method=='insert':
	    self.do_method_insert()
	elif method=='update':
	    self.do_method_update()
	elif method=='merge':
	    self.do_method_merge()
	else:
	    self.log('We do not implement method %s yet.'%method)
	    sys.exit(2)

    def run2(self):
	self.log(str(self.config))
	start = time.time()
	self.read_config()
	self.setup_connection()
	self.read_table_metadata()
	self.read_columns()
	self.read_mapping()
	self.start_gpfdists()
	self.do_method()
	self.log('Running time is %s seconds'%(time.time()-start))

    def run(self):
	self.pg8000 = None
	try:
	    try:
		self.run2()
	    except Exception:
		if self.logfile:
		    traceback.print_exc(file=self.logfile)
		    self.logfile.flush()
		traceback.print_exc()
		self.exitValue = 2
	finally:
	    self.log('Removing temporary stuff.')
	    for a in self.cleanupSql:
		try:
		    try:
			self.pg8000.execute(a)
		    except pg8000.errors.ProgrammingError:
			pass
		except pg8000.errors.InternalError:
		    if self.logfile:
			traceback.print_exc(file=self.logfile)
			self.logfile.flush()
		    traceback.print_exc()
	    self.log('Killing gpfdist.')
	    for a in self.subprocesses:
		try:
		    os.kill(a.pid,signal.SIGTERM)
		except OSError:
		    pass
	    for t in self.threads:
		t.join()
	if self.exitValue==0:
	    self.log('gpload succeeded.')
	elif self.exitValue==1:
	    self.log('gpload succeeded with warnings.')
	else:
	    self.log('gpload failed.')

g = gpload(sys.argv[1:])
g.run()
sys.exit(g.exitValue)
