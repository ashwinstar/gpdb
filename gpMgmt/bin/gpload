#!/usr/bin/env python

import sys
if sys.hexversion<0x2040400:
    sys.stderr.write("gpload needs python version at least 2.4.4\n")
    sys.exit(2)

sys.path.append(sys.path[0]+'/lib')

try:
    import yaml
except ImportError:
    sys.stderr.write("gpload needs pyyaml.  You can get it from http://pyyaml.org.\n")
    sys.exit(2)

try:
    import pg8000
except ImportError:
    sys.stderr.write("gpload needs pg8000.\n")
    sys.exit(2)
 
import getpass,os,signal,socket,subprocess,threading,time,traceback

class CatThread(threading.Thread):
    def __init__(self,gpload,fd):
	threading.Thread.__init__(self)
	self.gpload = gpload
	self.fd = fd
    def run(self):
	while 1:
	    line = self.fd.readline()
	    if line=='':
		break
	    self.gpload.log(line.strip('\n'))

class Progress(threading.Thread):
    def __init__(self,gpload,sockaddrs):
	threading.Thread.__init__(self)
	self.gpload = gpload
	self.sockaddrs = sockaddrs
    def get(self,sockaddr):
	s = socket.socket(socket.AF_INET,socket.SOCK_STREAM)
	s.connect(sockaddr)
	s.sendall('GET gpfdist/status HTTP/1.0\r\n\r\n')
	f = s.makefile()
	s.close()
	read_bytes = -1
	total_bytes = -1
	total_sessions = -1
	for line in f:
	    a = line.split(' ')
	    if not a:
		continue
	    if a[0]=='read_bytes':
		read_bytes = int(a[1])
	    elif a[0]=='total_bytes':
		total_bytes = int(a[1])
	    elif a[0]=='total_sessions':
		total_sessions = int(a[1])
	f.close()
	return read_bytes,total_bytes,total_sessions
    def get1(self):
	read_bytes = 0
	total_bytes = 0
	for sockaddr in self.sockaddrs:
	    a = self.get(sockaddr)
	    if a[2]<1:
		return
	    read_bytes += a[0]
	    if a[1]==-1:
		total_bytes = -1
	    elif total_bytes!=-1:
		total_bytes += a[1]
	if total_bytes==-1:
	    self.gpload.log('Transfered %d bytes.'%read_bytes)
	    self.gpload.log('The total number of bytes is not available because a file was compressed.')
	else:
	    self.gpload.log('Transfered %d of %d bytes.'%(read_bytes,total_bytes))
    def run(self):
	while 1:
	    try:
		self.get1()
	    except socket.error:
		break
	    time.sleep(1)

def usage():
    sys.stderr.write("%s [-h hostname] [-p port] [-U username] [-d databasename] [-W] [-?] [-c configfile|-f configfile|configfile]\n"%sys.argv[0])
    sys.exit(2)

def quote(a):
    return "'"+a.replace("'","''").replace('\\','\\\\')+"'"

def splitPgpassLine(a):
    b = []
    escape = False
    d = ''
    for c in a:
	if not escape and c=='\\':
	    escape = True
	elif not escape and c==':':
	    b.append(d)
	    d = ''
	else:
	    d += c
	    escape = False
    if escape:
	d += '\\'
    b.append(d)
    return b

def dictKeyToLower(a):
    if type(a)==list:
	return map(dictKeyToLower,a)
    if type(a)==dict:
	b = dict()
	for key,value in a.iteritems():
	    if type(key)==str:
		key = key.lower()
	    b[key] = dictKeyToLower(value)
	return b
    return a

class options:
    pass

class gpload:

    def __init__(self,argv):
	self.threads = []
	self.exitValue = 0
	self.options = options()
	self.options.h = None
	self.options.p = None
	self.options.U = None
	self.options.W = False
	self.options.password = None
	self.options.d = None
	self.name = 'gpload%s_%d'%(str(time.time()).replace('.','_'),os.getpid())
	self.cleanupSql = []
	configFilename = None
	while argv:
	    try:
		try:
		    if argv[0]=='-h':
			self.options.h = argv[1]
			argv = argv[2:]
		    elif argv[0]=='-p':
			self.options.p = int(argv[1])
			argv = argv[2:]
		    elif argv[0]=='-W':
			self.options.W = True
			argv = argv[1:]
		    elif argv[0]=='-U':
			self.options.U = argv[1]
			argv = argv[2:]
		    elif argv[0]=='-d':
			self.options.d = argv[1]
			argv = argv[2:]
		    elif argv[0] in ('-f','-c'):
			configFilename = argv[1]
			argv = argv[2:]
		    elif argv[0]=='-?':
			usage()
		    elif configFilename==None:
			configFilename = argv[0]
			argv = argv[1:]
		    else:
			break
		except IndexError:
		    sys.stderr.write("Option %s needs a parameter.\n"%argv[0])
		    sys.exit(2)
	    except ValueError:
		sys.stderr.write("Parameter for option %s must be an integer.\n"%argv[0])
		sys.exit(2)
	if configFilename==None or argv:
	    usage()
	try:
	    f = open(configFilename,'r')
	except IOError,e:
	    sys.stderr.write("Could not open the config file.\n%s\n"%e)
	    sys.exit(2)
	try:
	    self.config = yaml.load(f.read())
	except yaml.scanner.ScannerError,e:
	    sys.stderr.write("YAML error in config file.\n%s\n"%e)
	    sys.exit(2)
	f.close()
	self.config = dictKeyToLower(self.config)
	self.logfile = None
	self.subprocesses = []
	logfile = self.getconfig('gpload:logfile',str,None)
	if logfile!=None:
	    self.logfile = open(logfile,'a')

    def log(self,a):
	a += '\n'
	if self.logfile:
	    self.logfile.write(a)
	    self.logfile.flush()
	sys.stdout.write(a)

    def getconfig(self,a,typ=None,default='error'):
	s = a.split(':')
	b = []
	config = self.config
	for i in xrange(len(s)):
	    if type(config)!=dict or s[i] not in config:
		if default=='error':
		    self.log("Configuration must contain %s."%a)
		    sys.exit(2)
		return default
	    config = config[s[i]]
	if typ!=None and type(config)!=typ:
	    if typ==list:
		self.log("This configuration must be a sequence--%s."%a)
	    elif typ==dict:
		self.log("This configuration must be a mapping--%s."%a)
	    elif typ==str:
		self.log("This configuration must be a string--%s."%a)
	    elif typ==int:
		self.log("This configuration must be an integer--%s."%a)
	    else:
		assert 0
	    self.log("It is %s"%type(config))
	    sys.exit(2)
	return config

    def read_config(self):
	self.table = self.getconfig('gpload:into:connection:table',str)
	if self.options.h==None:
	    self.options.h = self.getconfig('hostname',str,None)
	if self.options.h==None:
	    self.options.h = os.environ.get('PGHOST')
	if self.options.h==None:
	    self.log("You need to specify your host name with the -h option or in your configuration file or in your environment as PGHOST.")
	    sys.exit(2)
	if self.options.p==None:
	    self.options.p = self.getconfig('port',int,None)
	if self.options.p==None:
	    try:
		self.options.p = int(os.environ.get('PGPORT'))
	    except ValueError:
		pass
	if self.options.p==None:
	    self.log("You need to specify your port number with the -p option or in your configuration or in your environment as PGPORT.")
	    sys.exit(2)
	if self.options.U==None:
	    self.options.U = self.getconfig('username',str,None)
	if self.options.U==None:
	    self.options.U = os.environ.get('PGUSER')
	if self.options.U==None:
	    self.log("You need to specify your username with the -U option or in your configuration or in your environment as PGUSER.")
	    sys.exit(2)
	if self.options.d==None:
	    self.options.d = self.getconfig('database',str,None)
	if self.options.d==None:
	    self.options.d = os.environ.get('PGDATABASE')
	if self.options.d==None:
	    self.log("You need to specify your database with the -d option or in your configuration or in your environment as PGDATABASE.")
	    sys.exit(2)

    def start_gpfdists(self):
	self.locations = []
	local_hostname = self.getconfig('gpload:input:source:local_hostname',list)
	file = self.getconfig('gpload:input:source:file',list)
	if len(local_hostname)!=len(file):
	    self.log("gpload:input:source:local_hostname and gpload:input:source:file must have the same length.")
	    sys.exit(2)
	port_range = self.getconfig('gpload:input:source:port_range',list,None)
	if port_range:
	    try:
		startPort = int(port_range[0])
		endPort = int(port_range[1])
	    except (IndexError,ValueError):
		self.log("gpload:input:source:port_range must be a sequence of two integers.")
		sys.exit(2)
	else:
	    startPort = self.getconfig('gpload:input:source:port',int,8000)
	    endPort = self.getconfig('gpload:input:source:port',int,9000)
	sockaddrs = []
	for l,f in zip(local_hostname,file):
	    if type(l)!=str:
		self.log("gpload:input:source:local_hostname must be a sequence of strings.")
		sys.exit(2)
	    if type(f)!=str:
		self.log("gpload:input:source:file must be a sequence of strings.")
		sys.exit(2)
	    try:
		l = socket.gethostbyname(l)
	    except:
		self.log("Can not resolve hostname "+l)
		sys.exit(2)
	    ip4addr = reduce(lambda x,y:int(x)*256+int(y),l.split('.'))
	    if ip4addr>=1<<31:
		ip4addr -= 1<<32
	    a = subprocess.Popen(['gpfdist','-p',str(startPort),'-P',str(endPort),'-b',str(ip4addr),'-f',f],stdout=subprocess.PIPE,stderr=subprocess.PIPE,close_fds=True)
	    self.subprocesses.append(a)
	    t = CatThread(self,a.stderr)
	    t.start()
	    self.threads.append(t)
	    while 1:
		line = a.stdout.readline()
		if line=='':
		    self.log('Failed to start gpfdist.')
		    sys.exit(2)
		line = line.strip('\n')
		self.log(line)
		if line.startswith('Serving HTTP on port '):
		    port = int(line[21:line.index(',')])
		    break
	    self.log('gpfdist is running on port %d'%port)
	    sockaddrs.append((l,port))
	    CatThread(self,a.stdout).start()
	    self.locations.append('gpfdist://%s:%d/%s'%(l,port,f))
	t = Progress(self,sockaddrs)
	t.start()
	self.threads.append(t)

    def readPgpass(self,pgpassname):
	f = open(pgpassname,'r')
	for line in map(splitPgpassLine,f):
	    try:
		if line[0]!='*' and line[0].lower()!=self.options.h.lower():
		    continue
		if line[1]!='*' and int(line[1])!=self.options.p:
		    continue
		if line[2]!='*' and line[2]!=self.options.d:
		    continue
		if line[3]!='*' and line[3]!=self.options.U:
		    continue
		self.options.password = line[4]
		break
	    except (ValueError,IndexError):
		pass
	f.close()

    def setup_connection(self):
	if self.pg8000!=None:
	    self.pg8000.close()
	if self.options.password==None and self.options.W:
	    self.options.password = getpass.getpass()
	if self.options.password==None:
	    self.options.password = self.getconfig('password',str,None)
	if self.options.password==None:
	    self.options.password = os.environ.get('PGPASSWORD')
	if self.options.password==None:
	    self.readPgpass(os.environ.get('PGPASSFILE',os.environ.get('HOME','.')+'/.pgpass'))
	try:
	    self.pg8000 = pg8000.Connection(user=self.options.U,host=self.options.h,port=self.options.p,database=self.options.d,password=self.options.password)
	except pg8000.errors.InterfaceError,e:
	    self.log("Could not connect to database.\n%s"%e)
	    sys.exit(2)

    def read_columns(self):
	columns = self.getconfig('gpload:input:columns',list,None)
	if columns!=None:
	    self.from_columns = []
	    for d in columns:
		if type(d)!=dict:
		    self.log("gpload:input:columns must be a sequence of mappings.")
		    sys.exit(2)
		key = d.keys()[0]
		self.from_columns.append([key,d[key],None])
	else:
	    self.from_columns = self.into_columns
	self.log('from columns are--')
	self.log('')
	for name,typ,mapto in self.from_columns:
	    self.log('%s: %s'%(name,typ))
	self.log('')

    def read_table_metadata(self):
	tableSchema = 'public'
	tableName = self.table
	i = tableName.find('.')
	if i>=0:
	    tableSchema = tableName[:i]
	    tableName = tableName[i+1:]
	self.pg8000.execute("select * from information_schema.columns where table_name=$1 and table_schema=$2 order by ordinal_position",tableName,tableSchema)
	count = 0
	self.into_columns = []
	self.into_columns_dict = dict()
	for row in self.pg8000.iterate_dict():
	    count += 1
	    ct = str(row['data_type'])
	    if ct=='numeric':
		stuff = ('numeric_precision','numeric_scale')
	    elif ct=='character' or ct=='character varying':
		stuff = ('character_maximum_length',)
	    else:
		stuff = ()
	    stuff2 = []
	    for a in stuff:
		if row[a]!=None:
		    stuff2.append(str(row[a]))
	    if stuff2:
		ct += '('+','.join(stuff2)+')'
	    name = str(row['column_name']).lower()
	    i = [name,ct,None]
	    self.into_columns.append(i)
	    self.into_columns_dict[name] = i
	if count==0:
	    self.log('Table %s does not exist.'%self.table)
	    sys.exit(2)

    def read_mapping(self):
	mapping = self.getconfig('gpload:into:mapping',dict,None)
	if mapping==None:
	    for a in self.into_columns:
		if a[0] in map(lambda a:a[0],self.from_columns):
		    a[2] = a[0]
	else:
	    for key,value in mapping.iteritems():
		if type(key)!=str or type(value)!=str:
		    self.log('gpload:into:mapping must be a mapping from strings to strings.')
		    sys.exit(2)
		try:
		    i = map(lambda a:a[0],self.into_columns).index(key)
		except ValueError:
		    self.log('%s in mapping is not in table %s:.'%(key,self.table))
		    sys.exit(2)
		self.into_columns[i][2] = value.lower()
	self.log('table %s columns are--'%self.table)
	self.log('')
	for name,typ,mapto in self.into_columns:
	    self.log('%s: %s = %s'%(name,typ,mapto))
	self.log('')

    def create_external_table(self):
	self.error_table = self.getconfig('gpload:input:error_table',str)
	self.cleanupSql.append('drop external table if exists ext_%s'%self.name)
	format = self.getconfig('gpload:input:format',str,'text').lower()
	sql = "create external table ext_%s"%self.name
	sql += "(%s)"%','.join(map(lambda a:'%s %s'%(a[0],a[1]),self.from_columns))
	sql += "location(%s)"%','.join(map(quote,self.locations))
	sql += "format%s("%quote(format)
	sql += "delimiter%s"%quote(self.getconfig('gpload:input:delimiter',str))
	if self.getconfig('gpload:input:header',bool,False):
	    sql += "header "
	if format=='csv':
	    sql += "quote as%s"%quote(self.getconfig('gpload:input:quote',str))
	    sql += "escape as%s"%quote(self.getconfig('gpload:input:escape',str))
	force_not_null_columns = self.getconfig('gpload:input:force_not_null_columns',list,[])
	if force_not_null_columns:
	    for i in force_not_null_columns:
		if type(i)!=str:
		    self.log('gpload:input:force_not_null_columns must be a sequence of strings.')
		    sys.exit(2)
	    sql += "force not null %s "%','.join(force_not_null_columns)
	sql += ")"
	sql += "encoding%s"%quote(self.getconfig('gpload:input:encoding',str))
	sql += "log errors into %s "%self.error_table
	limit = self.getconfig('gpload:input:error_limit',int,0)
	sql += "segment reject limit %s "%limit
	self.log(sql)
	self.pg8000.execute(sql)
	self.initial_errors = self.count_errors()

    def count_errors(self):
	self.pg8000.execute('select count(*) from %s'%self.error_table)
	return self.pg8000.iterate_dict().next()['count']

    def report_errors(self):
	errors = self.count_errors()-self.initial_errors
	if errors==1:
	    self.log('one bad row')
	    self.exitValue = 1
	elif errors:
	    self.log('%d bad rows'%errors)
	    self.exitValue = 1

    def do_insert(self,dest):
	cols = filter(lambda a:a[2]!=None,self.into_columns)
	sql = 'insert into %s'%dest
	sql += '(%s)'%','.join(map(lambda a:a[0],cols))
	sql += 'select %s '%','.join(map(lambda a:a[2],cols))
	sql += 'from ext_%s'%self.name
	self.log(sql)
	self.pg8000.execute(sql)
	self.report_errors()

    def do_method_insert(self):
	self.create_external_table()
	self.do_insert(self.table)

    def map_stuff(self,config,format,index):
	lis = []
	for i in self.getconfig(config,list):
	    if type(i)!=str:
		self.log('%s must be a sequence of strings.'%config)
		sys.exit(2)
	    j = self.into_columns_dict.get(i.lower())
	    if not j:
		self.log('Column %s in %s does not exist.'%(i,config))
		sys.exit(2)
	    if not j[index]:
		self.log('There is no mapping from the column %s in %s.'%(i,config))
		sys.exit(2)
	    lis.append(format(j[0],j[index]))
	return lis

    def do_update(self,fromname,index):
	sql = 'update %s into_table '%self.table
	sql += 'set %s '%','.join(self.map_stuff('gpload:into:method:update_cols',lambda x,y:'%s=from_table.%s'%(x,y),index))
	sql += 'from %s from_table '%fromname
	match = self.map_stuff('gpload:into:method:match_columns',lambda x,y:'into_table.%s=from_table.%s'%(x,y),index)
	update_condition = self.getconfig('gpload:into:method:update_condition',str,None)
	if update_condition:
	    match.append(update_condition)
	sql += 'where %s '%' and '.join(match)
	self.log(sql)
	self.pg8000.execute(sql)

    def do_method_update(self):
# Direct update doesn't work, so we copy data into temp table first.
	self.cleanupSql.append('drop table if exists temp_%s'%self.name)
	sql = 'create temp table temp_%s(like %s)'%(self.name,self.table)
	self.log(sql)
	self.pg8000.execute(sql)
	self.create_external_table()
	self.do_insert('temp_%s'%self.name)
	self.do_update('temp_%s'%self.name,0)
# This doesn't work.
#	self.create_external_table()
#	self.do_update('ext_%s'%self.name,2)
#	self.report_errors()

    def do_method_merge(self):
	self.cleanupSql.append('drop table if exists temp_%s'%self.name)
	sql = 'create temp table temp_%s(like %s)'%(self.name,self.table)
	self.log(sql)
	self.pg8000.execute(sql)
	self.create_external_table()
	self.do_insert('temp_%s'%self.name)
	self.do_update('temp_%s'%self.name,0)
	sql = 'insert into %s('%self.table
	sql += 'select %s '%','.join(map(lambda a:'from_table.%s'%a[0],self.into_columns))
	sql += 'from temp_%s from_table '%self.name
	sql += 'left outer join %s into_table '%self.table
	match = self.map_stuff('gpload:into:method:match_columns',lambda x,y:'into_table.%s=from_table.%s'%(x,y),0)
	sql += 'on %s '%' and '.join(match)
	where = self.map_stuff('gpload:into:method:match_columns',lambda x,y:'into_table.%s is null'%x,0)
	sql += 'where %s '%' and '.join(where)
	sql += ')'
	self.log(sql)
	self.pg8000.execute(sql)

    def do_method(self):
	method = self.getconfig('gpload:into:method:method',str,'insert').lower()
	if method=='insert':
	    self.do_method_insert()
	elif method=='update':
	    self.do_method_update()
	elif method=='merge':
	    self.do_method_merge()
	else:
	    self.log('We do not implement method %s yet.'%method)
	    sys.exit(2)

    def run2(self):
	self.log(str(self.config))
	start = time.time()
	self.read_config()
	self.setup_connection()
	self.read_table_metadata()
	self.read_columns()
	self.read_mapping()
	self.start_gpfdists()
	self.do_method()
	self.log('Running time is %s seconds'%(time.time()-start))

    def run(self):
	self.pg8000 = None
	try:
	    try:
		self.run2()
	    except Exception:
		if self.logfile:
		    traceback.print_exc(file=self.logfile)
		    self.logfile.flush()
		traceback.print_exc()
		self.exitValue = 2
	finally:
	    if self.cleanupSql:
		self.log('Removing temporary data.')
		self.setup_connection()
		for a in self.cleanupSql:
		    try:
			self.log(a)
			self.pg8000.execute(a)
		    except (pg8000.errors.InternalError,pg8000.errors.ProgrammingError):
			if self.logfile:
			    traceback.print_exc(file=self.logfile)
			    self.logfile.flush()
			traceback.print_exc()
	    if self.subprocesses:
		self.log('Killing gpfdist.')
		for a in self.subprocesses:
		    try:
			os.kill(a.pid,signal.SIGTERM)
		    except OSError:
			pass
	    for t in self.threads:
		t.join()
	if self.exitValue==0:
	    self.log('gpload succeeded.')
	elif self.exitValue==1:
	    self.log('gpload succeeded with warnings.')
	else:
	    self.log('gpload failed.')

g = gpload(sys.argv[1:])
g.run()
sys.exit(g.exitValue)
