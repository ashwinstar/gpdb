#!/usr/bin/env python

'''
gpreport -- gather log and report to Greenplum.

Usage: gpreport [--version] [-?v] [-p port] [-s dbname] [-t %yyyy-%mm-%dd %hh:%MM:%SS] [-o output_directory] [-f sqlfile] [-u user]

          --version : print version information
          -?        : print this help screen
          -v        : verbose mode
          -p port   : ssh port
          -s dbname : database name  [default='template1']
          -t time   : start time to report log (%yyyy-%mm-%dd %hh:%MM:%SS)  [default=now]
          -o dir    : output directory  [default=current directory]
          -f file   : sql statements to run in the file
          -u user   : user name
'''

import os, sys, getopt, popen2, pickle, time

sys.path.append(sys.path[0] + '/lib')
try:
    import gplib
except ImportError, e:
    sys.exit('Error: unable to import module: ' + str(e))

GPHOME = os.getenv('GPHOME')
if GPHOME is None:
    sys.exit('Please set GPHOME')

script_name = os.path.split(__file__)[-1]
opt = {}
opt['-v'] = False
opt['-s'] = 'template1'
opt['-u'] = os.environ.get('LOGNAME') or os.environ.get('USER')
opt['-t'] = time.strftime('%Y-%m-%d %H:%M:%S')
opt['-f'] = None
opt['-o'] = '.'
opt['-p'] = 22

GPHOME = os.environ.get('GPHOME')
if not GPHOME:
    sys.exit('GPHOME env not set')

################
def usage(exitarg):
    print gplib.cli_help() or __doc__
    sys.exit(exitarg)


#############
def print_version():
    print '%s version $Revision$' % script_name
    sys.exit(0)

#############
def parseCommandLine():
    global opt, argcmd
    try:
	(options, args) = getopt.getopt(sys.argv[1:], '?evs:u:t:f:o:p:', ['version'])
    except Exception, e:
	usage('Error: ' + str(e))

    for (switch, val) in options:
	if (switch == '-?'):	      usage(0)
	elif (switch[1] in 'v'):      opt[switch] = True
	elif (switch == '-u'):        opt[switch] = val
	elif (switch == '-t'):        opt[switch] = val
	elif (switch == '-f'):        opt[switch] = val
	elif (switch == '-o'):        opt[switch] = val
	elif (switch == '-p'):        opt[switch] = gplib.parse_port(val)
        elif (switch == '--version'): print_version()


def run(cmd):
    p = os.popen(cmd)
    ret = []
    for line in p:
        ret.append(line)
    rc = p.close()

    return (not rc, ret)

######### class Config -- gp_configuration
class Config:
    class Record:
        def __init__(self, line):
            line = line.split('|')
            line = [l.strip() for l in line]
            self.content = int(line[0])
            self.definedprimary = line[1] == 't'
            self.dbid = line[2]
            self.isprimary = line[3] == 't'
            self.valid = line[4] == 't'
            self.hostname = line[5]
            self.port = line[6]
            self.datadir = line[7]
        
    def __init__(self):
        self.record = []
        self.fill()

    def fill(self):
        self.record = []
        (ok, out) = run('psql template1 -t -q -c \"select * from gp_configuration order by dbid\"')
        if not ok:
            sys.exit('[Error] Unable to select gp_configuration')
        for line in out:
            line = line.strip()
            if line: self.record.append(Config.Record(line))

    def get(self):
        return self.record

    def hasMirror(self):
        return reduce(lambda x, y: x or y,
                      [not r.isprimary for r in self.record])

    def getHosts(self, unique = True):
        list = map(lambda x: x.hostname, self.record)
        if unique:
            u = {}
            for h in list: u[h] = 1
            list = u.keys()
        return list


##########
def sshGpLog(config):
    session = []
    for c in config.get():
        dbport = c.port
        data_dir = c.datadir
        host = c.hostname
        user = opt['-u']
        port = opt['-p']

        peer = user and ('%s@%s' % (user, host)) or host
        cmd = ('export PATH=%s && export LD_LIBRARY_PATH=%s && %s/bin/lib/gplog.py -s -t "%s" -p %s -d %s' % (os.getenv('PATH'), os.getenv('LD_LIBRARY_PATH'), GPHOME, opt['-t'], dbport, data_dir))
        ssh = gplib.ssh_prefix(user, host, port)
	ssh = ssh + ' eval  \'%s\' ' % cmd
        if opt['-v']: print '[INFO %s] %s' % (peer, cmd)
        p = popen2.Popen4(ssh)
        p.x_user = user or ''; p.x_host = host
	p.x_cmd = cmd;   p.x_ssh = ssh
	p.x_peer = peer
	p.tochild.close()
	session.append(p)

    return session

def waitSession(session):
    errmsg = None
    permissionDenied = False
    for p in session:
        p.x_res = p.fromchild.read()
        i = p.x_res.find("BEGINDUMP")
        if i >= 0: p.x_res = p.x_res[i+10:]
        try:
            p.x_res = pickle.loads(p.x_res)
        except KeyboardInterrupt:
            raise
        except:
            if opt['-v']: print p.x_res
            permissionDenied = (p.x_res.find('Permission denied') >= 0)
            if permissionDenied:
                errmsg = '[ERROR %s] ssh permission denied while %s' % (p.x_peer, p.x_ssh)
            else:
                noSuchFile = (p.x_res.find('No such file') >= 0)
                if noSuchFile:
                    errmsg = '[ERROR %s] no such file error while %s' % (p.x_peer, p.x_ssh)
                else:
                    errmsg = '[ERROR %s] bad output while %s' % (p.x_peer, p.x_ssh)
            print errmsg
        if opt['-v']: print p.x_res
	status = p.wait()
        p.pid = 0
	if status:
	    errmsg = '[ERROR %s] Command failed. Exit status = %s. Command = %s' % (p.x_peer, status, p.x_ssh)
	    print errmsg
		
    if permissionDenied:
	print
	print 'hint: check if the host is alive'
	print 'hint: use gpssh-exkeys to setup public-key authentication between hosts'
	print
    if errmsg: sys.exit(1)


def KillSession(session):
    for p in session:
        if p.pid > 0: os.kill(p.pid, signal.SIGTERM)

def perr(host, s):
    print '   ERROR: on %s - %s' % (host, s)


def runsql():
    if opt['-f'] is None:
        return
    fpath = '%s/sql.out' % opt['-o']
    cmd = 'psql -e %s < %s > %s 2>&1' % (opt['-s'], opt['-f'], fpath)
    return run(cmd)

def gp_configuration():
    fpath = '%s/gp_configuration.out' % opt['-o']
    return run('psql -e template1 -c "select * from gp_configuration" > %s 2>&1 ' % fpath)


def pg_stat_activity():
    fpath = '%s/pg_stat_activity.out' % opt['-o']
    return run('psql -e template1 -c "select * from pg_stat_activity" > %s 2>&1' % fpath)

def pg_locks():
    fpath = '%s/pg_locks.out' % opt['-o']
    return run('psql -e template1 -c "select * from pg_locks" > %s 2>&1' % fpath)

def save(fpath, content):
    try:
        f = open(fpath, 'w')
        f.write(content)
        f.close()
    except IOError, e:
        print 'ERROR: write file %s error' % fpath


try:
    parseCommandLine()

    if not os.path.exists(opt['-o']):
        os.mkdir(opt['-o'])

    (ok, out) = run('echo "%s" > %s/timestamp' % (opt['-t'],  opt['-o']))
    if not ok:
        sys.exit('directory %s is not writable' % opt['-o'])

    (ok, out) = runsql()

    (ok, out) = gp_configuration()
    (ok, out) = pg_stat_activity()
    (ok, out) = pg_locks()

    config = Config()
    session = sshGpLog(config)
    waitSession(session)

    dbid = 1
    for p in session:
        dir = '%s/%s' % (opt['-o'], p.x_host)
        if os.path.exists(dir) == False:
            os.mkdir(dir)
        
        key = 'netstat'
        value = p.x_res.get(key)
        if not value:
            perr(p.x_peer, 'netstat failed')

        fpath = '%s/%s' % (dir, key)
        save(fpath, value)

        key = 'pg_hba.conf'
        value = p.x_res.get(key)
        if not value:
            perr(p.x_peer, 'pg_hba.conf not found')

        fpath = '%s/%s' % (dir, key)
        save(fpath, value)

        key = 'log'
        value = p.x_res.get(key)
        if not value:
            value = 'empty log\n'

        
        fpath = '%s/%s%d' % (dir, key, dbid)
        save(fpath, value)

        dbid += 1

    cmd = 'rm -rf %s/gplog.tar.gz ; (cd %s ; tar cvf /tmp/gplog.tar .) ; gzip /tmp/gplog.tar ; cp /tmp/gplog.tar.gz %s ; rm -rf /tmp/gplog.tar.gz' % (opt['-o'], opt['-o'], opt['-o'])
    (ok, out) = run(cmd)
    print 'please send %s/gplog.tar.gz to Greeplum' % opt['-o']

except KeyboardInterrupt:
    killSession(session)
    sys.exit('\nInterrupted ...')
