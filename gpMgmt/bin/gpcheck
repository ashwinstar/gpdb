def testApplianceInittab(host):

    expectedDefaultRunLevel = "3"

    if not host.data.inittab.s1:
        printError(host.hostname, "S1 tty declaration not found in /etc/inittab")

    if host.data.inittab.defaultRunLevel != expectedDefaultRunLevel:
        printError(host.hostname, "default run level in /etc/initab is %s and expected to be %s" % (host.data.inittab.defaultRunLevel, expectedDefaultRunLevel))


def testApplianceSecuretty(host):

    expectedSecureTTys = set(['ttyS1'])

    for tty in expectedSecureTTys:

        if tty not in host.data.securetty.data:

            printError(host.hostname, "%s not detected in /etc/securetty" % tty)


def testSolarisEtcSystem(host):

    requiredValues = {  'rlim_fd_cur' : '65536',
                        'zfs:zfs_arc_max' : '0x600000000',
                        'pcplusmp:apic_panic_on_nmi' : '1',
                        'nopanicdebug' : '1' }

    results = dict()

    for k in requiredValues.keys():
        results[k] = 0
        
    for key in host.data.etc_system.parameters.keys():

        if key not in requiredValues:
            continue

        foundValue = host.data.etc_system.parameters[key]
        if foundValue == requiredValues[key]:
            results[key] = 1

    for k in results.keys():

        if results[k]:
            continue

        printError(host.hostname, "/etc/system is missing expected line 'set %s=%s'" % (k, requiredValues[k]))


def testSolarisEtcProject(host):

    requiredValues = {  'default:3::::project.max-sem-ids=(priv,1024,deny);process.max-file-descriptor=(priv,252144,deny)' : 0 }

    unexpectedValues = set(['default:3::::'])

    for line in host.data.etc_project.lines:
        if line in unexpectedValues:
            printError(host.hostname, "unexpected line in /etc/project: '%s'" % line)
            continue

        if line in requiredValues:
            requiredValues[line] = 1

    for line in requiredValues.keys():
        if requiredValues[line]:
            continue

        printError(host.hostname, "/etc/project is missing expected line '%s'" % line)
        

def testSolarisEtcUserAttr(host):

    requiredValues = { 'gpadmin::::defaultpriv=basic,dtrace_user,dtrace_proc' : 0 }

    for line in host.data.etc_user_attr.lines:
        if line in requiredValues:
            requiredValues[line] = 1

    for line in requiredValues.keys():
        if requiredValues[line]:
            continue

        printError(host.hostname, "/etc/user_attr is missing expected line '%s'" % line)
 

def testApplianceChkconfig(host):

    success = False

    # ipmi should be on for 3 4 5
    ipmi = None
    if 'ipmi' in host.data.chkconfig.services:
        ipmi = host.data.chkconfig.services['ipmi'] # return a dict of run levels and values

    if ipmi:
        lev3 = ipmi['3']
        lev4 = ipmi['4']
        lev5 = ipmi['5']
        if lev3 and lev4 and lev5:
            success = True

    if not success:
        printError(host.hostname, "ipmi service should be on for levels 3 4 and 5")

    services_that_should_be_off = ['iptables', 'ip6tables', 'avahi-daemon', 'avahi-dnsconfd', 'conman', 'bluetooth', 'cpuspeed',
                                   'setroubleshoot', 'hidd', 'hplip', 'kudzu']

    for sname in services_that_should_be_off:

        service = None

        if sname in host.data.chkconfig.services:
            service = host.data.chkconfig.services[sname] # return a dict of run levels and values
        else:
            printError(host.hostname, "service (%s) service not reported on machine in chkconfig output" % (sname))
            continue

        if len(service.keys()) != 7:
            printError(host.hostname, "service (%s) unexpected number of run levels for service" % (sname))
            continue

        for level in service.keys():
            if service[level]:
                printError(host.hostname, "service (%s) should be off" % (sname))
                break

def testBlockdev(host):

    expectedReadAhead = "16384"

    for dev in host.data.blockdev.ra.keys():

        ra = host.data.blockdev.ra[dev]

        if ra != expectedReadAhead:

            printError(host.hostname, "on device (%s) blockdev readahead value '%s' does not match expected value '%s'" % (dev, ra, expectedReadAhead))


def testSysctl(host):

    expectedValues = dict()
    expectedValues['kernel.sem'] = '250 64000 100 512'
    expectedValues['kernel.shmmax'] = '500000000'
    expectedValues['kernel.shmmni'] = '4096'
    expectedValues['kernel.shmall'] = '4000000000'
    expectedValues['kernel.sem'] = '250 64000 100 512'
    expectedValues['kernel.sysrq'] = '1'
    expectedValues['kernel.core_uses_pid'] = '1'
    expectedValues['kernel.msgmnb'] = '65536'
    expectedValues['kernel.msgmax'] = '65536'
    expectedValues['net.ipv4.tcp_syncookies'] = '1'
    expectedValues['net.ipv4.ip_forward'] = '0'
    expectedValues['net.ipv4.conf.default.accept_source_route'] = '0'
    expectedValues['net.ipv4.tcp_tw_recycle'] = '1'
    expectedValues['net.ipv4.tcp_max_syn_backlog'] = '4096'
    expectedValues['net.ipv4.conf.all.arp_filter'] = '1'
    expectedValues['net.core.netdev_max_backlog'] = '10000'
    expectedValues['vm.overcommit_memory'] = '2'

    for k in expectedValues.keys():
        if k not in host.data.sysctl.variables:
            printError(host.hostname, "variable not detected in /etc/sysctl.conf: '%s'" % k)
            continue

        value = host.data.sysctl.variables[k]

        if value != expectedValues[k]:
            printError(host.hostname, "/etc/sysctl.conf value for key '%s' has value '%s' and expects '%s'" % (k, value, expectedValues[k]))


def testIOSchedulers(host):

    expectedScheduler = "deadline"

    for dev in host.data.ioschedulers.devices.keys():

        scheduler = host.data.ioschedulers.devices[dev]

        if scheduler != expectedScheduler:

            printError(host.hostname, "on device (%s) IO scheduler '%s' does not match expected value '%s'" % (dev, scheduler, expectedScheduler))

def testNtp(host):

    if host.data.ntp.currenttime < (gpcheck_info.collection_start_time - 1):
        printError(host.hostname, "potential NTPD issue.  gpcheck start time (%s) time on machine (%s)" % (time.ctime(gpcheck_info.collection_start_time), time.ctime(host.data.ntp.currenttime)))

    if host.data.ntp.currenttime > (gpcheck_info.collection_end_time + 1):
        printError(host.hostname, "potential NTPD issue.  gpcheck end time (%s) time on machine (%s)" % (time.ctime(gpcheck_info.collection_start_time), time.ctime(host.data.ntp.currenttime)))

    if not host.data.ntp.running:
        printError(host.hostname, "ntpd not detected on machine")


def testApplianceNtp(host):

    testNtp(host)

    if host.is_a_master:

        if host.primary_master:
            if 'mdw-cm'  in host.data.ntp.hosts:
                printError(host.hostname, "mdw-cm is a ntpd peer of this master host. The master host, should use an external source")
            if 'smdw-cm'  in host.data.ntp.hosts:
                printError(host.hostname, "smdw-cm is a ntpd peer of this master host. The master host, should use an external source")

        else:
            if 'mdw-cm' not in host.data.ntp.hosts:
                printError(host.hostname, "mdw-cm is not a ntpd peer of this stand by master host")
            if 'smdw-cm'  in host.data.ntp.hosts:
                printError(host.hostname, "smdw-cm is a ntpd peer of this stand by master host. This is redundant.")

    else:
        if 'mdw-cm' not in host.data.ntp.hosts:
            printError(host.hostname, "mdw-cm is not a ntpd peer of this segment host")
        if 'smdw-cm' not in host.data.ntp.hosts:
            printError(host.hostname, "smdw-cm is not a ntpd peer of this segment host")


def testApplianceRclocal(host):

    if not host.data.rclocal.isexecutable:

        printError(host.hostname, "/etc/rc.d/rc.local is not present and executable")

def testLimitsConf(host):

    # utility class for this function only
    class limitsconf_data:
        def __init__(self, expected):
            self.domain = None
            self.value_found = None
            self.value_expected = int(expected)

    # maps tuple (type/item) to limitsconf_data
    table = dict() 
    table[('soft', 'nofile')] = limitsconf_data(65536)
    table[('hard', 'nofile')] = limitsconf_data(65536)
    table[('soft', 'nproc')] = limitsconf_data(131072)
    table[('hard', 'nproc')] = limitsconf_data(131072)

    for entry in host.data.limitsconf.lines:

        if (entry.type, entry.item) not in table:
            continue

        tabledata = table[(entry.type, entry.item)]

        # we only supersede previous data if it is specific to gpadmin or it is * and there is not 
        # specific gpadmin data already
        if entry.domain == 'gpadmin' or (entry.domain == '*' and tabledata.domain != 'gpadmin'):

            tabledata.value_found = entry.value

    for k in table:

        ld = table[k]

        if not ld.value_found:
            printError(host.hostname, "%s %s not found in /etc/security/limits.conf" % (k[0], k[1]))
            continue

        try:
            found = int(ld.value_found)
        except:
            found = 0

        if found < ld.value_expected:

            printError(host.hostname, "%s %s in  /etc/security/limits.conf has value %d lower than expected value %d" % (k[0], k[1], found, ld.value_expected))


def testLinuxMounts(host):

    xfs_mounts = list()

    if gpcheck_info.host_type == HostType.GPCHECK_HOSTTYPE_APPLIANCE:
        if host.is_a_master:
            p = '/dev/sdc'
            loc = '/data'
            hosttype = 'master'
            if p in host.data.mounts.entries:
                entry = host.data.mounts.entries[p]
                if entry.dir != loc:
                    printError(host.hostname, "%s should be mounted at %s on a %s host" % (p, loc, hosttype))
                xfs_mounts.append(entry)
            else:
                printError(host.hostname, "on a %s host '%s' not found in output of mount" % (hosttype, p))
        else:
            hosttype = 'segment'
            p = '/dev/sdb'
            loc = '/data1'
            if p in host.data.mounts.entries:
                entry = host.data.mounts.entries[p]
                xfs_mounts.append(entry)
                if entry.dir != loc:
                    printError(host.hostname, "%s should be mounted at %s on a %s host" % (p, loc, hosttype))
            else:
                printError(host.hostname, "on a %s host '%s' not found in output of mount" % (hosttype, p))
    
            p = '/dev/sdd'
            loc = '/data2'
            if p in host.data.mounts.entries:
                entry = host.data.mounts.entries[p]
                xfs_mounts.append(entry)
                if entry.dir != loc:
                    printError(host.hostname, "%s should be mounted at %s on a %s host" % (p, loc, hosttype))
            else:
                printError(host.hostname, "on a %s host '%s' not found in output of mount" % (hosttype, p))
    else:

        for k in host.data.mounts.entries.keys():
            entry = host.data.mounts.entries[k]
            if entry.type == "xfs":
                xfs_mounts.append(entry)
            
    
    for mnt in xfs_mounts:

        if mnt.type != "xfs":
            printError(host.hostname, "device %s is not XFS and is expected to be so on a %s host" % (mnt.partition, hosttype))
            continue

        expectedOptions = set(gpcheck_config.xfs_mount_options.split(","))

        if len(mnt.options) != len(expectedOptions):
            printError(host.hostname, "XFS filesystem on device %s has %d XFS mount options and %d are expected" % (mnt.partition, len(mnt.options), len(expectedOptions)))

        for opt in expectedOptions:

            if opt not in mnt.options:
                printError(host.hostname, "XFS filesystem on device %s is missing the recommended mount option '%s'" % (mnt.partition, opt))
                continue


def testApplianceHost(host):

    # test chkconfig
    testApplianceChkconfig(host)

