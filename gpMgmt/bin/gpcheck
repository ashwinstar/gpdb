#!/usr/bin/env python
'''
USAGE:   gpcheck -f|--file HOSTFILE -m|--master MASTER_HOST -s|--standymaster MASTER_HOST [--dump]
         where HOSTFILE lists all the hosts to check
         where MASTER_HOST indicates hosts that should be assumed to be master or standby masters
         where --dump will indicate to dump all collected data without doing any checks
'''

import os, sys, re, tempfile, shutil, pickle, getpass

try:
    from optparse import Option, OptionParser 
    from gppylib.gpparseopts import OptParser, OptChecker
    from gppylib.gplog import get_default_logger, setup_tool_logging
    from gppylib.commands.unix import getLocalHostname, getUserName
    from gppylib.commands.base import WorkerPool, Command, REMOTE

except ImportError, e:    
    sys.exit('Cannot import modules.  Please check that you have sourced greenplum_path.sh.  Detail: ' + str(e))

EXECNAME = os.path.split(__file__)[-1]

gphome = None
options = None
logger = None
pool = None
hosts = dict()
tmpdir = None
appliance_version = None
is_root = False
found_errors = False

class GpCheckHost:
    def __init__(self, name):
        self.hostname = name
        self.ismaster = False
        self.datafile = None
        self.data = None
    def __str__(self):
        return "%s ismaster(%s) datafile(%s)" % (self.hostname, self.ismaster, self.datafile)

# True is an error
def parseargs():

    global options, gphome

    parser = OptParser(option_class=OptChecker)
    parser.remove_option('-h')
    parser.add_option('-?', '--help', action='store_true')
    parser.add_option('-d', '--dump', action='store_true')
    parser.add_option('-f', '--file',  type='string')
    parser.add_option('-m', '--master', type='string')
    parser.add_option('-s', '--standbymaster', type='string')
    (options, args) = parser.parse_args()

    global gphome
    gphome = os.environ.get('GPHOME')
    if not gphome:
        logger.error("GPHOME not set")
        return True

    if options.help:
        print __doc__
        return True

    if not options.file:
        logger.error("--file must be specified")
        return True

    return False

def printWarning(msg):
    logger.warning("GPCHECK_WARNING: %s", msg)
    

def printError(msg):
    global found_errors
    found_errors = True
    logger.error("GPCHECK_ERROR: %s", msg)

#true is error
def createHostList():

    logger.info("dedupe hostnames")

    global hosts

    try:
        for line in open(options.file, "r"):
            hostname = line.rstrip()
            cmd = Command(hostname, "hostname", REMOTE, hostname)
            pool.addCommand(cmd)

        pool.join()
        items = pool.getCompletedItems()
        for i in items:
            address = i.remoteHost
            if i.results.rc or i.results.halt or not i.results.completed:
                logger.error("error obtaining information from host %s" % address)
                logger.error(i.results.stderr.strip())
                return True
            actualHostname = i.results.stdout.strip()

            if actualHostname in hosts:
                pass
            else:
                hosts[actualHostname] = GpCheckHost(actualHostname)
                if actualHostname == options.master or actualHostname == options.standbymaster:
                    hosts[actualHostname].ismaster = True

    except Exception, e:
        logger.error("Error while deduping host file: %s" % options.file)
        logger.error(e.__str__())
        return True

    return False

#true is error
def runCollectionOnDells():

    logger.info("generate data on servers")

    global hosts

    try:
        for host in hosts.keys():
            cmdStr = "%s/sbin/gpcheck_hostdump --dell" % gphome
            cmd = Command(host, cmdStr, REMOTE, host)
            pool.addCommand(cmd)

        pool.join()
        items = pool.getCompletedItems()
        for i in items:
            if i.results.rc or i.results.halt or not i.results.completed:
                logger.error("error obtaining information from host %s" % i.remoteHost)
                logger.error(i.results.stderr.strip())
                return True

            hosts[i.remoteHost].datafile = i.results.stdout.strip()
            
    except Exception, e:
        logger.error("Exception collecting data from servers")
        logger.error(e.__str__())
        return True

    return False

#true is error
def copyFilesLocally():

    logger.info("copy data files from servers")

    global hosts

    try:
        for host in hosts.keys():
            cmdStr = "scp %s:%s %s/%s.data" % (host, hosts[host].datafile, tmpdir, host)
            cmd = Command(host, cmdStr)
            pool.addCommand(cmd)

        pool.join()
        items = pool.getCompletedItems()
        for i in items:
            if i.results.rc or i.results.halt or not i.results.completed:
                logger.error("error running cmd: %s" % i.cmdStr)
                logger.error(i.results.stderr.strip())
                return True
    except Exception, e:
        logger.error("Exception collecting data from servers")
        logger.error(e.__str__())
        return True

    return False

#true is error
def deleteRemoteFiles():

    logger.info("delete remote tmp files")

    try:
        for host in hosts.keys():
            cmdStr = "rm -f %s" % hosts[host].datafile
            cmd = Command(host, cmdStr, REMOTE, host)
            pool.addCommand(cmd)

        pool.join()
        items = pool.getCompletedItems()
        for i in items:
            if i.results.rc or i.results.halt or not i.results.completed:
                logger.error("error deleting remote tmp files")
                logger.error(i.results.stderr.strip())
                return True
    except Exception, e:
        logger.error("Exception deleting remote tmp files")
        logger.error(e.__str__())
        return True

    return False


#true is error
def readDataFiles():

    for host in hosts.keys():
        fname = "%s/%s.data" % (tmpdir, host)
        fd = open(fname, "rb")
        hosts[host].data = pickle.load(fd)


def testAppliance1001OmreportBiossetup(host):

    # first NIC should be PXE enabled
    firstNicAttribute = "Dual NIC"
    if host.ismaster:
        firstNicAttribute = "Dual NIC (1/2)"
    pxeText = "Enabled with 1st NIC PXE and 2nd NIC None"

    if firstNicAttribute in host.data.omreport.biossetup:
        firstNicText =  host.data.omreport.biossetup[firstNicAttribute]
        if firstNicText != pxeText:
            printError("host (%s) omreport chassis biossetup '%s:%s' PXE not enabled" % (host.hostname, firstNicAttribute, firstNicText))
    else:
        printError("host (%s) can not find Attribute in omreport chassis biossetup '%s'" % (host.hostname, firstNicAttribute))



def testAppliance1001Chkconfig(host):

    # ipmi should be on for 3 4 5
    ipmi = host.data.chkconfig.services['ipmi'] # return a dict of run levels and values
    success = False

    if ipmi:
        lev3 = ipmi['3']
        lev4 = ipmi['4']
        lev5 = ipmi['5']
        if lev3 and lev4 and lev5:
            success = True

    if not success:
        printError("host (%s) ipmi service should be on for levels 3 4 and 5" % host.hostname)

    services_that_should_be_off = ['iptables', 'ip6tables', 'avahi-daemon', 'avahi-dnsconfd', 'conman', 'bluetooth', 'cpuspeed',
                                   'setroubleshoot', 'hidd', 'hplip', 'kudzu']

    for sname in services_that_should_be_off:

        service = host.data.chkconfig.services[sname] # return a dict of run levels and values

        if not service:
            printError("host (%s) service (%s) service not reported on machine in chkconfig output" % (host.hostname, sname))

        if len(service.keys()) != 7:
            printError("host (%s) service (%s) unexpected number of run levels for service" % (host.hostname, sname))
            continue

        for level in service.keys():
            if service[level]:
                printError("host (%s) service (%s) should be off" % (host.hostname, sname))
                break



def testAppliance1001Host(host):

    # test chkconfig
    testAppliance1001Chkconfig(host)

    # test omreport
    testAppliance1001OmreportBiossetup(host)

    # test grubconf
    # test mounts
    # test inittab
    # test securetty
    # test bcu

######################################################################################


def testAppliance1001():
    for h in hosts.keys():
        testAppliance1001Host(hosts[h])


def runTests():

    global is_root

    if getpass.getuser() == "root":
        is_root = True
    else:
        is_root = False
        printWarning("utility will not check all settings when run as non-root user")

    if appliance_version == "1.0.0.1":
        testAppliance1001()
    else:
        printError("Unkown appliance version: %s" % appliance_version)
        return False

#true is error
def createTmpDir():
    global tmpdir

    try:
        tmpdir = tempfile.mkdtemp(prefix='gpcheck')

    except Exception, e:
        logger.error("error creating tmp dir on master")
        logger.error(e.__str__())
        return True

    return False

#true is error
def runCollections():

    retVal = runCollectionOnDells()
    if retVal:
        return True

    retVal = copyFilesLocally()
    if retVal:
        return True

    retVal = deleteRemoteFiles()
    if retVal:
        return True

    return False

# True for error, for now this utility only works on an appliance
def checkAppliance():
    global appliance_version
    if not os.path.exists('/etc/gpdb-appliance-version'):
        return True

    fd = open('/etc/gpdb-appliance-version')

    appliance_version = fd.read()

    appliance_version = appliance_version.strip()

    logger.info("GPDB Appliance Version: %s" % appliance_version)

    return False


def earlyExit(error = False):

    try:
        if tmpdir:
            shutil.rmtree(tmpdir)
    except Exception, e:
        logger.error("error removing tempdir during job cleanup")
        logger.error(e.__str__())
    
    if error:
        logger.fatal("early exit from gpcheck")
    if pool:
        pool.join()
        pool.haltWork()
        pool.joinWorkers()

    if error:
        sys.exit(1)
    else:
        sys.exit(0)

def doDump():
    for h in hosts:
        print "+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
        print "HOST: %s" % h
        print hosts[h].data.__str__()
        print "+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"


logger = get_default_logger()
setup_tool_logging(EXECNAME,getLocalHostname(),getUserName())

if (parseargs()):
    sys.exit(0)

if (checkAppliance()):
    sys.exit(0)

pool = WorkerPool()

if (createHostList()):
    earlyExit(True)

if (createTmpDir()):
    earlyExit(True)

if (runCollections()):
    earlyExit(True)

if (readDataFiles()):
    earlyExit(True)

if options.dump:
    doDump()
    earlyExit(False)

if (runTests()):
    earlyExit(True)

if not found_errors:
    logger.info("GPCHECK_NORMAL")

earlyExit(False)
