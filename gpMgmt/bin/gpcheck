def testAppliance1001Rclocal(host):

    if not host.data.rclocal.isexecutable:

        printError(host.hostname, "/etc/rc.d/rc.local is not present and executable")

def testAppliance1001LimitsConf(host):

    # utility class for this function only
    class limitsconf_data:
        def __init__(self, expected):
            self.domain = None
            self.value_found = None
            self.value_expected = int(expected)

    # maps tuple (type/item) to limitsconf_data
    table = dict() 
    table[('soft', 'nofile')] = limitsconf_data(65536)
    table[('hard', 'nofile')] = limitsconf_data(65536)
    table[('soft', 'nproc')] = limitsconf_data(131072)
    table[('hard', 'nproc')] = limitsconf_data(131072)

    for entry in host.data.limitsconf.lines:

        if (entry.type, entry.item) not in table:
            continue

        tabledata = table[(entry.type, entry.item)]

        # we only supersede previous data if it is specific to gpadmin or it is * and there is not 
        # specific gpadmin data already
        if entry.domain == 'gpadmin' or (entry.domain == '*' and tabledata.domain != 'gpadmin'):

            tabledata.value_found = entry.value

    for k in table:

        ld = table[k]

        if not ld.value_found:
            printError(host.hostname, "%s %s not found in /etc/security/limits.conf" % (k[0], k[1]))
            continue

        try:
            found = int(ld.value_found)
        except:
            found = 0

        if found < ld.value_expected:

            printError(host.hostname, "%s %s in  /etc/security/limits.conf has value %d lower than expected value %d" % (k[0], k[1], found, ld.value_expected))

def testAppliance1001Mounts(host):

    xfs_mounts = list()

    if host.is_a_master:
        p = '/dev/sdc'
        loc = '/data'
        hosttype = 'master'
        if p in host.data.mounts.entries:
            entry = host.data.mounts.entries[p]
            if entry.dir != loc:
                printError(host.hostname, "%s should be mounted at %s on a %s host" % (p, loc, hosttype))
            xfs_mounts.append(entry)
        else:
            printError(host.hostname, "on a %s host '%s' not found in output of mount" % (hosttype, p))
    else:
        hosttype = 'segment'
        p = '/dev/sdb'
        loc = '/data1'
        if p in host.data.mounts.entries:
            entry = host.data.mounts.entries[p]
            xfs_mounts.append(entry)
            if entry.dir != loc:
                printError(host.hostname, "%s should be mounted at %s on a %s host" % (p, loc, hosttype))
        else:
            printError(host.hostname, "on a %s host '%s' not found in output of mount" % (hosttype, p))

        p = '/dev/sdd'
        loc = '/data2'
        if p in host.data.mounts.entries:
            entry = host.data.mounts.entries[p]
            xfs_mounts.append(entry)
            if entry.dir != loc:
                printError(host.hostname, "%s should be mounted at %s on a %s host" % (p, loc, hosttype))
        else:
            printError(host.hostname, "on a %s host '%s' not found in output of mount" % (hosttype, p))

    for mnt in xfs_mounts:

        # expected XFS options
        # rw,noatime,nodiratime,logbufs=8

        if mnt.type != "xfs":
            printError(host.hostname, "device %s is not XFS and is expected to be so on a %s host" % (mnt.partition, hosttype))
            continue

        if len(mnt.options) != 4:
            printError(host.hostname, "XFS filesystem on device %s has %d XFS mount options and 4 are expected" % mnt.partition)

        simpleoptions = set([ 'rw', 'noatime', 'nodiratime'])
        for opt in simpleoptions:

            if opt not in mnt.options:
                printError(host.hostname, "XFS filesystem on device %s has does not have expected XFS mount options '%s' " % (mnt.partition, opt))
                continue

            value = mnt.options[opt]
            if value:
                printError(host.hostname, "XFS filesystem on device %s has XFS mount option '%s' with a parameter, this XFS option is not expected to have a param " % (mnt.partition, opt))

        logbufs = 'logbufs'
        if logbufs in mnt.options:
            value = mnt.options[logbufs]
            if not value or value != '8':
                printError(host.hostname, "XFS filesystem on device %s has mount option '%s' without expected value '8'" % (mnt.partition, logbufs))
        else:
            printError(host.hostname, "XFS filesystem on device %s has does not have expected XFS mount options '%s' " % (mnt.partition, logbufs))
            


def testAppliance1001Host(host):

    # test chkconfig
    testAppliance1001Chkconfig(host)

    # test omreport
    testAppliance1001OmreportVersion(host)
    testAppliance1001OmreportBios(host)
    testAppliance1001OmreportBiossetup(host)
    testAppliance1001OmreportBootorder(host)
    testAppliance1001OmreportRemoteaccess(host)
    testAppliance1001OmreportVdisks(host)
    testAppliance1001OmreportController(host)

    # test grubconf
    testAppliance1001Grub(host)

    # test mounts
    testAppliance1001Mounts(host)

    # test inittab
    testAppliance1001Inittab(host)

    # test securetty
    testAppliance1001Securetty(host)

    # test bcu
    testAppliance1001Bcu(host)

    # test IO schedulers
    testAppliance1001IOSchedulers(host)

    # test blockdev
    testAppliance1001Blockdev(host)

    # test rclocal
    testAppliance1001Rclocal(host)

    # test sysctl
    testAppliance1001Sysctl(host)

    # test limits.conf
    testAppliance1001LimitsConf(host)


def testUnameConsistency():

    firstUname = None
    firstHost = None

    for h in hosts.keys():

        host = hosts[h]
        uname = host.data.uname.output

        if firstUname:
            if firstUname != uname:
                printError(h, "uname -r output different among hosts: %s : %s != %s : %s" % (firstHost, firstUname, host.hostname, uname))
        else:
            firstUname = uname
            firstHost = host.hostname

def testAppliance1001():
    for h in hosts.keys():
        testAppliance1001Host(hosts[h])

    testUnameConsistency()


def runTests():

    global is_root

    if getpass.getuser() == "root":
        is_root = True
    else:
        is_root = False
        printWarning("utility will not check all settings when run as non-root user")

    if appliance_version == "1.0.0.1":
        testAppliance1001()
    else:
        printError(None, "Unkown appliance version: %s" % appliance_version)
        return False

#true is error
def createTmpDir():
    global tmpdir

    try:
        tmpdir = tempfile.mkdtemp(prefix='gpcheck')

    except Exception, e:
        logger.error("error creating tmp dir on master")
        logger.error(e.__str__())
        return True

    return False

#true is error
def runCollections():

    retVal = runCollectionOnApp1001Serverss()
    if retVal:
        return True

    retVal = copyFilesLocally()
    if retVal:
        return True

    retVal = deleteRemoteFiles()
    if retVal:
        return True

    return False

# True for error, for now this utility only works on an appliance
def checkAppliance():
    global appliance_version
    if not os.path.exists('/etc/gpdb-appliance-version'):
        return True

    fd = open('/etc/gpdb-appliance-version')

    appliance_version = fd.read()

    appliance_version = appliance_version.strip()

    logger.info("GPDB Appliance Version: %s" % appliance_version)

    return False


def earlyExit(error = False):

    try:
        if tmpdir:
            shutil.rmtree(tmpdir)
    except Exception, e:
        logger.error("error removing tempdir during job cleanup")
        logger.error(e.__str__())
    
    if error:
        logger.fatal("early exit from gpcheck")
    if pool:
        pool.join()
        pool.haltWork()
        pool.joinWorkers()

    if error:
        sys.exit(1)
    else:
        sys.exit(0)

def doDump():
    for h in hosts:
        print "+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
        print "HOST: %s" % h
        print hosts[h].data.__str__()
        print "+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"


logger = get_default_logger()
setup_tool_logging(EXECNAME,getLocalHostname(),getUserName())

if (parseargs()):
    sys.exit(0)

if (checkAppliance()):
    sys.exit(0)

pool = WorkerPool()

if (createHostList()):
    earlyExit(True)

if (createTmpDir()):
    earlyExit(True)

if (runCollections()):
    earlyExit(True)

if (readDataFiles()):
    earlyExit(True)

if options.dump:
    doDump()
    earlyExit(False)

if (runTests()):
    earlyExit(True)

if not found_errors:
    logger.info("GPCHECK_NORMAL")

earlyExit(False)
