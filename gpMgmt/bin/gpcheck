def testAppliance1001OmreportVdisks(host):

    deviceName = 'Device Name'
    vdiskSize = 'Size'
    vdiskStripeSize = 'Stripe Element Size'

    allDevices = set()
    virtualDisks = dict() # mapping from device name to dict of properties 
    errmsg = None
    expectedSize = 50000000000
    expectedVdiskStripeSize = '128 KB'

    if host.is_a_master:
        allDevices.add('/dev/sda')
        allDevices.add('/dev/sdb')
        allDevices.add('/dev/sdc')
        errmsg = "on master host"
    else:
        allDevices.add('/dev/sda')
        allDevices.add('/dev/sdc')
        allDevices.add('/dev/sdb')
        allDevices.add('/dev/sdd')
        errmsg = "on segment host"

    # populate dictionary keyed on device name
    for vdisk in host.data.omreport.vdisks:
        if deviceName in vdisk:
            device = vdisk[deviceName]
            virtualDisks[device]  = vdisk

    for dev in allDevices:
        if dev not in virtualDisks:
            printError(host.hostname, "can not find device '%s' expected %s" % (dev, errmsg))
            continue

        vdisk = virtualDisks[dev]

        if vdiskSize in vdisk:
            size = 0
            words = vdisk[vdiskSize].split("(")
            if len(words) == 2:
                words = words[1].split()
                if len(words) > 0:
                    size = int(words[0].strip())
            if size < expectedSize:
                printError(host.hostname, "virtual disk %s size is too small %d bytes. minumum %d bytes." % (dev, size, expectedSize))
        else:
            printError(host.hostname, "attribute %s not found in omreport for virtual disk %s" % (vdiskSize, dev))

        if vdiskStripeSize in vdisk:
            if vdisk[vdiskStripeSize] != expectedVdiskStripeSize:
                printError(host.hostname, "Virtual Disk Stripe Size '%s' does not match expected '%s' for %s" % (vdisk[vdiskStripeSize], expectedVdiskStripeSize, dev))
        
        else:
            printError(host.hostname, "attribute %s not found in omreport for virtual disk %s" % (vdiskStripeSize, dev))


def testAppliance1001OmreportVersion(host):

    expectedOmversion = "6.3.0"

    if expectedOmversion != host.data.omreport.omversion:
        printError(host.hostname, "Version of omreport '%s' does not match expected version '%s'" % (host.data.omreport.omversion, expectedOmversion))


def testAppliance1001OmreportBios(host):

    biosVersion = None

    if host.is_a_master:
        expectedBiosVersion = '2.1.9'
    else:
        expectedBiosVersion = '1.3.6'

    if 'Version' in host.data.omreport.bios:
        biosVersion = host.data.omreport.bios['Version']

    if not biosVersion:
        printError(host.hostname, "Can not identify system bios version using 'omreport chassis bios'")

    elif biosVersion != expectedBiosVersion:
        printError(host.hostname, "using 'omreport chassis bios', bios version '%s' does not match expected value: '%s'" % (biosVersion, expectedBiosVersion))
        


def testAppliance1001OmreportBootorder(host):

    if host.is_a_master:
        if len(host.data.omreport.bootorder) < 2:
            printError(host.hostname, "omreport chassis biossetup attribute=bootorder, less then 2 boot devices on a master host")
        if host.data.omreport.bootorder[0] != "SATA Optical Drive":
            printError(host.hostname, "omreport chassis biossetup attribute=bootorder, first boot device is not the dvd drive")
        if host.data.omreport.bootorder[1] != "Hard drive C:":
            printError(host.hostname, "omreport chassis biossetup attribute=bootorder, second boot device is not the hard drive")
    else:
        if len(host.data.omreport.bootorder) < 1:
            printError(host.hostname, "omreport chassis biossetup attribute=bootorder, less then 1 boot devices on a segment host")
        if host.data.omreport.bootorder[0] != "Hard drive C:":
            printError(host.hostname, "omreport chassis biossetup attribute=bootorder, first boot device is not the hard drive")


def testAppliance1001Grub(host):

    if not host.data.grubconf.serial_declaration:
        printError(host.hostname, "did not detect serial properties declaration in grub.conf file")

    if not host.data.grubconf.terminal_declaration:
        printError(host.hostname, "did not detect terminal properties declaration in grub.conf file")

    if not host.data.grubconf.ttyS1_declaration:
        printError(host.hostname, "did not detect console ttyS1 declaration in grub.conf file")


def testAppliance1001Bcu(host):

    expectedFwversion = 'FCHBA2.2.0.1'

    if host.data.bcu.firmware != expectedFwversion:

        printError(host.hostname, "CNA firmware version '%s' does not match expected '%s'" % (host.data.bcu.firmware, expectedFwversion))



def testAppliance1001Inittab(host):

    expectedDefaultRunLevel = "3"

    if not host.data.inittab.s1:
        printError(host.hostname, "S1 tty declaration not found in /etc/inittab")

    if host.data.inittab.defaultRunLevel != expectedDefaultRunLevel:
        printError(host.hostname, "default run level in /etc/initab is %s and expected to be %s" % (host.data.inittab.defaultRunLevel, expectedDefaultRunLevel))


def testAppliance1001Securetty(host):

    expectedSecureTTys = set(['ttyS1'])

    for tty in expectedSecureTTys:

        if tty not in host.data.securetty.data:

            printError(host.hostname, "%s not detected in /etc/securetty" % tty)


def testAppliance1001Chkconfig(host):

    # ipmi should be on for 3 4 5
    ipmi = host.data.chkconfig.services['ipmi'] # return a dict of run levels and values
    success = False

    if ipmi:
        lev3 = ipmi['3']
        lev4 = ipmi['4']
        lev5 = ipmi['5']
        if lev3 and lev4 and lev5:
            success = True

    if not success:
        printError(host.hostname, "ipmi service should be on for levels 3 4 and 5")

    services_that_should_be_off = ['iptables', 'ip6tables', 'avahi-daemon', 'avahi-dnsconfd', 'conman', 'bluetooth', 'cpuspeed',
                                   'setroubleshoot', 'hidd', 'hplip', 'kudzu']

    for sname in services_that_should_be_off:

        service = host.data.chkconfig.services[sname] # return a dict of run levels and values

        if not service:
            printError(host.hostname, "service (%s) service not reported on machine in chkconfig output" % (sname))

        if len(service.keys()) != 7:
            printError(host.hostname, "service (%s) unexpected number of run levels for service" % (sname))
            continue

        for level in service.keys():
            if service[level]:
                printError(host.hostname, "service (%s) should be off" % (sname))
                break

def testAppliance1001Blockdev(host):

    expectedReadAhead = "16384"

    for dev in host.data.blockdev.ra.keys():

        ra = host.data.blockdev.ra[dev]

        if ra != expectedReadAhead:

            printError(host.hostname, "on device (%s) blockdev readahead value '%s' does not match expected value '%s'" % (dev, ra, expectedReadAhead))


def testAppliance1001Sysctl(host):

    expectedValues = dict()
    expectedValues['kernel.sem'] = '250 64000 100 512'
    expectedValues['kernel.shmmax'] = '500000000'
    expectedValues['kernel.shmmni'] = '4096'
    expectedValues['kernel.shmall'] = '4000000000'
    expectedValues['kernel.sem'] = '250 64000 100 512'
    expectedValues['kernel.sysrq'] = '1'
    expectedValues['kernel.core_uses_pid'] = '1'
    expectedValues['kernel.msgmnb'] = '65536'
    expectedValues['kernel.msgmax'] = '65536'
    expectedValues['net.ipv4.tcp_syncookies'] = '1'
    expectedValues['net.ipv4.ip_forward'] = '0'
    expectedValues['net.ipv4.conf.default.accept_source_route'] = '0'
    expectedValues['net.ipv4.tcp_tw_recycle'] = '1'
    expectedValues['net.ipv4.tcp_max_syn_backlog'] = '4096'
    expectedValues['net.ipv4.conf.all.arp_filter'] = '1'
    expectedValues['net.core.netdev_max_backlog'] = '10000'
    expectedValues['vm.overcommit_memory'] = '2'

    for k in expectedValues.keys():
        if k not in host.data.sysctl.variables:
            printError(host.hostname, "variable not detected in /etc/sysctl.conf: '%s'" % k)
            continue

        value = host.data.sysctl.variables[k]

        if value != expectedValues[k]:
            printError(host.hostname, "/etc/sysctl.conf value for key '%s' has value '%s' and expects '%s'" % (k, value, expectedValues[k]))


