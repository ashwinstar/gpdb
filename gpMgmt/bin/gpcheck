#!/usr/bin/env python
'''
USAGE:   gpcheck -f|--file HOSTFILE -m|--master MASTER_HOST -s|--standymaster MASTER_HOST [--dump]
         where HOSTFILE lists all the hosts to check
         where MASTER_HOST indicates hosts that should be assumed to be master or standby masters
         where --dump will indicate to dump all collected data without doing any checks
'''

import os, sys, re, tempfile, shutil, pickle, getpass

try:
    from optparse import Option, OptionParser 
    from gppylib.gpparseopts import OptParser, OptChecker
    from gppylib.gplog import get_default_logger, setup_tool_logging
    from gppylib.commands.unix import getLocalHostname, getUserName
    from gppylib.commands.base import WorkerPool, Command, REMOTE

except ImportError, e:    
    sys.exit('Cannot import modules.  Please check that you have sourced greenplum_path.sh.  Detail: ' + str(e))

EXECNAME = os.path.split(__file__)[-1]

gphome = None
options = None
logger = None
pool = None
hosts = dict()
tmpdir = None
appliance_version = None
is_root = False
found_errors = False

class GpCheckHost:
    def __init__(self, name):
        self.hostname = name
        self.is_a_master = False
        self.primary_master = False
        self.datafile = None
        self.data = None
    def __str__(self):
        return "%s is_a_master(%s) primary_master(%s) datafile(%s)" % (self.hostname, self.is_a_master, self.primary_master, self.datafile)

# True is an error
def parseargs():

    global options, gphome

    parser = OptParser(option_class=OptChecker)
    parser.remove_option('-h')
    parser.add_option('-?', '--help', action='store_true')
    parser.add_option('-d', '--dump', action='store_true')
    parser.add_option('-f', '--file',  type='string')
    parser.add_option('-m', '--master', type='string')
    parser.add_option('-s', '--standbymaster', type='string')
    (options, args) = parser.parse_args()

    global gphome
    gphome = os.environ.get('GPHOME')
    if not gphome:
        logger.error("GPHOME not set")
        return True

    if options.help:
        print __doc__
        return True

    if not options.file:
        logger.error("--file must be specified")
        return True

    return False

def printWarning(msg):
    logger.warning("GPCHECK_WARNING: %s", msg)
    

def printError(host, msg):
    global found_errors
    found_errors = True
    logger.error("GPCHECK_ERROR host(%s): %s", host, msg)

#true is error
def createHostList():

    logger.info("dedupe hostnames")

    global hosts

    try:
        for line in open(options.file, "r"):
            hostname = line.rstrip()
            cmd = Command(hostname, "hostname", REMOTE, hostname)
            pool.addCommand(cmd)

        pool.join()
        items = pool.getCompletedItems()
        for i in items:
            address = i.remoteHost
            if i.results.rc or i.results.halt or not i.results.completed:
                logger.error("error obtaining information from host %s" % address)
                logger.error(i.results.stderr.strip())
                return True
            actualHostname = i.results.stdout.strip()

            if actualHostname in hosts:
                pass
            else:
                hosts[actualHostname] = GpCheckHost(actualHostname)

                if actualHostname == options.master:
                    hosts[actualHostname].is_a_master = True
                    hosts[actualHostname].primary_master = True

                elif actualHostname == options.standbymaster:
                    hosts[actualHostname].is_a_master = True
                    hosts[actualHostname].primary_master = False

                else:
                    hosts[actualHostname].is_a_master = False
                    hosts[actualHostname].primary_master = False

    except Exception, e:
        logger.error("Error while deduping host file: %s" % options.file)
        logger.error(e.__str__())
        return True

    return False

#true is error
def runCollectionOnApp1001Serverss():

    logger.info("generate data on servers")

    global hosts

    try:
        for host in hosts.keys():
            cmdStr = "%s/sbin/gpcheck_hostdump --app1001" % gphome
            cmd = Command(host, cmdStr, REMOTE, host)
            pool.addCommand(cmd)

        pool.join()
        items = pool.getCompletedItems()
        for i in items:
            if i.results.rc or i.results.halt or not i.results.completed:
                logger.error("error obtaining information from host %s" % i.remoteHost)
                logger.error(i.results.stderr.strip())
                return True

            hosts[i.remoteHost].datafile = i.results.stdout.strip()
            
    except Exception, e:
        logger.error("Exception collecting data from servers")
        logger.error(e.__str__())
        return True

    return False

#true is error
def copyFilesLocally():

    logger.info("copy data files from servers")

    global hosts

    try:
        for host in hosts.keys():
            cmdStr = "scp %s:%s %s/%s.data" % (host, hosts[host].datafile, tmpdir, host)
            cmd = Command(host, cmdStr)
            pool.addCommand(cmd)

        pool.join()
        items = pool.getCompletedItems()
        for i in items:
            if i.results.rc or i.results.halt or not i.results.completed:
                logger.error("error running cmd: %s" % i.cmdStr)
                logger.error(i.results.stderr.strip())
                return True
    except Exception, e:
        logger.error("Exception collecting data from servers")
        logger.error(e.__str__())
        return True

    return False

#true is error
def deleteRemoteFiles():

    logger.info("delete remote tmp files")

    try:
        for host in hosts.keys():
            cmdStr = "rm -f %s" % hosts[host].datafile
            cmd = Command(host, cmdStr, REMOTE, host)
            pool.addCommand(cmd)

        pool.join()
        items = pool.getCompletedItems()
        for i in items:
            if i.results.rc or i.results.halt or not i.results.completed:
                logger.error("error deleting remote tmp files")
                logger.error(i.results.stderr.strip())
                return True
    except Exception, e:
        logger.error("Exception deleting remote tmp files")
        logger.error(e.__str__())
        return True

    return False


#true is error
def readDataFiles():

    for host in hosts.keys():
        fname = "%s/%s.data" % (tmpdir, host)
        fd = open(fname, "rb")
        hosts[host].data = pickle.load(fd)


def testAppliance1001OmreportBiossetup(host):

    # first NIC should be PXE enabled
    firstNicAttribute = "Dual NIC"
    if host.is_a_master:
        firstNicAttribute = "Dual NIC (1/2)"
    pxeText = "Enabled with 1st NIC PXE and 2nd NIC None"

    if firstNicAttribute in host.data.omreport.biossetup:
        firstNicText =  host.data.omreport.biossetup[firstNicAttribute]
        if firstNicText != pxeText:
            printError(host.hostname, "omreport chassis biossetup '%s:%s' PXE not enabled" % (firstNicAttribute, firstNicText))
    else:
        printError(host.hostname, "can not find Attribute in omreport chassis biossetup '%s'" % (firstNicAttribute))

    expectedKeyValuePairs = dict()
    expectedKeyValuePairs['Serial Communications'] = 'On with Console Redirection via COM2'
    expectedKeyValuePairs['Console Redirection After Boot'] = 'Disabled'
    expectedKeyValuePairs['Processor C State Control'] = 'Disabled'

    for k in expectedKeyValuePairs.keys():
        if k in host.data.omreport.biossetup:
            value = host.data.omreport.biossetup[k]
            if value != expectedKeyValuePairs[k]:
                printError(host.hostname, "omreport chassis biossetup attribute '%s' Value '%s' does not match expected '%s'" % (k, value, expectedKeyValuePairs[k]))
        else:
            printError(host.hostname, "can not find Attribute in omreport chassis biossetup '%s'" % (k))

def testAppliance1001OmreportRemoteaccess(host):

    expectedKeyValuePairs = dict()
    expectedKeyValuePairs['Enable IPMI Over LAN'] = 'Yes'
    expectedKeyValuePairs['SOL Enabled'] = 'Yes'
    expectedKeyValuePairs['IP Address Source'] = 'Static'
    expectedKeyValuePairs['IP Subnet'] = '255.255.248.0'

    for k in expectedKeyValuePairs.keys():
        if k in host.data.omreport.remoteaccess:
            value = host.data.omreport.remoteaccess[k]
            if value != expectedKeyValuePairs[k]:
                printError(host.hostname, "omreport chassis remoteaccess attribute '%s' Value '%s' does not match expected '%s'" % (k, value, expectedKeyValuePairs[k]))
        else:
            printError(host.hostname, "can not find Attribute in omreport chassis remoteaccess '%s'" % (k))

    ipaddressAttribute = "IP Address"
    ipadd_root = "172.28.0"
    if host.is_a_master:
        if host.primary_master:
            expectedIpAddress = "%s.250" % ipadd_root
        else:
            expectedIpAddress = "%s.251" % ipadd_root
    else:
        words = host.hostname.split("sdw")
        expectedIpAddress = ipadd_root
        if len(words) == 2:
            expectedIpAddress = "%s.%s" % (expectedIpAddress, words[1])


    if ipaddressAttribute in host.data.omreport.remoteaccess:
        ipaddress = host.data.omreport.remoteaccess[ipaddressAttribute]
        if ipaddress != expectedIpAddress:
            printError(host.hostname, "LOM IP Address %s does not match expected IP Address %s" % (ipaddress, expectedIpAddress))
    else:
        printError(host.hostname, "can not find Attribute in omreport chassis remoteaccess '%s'" % (ipaddressAttribute))



