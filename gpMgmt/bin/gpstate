#	Release stat:-		Greenplum Co internal
#                               Copyright (c) Metapa 2005. All Rights Reserved.
#                               Copyright (c) Greenplum 2005. All Rights Reserved
#	Brief descn:-		Provides state of the Greenplum instance.
#******************************************************************************
# Update History
#******************************************************************************
# Ver	Date		Who		Update
#******************************************************************************
# Detailed Description
#******************************************************************************
#
#******************************************************************************
# Prep Code
# Source required functions file, this required for script to run
# exit if cannot locate this file. Change location of FUNCTIONS variable
# as required.
WORKDIR=`dirname $0`
PYTHON_GPSTATE=$WORKDIR/lib/gpstate.py
FUNCTIONS=$WORKDIR/lib/gp_bash_functions.sh
if [ -f $FUNCTIONS ]; then
		. $FUNCTIONS
else
		echo "[FATAL:]-Cannot source $FUNCTIONS file Script Exits!"
		exit 2
fi
#******************************************************************************
# Location Variables
#******************************************************************************

#******************************************************************************
# Command Variables
#******************************************************************************

#******************************************************************************
# Script Specific Variables
#******************************************************************************
VERBOSE=1
PROG_NAME=`$BASENAME $0`
PROG_NAME=`$BASENAME $0`
HELP_DOC_NAME=`$ECHO $PROG_NAME|$AWK -F'.' '{print $1}'`_help
TIME=`$DATE +%H":"%M":"%S`
CUR_DATE=`$DATE +%Y%m%d`
QD_NAME=`hostname`
EXIT_STATUS=0
WAIT_LIMIT=600
PARALLEL_STATUS_FILE=/tmp/gpstate_parallel_status_file.$$
TMP_SORT_FILE=/tmp/gpstate_parallel_tmp_sort.$$
GPSEGSTATE=$WORKDIR/lib/gpsegstate.sh
#******************************************************************************
# Functions
#******************************************************************************
#
USAGE () {
	if [ -f ${GPDOCDIR}/$HELP_DOC_NAME ] && [ x"" == x"$SCRIPT_USAGE" ];then
		$LESSCMD ${GPDOCDIR}/$HELP_DOC_NAME
		exit 0
	else
		$ECHO
		$ECHO "      `basename $0`"
		$ECHO
		$ECHO "      Reports on the state of the Greenplum Database instance"
		$ECHO
		$ECHO "      Usage:"
		$ECHO "      $0 [OPTIONS]"
		$ECHO
		$ECHO "      General options:"
		$ECHO "      -?, display this help message & exit"
		$ECHO "      -v, display version information & exit"
		$ECHO "      -t, display default parameter settings & exit"
		$ECHO
		$ECHO "      Logging options:"
		$ECHO "      -q, quiet mode, do not log progress to screen [default:- verbose output to screen]"
		$ECHO "      -l, <logfile directory> alternative logfile directory [optional]"
		$ECHO "      -D, set log output to debug level, shows all function calls"
		$ECHO
		$ECHO "      Connection options:"
		$ECHO "      -d, <Master instance directory> name of alternative Master instance to report status of [optional]"
		$ECHO
		$ECHO "      Status options:"
		$ECHO "      -s, Display detailed Greenplum instance status"
		$ECHO "      -m, List mirror segments of Greenplum database"
		$ECHO "      -c, List primary/mirror segment instance mapping of Greenplum database"
		$ECHO "      -p, List Greenplum instance ports"
		$ECHO "      -b, Display a brief Greenplum instance status summary [default]"
		$ECHO "      -Q, Display a quick Greenplum instance status summary, will obtain state from Master instance"
		$ECHO "          only, will not pole the segment instance databases"
		$ECHO "      -i, Display system version information"
		$ECHO "      -f, Display details of standby master host if configured"
		$ECHO "      -B, <number> run this batch of state segment processes in parallel [default $BATCH_DEFAULT]"
		$ECHO
		$ECHO "      Return codes:"
		$ECHO "      0 No problems encountered with requested operation"
		$ECHO "      1 Warning generated"
		$ECHO "      2 Fatal error, unable to complete requested operation"
		$ECHO
		exit $EXIT_STATUS
	fi
}

UNKNOWN_OPTION () {
		$ECHO
		$ECHO "[ERROR]:-Unknown option $1"
		USAGE
}

DISPLAY_PARAM () {
		GET_MASTER_PORT $MASTER_DATA_DIRECTORY
		$ECHO
		$ECHO "Current Default State Parameters"
		$ECHO "--------------------------------"
		$ECHO "Greenplum Master instance port      = $MASTER_PORT"
		$ECHO "Greenplum Master instance directory = $MASTER_DATA_DIRECTORY [Override with -d <master instance directory>]"
		if [ $VERBOSE ]; then
				$ECHO "Verbose                       = True             [Override with -q]"
		else
				$ECHO "Verbose                       = False"
		fi 
		$ECHO
		exit $EXIT_STATUS
}

GET_FAIL_SETTING () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	FAIL_TYPE=`${EXPORT_LIB_PATH};env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $MASTER_PORT -d "$QD_DBNAME" -R" " -A -t -c"show gp_fault_action;"`
	ERROR_CHK $? "obtain fault action setting" 2
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

GET_STANDBY_SETTING () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	MASTER_STANDBY_HOSTNAME=`${EXPORT_LIB_PATH};env PGOPTIONS="-c gp_session_role=utility" $PSQL -p $MASTER_PORT -d "$QD_DBNAME" -R" " -A -t -c"select hostname from $CONFIG_TABLE a where content=-1 and dbid<>1;"`
	ERROR_CHK $? "Obtain standby hostname" 1
	if [ x"" == x"$MASTER_STANDBY_HOSTNAME" ];then
		STANDBY_CONFIGURED="No master standby configured"
	else
		STANDBY_CONFIGURED="$MASTER_STANDBY_HOSTNAME"
		if [ `$HOSTNAME` == $MASTER_STANDBY_HOSTNAME ];then
			STANDBY_STATE="STANDBY HOST ACTIVE INSTANCE MASTER"
		else
			STANDBY_STATE="Standby host passive";fi
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}


SORT_FILE () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	$CAT $PARALLEL_STATUS_FILE|$SORT -t: -k2,5 > $TMP_SORT_FILE
	$MV $TMP_SORT_FILE $PARALLEL_STATUS_FILE
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

QUICK_DATABASE_STATUS () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"

    $PYTHON_GPSTATE -Q -d $MASTER_DATA_DIRECTORY $VERBOSE_PYTHON_OPTION

	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

VERSION_INFO () {
    LOG_MSG "[INFO]:-Start Function $FUNCNAME"

    $PYTHON_GPSTATE -i -d $MASTER_DATA_DIRECTORY $VERBOSE_PYTHON_OPTION

    LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

CLUSTER_CONFIG () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"

    $PYTHON_GPSTATE -c -d $MASTER_DATA_DIRECTORY $VERBOSE_PYTHON_OPTION

	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

MIRROR_LIST () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"

    $PYTHON_GPSTATE -m -d $MASTER_DATA_DIRECTORY $VERBOSE_PYTHON_OPTION

	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

LIST_GP_PORTS () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"

    $PYTHON_GPSTATE -p -d $MASTER_DATA_DIRECTORY $VERBOSE_PYTHON_OPTION

	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

STANDBY_HOST_DETAILS () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"

    $PYTHON_GPSTATE -f -d $MASTER_DATA_DIRECTORY $VERBOSE_PYTHON_OPTION

	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

DATABASE_STATUS () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"

    $PYTHON_GPSTATE -s -d $MASTER_DATA_DIRECTORY $VERBOSE_PYTHON_OPTION

    LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

SET_VAR () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
		QE_NAME=`$ECHO $TNODE|$CUT -d"|" -f1`
		QE_DIR=`$ECHO $TNODE|$CUT -d"|" -f2`
		QE_PORT=`$ECHO $TNODE|$CUT -d"|" -f3`
		QE_VALID=`$ECHO $TNODE|$CUT -d"|" -f4`
		QE_PRIMARY=`$ECHO $TNODE|$CUT -d"|" -f5`
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

GET_STATUS_INFORMATION () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	QE_COUNT=0
	if [ ! -s $MASTER_DATA_DIRECTORY/$PG_PID ]; then
		ERROR_EXIT "[WARN]:-Master instance down" 1
	else
		GET_QE_DETAILS
		GET_TRANS_READ
	fi
	LOG_MSG "[INFO]:-Processing status request, please wait..." 1
	GET_STANDBY_DETAILS
	if [ ${#STANDBY_ARRAY[@]} -eq 0 ];then
		STANDBY_TEXT="NOT CONFIGURED"
	else
		MASTER_STANDBY_HOSTNAME=`$ECHO $STANDBY_ARRAY|$CUT -d"|" -f1`
		MASTER_STANDBY_PORT=`$ECHO $STANDBY_ARRAY|$CUT -d"|" -f3`
		GET_PG_PID_ACTIVE $MASTER_STANDBY_PORT $MASTER_STANDBY_HOSTNAME
		if [ $PID -eq 0 ];then
			STANDBY_TEXT="Down <<<<<<<<<<"
		else
			STANDBY_TEXT="Passive"
		fi
	fi
	BATCH_LIMIT=${#QE_ARRAY[@]}
	PARALLEL_SETUP  $PARALLEL_STATUS_FILE
	for TNODE in "${QE_ARRAY[@]}"
	do
		SET_VAR
		if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $NOLINE_ECHO ".\c";fi
		$GPSEGSTATE $$ $QE_NAME $QE_PORT $QE_DIR $QE_VALID $QE_PRIMARY $INST_COUNT $LOG_FILE $MASTER_PORT 1 & 
		PARALLEL_COUNT $BATCH_LIMIT $BATCH_DEFAULT
	done
	if [ $DEBUG_LEVEL -eq 0 ];then $NOLINE_ECHO;fi
	$CAT $PARALLEL_STATUS_FILE >> $LOG_FILE
	SUMMARY_REPORT
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

SUMMARY_REPORT () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	#Now process the temp file
	KILLED_COUNT=`$GREP -c "KILLED:" $PARALLEL_STATUS_FILE`
	#Get total reported as completed
	COMPLETED_COUNT=`$GREP -c "COMPLETED:" $PARALLEL_STATUS_FILE`
	#Get total reported as ping fail
	PING_FAILED_COUNT=`$GREP -c "PING_FAIL:" $PARALLEL_STATUS_FILE`
	#Get total number of primary segments 
	QE_PRIMARY_COUNT=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' '{print $5}'|$GREP -c "t"`
	#Get total number of mirror segments
	QE_MIRROR_COUNT=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' '{print $5}'|$GREP -c "f"`
	#Get total primary segments marked as valid from master
	AT_MASTER_PRIMARY_VALID=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' '{print $5$6}'|$GREP -c "tt"`
	#Get total primary segments marked as invalid from master
	AT_MASTER_PRIMARY_INVALID=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' '{print $5$6}'|$GREP -c "tf"`
	#Get total mirror segments marked as valid from master
	AT_MASTER_MIRROR_VALID=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' '{print $5$6}'|$GREP -c "ft"`
	#Get total mirror segments marked as invalid from master
	AT_MASTER_MIRROR_INVALID=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' '{print $5$6}'|$GREP -c "ff"`
	#Get total number of primary errors reported
	QE_TOTAL_PRIMARY_ERROR_COUNT=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' 'BEGIN {x=0} {if ($7 > 0 && $5 == "t") x=x+$7} END {print x}'`
	#Get total number of mirror errors reported
	QE_TOTAL_MIRROR_ERROR_COUNT=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':'  'BEGIN {x=0} {if ($7 > 0 && $5 == "f") x=x+$7} END {print x}'`
	#Get total number of primary postmaster.pid files missing
	QE_TOTAL_PRIMARY_POSTMASTER_PID_FILE_MISSING=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' 'BEGIN {x=0} {if ($5 == "t") x += $8} END {print x}'`
	QE_TOTAL_MIRROR_POSTMASTER_PID_FILE_MISSING=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' 'BEGIN {x=0} {if ($5 == "f") x += $8} END {print x}'`
	#Get total number of primary postmaster.pid files located
	QE_TOTAL_PRIMARY_POSTMASTER_PID_FILE_FOUND=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' 'BEGIN {x=0} {if ($5 == "t" && $8 == 0) x=x+1} END {print x}'`
	#Get total number of mirror postmaster.pid files located
	QE_TOTAL_MIRROR_POSTMASTER_PID_FILE_FOUND=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' 'BEGIN {x=0} {if ($5 == "f" && $8 == 0) x=x+1} END {print x}'`
	#Get total primary PID values in error from postmaster.pid file
	QE_TOTAL_PRIMARY_POSTMASTER_PID_ERROR=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' 'BEGIN {x=0} {if ($5 == "t" && $9 == 1) x=x+1} END {print x}'`
	#Get total mirror PID values in error from postmaster.pid file
	QE_TOTAL_MIRROR_POSTMASTER_PID_ERROR=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' 'BEGIN {x=0} {if ($5 == "f" && $9 == 1) x=x+1} END {print x}'`
	#Get total primary PID values not in error in postmaster.pid file
	QE_TOTAL_PRIMARY_POSTMASTER_PID_VALID=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' 'BEGIN {x=0} {if ($5 == "t" && $9 > 1) x=x+1} END {print x}'`
	#Get total mirror PID values not in error in postmaster.pid file
	QE_TOTAL_MIRROR_POSTMASTER_PID_VALID=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' 'BEGIN {x=0} {if ($5 == "f" && $9 > 1) x=x+1} END {print x}'`
	#Get total number of primary /tmp lock files missing
	QE_TOTAL_PRIMARY_LOCK_MISSING=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' 'BEGIN {x=0} {if ($5 == "t") x += $10} END {print x}'`
	#Get total number of mirror /tmp lock files missing
	QE_TOTAL_MIRROR_LOCK_MISSING=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' 'BEGIN {x=0} {if ($5 == "f") x += $10} END {print x}'`
	#Get total number of primary /tmp lock files found
	QE_TOTAL_PRIMARY_LOCK_FOUND=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' 'BEGIN {x=0} {if ($5 == "t" && $10 == 0) x=x+1} END {print x}'`
	#Get total number of mirror /tmp lock files found
	QE_TOTAL_MIRROR_LOCK_FOUND=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' 'BEGIN {x=0} {if ($5 == "f" && $10 == 0) x=x+1} END {print x}'`
	#Get total number of primary postmaster pid processes missing
	QE_POST_PRIMARY_PID_MISSING=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' 'BEGIN {x=0} {if ($5 == "t" && $11 == 1) x=x+1} END {print x}'`
	#Get total number of mirror postmaster pid processes missing
	QE_POST_MIRROR_PID_MISSING=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' 'BEGIN {x=0} {if ($5 == "f" && $11 == 1) x=x+1} END {print x}'`
	#Get total number of primary postmaster pid processes found
	QE_POST_PRIMARY_PID_FOUND=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' 'BEGIN {x=0} {if ($5 == "t" && $11 > 1) x=x+1} END {print x}'`
	#Get total number of mirror postmaster pid processes found
	QE_POST_MIRROR_PID_FOUND=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' 'BEGIN {x=0} {if ($5 == "f" && $11 > 1) x=x+1} END {print x}'`
	#Get total number of mirror segments that are marked as active
	QE_MIRROR_SEGMENT_ACTIVE=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' '{x += $12} END {print x}'`	
	#Get total number of mirror segments that are marked as passive
	QE_MIRROR_SEGMENT_PASSIVE=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' 'BEGIN {x=0} {if ($5 == "f" && $12 == 0) x=x+1 } END {print x}'`
	#Get total number of mirrors marked as invalid
	QE_MIRROR_SEGMENT_FAILED=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' 'BEGIN {x=0} {if ($5 == "f" && $13 > 0) x=x+1} END {print x}'`
	#Get  total number of primaries marked as invalid
	QE_PRIMARY_SEGMENT_FAILED=`$CAT $PARALLEL_STATUS_FILE|$AWK -F':' 'BEGIN {x=0} {if ($5 == "t" && $14 > 0) x=x+1} END {print x}'`
	$RM -f $PARALLEL_STATUS_FILE	
	WARN_MARK="<<<<<<"
	if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $ECHO;fi
		LOG_MSG "[INFO]:-Greenplum instance status summary" 1
		LOG_MSG "[INFO]:------------------------------------------------" 1
		LOG_MSG "[INFO]:-Master instance                               = Active"  1
		LOG_MSG "[INFO]:-Master instance read-only                     = $TRANS_STATE" 1
		LOG_MSG "[INFO]:-Master instance standby                       = $STANDBY_TEXT" 1
		if [ $MULTI_HOME -eq 0 ];then
		LOG_MSG "[INFO]:-Greenplum array configuration type            = Standard" 1
		else
		LOG_MSG "[INFO]:-Greenplum array configuration type            = Mult-home " 1
		fi
		LOG_MSG "[INFO]:------------------------------------------------" 1
		LOG_MSG "[INFO]:-Total segment instance count from meta data   = $INST_COUNT" 1
		LOG_MSG "[INFO]:------------------------------------------------" 1
		LOG_MSG "[INFO]:-Parallel process exit status" 1
		LOG_MSG "[INFO]:------------------------------------------------" 1
		LOG_MSG "[INFO]:-Total processes marked as completed           = $COMPLETED_COUNT" 1
		if [ $KILLED_COUNT -ne 0 ];then
		LOG_MSG "[WARN]:-Total processes marked as killed              = $KILLED_COUNT $WARN_MARK" 1
		EXIT_STATUS=1
		else
		LOG_MSG "[INFO]:-Total processes marked as killed              = 0" 1
		fi
		if [ $PING_FAILED_COUNT -ne 0 ];then
		LOG_MSG "[WARN]:-Total processes marked as ping failed         = $PING_FAILED_COUNT $WARN_MARK" 1
		EXIT_STATUS=1
		else
		LOG_MSG "[INFO]:-Total processes marked as ping failed         = 0" 1
		fi
		LOG_MSG "[INFO]:------------------------------------------------" 1
		LOG_MSG "[INFO]:-Primary Segment Status" 1
		LOG_MSG "[INFO]:------------------------------------------------" 1
		LOG_MSG "[INFO]:-Total primary segments                        = $QE_PRIMARY_COUNT" 1
		LOG_MSG "[INFO]:-Total primary segment valid (at master)       = $AT_MASTER_PRIMARY_VALID" 1
		if [ $AT_MASTER_PRIMARY_INVALID -ne 0 ];then
		LOG_MSG "[WARN]:-Total primary segment failures (at master)    = $AT_MASTER_PRIMARY_INVALID $WARN_MARK" 1
		EXIT_STATUS=1
		else
		LOG_MSG "[INFO]:-Total primary segment failures (at master)    = 0" 1
		fi
		if [ $QE_TOTAL_PRIMARY_ERROR_COUNT -ne 0 ];then
		LOG_MSG "[WARN]:-Total number of errors generated (remote)     = $QE_TOTAL_PRIMARY_ERROR_COUNT $WARN_MARK" 1
		EXIT_STATUS=1
		else
		LOG_MSG "[INFO]:-Total number of errors generated (remote)     = 0" 1
		fi
		if [ $QE_TOTAL_PRIMARY_POSTMASTER_PID_FILE_MISSING -ne 0 ];then
		LOG_MSG "[WARN]:-Total number of postmaster.pid files missing  = $QE_TOTAL_PRIMARY_POSTMASTER_PID_FILE_MISSING $WARN_MARK" 1
		EXIT_STATUS=1
		else
		LOG_MSG "[INFO]:-Total number of postmaster.pid files missing  = 0" 1
		fi
		LOG_MSG "[INFO]:-Total number of postmaster.pid files found    = $QE_TOTAL_PRIMARY_POSTMASTER_PID_FILE_FOUND" 1
		if [ $QE_TOTAL_PRIMARY_POSTMASTER_PID_ERROR -ne 0 ];then
		LOG_MSG "[WARN]:-Total number of postmaster.pid PID's missing  = $QE_TOTAL_PRIMARY_POSTMASTER_PID_ERROR $WARN_MARK" 1
		EXIT_STATUS=1
		fi
		LOG_MSG "[INFO]:-Total number of postmaster.pid PID's valid    = $QE_TOTAL_PRIMARY_POSTMASTER_PID_VALID" 1
		if [ $QE_TOTAL_PRIMARY_LOCK_MISSING -ne 0 ];then
		LOG_MSG "[WARN]:-Total number /tmp lock files missing          = $QE_TOTAL_PRIMARY_LOCK_MISSING $WARN_MARK" 1
		EXIT_STATUS=1
		else
		LOG_MSG "[INFO]:-Total number /tmp lock files missing          = 0" 1
		fi
		LOG_MSG "[INFO]:-Total number /tmp lock files found            = $QE_TOTAL_PRIMARY_LOCK_FOUND" 1
		if [ $QE_POST_PRIMARY_PID_MISSING -ne 0 ];then
		LOG_MSG "[WARN]:-Total number postmaster processes missing     = $QE_POST_PRIMARY_PID_MISSING $WARN_MARK" 1
		EXIT_STATUS=1
		else
		LOG_MSG "[INFO]:-Total number postmaster processes missing     = 0" 1
		fi
		LOG_MSG "[INFO]:-Total number postmaster processes found       = $QE_POST_PRIMARY_PID_FOUND" 1
		if [ $QE_PRIMARY_SEGMENT_FAILED -ne 0 ];then
		LOG_MSG "[WARN]:-Total number segments invalid at hosts        = $QE_PRIMARY_SEGMENT_FAILED $WARN_MARK" 1
		EXIT_STATUS=1
		else
		LOG_MSG "[INFO]:-Total number segments invalid at hosts        = 0" 1
		fi
		LOG_MSG "[INFO]:------------------------------------------------" 1
		LOG_MSG "[INFO]:-Mirror Segment Status" 1
		LOG_MSG "[INFO]:------------------------------------------------" 1
		if [ $QE_MIRROR_COUNT -eq 0 ];then
			LOG_MSG "[INFO]:-Mirrors not configured on this array" 1
			LOG_MSG "[INFO]:------------------------------------------------" 1
		else
			LOG_MSG "[INFO]:-Total mirror segments                         = $QE_MIRROR_COUNT" 1
			LOG_MSG "[INFO]:-Total mirror segment valid (at master)        = $AT_MASTER_MIRROR_VALID" 1
			if [ $AT_MASTER_MIRROR_INVALID -ne 0 ];then
			LOG_MSG "[WARN]:-Total mirror segment failures (at master)     = $AT_MASTER_MIRROR_INVALID $WARN_MARK" 1
			EXIT_STATUS=1
			else
			LOG_MSG "[INFO]:-Total mirror segment failures (at master)     = 0" 1
			fi
			if [ $QE_TOTAL_MIRROR_ERROR_COUNT -ne 0 ];then
			LOG_MSG "[WARN]:-Total number of errors generated (remote)     = $QE_TOTAL_MIRROR_ERROR_COUNT $WARN_MARK" 1
			EXIT_STATUS=1
			else
			LOG_MSG "[INFO]:-Total number of errors generated (remote)     = 0" 1
			fi
			if [ $QE_TOTAL_MIRROR_POSTMASTER_PID_FILE_MISSING -ne 0 ];then
			LOG_MSG "[WARN]:-Total number of postmaster.pid files missing  = $QE_TOTAL_MIRROR_POSTMASTER_PID_FILE_MISSING $WARN_MARK" 1
			EXIT_STATUS=1
			else
			LOG_MSG "[INFO]:-Total number of postmaster.pid files missing  = 0" 1
			fi
			LOG_MSG "[INFO]:-Total number of postmaster.pid files found    = $QE_TOTAL_MIRROR_POSTMASTER_PID_FILE_FOUND" 1
			if [ $QE_TOTAL_MIRROR_POSTMASTER_PID_ERROR -ne 0 ];then
			LOG_MSG "[WARN]:-Total number of postmaster.pid PID's missing  = $QE_TOTAL_MIRROR_POSTMASTER_PID_ERROR $WARN_MARK" 1
			EXIT_STATUS=1
			fi
			LOG_MSG "[INFO]:-Total number of postmaster.pid PID's valid    = $QE_TOTAL_MIRROR_POSTMASTER_PID_VALID" 1
			if [ $QE_TOTAL_MIRROR_LOCK_MISSING -ne 0 ];then
			LOG_MSG "[WARN]:-Total number /tmp lock files missing          = $QE_TOTAL_MIRROR_LOCK_MISSING $WARN_MARK" 1
			EXIT_STATUS=1
			else
			LOG_MSG "[INFO]:-Total number /tmp lock files missing          = 0" 1
			fi
			LOG_MSG "[INFO]:-Total number /tmp lock files found            = $QE_TOTAL_MIRROR_LOCK_FOUND" 1
			if [ $QE_POST_MIRROR_PID_MISSING -ne 0 ];then
			LOG_MSG "[WARN]:-Total number postmaster processes missing     = $QE_POST_MIRROR_PID_MISSING $WARN_MARK" 1
			EXIT_STATUS=1
			else
			LOG_MSG "[INFO]:-Total number postmaster processes missing     = 0" 1
			fi
			LOG_MSG "[INFO]:-Total number postmaster processes found       = $QE_POST_MIRROR_PID_FOUND" 1
			if [ $QE_MIRROR_SEGMENT_ACTIVE -ne 0 ];then
			LOG_MSG "[WARN]:-Total number mirror segments active           = $QE_MIRROR_SEGMENT_ACTIVE $WARN_MARK" 1
			EXIT_STATUS=1
			else
			LOG_MSG "[INFO]:-Total number mirror segments active           = 0" 1
			fi
			LOG_MSG "[INFO]:-Total number mirror segments passive          = $QE_MIRROR_SEGMENT_PASSIVE" 1
			if [ $QE_MIRROR_SEGMENT_FAILED -ne 0 ];then
			LOG_MSG "[WARN]:-Total number segments invalid at hosts        = $QE_MIRROR_SEGMENT_FAILED $WARN_MARK" 1
			EXIT_STATUS=1
			else
			LOG_MSG "[INFO]:-Total number segments invalid at hosts        = 0" 1
			fi
		fi
	$RM -f $PARALLEL_STATUS_FILE
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

GET_GP_VERSION () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
		GP_INIT_VERSION=`${EXPORT_LIB_PATH};env PGOPTIONS="-c gp_session_role=utility" $PSQL -q -p $MASTER_PORT -d "$QD_DBNAME" -A -t -c "select * from gp_version_at_initdb limit 1;" 2>/dev/null`
		ERROR_CHK $? "obtain Greenplum initdb version information" 2
		GP_VERSION=`${EXPORT_LIB_PATH};env PGOPTIONS="-c gp_session_role=utility" $PSQL -q -p $MASTER_PORT -d "$QD_DBNAME" -A -t -c "select version();" 2>/dev/null`
		ERROR_CHK $? "obtain Greenplum version information" 2
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

DISPLAY_RO_MASTER () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	LOG_MSG "[INFO]:----------------------------------------" 1
	LOG_MSG "[INFO]:-Master read only hostname = `$HOSTNAME`" 1
	LOG_MSG "[INFO]:-Master read only port     = $MASTER_PORT" 1
	LOG_MSG "[INFO]:-Master read only status   = Active" 1
	LOG_MSG "[INFO]:----------------------------------------" 1
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}
#******************************************************************************
# Main Section
#******************************************************************************
#Check to see if we have a parameter supplied to script
trap '$RM -f $PARALLEL_STATUS_FILE;ERROR_EXIT "[FATAL]:-Recieved INT or TERM signal" 2' INT TERM
SELECT=6
if [ $# -ne 0 ]; then
		while getopts ":vtbl:d:nieqsmcpf'?'r:g:!DB:Q" opt;do
				case $opt in
						v ) VERSION_INFO ;;
						t ) DISPLAY_PARAM ;;
						'?' ) USAGE ;;
						! ) SCRIPT_USAGE=1
						    USAGE ;;
						d ) MASTER_DATA_DIRECTORY=$OPTARG ;;
						q ) unset VERBOSE ;;
						s ) SELECT=1 ;;
						m ) SELECT=2 ;;
						c ) SELECT=3 ;;
						p ) SELECT=4 ;; 					
						b ) SELECT=6 ;;
						i ) SELECT=7 ;;
						f ) SELECT=8 ;;
						Q ) SELECT=9 ;;					
						l ) LOG_DIR=$OPTARG ;;					
						D ) DEBUG_LEVEL=1 ;;
						B ) BATCH_DEFAULT=$OPTARG ;;
						* ) UNKNOWN_OPTION ;;
				esac
		done	
fi
if [ x"" != x"$LOG_DIR" ];then
	CHK_DIR $LOG_DIR
	if [ $EXISTS -eq 1 ]; then
		LOG_MSG "[WARN]:-Log directory $LOG_DIR does not exist, using default log directory" 1
		EXIT_STATUS=1
else
	LOG_FILE=$LOG_DIR/${PROG_NAME}_${CUR_DATE}.log
	fi
fi
CHK_ON_PASSIVE_STANDBY

VERBOSE_PYTHON_OPTION=
if [ $DEBUG_LEVEL -eq 1 ];then
    VERBOSE_PYTHON_OPTION=-v
fi

LOG_MSG "[INFO]:-Start Main"
LOG_MSG "[INFO]:-Command line options passed to utility = $*"

DONE_IN_PYTHON=1
case $SELECT in
        1 ) DATABASE_STATUS ;; 
		2 ) MIRROR_LIST ;;
		3 ) CLUSTER_CONFIG ;;
        4 ) LIST_GP_PORTS ;;
		7 ) VERSION_INFO ;;
        8 ) STANDBY_HOST_DETAILS ;;
		9 ) QUICK_DATABASE_STATUS ;;
        * ) DONE_IN_PYTHON=0;;
esac

if [ $DONE_IN_PYTHON -ne 0 ];then
    LOG_MSG "[INFO]:-End Main"
    exit $EXIT_STATUS
fi

CHK_GPDB_ID
CHK_DB_RUNNING
GET_MASTER_PORT $MASTER_DATA_DIRECTORY
CHK_MULTI_HOME
GET_QD_DB_NAME
READ_CHK
if [ $READ_COUNT -ne 0 ];then
	DISPLAY_RO_MASTER
	LOG_MSG "[INFO]:-End Main"
	exit 0
fi
GET_MIRROR_TYPE
case $SELECT in
		6 ) GET_STATUS_INFORMATION ;;
esac
$RM -f $PARALLEL_STATUS_FILE


LOG_MSG "[INFO]:-End Main"
exit $EXIT_STATUS
