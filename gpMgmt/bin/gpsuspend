#!/usr/bin/env python
#
# Copyright (c) Greenplum Inc 2009. All Rights Reserved. 
#
try:
    
    import os, sys
    from optparse import Option, OptionParser 
    from gppylib.gpparseopts import OptParser, OptChecker
    from gppylib.gparray import *
    from gppylib.gplog import *
    from gppylib.commands.unix import *
    from gppylib.commands.gp import *
    from gppylib.db import dbconn
    from gppylib.userinput import *
    from pygresql.pgdb import DatabaseError

except ImportError, e:    
    sys.exit('Cannot import modules.  Please check that you have sourced greenplum_path.sh.  Detail: ' + str(e))

EXECNAME = os.path.split(__file__)[-1]

_help = [""""""

]

def waitForResumeCommand():
    try:
        reply = ask_string(None, "Database is paused. When you are ready, type a command below to resume or quit.", 'quit', ['quit','resume'])
    except:
        sys.exit(0)
    if reply == 'resume':
        return True
    else:
        return False


def parseargs():

    parser = OptParser(option_class=OptChecker)

    parser.setHelp(_help)

    parser.remove_option('-h')
    parser.add_option('-h', '-?', '--help', action='help', help='show this help message and exit')
    parser.add_option('-v','--verbose', action='store_true', help='debug output.')

    parser.add_option('--pause', action='store_true', help='pause greenplum db')
    parser.add_option('--resume', action='store_true', help='resume greenplum db')

    parser.add_option('--pausefile', type='string', help='pause file path')

    parser.add_option('--batchsize', type='int', help='number of parallel processes to run connecting to other hosts')

    parser.add_option('--noninteractive', action='store_false', dest='interactive', help='do not wait for user response in interactive mode')

    parser.set_defaults(batchsize=16, interactive=True)

    # Parse the command line arguments
    (options, args) = parser.parse_args()

    # sanity check 
    if options.pause and options.resume:
        print "Select either --pause or --resume, see --help for more info"
        parser.exit()

    if (not options.pause) and (not options.resume):
        print "Select either --pause or --resume, see --help for more info"
        parser.exit()

    if (not options.pausefile) and options.resume:
        print "--pausefile must be specified with --resume";
        parser.exit()

    if options.pausefile and options.pause:
        print "--pausefile cannot be specified with --pause";
        parser.exit()

    if (options.batchsize > 250 or options.batchsize < 1):
        print "batchsize must be between 1 and 250"
        parser.exit()

    # other validations
    USER=os.getenv('USER')
    if USER is None or USER is ' ':
        sys.exit('Please set USER environment variable')

    # master db setup
    if options.pause:
        try:
            options.master_data_directory = get_masterdatadir()
            options.gphome = get_gphome()
        except GpError, msg:
            logger.error(msg)
            parser.exit()

        if not os.path.exists(options.master_data_directory):
            logger.error('Master data directory does not exist.')
            parser.exit()


    # generate a pause file name
    if options.pause:
        pausef = time.strftime("/gp_pause.%Y%m%d.%H%M.dat")
        options.pausefile = options.gphome + pausef

    return options

def create_host_datadir_map(gparray):
    """ create a dictionary that maps hostnames to \n seperated gp_configuration strings on that host """

    hosts = dict()

    for seg in gparray.getSegDbList():
        if not seg.valid:
            continue

        if seg.hostname in hosts:
            # append next config string
            hosts[seg.hostname] = hosts[seg.hostname] + "\n" + seg.get_gp_configuration_string()
        else:
            # first config string for this host
            hosts[seg.hostname]  = seg.get_gp_configuration_string()

    return hosts

def connectToSegmentHosts(hosts, doResume):

    pool = WorkerPool(numWorkers=options.batchsize)
    errorString = ""

    try:
        earlyexit = False
        for h in hosts.keys():

            cmd = GpSuspendSegmentsOnHost(name="seg " + h, gpconfigstrings=hosts[h], resume=doResume, ctxt=REMOTE, remoteHost=h)
            pool.addCommand(cmd)

        pool.join()
        pool.check_results()

    except Exception, e:
        earlyexit = True
        errorString = e.__str__()

    pool.haltWork()
    pool.joinWorkers()

    if earlyexit:
        logger.fatal('Failed to process all segments: ' + errorString)
        return False

    return True


def suspend_greenplum(options):
    """ method to suspend an instance of greenplum db """

    try:
        dburl = dbconn.DbURL()

        logger.info("START: connecting to gp_configure table")
        gparray = createGPDBFromDB(dburl,utility=True)
        logger.info("DONE: connecting to gp_configure table")

        logger.info("START: creating pause file " + options.pausefile)
        dumpToFile(gparray, options.pausefile)
        logger.info("DONE: creating pause file " + options.pausefile)

    except DatabaseError, ex:
        logger.error('Failed to connect to database, exiting without action.')
        sys.exit(1)

    hostMap = create_host_datadir_map(gparray)

    logger.info("START: pausing the master postgres instance") 
    try:
        pausePg(gparray.master)
    except:
        logger.critical("Could not pause master postgres instance.")
        return False

    logger.info("DONE: pausing the master postgres instance") 

    logger.info("START: pausing the segment postgres instances") 
    if connectToSegmentHosts(hosts=hostMap, doResume=False):
        logger.info("DONE: pausing the segment postgres instances") 
        return True
    else:
        logger.info("pause of db was incomplete.")
        return False


def resume_greenplum(options):
    rerunmsg = "To rerun resume run: " + EXECNAME + " --resume --pausefile " + options.pausefile

    try:
        logger.info("START: reading gpsuspend pausefile: " + options.pausefile)
        gparray = createFromFile(options.pausefile)
        logger.info("DONE: reading gpsuspend pausefile: " + options.pausefile)
    except:
        logger.critical('Failed reading gpsuspend pausefile.')
        logger.info(rerunmsg)
        logger.fatal('exiting early.')
        sys.exit(1)

    hostMap = create_host_datadir_map(gparray)

    logger.info("START: resuming the segment postgres instances") 
    if connectToSegmentHosts(hosts=hostMap, doResume=True):
        logger.info("DONE: resuming the segment postgres instances") 
    else:
        logger.fatal('failure issuing resume on a segment host')
        logger.fatal("Could not resume all processes. Exiting early.")
        logger.info(rerunmsg)
        sys.exit(1)
 
    logger.info("START: resuming the master postgres instance") 

    try:
        resumePg(gparray.master)
    except:
        logger.fatal('resume failed to resume master postgres instance.')
        logger.info(rerunmsg)
        sys.exit(1)

    logger.info("DONE: resuming the master postgres instance") 


#------------------------------- Mainline --------------------------------
 
logger = get_default_logger()
setup_tool_logging(EXECNAME,getLocalHostname(),getUserName())

options = parseargs()

if options.verbose:
    enable_verbose_logging()

if options.pause:
    if suspend_greenplum(options): # suspend operation succesful
        if options.interactive:           
            if waitForResumeCommand():
                resume_greenplum(options)

    else: # suspend operation failed
        logger.critical("suspend failed, try to run a resume to ensure system is fully operational")
        resume_greenplum(options) 
        logger.critical("suspend was rolled back due to failure of suspend.  System is live.")
        sys.exit(1);

elif options.resume:
    resume_greenplum(options)

logger.info("--done--")
