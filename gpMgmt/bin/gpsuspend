#!/usr/bin/env python
#
# Copyright (c) Greenplum Inc 2009. All Rights Reserved. 
'''
USAGE: gpsuspend [--pause] [--resume]       # either pause or resume must be specified
                 [--pausefile FILE]         # when resuming specify the pause file created when pausing the system
                 [--noninteractive]         # exit after pausing system, do not wait for user to press keys to resume system
                 [--batchsize NUM]          # set number of conncurrent ssh jobs to nodes, default 16
                 [--verbose]                # show verbose information
                 [--help]                   # show this help message
'''

try:
    import os, sys, time
    import  gppylib.gplog
    from optparse import Option, OptionParser 
    from gppylib.gpparseopts import OptParser, OptChecker
    from gppylib.gparray import GpArray
    from gppylib.commands.base import WorkerPool, REMOTE
    from gppylib.commands.gp import GpSuspendSegmentsOnHost, GpError, get_masterdatadir, get_gphome, pausePg, resumePg
    from gppylib.commands.unix import getLocalHostname, getUserName, SYSTEM
    from gppylib.db import dbconn
    from gppylib.userinput import ask_string
    from pygresql.pgdb import DatabaseError
    from gppylib.gphostcache import GpHostCache
    from pygresql.pg import DB     #  Need this for admin sql, such as create/drop db
    from gppylib.gpcoverage import GpCoverage

except ImportError, e:    
    sys.exit('Cannot import modules.  Please check that you have sourced greenplum_path.sh.  Detail: ' + str(e))

EXECNAME = os.path.split(__file__)[-1]
RESUME_MSG = None
FTS_ON_SQL = "set gp_fts_probe_pause=off"
FTS_OFF_SQL = "set gp_fts_probe_pause=on"

def parseargs():
    parser = OptParser(option_class=OptChecker) 
    parser.remove_option('-h')
    parser.add_option('-h', '--help', action='store_true')
    parser.add_option('-v','--verbose', action='store_true')

    parser.add_option('--pause', action='store_true')
    parser.add_option('--resume', action='store_true')

    parser.add_option('--pausefile', type='string')

    parser.add_option('--batchsize', type='int', default=16)

    parser.add_option('--developertestmode', type='int', default=0)

    parser.add_option('--noninteractive', action='store_false', dest='interactive', default=True)

    # Parse the command line arguments
    (options, args) = parser.parse_args()

    if options.help:
        print __doc__
        sys.exit(1)

    # sanity check 
    if options.pause and options.resume:
        print "Select either --pause or --resume, see --help for more info"
        parser.exit()

    if (not options.pause) and (not options.resume):
        print "Select either --pause or --resume, see --help for more info"
        parser.exit()

    if (not options.pausefile) and options.resume:
        print "--pausefile must be specified with --resume";
        parser.exit()

    if options.pausefile and options.pause:
        print "--pausefile cannot be specified with --pause";
        parser.exit()

    if (options.batchsize > 250 or options.batchsize < 1):
        print "batchsize must be between 1 and 250"
        parser.exit()

    # other validations
    USER=os.getenv('USER')
    if USER is None or USER is ' ':
        sys.exit('Please set USER environment variable')

    # master db setup
    if options.pause:
        try:
            options.master_data_directory = get_masterdatadir()
            options.gphome = get_gphome()
        except GpError, msg:
            logger.error(msg)
            parser.exit()

        if not os.path.exists(options.master_data_directory):
            logger.error('Master data directory does not exist.')
            parser.exit()


    # generate a pause file name
    if options.pause:
        pausef = time.strftime("/gp_pause.%Y%m%d.%H%M.dat")
        options.pausefile = options.gphome + pausef

    global RESUME_MSG
    RESUME_MSG = "To run resume run: " + EXECNAME + " --resume --pausefile " + options.pausefile

    return options


def connectToSegmentHosts(cache, doResume):

    pool = WorkerPool(numWorkers=options.batchsize)
    errorString = ""

    try:

        earlyexit = False

        for h in hostCache.get_hosts():

            hostString = None

            # construct a string that combines all the strings of seg db's for a single host
            for seg in h.dbs:

                if not hostString:
                    hostString = seg.__repr__()
                else:
                    hostString = "%s\n%s" % (hostString, seg.__repr__())
                
            cmd = GpSuspendSegmentsOnHost(name=h.hostname, gpconfigstrings=hostString, resume=doResume, ctxt=REMOTE, remoteHost=h.hostname)
            pool.addCommand(cmd)

        pool.join()
        pool.check_results()

    except Exception, e:
        earlyexit = True
        errorString = e.__str__()

    pool.haltWork()
    pool.joinWorkers()

    if earlyexit:
        logger.fatal('Failed to process all segments: ' + errorString)
        return False

    return True


def suspend_greenplum(gparray, cache):
   
    try:
        # turn off the fts prober
        changeFtsMode(On=False)

        logger.info("pausing the master postgres instance.") 
        pausePg(gparray.master)

        if gparray.standbyMaster:
            logger.info("pausing the standby master postgres instance.") 
            pausePg(gparray.standbyMaster)

    except:
        logger.critical("Could not pause master postgres instance.")
        return False

    logger.info("pausing the segment postgres instances.") 
    if connectToSegmentHosts(cache=cache, doResume=False):
        return True
    else:
        return False


def resume_greenplum(gparray, cache):

    logger.info("resuming the segment postgres instances") 
    if not connectToSegmentHosts(cache=cache, doResume=True):
        logger.fatal('failure issuing resume on a segment host')
        logger.fatal("Could not resume all processes. Exiting early.")
        logger.info(RESUME_MSG)
        sys.exit(1)

    try:
        if gparray.standbyMaster:
            logger.info("resuming the standby master postgres instance.") 
            resumePg(gparray.standbyMaster)

        logger.info("resuming the master postgres instance.") 
        resumePg(gparray.master)

        # turn on the fts prober
        changeFtsMode(On=True)

    except:
        logger.fatal('resume failed to resume master postgres instance.')
        logger.info(rerunmsg)
        sys.exit(1)


def waitForResumeCommand():
    try:
        reply = ask_string(None, "Database is paused. When you are ready, type a command below to resume or quit.", 'quit', ['quit','resume'])
    except:
        sys.exit(0)
    if reply == 'resume':
        return True
    else:
        return False

def getGparray(dbUp, pausefile):

    if dbUp:
        try:
            dburl = dbconn.DbURL()
            gparray = GpArray.initFromCatalog(dburl,utility=True)
            gparray.dumpToFile(pausefile)
            return gparray

        except DatabaseError, ex:
            logger.error('Failed to connect to database, exiting without action.')
            return None
    else:
        try:
            gparray = GpArray.initFromFile(pausefile)
            return gparray

        except DatabaseError, ex:
            logger.error('Failed to read pausefile, exiting without action.')
            return None


def changeFtsMode(On):

    if On:
        sql = FTS_ON_SQL
    else:
        sql = FTS_OFF_SQL

    try:
        dburl = dbconn.DbURL()
        conn = dbconn.connect( dburl )
        DB(conn).query( sql )

    except DatabaseError, ex:
            errstring = "Database error changing fts mode with sql: " + sql
            errstring = errstring + "\n" + ex.__str__()
            logger.error(errstring)
            raise Exception('Fts Mode change failed')
    except Exception, e:
            errstring = "Failed changing fts mode with sql: " + sql
            errstring = errstring + "\n" + e.__str__()
            logger.error(errstring)
            raise Exception('Fts Mode change failed')


#------------------------------- Mainline --------------------------------

coverage = GpCoverage()
coverage.start()

logger = gppylib.gplog.get_default_logger()
gppylib.gplog.setup_tool_logging(EXECNAME, getLocalHostname(), getUserName())

options = parseargs()

if options.verbose:
    gppylib.gplog.enable_verbose_logging()

logger.info("gathering cluster information ...")

gparray = getGparray(dbUp=options.pause, pausefile=options.pausefile)
pool = WorkerPool(numWorkers=options.batchsize)
hostCache = GpHostCache(gparray, pool, list())
hostCache.ping_hosts(pool) # substibtute usable names
pool.haltWork()
pool.joinWorkers()

if options.pause:

    if SYSTEM.getName() == "linux":
        logger.info("linux os detected ... xfs_freeze is recommended before snapshotting the database.")

    success = suspend_greenplum(gparray=gparray, cache=hostCache)

    if success:
        if options.developertestmode:
            # option for automated testing of pause and resume after a sleep time
            print "Sleeing %d seconds before resuming db" % options.developertestmode
            time.sleep(options.developertestmode)
            resume_greenplum(gparray=gparray, cache=hostCache)

        elif options.interactive:
            if waitForResumeCommand():
                resume_greenplum(gparray=gparray, cache=hostCache)
            else:
                logger.info(RESUME_MSG)
        else:
            logger.info(RESUME_MSG)

    else: # suspend operation failed
        logger.critical("Suspend failed. Resuming db to ensure system is fully operational.")
        resume_greenplum(gparray=gparray, cache=hostCache) 
        logger.critical("Suspend was rolled back due to failure of suspend.  System is live.")
        sys.exit(1);

elif options.resume:
    resume_greenplum(gparray=gparray, cache=hostCache)

coverage.stop()
coverage.generate_report()

logger.info("--done--")
