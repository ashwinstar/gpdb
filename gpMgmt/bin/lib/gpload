#!/usr/bin/env python

import sys
if sys.hexversion<0x2050000:
    sys.stderr.write("gpload needs python version at least 2.5.\n")
    sys.exit(2)

try:
    import yaml
except ImportError:
    sys.stderr.write("gpload needs pyyaml.  You can get it from http://pyyaml.org.\n")
    sys.exit(2)

try:
    import pg8000
except ImportError:
    sys.stderr.write("gpload needs pg8000.\n")
    sys.exit(2)
 
import os,signal,socket,subprocess,threading,traceback

def quote(a):
    b = ["'"]
    for c in a:
	if c=="'":
	    b.append("''")
	else:
	    b.append(c)
    b.append("'")
    return "".join(b)
		

class CatThread(threading.Thread):
    def __init__(self,gpload,fd):
	threading.Thread.__init__(self)
	self.gpload = gpload
	self.fd = fd
    def run(self):
	while 1:
	    line = a.stdout.readline()
	    if line=='':
		break
	    gpload.log(line.strip('\n'))

def usage():
    sys.stderr.write("%s [-h hostname] [-p port] [-U username] [-d databasename] configfile\n"%sys.argv[0])
    sys.exit(2)

class options:
    pass

class gpload:

    def __init__(self,argv):
	self.exitValue = 0
	self.options = options()
	self.options.h = None
	self.options.p = None
	self.options.U = None
	self.options.d = None
	while argv:
	    if argv[0]=='-h':
		self.options.h = argv[1]
		argv = argv[2:]
	    elif argv[0]=='-p':
		self.options.p = int(argv[1])
		argv = argv[2:]
	    elif argv[0]=='-U':
		self.options.U = argv[1]
		argv = argv[2:]
	    elif argv[0]=='-d':
		self.options.d = argv[1]
		argv = argv[2:]
	    else:
		break
	if len(argv)!=1:
	    usage()
	f = open(argv[0],'r')
	self.config = yaml.load(f.read())
	f.close()
	self.logfile = None
	self.subprocesses = []
	logfile = self.getconfig('gpload.logfile',str)
	if logfile!=None:
	    self.logfile = open(logfile,'a')

    def log(self,a):
	a += '\n'
	if self.logfile:
	    self.logfile.write(a)
	sys.stdout.write(a)

    def getconfig(self,a,typ=None,default='error'):
	s = a.split('.')
	b = []
	c = self.config
	for i in xrange(len(s)):
	    if type(c)!=dict or s[i] not in c:
		if default=='error':
		    self.log("Configuration must contain--")
		    for j in xrange(i+1):
			self.log('    '*j+s[j]+':')
		    sys.exit(2)
		return default
	    c = c[s[i]]
	if typ!=None and type(c)!=typ:
	    if typ==list:
		self.log("This configuration must be a sequence--")
	    elif typ==dict:
		self.log("This configuration must be a mapping--")
	    elif typ==str:
		self.log("This configuration must be a scalar string--")
	    elif typ==int:
		self.log("This configuration must be a scalar integer--")
	    else:
		assert 0
	    for j in xrange(i+1):
		self.log('    '*j+s[j]+':')
	    sys.exit(2)
	return c

    def read_config(self):
	self.table = self.getconfig('gpload.into.connection.table',str)
	if self.options.h==None:
	    self.options.h = self.getconfig('gpload.into.connection.hostname',str)
	if self.options.p==None:
	    self.options.p = self.getconfig('gpload.into.connection.port',int)
	if self.options.U==None:
	    self.options.U = self.getconfig('gpload.into.connection.username',str)
	if self.options.d==None:
	    self.options.d = self.getconfig('gpload.into.connection.database',str)

    def start_gpfdists(self):
	sources = self.getconfig('gpload.from.source')
	if type(sources)!=list:
	    sources = [sources]
	for source in sources:
	    ipaddr = source.get('ipaddr',socket.gethostname())
	    if type(ipaddr)!=list:
		ipaddr = [ipaddr]
	    if 'port' in source:
		startPort = endPort = source['port']
	    elif 'portrange' in source:
		startPort = source['portrange']['start']
		endPort = source['portrange']['end']
	    else:
		startPort = 8000
		endPort = 9000
	    infile = source.get('infile')
	    if type(infile)!=list:
		infile = [infile]
	    a = subprocess.Popen("gpfdist -p %d -P %d"%(startPort,endPort),shell=True,stdout=subprocess.PIPE)
	    self.subprocesses.append(a)
	    while 1:
		line = a.stdout.readline()
		if line=='':
		    self.log('Failed to start gpfdist.')
		    sys.exit(2)
		line = line.strip('\n')
		self.log(line)
		if line.startswith('Serving HTTP on port '):
		    port = int(line[21:line.index(',')])
		    break
	    self.log('gpfdist is running on port %d'%port)
	    CatThread(self,a.stdout)

    def setup_connection(self):
	self.pg8000 = pg8000.Connection(user=self.options.U,host=self.options.h,port=self.options.p,database=self.options.d)

    def read_columns(self):
	columns = self.getconfig('gpload.from.columns',list,None)
	if columns!=None:
	    self.column_name = []
	    self.column_type = []
	    for d in columns:
		key = d.keys()[0]
		self.column_name.append(key)
		self.column_type.append(d[key])

    def read_table_metadata(self):
	self.pg8000.execute("select * from information_schema.columns where table_name=%s order by ordinal_position"%quote(self.table))
	count = 0
	self.column_name = []
	self.column_type = []
	for row in self.pg8000.iterate_dict():
	    count += 1
	    ct = row['data_type']
	    if row['character_maximum_length']!=None:
		ct += '(%s)'%row['character_maximum_length']
	    self.column_name.append(row['column_name'])
	    self.column_type.append(ct)
	if count==0:
	    self.log('Table %s does not seem to exist.'%self.table)
	    sys.exit(2)
	self.log('Metadata for table %s is--'%self.table)
	for i in xrange(len(self.column_name)):
	    self.log('%s: %s'%(self.column_name[i],self.column_type[i]))
	self.log('')

    def read_mapping(self):
	mapping = self.getconfig('gpload.into.mapping',dict,None)
	if mapping!=None:
	    pass

    def run2(self):
	self.read_config()
	self.setup_connection()
	self.read_table_metadata()
	self.read_columns()
	self.read_mapping()
	self.start_gpfdists()

    def run(self):
	try:
	    self.run2()
	except Exception,a:
	    if self.logfile:
		traceback.print_exc(file=self.logfile)
	    raise
	finally:
	    for a in self.subprocesses:
		try:
		    os.kill(a.pid,signal.SIGTERM)
		except OSError:
		    pass

g = gpload(sys.argv[1:])
g.run()
sys.exit(g.exitValue)
