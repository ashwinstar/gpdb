#!/usr/bin/env python
'''
gprsyncd.py -- run a rsync daemon on a directory

Usage: gprsyncd.py [-v] port dirpath

	input: a secret name for access. The secret name
                is one word without special char.
        output: if all is ok, print the string '[START RSYNC NOW]' 
        	before starting rsync daemon
	error: 
	    exit 73 if dir does not exist
	    exit 74 if rsync not found
            exit 75 if secret name not provided
            exit 76 for illegal secret name
'''
import sys, os, subprocess, getopt, re

class Global():
    USER = os.environ.get('USER', 'nobody')
    SUFFIX = '%s.%d' % (USER, os.getpid())
    (verbose, port, dirpath, secret) = (False, 0, None, None)

GV = Global()


###############################
def usage(exitarg = None):
    print __doc__
    sys.exit(exitarg)

################
def parse_port(val):
    try: val = int(val)
    except ValueError: val = 0
    return val


###############################
def parseCommandLine():
    try:
        (options, args) = getopt.getopt(sys.argv[1:], 'v')
    except Exception, e:
        usage('[ERROR] ' + str(e))

    for (switch, val) in options:
        if switch == '-v': GV.verbose = True

    if (len(args) != 2):
        usage('[ERROR] Missing arguments')

    GV.port = parse_port(args[0])
    GV.dirpath = os.path.abspath(args[1])
    if not GV.dirpath:
        print '[ERROR] Bad path in argument'
        usage(73)

    if not os.path.exists(GV.dirpath):
        print '[ERROR] Path "%s" does not exist' % GV.dirpath
        usage(73)

    if not os.path.isdir(GV.dirpath):
        print '[ERROR] Path "%s" is not a directory' % GV.dirpath
        usage(73)

    GV.secret = sys.stdin.readline()
    GV.secret = GV.secret.strip()
    if not GV.secret: 
        print '[ERROR] secret name not provided'
        sys.exit(75)
    re.compile('[a-zA-Z0-9._]+')
    if not re.match(GV.secret):
        print '[ERROR] illegal secret name'
        sys.exit(76)


###############################
def startRsyncDaemon(port, secret):
    '''Start rsync daemon locally'''

    def makeConfFile():
        '''Create rsyncd config files in /tmp. Use the global SUFFIX to ensure unique filenames'''
        fname = '/tmp/rsyncd.conf.' + GV.SUFFIX
        print 'fname', fname
        f = open(fname, 'w')
        f.write('pid file = /tmp/rsyncd.pid.%s\n' % GV.SUFFIX)
        f.write('log file = /tmp/rsyncd.log.%s\n' % GV.SUFFIX)
        f.write('\n')
        f.write('[%s]\n' % secret)
        f.write('\t path = %s\n' % GV.dirpath)
        f.write('\t use chroot = false\n')
        f.close()
        return fname


    # check if rsync exists
    if os.system('''bash -c 'type -a rsync' 2>&1 > /dev/null'''):
        print '[ERROR] rsync not found'
        sys.exit(74)
    # exec rsync daemon
    confpath = makeConfFile()
    sys.stdout.write('[START SYNC NOW]\n')
    sys.stdout.flush()
    os.execlp('rsync', 
              '--port=%d' % port, 
              '--daemon',
              '--no-detach', 
              '--config=%s' % confpath)

###############################
if __name__ == '__main__':
    parseCommandLine()
    startRsyncDaemon(GV.port, GV.secret)
