###################################################
#
# gpcheckos-SunOS.lib
#
#  v1.3
#
# This library contains the test functions associated with the
# gpcheckos script for SunOS systems.
#
# CHANGELOG:
#
# 1.1 -
#    -changed how the ipmitool fru print output is evaluated.  Instead of
#     stopping when a fru number is tested and not found, it stops looking
#     for the chassis fru after looking at 100 potential fru ids.  This makes
#     it much more likely we will find the server type and serial number.
#
#    -added support for -q to the lnout function so that most statements
#     are not sent to screen when -q is given at the command line.
#
#    -changed some of the output statements to overrid -q when present.
#
# 1.2 -
#    -changed how patches are evaluated.  If an both an oboslete patch and the
#     current patch that replaced it are present, no comment is made on the
#     obsolete patch.
#
#    -changed how the res file is evaluated so that the temp files created are
#     deleted if present before rebuilding them.  This prevents duplicate
#     entries in the temp files.
#
# 1.2.1 -
#    -changed check4root to use the id command instead of who am i.  This
#     allows the script to execute for users who su to root instead of logging
#     in.
#
# 1.3 -
#    -added Linux support (different library)
#    
#    -changed how the CURR_KERNEL variable is filled to trim spaces
#
#    -changed the dump and swap comparison such that it succeeds of swap and 
#     dump is greater than or equal to physical RAM


###################################################
# Functions in this library:
#
#  check4root - returns a 0 if the current user is root and a
#               1 if not.
#
#  parse_res - reads the resource file and generates the temporary
#              files.
#
#  versions - shows the versions of the main script, the resource
#             file, and the lib file that will be used on this 
#             system.
#
#  summary - produces the configuration summary.
#
#  patches_tests - examines the patches found, the current patch set, and 
#                  all previous patch set.  Returns a patch-by-patch 
#                  analysis showing if each found patch is current,
#                  from a previous patch set (along with its replacement),
#                  or an unsupported patch.
#
#  os_tests - examines the OS configuration and notes where it deviates 
#             from the standards.
#
#  storage_tests - examines the storage configuration and notes where it
#                  deviates from teh standard.
#
#  network_tests - examines the network configuration and notes where it 
#                  deviates from teh standard.
#
#  interconnect_tests - determines of the master and segment nodes have 
#                       connectivity on all NICs as expected.
#
###################################################
# VARIABLES
#
#  The following variables are defined and set in the calling script.
#
#  TEMP_DIR - the location where the functions store temporary files.
#  RES_FILE_NM - the name, without path, of the resource file
#  CONFIG_DIR - the path where the resource file is stored
#  LOG_FILE - the path and file name of the output file
#  LOG_DIR - the path with the log file will be stored
#  RUN_NM - the name given to the script run by the user in command parameters
#  ITER - the run number given to the script run by the user in command params
#
# The following variables are set globally and may be used in more than
# one function in this library or by the calling script.
#

#version of this file
LIB_VERS=1.3

#name of the file containing the resource file version
RES_VERS_FI=RES_VERS

#name of the file containing release information after parsing
RELEASE_FND_FI=RELEASE_FND

#name of the file holding the patches found installed
PATCHES_FND_FI=PATCHES_FOUND

#name of the file holding the patches currently approved
PATCHES_CUR_FI=CURR_PATCHES

#name of the file holding the approved patch history
PATCHES_OLD_FI=OLD_PATCHES

#name of the file holding the supported releases
RELEASES_FI=RELEASES

#name of the current release file
CURR_RELEASE_FI=CURR_RELEASE

#name of the file holding the supported kernels
KERNELS_FI=KERNELS

#name of the current release file
CURR_KERNEL_FI=CURR_KERNEL

#name of the file listing supported servers
SUPP_SERVERS_FI=SUPP_SERVERS

#name of the file listing services to disable
SVCS_2_DISABLE_FI=SVCS_2_DISABLE

#listing of services found
SVCS_FND_FI=SVCS_FND

#latest currently supported kernel patch
CURR_KERNEL=""

#latest currently supported release line
CURR_RELEASE=""

#holds the uname string found
UNAME_FND=""

#size of the RAM found
RAM_SIZ_FND=""

#swap device found
SWAP_DEV_FND=""

#swap size found
SWAP_SIZ_FND=""

#dump device found
DMP_DEV_FND=""

#dump size found
DMP_SIZ_FND=""

#number of disks detected
DSK_CNT_FND=""

#live upgrade status: 0 is configured, 1 is unconfigured
LUSTATUS_FND=""

#temp file for ifconfig results
IFCONFIG_FI=IFCONFIG

#temp file for nic negotiation results
AUTONEG_FI=AUTONEG_INFO

#network property setting vars
REQ_MAX_Q_FND=""
REQ_MAX_Q0_FND=""
LG_ANON_P_FND=""
SM_ANON_P_FND=""
TIME_WAIT_FND=""

#server info
SERVER_FND=""
SERIAL=FND=""

#zfs pools present.  Empty is yes and "no" is no.
export POOLS_PRESENT_FND=1

#Solaris volume manager configured.  0 is configured and 1 is not
export SVM_PRESENT=1

#number of processors found
NUM_PROCS=""

###################################################
# functions:

###################################################
#
# lnout
#
# This function formats lines out in a standard way.
#
lnout()
{
  #loop incrementer
  local i=0

  #the number of tabs to put in front of the line
  local num_tabs=0

  #indicates whether the line should go to screen and log of just log
  #0 is both
  #1 is log only
  #2 is log only and not append (overwrites file)
  #3 overrids -q option.  When -q is set, all messages go to the log.
  #any other value puts the line out to the screen only.
  local output_mode=1

  #name of the output file
  local dest_file=""
 
  #the test in the line to outpu
  local lineout=""

  #the printf template
  local pf_templ=""

  #set num_tabs to the first incoming argument
  num_tabs=${1}

  #set the output mode
  shift 1
  output_mode=${1}

  #set the output file name
  shift 1
  dest_file=${1}

  #set the line out to the remaining arguments
  shift 1
  lineout="${*}"

  #set the printf template
  while [ ${i} -lt ${num_tabs} ]; do
    pf_templ=${pf_templ}"     "
    i=`expr ${i} + 1`
  done

  pf_templ=${pf_templ}"%s\n"

  if [ ${output_mode} -eq 3 ]; then
    output_mode=0
  elif [ "X${QUIET_MODE}" == "Xtrue" ] && [ ${output_mode} -eq 0 ]; then
    output_mode=1
  fi

  #output the line
  if [ ${output_mode} -eq 0 ]; then
    printf "${pf_templ}" "${lineout}" | tee -a ${dest_file}
  elif [ ${output_mode} -eq 1 ]; then
    printf "${pf_templ}" "${lineout}" >> ${dest_file}
  elif [ ${output_mode} -eq 2 ]; then
    printf "${pf_templ}" "${lineout}" > ${dest_file}
  else
    printf "${pf_templ}" "${lineout}"
  fi
}

###################################################
#
# check4root
#
# This function is called form the main script to insure tha that the 
# current user is root.
#
check4root()
{

  #check the current user id
  local CURR_USR=`id | cut -d '(' -f2 | cut -d')' -f1`

  #if the user is root, return a 0.
  if [ "X${CURR_USR}" = "Xroot" ]; then
    return 0
 
  #otherwise, see if the user has root privs
  else
    return 0
  fi
}


###################################################
#
# versions
#
# This function reports the version of the main script
# passed in through the first argument.  It also reports
# the version from the resource file, the library file
# that will be used and it's version.
#
versions()
{
  #main version in from the argument
  local MAIN_VERS=${1}

  #output the versions
  lnout 0 0 ${LOG_FILE} "Versions:"
  lnout 1 0 ${LOG_FILE} ""
  lnout 1 0 ${LOG_FILE} "Main Script: ${MAIN_VERS}"
  lnout 1 0 ${LOG_FILE} "Library File Used: gpcheckos-`uname`.lib"
  lnout 1 0 ${LOG_FILE} "Library Version: ${LIB_VERS}"
  lnout 1 0 ${LOG_FILE} "Res file version: `cat ${TEMP_DIR}/${RES_VERS_FI}`"
  exit 0
}

###################################################
#
# parse_res
#
# This function reads the resource file and breaks it into the 
# temporary files used as the basis for evaluating standards
#
parse_res()
{
  local BEGIN=1
  local END=1
  local FST_CHAR=""
  local CURR_TEMP_FI=""

  #open the resource file an dread it line by line
  cat ${CONFIG_DIR}/${RES_FILE_NM} | while read LN; do

    #find the current line's first character
    FST_CHAR=`echo ${LN} | cut -c1`
 
    #if the current line starts with a :, determine if this is the
    #beginning or end of a section
    if [ "X${FST_CHAR}" = "X:" ]; then

      #if the begin and end flags are the same, it's the beginning
      #of a section
      if [ ${BEGIN} -eq ${END} ]; then
        #Parse the temp file name related to the section
        CURR_TEMP_FI=`echo ${LN} | cut -d':' -f2 | cut -d' ' -f1`

        #set the begin flag
        BEGIN=0

        #if the file is already present, remove it
        if [ -f ${TEMP_DIR}/${CURR_TEMP_FI} ]; then
          rm ${TEMP_DIR}/${CURR_TEMP_FI}
        fi
        
      #if a line starting with a : is found and the begin and end flags
      #are different, it is the end of a section
      else

        #set the begin and end flags to the same value
        BEGIN=1
        END=1
      fi

    #if the line does not begin with a :, determine if it should be added to 
    #a temp file
    else
      #if the begin and end flags are not the same, add the line to the
      #current temp file
      if [ ! ${BEGIN} -eq ${END} ]; then
        lnout 1 1 ${TEMP_DIR}/${CURR_TEMP_FI} ${LN}
      fi 
    fi
  done

  #Use the temp file for the current release and current kernel to fill their
  #variables
  CURR_RELEASE=`cat ${TEMP_DIR}/${CURR_RELEASE_FI}`
  CURR_KERNEL=`cat ${TEMP_DIR}/${CURR_KERNEL_FI}`
  
  #strips traling and leading spaces
  CURR_KERNEL=`echo ${CURR_KERNEL# } | sed 's/[ \t]*$//'`
  
}

###################################################
#
# summary
#
# This function produces the summary report shown both on screen and 
# in the log file.  Not everything placed in the log is 
# put on screen
#
summary()
{
  #these variables are used in this function for various things.
  local CURR_SRVR_FI=CURR_SERVER
  local PRTPICL_FI=PRTPICL_OUTPUT
  local DIMM_INFO_FI=DIMM_INFO
  local DISK_INFO_FI=DISK_INFO
  local LUSTATUS_FI=LUSTATUS
  local BOOT_DSK_FI=BOOT_DSK
  local METASTAT_FI=METASTAT
  local METADB_FI=METADB
  local ZPOOL_FI=ZPOOLS
  local ZFS_FI=ZFS_MOUNTS
  local HD_DC_FI=HD_DC
  local HD_R_FI=HD_R
  local LN_ARR=""
  local NUM_FLDS=""
  local NEW_LN=""
  local B=""
  local D=""
  local F=""
  local I=""
  local L=""
  local M=""
  local N=""
  local R=""
  local S=""
  local CURR_FLD=""

  #+++++++++++++++++++++++++++++++++++++++++++
  #gather data

  #Current server model

  #find the FRU number for the chassis
  i=0
  F=1
  while [ ${F} -eq 1 ]; do
    ipmitool fru print ${i} > ${TEMP_DIR}/${CURR_SRVR_FI} 2>/dev/null

    #we've looked at 100 frus.  Give up already
    if [ ${i} -gt 100 ]; then
      F=2
    else
      
      #Look for the rack mount chassis in the output
      grep "Rack Mount Chassis" ${TEMP_DIR}/${CURR_SRVR_FI} >/dev/null 2>&1
      rval=${?}
  
      #if the rack mount chassis is in the output then stop looking
      if [ ${rval} -eq 0 ]; then
        F=0
      #otherwise increment the search
      else
        i=`expr ${i} + 1`
      fi
    fi
  done
    
  #if the fru was found, get the info
  if [ ${F} -eq 0 ]; then
    #get the server product name
    SERVER_FND=`grep "Product Name" ${TEMP_DIR}/${CURR_SRVR_FI} | cut -d':' -f2`

    #trim leading and trailing space
    SERVER_FND=`echo ${SERVER_FND# } | sed 's/[ \t]*$//'`

    #get the serial number used to place service calls
    SERIAL_FND=`grep "Product Serial" ${TEMP_DIR}/${CURR_SRVR_FI} | cut -d':' -f2`

    #trim leading and trailing space
    SERIAL_FND=`echo ${SERIAL_FND# } | sed 's/[ \t]*$//'`
  
  #otherwise, set these to unknown
  else
    SERVER_FND="UNKNOWN"
    SERIAL_FND="UNKNOWN"
  fi

  #uname information where the kernel data will be found
  UNAME_FND=`uname -a`

  #mpstat shows one line (plus headings) for each usable processor, core,
  #or CMT thread
  NUM_PROCS=`mpstat | grep -v CPU | wc -l`

  #get the current release information
  cat `cat ${TEMP_DIR}/RELEASE_FI` | while read LN; do
    lnout 2 1 ${TEMP_DIR}/${RELEASE_FND_FI} "${LN}"
  done

  #get the detailed processor data into the log file
  #prtpicl is a command that read through the picl (platform independant 
  #configuration layer) tree and returns info about various config elements
  lnout 0 2 ${TEMP_DIR}/${PRTPICL_FI} ""
  prtpicl -v -c cpu 2>&1 | grep brand-string | cut -d':' -f2- | cut -d' ' -f2- | while read LN; do
    lnout 3 1 ${TEMP_DIR}/${PRTPICL_FI} "${LN}"
  done

  #prtconf output includes the working memory size in MB
  RAM_SIZ_FND=`prtconf 2>&1 | grep Memory | awk '{print $3}'` 

  #Get detailed DIMM information into the log
  lnout 0 2 ${TEMP_DIR}/${DIMM_INFO_FI} ""
  prtdiag 2>&1 | grep DIMM | while read LN; do
    lnout 3 1 ${TEMP_DIR}/${DIMM_INFO_FI} "${LN}"
  done

  #the cfgadm command selects disks and shows no headings.  It will list 
  #one line for each disk.  Note, cfgadm does not work in virtual environments
  DSK_CNT_FND=`cfgadm -a -s "select=type(disk),noheadings" 2>/dev/null | wc -l`

  #put the detailed disk information into the log file
  lnout 0 2 ${TEMP_DIR}/${DISK_INFO_FI} ""
  cfgadm -a -s "select=type(disk),cols=ap_id:info" 2>&1 | sed s-"          "-""-g | while read LN; do
    lnout 3 1 ${TEMP_DIR}/${DISK_INFO_FI} "${LN}"
  done

  #this hd command lists the disks and provides some diagnostic info.
  lnout 0 2 ${TEMP_DIR}/${HD_DC_FI}
  hd -dc 2>&1 | while read LN; do
    lnout 3 1 ${TEMP_DIR}/${HD_DC_FI} "${LN}"
  done

  #this hd command lists SMART data for the disks
  lnout 0 2 ${TEMP_DIR}/${HD_R_FI}
  hd -R 2>&1 | while read LN; do
    lnout 3 1 ${TEMP_DIR}/${HD_R_FI} "${LN}"
  done

  #the first field in the first line in swap -l is the primary swap device
  SWAP_DEV_FND=`swap -l | grep -v swapfile | head -1 | awk '{print $1}'`

  #the fourth field in the first line in swap -l is the primary swap size
  #in blocks
  SWAP_SIZ_FND=`swap -l | grep -v swapfile | head -1 | awk '{print $4}'`
  #convert the blocks to bytes
  SWAP_SIZ_FND=`echo ${SWAP_SIZ_FND}\*512 | bc`
  #convert the bytes to GB
  SWAP_SIZ_FND=`echo ${SWAP_SIZ_FND}/1024^3 | bc`

  #the 3rd field in the line containing device of the dumpadm output is the 
  #dump device
  DMP_DEV_FND=`dumpadm | grep device | awk '{print $3}'`
  #the 3rd field using 's' as a delimiiter in the dump device is the 
  #slice number
  local DMP_SLC=`echo ${DMP_DEV_FND} | cut -d's' -f3`
  #get the character device name
  local DMP_RDEV_FND=`echo ${DMP_DEV_FND} | sed s-dsk-rdsk-`
  #the devinfo command provides the size in blocks of the slice in the 
  #5th field.  Command requires the character device
  DMP_SIZ_FND=`devinfo -p ${DMP_RDEV_FND} | awk '{print $5}'`
  #convert blocks to bytes
  DMP_SIZ_FND=`echo ${DMP_SIZ_FND}\*512 | bc`
  #convert bytes to GB
  DMP_SIZ_FND=`echo ${DMP_SIZ_FND}/1024^3 | bc`

  #log header
  date +%d-%B-%Y.%H:%M:%S > ${LOG_FILE}
  lnout 0 0 ${LOG_FILE} "Starting logging..." 
  lnout 0 1 ${LOG_FILE} ""
  lnout 0 1 ${LOG_FILE} ""
  lnout 0 1 ${LOG_FILE} "Start gpcheckos log, run ${RUN_NM}, iteration ${ITER}"
  lnout 0 1 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "Summary:" 
  lnout 0 0 ${LOG_FILE} ""

  #determine live upgrade status
  lustatus >/dev/null 2>&1
  LUSTATUS_FND=${?}

  #check to see if SVM is configured
  metadb >/dev/null 2>&1
  SVM_PRESENT=${?}
  if [ ${SVM_PRESENT} -eq 0 ]; then
    #get the list of boot devices based on the disks under SVM control.  This
    #assumes a lot and a better check to determine what is booted and what
    #the available alternatives are should be found
    lnout 0 2 ${TEMP_DIR}/${BOOT_DSK_FI} ""
    metastat 2>/dev/null | tail -2 | awk '{print $1}' | while read LN; do
      lnout 3 1 ${TEMP_DIR}/${BOOT_DSK_FI} "${LN}"

      #Store the vtoc for future use
      prtvtoc /dev/rdsk/${LN}s2 | sed 's-\*--' 2>/dev/null | while read LN2; do
        lnout 4 1 ${TEMP_DIR}/${LN} "${LN2}"
      done
    done

    

    #get the state database info
    printf "%25s\t%7s\t%7s    %-13s\n" "flags " "1st block" "block cnt" "device" > ${TEMP_DIR}/${METADB_FI}
    metadb 2>/dev/null | tail +2 | while read LN; do
      #converts the line to an array
      LN_ARR=( `echo ${LN}` )
      #gets the number of fields in the line
      NUM_FLDS=${#LN_ARR[*]}
  
      #sets the current field to the last node in the array.  The array is 
      #0 indexed 
      CURR_FLD=`echo ${NUM_FLDS} - 1 | bc`
      #get the device name
      D=${LN_ARR[${CURR_FLD}]}
  
      #change the current field
      CURR_FLD=`echo ${CURR_FLD} - 1 | bc`
      #get the num blocks in the db
      B=${LN_ARR[${CURR_FLD}]}
  
      #change the current field
      CURR_FLD=`echo ${CURR_FLD} - 1 | bc`
      #get the first block
      F=${LN_ARR[${CURR_FLD}]}

      #parse the metadb flags
      M=""
      while [ ${CURR_FLD} -gt 0 ]; do
        CURR_FLD=`echo ${CURR_FLD} - 1 | bc`
        M=${LN_ARR[${CURR_FLD}]}" "${M}
      done

      #print the line to the temp file
      printf "%26s\t%8s\t%8s    %-13s\n" "${M} " ${F} ${B} ${D} >>${TEMP_DIR}/${METADB_FI}
    done

    #get the SVM object info
    lnout 0 2 ${TEMP_DIR}/${METASTAT_FI} ""
    metastat -c 2>/dev/null | while read LN; do
      LN_ARR=( `echo ${LN}` )
      NUM_FLDS=${#LN_ARR[*]}

      N=${LN_ARR[0]}
      M=${LN_ARR[1]}

      #if the line is the mirror device, get that line
      if [ "X${M}" = "Xm" ]; then
        #get the right-side device
        CURR_FLD=`echo ${NUM_FLDS} - 1 | bc`
        R=${LN_ARR[${CURR_FLD}]}
  
        #get the left-side device
        CURR_FLD=`echo ${CURR_FLD} - 1 | bc`
        L=${LN_ARR[${CURR_FLD}]}

        #get the size
        CURR_FLD=`echo ${CURR_FLD} - 1 | bc`
        B=${LN_ARR[${CURR_FLD}]}

        #echo the line
        printf "%19s\t%3s\t%6s\t%6s\t%6s\n" ${N} ${M} ${B} ${L} ${R} >> ${TEMP_DIR}/${METASTAT_FI}
      else
        #get the device
        CURR_FLD=`echo ${NUM_FLDS} - 1 | bc`
        D=${LN_ARR[${CURR_FLD}]}
  
        #get the size
        CURR_FLD=`echo ${CURR_FLD} - 1 | bc`
        B=${LN_ARR[${CURR_FLD}]}

        #echo the line
        printf "%24s\t%3s\t%6s\t%6s\n" ${N} ${M} ${B} ${D} >> ${TEMP_DIR}/${METASTAT_FI}
      fi
    done
  else
    B=`df / | cut -d'/' -f5 | cut -d')' -f1`
    lnout 3 1 ${TEMP_DIR}/${BOOT_DSK_FI} ${B}

    #Store the vtoc for future use
    
    prtvtoc /dev/rdsk/${B} | sed 's-\*--' | while read LN2; do
      lnout 4 1 ${TEMP_DIR}/${B} "${LN2}"
    done

    lnout 3 1 ${TEMP_DIR}/${METADB_FI} "No boot mirroring configured"
    lnout 3 1 ${TEMP_DIR}/${METASTAT_FI} "No boot mirrors configured"
  fi

  #determine if pools are present
  zpool status `zpool list | grep -v NAME | awk '{print $1}'` > /dev/null 2>&1
  POOLS_PRESENT_FND=${?}

  if [ ${POOLS_PRESENT_FND} -eq 0 ]; then
    zpool list | tail +2 | while read LN; do
      lnout 3 1 ${TEMP_DIR}/${ZPOOL_FI} "${LN}"
    done

    zfs list | tail +2 | while read LN; do
      lnout 3 1 ${TEMP_DIR}/${ZFS_FI} "${LN}" 
    done
  else
    lnout 3 2 ${TEMP_DIR}/${ZPOOL_FI} "no ZPools configured."
    lnout 3 2 ${TEMP_DIR}/${ZFS_FI} "no ZPools configured." 
  fi


  #put the lustatus info to a log file
  lnout 0 2 ${TEMP_DIR}/${LUSTATUS_FI} ""
  lustatus 2>&1 |  while read LN; do
    lnout 3 1 ${TEMP_DIR}/${LUSTATUS_FI} "${LN}" 
  done

  #get network tunable info
  #these settings are required for Greenplum
  REQ_MAX_Q_FND=`ndd -get /dev/tcp tcp_conn_req_max_q`
  REQ_MAX_Q0_FND=`ndd -get /dev/tcp tcp_conn_req_max_q0`
  LG_ANON_P_FND=`ndd -get /dev/tcp tcp_largest_anon_port`
  SM_ANON_P_FND=`ndd -get /dev/tcp tcp_smallest_anon_port`
  TIME_WAIT_FND=`ndd -get /dev/tcp tcp_time_wait_interval`

  #parse ifconfig
  NEW_LN=1
  ifconfig -a | while read LN; do
    LN_ARR=( `echo ${LN}` )
    
    if [ "X${LN_ARR[0]}" = "Xinet" ]; then
      NEW_LN=1
      I=${LN_ARR[1]}
      N=${LN_ARR[3]}
    elif [ "X${LN_ARR[0]}" = "Xether" ]; then
      NEW_LN=0
    else
      NEW_LN=1
      M=`echo ${LN_ARR[0]} | cut -d':' -f1`
      F=`echo ${LN_ARR[1]} | cut -d'<' -f2 | cut -d'>' -f1`
      R=${LN_ARR[3]}
    fi

    if [ ${NEW_LN} -eq 0 ]; then
      printf "%19s%16s%9s%36s\n" ${M} ${I} ${N} ${F} >> ${TEMP_DIR}/${IFCONFIG_FI}
      FLG=1
    fi
  done

  #get autonegotiation information
  for i in `cat ${TEMP_DIR}/${IFCONFIG_FI} | awk '{print $1}'`; do
    L=`dladm show-dev ${i}`
    S=`echo ${L} | awk '{print $5}'`
    D=`echo ${L} | awk '{print $8}'`
    LN=`printf "%s\tSpeed:%s\tDuplex:%s\n" "${i}" "${S}" "${D}"`
    lnout 3 1 ${TEMP_DIR}/${AUTONEG_FI} ${LN}
  done

  #get service states
  for i in `cat ${TEMP_DIR}/${SVCS_2_DISABLE_FI}`; do
    S=`svcs ${i} | grep -v STATE | awk '{print $1}'`
    lnout 2 1 ${TEMP_DIR}/${SVCS_FND_FI} "`printf \"%s\t%s\n\" ${S} ${i}`"
  done

  #server type
  lnout 1 0 ${LOG_FILE} "Res file version: `cat ${TEMP_DIR}/${RES_VERS_FI}`"
  lnout 0 0 ${LOG_FILE} ""
  lnout 1 0 ${LOG_FILE} "Server: ${SERVER_FND}" 
  lnout 1 0 ${LOG_FILE} "Serial: ${SERIAL_FND}" 

  #Kernel and uname information
  lnout 1 0 ${LOG_FILE} "Uname: ${UNAME_FND}" 
  lnout 1 0 ${LOG_FILE} "OS Release Info:"
  cat ${TEMP_DIR}/${RELEASE_FND_FI} >> ${LOG_FILE}
  lnout 0 0 ${LOG_FILE} ""
  lnout 1 0 ${LOG_FILE} "Capturing fmd log to ${LOG_DIR}/FMD_LOG"
  fmdump -v > ${LOG_DIR}/FMD_LOG
  lnout 1 0 ${LOG_FILE} "Capturing fmd faulty to ${LOG_DIR}/FMADM_LOG"
  fmadm faulty -a > ${LOG_DIR}/FMADM_LOG
  lnout 1 0 ${LOG_FILE} "Capturing prtdiag to ${LOG_DIR}/PRTDIAG_LOG"
  prtdiag -v > ${LOG_DIR}/PRTDIAG_LOG
  lnout 1 0 ${LOG_FILE} "Capturing prtconf to ${LOG_DIR}/PRTCONF_LOG"
  prtconf -v > ${LOG_DIR}/PRTCONF_LOG
  lnout 1 0 ${LOG_FILE} "Capturing ipmitool to ${LOG_DIR}/IPMITOOL_LOG"
  ipmitool sel elist > ${LOG_DIR}/IPMITOOL_LOG
  lnout 1 0 ${LOG_FILE} "Capturing messages files to ${LOG_DIR}"
  cp /var/adm/messages* ${LOG_DIR}

  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%" 
  lnout 0 0 ${LOG_FILE} ""

  #Processor information
  lnout 1 0 ${LOG_FILE} "Processor Info:" 
  lnout 2 0 ${LOG_FILE} "Number of processors/cores: ${NUM_PROCS}" 
  lnout 2 1 ${LOG_FILE} "Processor Type:" 
  cat ${TEMP_DIR}/${PRTPICL_FI} >> ${LOG_FILE}
  lnout 0 0 ${LOG_FILE} ""

  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
  lnout 0 0 ${LOG_FILE} ""

  #Memory information
  lnout 1 0 ${LOG_FILE} "Memory Info:" 
  lnout 2 0 ${LOG_FILE} "Memory Recognized in MB: ${RAM_SIZ_FND}" 
  lnout 2 1 ${LOG_FILE} "Detailed Memory Information:" 
  cat ${TEMP_DIR}/${DIMM_INFO_FI} >> ${LOG_FILE}

  #Swap information
  lnout 2 0 ${LOG_FILE} "Primary swap device: ${SWAP_DEV_FND}" 
  lnout 2 1 ${LOG_FILE} "Primary swap size in GB: ${SWAP_SIZ_FND}" 

  #Dump device information
  lnout 2 0 ${LOG_FILE} "Dump device: ${DMP_DEV_FND}" 
  lnout 2 1 ${LOG_FILE} "Dump device size in GB: ${DMP_SIZ_FND}" 

  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
  lnout 0 0 ${LOG_FILE} ""

  #Disk information
  lnout 1 0 ${LOG_FILE} "Disk Info:" 
  lnout 2 0 ${LOG_FILE} "Number of disk devices detected: ${DSK_CNT_FND}" 
  lnout 2 1 ${LOG_FILE} "Disk Map: "
  cat ${TEMP_DIR}/${DISK_INFO_FI} >> ${LOG_FILE}

  lnout 0 0 ${LOG_FILE} ""
  lnout 2 1 ${LOG_FILE} "Disk Information:"
  cat ${TEMP_DIR}/${HD_DC_FI} >> ${LOG_FILE}

  lnout 0 0 ${LOG_FILE} ""
  lnout 2 1 ${LOG_FILE} "SMART Data:"
  cat ${TEMP_DIR}/${HD_R_FI} >> ${LOG_FILE} 

  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
  lnout 0 0 ${LOG_FILE} ""


  #Patch information
  #patches are handled differently than the other options.  To facilitate
  #checking the installed patch list with the supported list, a temp file
  #is built.
  
  #initialize the temp file
  lnout 0 2 ${TEMP_DIR}/${PATCHES_FND_FI} ""
  lnout 1 0 ${LOG_FILE} "Patches installed since OS installation:" 
  for pdir in `showrev -p | cut -d':' -f2 | awk '{print $1}'`; do
    if [ -s /var/sadm/patch/${pdir} ]; then
      lnout 2 0 ${LOG_FILE} "${pdir}" 
      lnout 0 1 ${TEMP_DIR}/${PATCHES_FND_FI} ${pdir} 
    fi
  done

  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
  lnout 0 0 ${LOG_FILE} ""

  #Live Upgrade Information
  lnout 1 0 ${LOG_FILE} "Live Updgrade" 
  lnout 2 0 ${LOG_FILE} "Live Upgrade status:" 
  if [ "X${QUIET_MODE}" == "Xfalse" ]; then
    cat ${TEMP_DIR}/${LUSTATUS_FI} | tee -a ${LOG_FILE}
  else
    cat ${TEMP_DIR}/${LUSTATUS_FI} >> ${LOG_FILE}
  fi

  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
  lnout 0 0 ${LOG_FILE} ""

  #Solaris Volume Manager Information
  lnout 1 0 ${LOG_FILE} "SVM Information" 
  lnout 2 0 ${LOG_FILE} "Boot Disks:" 
  if [ "X${QUIET_MODE}" == "Xfalse" ]; then
    cat ${TEMP_DIR}/${BOOT_DSK_FI} | tee -a ${LOG_FILE}
  else
    cat ${TEMP_DIR}/${BOOT_DSK_FI} >> ${LOG_FILE}
  fi

  #put the prtvtocs into the log file
  for i in `cat ${TEMP_DIR}/${BOOT_DSK_FI}`; do
    cat ${TEMP_DIR}/${i# } >> ${LOG_FILE}
    lnout 0 0 ${LOG_FILE} ""
  done

  lnout 0 1 ${LOG_FILE} ""
  lnout 2 1 ${LOG_FILE} "State Database Information:" 
  cat ${TEMP_DIR}/${METADB_FI} >> ${LOG_FILE}
  lnout 0 1 ${LOG_FILE} ""
  lnout 2 1 ${LOG_FILE} "Metadevice Information:" 
  cat ${TEMP_DIR}/${METASTAT_FI} >> ${LOG_FILE}

  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
  lnout 0 0 ${LOG_FILE} ""

  #ZFS Information
  lnout 1 0 ${LOG_FILE} "ZFS Information:" 
  lnout 2 0 ${LOG_FILE} "Zpools:" 
  if [ "X${QUIET_MODE}" == "Xfalse" ]; then
    cat ${TEMP_DIR}/${ZPOOL_FI} | tee -a ${LOG_FILE}
  else
    cat ${TEMP_DIR}/${ZPOOL_FI} >> ${LOG_FILE}
  fi
  lnout 0 0 ${LOG_FILE} ""
  lnout 2 0 ${LOG_FILE} "ZFS Mounts:" 
  if [ "X${QUIET_MODE}" == "Xfalse" ]; then
    cat ${TEMP_DIR}/${ZFS_FI} | tee -a ${LOG_FILE}
  else
    cat ${TEMP_DIR}/${ZFS_FI} >> ${LOG_FILE}
  fi
  lnout 0 0 ${LOG_FILE} ""
  lnout 1 0 ${LOG_FILE} "Capturing full zpool status to ${LOG_DIR}/${ZPOOL_FI}"
  zpool status -v > ${LOG_DIR}/${ZPOOL_FI}

  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
  lnout 0 0 ${LOG_FILE} ""
  
  #Network information
  lnout 1 0 ${LOG_FILE} "Network Configuration Info:" 
  lnout 2 0 ${LOG_FILE} "TCP tunables:" 
  lnout 3 0 ${LOG_FILE} "tcp_conn_req_max_q: ${REQ_MAX_Q_FND}" 
  lnout 3 0 ${LOG_FILE} "tcp_conn_req_max_q0: ${REQ_MAX_Q0_FND}" 
  lnout 3 0 ${LOG_FILE} "tcp_largest_anon_port: ${LG_ANON_P_FND}" 
  lnout 3 0 ${LOG_FILE} "tcp_smallest_anon_port: ${SM_ANON_P_FND}" 
  lnout 3 0 ${LOG_FILE} "tcp_time_wait_interval: ${TIME_WAIT_FND}" 
  lnout 0 0 ${LOG_FILE} ""

  lnout 2 0 ${LOG_FILE} "Capturing Host file to ${LOG_DIR}..." 
  cp /etc/hosts ${LOG_DIR}

  lnout 2 0 ${LOG_FILE} "Capturing Hostname files to ${LOG_DIR}..." 
  cp /etc/hostname.* ${LOG_DIR}

  lnout 2 0 ${LOG_FILE} "Capturing Networks file to ${LOG_DIR}..." 
  cp /etc/networks ${LOG_DIR}

  lnout 2 0 ${LOG_FILE} "Capturing Netmasks file to ${LOG_DIR}" 
  cp /etc/netmasks ${LOG_DIR}

  lnout 2 0 ${LOG_FILE} "Capturing Nodename file to ${LOG_DIR}" 
  cp /etc/nodename ${LOG_DIR}

  lnout 2 0 ${LOG_FILE} "Capturing Defaultrouter file to ${LOG_DIR}" 
  cp /etc/defaultrouter ${LOG_DIR}
  lnout 0 0 ${LOG_FILE} ""

  lnout 2 0 ${LOG_FILE} "Active NICs" 
  if [ "X${QUIET_MODE}" == "Xfalse" ]; then
    cat ${TEMP_DIR}/${IFCONFIG_FI} | tee -a ${LOG_FILE}
  else
    cat ${TEMP_DIR}/${IFCONFIG_FI} >> ${LOG_FILE}
  fi
  lnout 0 0 ${LOG_FILE} ""

  lnout 2 1 ${LOG_FILE} "NIC Autonegotiation Status:"
  cat ${TEMP_DIR}/${AUTONEG_FI} >> ${LOG_FILE}

  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
  lnout 0 0 ${LOG_FILE} ""
  
  lnout 1 0 ${LOG_FILE} "Services info" 
  if [ "X${QUIET_MODE}" == "Xfalse" ]; then
    cat ${TEMP_DIR}/${SVCS_FND_FI} | tee -a ${LOG_FILE}
  else
    cat ${TEMP_DIR}/${SVCS_FND_FI} >> ${LOG_FILE}
  fi

  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "Summary complete" 
  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
  lnout 0 0 ${LOG_FILE} ""
  
}

patches_tests()
{
  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
  lnout 0 0 ${LOG_FILE} "Patch Report:"
  lnout 0 0 ${LOG_FILE} "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"

  #check the found patches for standards compliance
  for ptch in `cat ${TEMP_DIR}/${PATCHES_FND_FI}`; do

    #parse the base patch number
    PTCH_FND=`echo ${ptch} | cut -d'-' -f1`

    #parse the patch version
    VERS_FND=`echo ${ptch} | cut -d'-' -f2`

    #check to see if the exact patch found is supported
    PTCH_SUPP=`grep ${ptch} ${TEMP_DIR}/${PATCHES_CUR_FI}`
    rval=${?}
    PTCH_SUPP=${PTCH_SUPP# }

    #if the exact found patch is found in the supported list, 
    #say so and move on
    if [ ${rval} -eq 0 ]; then
      lnout 2 0 ${LOG_FILE} "${ptch} is currently supported" 

    #otherwise, figure out if it is replaced or unsupported
    else
      #check to see if the patch has been replaced.  Ignore the found patch's
      #version
      PTCH_SUPP=`grep ${PTCH_FND} ${TEMP_DIR}/${PATCHES_OLD_FI}`
      rval=${?}
      PTCH_SUPP=${PTCH_SUPP# }

      #if the patch has been replaced, say so and by what
      if [ ${rval} -eq 0 ]; then
        NEW_PTCH=`echo ${PTCH_SUPP} | cut -d'.' -f2`

        #check to see if the new patch is already installed
        grep ${NEW_PTCH} ${TEMP_DIR}/${PATCHES_FND_FI} > /dev/null 2>&1
        rval=${?}

        #if the new patch is not present, say this patch is obsolete and how
        if [ ! ${rval} -eq 0 ]; then
          lnout 2 0 ${LOG_FILE} "${ptch} is obsolete.  ${NEW_PTCH} is now supported." 
        fi

      #otherwise, look at the version
      else

        PTCH_SUPP=`grep ${PTCH_FND} ${TEMP_DIR}/${PATCHES_CUR_FI}`
        rval=${?}
        PTCH_SUPP=${PTCH_SUPP# }

        #if the base patch is supported, determine if the one installed is
        #newer or older than that supported
        if [ ${rval} -eq 0 ]; then
          #get the supported patch's version
          PTCH_SUPP_VER=`echo ${PTCH_SUPP} | cut -d'-' -f2`

          #if the supported patch is newer than the installed, say so
          if [ ${VERS_FND} -lt ${PTCH_SUPP_VER} ]; then
            lnout 2 0 ${LOG_FILE} "${ptch} is obsolete.  ${PTCH_SUPP} is supported." 
      
          #if the installed patch is newer than the supported, comment on that
          else
            lnout 2 0 ${LOG_FILE} "${ptch} appears to be newer then supported ${PTCH_SUPP}" 
          fi

        #If we get here, the found patch is not supported
        else
          lnout 2 0 ${LOG_FILE} "${ptch} appears not to be a patch Greenplum has tested." 
        fi

      fi
      
    fi

  done

  #check for supported patches not in the found list
  lnout 1 0 ${LOG_FILE} "Supported patches not installed:"

  for ptch in `cat ${TEMP_DIR}/${PATCHES_CUR_FI}`; do
    grep ^${ptch} ${TEMP_DIR}/${PATCHES_FND_FI} >/dev/null 2>&1
    rval=${?}

    if [ ! ${rval} -eq 0 ]; then
      lnout 2 0 ${LOG_FILE} "${ptch} is not installed and available."
    fi
  done

  lnout 1 0 ${LOG_FILE} "NOTE: Consult Greenplum before applying patches."
  lnout 1 0 ${LOG_FILE} "      Additional effort may be required than"
  lnout 1 0 ${LOG_FILE} "      simply applying patches."

     
  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
  lnout 0 0 ${LOG_FILE} ""
}

os_tests()
{
  local D=""
  local M=""
  local N=""
  local P=""
  local S=""
  local NIC_CNT=""

  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
  lnout 0 0 ${LOG_FILE} "OS Configuration Report:" 
  lnout 0 0 ${LOG_FILE} "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
  lnout 0 0 ${LOG_FILE} ""

  ###############################
  #evaluate the server

  #determine if this is a supported server
  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "Server Results"

  #Get the matching supported server info
  supp_srvr=`grep -i "${SERVER_FND}" ${TEMP_DIR}/${SUPP_SERVERS_FI}`
  rval=${?}

  #if a supported server is found, evaluate it
  if [ ${rval} -eq 0 ]; then
    #number of processors expected
    P=`echo ${supp_srvr} | cut -d':' -f2`
    
    #Memory in MB expected
    M=`echo ${supp_srvr} | cut -d':' -f3`

    #Number of disks expected
    D=`echo ${supp_srvr} | cut -d':' -f4`

    #This is the number of NICs expected to be active for this server
    #it is used later in the function.
    N=`echo ${supp_srvr} | cut -d':' -f5`
    
    lnout 0 0 ${LOG_FILE} ""
    lnout 1 0 ${LOG_FILE} "Server (${SERVER_FND}) is supported"

    #if the number of processors found is at least the num expected, say so
    if [ ${NUM_PROCS} -ge ${P} ]; then
      lnout 2 0 ${LOG_FILE} "Found at least ${P} processors"
    #otherwise warn that it is short
    else
      lnout 2 0 ${LOG_FILE} "WARNING: expected ${P} processors, found ${NUM_PROCS}"
    fi

    #if the amount of memory is at least what was expected, say so
    if [ ${RAM_SIZ_FND} -ge ${M} ]; then
      lnout 2 0 ${LOG_FILE} "Found at least ${M}MB memory"
    #otherwise warn that it is short
    else
      lnout 2 0 ${LOG_FILE} "WARNING: expected ${M}MB memory, found ${RAM_SIZ_FND}"
    fi

    #if the number of disks is at least what was expected, say so
    if [ ${DSK_CNT_FND} -ge ${D} ]; then
      lnout 2 0 ${LOG_FILE} "Found at least ${D} disks"
    #otherwise warn that it is short
    else
      lnout 2 0 ${LOG_FILE} "WARNING: expected ${D} disks, found ${DSK_CNT_FND}"
    fi

  #if the server is not found in the supported list, say so
  else
    lnout 1 0 ${LOG_FILE} "WARNING: The server found (${SERVER_FND}) does not"
    lnout 1 0 ${LOG_FILE} "         appear to be a standard." 
  fi

  ###############################
  #evaluate the kernel

  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "Kernel Results"

  #parse the kernel patch rev out of the uname output
  KERNEL_FND=`echo ${UNAME_FND} | awk '{print $4}' | cut -d'_' -f2`

  #if the kernel found is the same as the current kernel, say so
  if [ "X${KERNEL_FND}" = "X${CURR_KERNEL}" ]; then
    lnout 1 0 ${LOG_FILE} "The kernel (${KERNEL_FND}) is up to date."

  #otherwise, look to see if the current kernel is in the list of previously
  #supported kernels
  else
    grep ${KERNEL_FND} ${TEMP_DIR}/${KERNELS_FI} > /dev/null 2>&1
    rval=${?}
    
    #if the current kernel is found in the past kernels, say so
    if [ ${rval} -eq 0 ]; then
      lnout 1 0 ${LOG_FILE} "The installed kernel (${KERNEL_FND}) can be upgraded to ${CURR_KERNEL}"

    #if the kernel installed cannot be found in the list, complain
    else 
      lnout 1 0 ${LOG_FILE} "The installed kernel (${KERNEL_FND}), does not appear to be supported." 
    fi
  fi

  ###############################
  #evaluate swap size

  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "Swap Results"

  #compare the swap space to the memory size
  SWAP_SIZ_FND_MB=`echo ${SWAP_SIZ_FND}\*1024 | bc`
  if [ ${SWAP_SIZ_FND_MB} -ge ${RAM_SIZ_FND} ]; then
    lnout 1 0 ${LOG_FILE} "Primary swap is greather than or equal to physical RAM." 
  else
    lnout 1 0 ${LOG_FILE} "Primary swap is NOT equal to physical RAM." 
  fi
  
  ###############################
  #evaluate dump size

  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "Dump Device Results"

  #compare the dump space to the memory size
  DMP_SIZ_FND_MB=`echo ${DMP_SIZ_FND}\*1024 | bc`
  if [ ${DMP_SIZ_FND_MB} -ge ${RAM_SIZ_FND} ]; then
    lnout 1 0 ${LOG_FILE} "Dump space is greater than or equal to physical RAM." 
  else
    lnout 1 0 ${LOG_FILE} "Dump space is NOT equal to physical RAM." 
  fi
  
  #compare swap and dump devices
  if [ "X${DMP_DEV_FND}" = "X${SWAP_DEV_FND}" ]; then
    lnout 1 0 ${LOG_FILE} "Dump is NOT a dedicated device"
  else
    lnout 1 0 ${LOG_FILE} "Dump is a dedicated device"
  fi

  ###############################
  #SVM evaluation
 
  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "SVM and Boot Disk Evaluation"

  #if SVM is configured, check it against the standards
  if [ ${SVM_PRESENT} -eq 0 ]; then
    lnout 1 0 ${LOG_FILE} "SVM is configured.  This does not mean it is"
    lnout 1 0 ${LOG_FILE} "   correct.  Please review the SVM information"
    lnout 1 0 ${LOG_FILE} "   in the summary."
  
  #Otherwise complain
  else
    lnout 1 0 ${LOG_FILE} "SVM is not configured.  This means the boot"
    lnout 1 0 ${LOG_FILE} "  disk is not mirrored."
  fi

  ###############################
  #ZFS evaluation
 
  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "ZFS Evaluation"

  #if ZFS is configured, check it against the standards
  if [ ${POOLS_PRESENT_FND} -eq 0 ]; then
    lnout 1 0 ${LOG_FILE} "ZFS is configured.  This does not mean it is"
    lnout 1 0 ${LOG_FILE} "   correct.  Please review the ZFS information"
    lnout 1 0 ${LOG_FILE} "   in the summary."
  
  #Otherwise complain
  else
    lnout 1 0 ${LOG_FILE} "ZFS is not configured.  This means the data"
    lnout 1 0 ${LOG_FILE} "  disks are not configured and GP cannot be"
    lnout 1 0 ${LOG_FILE} "  set up properly."
  fi

  ###############################
  #NIC evaluation

  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "NIC Evaluation"

  #find out how many NICs were plumbed
  NIC_CNT=`cat ${TEMP_DIR}/${IFCONFIG_FI} | wc -l`

  #if N is not filled, assume the server is non-standard and beg off
  #the count
  if [ "X${N}" = "X" ]; then
    lnout 1 0 ${LOG_FILE} "WARNING: Cannot determine how many NICs to expect for server ${SERVER_FND}"

  #if at least the number of active NICs expected was found, say so
  elif [ ${NIC_CNT} -ge ${N} ]; then
    lnout 1 0 ${LOG_FILE} "Found at least the number of active NICs expected."

  #otherwise warn that it is short
  else
    lnout 1 0 ${LOG_FILE} "WARNING: Expected at least ${N} NICS, found ${NIC_CNT}"
  fi

  #For each NIC found, make sure it is 1Gb and full duplex
  for i in `cat ${TEMP_DIR}/${IFCONFIG_FI} | awk '{print $1}'`; do

    lnout 1 0 ${LOG_FILE} "NIC: ${i}"
    #pull the NIC info form the autonegotiation records
    LN=`grep ${i} ${TEMP_DIR}/${AUTONEG_FI}`
    rval=${?}

    #if the NIC was found in the autonegotiation records, parse it
    if [ ${rval} -eq 0 ]; then

      #parse the speed from the autoneg record
      S=`echo ${LN} | awk '{print $2}' | cut -d':' -f2`

      #parse the duplex from the autoneg record
      D=`echo ${LN} | awk '{print $3}' | cut -d':' -f2`

      #if speed is 1000, say so
      if [ ${S} -eq 1000 ]; then
        lnout 2 0 ${LOG_FILE} "Speed is 1Gb"

      #otherwise complain
      else
        lnout 2 0 ${LOG_FILE} "WARNING: Speed found is ${S}, expected 1000"
      fi
    
      #if duplex is full, say so
      if [ "X${D}" = "Xfull" ]; then
        lnout 2 0 ${LOG_FILE} "Duplex is full"

      #otherwise complain
      else
        lnout 2 0 ${LOG_FILE} "WARNING: Duplex found is ${D}, expected full"
      fi
    
    #otherwise, complain that an active NIC was not recorded
    else
      lnout 1 0 ${LOG_FILE} "ERROR: Could not find ${i} in autonegotiation"
      lnout 1 0 ${LOG_FILE} "       records.  This is a problem in this tool"
      lnout 1 0 ${LOG_FILE} "       not necessarily with the server."
    fi
  done
    
  ###############################
  #Live Upgrade evaluation
  
  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "Live Upgrade Evaluation"
 
  #If LU is configured, say so
  if [ ${LUSTATUS_FND} -eq 0 ]; then
    lnout 1 0 ${LOG_FILE} "Live upgrade is configured"

  #otherwise complain
  else
    lnout 1 0 ${LOG_FILE} "WARNING: No Live upgrade configured."
  fi

  ###############################
  #services evaluation

  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "Services Evaluation"

  for i in `cat ${TEMP_DIR}/${SVCS_2_DISABLE_FI}`; do
    CURR_SVC=${i# }
    S=`grep ${CURR_SVC} ${TEMP_DIR}/${SVCS_FND_FI}`
    S=`echo ${S# } | awk '{print $1}'`
    if [ "X${S}" = "Xdisabled" ]; then
      lnout 1 0 ${LOG_FILE} "${CURR_SVC} is disabled."
    else
      lnout 1 0 ${LOG_FILE} "${CURR_SVC} is not disabled.  Use svcadm to disable it."
    fi
  done

  lnout 0 0 ${LOG_FILE} ""
  lnout 0 0 ${LOG_FILE} "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
  lnout 0 0 ${LOG_FILE} ""

}

