def parseCommandLine():
    try:
        (options, args) = getopt.getopt(sys.argv[1:], '?h:p:P:U:B:vVog:')
    except Exception, e:
        usage('Error: ' + str(e))

    for (switch, val) in options:
        if switch == '-?':	  usage(0)
        elif switch[1] in 'hpBPUg': GV.opt[switch] = val
        elif switch[1] in 'vVo':   GV.opt[switch] = True

    def setdef(x, v):
        if not GV.opt[x]:
            t = os.environ.get(v)
            GV.opt[x] = t
            if t:
                verbose('[INFO] %s not specified; default to %s (from %s)' % 
                        (x, t, v))

    setdef('-h', 'PGHOST')
    setdef('-P', 'PGPASSWORD')
    setdef('-U', 'PGUSER')
    setdef('-U', 'USER')
    setdef('-p', 'PGPORT')
    if not GV.opt['-p']:
        usage('Please specify -p port')
    GV.opt['-p'] = parse_int(GV.opt['-p'])

    if not GV.opt['-h']:
        GV.opt['-h'] = 'localhost'
        verbose('[INFO] -h not specified; default to %s' % GV.opt['-h'])
    
    if (len(args) != 0 and len(args) != 1):
        usage('Too many arguments')

    if len(args) == 0:
        GV.dbname = os.environ.get('PGDATABASE') or GV.opt['-U']
        verbose('[INFO] database is %s' % GV.dbname)
    else:
        GV.dbname = args[0]
    
    print ('[INFO] master at host %s, port %s, user %s, database %s' % 
           (GV.opt['-h'], GV.opt['-p'], GV.opt['-U'], GV.dbname))

    try:
        GV.opt['-B'] = int(GV.opt['-B'])
    except Exception, e:
        usage('Error: ' + str(e))

    if GV.opt['-B'] < 1:
        usage('Error: parallelism must be 1 or greater')

    veryverbose('[INFO] degree of parallelism: %s' % GV.opt['-B'])
    
