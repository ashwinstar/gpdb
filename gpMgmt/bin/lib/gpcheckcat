def checkPGNamespace():
    logger.info('-----------------------------------')
    logger.info('Checking missing schema definitions ...')
# doesn't work in 3.1.1.* -- we get an Abort()
#    qry = '''SELECT o.nsp
#         FROM pg_namespace n right outer join 
#              (select relnamespace as nsp from pg_class union
#               select typnamespace as nsp from pg_type union
#               select oprnamespace as nsp from pg_operator union
#               select pronamespace as nsp from pg_proc) o on
#               (n.oid = o.nsp)
#        WHERE n.oid is NULL'''

# SIGH! Seems anything in 3.1.1.* with outer joins and unions is just 
# not on. So, do it step by step

    qry1 = '''select c.relnamespace as nsp from pg_namespace n right outer join
             pg_class c on (n.oid = c.relnamespace)
             WHERE n.oid IS NULL;'''
    err1 = connect2run(qry1, ('nsp',))

    qry2 = '''select c.typnamespace as nsp from pg_namespace n right outer join
             pg_type c on (n.oid = c.typnamespace)
             WHERE n.oid IS NULL;'''
    err2 = connect2run(qry2, ('nsp',))

    qry3 = '''select c.oprnamespace as nsp from pg_namespace n right outer join
             pg_operator c on (n.oid = c.oprnamespace)
             WHERE n.oid IS NULL;'''
    err3 = connect2run(qry3, ('nsp',))
    
    qry4 = '''select c.pronamespace as nsp from pg_namespace n right outer join
             pg_proc c on (n.oid = c.pronamespace)
             WHERE n.oid IS NULL;'''
    err4 = connect2run(qry4, ('nsp',))

    err = err1 + err2 + err3 + err4
    errs = [[err1, qry1], [err2, qry2], [err3, qry3], [err4, qry4]]

    count = 0
    for errrow in errs:
        err = errrow[0]
        qry = errrow[1]
        count += 1
        if not err:
            logger.info('[OK] schema test %i' % count)
        else:
            GV.retcode = 1
            logger.info('[ERROR] schema test %i has %d issue(s)' % (count, len(err)))
            logger.info('[ERROR] %s' % qry)
            for e in err: logger.info('[ERROR] %s' % formatErr(e[0], e[1], e[2]))
            schemaids = {}
            for e in err:
                seg = e[0]['dbid'] 
                if not schemaids.has_key(seg):
                    schemaids[seg] = []
                
                schemaids[seg].append(e[2]['nsp'])    
            for seg in schemaids:
                # unique
                schemas = set(schemaids[seg])
                for schemaid in schemas:
                    c = GV.cfg[seg]
                    removeSchema(seg, connect2(c), schemaid)

