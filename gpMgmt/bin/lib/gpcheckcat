def checkPGExtTable():
    logger.info('-----------------------------------')
    logger.info('Checking pg_exttable ...')

    if GV.version < "4.0":
        qry = '''
    SELECT reloid
    FROM   pg_exttable te left outer join 
           pg_class tc on (te.reloid = tc.oid and tc.relkind = 'x')
    WHERE tc.oid is NULL
    '''
    else:
        qry = '''
    SELECT reloid
    FROM   pg_exttable te left outer join 
           pg_class tc on (te.reloid = tc.oid and tc.relstorage = 'x')
    WHERE tc.oid is NULL
    '''

    err = connect2run(qry, ('reloid',))
    if not err:
        logger.info('[OK] pg_exttable')
    else:
        setError(ERROR_REMOVE)
        logger.info('[FAIL] pg_exttable')
        logger.error('pg_exttable has %d issue(s)' % len(err))
        logger.error(qry)
        for e in err[0:100]: 
            logger.error(formatErr(e[0], e[1], e[2]))
        if len(err) > 100:
            logger.error("...")

        relids = {}
        for e in err:
            seg = e[0]['dbid'] 
            if not relids.has_key(seg):
                relids[seg] = []
            
            relids[seg].append(e[2]['reloid'])    
        for seg in relids:
            # unique
            rels = set(relids[seg])
            for relid in rels:
                c = GV.cfg[seg]
                removeExtTable(seg, connect2(c), relid, str(relid))



