def removeTable(seg, db, reloid):
    # see if table has a toast table and if so, remove that
    db.execute('select oid, reltoastrelid, reltoastidxid from pg_class ' + 
			   'where oid = %i' % reloid)
    for row in db.iterate_dict():
        if row['reltoastrelid'] != 0:
            removeTable(seg, db, row['reltoastrelid'])
    
    if reloid in oidmap:
        rel = oidmap[reloid]
    else:
        # get relname
        db.execute('select nspname, relname, relnamespace from pg_namespace n' +
                    ' right outer join pg_class c on ' +
                    '(c.relnamespace = n.oid) where c.oid = %i' % reloid)
        row = db.read_tuple()
    
        if row:
            nspname = row[0]
            relname = row[1]
            if nspname == None:
                nspname = str(row[2])
            rel = nspname + '.' + relname
            oidmap[reloid] = rel
        else:
            rel = str(reloid)

    removeInheritance(seg, db, reloid, rel)
    removeStats(seg, db, reloid, rel)
    removeAttributes(seg, db, reloid, rel)
    removeRelTuple(seg, db, reloid, rel)
    removeIndexes(seg, db, reloid, rel)
    removeRelType(seg, db, reloid, rel)
    removeExtTable(seg, db, reloid, rel)
    removeDepend(seg, db, reloid, rel)

    if seg == -1:
        removePolicy(seg, db, reloid, rel)

def removeInheritance(seg, db, reloid, rel):
    buildRemove(seg, 'inheritance', 'pg_inherits',
                dict([('inhrelid', reloid),('inhparent', reloid)]), rel)


def removeIndexConstraint(nspname, relname, constraint):
    Constraints.append('ALTER TABLE "%s"."%s" DROP CONSTRAINT "%s";' % \
            (nspname, relname, constraint))

def removeStats(seg, db, reloid, rel):
    buildRemove(seg, 'statistics', 'pg_statistic',
                dict([('starelid', reloid)]), rel)

def removeRelTuple(seg, db, reloid, rel):
    buildRemove(seg, 'relation tuple', 'pg_class',
                dict([('oid', reloid)]), rel)

def removeExtTable(seg, db, reloid, rel):
    buildRemove(seg, 'external table definition', 'pg_exttable',
                dict([('reloid', reloid)]), rel)

def removePolicy(seg, db, reloid, rel):
    buildRemove(seg, 'Distribution policy', 'gp_distribution_policy',
                dict([('localoid', reloid)]), rel)

def removeAttributes(seg, db, reloid, rel):
    buildRemove(seg, 'attributes', 'pg_attribute',
                dict([('attrelid', reloid)]), rel)
    removeAttrDefs(seg, db, reloid, rel)
    removeConstraints(seg, db, reloid, rel)

def removeAttrDefs(seg, db, reloid, rel):
    buildRemove(seg, 'attribute defaults', 'pg_attrdef',
                dict([('adrelid', reloid)]), rel)

def removeConstraints(seg, db, reloid, rel):
    buildRemove(seg, 'constraints', 'pg_constraint',
                dict([('conrelid', reloid)]), rel)

def removeRelType(seg, db, reloid, rel):
    buildRemove(seg, 'relation type tuple', 'pg_type',
                dict([('typrelid', reloid)]), rel)

def removeIndexes(seg, db, reloid, rel):
    buildRemove(seg, 'indexes', 'pg_index', dict([('indrelid', reloid)]), rel)

def removeDepend(seg, db, reloid, rel):
    buildRemove(seg, 'dependencies', 'pg_depend',
                dict([('objid', reloid), ('refobjid', reloid)]), rel)
    buildRemove(seg, 'shared dependencies', 'pg_shdepend',
                dict([('objid', reloid), ('refobjid', reloid)]), rel)

def buildRemove(seg, name, table, cols, objname):
    first = False
    fullstr = ''
    str = ''
    for col in cols:
        if not first:
            fullstr = '--Object Name: %s\n--Remove %s for %i\n' %  \
                (objname, name, cols[col])
        if len(str) > 0:
            str += ' or '
        str += '%s = \'%s\'' % (col, cols[col])
    fullstr += 'DELETE FROM %s WHERE %s;' % (table, str)
    addRemove(seg, fullstr)

def addRemove(seg, line):
    if not Remove.has_key(seg):
        Remove[seg] = []
    Remove[seg].append(line)

class sysCatThread(Thread):
    # Override Thread.__init__ to supply extra info

    def __init__(self, dbid, table, catalog):
        self.dbid = dbid
        self.table = table
        self.catalog = catalog
        Thread.__init__(self)

    def run(self):
        dbid     = self.dbid
        table    = self.table
        catalog  = self.catalog
        host    = GV.cfg[dbid]['hostname']
        port    = GV.cfg[dbid]['port']
        datadir = GV.cfg[dbid]['datadir']
        veryverbose('[INFO] fetching %s from %s:%s:%s' % (catalog, host, port, datadir))
    
        if dbid == 1:
            outfile = "%s/gpcheckcat_m" % GV.tmpdir
        else:
            outfile = "%s/gpcheckcat.%s.%s_s" % (GV.tmpdir, dbid, table)
    
        cmd  = 'PGOPTIONS="-c gp_session_role=utility"'
        cmd += ' psql -A -F , -o %s -h %s -p %s -U %s -c "%s" %s' % \
            (outfile, host, port, GV.opt['-U'], catalog, GV.dbname)
    
        subprocess.call(cmd, shell=True)
    

def row2str(row):
	keys = row.keys()
	keys.sort()

	l = [ "%s: '%s'" % (key, str(row[key])) for key in keys ]
	strout = ', '.join(l)
	return strout

def crossDbCheck():
        print """
-------------------------------------------
Performing cross database consistency tests
-------------------------------------------
"""

        # If we have specified "-o" then we want all the OIDs to be idenitical between
        # segments, otherwise the queries should all be oid/relfile neutral
        if GV.opt['-o'] == True:
            oids       = ', x.oid'
            nspexclude = 'pg_(temp.*|pg_toast)'
        else:
            oids       = ''
            nspexclude = 'pg_temp.*'

	# 1: get catalog from every node
        catalogs = {
                'pg_class':  '''
SELECT nspname, relname, typname, usename, amname, spcname, relnatts,
       relhasindex, relkind, relacl %s
FROM pg_catalog.pg_class x
     LEFT OUTER JOIN pg_catalog.pg_namespace n on (relnamespace = n.oid)
     LEFT OUTER JOIN pg_catalog.pg_type t on (reltype = t.oid)
     LEFT OUTER JOIN pg_catalog.pg_user u on (relowner = u.usesysid)
     LEFT OUTER JOIN pg_catalog.pg_tablespace spc on (reltablespace = spc.oid)
     LEFT OUTER JOIN pg_catalog.pg_am am on (relam = am.oid)
WHERE (nspname is null or n.nspname !~ '%s')
ORDER BY nspname, relname
''' % (oids, nspexclude),
                
                'pg_attribute': '''
SELECT nspname, relname, attnum, attname, typname, attlen, attbyval, attalign,
       attstorage, attndims, attstattarget
FROM pg_catalog.pg_attribute x
     LEFT OUTER JOIN pg_catalog.pg_class c on (attrelid = c.oid)
     LEFT OUTER JOIN pg_catalog.pg_namespace n on (relnamespace = n.oid)
     LEFT OUTER JOIN pg_catalog.pg_type t on (atttypid = t.oid)
WHERE (nspname is null or nspname !~ '%s')
ORDER BY nspname, relname, attnum
''' % (nspexclude),

                'pg_type': '''
SELECT nspname, typname, relname, usename, 
       typlen, typbyval, typtype, typisdefined, typdelim, typelem %s
FROM pg_catalog.pg_type x
     LEFT OUTER JOIN pg_catalog.pg_namespace n on (typnamespace = n.oid)
     LEFT OUTER JOIN pg_catalog.pg_class c on (typrelid = c.oid)
     LEFT OUTER JOIN pg_catalog.pg_user u on (typowner = usesysid)
ORDER BY nspname, typname
''' % (oids),

                'pg_namespace': '''
SELECT nspname, usename, nspacl %s
FROM   pg_catalog.pg_namespace x
       LEFT OUTER JOIN pg_catalog.pg_user u on (nspowner = usesysid)
ORDER BY nspname
''' % (oids),
                }

        # Establish a connection to each node
            
        # check each catalog in turn
        for cid in catalogs:
            error = False
            print '  - Comparing %s on master to all segments' % cid

            threads = []
            i = 1
            for dbid in GV.cfg:
                thread = sysCatThread(dbid, cid, catalogs[cid])
                thread.start()
                veryverbose('[INFO] launching query thread %s for dbid %i' %
                            (thread.getName(), dbid))
                threads.append(thread)

                # we don't want too much going on at once
                if (i % GV.opt['-B']) == 0:
                    for th in threads:
                        veryverbose('[INFO] waiting on thread %s' % 
                                th.getName())
                        th.join()
                    threads = []
                i += 1

            # process leftovers
            for th in threads:
                veryverbose('[INFO] waiting on thread %s' % 
                                th.getName())
                th.join()

            for dbid in GV.cfg:
                if dbid == 1:
                    continue    # master segment

                cmd = 'diff %s/gpcheckcat_m %s/gpcheckcat.%s.%s_s' % \
                    (GV.tmpdir, GV.tmpdir, dbid, cid)
                pipe = subprocess.Popen(cmd, shell=True,
                                        stdout=subprocess.PIPE)

                lines = ''
                for line in pipe.stdout:
                    lines += line

                if len(lines) > 0:
                    print '\n'
                    print '[ERROR] inconsistency between master and seg %i' % \
                            dbid
                    #print "return code %i\n" % pipe.returncode
                    print lines

                os.unlink('%s/gpcheckcat.%s.%s_s' % (GV.tmpdir, dbid, cid))

            os.unlink('%s/gpcheckcat_m' % GV.tmpdir)

        if error == False:
            print '[OK]'
        else:
            GV.retcode = 1

class fileCheckThread(Thread):
    def __init__(self, index, host, file, env):
       self.host = host
       self.file = file
       self.index = index
       self.exists = False
       self.env = env
       Thread.__init__(self)

    def run(self):
        verbose('Checking bitmap index %s on host %s' % \
                (self.file, self.host))

        try:
            cmd = "ssh %s ls -l %s" % (self.host, self.file)
            veryverbose('running command %s' % cmd)
            cmd = cmd.split(' ')
            pipe = subprocess.Popen(cmd, env=self.env,
                                    stdout=subprocess.PIPE,
                                    stderr=subprocess.PIPE)
            result  = pipe.communicate();
        except OSError, e:
            print '%s, %s' % (' '.join(cmd),  str(e))
            raise
    
        if pipe.returncode == 0:
            self.exists = True

def checkBitmapIndexes():
    print '-----------------------------------'
    print 'Checking bitmap indexes'

    c = GV.cfg[1] # master
    db = connect2(c)

    db.execute('''
    select d.oid as dboid, nspname, relname, relfilenode from 
    pg_class c, pg_index i, pg_namespace n, pg_am a,
    pg_database d where c.relam = a.oid and 
    a.amname = 'bitmap' and i.indexrelid = c.oid and c.relnamespace = n.oid
    and d.datname = current_database();
    ''')
    rows = []
    for row in db.iterate_dict():
        rows.append(row)

    # same path as gpinitsystem
    path = '/usr/kerberos/bin:/usr/sfw/bin:/opt/sfw/bin'
    path += ':/usr/local/bin:/bin:/usr/bin:/sbin:/usr/sbin:/usr/ucb'
    path += ':/sw/bin'
    env = {'PATH': path}
    ssh = os.environ.get('SSH_AUTH_SOCK')
    if ssh:
        env['SSH_AUTH_SOCK'] = ssh

    reindex = []
    threads = []
    for row in rows:
        index = '"%s"."%s"' % (row['nspname'], row['relname'])
        exists = True
        for dbid in GV.cfg:
            seg = GV.cfg[dbid]
            file = '%s/base/%s/%s' % (seg['datadir'], row['dboid'],
                        row['relfilenode'])
    
            thread = fileCheckThread(index, seg['hostname'], file, env)
            thread.start()
            threads.append(thread)

            if (len(threads) % GV.opt['-B']) == 0:
                for th in threads:
                    veryverbose('[INFO] waiting on thread %s' % 
                            th.getName())
                    th.join()
                    if th.exists == False:
                        exists = False
                        verbose('Could not find %s:%s' % \
                                (seg['hostname'], file))
                        reindex.append('"%s"."%s"' % (row['nspname'], 
                                                      row['relname']))
                threads = []

            if exists == False:
                break
        # stragglers 
        for th in threads:
            veryverbose('[INFO] waiting on thread %s' % 
                           th.getName())
            th.join()
            if th.exists == False:
                exists = False
                verbose('Could not find %s:%s' % \
                            (seg['hostname'], file))
                reindex.append('"%s"."%s"' % (row['nspname'], 
                                                  row['relname']))
            threads = []

    if reindex:
        GV.retcode = 1
        # unique
        a = list(set(reindex))
        print '[ERROR] %d bitmap issue(s)' % len(a)
        for b in a:
            print '[ERROR] %s' % b
            Reindex.append(b)

    else:
        print '[OK] bitmap indexes'

