def removeTable(seg, db, reloid):
    # see if table has a toast table and if so, remove that
    qry = """
      SELECT oid, reltoastrelid, reltoastidxid
      FROM pg_class
      WHERE oid = %i
    """ % reloid
    curs = db.query(qry)
    for row in curs.dictresult():
        if row['reltoastrelid'] != 0:
            removeTable(seg, db, row['reltoastrelid'])
        if row['reltoastidxid'] != 0:
            removeTable(seg, db, row['reltoastidxid'])

    if reloid in oidmap:
        rel = oidmap[reloid]
    else:
        # get relname
        curs = db.query('select nspname, relname, relnamespace from pg_namespace n' +
                    ' right outer join pg_class c on ' +
                    '(c.relnamespace = n.oid) where c.oid = %i' % reloid)
        if curs.ntuples() > 0:
            row = curs.getresult()[0]
            nspname = row[0]
            relname = row[1]
            if nspname == None:
                nspname = str(row[2])
            rel = nspname + '.' + relname
            oidmap[reloid] = rel
        else:
            rel = str(reloid)

    removeInheritance(seg, db, reloid, rel)
    removeStats(seg, db, reloid, rel)
    removeAttributes(seg, db, reloid, rel)
    removeRelTuple(seg, db, reloid, rel)
    removeIndexes(seg, db, reloid, rel)
    removeRelType(seg, db, reloid, rel)
    removeExtTable(seg, db, reloid, rel)
    removeAppendOnly(seg, db, reloid, rel)
    removeDepend(seg, db, reloid, rel)

    if seg == -1:
        removePolicy(seg, db, reloid, rel)

def removeInheritance(seg, db, reloid, rel):
    buildRemove(seg, 'inheritance', 'pg_inherits',
                dict([('inhrelid', reloid),('inhparent', reloid)]), rel)


def removeIndexConstraint(nspname, relname, constraint):
