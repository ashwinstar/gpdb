# remove all remnants of a schema
def removeSchema(seg, db, schemaid):
    # see if table has a toast table and if so, remove that
    # must do it like this so we can get toast tables
    qry = 'select oid from pg_class where relnamespace = %i' % schemaid
    curs = db.query(qry)
    for row in curs.dictresult():
        removeTable(seg, db, row['oid'])

    # get schema name
    curs = db.query('select nspname from pg_namespace where oid = %i' % schemaid)
    if curs.ntuples() > 0:
        row = db.getresult()[0]
        schemaname = row[0]
        oidmap[schemaid] = schemaname
    else:
        schemaname = str(schemaid)

    buildRemove(seg, 'schema operators', 'pg_operator',
                dict([('oprnamespace', schemaid)]), schemaname)

    buildRemove(seg, 'schema types', 'pg_type',
                dict([('typnamespace', schemaid)]), schemaname)

    buildRemove(seg, 'schema procedures', 'pg_proc',
                dict([('pronamespace', schemaid)]), schemaname)

    removeDepend(seg, db, schemaid, schemaname)
    

