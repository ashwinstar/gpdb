class CheckcatLogger:

    def __init__(self):
        self.logger = None

    def get(self):
        if self.logger == None:
            form = logging.Formatter("gpcheckcat:-[%(levelname)-s]:-%(message)s")
            handler = gplog.EncodingStreamHandler()
            handler.setFormatter(form)
            self.logger = logging.getLogger('gpcheckcat')
            self.logger.addHandler(handler)
            self.logger.setLevel(logging.INFO)
        return self.logger

#-------------------------------------------------------------------------------
