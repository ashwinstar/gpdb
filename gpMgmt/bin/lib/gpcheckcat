    closeDbs()

    crossDbCheck()
    
    fixes = (len(Remove) > 0 or len(Reindex) > 0 or len(Constraints))
    if GV.opt['-g'] != None and fixes:
        try:
            if not os.path.exists(GV.opt['-g']):
                os.mkdir(GV.opt['-g'])
        except Exception, e:
            print '[FATAL] unable to create directory "%s": %s' % (GV.opt['-g'],
                  str(e))
            sys.exit(1)
                   
        verbose('Building catalog repair scripts')
        # build a script to run these files     
        script = '#!/bin/sh\n'

        for seg in Remove:
            # dbid.host.port.dbname.sql
            c = GV.cfg[seg]
            filename = '%i.%s.%i.%s.sql' % (seg, c['hostname'],
                        c['port'], GV.dbname)
            fullpath = '%s/%s' % (GV.opt['-g'], filename)
            try:
                file = open(fullpath, 'w')
            except Exception, e:
                print '[FATAL] unable to create file "%s": %s' %  \
                        (fullpath, str(e))
                sys.exit(1)

            #unique
            lines = set(Remove[seg])

            # make sure it is sorted
            li = list(lines)
            li.sort()
            file.write('BEGIN;\n');
            for line in li:
                file.write(line + '\n')
            file.write('COMMIT;\n');

            file.close()

            script += 'echo "Repairing segment %i"\n' % seg
            script += 'env PGOPTIONS="-c gp_session_role=utility" ' + \
                    'psql -X -a -h %s -p %i -f %s %s > %s.out\n' % \
                    (c['hostname'], c['port'], filename, GV.dbname, filename)

        if len(Reindex) > 0:
            filename = 'reindex.sql'
            fullpath = '%s/%s' % (GV.opt['-g'], filename)
            try:
                file = open(fullpath, 'w')
            except Exception, e:
                print '[FATAL] unable to create file "%s": %s' %  \
                        (fullpath, str(e))
                sys.exit(1)

            for r in Reindex:
                file.write('REINDEX INDEX %s;\n' % r)
            file.close()

            script += 'echo "Reindexing potentially damaged bitmap indexes"\n'
            c = GV.cfg[1]
            script += 'psql -X -a -h %s -p %i -f %s %s > %s.out 2>&1\n' % \
                    (c['hostname'], c['port'], filename, GV.dbname, filename)

        if len(Constraints) > 0:
            Constraints = list(set(Constraints))
            filename = 'removeconstraints.sql'
            fullpath = '%s/%s' % (GV.opt['-g'], filename)
            try:
                file = open(fullpath, 'w')
            except Exception, e:
                print '[FATAL] unable to create file "%s": %s' %  \
                        (fullpath, str(e))
                sys.exit(1)

            for r in Constraints:
                file.write('%s\n' % r)
            file.close()

            script += 'echo "Dropping invalid unique constraints"\n'
            c = GV.cfg[1]
            script += 'psql -X -a -h %s -p %i -f %s %s > %s.out 2>&1\n' % \
                    (c['hostname'], c['port'], filename, GV.dbname, filename)


        try:
            path = '%s/runsql.sh' % GV.opt['-g']
            file = open(path, 'w')
            file.write(script)
            file.close()
            os.chmod(path, stat.S_IXUSR | stat.S_IRUSR | stat.S_IWUSR)
        except Exception, e:
            print '[FATAL] could not write script: %s' % str(e)
            sys.exit(1)

        print '[INFO] repair scripts generated in directory %s' % GV.opt['-g']
    subprocess.call('rm -rf ' + GV.tmpdir, shell=True)
    sys.exit(GV.retcode)
