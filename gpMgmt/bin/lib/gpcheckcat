def crossDbCheck():
    fkcdb = 'Performing foreign key and cross database consistency tests';
    fkcdbdash = '-'*len(fkcdb) # big dashed line
    logger.info(fkcdbdash)
    logger.info(fkcdb);
    logger.info(fkcdbdash)

    # Establish a connection to the master
    db = connect2(GV.cfg[1], utilityMode=False)

    # Find the highest contentid
    max_content = max([GV.cfg[dbid]['content'] for dbid in GV.cfg])

    # the GPCatalog object looks up information in the catalog:
    #   - a list of catalog tables defined in the database
    #   - which tables are "master only"
    #   - the primary keys for the tables
    #   - the oid columns for the tables
    #   - the acl columns for the tables
    #   - which tables have foreign keys on other tables
    #   - etc
    #
    # Most of this is derived directly from the catalog definition, but
    # some requires extra hinting.  
    #
    # see gppylib.gpcatalog for details
    #
    catalog = GPCatalog(db)
    tables = catalog.getCatalogTables()

    # check foreign key constraints            
    checkFKConstraint(db, tables, max_content)

    logger.info('-----------------------------------')
    logger.info('Checking cross database consistency ...')

    for cat in sorted(tables):
        catname = cat.getTableName()
        pkey    = cat.getPrimaryKey()
        master  = cat.isMasterOnly()
        columns = cat.getTableColumns(with_acl=False)

        # Skip master only tables
        if master:
            continue

        # Skip catalogs without primary key
        if pkey == []:
            logger.warn("[WARN] Skipped cross consistency check for %s" % 
                        catname)
            continue

        qry = crossDbquery(max_content, catname, pkey, columns)
        
        # Execute the query
        try:
            curs  = db.query(qry)
            nrows = curs.ntuples()
        
            if nrows == 0:
                logger.info('[OK] Cross consistency check for ' + catname)
            else:
                logger.info('[FAIL] Cross consistency check for ' + catname)
                logger.error('  %s has %d issue(s)' % (catname, nrows))
                # logger.error(qry)

                # TODO: smarter handling of output
                #   - Improved reporting when all segments are different 
                #     from master
                #   - Improved identification of what the difference is
                #   - Dumping to a file when there is too much data
                #   - Don't use "print"
                fields = curs.listfields()
                print "    " + " | ".join(fields)
                for row in curs.getresult():
                    print "    " + " | ".join(map(str, row))
        
        except Exception, e:
            logger.info('[FAIL] Cross consistency check for ' + catname)
            logger.error('  Execution error: ' + str(e))
            logger.error(qry)

            
    # Checking ACLs in the above query proved prohibitively difficult to
    # do correctly, so we break the ACL check into a separate query.
    for cat in sorted(tables):

        catname   = cat.getTableName()
        pkey      = cat.getPrimaryKey()
        master    = cat.isMasterOnly()
        acl       = cat.getTableAcl()

        # Skip:
        #   - master only tables
        #   - tables without a primary key
        #   - tables without acls
        if master or pkey == [] or acl == None:
            continue


        # Build up the catalog query based on the catalog definition
        #
        # It is sufficient to only compare acls for objects that exist on
        # both master and segment, so we can do a simple join on the primary
        # key instead of the complex union/except queries above.
        #
        # Comparing ACLs cannot be done with a simple equality comparison
        # since it is valid for the ACLs to have different order.  Instead
        # we compare that both acls are subsets of each other => equality.
        pkey = ', '.join(pkey)
        qry = """
        SELECT s.gp_segment_id, {primary_key}, 
               m.{acl} as master_acl, s.{acl} as segment_acl
        FROM {catalog} m
        JOIN gp_dist_random('{catalog}') s using ({primary_key})
        WHERE  not (m.{acl} @> s.{acl} and s.{acl} @> m.{acl}) or
               (m.{acl} is null and s.{acl} is not null) or
               (s.{acl} is null and m.{acl} is not null)
        ORDER BY {primary_key}, s.gp_segment_id
        """.format(catalog     = catname,
                   primary_key = pkey,
                   acl         = acl)


        try:
            curs  = db.query(qry)
            nrows = curs.ntuples()
        
            if nrows == 0:
                logger.info('[OK] Cross consistency acl check for ' + catname)
            else:
                logger.info('[FAIL] Cross consistency acl check for ' + catname)
                logger.error('  %s acl check has %d issue(s)' % (catname, nrows))
                # logger.error(qry)

                # TODO: smarter handling of output
                #   - Improved reporting when all segments are different 
                #     from master
                #   - Improved identification of what the difference is
                #   - Dumping to a file when there is too much data
                #   - Don't use "print"
                fields = curs.listfields()
                print "    " + " | ".join(fields)
                for row in curs.getresult():
                    print "    " + " | ".join(map(str, row))
        
        except Exception, e:
            logger.info('[FAIL] Cross consistency check for ' + catname)
            logger.error('  Execution error: ' + str(e))
            logger.error(qry)


class fileCheckThread(Thread):
    # connect to host and look for oidlist for each segment on the host
    # dirs is a dict mapping segid -> dir
    def __init__(self, host, segs, env):
       self.host = host
       self.segs = segs
       self.env = env
       self.badinds = []
       self.exception = None
       Thread.__init__(self)

    def run(self):
        logger.debug('Checking bitmap indexes on host %s' % self.host)

        oidsbyseg = {}
        dboid = 0

        for seg in self.segs:
            db = connect2(seg)
            curs = db.query('''
    select d.oid as dboid, nspname, relname, relfilenode from 
    pg_class c, pg_index i, pg_namespace n, pg_am a,
    pg_database d where c.relam = a.oid and 
    a.amname = 'bitmap' and i.indexrelid = c.oid and c.relnamespace = n.oid
    and d.datname = current_database();
            ''')
            oidsbyseg[seg['dbid']] = {}
            for row in curs.dictresult():
                dboid = row['dboid']
                oidsbyseg[seg['dbid']][row['relfilenode']] = row

        
        try:
            cs = ""
            for seg in self.segs:
                dir = '%s/base/%s/' % (seg['datadir'], dboid)
                segid = seg['dbid'];
                cs += 'cd ' + dir + '; ls -1 | while read file; ' + \
                       'do echo ' + str(segid) + '=$file; done; '

            cmd = "ssh -o StrictHostKeyChecking=no %s (%s)" % \
                    (self.host, cs)

            logger.debug('running command %s' % cmd)
            cmd = cmd.split(' ')
            pipe = subprocess.Popen(cmd, env=self.env,
                                    stdout=subprocess.PIPE,
                                    stderr=subprocess.PIPE, close_fds=True)
            result  = pipe.communicate();
        except OSError, e:
            logger.info('%s, %s' % (' '.join(cmd),  str(e)))
            self.exception = e
            return
    
        logger.debug('directory listing:\n%s' % result[0])
        if pipe.returncode == 0:
            oidseghash = {}
            for line in result[0].split('\n'):
                l = line.split('=')
                if len(l) == 2:
                    if l[0].isdigit() and l[1].isdigit():
                        segid = int(l[0])
                        oid = int(l[1])
                        if oidseghash.get(segid) == None:
                            oidseghash[segid] = {}

                        oidseghash[segid][oid] = True

            for seg in self.segs:
                segid = seg['dbid']
                # XXX: this doesn't handle tablespaces correctly
                if not oidseghash.get(segid):
                    for oid, row in oidsbyseg[segid].iteritems():
                        self.badinds.append(row)
                    break
                  
                for oid, row in oidsbyseg[segid].iteritems():
                    oid = int(oid)
                    logger.debug('Checking index oid %s' % oid)
                    if not oidseghash[segid].get(oid):
                        self.badinds.append(row)
                        logger.debug('Could not find index with relfilenode %s' % oid)

        else:
            msg = 'Failed to fetch directory listing on host %s' % self.host
            logger.error(result[1].strip())
            self.exception = Exception(msg)
            return



def checkBitmapIndexes():
    # In 4.0 the bitmap index check, which looks for bitmap indexes
    # where the relfilenode does not exist on disk, is subsumed by the
    # persistent object validation, which checks the same thing for
    # every object using a more efficient methodology.
    #
    # However, the persistent validation functions only exist in 4.0+,
    # for older versions we still want to at least check for the
    # issue we know to be possible with bitmaps, so this test remains.
    if GV.version >= "4.0":
        return

    logger.info('-----------------------------------')
    logger.info('Checking bitmap indexes')

    db = connect2(GV.cfg[1])
    curs = db.query('''
    select d.oid as dboid, nspname, relname, relfilenode 
    from   pg_class c, pg_index i, pg_namespace n, pg_am a, pg_database d 
    where  c.relam = a.oid and a.amname = 'bitmap' and i.indexrelid = c.oid 
      and c.relnamespace = n.oid and d.datname = current_database();
    ''')
    if curs.ntuples() == 0:
        logger.info('[OK] no bitmaps to check')
        return

    # same path as gpinitsystem
    path = '/usr/kerberos/bin:/usr/sfw/bin:/opt/sfw/bin'
    path += ':/usr/local/bin:/bin:/usr/bin:/sbin:/usr/sbin:/usr/ucb'
    path += ':/sw/bin'
    env = {'PATH': path, 'LOGNAME': GV.user, 'USER': GV.user,
           'HOME': GV.home}
    ssh = os.environ.get('SSH_AUTH_SOCK')
    if ssh:
        env['SSH_AUTH_SOCK'] = ssh

    reindex = []
    threads = []
    mod = GV.opt['-B'] / 4
    if mod == 0:
        mod = 1

    raised = False
    badinds = []

    hostsegmap = {}
    for segid in GV.cfg:
        seg = GV.cfg[segid]
        if not hostsegmap.get(seg['hostname']):
            hostsegmap[seg['hostname']] = []

        hostsegmap[seg['hostname']].append(seg)

    for host in hostsegmap.keys():
        segs = hostsegmap[host]
        # supply just the relfilenodes, not the full mapping
        thread = fileCheckThread(host, segs, env)
        thread.start()
        threads.append(thread)

        if (len(threads) % mod) == 0:
            for th in threads:
                logger.debug('waiting on thread %s' % th.getName())
                th.join()
                badinds += th.badinds
                raised |= (th.exception != None)

            threads = []

    # stragglers 
    for th in threads:
        logger.debug('waiting on thread %s' % 
                       th.getName())
        th.join()
        badinds += th.badinds
        raised |= (th.exception != None)

    threads = []

    if raised:
        setError(ERROR_NOREPAIR)
        logger.info('[FAIL] bitmap indexes')
    elif badinds:
        setError(ERROR_REMOVE)

        # unique
        reindex = []

        for row in badinds:
            reindex.append(row['nspname'] + '.' + row['relname'])

        a = list(set(reindex))
        logger.info('bitmap test found %d bitmap issue(s)' % len(a))
        for index in a[0:100]:
            logger.error(index)
        if len(a) > 100:
            logger.error("...")

        # Generate a repair script for all broken indexes
        for index in a:
            Reindex.append(index)

    else:
        logger.info('[OK] bitmap indexes')

def checkDepend():
    # Check for dependencies on non-existent objects
    logger.info('-----------------------------------')
    logger.info('Checking Object Dependencies')

    db = connect2(GV.cfg[1], utilityMode=False)

    # Catalogs that link up to pg_depend/pg_shdepend
    qry = "select relname from pg_class where relnamespace=11 and relhasoids"
    curs = db.query(qry)
    catalogs = []
    for row in curs.getresult():
        catalogs.append(row[0])

    # For each catalog construct the subquery for that catalog
    #
    # It would be desireable to switch these queries to a gp_dist_random
    # type query rather than issueing it in utility mode on every segment,
    # however because there are numerous issues remaining with oid 
    # inconsistencies (see crossDBCheck()) that doesn't work out well.
    deps = []
    for cat in catalogs:
        qry = """
          SELECT '{catalog}' as catalog, objid FROM (
            SELECT objid FROM pg_depend 
              WHERE classid = '{catalog}'::regclass
            UNION ALL
            SELECT refobjid FROM pg_depend 
              WHERE refclassid = '{catalog}'::regclass
          ) d 
          LEFT OUTER JOIN {catalog} c on (d.objid = c.oid)
          WHERE c.oid is NULL
          UNION ALL
          SELECT '{catalog}' as catalog, objid FROM (
            SELECT dbid, objid FROM pg_shdepend
              WHERE classid = '{catalog}'::regclass
            UNION ALL
            SELECT dbid, refobjid FROM pg_shdepend
              WHERE refclassid = '{catalog}'::regclass
          ) d JOIN pg_database db 
            ON (d.dbid = db.oid and datname= current_database())
          LEFT OUTER JOIN {catalog} c on (d.objid = c.oid)
          WHERE c.oid is NULL
          """.format(catalog=cat)
        deps.append(qry)

    qry = """
    SELECT distinct catalog, objid 
    FROM (%s
    ) q
    """ % "UNION ALL".join(deps)
    try:
        err = connect2run(qry)
        if not err:
            logger.info('[OK] basic object dependencies')
        else:
            setError(ERROR_REMOVE)
            logger.info('[FAIL] basic object dependencies')
            logger.error('  found %d dependencies on dropped objects' % len(err))
            # logger.info(qry)

            todrop = {}
            for e in err:
                seg = e[0]['dbid']    # segment the error came from
                oid = e[2]['objid']   # objid that did not exist
                cat = e[2]['catalog'] # catname
                if seg not in todrop:
                    todrop[seg] = set()
                todrop[seg].add((oid, cat))

            for seg in todrop:
                segdb = connect2(GV.cfg[seg])
                for (objid, cat) in todrop[seg]:
                    name = "dropped oid %s in %s" % (objid, cat)
                    removeDepend(seg, segdb, objid, name)
            

    except Exception, e:
        logger.info("[FAIL] basic object dependencies")
        logger.error("  Execution error: " + str(e))
        logger.error(qry)
        

def fixupowners(nspname, relname, oldrole, newrole):
    
    # Must first alter the table to the wrong owner, then back to the right
    # owner.  The purpose of this is that AT doesn't dispatch the change unless
    # it think the table actually changed owner.
    #
    # Note: this means that the Owners list must be run in the order given.
    #
    Owners.append('-- owner for "%s"."%s"' % (nspname, relname))
    Owners.append('ALTER TABLE "%s"."%s" OWNER TO "%s";' % 
                  (nspname, relname, oldrole))
    Owners.append('ALTER TABLE "%s"."%s" OWNER TO "%s";' % 
                  (nspname, relname, newrole))


def checkOwners():
    logger.info('-----------------------------------')
    logger.info('Checking table ownership')
    if GV.version < "3.3":
        logger.info('Skipping...')
        return

    # Check owners in pg_class
    #
    #  - Report each table that has an inconsistency with the master database,
    #    this can be on the table directly, or on one of the table subobjects
    #    (pg_toast, pg_aoseg, etc)
    #
    #  - Theoretically this could result in multiple corrections for a given
    #    table based on having multiple "wrong" owners.  Realistically most
    #    of the problems we have seen with this problem the wrong owner is
    #    almost always the gpadmin user, so this is not expected.  If it does
    #    occur it won't be a problem, but we will issue more ALTER TABLE 
    #    commands than is strictly necessary.
    #
    #  - Between 3.3 and 4.0 the ao segment columns migrated from pg_class
    #    to pg_appendonly.
    db = connect2(GV.cfg[1], utilityMode=False)
    if GV.version >= "4.0":
        qry = '''
    select distinct n.nspname, coalesce(o.relname, c.relname) as relname,
                    a.rolname, m.rolname as master_rolname
    from gp_dist_random('pg_class') r
      join pg_class c on (c.oid = r.oid)
      left join pg_appendonly ao on (c.oid = ao.segrelid or 
                                     c.oid = ao.segidxid or
                                     c.oid = ao.blkdirrelid or 
                                     c.oid = ao.blkdiridxid)
      left join pg_class t on (t.reltoastidxid = c.oid)
      left join pg_class o on (o.oid = ao.relid or 
                               o.reltoastrelid = t.oid or
                               o.reltoastrelid = c.oid)
      join pg_authid a on (a.oid = r.relowner)
      join pg_authid m on (m.oid = coalesce(o.relowner, c.relowner))
      join pg_namespace n on (n.oid = coalesce(o.relnamespace, c.relnamespace))
    where c.relowner <> r.relowner
    '''
    else:
        qry = '''
    select distinct n.nspname, coalesce(o.relname, c.relname) as relname,
                    a.rolname, m.rolname as master_rolname
    from gp_dist_random('pg_class') r
      join pg_class c on (c.oid = r.oid)
      left join pg_class t on (t.reltoastidxid = c.oid or
                               t.relaosegidxid = c.oid)
      left join pg_class o on (o.reltoastrelid = t.oid or
                               o.reltoastrelid = c.oid or
                               o.relaosegrelid = t.oid or
                               o.relaosegrelid = c.oid)
      join pg_authid a on (a.oid = r.relowner)
      join pg_authid m on (m.oid = coalesce(o.relowner, c.relowner))
      join pg_namespace n on (n.oid = coalesce(o.relnamespace, c.relnamespace))
    where c.relowner != r.relowner
    '''
    curs = db.query(qry)

    rows = []
    for row in curs.dictresult():
        rows.append(row)

    if len(rows) == 0:
        logger.info('[OK] table ownership')
    else:
        setError(ERROR_REMOVE)
        logger.info('[FAIL] table ownership')
        logger.error('found %d table ownership issue(s)' % len(rows))
        logger.error('%s' % qry)
        for row in rows[0:100]:
            logger.error('  %s.%s relowner %s != %s'
                % (row['nspname'], row['relname'], row['rolname'],
                   row['master_rolname']))
        if len(rows) > 100:
            logger.error("...")
        for row in rows:
            fixupowners(row['nspname'], row['relname'], row['rolname'],
                        row['master_rolname'])

    # TODO: add a check that subobject owners agree with the main object owner.
    # (The above checks only compare master vs segment)


    # Check owners in pg_type
    #  - Ignore implementation types of pg_class entries - they should be
    #    in the check above since ALTER TABLE is required to fix them, not
    #    ALTER TYPE.
    db = connect2(GV.cfg[1], utilityMode=False)
    qry = '''
    select distinct n.nspname, t.typname, a.rolname, m.rolname as master_rolname
    from gp_dist_random('pg_type') r
      join pg_type t on (t.oid = r.oid)
      join pg_namespace n on (n.oid = t.typnamespace)
      join pg_authid a on (a.oid = r.typowner)
      join pg_authid m on (m.oid = t.typowner)
    where r.typowner <> t.typowner and r.typrelid = 0
    '''
    curs = db.query(qry)

    rows = []
    for row in curs.dictresult():
        rows.append(row)

    if len(rows) == 0:
        logger.info('[OK] type ownership')
    else:
        setError(ERROR_NOREPAIR)
        logger.info('[FAIL] type ownership')
        logger.error('found %d type ownership issue(s)' % len(rows))
        logger.error('%s' % qry)
        for row in rows[0:100]:
            logger.error('  %s.%s typeowner %s != %s'
                % (row['nspname'], row['typname'], row['rolname'],
                   row['master_rolname']))
        if len(rows) > 100:
            logger.error("...")
        # FIXME: add repair script
