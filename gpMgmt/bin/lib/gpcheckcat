def parseCommandLine():
    try:
        (options, args) = getopt.getopt(sys.argv[1:], '?h:p:P:U:B:vog:tT:')
    except Exception, e:
        usage('Error: ' + str(e))

    for (switch, val) in options:
        if switch == '-?':	  usage(0)
        elif switch[1] in 'hpBPUgT': GV.opt[switch] = val
        elif switch[1] in 'vot':   GV.opt[switch] = True

    def setdef(x, v):
        if not GV.opt[x]:
            t = os.environ.get(v)
            GV.opt[x] = t
            if t:
                logger.debug('%s not specified; default to %s (from %s)' % 
                        (x, t, v))

    if GV.opt['-v']:
        enable_verbose_logging()

    setdef('-h', 'PGHOST')
    setdef('-P', 'PGPASSWORD')
    setdef('-U', 'PGUSER')
    setdef('-U', 'USER')
    setdef('-p', 'PGPORT')
    if not GV.opt['-p']:
        usage('Please specify -p port')
    GV.opt['-p'] = parse_int(GV.opt['-p'])

    if not GV.opt['-h']:
        GV.opt['-h'] = 'localhost'
        logger.debug('-h not specified; default to %s' % GV.opt['-h'])
    
    if (len(args) != 0 and len(args) != 1):
        usage('Too many arguments')

    if len(args) == 0:
        GV.dbname = os.environ.get('PGDATABASE') or GV.opt['-U']
        logger.debug('database is %s' % GV.dbname)
    else:
        GV.dbname = args[0]
    
    logger.info('master at host %s, port %s, user %s, database %s' % 
           (GV.opt['-h'], GV.opt['-p'], GV.opt['-U'], GV.dbname))

    try:
        GV.opt['-B'] = int(GV.opt['-B'])
    except Exception, e:
        usage('Error: ' + str(e))

    if GV.opt['-B'] < 1:
        usage('Error: parallelism must be 1 or greater')

    logger.debug('degree of parallelism: %s' % GV.opt['-B'])
    
