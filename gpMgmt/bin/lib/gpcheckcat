def getversion():
    db = connect2(GV.cfg[1])
    db.execute('''
    select regexp_replace(version(), E'.*PostgreSQL \([^ ]*\).*Greenplum.*',
    E'\\\\1') as ver;''')

    row = db.read_tuple()
    version = row[0]

    verbose('got version %s' % version)
    if not (version == "8.2.6" or version == "8.2.9"):
        usage('Error: only Greenplum database 3.1 and 3.2 are supported')

    return version


