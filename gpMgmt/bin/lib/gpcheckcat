def removeTable(seg, db, reloid):
    # see if table has a toast table and if so, remove that
    curs = db.query('select oid, reltoastrelid, reltoastidxid from pg_class ' + 
			   'where oid = %i' % reloid)
    for row in curs.dictresult():
        if row['reltoastrelid'] != 0:
            removeTable(seg, db, row['reltoastrelid'])
    
    if reloid in oidmap:
        rel = oidmap[reloid]
    else:
        # get relname
        curs = db.query('select nspname, relname, relnamespace from pg_namespace n' +
                    ' right outer join pg_class c on ' +
                    '(c.relnamespace = n.oid) where c.oid = %i' % reloid)
        if curs.ntuples() > 0:
            row = curs.getresult()[0]
            nspname = row[0]
            relname = row[1]
            if nspname == None:
                nspname = str(row[2])
            rel = nspname + '.' + relname
            oidmap[reloid] = rel
        else:
            rel = str(reloid)

    removeInheritance(seg, db, reloid, rel)
    removeStats(seg, db, reloid, rel)
    removeAttributes(seg, db, reloid, rel)
    removeRelTuple(seg, db, reloid, rel)
    removeIndexes(seg, db, reloid, rel)
    removeRelType(seg, db, reloid, rel)
    removeExtTable(seg, db, reloid, rel)
    removeDepend(seg, db, reloid, rel)

    if seg == -1:
        removePolicy(seg, db, reloid, rel)

def removeInheritance(seg, db, reloid, rel):
    buildRemove(seg, 'inheritance', 'pg_inherits',
                dict([('inhrelid', reloid),('inhparent', reloid)]), rel)


def removeIndexConstraint(nspname, relname, constraint):
    Constraints.append('ALTER TABLE "%s"."%s" DROP CONSTRAINT "%s";' % \
            (nspname, relname, constraint))

def removeStats(seg, db, reloid, rel):
    buildRemove(seg, 'statistics', 'pg_statistic',
                dict([('starelid', reloid)]), rel)

def removeRelTuple(seg, db, reloid, rel):
    buildRemove(seg, 'relation tuple', 'pg_class',
                dict([('oid', reloid)]), rel)

def removeExtTable(seg, db, reloid, rel):
    buildRemove(seg, 'external table definition', 'pg_exttable',
                dict([('reloid', reloid)]), rel)

def removePolicy(seg, db, reloid, rel):
    buildRemove(seg, 'Distribution policy', 'gp_distribution_policy',
                dict([('localoid', reloid)]), rel)

def removeAttributes(seg, db, reloid, rel):
    buildRemove(seg, 'attributes', 'pg_attribute',
                dict([('attrelid', reloid)]), rel)
    removeAttrDefs(seg, db, reloid, rel)
    removeConstraints(seg, db, reloid, rel)

def removeAttrDefs(seg, db, reloid, rel):
    buildRemove(seg, 'attribute defaults', 'pg_attrdef',
                dict([('adrelid', reloid)]), rel)

def removeConstraints(seg, db, reloid, rel):
    buildRemove(seg, 'constraints', 'pg_constraint',
                dict([('conrelid', reloid)]), rel)

def removeRelType(seg, db, reloid, rel):
    buildRemove(seg, 'relation type tuple', 'pg_type',
                dict([('typrelid', reloid)]), rel)

def removeIndexes(seg, db, reloid, rel):
    buildRemove(seg, 'indexes', 'pg_index', dict([('indrelid', reloid)]), rel)

def removeDepend(seg, db, reloid, rel):
    buildRemove(seg, 'dependencies', 'pg_depend',
                dict([('objid', reloid), ('refobjid', reloid)]), rel)
    buildRemove(seg, 'shared dependencies', 'pg_shdepend',
                dict([('objid', reloid), ('refobjid', reloid)]), rel)

def buildRemove(seg, name, table, cols, objname):
    first = False
    fullstr = ''
    str = ''
    for col in cols:
        if not first:
            fullstr = '--Object Name: %s\n--Remove %s for %i\n' %  \
                (objname, name, cols[col])
        if len(str) > 0:
            str += ' or '
        str += '%s = \'%s\'' % (col, cols[col])
    fullstr += 'DELETE FROM %s WHERE %s;' % (table, str)
    addRemove(seg, fullstr)

def addRemove(seg, line):
    if not Remove.has_key(seg):
        Remove[seg] = []
    Remove[seg].append(line)

class sysCatThread(Thread):
    # Override Thread.__init__ to supply extra info

    def __init__(self, dbid, table, catalog):
        self.dbid = dbid
        self.table = table
        self.catalog = catalog
        Thread.__init__(self)

    def run(self):
        dbid     = self.dbid
        table    = self.table
        catalog  = self.catalog
        host    = GV.cfg[dbid]['hostname']
        port    = GV.cfg[dbid]['port']
        datadir = GV.cfg[dbid]['datadir']
        logger.debug('fetching %s from %s:%s:%s' % (catalog, host, port, datadir))
    
        if dbid == 1:
            outfile = "%s/gpcheckcat_m" % GV.tmpdir
        else:
            outfile = "%s/gpcheckcat.%s.%s_s" % (GV.tmpdir, dbid, table)
    
        cmd  = 'PGOPTIONS="-c gp_session_role=utility"'
        cmd += ' psql -A -F , -o %s -h %s -p %s -U %s -c "%s" "%s"' % \
            (outfile, host, port, GV.opt['-U'], catalog, GV.dbname)
    
        logger.debug('outfile = %s' % outfile)
        subprocess.call(cmd, shell=True, close_fds=True)
    

def row2str(row):
	keys = row.keys()
	keys.sort()

	l = [ "%s: '%s'" % (key, str(row[key])) for key in keys ]
	strout = ', '.join(l)
	return strout

def crossDbCheck():
    logger.info('-------------------------------------------')
    logger.info('Performing cross database consistency tests')
    logger.info('-------------------------------------------')

    # If we have specified "-o" then we want all the OIDs to be idenitical
    # between segments, otherwise the queries should all be oid/relfile neutral
    if GV.opt['-o'] == True:
        oids       = ', x.oid'
        nspexclude = 'pg_temp_.*'
    else:
        oids       = ''
        nspexclude = 'pg_(temp_.*|toast)'

	# 1: get catalog from every node
    # we use copy (...) to stdout here in case the result set is huge (which is
    # often with pg_attribute). Otherwise, psql caches the whole result set in
    # its local memory, then copies to stdout.
    # Note the complex sorting of relacl. This is necessary because relacls
    # might be in different orders when you compare the master to segments.
    catalogs = {
                'pg_class':  '''
copy (
SELECT nspname, relname, typname, usename, amname, spcname, relnatts,
       relhasindex, relkind,
       array(select relacl[i] from 
               generate_series(array_lower(relacl,1), array_upper(relacl,1)) i
               order by textin(aclitemout(relacl[i]))) as acl
        %s
FROM pg_catalog.pg_class x
     LEFT OUTER JOIN pg_catalog.pg_namespace n on (relnamespace = n.oid)
     LEFT OUTER JOIN pg_catalog.pg_type t on (reltype = t.oid)
     LEFT OUTER JOIN pg_catalog.pg_user u on (relowner = u.usesysid)
     LEFT OUTER JOIN pg_catalog.pg_tablespace spc on (reltablespace = spc.oid)
     LEFT OUTER JOIN pg_catalog.pg_am am on (relam = am.oid)
WHERE (nspname is null or nspname !~ '%s')
ORDER BY nspname, relname
) to stdout delimiter ','
''' % (oids, nspexclude),
                
                'pg_attribute': '''
copy (
SELECT nspname, relname, attnum, attname, typname, attlen, attbyval, attalign,
       attstorage, attndims, attstattarget
FROM pg_catalog.pg_attribute x
     LEFT OUTER JOIN pg_catalog.pg_class c on (attrelid = c.oid)
     LEFT OUTER JOIN pg_catalog.pg_namespace n on (relnamespace = n.oid)
     LEFT OUTER JOIN pg_catalog.pg_type t on (atttypid = t.oid)
WHERE (nspname is null or nspname !~ '%s')
ORDER BY nspname, relname, attnum
) to stdout delimiter ','
''' % (nspexclude),

                'pg_type': '''
copy (
SELECT nspname, typname, relname, usename, 
       typlen, typbyval, typtype, typisdefined, typdelim, typelem %s
FROM pg_catalog.pg_type x
     LEFT OUTER JOIN pg_catalog.pg_namespace n on (typnamespace = n.oid)
     LEFT OUTER JOIN pg_catalog.pg_class c on (typrelid = c.oid)
     LEFT OUTER JOIN pg_catalog.pg_user u on (typowner = usesysid)
WHERE (nspname is null or nspname !~ '%s')
ORDER BY nspname, typname
) to stdout delimiter ','
''' % (oids, nspexclude),

                'pg_namespace': '''
copy (
SELECT nspname, usename, nspacl %s
FROM   pg_catalog.pg_namespace x
       LEFT OUTER JOIN pg_catalog.pg_user u on (nspowner = usesysid)
ORDER BY nspname
) to stdout delimiter ','
''' % (oids),
                }

    # Establish a connection to each node
        
    # check each catalog in turn
    error = False
    for cid in catalogs:
        logger.info('  - Comparing %s on master to all segments' % cid)

        threads = []
        i = 1
        for dbid in GV.cfg:
            thread = sysCatThread(dbid, cid, catalogs[cid])
            thread.start()
            logger.debug('launching query thread %s for dbid %i' %
                        (thread.getName(), dbid))
            threads.append(thread)

            # we don't want too much going on at once
            if (i % GV.opt['-B']) == 0:
                for th in threads:
                    logger.debug('waiting on thread %s' % 
                            th.getName())
                    th.join()
                threads = []
            i += 1

        # process leftovers
        for th in threads:
            logger.debug('waiting on thread %s' % 
                            th.getName())
            th.join()

        for dbid in GV.cfg:
            if dbid == 1:
                continue    # master segment

            cmd = 'diff %s/gpcheckcat_m %s/gpcheckcat.%s.%s_s' % \
                (GV.tmpdir, GV.tmpdir, dbid, cid)
            pipe = subprocess.Popen(cmd, shell=True,
                                    stdout=subprocess.PIPE, close_fds=True)

            lines = ''
            for line in pipe.stdout:
                lines += line

            if len(lines) > 0:
                logger.info('\n')
                logger.info('[ERROR] inconsistency between master and seg %i' % \
                         dbid)
                #logger.info("return code %i\n" % pipe.returncode)
                logger.info(lines)
                error = True
                GV.retcode = 1

            os.unlink('%s/gpcheckcat.%s.%s_s' % (GV.tmpdir, dbid, cid))

        os.unlink('%s/gpcheckcat_m' % GV.tmpdir)

    if error == False:
        logger.info('[OK]')

class fileCheckThread(Thread):
    # connect to host and look for oidlist for each segment on the host
    # dirs is a dict mapping segid -> dir
    def __init__(self, host, segs, env):
       self.host = host
       self.segs = segs
       self.env = env
       self.badinds = []
       Thread.__init__(self)

    def run(self):
        logger.debug('Checking bitmap indexes on host %s' % self.host)

        oidsbyseg = {}
        dboid = 0

        for seg in self.segs:
            db = connect2(seg)
            curs = db.query('''
    select d.oid as dboid, nspname, relname, relfilenode from 
    pg_class c, pg_index i, pg_namespace n, pg_am a,
    pg_database d where c.relam = a.oid and 
    a.amname = 'bitmap' and i.indexrelid = c.oid and c.relnamespace = n.oid
    and d.datname = current_database();
            ''')
            oidsbyseg[seg['dbid']] = {}
            for row in curs.dictresult():
                dboid = row['dboid']
                oidsbyseg[seg['dbid']][row['relfilenode']] = row

        
        try:
            cs = ""
            for seg in self.segs:
                dir = '%s/base/%s/' % (seg['datadir'], dboid)
                segid = seg['dbid'];
                cs += 'cd ' + dir + '; ls -1 | while read file; ' + \
                       'do echo ' + str(segid) + '=$file; done; '

            cmd = "ssh -o StrictHostKeyChecking=no %s (%s)" % \
                    (self.host, cs)

            logger.debug('running command %s' % cmd)
            cmd = cmd.split(' ')
            pipe = subprocess.Popen(cmd, env=self.env,
                                    stdout=subprocess.PIPE,
                                    stderr=subprocess.PIPE, close_fds=True)
            result  = pipe.communicate();
        except OSError, e:
            logger.info('%s, %s' % (' '.join(cmd),  str(e)))
            raise
    
        logger.debug('directory listing:\n%s' % result[0])
        if pipe.returncode == 0:
            oidseghash = {}
            for line in result[0].split('\n'):
                l = line.split('=')
                if len(l) == 2:
                    if l[0].isdigit() and l[1].isdigit():
                        segid = int(l[0])
                        oid = int(l[1])
                        if oidseghash.get(segid) == None:
                            oidseghash[segid] = {}

                        oidseghash[segid][oid] = True

            for seg in self.segs:
                segid = seg['dbid']
                if not oidseghash.get(segid):
                    for oid, row in oidsbyseg[segid]:
                        self.badinds.append(row)
                    break
                  
                for oid, row in oidsbyseg[segid].iteritems():
                    oid = int(oid)
                    logger.debug('Checking index oid %s' % oid)
                    if not oidseghash[segid].get(oid):
                        self.badinds.append(row)
                        logger.debug('Could not find index with relfilenode %s' % oid)

        else:
            # XXX: fix to set all indexes bad
            for segid in oidsbyseg:
                for oid, row in oidsbyseg[segid]:
                    self.badinds.append(row)
            pass


def checkBitmapIndexes():
    logger.info('-----------------------------------')
    logger.info('Checking bitmap indexes')

    db = connect2(GV.cfg[1])
    curs = db.query('''
    select d.oid as dboid, nspname, relname, relfilenode from 
    pg_class c, pg_index i, pg_namespace n, pg_am a,
    pg_database d where c.relam = a.oid and 
    a.amname = 'bitmap' and i.indexrelid = c.oid and c.relnamespace = n.oid
    and d.datname = current_database();
            ''')
    if curs.ntuples() == 0:
        logger.info('[OK] no bitmaps to check')
        return

    # same path as gpinitsystem
    path = '/usr/kerberos/bin:/usr/sfw/bin:/opt/sfw/bin'
    path += ':/usr/local/bin:/bin:/usr/bin:/sbin:/usr/sbin:/usr/ucb'
    path += ':/sw/bin'
    env = {'PATH': path, 'LOGNAME': GV.user, 'USER': GV.user,
           'HOME': GV.home}
    ssh = os.environ.get('SSH_AUTH_SOCK')
    if ssh:
        env['SSH_AUTH_SOCK'] = ssh

    reindex = []
    threads = []
    mod = GV.opt['-B'] / 4
    if mod == 0:
        mod = 1

    badinds = []

    hostsegmap = {}
    for segid in GV.cfg:
        seg = GV.cfg[segid]
        if not hostsegmap.get(seg['hostname']):
            hostsegmap[seg['hostname']] = []

        hostsegmap[seg['hostname']].append(seg)

    for host in hostsegmap.keys():
        segs = hostsegmap[host]
        # supply just the relfilenodes, not the full mapping
        thread = fileCheckThread(host, segs, env)
        thread.start()
        threads.append(thread)

        if (len(threads) % mod) == 0:
            for th in threads:
                logger.debug('waiting on thread %s' % th.getName())
                th.join()
                badinds += th.badinds

            threads = []

    # stragglers 
    for th in threads:
        logger.debug('waiting on thread %s' % 
                       th.getName())
        th.join()
        badinds += th.badinds

    threads = []

    if badinds:
        GV.retcode = 1
        # unique
        reindex = []

        for row in badinds:
            reindex.append(row['nspname'] + '.' + row['relname'])

        a = list(set(reindex))
        logger.info('[ERROR] %d bitmap issue(s)' % len(a))
        for index in a:
            logger.info('[ERROR] %s' % index)
            Reindex.append(index)

    else:
        logger.info('[OK] bitmap indexes')

def fixupowners(nspname, relname, rolename):
    Owners.append('ALTER TABLE "%s"."%s" OWNER TO "%s";' % (nspname, relname,
                                                           rolename))

def checkOwners():

    logger.info('-----------------------------------')
    logger.info('Checking table ownership')
    if GV.version < "3.3":
        logger.info('Skipping...')
        return

    db = connect2(GV.cfg[1], utilityMode=False)
    qry = '''
    select distinct n.nspname, c.relname, a.rolname from
    gp_dist_random('pg_class') r, pg_class c, pg_namespace n, pg_authid a where
    r.oid = c.oid and r.relowner <> c.relowner and c.relnamespace = n.oid and
    c.relowner = a.oid;
    '''
    curs = db.query(qry)

    rows = []
    for row in curs.dictresult():
        rows.append(row)

    if len(rows) == 0:
        logger.info('[OK] table ownership')
    else:
        GV.retcode = 1
        logger.info('[ERROR] there are %d ownership issue(s)' % len(rows))
        logger.info('[ERROR] %s' % qry)
        for row in rows:
            logger.info('[ERROR] %s %s %s'
                % (row['nspname'], row['relname'], row['rolname']))
            fixupowners(row['nspname'], row['relname'], row['rolname'])

def closeDbs():
    for key, conns in GV.db.iteritems():
        db = conns[0]
        db.close()

