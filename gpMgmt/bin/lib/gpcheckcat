def checkFKConstraint(db, tables, max_content):
    logger.info('-----------------------------------')
    logger.info('Checking foreign keys ...')
    
    qtempl = '''
    SELECT cat1.gp_segment_id, {cat1_dot_primary_key}, cat1.{FK1}
    FROM
    gp_dist_random('{CATALOG1}') cat1 LEFT OUTER JOIN
    gp_dist_random('{CATALOG2}') cat2
    ON (cat1.gp_segment_id = cat2.gp_segment_id AND
        cat1.{FK1} = cat2.{PK2} )
    WHERE cat2.{PK2} is NULL
    AND cat1.{FK1} != 0
    UNION ALL
    SELECT -1 as gp_segment_id, {cat1_dot_primary_key}, cat1.{FK1}
    FROM
    {CATALOG1} cat1 LEFT OUTER JOIN
    {CATALOG2} cat2
    ON (cat1.gp_segment_id = cat2.gp_segment_id AND
        cat1.{FK1} = cat2.{PK2} )
    WHERE cat2.{PK2} is NULL
    AND cat1.{FK1} != 0
    ORDER BY {primary_key_alias}, gp_segment_id
    '''

    tidx   = 0
    tblcnt = 0
    qrycnt = 0

    fktables = []
    badfktables = {}
    badpktables = {}
    dtab = {}

    for cat in tables:
        catname = cat.getTableName()
        fkey    = cat.getForeignKeys()
        dtab[catname] = tidx
        tidx += 1

        # skip tables without fkey
        if len(fkey) <= 0:
            continue;
        fktables.append(cat)

        tblcnt += 1
        qrycnt += len(fkey)

    logger.info(' %d tables, %d queries' % (tblcnt, qrycnt))
        
    for tab in sorted(fktables):
        fkeylist = tab.getForeignKeys()
        tname    = tab.getTableName()

        # primary key lists
        cat1pkeys = []
        pkeys     = []
        aliasidx  = 1;
        
        # build array of catalog primary keys (with aliases) and
        # primary key alias list
        for pk in tab.getPrimaryKey():
            cat1pkeys.append('cat1.' + pk + ' as PK%s'%aliasidx+'_'+pk)
            pkeys.append('PK%s'%aliasidx+'_'+pk)
            aliasidx += 1

        for fkeydef in fkeylist:
            fkeystr     = ', '.join(fkeydef.getColumns())
            cat1fkeystr = 'cat1.' + ', cat1.'.join(fkeydef.getColumns())
            
            pkeytabname = fkeydef.getPkeyTableName()

            qry = qtempl.format(cat1_dot_primary_key = ', '.join(cat1pkeys) ,
                                primary_key_alias    = ', '.join(pkeys),
                                FK1      = fkeystr,
                                CATALOG1 = tname,
                                CATALOG2 = pkeytabname,
                                PK2      = ', '.join(fkeydef.getPKey())
                                )
                                
            # Execute the query
            try:
                curs  = db.query(qry)
                nrows = curs.ntuples()
        
                if nrows == 0:
                    logger.info('[OK] Foreign key check for %s(%s)'%
                                (tname, fkeystr))
                else:
                    logger.info('[FAIL] Foreign key check for %s(%s)'%
                                (tname, fkeystr))
                    logger.error('  %s has %d issue(s)' % (tname, nrows))
                    if tname not in badfktables:
                        badfktables[tname] = []
                    if pkeytabname not in badpktables:
                        badpktables[pkeytabname] = []
                    # TODO: smarter handling of output
                    #   - Improved reporting when all segments are different 
                    #     from master
                    #   - Improved identification of what the difference is
                    #   - Dumping to a file when there is too much data
                    #   - Don't use "print"
                    fields = curs.listfields()
                    print "    " + " | ".join(fields)
                    for row in curs.getresult():
                        print "    " + " | ".join(map(str, row))
                    #
                    def1           = {}
                    def1["fk"]     = fkeydef
                    def1["qry"]    = qry
                    def1["fields"] = fields
                    def1["rows"]   = curs.getresult()
                    
                    badfktables[tname].append(def1)
                    badpktables[pkeytabname].append(tname)
        
            except Exception, e:
                logger.info('[FAIL] Foreign key check for ' + tname)
                logger.error('  Execution error: ' + str(e))
                logger.error(qry)

    # attempt to construct sql to resynchronize foreign key entries on
    # segments
    BuildFKResync(db, dtab, tables, badfktables, badpktables, max_content)


