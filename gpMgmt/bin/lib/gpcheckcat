# Cross consistency check for each catalog table
def checkTableCrossConsistency(cat):
    
    catname  = cat.getTableName()
    pkey     = cat.getPrimaryKey()
    master   = cat.isMasterOnly()
    isShared = cat.isShared()
    columns  = cat.getTableColumns(with_acl=False)

    # Skip master only tables
    if master:
        return

    # skip shared/non-shared tables
    if GV.opt['-S']:
        if re.match("none", GV.opt['-S'], re.I) and isShared:
            return
        if re.match("only", GV.opt['-S'], re.I) and not isShared:
            return

    # Skip catalogs without primary key
    if pkey == []:
        logger.warn("[WARN] Skipped cross consistency check for %s" %
                    catname)
        return

    qry = crossDbquery(GV.max_content, catname, pkey, columns)

    # Execute the query
    try:
        db = connect2(GV.cfg[1], utilityMode=False)
        curs  = db.query(qry)
        nrows = curs.ntuples()

        if nrows == 0:
            logger.info('[OK] Cross consistency check for ' + catname)
        else:
            setError(ERROR_NOREPAIR)
            logger.info('[FAIL] Cross consistency check for ' + catname)
            logger.error('  %s has %d issue(s)' % (catname, nrows))
            # logger.error(qry)

            # TODO: smarter handling of output
            #   - Improved reporting when all segments are different 
            #     from master
            #   - Improved identification of what the difference is
            #   - Dumping to a file when there is too much data
            #   - Don't use "print"
            fields = curs.listfields()
            print "    " + " | ".join(fields)
            for row in curs.getresult():
                print "    " + " | ".join(map(str, row))

    except Exception, e:
        setError(ERROR_NOREPAIR)
        logger.info('[FAIL] Cross consistency check for ' + catname)
        logger.error('  Execution error: ' + str(e))
        logger.error(qry)


#-------------------------------------------------------------------------------
def crossDbquery(max_content, catname, pkey, columns):

        # Build up the query based on catalog definition
        pkey      = ', '.join(pkey)
        catcols   = 'c.' + ', c.'.join(columns)

        # MPP-10286 - oid inconsistencies for temp schemas
        #
        # Due to oid differences for temp schemas the query would show
        # relnamespace and typnamespace differences for any table defined
        # in a temporary schema.  For the purposes of this consistency
        # test we hack around this right now by joining to pg_namespace
        # and eliminating temporary schemas.
        if catname == 'pg_class':
            temp_schema_hack_1 = """
            JOIN gp_dist_random('pg_namespace') as n
              ON (c.relnamespace = n.oid and n.nspname !~ '^pg_temp_' and
                  c.gp_segment_id = n.gp_segment_id)
            """
            temp_schema_hack_2 = """
            JOIN pg_namespace as n
              ON (c.relnamespace = n.oid and n.nspname !~ '^pg_temp_')
            """
        elif catname == 'pg_type':
            temp_schema_hack_1 = """
            JOIN gp_dist_random('pg_namespace') as n
              ON (c.typnamespace = n.oid and n.nspname !~ '^pg_temp_' and
                  c.gp_segment_id = n.gp_segment_id)
            """
            temp_schema_hack_2 = """
            JOIN pg_namespace as n
              ON (c.typnamespace = n.oid and n.nspname !~ '^pg_temp_')
            """
        else:
            temp_schema_hack_1 = ""
            temp_schema_hack_2 = ""


        # Construct the query
        # 
        # Basic idea of the query is:
        #   SELECT (all rows on segments different from master)
        #   UNION ALL
        #   SELECT (all rows on master different from segments)
        qry = """
        SELECT * FROM (
            SELECT c.gp_segment_id, {columns}
            FROM   gp_dist_random('{catalog}') as c {schema_join_1}
            WHERE  ({primary_key}) in (
               SELECT {primary_key} FROM (
                   select c.gp_segment_id, {columns}
                   from   gp_dist_random('{catalog}') as c
                   except all 
                   select segid as gp_segment_id, {columns}
                   from   {catalog} as c, 
                          generate_series(0,{max_content}) as segid
               ) segments
            )
        ) x
        UNION ALL
        SELECT * FROM (
            select c.gp_segment_id, {columns}
            from   {catalog} as c {schema_join_2}
            where ({primary_key}) in (
               SELECT {primary_key} FROM (
                   select segid as gp_segment_id, {columns}
                   from   {catalog} as c, 
                          generate_series(0,{max_content}) as segid
                   except all 
                   select c.gp_segment_id, {columns}
                   from   gp_dist_random('{catalog}') as c
               ) master
            )
        ) y
        order by {primary_key}, gp_segment_id
        """.format(max_content = max_content,
                   catalog     = catname,
                   primary_key = pkey,
                   columns     = catcols,
                   schema_join_1 = temp_schema_hack_1,
                   schema_join_2 = temp_schema_hack_2)

        return qry



