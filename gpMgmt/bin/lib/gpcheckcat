def getversion():
    versions = ["3.1", "3.2", "3.3", "3.4", "main"]
    db = connect()
    curs = db.query('''
    select regexp_replace(version(), 
       E'.*PostgreSQL [^ ]+ .Greenplum Database ([1-9]+.[0-9]+|main).*', 
       E'\\\\1') as ver;''')

    row = curs.getresult()[0]
    version = row[0]

    logger.debug('got version %s' % version)
    if not (version in versions):
        usage('Error: only Greenplum database 3.1, 3.2, 3.3 and 3.4 are supported')

    return version


