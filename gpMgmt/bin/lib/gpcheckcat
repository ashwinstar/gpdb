def getGPConfiguration():
    cfg = {}
    db = connect()
    db.execute("select * from gp_configuration")
    for row in db.iterate_dict():
        if row['content'] == -1 and not row['isprimary']:
            continue    # skip standby master
        cfg[row['dbid']] = row
    db.close()
    return cfg

