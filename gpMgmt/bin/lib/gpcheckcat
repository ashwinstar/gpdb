def removeAppendOnly(seg, db, reloid, rel):
    # see if table has appendonly subtables and if so, remove them
    qry = """
      SELECT relid, segrelid, segidxid
      FROM pg_appendonly
      WHERE relid = %i
    """ % reloid
    curs = db.query(qry)
    if curs.ntuples() == 0:
        return
    for row in curs.dictresult():
        if row['segrelid'] != 0:
            removeTable(seg, db, row['segrelid'])
        if row['segidxid'] != 0:
            removeTable(seg, db, row['segidxid'])
    
    buildRemove(seg, 'append only subtables', 'pg_appendonly',
                {'relid': reloid}, rel)


def removeDepend(seg, db, reloid, rel):
    buildRemove(seg, 'dependencies', 'pg_depend',
                {'objid': reloid, 'refobjid': reloid}, rel)
    buildRemove(seg, 'shared dependencies', 'pg_shdepend',
                {'objid': reloid, 'refobjid': reloid}, rel)

def buildRemove(seg, name, table, cols, objname):
    first = False
