                sys.exit(1)

            #unique
            lines = set(Remove[seg])

            # make sure it is sorted
            li = list(lines)
            li.sort()
            file.write('BEGIN;\n');
            for line in li:
                file.write(line + '\n')
            file.write('COMMIT;\n');

            file.close()

            script += 'echo "Repairing segment %i"\n' % seg
            script += 'env PGOPTIONS="-c gp_session_role=utility" ' + \
                    'psql -X -a -h %s -p %i -f %s "%s" > %s.out\n' % \
