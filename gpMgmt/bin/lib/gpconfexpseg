#!/usr/bin/env python

import sys
import os
from optparse import Option, OptionGroup, OptionParser, OptionValueError, SUPPRESS_USAGE

from gppylib.gpparseopts import OptParser, OptChecker
from gppylib.commands.gp import ModifyPostgresqlConfSetting, SegmentStart, SegmentStop, SegmentToStart
from gppylib.db import dbconn
from gppylib.db import catalog
from gppylib.commands import unix
from gppylib.commands.pg import DbStatus
from gppylib import gplog
from gppylib.commands.base import *
from time import sleep

description = (""" 
Adds additional segments to a pre-existing GPDB Array.
""")

DEFAULT_BATCH_SIZE=8
ADDITIONAL_PG_CTL_WAIT=60

EXECNAME = os.path.split(__file__)[-1]

class ConfExpSegCmd(Command):
    def __init__(self, name, cmdstr, datadir, port, numsegs, 
                 content, dbid, newseg, tarfile, verbose=False):
        self.datadir = datadir
        self.port = int(port)
        self.numsegs = int(numsegs)
        self.content = int(content)
        self.dbid = int(dbid)
        self.newseg = newseg
        self.tarfile = tarfile
        self.verbose = verbose
        Command.__init__(self, name, cmdstr)
        
        
    def __str__(self):
        if self.results:
            return "%s cmdStr='%s'  had result: %s" % (self.name,self.cmdStr,self.results)
        else:
            return "%s cmdStr='%s'" % (self.name,self.cmdStr)
        
    def run(self):
        try:
            # update postgresql.conf
            if self.newseg:
                try:
                    if os.path.exists(self.datadir):
                        #it better be empty
                        if len(os.listdir(self.datadir)) == 0:
                            os.chmod(self.datadir,0700)
                        else:
                            raise Exception('Segment directory %s exists but is not empty!' % self.datadir)
                    else:
                        os.mkdir(self.datadir,0700)
                except Exception, e:
                    self.set_results(CommandResult(1,'',e,True,False))
                    raise
        
                logger.info("extract tar file to new segment")    
                extractTarCmd = unix.ExtractTar('extract tar file to new segment', self.tarfile, self.datadir )
                try:
                    logger.debug('Extracting tar file %s to %s' % (self.tarfile, self.datadir))
                    extractTarCmd.run(validateAfter=True)
                except:
                    self.set_results(extractTarCmd.get_results())
                    logger.error(extractTarCmd.get_results())
                    raise
        
        
                logger.info("Updating %s/postgresql.conf" % self.datadir)
                modifyPostgresqlConfCmd = ModifyPostgresqlConfSetting('Updating %s/postgresql.conf' % self.datadir,
                                                                      self.datadir + '/postgresql.conf',
                                                                      'port', self.port, optType='number')
                try:
                    modifyPostgresqlConfCmd.run(validateAfter=True)
                except:
                    self.set_results(modifyPostgresqlConfCmd.get_results())
                    raise
    
            # We might need to stop the segment if the last setup failed past this point
            if os.path.exists('%s/postmaster.pid' % self.datadir):
                logger.info('%s/postmaster.pid exists.  Stopping segment' % self.datadir)
                stopCmd = SegmentStop('Stop expansion segment', self.datadir)
                try:
                    stopCmd.run(validateAfter=True)
                except:
                    pass
                    
            # start up segment in utility
            logger.info("starting expansion segment (datadir: %s, port: %s)" % (self.datadir, self.port))

            # use dummy values for dbid, contentid, and numSegmentsInCluster since we are connecting in utility mode
            # SegmentToStart takes dataDir, port, dbId, contentId, numContentsInCluster, mirroringMode, noWait
            segmentToStart = SegmentToStart(self.datadir, self.port, -1, -1, 0, "mirrorless", false)
            startCmd = SegmentStart('Start expansion segment', segmentToStart, utilityMode=True)
            try:
                startCmd.run(validateAfter=True)
            except:
                seg_started = False
                if startCmd.get_results().stdout.find('Failed to test postmaster connection') != -1:
                    # If there are a lot of segments, the start can take longer than pg_ctl 
                    # wait of 60 seconds.  So we'll loop a few times and check...
                    logger.info('Waiting additional time for segment to start...')
                    class FakeDB:
                        def __init__(self, datadir):
                            self.datadir = datadir
                            
                    db = FakeDB(self.datadir)
                    for i in range(1,ADDITIONAL_PG_CTL_WAIT):
                        logger.debug('Waiting for segment to start...')
                        if DbStatus.local('gpconfexpseg db status check', db):
                            seg_started = True 
                            break
                        sleep(1)
                    
                if not seg_started:    
                    self.set_results(startCmd.get_results())
                    logger.error(startCmd.get_results())
                    raise
            
            # update gp_id
            dbUrl = dbconn.DbURL(hostname='127.0.0.1', port=self.port,dbname='template1')
            conn = dbconn.connect(dbUrl, utility=True)
            
            gpid_tbl = catalog.GpIdTable(conn)
            gpid_tbl.set(dbid=self.dbid,content=int(self.content),numsegments=self.numsegs)
            dbconn.execSQL(conn,gpid_tbl.get_update_sql())
            
            conn.commit()
            conn.close()

            # stop segment
            logger.info("stopping expansion segment")
            stopCmd = SegmentStop('Stop expansion segment', self.datadir)
            
            try:
                stopCmd.run(validateAfter=True)
            except:
                self.set_results(stopCmd.get_results())
                logger.error(stopCmd.get_results())
                raise
        except Exception, e:
            if self.verbose:
                logger.exception(e)
            return
        else:
            self.set_results(CommandResult(0,'','',True,False))

    def set_results(self,results):
        self.results=results
        
    def get_results(self):
        return self.results

    def cancel(self):
        self.exec_context.cancel()    
    
    def interrupt(self):
        self.exec_context.interrupt()
    
    def was_successful(self):
        if self.results is None:
            return False
        else:
            return self.results.wasSuccessful()
    
        
    def validate(self):
        """Plain vanilla validation which expects a 0 return code."""        
        if self.results.rc != 0:
            raise ExecutionError("non-zero rc: %d" % self.results.rc, self)  

def parseargs():
    parser = OptParser(option_class=OptChecker,
                description=' '.join(description.split()),
                version='%prog version $Revision: $')
    parser.set_usage('%prog is a utility script used by gpexpand and not intended to be run separately.')
    parser.remove_option('-h')
    
    parser.add_option('-v','--verbose', action='store_true',help='debug output.')
    parser.add_option('-c', '--confinfo', type='string')                        
    parser.add_option('-t', '--tarfile', type='string')
    parser.add_option('-n', '--newsegments', action='store_true')
    parser.add_option('-B', '--batch-size', type='int', default=DEFAULT_BATCH_SIZE, metavar='<batch_size>')  
        
    parser.set_defaults(verbose=False,filters=[], slice=(None, None))
    
    # Parse the command line arguments
    (options, args) = parser.parse_args()

    if not options.confinfo:
        raise Exception('Missing --confinfo argument.')

    if options.batch_size <= 0:
        logger.warn('batch_size was less than zero.  Setting to 1.')
        batch_size = 1

    if options.newsegments and not options.tarfile:
        raise Exception('-n option requires -t option to be specified')

    seg_info = []
    conf_lines = options.confinfo.split(',')
    for line in conf_lines:
        conf_vals = line.split(':')
        if len(conf_vals) != 5:
            raise Exception('Invalid configuration value: %s' % conf_vals)
        if conf_vals[0] == '':
            raise Exception('Missing data directory in: %s' % conf_vals)
        if conf_vals[1] < 1024:
            raise Exception('Invalid port in: %s' % conf_vals)
        if conf_vals[2] <= 0:
            raise Exception('Invalid number of segments in: %s' % conf_vals)
        if conf_vals[3] < 0:
            raise Exception('Invalid content id in: %s' % conf_vals)
        if conf_vals[4] <= 0:
            raise Exception('Invalid dbid in: %s' % conf_vals)
        seg_info.append(conf_vals)

    seg_info_len = len(seg_info)
    if seg_info_len == 0:
        raise Exception('No segment configuration values found in --confinfo argument')
    elif seg_info_len < options.batch_size:
        # no need to have more threads than segments
        options.batch_size = seg_info_len

    return options, args, seg_info


try:
    logger=gplog.setup_tool_logging(EXECNAME,unix.getLocalHostname(),unix.getUserName())

    (options, args, seg_info) = parseargs()
    if options.verbose:
        gplog.enable_verbose_logging()
        
    logger.info("Starting gpconfexpseg with args: %s" % ' '.join(sys.argv[1:]))
    
    pool = WorkerPool(numWorkers=options.batch_size)
    
    for seg in seg_info:
        cmd = ConfExpSegCmd('Configure expansion segment', ' '.join(sys.argv), seg[0], seg[1], seg[2], seg[3], 
                            seg[4], options.newsegments, options.tarfile,
                            options.verbose)
        pool.addCommand(cmd)

    pool.join()

    try:
        pool.check_results()
    except Exception,e:
        if options.verbose:
            logger.exception(e)
        logger.error(e)
        print >> sys.stderr, e
        sys.exit(1)

    sys.exit(0)

except Exception, msg:
    logger.error(msg)
    print >> sys.stderr, msg
    sys.exit(1)
