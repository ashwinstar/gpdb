description = (""" 
Adds additional segments to a pre-existing GPDB Array.
""")

EXECNAME = os.path.split(__file__)[-1]

def parseargs():
    parser = OptParser(option_class=OptChecker,
                description=' '.join(description.split()),
                version='%prog version $Revision: $')
    parser.set_usage('%prog is a utility script used by gpexpand and not intended to be run separately.')
    parser.remove_option('-h')
    
    parser.add_option('-p','--port', type='int')
    parser.add_option('-d', '--datadir', type='string')                        
    parser.add_option('-s','--numsegs', type='int')
    parser.add_option('-c', '--content', type='int')
    parser.add_option('-i', '--dbid', type='int')
    parser.add_option('-n', '--newsegment', action='store_true')
    parser.add_option('-t', '--tarfile', type='string')
  
        
    parser.set_defaults(verbose=False,filters=[], slice=(None, None))
    
    
    # Parse the command line arguments
    (options, args) = parser.parse_args()
    
    #-n sanity check
    if options.numsegs <= 0:
        raise Exception("Invalid numsegs arg: '%s'" % options.numsegs)
        
    if options.content < 0:
        raise Exception('Invalid contentid arg')
        
    if options.dbid <= 0:
        raise Exception('Invalid dbid arg')

    if options.port and options.port < 1024:
        raise Exception('Invalid port arg')

    if not options.datadir:
        raise Exception('Invalid datadir arg')
    
    if options.newsegment and not options.tarfile:
        raise Exception('-t must be specified if -n is used')

    return options, args


