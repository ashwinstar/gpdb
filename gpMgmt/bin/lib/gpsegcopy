# CopyFilter class
class CopyFilter:
    def __init__(self, param, empty_index):
        self.param = param
        self.src_host = self.param['src_host']
        self.src_dir = self.param['src_dir']
        self.dst_host = self.param['dst_host']
        self.dst_dir = self.param['dst_dir']
        self.filter = self.param['filter']
        self.empty_index = empty_index

    def touch_filter(self, oid, files):
        if len(files) == 0:
            return
        dst_path =  os.path.join(self.dst_dir, 'base', str(oid))
        filelist = ' '.join([ str(f) for f in files ])
        gpmlib.log_info('cd %s && touch %s' % (dst_path, filelist))
        (ok, out) = gpmlib.run_warn('%s "cd %s && touch %s"' % (gplib.ssh_prefix(self.dst_host),
                                                                dst_path, filelist))
        if not ok:
            gpmlib.fatal('failed to touch files %s' % filelist)

    def table_filter(self, oid, files):
        self.touch_filter(oid, files)

    def index_filter(self, oid, files):
        if len(files) == 0:
            return

        param = {}
        param['dst_dir'] = os.path.join(self.dst_dir, 'base', str(oid))
        param['indexes'] = files
        paramSource = cPickle.dumps(param)
        cmd = gpmlib.makeCommand('''python -u -c '%s' >> %s 2>&1'''% (bootstrapSource, logfile))
        cmd = '''bash -c "%s"''' % cmd

        args = []
        args.append('ssh')
        args.append(self.dst_host)
        args.append(cmd)
        p = None
        try:
            p = subprocess.Popen(args, stdin=subprocess.PIPE)
            p.stdin.write('%s\\n%s' % (len(gpcopyIndexSource), gpcopyIndexSource))
            p.stdin.write('%s\\n%s' % (len(paramSource), paramSource))
            p.stdin.write('%s\\n%s' % (len(self.empty_index), empty_index))

            e = p.wait()
            if e != 0:
                gpmlib.log_fatal('Copy Index Failed')
                gpmlib.log_fatal('Exit status: %s' % e)
                sys.exit(e)

        except OSError, e:
            gpmlib.log_fatal(str(e))
        finally:
            try:
                if p: 
                    os.kill(p.pid, 9)
            except:
                pass



    def sequence_filter(self, oid, files):
        self.touch_filter(oid, files)

    def toast_filter(self, oid, files):
        self.touch_filter(oid, files)

    def run(self):
        for (oid, table, toast, sequence, index) in self.filter:
            path = os.path.join(self.src_dir, 'base', str(oid))
            dst_path =  os.path.join(self.dst_dir, 'base', str(oid))

            table_oids = []
            index_oids = []
            sequence_oids = []
            toast_oids = []
            
            for root, dirs, files in os.walk(path):
                for f in files:
                    try:
                        foid = int(f)
                        if foid in table:
                            table_oids.append(foid)
                        elif foid in toast:
                            toast_oids.append(foid)
                        elif foid in sequence:
                            sequence_oids.append(foid)
                        elif foid in index:
                            index_oids.append(foid)
                        else:
                            pass
                    except:
                        pass

            exclude = []
            exclude.extend(table_oids)
            exclude.extend(index_oids)
            exclude.extend(toast_oids)
            exclude.extend(sequence_oids)

            xopt = ''
            if len(exclude) > 0:
                xopt = '-x ' + ' -x '.join([ str(r) for r in exclude ])
            
            (ok, out) = gpmlib.run_warn('%s mkdir %s' % (gplib.ssh_prefix(self.dst_host), dst_path))
            if not ok:
                gpmlib.fatal('failed to make directory %s on remote host %s' % (dst_path, self.dst_host))

            cmd = gpmlib.makeCommand('%s -v --delete %s %s %s:%s' % (os.path.join(os.environ['GPHOME'], 'bin/lib/pysync.py'),
                                                                     xopt,
                                                                     path,
                                                                     self.dst_host,
                                                                     dst_path))
            
            gpmlib.log_info(cmd)
            
            (ok, out) = gpmlib.run_warn('%s >> %s 2>&1' % (cmd, logfile))
            if not ok:
                gpmlib.fatal('failed to copy segment')

            self.table_filter(oid, table_oids)
            self.toast_filter(oid, toast_oids)
            self.sequence_filter(oid, sequence_oids)
            self.index_filter(oid, index_oids)


