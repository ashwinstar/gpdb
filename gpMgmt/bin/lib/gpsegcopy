gpcopySource="""
from __future__ import with_statement
import os, sys, getopt, cPickle, subprocess
from datetime import date, datetime
sys.path.append(os.path.join(os.getenv('GPHOME'), 'bin/lib'))
try:
    import pg8000
    import gplib
    import gpmlib
    from gpmlib import ENV
except ImportError, e:
    gpmlib.error('Unable to import module: ' + str(e))

logdir = os.path.join(os.environ.get('HOME'), 'gpAdminLogs')
if not gpmlib.directory_exists(logdir):
    try:
        os.mkdir(logdir)
    except OSError, e:
        gpmlib.error('Make directory %s error' % logdir)

logfile = os.path.join(logdir, '%s_%s.log' % ('gpsegcopy', date.today().strftime('%Y%m%d')))
gpmlib.log_set_file(logfile)


# CopyFilter class
class CopyFilter:
    def __init__(self, param):
        self.param = param
        self.src_host = self.param['src_host']
        self.src_dir = self.param['src_dir']
        self.dst_host = self.param['dst_host']
        self.dst_dir = self.param['dst_dir']
        self.filter = self.param['filter']

    def touch_filter(self, oid, files):
        if len(files) == 0:
            return
        dst_path =  os.path.join(self.dst_dir, 'base', str(oid))
        filelist = ' '.join([ str(f) for f in files ])
        gpmlib.log_info('cd %s && touch %s' % (dst_path, filelist))
        (ok, out) = gpmlib.run_warn('%s "cd %s && touch %s"' % (gplib.ssh_prefix(self.dst_host),
                                                                dst_path, filelist))
        if not ok:
            gpmlib.fatal('failed to touch files %s' % filelist)

    def table_filter(self, oid, files):
        self.touch_filter(oid, files)

    def index_filter(self, oid, files):
        for f in files:
            print 'index_filter %s' %  os.path.join(self.src_dir, 'base', str(oid), str(f))

    def sequence_filter(self, oid, files):
        self.touch_filter(oid, files)

    def toast_filter(self, oid, files):
        self.touch_filter(oid, files)

    def run(self):
        for (oid, table, toast, sequence, index) in self.filter:
            path = os.path.join(self.src_dir, 'base', str(oid))
            dst_path =  os.path.join(self.dst_dir, 'base', str(oid))

            table_oids = []
            index_oids = []
            sequence_oids = []
            toast_oids = []
            
            for root, dirs, files in os.walk(path):
                for f in files:
                    try:
                        foid = int(f)
                        if foid in table:
                            table_oids.append(foid)
                        elif foid in toast:
                            toast_oids.append(foid)
                        elif foid in sequence:
                            sequence_oids.append(foid)
                        elif foid in index:
                            index_oids.append(foid)
                        else:
                            pass
                    except:
                        pass

            exclude = []
            exclude.extend(table_oids)
            exclude.extend(index_oids)
            exclude.extend(toast_oids)
            exclude.extend(sequence_oids)

            xopt = ''
            if len(exclude) > 0:
                xopt = '-x ' + ' -x '.join([ str(r) for r in exclude ])
            
            (ok, out) = gpmlib.run_warn('%s mkdir %s' % (gplib.ssh_prefix(self.dst_host), dst_path))
            if not ok:
                gpmlib.fatal('failed to make directory %s on remote host %s' % (dst_path, self.dst_host))

            cmd = gpmlib.makeCommand('%s -v --delete %s %s %s:%s' % (os.path.join(os.environ['GPHOME'], 'bin/lib/pysync.py'),
                                                                     xopt,
                                                                     path,
                                                                     self.dst_host,
                                                                     dst_path))
            
            gpmlib.log_info(cmd)
            
            (ok, out) = gpmlib.run_warn('%s >> %s 2>&1' % (cmd, logfile))
            if not ok:
                gpmlib.fatal('failed to copy segment')

            self.table_filter(oid, table_oids)
            self.index_filter(oid, index_oids)
            self.toast_filter(oid, toast_oids)
            self.sequence_filter(oid, sequence_oids)


try:
    param = cPickle.loads(sys.stdin.read(int(sys.stdin.readline())))

    # check segment is still running
    cmd = gpmlib.makeCommand('%s %s' % (os.path.join(os.environ['GPHOME'], 'bin/pg_controldata'),
                                           param['src_dir']))
    (ok, out) = gpmlib.run_warn(cmd)
    if not ok:
        gpmlib.fatal('failed to run pg_controldata')

    for line in out:
        if line.startswith('Database cluster state:') and line.find('shut down') == -1:
            gpmlib.fatal('Unable to copy segment data directory.  Segment %s:%s is running' % (param['src_host'], param['src_dir']))

    # copy segment except base directory
    xopt = ''
    if len(param['filter']) > 0:
        xopt = '-x ' + ' -x '.join([ 'base/%d' % r[0] for r in param['filter'] ])

    cmd = gpmlib.makeCommand('%s -v --delete %s %s %s:%s' % (os.path.join(os.environ['GPHOME'], 'bin/lib/pysync.py'),
                                                                  xopt,
                                                                  param['src_dir'],
                                                                  param['dst_host'],
                                                                  param['dst_dir']))
    gpmlib.log_info(cmd)
    
    (ok, out) = gpmlib.run_warn('%s >> %s 2>&1' % (cmd, logfile))
    if not ok:
        gpmlib.fatal('failed to copy segment')

    # filtering
    f = CopyFilter(param)
    f.run()
except Exception, e:
    gpmlib.fatal(str(e))
    # remove dst directory


"""

script_name = os.path.split(__file__)[-1]
opt = {}
opt['-q'] = False
opt['-d'] = None
opt['-l'] = None

arg = {}
arg['exit'] = 0
arg['dst_host'] = None
arg['dst_dir'] = None

################
def usage(exitarg):
    print gplib.cli_help() or __doc__
    sys.exit(exitarg)

################
def print_version():
    print '%s version $Revision: #32 $' % script_name
    sys.exit(0)

################
def parseCommandLine():
    global opt
    try:
        (options, args) = getopt.getopt(sys.argv[1:], '?vql:d:', ['version'])
    except Exception, e:
        usage(str(e))

    for (switch, val) in options:
        if (switch == '-?'):          usage(0)
        elif (switch == '-v'):        print_version()
        elif (switch == '-q'):        opt[switch] = True
        elif (switch == '-l'):        opt[switch] = val
        elif (switch == '-d'):        opt[switch] = val

    if len(args) != 1:
        usage('please specify dst_host:dst_dir')

    dst = args[0].split(':')
    if len(dst) != 2:
        usage('please specify dst_host:dst_dir')

    arg['dst_host'] = dst[0]
    arg['dst_dir'] = dst[1]

    gpmlib.log_set_module(script_name)

    if opt['-q']:
        gpmlib.log_set_verbose(False)

    if opt['-l']:
        if not gpmlib.directory_exists(opt['-l']):
            gpmlib.error('Log directory %s does not exist' % opt['-l'])

        opt['-l'] = os.path.join(opt['-l'], '%s_%s.log' % (script_name, date.today().strftime('%Y%m%d')))
        gpmlib.log_set_file(opt['-l'])
    else:
        logdir = os.path.join(os.environ.get('HOME'), 'gpAdminLogs')
        if not gpmlib.directory_exists(logdir):
            try:
                os.mkdir(logdir)
            except OSError, e:
                gpmlib.error('Make directory %s error' % logdir)

        opt['-l'] = os.path.join(logdir, '%s_%s.log' % (script_name, date.today().strftime('%Y%m%d')))
        gpmlib.log_set_file(opt['-l'])

    if not opt['-d']:
        opt['-d'] = os.getenv('MASTER_DATA_DIRECTORY')
        if not opt['-d']:
            gpmlib.error('MASTER_DATA_DIRECTORY not set')
    else:
        os.environ['MASTER_DATA_DIRECTORY'] = opt['-d']

    if not os.path.isdir(opt['-d']):
        gpmlib.error('MASTER_DATA_DIRECTORY %s does not exist or is not a directory' % opt['-d'])



#####################
try:
    parseCommandLine()
    ENV.chk_environ()

    master_port = gpmlib.get_master_port(opt['-d'])

    # check passive standby
    if gpmlib.chk_on_passive_standby(master_port):
        gpmlib.fatal('Unable to process requested command')

    db = None
    src_host = None
    src_port = None
    src_dir  = None

    # connect to master QD in admin mode
    try:
        db = pg8000.Connection(host='localhost', port=master_port, 
        user=ENV.USER, database=ENV.DBNAME, 
        options='-c gp_session_role=utility')
        if db and gpmlib.chk_db_running(db, True):
            gpmlib.error('Database is running.  Please shutdown the database before running this script.')
    except pg8000.errors.InterfaceError, e:
        pass
    finally:
        if db:
            db.close()
            db = None
    
    try:
        # start master in admin mode
        e = os.system('gpstart -am %s -d %s' % (opt['-q'] and '-q' or '', os.environ.get('MASTER_DATA_DIRECTORY')))
        ok = not e
        if not ok:
            gpmlib.error('Start master in admin mode failed')


        db = pg8000.Connection(host='localhost', port=master_port, 
        user=ENV.USER, database=ENV.DBNAME, 
        options='-c gp_session_role=utility')
        db.execute('select hostname, datadir, port from gp_configuration where definedprimary=True and content=0')
        (src_host, src_dir, src_port) = db.read_tuple()
        db.close()
        db = None

        # get copy filters
        filters = gpmlib.get_copy_filter('localhost', master_port)

        # stop master in admin mode
        e = os.system('gpstop -am %s -d %s' % (opt['-q'] and '-q' or '', os.environ.get('MASTER_DATA_DIRECTORY')))
        ok = not e
        if not ok:
            gpmlib.error('Stop master in admin mode failed')

    except pg8000.errors.InterfaceError, e:
        gpmlib.error(e)
    except pg8000.errors.ProgrammingError, e:
        gpmlib.error(e)
    finally:
        if db:
            db.close()
            db = None

    # copy segment with filters
    param = {}
    param['src_host'] = src_host
    param['src_dir'] = src_dir
    param['src_port'] = src_port
    param['dst_host'] = arg['dst_host']
    param['dst_dir'] = arg['dst_dir']
    param['filter'] = filters
    paramSource = cPickle.dumps(param)
    cmd = gpmlib.makeCommand('''python -u -c '%s' >> %s 2>&1'''% (bootstrapSource, opt['-l']))
    cmd = '''bash -c "%s"''' % cmd

    args = []
    args.append('ssh')
    args.append(src_host)
    args.append(cmd)
    p = None
    try:
        p = subprocess.Popen(args, stdin=subprocess.PIPE, stdout=subprocess.PIPE)
        p.stdin.write('%s\n%s' % (len(gpcopySource), gpcopySource))
        p.stdin.write('%s\n%s' % (len(paramSource), paramSource))

        e = p.wait()
        if e != 0:
            gpmlib.log_fatal('Copy Segment Failed')
            gpmlib.log_fatal('Exit status: %s' % os.WEXITSTATUS(e))
            sys.exit(os.WEXITSTATUS(e))

    except OSError, e:
        print str(e)
    finally:
        try:
            if p: 
                os.kill(p.pid, 9)
        except:
            pass

except KeyboardInterrupt:
    sys.exit('\nUser Interrupted')
