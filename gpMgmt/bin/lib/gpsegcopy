#!/usr/bin/env python

'''
gpsegcopy

copy segment 0 data directory and filter out the data so that the target data directory contains the schema and empty tables

Usage: gpsegcopy [-v] [-?q] [-d master_data_directory] [-l log_dir] dst_host:dst_dir

          General options:
          -v        : print version information
          -?        : print this help screen
          
          Logging options:
          -q        : quiet mode, do not log process to screen 
          
          Config options:
          -d        : <master_data_directory> master data directory
'''

from __future__ import with_statement
import os, sys, getopt, cPickle, subprocess
from datetime import date, datetime
sys.path.append(sys.path[0] + '/lib')
try:
    import pg8000
    import gplib
    import gpmlib
    from gpmlib import ENV
except ImportError, e:
    gpmlib.error('Unable to import module: ' + str(e))

bootstrapSource='''
import os,sys
exec(sys.stdin.read(int(sys.stdin.readline())))
