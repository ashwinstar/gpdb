#!/usr/bin/env python

"""
groupSession -- ssh access to multiple hosts at once

Usage:
    groupSession <options> hostfile

hostfile - a list of remote hosts, each entry of the form:
    username@host
    username@host2
    ...
    userN@hostN
or just:
    host1
    host2
    ...
    hostN

Options:
-h,-?     Print usage summary and exit
-v        Report all commands sent to host and output received.
-p <port> Connect on a particular port in place of 22
-s        Disable the setup of trusted hosts key access
-l <fileName> Log all the messages to this file


Runs commands on a list of hosts.  Manages passwords and trusted key access
using ssh.

Author: Luke Lonergan <llonergan@greenplum.com>
"""

# $Id$

__all__ = ['runCommand', 'handlerTERM']

__author__ = "Luke Lonergan"
__version__ = "1.0"
__date__ = "2005-09-26"

import os, sys, threading, time, string, getpass, getopt, signal, commands
import traceback

if sys.version_info < (2, 3):
    print "Error groupSession is supported on Python versions 2.3 or greater."
    print "Please upgrade python installed on this machine."
    raise SystemExit, -1
#
# A tiny Kludge that will add '/lib' to the path
#
sys.path.append(sys.path[0]+'/lib')

try :
    import gpLogger
    import logging
    import groupSessionModule
    import paramiko
except ImportError, e:
    print "Error Importing necessary modules: %s " % str(e)
    raise SystemExit, -1


def usage(exitarg):
    print __doc__
    sys.exit(exitarg)

if __name__ == '__main__': 
    # Process options
    verbose = False
    debug   = False
    defaultport = 22
    setupKeys = True
    logFile=''
    logName='groupSession'

    (options, arguments) = getopt.getopt(sys.argv[1:], "?hvdp:l:sx")
    for (switch, val) in options:
        if (switch == '-p'):
            defaultport = val;
        elif (switch == '-x'):
	    sys.exit('Error: deprecated feature ... Please use gpssh-exkeys instead')
        elif (switch == '-s'):
            setupKeys = False 
        elif (switch == '-h' or switch == '-?'):
            print __doc__
            raise SystemExit, 0
        elif (switch == '-d'):
            debug = True
            verbose = True
        elif (switch == '-v'):
            verbose = True
        elif (switch == '-l'):
            logFile= val

    if not arguments:
        print "\nNo remote host list specified."
        print __doc__
        raise SystemExit, 0
    else:
        filename = arguments[0]

    try:
        hostFile=open(filename,'r')

    except IOError:
        print 'Error opening file named: ' + filename
        raise SystemExit, 1

    except:
        print 'Unexpected error:', sys.exc_info()[0]
        raise
    #
    # MPP-728
    # We don't have to worry about size of this file,
    # Truncated every new session.
    #
    try:
        execUser = os.environ.get('LOGNAME') or os.environ.get('USER')
        paramiko.util.log_to_file('/tmp/paramiko'+'_'+execUser+'.log') 
    except :
        print "Unexpected error: +'-'+execUser", sys.exc_info()[0]
        raise

    hostuserport = []
    for h in hostFile:
        #Strip out the hostname and user, if there is a user present in the 
        # record (e.g. user@host)
        host = h.strip()
        if host != '':
            if verbose:
                print 'Working on host: ' + host

            if '@' in host:
                (user, host) = string.split(host, '@')
            else:
                user = execUser

            if ':' in host:
                (host,port) = string.split(host, ':')
            else:
                port = defaultport

            hostuserport.append((host,user,port))

    hostFile.close()

    #Create a groupSession object
    gpLogger.initLogger(lName=logName, lfName=logFile, debug=debug, 
        verbose=verbose)
    gLogger=logging.getLogger(logName)
    try:
        gsession = groupSessionModule.groupSession(hostuserport, setupKeys, \
            verboseOpt=verbose)#, gLogger=gLogger)

        #Register a signal handler for the TERM signal
        signal.signal(signal.SIGTERM,gsession.handlerTERM)

        #Run commands
        gsession.cmdloop()
        print 'Done with group session.'
    except KeyboardInterrupt:
        print "Received KeyboardInterrupt"
        raise SystemExit, 1
    except Exception, e:
        errStr="*** Received Exception Error %s %s "% \
                (str(e.__class__),str(e))
        traceback.print_exc()
        print "Exiting.."
        raise SystemExit, 1
