#!/bin/bash
#       Filename:-		gpsizecalc
#       Version:-		$Revision$
#       Updated:-		$Date$
#       Status:-		Released
#       Author:-		G Coombe
#       Contact:-               gcoombe@greenplum.com
#       Release date:-          March 2006
#       Release stat:-          Greenplum Co internal
#                               Copyright (c) Metapa 2005. All Rights Reserved.
#                               Copyright (c) Greenplum 2005. All Rights Reserved
#       Brief descn:-           Provides sizing data for databases/tables/indexes.
#******************************************************************************
# Update History
#******************************************************************************
# Ver   Date            Who             Update
#******************************************************************************
# Detailed Description
#******************************************************************************
#
#******************************************************************************
# Prep Code
# Source required functions file, this required for script to run
WORKDIR=`dirname $0`
FUNCTIONS=$WORKDIR/gp_bash_functions.sh
if [ -f $FUNCTIONS ]; then
                . $FUNCTIONS
else
                echo "[FATAL:]-Cannot source $FUNCTIONS file Script Exits!"
                exit 2
fi
#******************************************************************************
# Location Variables
#******************************************************************************

#******************************************************************************
# Command Variables
#******************************************************************************

#******************************************************************************
# Script Specific Variables
#******************************************************************************
INTERACTIVE=1
VERBOSE=1
TIME=`$DATE +%H":"%M":"%S`
CUR_DATE=`$DATE +%Y%m%d`
PROG_NAME=`$BASENAME $0`
PROG_NAME=`$BASENAME $0`
HELP_DOC_NAME=`$ECHO $PROG_NAME|$AWK -F'.' '{print $1}'`_help
QD_NAME=`hostname`
EXIT_STATUS=0
TMPFILE=/tmp/table_size.$$
SCALE=k
DISPLAY_TYPE=0
SIZE_TYPE=0 #0=table 1=index
SIZE_TARGET=0 #0=primary and mirror 1=primary only 2=mirror only
DO_CHILD=0
SKIP_INDEX=0
PARALLEL_STATUS_FILE=/tmp/gpsizecalc_parallel_status_file.$$
GPSEGSIZE=gpsegsize.sh
#***********************************************************************************
USAGE () {
if [ -f ${GPDOCDIR}/$HELP_DOC_NAME ] && [ x"" == x"$SCRIPT_USAGE" ];then
	$MORE ${GPDOCDIR}/$HELP_DOC_NAME
	exit 0
else
	if [ x"" == x"$PGDATABASE" ];then
		QD_DBNAME=Unknown
	else
		QD_DBNAME=$PGDATABASE
	fi
	$ECHO 
	$ECHO "      `basename $0`"
	$ECHO
	$ECHO "      Provides actual disk space usage for a postgres table/index or database name supplied"
	$ECHO "      as a parameter to this script"
	$ECHO 
	$ECHO "      Usage:"
	$ECHO "      $0 [OPTIONS]"
	$ECHO 
	$ECHO "      General options:"
	$ECHO "      -?, display this help message & exit"
	$ECHO "      -v, display version information & exit"
	$ECHO
	$ECHO "      Logging options:"
	$ECHO "      -q, quiet mode, do not log progress to screen [default:- verbose output to screen]"
	$ECHO "      -l, <logfile directory> alternative logfile directory [optional]"
	$ECHO "      -D, set log output to debug level, shows all function calls"
	$ECHO 
	$ECHO "      Connection options:"
	$ECHO "      -d, <Master instance directory> name of alternative Master instance to run against [optional]"
	$ECHO
	$ECHO "      Size options:"
	$ECHO "      -t, <table name> name of table to obtain size data [mandatory if -x not supplied]"
	$ECHO "      -s, <scale> valid values b (Bytes) k (KBytes) m (MBytes) g (GBytes) [default:- ${SCALE}]"
	$ECHO "          Size obtained via ls ,if k specified, value will be divided by 1024, if m"
	$ECHO "          specified, value will again be divided by 1024, and again further divided by 1024"
	$ECHO "          for value g"
	$ECHO "      -f, display full size information [default:-display total only]"
	$ECHO "      -a, <database name> alternative database name [default ${QD_DBNAME}]"
	$ECHO "      -i, obtain index size for <table name> [default:- table size]"
	$ECHO "      -x, <database name> name of database to obtain size data [default ${QD_DBNAME}]"
	$ECHO "      -p, obtain size details for primary segment instance only [default both]"
	$ECHO "      -m, obtain size details for mirror segment instances only [default both]"
	$ECHO "      -h, display size of child tables if -t <table name> is a partitioned table"
	$ECHO "      -B, <number> run this batch of stop segment processes in parallel [default $BATCH_DEFAULT]"
	$ECHO
	$ECHO "      Return codes:"
	$ECHO "      0 No problems encountered with requested operation"
	$ECHO "      1 Warning generated, but operation completed"
	$ECHO "      2 Fatal error, unable to complete requested operation"
	$ECHO
	exit 0
fi
}

GET_DB_OID_DATA () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	DB_OID=`$PSQL -q -p $MASTER_PORT $QD_DBNAME -A -t -c"select oid from pg_database where datname='${QD_DBNAME}';"`
	ERROR_CHK $? "obtain database OID from $QD_DBNAME database" 2
	LOG_MSG "[INFO]:-Obtained database OID value $DB_OID"
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

GET_TABLE_OID_DATA () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	if [ x"" != x"$SCHEMA_NAME" ]; then
		#Schema name has been supplied
		#Get schema oid
		SCHEMA_OID=`$PSQL -q -p $MASTER_PORT $QD_DBNAME -A -t -c"select oid from pg_namespace where nspname='${SCHEMA_NAME}';"`
		ERROR_CHK $? "obtain schema oid value" 2
		if [ x"" == x"$SCHEMA_OID" ]; then
			ERROR_EXIT "[FATAL]:-Schema $SCHEMA_NAME does not exist";fi
		#Get table oid
		TABLE_OID=`$PSQL -q -p $MASTER_PORT $QD_DBNAME -A -t -c"select oid from pg_class where relname='$TABLE_NAME' and relnamespace=${SCHEMA_OID};"`
		ERROR_CHK $? "obtain table oid value" 2
		if [ x"" == x"$TABLE_OID" ];then
			ERROR_EXIT "[FATAL]:Table OID is NULL" 2
		fi
	else
		#No schema name supplied, make sure no duplicate tables
		TABLE_NAME_COUNT=`$PSQL -q -p $MASTER_PORT $QD_DBNAME -A -t -c"select count(*) from pg_class where relname='${TABLE_NAME}';"`
		case $TABLE_NAME_COUNT in
			0) ERROR_EXIT "[FATAL]:-Could not locate $TABLE_NAME in pg_class" 2 ;;
			1) ;;
			*) ERROR_EXIT "[FATAL]:-Duplicates found for $TABLE_NAME in pg_class, use -n <schema name> option" 2 ;;
		esac
		TABLE_OID=`$PSQL -q -p $MASTER_PORT $QD_DBNAME -A -t -c"select oid from pg_class where relname='${TABLE_NAME}';"`
		ERROR_CHK $? "obtain access to pg_class table in $QD_DBNAME" 2	
	fi
	LOG_MSG "[INFO]:-Obtained OID value $TABLE_OID"
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

GET_OID_DATA () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	GET_DB_OID_DATA
	GET_TABLE_OID_DATA
	if [ $SIZE_TYPE -eq 1 ]; then
		INDEX_OID=(`$PSQL -q -p $MASTER_PORT $QD_DBNAME -A -t -c"select indexrelid from pg_index where indrelid=${TABLE_OID};"`)
		INDEX_COUNT=${#INDEX_OID[@]}
		if [ $INDEX_COUNT -eq 0 ];then
			if [ $DO_CHILD -eq 0 ];then
				ERROR_EXIT "[FATAL]:-No indexes found for table $TABLE_NAME" 2
			else
				LOG_MSG "[WARN]:-No indexes found for table $TABLE_NAME" 1
				EXIT_STATUS=1
				SKIP_INDEX=1
			fi
		else
			SKIP_INDEX=0
		fi
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

SEND_TABLE_SIZE_REQUEST () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	BATCH_LIMIT=${#QE_ARRAY[@]}
	PARALLEL_SETUP  $PARALLEL_STATUS_FILE
	for I in "${QE_ARRAY[@]}"
	do
		SET_VAR
		if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $NOLINE_ECHO ".\c";fi
		$GPSEGSIZE $$ $QE_HOST $QE_PORT $QE_DIR $INST_COUNT $LOG_FILE $TABLE_OID ${DB_OID} 1 $TMPFILE &
		PARALLEL_COUNT $BATCH_LIMIT $BATCH_DEFAULT
	done	
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

SET_VAR () {
	QE_HOST=`$ECHO $I|$CUT -d'|' -f1`
	QE_DIR=`$ECHO $I|$CUT -d'|' -f2`
	QE_PORT=`$ECHO $I|$CUT -d'|' -f3`
}

SEND_INDEX_SIZE_REQUEST () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	BATCH_LIMIT=${#QE_ARRAY[@]}
	PARALLEL_SETUP  $PARALLEL_STATUS_FILE	
	for I in "${QE_ARRAY[@]}"
	do
		SET_VAR
		if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $NOLINE_ECHO ".\c";fi
		$GPSEGSIZE $$ $QE_HOST $QE_PORT $QE_DIR $INST_COUNT $LOG_FILE $TABLE_OID ${DB_OID} 1 $TMPFILE $QD_DBNAME &
		PARALLEL_COUNT $BATCH_LIMIT $BATCH_DEFAULT
	done
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

GET_CHILD_NAMES () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	PARENT_TABLE_RELFILENODE=`$PSQL -p $MASTER_PORT -A -t $QD_DBNAME -c"select oid from pg_class where relname='$TABLE_NAME' and relkind='r' and relnamespace in (select oid from pg_namespace where nspname='$SCHEMA_NAME');"`
	CHILD_NAME_ARRAY=(`$PSQL -p $MASTER_PORT -A -t $QD_DBNAME -c"select relname from pg_class where relkind='r' and oid in (select inhrelid from pg_inherits where inhparent=$PARENT_TABLE_RELFILENODE);"|$TR '\n' ' '`)
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

CHK_SCHEMA_PREFIX () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	if [ `$ECHO $TABLE_NAME|$GREP -c "\."` -eq 1 ];then
		LOG_MSG "[INFO]:-Schema prefix found, processing"
		TMP_TABLE_NAME=`$ECHO $TABLE_NAME|$CUT -d"." -f2`
		SCHEMA_NAME=`$ECHO $TABLE_NAME|$CUT -d"." -f1`
		TABLE_NAME=$TMP_TABLE_NAME
	fi
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

SEND_DB_SIZE_REQUEST () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	BATCH_LIMIT=${#QE_ARRAY[@]}
	PARALLEL_SETUP  $PARALLEL_STATUS_FILE	
	for I in "${QE_ARRAY[@]}"
	do
		QE_HOST=`$ECHO $I|$CUT -d'|' -f1`
		QE_DIR=`$ECHO $I|$CUT -d'|' -f2`
		QE_PORT=`$ECHO $I|$CUT -d'|' -f3`
		if [ $DEBUG_LEVEL -eq 0 ] && [ x"" != x"$VERBOSE" ];then $NOLINE_ECHO ".\c";fi
		$GPSEGSIZE $$ $QE_HOST $QE_PORT $QE_DIR $INST_COUNT $LOG_FILE 0 $DB_OID 3 $TMPFILE $QD_DBNAME &
		PARALLEL_COUNT $BATCH_LIMIT $BATCH_DEFAULT
	done	
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

CALC_TOTAL_SIZE () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	TOTAL_SIZE=0
	for I in `$CAT $TMPFILE| grep -v "|$"` 
	do
		BSIZE=`$ECHO $I|$CUT -d'|' -f4`
		case $SCALE in
			k) ((SIZE=$BSIZE/1024)) ;;
			m) ((SIZE=$BSIZE/1024/1024)) ;;
			g) ((SIZE=$BSIZE/1024/1024/1024)) ;;
			b) ((SIZE=$BSIZE)) ;;
		esac
		HOST=`$ECHO $I|$CUT -d'|' -f1`
		SEG=`$ECHO $I|$CUT -d'|' -f2`
		PORT=`$ECHO $I|$CUT -d'|' -f3`
		if [ $DISPLAY_TYPE -eq 1 ];then
			if [ $VERBOSE ];then
				LOG_MSG "[INFO]:-Host $HOST Port $PORT Segment $SEG Space Used = $SIZE ${TXT_SCALE}" 1
			else
				$ECHO $I
				$ECHO $I >> $LOG_FILE
			fi
		fi
		((TOTAL_SIZE=$TOTAL_SIZE+$SIZE))	
	done
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}

DISPLAY_SIZE () {
	LOG_MSG "[INFO]:-Start Function $FUNCNAME"
	PARALLEL_SUMMARY_STATUS_REPORT $PARALLEL_STATUS_FILE
	$RM -f $PARALLEL_STATUS_FILE
	case $SCALE in
		b ) TXT_SCALE=Bytes ;;
		k ) TXT_SCALE=KBytes ;;
		m ) TXT_SCALE=MBytes ;;
		g ) TXT_SCALE=GBytes ;;
	esac
			   LOG_MSG "[INFO]:-Size calculation type = $TYPE_TEXT" 1
	if [ $VERBOSE ];then
			   LOG_MSG "[INFO]:-Database name         = $QD_DBNAME" 1
			   LOG_MSG "[INFO]:-Schema name           = $SCHEMA_NAME" 1
			   LOG_MSG "[INFO]:-Table name            = $TABLE_NAME" 1
		case $SIZE_TYPE in 
			0) if [ $PARTITIONED = 't' ];then
			   LOG_MSG "[INFO]:-Table type            = Partitioned and $TAB_TYPE_TXT" 1
			   else
		           LOG_MSG "[INFO]:-Table type            = Un-Partitioned and $TAB_TYPE_TXT" 1
			   fi 
			   LOG_MSG "[INFO]:-Space type            = Table" 1 ;;
			1) if [ $PARTITIONED = 't' ];then
			   LOG_MSG "[INFO]:-Table type            = Partitioned and $TAB_TYPE_TXT" 1
			   else
			   LOG_MSG "[INFO]:-Table type            = Un-Partitioned and $TAB_TYPE_TXT" 1
			   fi 
			   LOG_MSG "[INFO]:-Space type            = Index" 1 ;;
			2) LOG_MSG "[INFO]:-Space type            = Database" 1;;
		esac
		 	   LOG_MSG "[INFO]:-Space used in total   = $TOTAL_SIZE ${TXT_SCALE}" 1
	else
		$ECHO $TOTAL_SIZE
		$ECHO $TOTAL_SIZE >> $LOG_FILE
	fi
	LOG_MSG "[INFO]:------------------------------------------------" 1
	LOG_MSG "[INFO]:-End Function $FUNCNAME"
}
#***********************************************************************************
trap '$RM -f $TMPFILE $PARALLEL_STATUS_FILE;ERROR_EXIT "[FATAL]:-Recieved INT or TERM signal" 2' INT TERM
CHK_DB_QD_SET
if [ $# -ne 0 ]; then
	while getopts ":fvt:'?'ql:mpd:s:a:ix:!hDB:" opt;do
	case $opt in
		v ) VERSION_INFO ;;
		t ) TABLE_NAME=`$ECHO $OPTARG|$TR '[A-Z]' '[a-z]'` ;;
		'?' ) USAGE ;;
		! ) SCRIPT_USAGE=1
		    USAGE ;;
		d ) MASTER_DATA_DIRECTORY=$OPTARG ;;
		q ) unset VERBOSE ;;
		l ) LOG_DIR=$OPTARG ;;
		s ) SCALE=`$ECHO $OPTARG|$TR '[A-Z]' '[a-z]'` ;;
		f ) DISPLAY_TYPE=1 ;;
		a ) ALT_DBNAME=$OPTARG ;;
		i ) SIZE_TYPE=1 ;;
		m ) SIZE_TARGET=2 ;;
		p ) SIZE_TARGET=1 ;;
		x ) SIZE_DB=$OPTARG ;;
		h ) DO_CHILD=1 ;;
		D ) DEBUG_LEVEL=1 ;;
		B ) BATCH_DEFAULT=$OPTARG ;;
		* ) USAGE ;;
		esac
	done
	CHK_ON_PASSIVE_STANDBY
else
	CHK_ON_PASSIVE_STANDBY
	USAGE
fi
if [ $SCALE != "k" ];then
	case $SCALE in
		m ) ;;
		b ) ;;
		g ) ;;
		* ) ERROR_EXIT "[FATAL]:-Parameter -s must be either b, k, m or g" 2 ;;
	esac
fi
if [ x"" == x"$TABLE_NAME" ] && [ x"" == x"$SIZE_DB" ];then
	ERROR_EXIT "[FATAL]:-Must supply a table name via -t option, or use -x <database name> option" 2
else
	CHK_SCHEMA_PREFIX
fi
if [ x"" != x"$LOG_DIR" ];then
	CHK_DIR $LOG_DIR
	if [ $EXISTS -eq 1 ]; then
		LOG_MSG "[WARN]:-Log directory $LOG_DIR does not exist, using default log directory"
		EXIT_STATUS=1
else
	LOG_FILE=$LOG_DIR/${PROG_NAME}_${CUR_DATE}.log
	fi
fi
LOG_MSG "[INFO]:-Start Main"
LOG_MSG "[INFO]:-Command line options passed to utility = $*"
GET_QD_DB_NAME
READ_CHK
if [ $READ_COUNT -ne 0 ];then
	ERROR_EXIT "[FATAL]:-This script cannot be used on a Master read only segment instance" 2
fi
case $SIZE_TARGET in 
	0) GET_QE_DETAILS 
	   GET_MIRROR_TYPE
	   if [ $MIR_NUM -eq 0 ];then
	   TYPE_TEXT="Primary [No mirrors configured]"
	   else
	   TYPE_TEXT="Primary and Mirror Segments" 
	   fi
       	;;
	1) GET_QE_PRIMARY_DETAILS
	   QE_ARRAY=(${QE_PRIMARY_ARRAY[@]}) 
	   TYPE_TEXT="Primary Segments Only" ;;
	2) GET_QE_MIRROR_DETAILS
	   if [ ${#QE_MIRROR_ARRAY[@]} -eq 0 ];then
	 	ERROR_EXIT "[FATAL]:-No mirrors configured -m option invalid" 2;fi
	   QE_ARRAY=(${QE_MIRROR_ARRAY[@]}) 
	   TYPE_TEXT="Mirror Segments Only" ;;
esac
if [ x"" != x"$ALT_DBNAME" ];then
	QD_DBNAME=$ALT_DBNAME
fi
if [ x"" != x"$SIZE_DB" ];then
	QD_DBNAME=$SIZE_DB
	SIZE_TYPE=2
fi
if [ $SIZE_TYPE -le 1 ];then
	CHK_EXISTS_TABLE ${SCHEMA_NAME}.$TABLE_NAME $MASTER_PORT $QD_DBNAME
	if [ $EXISTS -ne 0 ];then
		ERROR_EXIT "[FATAL]:-Table $TABLE_NAME does not exist in $QD_DBNAME database" 2
	fi
	GET_OID_DATA
	GET_TABLE_TYPE ${SCHEMA_NAME}.$TABLE_NAME $MASTER_PORT $QD_DBNAME
	if [ $SIZE_TYPE -eq 0 ];then
		SEND_TABLE_SIZE_REQUEST
		CALC_TOTAL_SIZE
		DISPLAY_SIZE
		$RM -f $TMPFILE
		if [ $DO_CHILD -eq 1 ] && [ $PARTITIONED == 't' ];then
			GET_CHILD_NAMES
			LOG_MSG "[INFO]:-Processing child tables"
			for CHILD_TABLE_NAME in ${CHILD_NAME_ARRAY[@]}
			do
				#TABLE_NAME=${SCHEMA_NAME}.$CHILD_TABLE_NAME
				TABLE_NAME=$CHILD_TABLE_NAME
				LOG_MSG "[INFO]:-Processing child table $TABLE_NAME" 1
				CHK_EXISTS_TABLE ${SCHEMA_NAME}.$TABLE_NAME $MASTER_PORT $QD_DBNAME
				GET_TABLE_TYPE ${SCHEMA_NAME}.$TABLE_NAME $MASTER_PORT $QD_DBNAME
				GET_OID_DATA
				SEND_TABLE_SIZE_REQUEST
				CALC_TOTAL_SIZE
				DISPLAY_SIZE
				$RM -f $TMPFILE
			done
		fi			
	else
		if [ $SKIP_INDEX -eq 0 ];then
			SEND_INDEX_SIZE_REQUEST
			CALC_TOTAL_SIZE
			DISPLAY_SIZE
		fi
		$RM -f $TMPFILE
		if [ $DO_CHILD -eq 1 ] && [ $PARTITIONED == 't' ];then
			GET_CHILD_NAMES
			LOG_MSG "[INFO]:-Processing child tables"
			for CHILD_TABLE_NAME in ${CHILD_NAME_ARRAY[@]}
			do
				TABLE_NAME=$CHILD_TABLE_NAME
				LOG_MSG "[INFO]:-Processing child table $TABLE_NAME" 1
				GET_OID_DATA
				GET_TABLE_TYPE ${SCHEMA_NAME}.$TABLE_NAME $MASTER_PORT $QD_DBNAME
				if [ $SKIP_INDEX -eq 0 ];then
					SEND_INDEX_SIZE_REQUEST
					CALC_TOTAL_SIZE
					DISPLAY_SIZE
				fi
			$RM -f $TMPFILE
			done
		fi	
	fi
else
	GET_DB_OID_DATA
	SEND_DB_SIZE_REQUEST
	CALC_TOTAL_SIZE
	DISPLAY_SIZE
	$RM -f $TMPFILE
fi
LOG_MSG "[INFO]:-End Main"
exit $EXIT_STATUS
