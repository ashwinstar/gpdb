def make_conn(ug, user, db, options, port, sockdir):
    try:
        ug.Log('DEBUG', "making database connection: user = %s, "
                 "dbname = %s port = %i, unix socket connection" % (user, db, port))
        conn = pg8000.Connection(user=user,
                                 unix_sock=os.path.join(sockdir, '.s.PGSQL.%i' % port),
                                 database=db, 
                                 options=options,
                                 port=port,
                                 socket_timeout=5000)
    except Exception, e:
        # could be an issue with using UNIX sockets, try a host based
        # connection
        try:
            ug.Log('DEBUG', "could not connect using unix socket (%s), trying host based connection" % str(e))
            conn = pg8000.Connection(user=user,
                                     host='localhost',
                                     database=db, 
                                     options=options,
                                     port=port,
                                     socket_timeout=5000)
        except Exception, e:
            ug.Log('FATAL', 'Could not establish connection to ' +
                          'database "%s" port %d: %s' % (db, port, str(e)))
            raise ConnectionError(str(e))
    return conn


#============================================================
def pretty_version(v):
    '''
    Turns the RCS revision number into a prettier format
    '''
    m = re.compile('Revision: #(\d+)').search(v)
    if m: return str('3' + '.' + m.group(1))
    else: return str(v)

__version__ = pretty_version('$Revision$')

#============================================================
def cli_help():
    help_path = os.path.join(sys.path[0], '..', 'docs', 'cli_help', EXECNAME + '_help');
    f = None
    try:
        try:
            f = open(help_path);
            return f.read(-1)
        except:
            return ''
    finally:
        if f: f.close()

#============================================================
def usage():
    print cli_help() or __doc__

#============================================================
class ConnectionError(StandardError): pass
class UpgradeError(StandardError): pass
class CmdError(StandardError):
    def __init__(self, cmd, stdout, stderr):
        self.cmd = cmd
        self.stdout = stdout
        self.stderr = stderr
    def __str__(self):
        return self.stderr

#============================================================
class MappingsWorker(Thread):
    def __init__(self, upgrade, dir, mapfilename, oids):
        self.dir = dir
        self.oids = oids
        self.errors = 0
        self.upgrade = upgrade
        self.mapfilename = mapfilename

        Thread.__init__(self)

    def run(self):
        mapfile = open(self.mapfilename, 'w')
        for oid, dboids in self.oids.iteritems():
            dbname = dboids[0]
            oids = dboids[1]
            for o in oids:
                # Check that the relfilenode actually exists! 
                #   There is a bug that can cause diskfiles to go missing from
                #   bitmap indices.  We want to generate a comprehensable error
                #   message for these.
                file = os.path.join(self.dir, 'base', str(oid), str(o['filenode']))
                if not os.path.exists(file):
                    # name is either "schema"."parentschema"."parent_name"_"kind"
                    #      or        "schema"."name"."kind"
                    # where the first form is used for objects that embed oids
                    # in their names (append only segments, bitmap indexes)
    
                    kind = o['name'][-1:]
                    name = o['name'][:-2]
    
                    if name[:14] == 'pg_bitmapindex':
                        msg = "Bitmap index '%s'" % name[15:]
                    elif name[:8] == 'pg_aoseg':
                        msg = "Append only segment for '%s'" % name[9:]
                    elif kind == 'a' or kind == 'r':
                        msg = "Table '%s'" % name
                    elif kind == 'i':
                        msg = "Index '%s'" % name
                    elif kind == 'S':
                        msg = "Sequence '%s'" % name
                    else:
                        msg = "Object '%s'" % name
                    msg += " missing relfile on segment '%s'\n" % self.upgrade.host
                    self.upgrade.Log('FATAL', msg)
                    self.upgrade.Log('FATAL', 'missing relfile: ' + file)
                    self.errors += 1
    
                # Prefix each name with the database it's in
                mapfile.write('%s.%s,%s,%s,%s,%s\n' %
                              (dbname.encode('utf-8'), o['name'].encode('utf-8'),
                               oid, 
                               o['filenode'], 
                               o['toast'], 
                               o['toast_index']))


        mapfile.close()

class RemapOidWorker(Thread):
    def __init__(self, mapspec, olddir, newdir, method):
        self.mapspec = mapspec
        self.olddir = olddir
        self.newdir = newdir
        self.method = method
        self.errors = 0
        self.errstr = ""
        Thread.__init__(self)

    def run(self):
        oldmapfile = open(self.mapspec+'_source_mapping', 'r')
        newmapfile = open(self.mapspec+'_target_mapping', 'r')
        for oldline in oldmapfile:
            newline = newmapfile.next()

            # trim off the newlines
            oldline = oldline[0:-1]
            newline = newline[0:-1]

            (oldname, olddb, oldoid, oldtoast, oldtidx) = \
                oldline.split(',')
            (newname, newdb, newoid, newtoast, newtidx) = \
                newline.split(',')                        

            if oldname != newname:
                self.errors += 1
                self.errstr = "Mapping failure on %s" % oldname
                raise UpgradeError(self.errstr)

            def makemapping(name,olddb,oldoid,newdb,newoid,msg):
                if oldoid == 'None' and newoid == 'None':
                    return
                if oldoid == 'None' or newoid == 'None':
                    raise UpgradeError("Mapping failure on %s %s" % (name, msg))
                mapping[os.path.join(olddb,oldoid)] = os.path.join(newdb, newoid)

            mapping = {}
            makemapping(oldname, olddb, oldoid, newdb, newoid, '')
            makemapping(oldname, olddb, oldtoast, newdb, newtoast, 'toast')
            makemapping(oldname, olddb, oldtidx, newdb, newtidx, 'toast index')

            for oldoid in mapping:
                newoid = mapping[oldoid]
                oldfile = os.path.join(self.olddir, 'base', oldoid)
                newfile = os.path.join(self.newdir, 'base', newoid)

                # Both old and new file should exist
                if not os.path.exists(oldfile):
                    self.errors += 1
                    self.errstr = oldfile + ' not found'
                    raise UpgradeError(self.errstr)
                # we don't want to test if the file exists if this
                # is a transform style 'grade
                if (self.method == 'dumprestore' and 
                    not os.path.exists(newfile)):
                    self.errors += 1
                    self.errstr = newfile + ' not found'
                    raise UpgradeError(self.errstr)

                if os.path.exists(newfile):
                    os.remove(newfile)
                os.link(oldfile, newfile)

                # Large tables will have additional extensions, these
                # are named 'relfilenode.extension#'.
                ext = 1
                while (os.path.exists(oldfile + '.' + str(ext))):
                    os.link('%s.%s' % (oldfile, str(ext)),
                            '%s.%s' % (newfile, str(ext)))
                    ext = ext + 1
        
class Worker(Thread):
    def __init__(self, harness):
        self.harness  = harness
        self.problems = []
        Thread.__init__(self)

    # Note that we do not override Thread's __init__ method.
    # The Queue module makes this not necessary.
    def run(self):

        # Have our thread serve "forever":
        while True:

            # Get a client out of the queue
            task = self.harness.queue.get()

            # tasks placed into the threadpool are tuples with the first
            # element describing the directive.
            if task != None:
                try:
                    if task[0] == 'EXIT':
                        self.harness.queue.task_done()
                        return

#                    if task[0] == 'REMOTE':
#                        host = task[1]
#                        cmd  = task[2]
#                 
#                        # use paramiko to invoke SSH to run the command.
#                        p = SSHClient()
#                        p.load_system_host_keys()
#                        p.connect(host)
#                        (cin, cout, cerr) = p.exec_command(cmd)
#                        raise UpgradeError('remote thread exec not implemented')

                    elif task[0] == 'LOCAL':
                        cmd  = task[1]
                        pipe = subprocess.Popen(cmd, shell=True,
                                                stdout=subprocess.PIPE,
                                                stderr=subprocess.PIPE,
                                                close_fds=True)
                        result = pipe.communicate()
                        if pipe.returncode:
                            raise CmdError(str(cmd), result[0], result[1])

                    else:
                        raise UpgradeError('Unknown Worker directive: ' + str(task))
                except BaseException, e:
                    self.problems.append(e)
                
                 # Tell the queue that the task is done
                sys.stderr.write('.')
                self.harness.queue.task_done()

class Harness():
    def __init__(self, upgrader, size):
        self.upgrader = upgrader
        self.pool  = []
        self.queue = Queue(size*2)
        for x in range(size):
            w = Worker(self)
            w.start()
            self.pool.append(w)

    def __del__(self):
        for w in self.pool:
            self.queue.put(['EXIT'])
        self.wait()

    def remoteCommand(self, host, cmd):
        self.queue.put(['REMOTE', host, cmd])

    def localCommand(self, cmd):
        self.queue.put(['LOCAL', cmd])

    def wait(self):
        failed = False

        # Wait until the queue is empty and all tasks complete
        self.queue.join()
        sys.stderr.write('\n')

        # Report any errors the threads encountered
        for w in self.pool:
            for e in w.problems:
                self.upgrader.Log('FATAL', str(e))
                failed = True
            w.problems = []

        if failed:
            raise UpgradeError('Error encountered in threaded execution')


#============================================================
class GPUpgrade:
    '''
    Greenplum Database Upgrade Utility
    '''

    # INTERNAL command:
    #   MASTER    - default, run on master, [not included in list]
    #   MKDIR     - Create directories, run on every host
    #   RMDIR     - Remove directories, run on every host
    #   CHKDIR    - Check directories, run on every host
    #   RESETXLOG - Syncronize xlogs
    #   REMAPOID  - Link newdb to old oids, run on every host
    #   DEEPLINK  - Recursive hardlink
    #   EXTRACTCATFILES - build a list of catalog files to be copied
    #   BUILDSKEL - build a skeleton copy of the old system
    #   TRANSFORMCAT - apply catalog transformations
    #   SETCATVERSION - set catalog version
    #   EXTRACTAOSEGS - get ao seg info
    #   GETHIGHESTOID - find the highest OID in the cluster
    commands = ['SETSTATE', 'MKDIR', 'RMDIR', 'CHKDIR', 'RESETXLOG', 'MAPPINGS',
                'REMAPOID', 'DEEPLINK', 'CHKDOWN', 'LOCKDOWN', 'UNLOCK',
                'EXTRACTCATFILES', 'BUILDSKEL', 'TRANSFORMCAT',
                'SETCATVERSION', 'EXTRACTAOSEGS', 'GETHIGHESTOID']

    #------------------------------------------------------------
    def __init__(self):
        '''
        The most basic of initialization
        '''
        self.cmd       = 'MASTER'      # Command being run

        self.prepare   = False
        self.execute   = False
        self.noinit    = False

        self.pid       = os.getpid()   # Process ID of the master
        self.threadpool = None

        # Non-master variables
        self.option    = None     # Argument passed to cmd
        self.option2   = None     # Argument passed to cmd
        
        # Enviornment and system info
        self.masterdir = None     # Master Data Directory
        self.masterport = 5432    # Master Port
        self.datadirs  = None     # Set of all data and mirror directories
        self.oldhome   = None     # Old gphome/bin directory
        self.newhome   = None     # New gphome/bin directory
        self.oldenv    = None     # enviornment: old gp env
        self.newenv    = None     # enviornment: new gp env
        self.user      = None     # db admin user
        self.host      = None     # master hostname
        self.path      = None     # Default path
        self.upgrade   = None     # True for upgrade, False for downgrade
        self.logdir    = None
        self.logfile   = None
        self.method    = None     # transform or dumprestore ?

        # Alternate ports for upgrade database during --prepare
        self.new_master_port      = None
        self.new_port_base        = None
        self.new_mirror_port_base = None

        # Upgrade information and state
        self.debug      = False
        self.quiet      = False
        self.revert     = False
        self.checkschema = True
        self.warnings   = False
        self.oldversion = None
        self.newversion = None
        self.root       = None     # directory: masterdir
        self.workdir    = None     # directory: masterdir/gpmigrator
        self.newmaster  = None     # directory: workdir/upgrade/gp-1
        self.state      = None     # file:      backup/state
        self.config     = {}       # gp_init_config for new db
        self.mappings   = None     # Mappings of old oid to new oids
        self.hosts      = []       # list of hosts
        self.segments   = []       # list of segments
        self.mirrors    = []       # list of mirrors
        self.dbup       = None
        self.interupted = False    # SIGINT recieved
        self.faultinjection = None

    #------------------------------------------------------------
    def Setup(self):
        '''
        Basic initialization, separate from __init__ for exception
        handling purposes.
        '''

        # This is the same path used by gpinitsystem
        self.path = '/usr/kerberos/bin:/usr/sfw/bin:/opt/sfw/bin'
        self.path += ':/usr/local/bin:/bin:/usr/bin:/sbin:/usr/sbin:/usr/ucb'
        self.path += ':/sw/bin'

        # Set defaults
        self.user      = os.environ.get('USER') or os.environ.get('LOGNAME')
        self.host      = self.RunCmd('hostname')
        self.masterdir = os.environ.get('MASTER_DATA_DIRECTORY')

        self.ParseInput()

        # Extract path from input master directory
        if self.cmd == 'MASTER':
            self.Log('INFO', 'Beginning upgrade')
            self.Log('INFO', 'Checking configuration')

            if not self.masterdir or len(self.masterdir) == 0:
                raise UpgradeError('MASTER_DATA_DIRECTORY is not defined')
            self.masterdir = self.masterdir.rstrip('/')

            # The configuration file
            conf = os.path.join(self.masterdir, 'postgresql.conf')

            # All the parameters we are interested in are integer values
            def getconf(x):
                conf_re  = re.compile('^\s*%s\s*=\s*(\d+)' % x)
                conf_str = self.RunCmd('grep %s %s' % (x, conf))
                value = None
                for line in conf_str.split('\n'):
                    match = conf_re.search(line)
                    if match:
                        value = int(match.group(1))
                return value

            # Find the port for this segment:
            self.masterport = getconf('port')
            if self.masterport == None:
                raise UpgradeError('Could not determine master port from ' + conf)

            self.sock_dir = getconf('unix_socket_directory')
            if not self.sock_dir:
                self.sock_dir = '/tmp/'

            # Verify that (max_connections == superuser_reserved_connections)
            # max_conn = getconf('max_connections')
            # reserved = getconf('superuser_reserved_connections')

            masterpath, masterdir = os.path.split(self.masterdir)
            self.root      = masterpath
            self.workdir   = os.path.join(masterpath, WORKDIR)
            self.newmaster = os.path.join(self.workdir, UPGRADEDIR, masterdir)
            self.oldenv    = self.SetupEnv(self.oldhome, self.masterdir)
            self.newenv    = self.SetupEnv(self.newhome, self.newmaster)

            # Find the SEG_PREFIX (everything except the trailing "-1" on
            # the masterdir)
            self.config['SEG_PREFIX'] = masterdir[:-2]

            # Setup the pool of worker threads
            #self.threadpool = Harness(self, PARALLELISM)

        else:
            self.oldenv = self.SetupEnv(self.oldhome, None)
            self.newenv = self.SetupEnv(self.newhome, None)

    #------------------------------------------------------------
    def ParseInput(self):
        '''
        Parses and validates input to the script
        '''

        try:
            parser = optparse.OptionParser(usage=(cli_help() or __doc__), add_help_option=False)
            parser.add_option('-v', '--version', action='store_true',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('-h', '--help', action='store_true',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('-d', dest='directory', 
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('-l', dest='logdir',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('-q', dest='quiet', action='store_true',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('-R', dest='revert', action='store_true',
                              help=optparse.SUPPRESS_HELP)
            
            parser.add_option('--prepare', action='store_true',
                              help=optparse.SUPPRESS_HELP)

            parser.add_option('--master_port', type="int",
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--port_base',   type="int",
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--mirror_port_base', type="int",
                              help=optparse.SUPPRESS_HELP)

            parser.add_option('--noinit', action='store_true',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--execute', action='store_true',
                              help=optparse.SUPPRESS_HELP)


            parser.add_option('--debug', action='store_true',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--internal-disable-checkschema',
                              dest='nocheckschema', action='store_true',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--internal-command', dest='command',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--internal-pid', dest='pid',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--internal-dirs', dest='datadirs',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--internal-option', dest='option',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--internal-option2', dest='option2',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--internal-method', dest='method',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--internal-oldversion', dest='oldversion',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--internal-newversion', dest='newversion',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--internal-isupgrade', dest='upgrade',
                              action='store_true',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--force-dumprestore', dest='forcedumprestore',
                              action='store_true',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--nocheckcat', dest='nocheckcat',
                              action='store_true',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--fault-injection', dest='faultinjection',
                              type='int', help=optparse.SUPPRESS_HELP)
            (options, args) = parser.parse_args()
            
            if options.version:
                print EXECNAME + ' ' + __version__
                sys.exit(0)

            if options.help:
                usage()
                sys.exit(0)

            if len(args) != 2:
                usage()
                msg = "incorrect number of arguments"
                if len(args) > 0:
                    msg += ": %s" % str(args)
                parser.error(msg)

        except Exception, e:
            usage()
            raise UpgradeError('Error parsing input: ' + str(e))

        if options.quiet and options.debug:
            parser.error('cannot specify -q and --debug at the same time')
        elif options.prepare and options.revert:
            parser.error('cannot specify --prepare and -R at the same time')
        elif options.execute and options.revert:
            parser.error('cannot specify --execute and -R at the same time')

        if options.revert:
            self.revert = True

        if options.directory:
            self.masterdir = options.directory
        if options.command:
            if options.command not in self.commands:
                parser.error('INVALID INTERNAL COMMAND: ' + options.command)
            self.cmd = options.command
        if options.pid:
            if self.cmd == 'MASTER':
                parser.error('INVALID INTERNAL COMMAND: ' + self.cmd)
            self.pid = int(options.pid)
        self.oldhome   = args[0].rstrip('/')
        self.newhome   = args[1].rstrip('/')
        if options.datadirs:
            self.datadirs = urllib.unquote(options.datadirs).split();
        if options.option:
            self.option   = urllib.unquote(options.option)
        if options.option2:
            self.option2  = urllib.unquote(options.option2)
        if options.debug:
            self.debug = True
        if options.quiet:
            self.quiet = True
        if options.logdir:
            self.logdir = options.logdir
        else:
            self.logdir = os.path.join(os.environ['HOME'], 'gpAdminLogs')
        if options.nocheckschema:
            self.checkschema = False
        if self.cmd != 'MASTER':
            self.oldversion = options.oldversion
            self.newversion = options.newversion
            self.method = options.method
            if options.upgrade:
                self.upgrade = True
            else:
                self.upgrade = False
        if options.nocheckcat:
            self.checkcat = False
        else:
            self.checkcat = True
        self.faultinjection = options.faultinjection

        if self.cmd == 'MASTER':
            if options.forcedumprestore:
                self.method = "dumprestore"

            today = date.today().strftime('%Y%m%d')
            if not os.path.isdir(self.logdir):
                os.makedirs(self.logdir, 0700)
            logname = os.path.join(self.logdir, '%s_%s.log' % (EXECNAME, today))
            self.logfile = open(logname, 'a')

            self.pid = os.getpid()
            if self.masterdir == None:
                self.Log('FATAL', 'MASTER_DATA_DIRECTORY parameter not set')
                raise UpgradeError('Initialization failed')
            if not os.path.exists(self.masterdir):
                self.Log('FATAL', 'MASTER_DATA_DIRECTORY: %s not found'
                         % self.masterdir)
                raise UpgradeError('Initialization failed')
            if not os.path.isabs(self.masterdir):
                self.masterdir = os.path.abspath(self.masterdir)
            if not os.path.exists(self.oldhome):
                self.Log('FATAL', ' directory not found: ' + self.oldhome)
                raise UpgradeError('Initialization failed')
            if not os.path.exists(self.newhome):
                self.Log('FATAL', ' directory not found: ' + self.newhome)
                raise UpgradeError('Initialization failed')
            if not os.path.isabs(self.oldhome):
                self.oldhome = os.path.abspath(self.oldhome)
            if not os.path.isabs(self.newhome):
                self.newhome = os.path.abspath(self.newhome)

            if options.prepare:
                self.prepare = True
            if options.execute:
                self.execute = True
            if options.noinit:
                self.noinit  = True

            if not self.prepare and not self.execute:
                self.prepare = True
                self.execute = True

            self.new_master_port      = options.master_port
            self.new_port_base        = options.port_base
            self.new_mirror_port_base = options.mirror_port_base



    #------------------------------------------------------------
    def Cleanup(self):
        '''
        Cleanup open connections.
        Separate from __del__ because that caused weird issues with exit() 
        behavior.
        '''
        if self.cmd == 'MASTER':
            self.Log('FATAL', 'Fatal error occured - Recovering')
            try:
                self.Shutdown()
            except Exception, e:
                self.Log('FATAL', 'Cleanup failure: ' + str(e))

            try:
                self.ReleaseLockdown(self.oldenv)
            except Exception, e:
                self.Log('FATAL', 'Cleanup failure: ' + str(e))

            if self.threadpool:
                del self.threadpool



    #------------------------------------------------------------
    def SetState(self, newstate):
        '''
        Sets the state in the upgrader state file
        '''

        # Set state across all hosts, if all hosts succeed then set the 
        # master state
        if self.cmd == 'MASTER':
            self.CallSlaves('SETSTATE', newstate, self.config['SEG_PREFIX'])
            try:
                self.state.write(str(newstate) + "\n")
                self.state.flush()
            except Exception, e:
                raise UpgradeError('Error writing to statefile: (%s)' % str(e))
        else:
            for d in filter(os.path.exists, self.datadirs):
                statefile = os.path.join(d, WORKDIR, 'state')
                file = open(statefile, 'a')
                file.write(str(newstate) + "\n")
                file.close()

    #------------------------------------------------------------
    def RunCmd(self, cmd, env=None, utility=False, supressDebug=False):
        '''
        Runs a single command on this machine
        '''

        if type(cmd) in [type('string'), type(u'unicode')]:
            cmdstr = cmd
            cmd    = cmd.split(' ')
        elif type(cmd) == type(['list']):
            cmdstr = ' '.join(cmd)
        else:
            self.Log('WARN', "Unknown RunCmd datatype '%s'" % str(type(cmd)))
            cmdstr = str(cmd)
        
        if self.debug and not supressDebug: 
            self.Log('DEBUG', "CMD: " + cmdstr)

        # If utility mode has been specified add role to env
        if env == None:
            env = {'PATH': self.path}

        if utility:
            env['PGOPTIONS'] = '-c gp_session_role=utility'

        try:
            pipe = subprocess.Popen(cmd, env=env, 
                                    stdout=subprocess.PIPE, 
                                    stderr=subprocess.PIPE,
                                    close_fds=True)
            result  = pipe.communicate();
        except OSError, e:
            raise CmdError(cmdstr, '', str(e))

        if self.debug and not supressDebug:
            self.Log('DEBUG', result[1])

        if pipe.returncode:
            raise CmdError(' '.join(cmd), result[0], result[1])
        else:
            return result[0].strip();

    #------------------------------------------------------------
    def CallSlaves(self, cmd, option='', option2=''):
        '''
        Calls every host to execute the given command with the given option 
        value
        '''
                    
        # Check for things that should never happen
        if self.cmd != 'MASTER':
            raise UpgradeError("Recursive communication error")
        if not self.datadirs:
            raise UpgradeError("Failure initializing data directories")

        # Construct a string of '-h hostname' for all hosts
        exec_cmd = 'gpssh'
        for h in self.hosts: 
            exec_cmd += ' -h %s' % h

        if self.upgrade or self.revert:
            env = self.newenv
            exec_cmd += ' %s/bin/lib/gpenv.sh %s ' % (self.newhome, EXECNAME)
        else:
            env = self.oldenv
            exec_cmd += ' %s/bin/lib/gpenv.sh %s ' % (self.oldhome, EXECNAME)

        exec_cmd += self.oldhome + ' ' + self.newhome
        exec_cmd += ' --internal-oldversion=' + str(self.oldversion)
        exec_cmd += ' --internal-newversion=' + str(self.newversion)
        exec_cmd += ' --internal-command=' + str(cmd)
        exec_cmd += ' --internal-pid=' + str(self.pid)
        exec_cmd += ' --internal-dirs=%s' % urllib.quote(str(self.datadirs))
        exec_cmd += ' --internal-option=%s' % urllib.quote(str(option))
        exec_cmd += ' --internal-option2=%s' % urllib.quote(str(option2))
        if self.method:
            exec_cmd += ' --internal-method=%s' % urllib.quote(str(self.method))
        if self.upgrade:
            exec_cmd += ' --internal-isupgrade'
        if self.revert:
            exec_cmd += ' -R'

        try:
            result = self.RunCmd(exec_cmd, env=env)
            #sys.stdout.write(result)
            #sys.stdout.flush()
        except CmdError, e:
            self.Log('DEBUG', e.cmd)
            sys.stdout.write(e.stdout)
            sys.stdout.flush()
            sys.stderr.write(e.stderr)
            raise UpgradeError('Fatal Segment Error')
        
        # gpssh is very bad at returning useful status codes so we also need
        # to see if there was any mention of FATAL within the message
        self.Log('GPSSH', result)

        if re.search('gpmigrator.*\[FATAL\]', result):
            raise UpgradeError('Fatal Segment Error')
        return result

    #------------------------------------------------------------
    def CheckDirectories(self):
        if self.cmd == 'MASTER':
            datadirs = [ self.root ]
        else:
            datadirs = self.datadirs

        err = False
        for d in filter(os.path.exists, datadirs):
            p = os.path.join(d, WORKDIR)
            if os.path.exists(p):
                self.Log('WARN', '%s : File exists' % p)
                err = True

        if err:
            raise UpgradeError('Directories exist')
            
    #------------------------------------------------------------
    def SetupEnv(self, gphome, masterdir):
        '''
        Sets up environment variables for Greenplum Administration
        '''
        home  = os.environ.get('HOME')
        lpath = os.environ.get('LD_LIBRARY_PATH')
        dypath = os.environ.get('DYLD_LIBRARY_PATH')

        # Add $GPHOME/bin to the path for this environment
        path = '%s/bin:%s/ext/python/bin:%s' % (gphome, gphome, self.path)

        if lpath:
            lpath = '%s/lib:%s/ext/python/lib:%s' % (gphome, gphome, lpath)
        else:
            lpath = '%s/lib:%s/ext/python/lib' % (gphome, gphome)
        if dypath:
            dypath = '%s/lib:%s/ext/python/lib:%s' % (gphome, gphome, dypath)
        else:
            dypath = '%s/lib:%s/ext/python/lib' % (gphome, gphome)

        env = {}
        env['HOME']    = home
        env['USER']    = self.user
        env['LOGNAME'] = self.user
        env['GPHOME']  = gphome
        env['PATH']    = path
        env['LD_LIBRARY_PATH'] = lpath
        env['DYLD_LIBRARY_PATH'] = dypath
        env['PYTHONPATH'] = os.path.join(gphome, 'lib', 'python')
        env['PYTHONHOME'] = os.path.join(gphome, 'ext', 'python')
        if masterdir:
            env['MASTER_DATA_DIRECTORY'] = masterdir
            env['PGPORT'] = str(self.masterport)
        return env

    #------------------------------------------------------------
    def Log(self, type, msg):

        if type not in ['NONE', 'INFO', 'WARN', 'FATAL', 'DEBUG', 'GPSSH']:
            print '[WARN] Odd log type: %s' % str(type)
        
        if type in ['DEBUG', 'GPSSH'] and not self.debug:
            return

        if type in ['WARN', 'ERROR']:
            self.warnings = True

        if type == 'NONE':
            prefix = ''
        else:
            prefix = ':'.join(
                [strftime('%Y%m%d:%H:%M:%S', localtime()), EXECNAME, 
                 self.host, self.user, '[%s]' % type, '-'])

        try:
            for m in msg.splitlines():
                if m.strip() == '': 
                    continue

                if (self.logfile):
                    self.logfile.write('%s%s\n' % (prefix, m))
                    self.logfile.flush()

                if type == 'FATAL' or type == 'WARN' or not self.quiet:
                    sys.stderr.write('%s%s\n' % (prefix, m))
        except:
            pass

    #------------------------------------------------------------
    def Select(self, qry, db='template1', port=None, forceutility=False):
        '''
        Execute a SQL query and return an array of result rows
           + Single columns will be returned as an array of values
           + Multiple columns will be returned as an array of tuples
        '''

        #
        #   If we are executing from one of the segments then we don't
        #   actually know where the data directory is for the segment
        #   is so we can't check if we are in lockdown mode
        #
        #   Fortunately we never actually lock the segments, so we can
        #   always run as current user.
        #
        if self.cmd == 'MASTER':
            if not self.dbup:
                raise UpgradeError('database is down')
            [env, utility] = self.dbup

            locked = os.path.join(env['MASTER_DATA_DIRECTORY'],
                                  'pg_hba.conf'+LOCKEXT)
            if os.path.exists(locked):
                user = MIGRATIONUSER
            else:
                user = env['USER']

        else:

            # If we lockdown on segments this needs to change, some method
            # would need to be made to determine if the segment in question
            # is locked
            user = self.user
            utility = True

        if port == None:
            port = self.masterport
        elif port != self.masterport:
            utility = True

        if utility or forceutility:
            options = '-c gp_session_role=utility'
        else:
            options = ''

        if self.__dict__.get('sock_dir'):
            sockdir = self.sock_dir
        else:
            sockdir = '/tmp/'
        conn = make_conn(self, user, db, options, port, sockdir)

        try:
            conn.execute(qry)
        except Exception, e:
            conn.close()
            self.Log('FATAL', 'Error executing SQL')
            raise ConnectionError('%s\nsql> %s' % (str(e), qry))

        rows = []
        for tuple in conn.iterate_dict():
            if len(tuple) == 1: 
                rows.append(tuple.values()[0])
            else: 
                rows.append(tuple)
        conn.close()
        return rows

    #------------------------------------------------------------
    def Update(self, qry, db='template1', port=None):
        '''
        Execute a SQL query expecting no output
        '''

        #   If we are executing from one of the segments then we don't
        #   have the current database state, so we have to know what to
        #   do via other means.
        #
        #   The assumption is:
        #      A) utility = true
        #      B) pguser = MIGRATIONUSER
        #
        #   If we ever need to run as the non-upgrade user from a segment
        #   this code will obviously need to change
        #
        if self.cmd == 'MASTER':
            if not self.dbup:
                raise UpgradeError('database is down')
            [env, utility] = self.dbup

            locked = os.path.join(env['MASTER_DATA_DIRECTORY'], 
                                  'pg_hba.conf'+LOCKEXT)
            if os.path.exists(locked):
                user = MIGRATIONUSER
            else:
                user = env['USER']
        else:

            # If we lockdown on segments this needs to change, some method
            # would need to be made to determine if the segment in question
            # is locked
            user = self.user
            utility = True

        if port == None:
            port = self.masterport
        
        if utility:  options = '-c gp_session_role=utility'
        else:        options = ''

        conn = make_conn(self, user, db, options, port, self.sock_dir)

        try:
            conn.execute(qry)
        except Exception, e:
            self.Log('FATAL', 'Error executing SQL')
            raise ConnectionError('%s\nsql> %s' % (str(e), qry))

        finally:
            conn.close()

    #------------------------------------------------------------
    def CheckDown(self):
        '''
        Checks that neither postmaster is running and that the database 
        was cleanly shutdown.
        '''
        if self.cmd == 'MASTER':
            dirs   = [ self.root ]
            seg_prefix = self.config['SEG_PREFIX'] + '-'
        else:
            dirs   = self.datadirs
            seg_prefix = self.option

        segdir_re = re.compile(seg_prefix+'\d+$')
        shutdown_re = re.compile('Database cluster state: *(.*)')
            
        for d in dirs:

            # look for segments in the directory
            for content in os.listdir(d):

                # ignore anything not matching the segment prefix
                if not segdir_re.match(content):
                    continue

                # construct full path to segment and upgrade segment
                oldseg = os.path.join(d, content)
                newseg = os.path.join(d, WORKDIR, UPGRADEDIR, content)

                # Only check the upgrade directory if its not legacy
                if self.datadirs:
                    dirs = [oldseg, newseg]
                else:
                    dirs = [oldseg]

                for dir in dirs:
                    if dir == oldseg:  env = self.oldenv
                    else:              env = self.newenv

                    # upgrade directory might not actually exist
                    if not os.path.isdir(dir):
                        continue

                    pid = os.path.join(dir, 'postmaster.pid')
                    if os.path.exists(pid):
                        raise UpgradeError("Greenplum process running: " + pid)

                    shutdown = self.RunCmd('pg_controldata ' + dir, env=env)
                    for line in shutdown.split('\n'):
                        m = shutdown_re.match(line)
                        if m:
                            if m.group(1) == 'shut down': 
                                break
                            msg  = 'pg_controldata: "Database cluster state: %s"\n' % m.group(1)
                            msg += 'Greenplum segment %s did not shutdown cleanly' % dir
                            if self.revert:
                                self.Log('WARN', msg)
                            else:
                                raise UpgradeError(msg)
            
        if self.cmd == 'MASTER' and self.datadirs:
            self.CallSlaves('CHKDOWN', self.config['SEG_PREFIX'])
            
        return True

    #------------------------------------------------------------
    def CheckUp(self, tryconn = False):
        '''
        Checks if one of the postmasters is up and running.
        Return the environment of the running server
        '''
        olddir = self.oldenv['MASTER_DATA_DIRECTORY']
        newdir = self.newenv['MASTER_DATA_DIRECTORY']
        env = None

        if olddir and os.path.exists('%s/postmaster.pid' % olddir):
            self.Log('DEBUG', 'CheckUp: found old postmaster running')
            env = self.oldenv
        if newdir and os.path.exists('%s/postmaster.pid' % newdir):
            self.Log('DEBUG', 'CheckUp: found new postmaster running')
            env = self.newenv

        if not env:
            self.Log('INFO', 'Postmaster not running')
            raise UpgradeError("Postmaster failed to start")

        if tryconn:
            try:
                self.Log('DEBUG', 'trying to establish connection to database')
                self.Log('DEBUG', 'user = %s, db = template1, port = %i, dir = %s'
                    % (self.user, self.masterport, self.sock_dir))
                conn = make_conn(self, self.user, 'template1', '', self.masterport,
                                 self.sock_dir)
            except Exception:
                raise UpgradeError("Found a postmaster.pid but postmaster " +
                                   "running")
            conn.close()
        return env

    #------------------------------------------------------------
    def Startup(self, env, utility=False):
        '''
        Starts up the specified database
        '''

        if self.dbup:
            raise UpgradeError('database already started')
        self.dbup = [env, utility]

        isu = ""
        if utility:
            isu = " in utility mode"
        if (env == self.oldenv):
            self.Log('INFO', 'Starting old Greenplum postmaster%s' % isu)
        else:
            self.Log('INFO', 'Starting new Greenplum postmaster%s' % isu)

        try:
            if utility:  cmd = 'gpstart -a -m'
            else:        cmd = 'gpstart -a'

            cmd += ' -l %s' % self.logdir

            locked = os.path.join(env['MASTER_DATA_DIRECTORY'],
                                  'pg_hba.conf'+LOCKEXT)
            try:
                if os.path.exists(locked):
                    env['PGUSER'] = MIGRATIONUSER
                    self.Log('DEBUG', "lockfile: '%s' exists" % locked)
                else:
                    self.Log('DEBUG', "lockfile: '%s' does not exist" % locked)

                self.Log('DEBUG', "Starting cluster with env = %s" % str(env))
                pid = subprocess.Popen(cmd, preexec_fn=os.setpgrp,
                                       env=env, shell=True,
                                       stdout=self.logfile, 
                                       stderr=self.logfile, 
                                       close_fds=True)
            finally:
                if os.path.exists(locked):
                    del env['PGUSER']

            # Ignore interupt requests until startup is done
            error = None
            retcode = None
            while retcode == None:
                try: 
                    retcode = pid.wait();

                except KeyboardInterrupt, e:
                    if not self.interupted:
                        self.Log('FATAL', '***************************************')
                        self.Log('FATAL', 'SIGINT-: Upgrade Aborted')
                        self.Log('FATAL', '***************************************')
                        self.Log('INFO',  'Performing clean abort')
                        self.interupted = True
                        error = e
                    else:
                        self.Log('INFO',  'SIGINT-: Still processing shutdown')

            if retcode < 0:
                raise UpgradeError("Startup terminated by signal");

            today = date.today().strftime('%Y%m%d')
            logname = os.path.join(self.logdir, 'gpstart_%s.log' % today)
            if retcode == 1:
                self.Log('WARN', '***************************************')
                self.Log('WARN', 'Warnings generated starting cluster')
                self.Log('WARN', 'Check %s for detailed warnings' % logname)
                self.Log('WARN', '***************************************')
            if retcode > 1:
                self.Log('FATAL', '***************************************')
                self.Log('FATAL', 'Startup failed with error code %d' % retcode)
                self.Log('FATAL', 'Check %s for detailed warnings' % logname)
                self.Log('FATAL', '***************************************')
                raise UpgradeError('Startup failed')

            # If we recieved an interupt, resignal it now that the startup is done
            if error: 
                raise error

        except OSError, e:
            self.Log('FATAL', str(e))
            raise UpgradeError('Startup failed')

        self.CheckUp();


    #------------------------------------------------------------
    def Shutdown(self):
        '''
        Stops the specified database
        '''
        if not self.dbup:
            return
        [env, utility] = self.dbup
        self.dbup = None

        dir = env['MASTER_DATA_DIRECTORY']
        if not os.path.exists('%s/postmaster.pid' % dir):
            self.Log('WARN', 
                     'Shutdown skipped - %s/postmaster.pid not found' % dir)
            return

        if (env == self.oldenv):
            self.Log('INFO', 'Shutting down old Greenplum postmaster')
        else:
            self.Log('INFO', 'Shutting down new Greenplum postmaster')

        locked = os.path.join(env['MASTER_DATA_DIRECTORY'],
                              'pg_hba.conf'+LOCKEXT)

        try:
            if utility:  cmd = 'gpstop -am -s'
            else:        cmd = 'gpstop -a -s'

            cmd += ' -l %s' % self.logdir

            locked = os.path.join(env['MASTER_DATA_DIRECTORY'],
                                  'pg_hba.conf'+LOCKEXT)
            try:
                if os.path.exists(locked):
                    env['PGUSER'] = MIGRATIONUSER
                    self.Log('DEBUG', 'handling locked shutdown')
                self.Log('DEBUG', 'shutting down with env: %s' % str(env))
                self.Log('DEBUG', 'shutting down with command: %s' % cmd)

                pid = subprocess.Popen(cmd, preexec_fn=os.setpgrp,
                                       env=env, shell=True,
                                       stdout=self.logfile, 
                                       stderr=self.logfile,
                                       close_fds=True)
            finally:
                if os.path.exists(locked):
                    del env['PGUSER']

            # Ignore interupt requests until shutdown is done
            error = None
            retcode = None
            while retcode == None:
                try: 
                    retcode = pid.wait();

                except KeyboardInterrupt, e:
                    if not self.interupted:
                        self.Log('FATAL', '***************************************')
                        self.Log('FATAL', 'SIGINT-: Upgrade Aborted')
                        self.Log('FATAL', '***************************************')
                        self.Log('INFO',  'Performing clean abort')
                        self.interupted = True
                        error = e
                    else:
                        self.Log('INFO',  'SIGINT-: Still processing shutdown')

            if retcode < 0:
                raise UpgradeError("Shutdown terminated by signal");
            today = date.today().strftime('%Y%m%d')
            logname = os.path.join(self.logdir, 'gpstop_%s.log' % today)
            if retcode == 1:
                self.Log('WARN', '***************************************')
                self.Log('WARN', 'Warnings generated stopping cluster')
                self.Log('WARN', 'Check %s for detailed warnings' % logname)
                self.Log('WARN', '***************************************')
            if retcode > 1:
                self.Log('FATAL', '***************************************')
                self.Log('FATAL', 'Shutdown failed with error code %d' % retcode)
                self.Log('FATAL', 'Check %s for detailed error' % logname)
                self.Log('FATAL', '***************************************')
                raise UpgradeError('Shutdown failed')

            # If we recieved an interupt, resignal it now that the startup is done
            if error: 
                raise error

        except OSError, e:
            self.Log('FATAL', str(e))
            raise UpgradeError('Shutdown failed')

        # If we are only doing --prepare then we may shutdown the newdb with the olddb
        # still running, so the CheckDown() shouldn't be run
        if self.execute:
            self.CheckDown();

    #------------------------------------------------------------
    def Revert(self):
        '''
        Revert to backup
        '''

        if not self.execute:
            raise UpgradeError('gpmigrator [-R] is not compatible with --prepare')

        try:
            if u.faultinjection == -1:
                raise UpgradeError("faultinjection=%d" % u.faultinjection)
            self.Shutdown()
            self.CheckDown()
        except BaseException, e:
            u.Log('FATAL', '***************************************')
            u.Log('FATAL', str(e))
            u.Log('FATAL', '***************************************')
            raise UpgradeError("Unable to REVERT\nShutdown the running " +
                               "database and rerun gpmigrator with '-R'")
            
        self.Log('INFO', 'Reverting to Backup')
        self.revert = True

        statefile = os.path.join(self.workdir, 'state')
        if not os.path.exists(statefile):
            self.Log('WARN', "  '%s' not found" % statefile)
            self.Log('INFO', 'Revert aborted')
            sys.exit(0)
        state = self.RunCmd('cat ' + statefile)

        needrevert = False
        for line in state.split('\n'):
            if line == 'BACKUP_VALID':
                needrevert = True

        hba   = os.path.join(self.masterdir, 'pg_hba.conf'+LOCKEXT)
        ident = os.path.join(self.masterdir, 'pg_ident.conf'+LOCKEXT)
        if os.path.exists(hba) or os.path.exists(ident):
            needunlock = True
        else:
            needunlock = False

        if (needrevert or needunlock) and len(self.hosts) < 1:

            # grab configuration information from generated init file
            initfile = os.path.join(self.workdir, 'gp_init_config')
            if not os.path.exists(initfile):
                self.Log('FATAL', "  '%s' not found" % initfile)
                self.Log('INFO', 'Revert aborted')
                sys.exit(1)

            # Extract from gp_init_config
            declare_re = re.compile('^declare\s+-a\s+([^= \t]*)\s*=\s*\(\s*(.*)')
            config = self.RunCmd('cat ' + initfile)
            datadirs = set()
            gathering = False
            for line in config.split('\n'):
                line = line.strip()

                if not gathering:
                    m = declare_re.match(line)
                    if m:
                        field = m.group(1)
                        stuff = m.group(2).strip()
                        if len(stuff) > 0 and stuff[-1] == ')':
                            value = stuff[:-1]
                        else:
                            value = '%s ' % stuff
                            gathering = True
                    else:
                        (field, value) = line.split('=')
                elif line[-1] == ')':
                    value = value.strip()
                    gathering = False
                else:
                    value = "%s %s" % (value, line)

                if not gathering:
                    if field in ['DATA_DIRECTORY', 'MIRROR_DATA_DIRECTORY']:
                        value = value.split()
                        datadirs = datadirs | set(value)
                    if field in ['PRIMARY_ARRAY', 'MIRROR_ARRAY']:
                        x_re = re.compile('[^:]+:\d+:([^:]+):\d+:\d+')
                        value = value.split()
                        dir = map(lambda x: x_re.match(x).group(1), value)
                        datadirs = datadirs | set(dir)

                    self.config[field] = value

            # remove final "WORKDIR/UPGRADEDIR/.*" from all the paths and convert to a 
            # space delimited string
            datadirs.discard('')
            datadirs = set(map(lambda(x): x[0:x.rfind('%s/%s/' % (WORKDIR, UPGRADEDIR))], datadirs))
            self.datadirs = ' '.join(datadirs)

            # read the hosts file
            hostfile = os.path.join(self.workdir, 'hosts')
            if not os.path.exists(hostfile):
                self.Log('FATAL', "  '%s' not found" % hostfile)
                self.Log('INFO', 'Revert aborted')
                sys.exit(1)
            hosts = self.RunCmd('cat ' + hostfile)
            self.hosts = hosts.split('\n')

        # Attempt revert
        if needrevert:
            self.Log('INFO', 'Restoring directories')
            self.DeepLink('REVERT')

        # Truncate the statefile
        # + Must occur AFTER actual Revert is processed
        open(statefile, 'w').truncate()

        if needunlock:
            self.ReleaseLockdown(self.oldenv)

        self.Startup(self.oldenv)
        self.Log('INFO', 'Removing upgrade user')
        self.Update('DROP USER IF EXISTS ' + MIGRATIONUSER)
        self.Shutdown()
        
        # done
        self.Log('INFO', 'Revert Successful')
        self.revert = False


    #------------------------------------------------------------
    def CheckVersions(self):
        '''
        Validates that the upgrade from old->new is okay
        '''

        # Log the OS type info
        os_type = os.uname()[0]
        os_ver  = os.uname()[2]
        self.Log('INFO', 'Operating System: %s %s' % (os_type, os_ver))

        # Log version checking
        self.Log('INFO', 'Checking version compatability')

        # --gp-version added in 3.2, but that doesn't help us determine
        # version information from old versions.
        #
        # Instead we take the hacky aproach of getting the version from
        # pg_config.h
        def getversion(home,env):
            binary = os.path.join(home, 'bin', 'pg_ctl')
            if not os.path.exists(binary):
                raise UpgradeError(binary + ' not found')

            try:
                return self.RunCmd('pg_ctl --gp-version', env=env)
            except CmdError:
                pass
            conf = '%s/include/pg_config.h' % home
            if os.path.exists(conf):
                cmd = 'grep PG_VERSION_STR ' + conf
                try:
                    return self.RunCmd(cmd, env=self.oldenv)
                except Exception, e:
                    self.Log('FATAL', str(e))
            raise UpgradeError('Unable to determine version of %s' % home)

        oldversion = getversion(self.oldhome, self.oldenv)
        newversion = getversion(self.newhome, self.newenv)

        # If we got a version, but it doesn't match our regex then it's probably
        # not a Greenplum database.
        version_re = re.compile('\(Greenplum Database\)? ([^\)]+) build ([^\)]+)')
        match = version_re.search(oldversion)
        if match: 
            oldversion = match.group(1)
            oldbuild = match.group(2)
            self.Log('INFO', 'Source Version: (Greenplum Database) %s build %s'
                     % (oldversion, oldbuild))
        else:
            raise UpgradeError('Source not a Greenplum Database: ' + oldversion)
        match = version_re.search(newversion)
        if match: 
            newversion = match.group(1)
            newbuild = match.group(2)
            self.Log('INFO', 'Target Version: (Greenplum Database) %s build %s'
                     % (newversion, newbuild))
        else:
            raise UpgradeError('Target not a Greenplum Database: ' + newversion)    

        def canonical_ver(v):
            '''
            Make a standard a.b.c.d greenplum database version string.
            Some releases don't look like this, but rather
            3.2 dev.
            '''
            if v == 'main': return MAIN
            vs = v.split('.')

            # all released versions have 4 integer version components
            # but dev builds may have anywhere from 2-4
            try:
                vs = map(int, vs)
            except:
                raise UpgradeError("Unrecognised Greenplum Version '%s'" % v)
            if len(vs) < 4:
                vs.extend([99,99,99,99])

            vs = map(str, vs)
            v = '.'.join(vs[:4])
            return v

        def reverse_canon_ver(v):
            '''
            Back the other way
            '''
            if v == MAIN: return "main"
            elif v == "3.2.99.99": return "3.2 dev"
            elif v == "3.1.99.99": return "3.1 dev"
            else: return v

        oldversion = canonical_ver(oldversion)
        newversion = canonical_ver(newversion)
        self.oldversion = oldversion
        self.newversion = newversion

        # Versions supported by this version of the upgrader
        #  [3.1.0.0 - 3.3.0.0] + (main) by default
        def checkversion(v, frm):
            if v == 'main': return
            vs = v.split('.')

            if frm: upstr = "upgrade"
            else: upstr = "downgrade"
            try:
                vs = map(int, vs)
            except:
                raise UpgradeError("Unrecognised Greenplum Version '%s'" % v)

            # Acceptable versions are 3.2.x - 3.3.x
            if ((vs[0] < 3) or (vs[0] == 3 and vs[1] < 2)):
                raise UpgradeError(
                    "Greenplum Version '%s' not supported for %s" % (v, upstr))
            if ((vs[0] > 3) or (vs[0] == 3 and vs[1] > 3)):
                raise UpgradeError(
                    "To upgrade to Greenplum Version '%s' use the %s tool "
                    "shipped with that release" % (v, upstr))
        
        checkversion(oldversion, True)
        checkversion(newversion, False)

        if newversion == oldversion:
            raise UpgradeError("Greenplum Database is already version %s"
                    % reverse_canon_ver(newversion))
        elif newversion[:3] == oldversion[:3]:
            raise UpgradeError("Upgrade not needed to go from version %s to version %s" % (reverse_canon_ver(oldversion), reverse_canon_ver(newversion)))
        if newversion == 'main' or newversion >= oldversion:
            self.upgrade = True
        else:
            self.upgrade = False    # Downgrade
            raise UpgradeError("Downgrade to Greenplum Database %s not supported from gpmigrator" % newversion[:3])

        if self.upgrade and newversion[:3] == "3.2":
            raise UpgradeError(
"""Upgrade from %s to %s not supported. Target version should be Greenplum Database 3.3""" % (reverse_canon_ver(oldversion), reverse_canon_ver(newversion)))

        if not self.method:
            oldvers = ["3.1"]
            if (self.oldversion[:3] in oldvers or
                self.newversion[:3] in oldvers):
                self.method = "dumprestore"
            else:
                self.method = "transform"

        self.Log('DEBUG', 'Using %s method for migration' % self.method)

        # Compare old version catalog number with the catalog in 
        # MASTER_DATA_DIRECTORY
        catalog_re = re.compile('Catalog version number: *(.*)')
        oldcat = self.RunCmd('postgres --catalog-version', env=self.oldenv)
        self.Log('INFO', "Source %s" % oldcat)
        newcat = self.RunCmd('postgres --catalog-version', env=self.newenv)
        self.Log('INFO', "Target %s" % newcat)

        control = self.RunCmd('pg_controldata ' + self.masterdir, env=self.oldenv)
        for line in control.split('\n'):
            m = catalog_re.match(line)
            if m:
                self.Log('INFO', "Data   %s " % line)
                if ((not self.revert and line != oldcat) or
                    (self.revert and line != oldcat and line != newcat)):
                    self.Log('DEBUG', 'catalog mismatch: expected %s, found %s'
                             % (oldcat, line))
                    msg = 'Catalog in %s does not match source binary' % self.masterdir
                    raise UpgradeError(msg)
                break

        # For the moment everything goes:
        #   - Additional checks will be made once the old database is up
        self.Log('INFO', 'Versions are compatible')        


    #------------------------------------------------------------
    def RemoveDirectories(self, force=False):
        '''
        Removes upgrade/ and backup/ directories on all segments
        '''

        # If force is set then we remove the directories regardless of
        # whether we created them or they were created by another process.
        # If force is not set then we will throw an exception when we are
        # done if there were directories that we failed to remove.
        doerror = False
        if self.cmd == 'MASTER':
            self.Log('INFO', 'Removing temporary directories')
            self.CallSlaves('RMDIR', force, self.config['SEG_PREFIX'])
            datadirs = [self.root]
        else:
            datadirs = self.datadirs

        for d in filter(os.path.exists, datadirs):
            dir = os.path.join(d, WORKDIR)
            if not os.path.exists(dir):
                continue

            flag = os.path.join(dir, 'flag')
            if (not force) and os.path.exists(flag):
                try:
                    dpid = self.RunCmd('cat ' + flag)
                    dpid = int(dpid)
                except Exception, e:
                    self.Log('WARN', 'Read error on file:  ' + str(e))
                    doerror = True
                    continue

                if dpid != self.pid:
                    self.Log('WARN', 'Directory %s owned by pid %s' 
                             % (dir, dpid))
                    doerror = True
                    continue
                
            # Regardless of the setting of force, if there is an active 
            # process running, we won't remove the directory.
            running = self.RunCmd('find %s -name postmaster.pid -print' % dir)
            if (running):
                self.Log('INFO', running)
                self.Log('FATAL', 'Active processes running')
                doerror = True
            else:
                self.RunCmd('rm -rf ' + dir)

        # We hold off throwing the error until the end, because we want to make
        # sure we removed all of our own directories.
        if doerror:
            raise UpgradeError('Failed to remove old upgrade directories')

    #------------------------------------------------------------
    def CreateDirectories(self):
        '''
        Creates the upgrade/ and backup/ directories on all segments
        '''

        if self.cmd == 'MASTER':

            dirs_exist = False
            try: 
                self.CallSlaves('CHKDIR', self.config['SEG_PREFIX'])
            except UpgradeError, e:
                dirs_exist = True
            if os.path.exists(self.workdir):
                dirs_exist = True
            if dirs_exist:
                self.RemoveDirectories(force=True)
            

            self.Log('INFO', 'Creating temporary directories')                

            # Have the slaves create their directories
            self.CallSlaves('MKDIR', self.config['SEG_PREFIX'])
            
            # Additionally we need upgrade/ and backup/ under the masterdir
            # if the masterdir is located in a different location or on
            # another host.
            if (not os.path.exists(self.workdir)):
                try:
                    os.mkdir(self.workdir)
                    self.RunCmd('chmod 700 %s' % self.workdir)
                    flag = open(os.path.join(self.workdir, 'flag'), 'w')
                    flag.write('%s\n' % str(self.pid))
                    flag.close()

                    d = os.path.join(self.workdir, UPGRADEDIR)
                    os.mkdir(d)
                    self.RunCmd('chmod 700 %s' % d)

                    d = os.path.join(self.workdir, BACKUPDIR)
                    os.mkdir(d)
                    self.RunCmd('chmod 700 %s' % d)


                except Exception, e:
                    self.Log('FATAL', str(e))
                    raise UpgradeError('Failed to create upgrade directories')
                
            else:
                # if it does exist then chances are very good that one of
                # the slaves just created it since we checked for it before
                # we called the slaves.  But there is a remote chance that
                # someone else created the directory in the meantime.  
                # -- check the flag to be safe (not foolproof).
                if (not os.path.exists(os.path.join(self.workdir, 'flag')) or
                    self.RunCmd('cat %s/flag' % self.workdir) != str(self.pid)):
                    raise UpgradeError('Failed to create upgrade directories')

            # Finally now that we have those directories we'll make a state file
            self.state = open('%s/state' % self.workdir, 'w')

            self.Update("COPY gp_configuration to '%s/gp_config'" % self.workdir)

        else:
            if self.cmd != 'MKDIR': 
                raise Exception(self.cmd + ' != MKDIR]')

            for d in filter(os.path.exists, self.datadirs):
                # Creating directories is an atomic operation, if mkdir 
                # succeeds then it did not exist previously making it ours
                # This prevents mulitiple upgrades running simultaneously.
                workpath = os.path.join(d, WORKDIR)
                os.mkdir(workpath)
                self.RunCmd('chmod 700 %s' % workpath)

                # Claim it in the name of our parent process.  We make use of
                # this flag during tear down to confirm that we created it.
                flag = open(os.path.join(workpath, 'flag'), 'w')
                flag.write('%s\n' % str(self.pid))
                flag.close()

                upgradepath = os.path.join(workpath, UPGRADEDIR)
                os.mkdir(upgradepath)
                self.RunCmd('chmod 700 %s' % upgradepath)

                # Repeat for the backup directory
                backuppath = os.path.join(workpath, BACKUPDIR)
                os.mkdir(backuppath)
                self.RunCmd('chmod 700 %s' % backuppath)
                        

    #------------------------------------------------------------
    def GenerateConfigFiles(self):
        '''
        Creates 'hosts' and 'gp_init_config' files
        '''

        self.Log('INFO', 'Generating config files')        
        resetports = None
        try: 
            self.CheckDown()
            resetports = False
        except:
            resetports = True

        if not resetports:
            self.new_master_port      = self.config['MASTER_PORT']
            self.new_port_base        = self.config['PORT_BASE']
            if len(self.mirrors) > 0:
                self.new_mirror_port_base = self.config['MIRROR_PORT_BASE']
        else:

            if not (self.new_master_port and
                    self.new_port_base   and
                    (self.new_mirror_port_base or len(self.mirrors) == 0)):
                print '''
------------------------------------------------------------------------
To prepare the upgrade instance while the main system is running it must 
be started on different ports.  

This may be specified on the commandline with:
     --master_port, --port_base, and --mirror_port_base
------------------------------------------------------------------------
'''
                
                # If running nohup then we can't ask for input
                if not sys.stdin.isatty():
                    raise UpgradeError('Unable to determine new ports')

                def getint(prompt):
                    while True:
                        value = raw_input(prompt)
                        try:    return int(value)
                        except: pass

                if not self.new_master_port:
                    self.new_master_port = getint('MASTER_PORT> ')
                if not self.new_port_base:
                    self.new_port_base = getint('PORT_BASE> ')
                if len(self.mirrors) > 0 and not self.new_mirror_port_base:
                    self.new_mirror_port_base = getint('MIRROR_PORT_BASE> ')


        # Write host list file
        host_file = os.path.join(self.workdir, 'hosts')
        o = open(host_file, 'w')
        for host in self.hosts:
            o.write(host + '\n')
        o.close()

        # Write our new gp_init_config file
        gp_init_config = os.path.join(self.workdir, 'gp_init_config')
        o = open(gp_init_config, 'w')
        o.write('ARRAY_NAME="%s"\n'          % self.config['ARRAY_NAME'])
        o.write('SEG_PREFIX=%s\n'            % self.config['SEG_PREFIX'])
        o.write('TRUSTED_SHELL=%s\n'         % self.config['TRUSTED_SHELL'])
        o.write('CHECK_POINT_SEGMENTS=%s\n'  % self.config['CHECKPOINT_SEGMENTS'])
        o.write('ENCODING=%s\n'              % self.config['CLIENT_ENCODING'])

        o.write('QD_PRIMARY_ARRAY=%s:%d:%s:1:-1\n' %
                (self.config['MASTER_HOSTNAME'],
                 self.new_master_port,
                 self.newmaster))

        o.write('declare -a PRIMARY_ARRAY=(\n')
        
        for s in self.segments:
            (a,b) = os.path.split(s['datadir'])
            dir = os.path.join(a, WORKDIR, UPGRADEDIR, b)
            port = s['port'] - self.config['PORT_BASE'] + self.new_port_base
            o.write('%s:%d:%s:%d:%d\n' % 
                    (s['hostname'], port, dir, s['dbid'], s['content']))
        o.write(')\n')

        if len(self.mirrors) > 0:
            o.write('declare -a MIRROR_ARRAY=(\n')
            for s in self.mirrors:
                (a,b) = os.path.split(s['datadir'])
                dir = os.path.join(a, WORKDIR, UPGRADEDIR, b)
                port = s['port'] - self.config['MIRROR_PORT_BASE'] + self.new_mirror_port_base
                o.write('%s:%d:%s:%d:%d\n' % 
                        (s['hostname'], port, dir, s['dbid'], s['content']))
            o.write(')\n')

        o.close()
        self.Log('INFO', 'Configuration files generated')


    #------------------------------------------------------------
    def ExtractInfo(self):
        '''
        Get all the information we need from the old instance
        '''

        # Determine if there are any invalid segments
        self.Log('INFO', 'Checking that all segments are valid')
        invalid = self.Select(
        '''
           SELECT hostname, datadir FROM gp_configuration
           WHERE not valid
        ''', forceutility=True)
        if len(invalid) > 0:
            for item in invalid:
                self.Log('FATAL', 'INVALID SEGMENT: %s:/%s' % 
                         (item['hostname'], item['datadir']));
            raise UpgradeError('Cannot upgrade database with invalid segments')


        self.Log('INFO', 'Creating list of databases')
        databases = self.Select("SELECT datname from pg_database WHERE datname != 'template0'")

        if self.method == 'dumprestore':
            # Look for dropped columns that we do not know how to deal with
            #
            # The query lists the dropped attributes for which no suitable reconstruction
            # type exists in pg_type.  This will happen for user-defined types that have 
            # been dropped.  (This query is compatible with a similar query used in pg_dump
            # for finding a reconstruction match for dropped attributes with user-defined
            # types.
            self.Log('INFO', 'Checking for dropped columns')
            for db in databases:
                unsupportedDropped = self.Select( 
                        '''
                            SELECT 
                                current_database() as database,
                                pg_catalog.quote_ident(nspname) || '.' ||
                                pg_catalog.quote_ident(relname) AS table,
                                attnum,
                                attlen,
                                attbyval,
                                attstorage,
                                attalign,
                                atttypmod,
                                attndims,
                                reltoastrelid != 0 AS istoasted
                            FROM 
                                pg_catalog.pg_attribute, 
                                pg_catalog.pg_class, 
                                pg_catalog.pg_namespace
                            WHERE 
                                  attisdropped
                              AND attnum >= 0
                              AND attrelid = pg_catalog.pg_class.oid
                              AND relnamespace = pg_catalog.pg_namespace.oid
                              AND (attlen, attbyval, attalign, attstorage) NOT IN 
                                    (SELECT typlen, typbyval, typalign, typstorage 
                                     FROM pg_catalog.pg_type 
                                     WHERE typisdefined AND typtype ='b')
                            ORDER BY
                                attrelid, attnum;
                        ''', db=db)
                if unsupportedDropped:
                    for row in unsupportedDropped:
                        self.Log('FATAL', 
                                 'Unrecognized dropped column in database "%(database)s" - table %(table)s '
                                 '[%(attnum)d]: len=%(attlen)d, byval=%(attbyval)s, storage=%(attstorage)s, '
                                 'align=%(attalign)s, typmod=%(atttypmod)d, ndims=%(attndims)d, istoasted=%(istoasted)s'
                                 % row)
                    raise UpgradeError("non-upgradable dropped columns detected")

        # Look for an existing user named MIGRATIONUSER
        self.Log('INFO', 'Checking gpmigrator user')
        upgradeuser = self.Select(
            "SELECT count(*)::numeric FROM pg_user " +
            "WHERE usename = '%s'" % MIGRATIONUSER)
        if upgradeuser[0] > 0:
            self.Log('WARN', "Database user '%s' already exists" % MIGRATIONUSER)
            self.Update('DROP USER ' + MIGRATIONUSER)
            #raise UpgradeError("Database user 'gpmigrator' already exists")

        # If this is a downgrade, verify that we have no objects that can not
        # be downgraded:
        #    - append only tables
        #    - new style partitions
        if (not self.upgrade and self.newversion < '3.2.0.0' and 
            self.oldversion >= '3.2.0.0'):
            self.Log('INFO', 'Checking for partitioning and append only tables')
            c = 0
            for db in databases:
                c = self.Select('SELECT COUNT(*)::numeric FROM pg_partition', db=db)
                if c[0] > 0:
                    raise UpgradeError(
'''
-------------------------------------------------------
Cannot downgrade a database with 3.2 style partitioning     <<<<<
-------------------------------------------------------
''')
                c = self.Select("SELECT COUNT(*)::numeric FROM pg_appendonly", db=db)
                if c[0] > 0:
                    raise UpgradeError(
'''
---------------------------------------------------
Cannot downgrade a database with append only tables     <<<<<
---------------------------------------------------
''')

        if (not self.upgrade and self.newversion < '3.3.0.0' and
            (self.oldversion >= '3.3.0.0' or self.oldversion == 'main')):
            c = 0
            for db in databases:
                c = self.Select('SELECT COUNT(*)::numeric FROM pg_catalog.pg_aocs;', db=db)
                if c[0] > 0:
                    raise UpgradeError(
'''
---------------------------------------------------
Cannot downgrade a database with 3.3 column storage    <<<<<
---------------------------------------------------
''')

        # Extract the information needed to construct a gp_init_config file
        self.Log('INFO', 'Extracting configuration information')
        gp_config = self.Select(
        '''
           SELECT content::numeric, definedprimary, dbid::numeric, hostname, port::numeric, datadir 
           FROM gp_configuration 
           ORDER BY content
        ''')

        # check multi-home and get the hostname
        h = {}
        for x in gp_config:
            if x['content'] < 0: continue

            if x['hostname'] not in h:
                cmd = 'ssh %s hostname' % x['hostname']
                x['host'] = self.RunCmd(cmd)
                h[x['hostname']] = x['host']
            else:
                x['host'] = h[x['hostname']]
                
        master = filter(lambda(x): x['content'] < 0 and 
                                   x['definedprimary'], gp_config);
        standbymaster = filter(lambda(x): x['content'] < 0 and 
                                      not x['definedprimary'], gp_config);
        segments = filter(lambda(x): x['content'] >= 0 and 
                                     x['definedprimary'], gp_config);
        mirrors = filter(lambda(x): x['content'] >= 0 and 
                                 not x['definedprimary'], gp_config);
        self.segments = segments
        self.mirrors = mirrors
        
        # Internal sanity checking
        if len(master) != 1:
            raise UpgradeError('Too many master segments, aborting')
        if len(segments) == 0:
            raise UpgradeError('No segments found')
        if len(standbymaster) > 0:
            raise UpgradeError('Cannot upgrade while standbymaster is running')

        master = master[0]

        # ARRAY_NAME
        arrayname = self.Select('SELECT gpname FROM gp_id')
        self.config['ARRAY_NAME'] = arrayname[0]

        # HOSTS can be used to build a MACHINE_LIST_FILE
        # In 3.2 and later gpinitsystem can gracefully handle multiple
        # hostnames per host, but in 3.1 we have to generate a config
        # file with a single hostname per host - which means that we
        # will lose any NIC information during downgrade.
        if self.upgrade:
            self.hosts = h.keys()
        else:
            self.hosts = list(set(h.values()))

        # Determine PORT_BASE, (min of segments - 1)
        port_base = min(map(lambda(x): x['port'], segments))-1
        self.config['PORT_BASE'] = port_base

        # Determine DATA_DIRECTORY, use any host
        # We also keep track of a SET() of data and mirror dirs without
        # the /upgrade suffix
        dirs = set();
        #data_dir = ''
        for seg in segments:
            newdir = seg['datadir'][0:seg['datadir'].rindex('/')]
            dirs.add(newdir)
            if (seg['host'] != segments[0]['host']): 
                continue
            # data_dir = data_dir + os.path.join(str(newdir), WORKDIR, UPGRADEDIR) + ' '
        # self.config['DATA_DIRECTORY'] = data_dir

        # MASTER_HOSTNAME, super easy
        self.config['MASTER_HOSTNAME'] = master['hostname']

        # MASTER_DIRECTORY, also easy - we already set it up
        self.config['MASTER_DIRECTORY'] = self.newmaster

        # MASTER_PORT, super easy
        self.config['MASTER_PORT'] = master['port']

        # TRUSTED_SHELL, set manually since there's only one supported value
        self.config['TRUSTED_SHELL'] = 'ssh'

        # CHECK_POINT_SEGMENTS 
        self.config['CHECKPOINT_SEGMENTS'] = \
            self.Select('show checkpoint_segments')[0]

        # ENCODING
        self.config['CLIENT_ENCODING'] = \
            self.Select('show client_encoding')[0]

        # LOCALE
        self.config['LOCALE'] = \
            self.Select('show lc_ctype')[0]

        # MAX_CONNECTIOS
        self.config['MAX_CONNECTIONS'] = \
            self.Select('show max_connections')[0]

        # Handle mirrors, if present
        mirror_dirs = set();
        if len(self.mirrors) > 0:

            # Determine PORT_BASE, (min of segments - 1)
            port_base = min(map(lambda(x): x['port'], mirrors))-1
            self.config['MIRROR_PORT_BASE'] = port_base

            # MIRROR_DATA_DIRECTORY, use any mirror
            # mirror_data_dir = ''
            for seg in mirrors:
                newdir = seg['datadir'][0:seg['datadir'].rindex('/')]

                if newdir in dirs:
                    raise UpgradeError(
'''
Conflict between data directory and mirror data directory.
     (%s)
This issue must be resolved before upgrade can complete.
''' % newdir)
                mirror_dirs.add(newdir)

                if (seg['host'] != mirrors[0]['host']): 
                    continue
                # mirror_data_dir = mirror_data_dir + os.path.join(str(newdir), 'upgrade') + ' '
            # self.config['MIRROR_DATA_DIRECTORY'] = mirror_data_dir

        # standby masters
        #  - currently not upgraded - reinit them once upgrade is complete

        # We collected a set of data and mirror directories, convert it back
        # to a string.
        self.datadirs = ''
        for d in dirs | mirror_dirs:
            self.datadirs = '%s%s ' % (self.datadirs, d)
        self.datadirs = self.datadirs.strip()

        self.Log('INFO', 'Configuration acquired')


    def copy_rewrite_hba(self, frm, to, upgrdfmt):
        '''
        Between 3.2 and 3.3 we have a change in pg_hba.conf. The differences
        are:
        - "ident sameuser" becomes "ident"
        - "ident <map name>" becomes "ident map=<map name>"
        '''
        f = open(frm, 'r')
        t = open(to, 'w')
        self.Log('DEBUG', 'writing %s to %s for upgrade = %s'
                 % (frm, to, str(upgrdfmt)))
        for line in f:
            # translate to new pg_hba.conf format
            if upgrdfmt:
                line = re.compile('ident sameuser$').sub('ident', line)
                line = re.compile('ident (?!map=)(.*)$').sub('ident map=\\1', line)
            else:
                line = re.compile('ident$').sub('ident sameuser', line)
                line = re.compile('ident map=(.*)$').sub('ident \\1', line)

            self.Log('DEBUG', 'writing to %s line %s' % (to, line))
            t.write(line)
        f.close()
        t.close()

    def move_rewrite_hba(self, frm, to, upgrade):
        self.copy_rewrite_hba(frm, to, upgrade)
        os.unlink(frm)

    #------------------------------------------------------------
    def SetupLockdown(self):
        '''
        Change pg_hba.conf to disallow access to everyone except the
        upgrade user.
        '''

        os_type = os.uname()[0].lower()

        if self.cmd == 'MASTER':
            self.Log('INFO', 'Locking database')
            self.CheckUp()
            [env, utility] = self.dbup;
            if utility:
                raise UpgradeError("Cannot lock database in utility mode")

            self.Log('INFO', '...Creating upgrade user')
            self.Update('DROP USER IF EXISTS ' + MIGRATIONUSER)
            self.Update('CREATE USER %s with superuser' % MIGRATIONUSER)

            self.Log('INFO', '...Creating pg_hba.conf ')

            # To write out a new pg_hba.conf we need to know all the ip 
            # addresses that the master identifies with.
            #
            # If we re-enable segment locking then this will need to be
            # passed to the segments as well.
            if os_type == 'sunos':
                cmd = 'ifconfig -a inet'
            else:
                cmd = 'ifconfig'        
            ifconf = self.RunCmd(cmd)
            ip_re = re.compile('inet (?:addr:)?(\d+\.\d+\.\d+\.\d+)')
            ip = []
            for line in ifconf.split('\n'):
                m = ip_re.search(line)
                if m:
                    ip.append(m.group(1))

            # Currently we only lock the MASTER node
            #
            # locking down the segments requires having gpstart
            # pass the PGUSER to the segments otherwise the segments
            # don't have the permissions to startup.
            # 
            # This leaves a "hole" in the lockdown that still allows 
            # utility connections to the segments.
            hba   = os.path.join(self.masterdir, 'pg_hba.conf')
            ident = os.path.join(self.masterdir, 'pg_ident.conf')

            if env == self.oldenv or not os.path.exists(hba + LOCKEXT): 
                # pre-upgrade database makes a backup of files and then
                # writes a new one

                # Solaris doesn't support ident authentication
                if os_type != 'sunos':
                    self.RunCmd('mv -f %s %s' % (ident, ident+LOCKEXT))
                    file = open(ident, 'w')
                    file.write('%s %s %s\n' % 
                               (MIGRATIONUSER, self.user, MIGRATIONUSER))
                    file.close()

                self.RunCmd('mv -f %s %s' % (hba, hba+LOCKEXT))
                file = open(hba, 'w')
                if os_type == 'sunos':
                    file.write('local all %s trust\n' % MIGRATIONUSER)
                else:
                    if self.oldversion < '3.3.0.0':
                        file.write('local all %s ident %s\n' 
                                   % (MIGRATIONUSER, MIGRATIONUSER))
                    else:
                        file.write('local all %s ident map=%s\n'
                                   % (MIGRATIONUSER, MIGRATIONUSER))
                for addr in ip:
                    file.write('host all %s %s/32 trust\n'
                               % (MIGRATIONUSER, addr))
                file.close()

            if env == self.newenv:
                # upgrade database just copies all locking information 
                # from the pre-upgrade database which should already be
                # locked
                dir = self.newmaster

                self.copy_rewrite_hba(hba, os.path.join(dir, 'pg_hba.conf'),
                                      self.upgrade)
                self.RunCmd('cp -f %s %s' % (ident, dir))

                # Grab the original versions to (if any)
                if os.path.exists(hba + LOCKEXT):
                    self.copy_rewrite_hba(hba+LOCKEXT,
                                          os.path.join(dir,
                                                       'pg_hba.conf'+LOCKEXT),
                                          self.upgrade)
                if os.path.exists(ident + LOCKEXT):
                    self.RunCmd('cp -f %s %s' % (ident+LOCKEXT, dir))

            # With the new lockfiles in place force the server to reload
            self.Log('INFO', '...Syncing')
            self.Log('DEBUG', 'calling gpstop -u with env: %s' % str(env))
            self.RunCmd('gpstop -u -a -l %s' % self.logdir, env=env)
            self.Log('INFO', 'Database Locked')


    def CheckClusterReady(self, databases, port):
        '''
        Pre-flight checks
        '''
        for db in databases:
            xact = self.Select("SELECT count(*)::numeric FROM " +
                               "pg_prepared_xacts",
                               db=db['dbname'], port=port);
            if xact[0] > 0:
                raise UpgradeError("Database contains prepared transactions");

    #------------------------------------------------------------
    def ReleaseLockdown(self, env):
        '''
        Revert pg_hba.conf to pre-lockdown state
        '''

        # Two main cases:
        #   1) Release lockdown on old environment
        #   2) Release lockdown on newly installed environment
        # Both cases have the database installed under MASTER_DATA_DIRECTORY
        # so we actually treat them exactly the same

        if self.cmd == 'MASTER':

            # If we haven't setup "config" yet then there isn't anything to do
            if 'SEG_PREFIX' not in self.config:
                return

            # If we are doing "prepare" then we won't have locked anything
            if not self.execute:
                return

            self.Log('INFO', 'Unlocking database')

            # See comment about disabling lockdown on segments in SetupLockdown()
            # self.CallSlaves('UNLOCK', self.config['SEG_PREFIX'])

            seg_prefix = self.config['SEG_PREFIX'] + '-'
            datadirs   = [self.root]
        else:
            seg_prefix = self.option
            datadirs   = self.datadirs

        seg_re = re.compile('^%s\d+$' % seg_prefix)
        for d in datadirs:

            # Find the segments for this directory
            for seg in os.listdir(d):
                if seg_re.match(seg):
                    hba   = os.path.join(d, seg, 'pg_hba.conf')
                    ident = os.path.join(d, seg, 'pg_ident.conf')
                    if os.path.exists(hba + LOCKEXT):
                        forward = False
                        if self.upgrade and env == self.newenv:
                            forward = True
                        elif not self.upgrade and env == self.oldenv:
                            forward = True
                        self.move_rewrite_hba(hba+LOCKEXT, hba, forward)

                    if os.path.exists(ident + LOCKEXT):
                        self.RunCmd('mv -f %s %s' % (ident+LOCKEXT, ident))


        # Resource the conf files if the database is up.
        if self.dbup:
            userset = False
            if env == self.newenv:
                userset = True
                env['PGUSER'] = MIGRATIONUSER

            self.RunCmd('gpstop -u -l %s' % self.logdir, env=env)

            if userset:
                del env['PGUSER']

        # We would love to actually delete the user, but it's not actually
        # safe to do so here because we unlock the source database before we
        # are done with the upgrade.
        return
 

    #------------------------------------------------------------
    def BuildMappings(self):
        '''
        Constructs the mappings of user objects to data files.
        It is called twice over the course of the upgrade, the first time it
        extracts mappings from the olddb, the second time it extracts mappings
        from the new db and joins the two mappings together.

        For the 3.2 -> 3.3 upgrade, the mappings should be identical so we just 
        copy the source mapping to the target mapping.
        '''
        if self.cmd == 'MASTER':
            seg_prefix = self.config['SEG_PREFIX'] + '-'
            [env, utility] = self.dbup
            if (env == self.oldenv):
                self.Log('INFO', 'Building original oid Mappings')
                type = 'source'
                datadirs = [ self.root ]
            else:
                self.Log('INFO', 'Building upgraded oid Mappings')
                if self.method == "dumprestore":
                    type = 'target'
                    datadirs = [ os.path.join(self.workdir, UPGRADEDIR) ]
                else:
                    type = 'copy'
                    datadirs = [ self.root ]

            # Currently we only build target mappings on the dummy segment,
            # for 3.1 -> 3.x upgrades, which resides on the same machine as
            # the master, it will then copy for all other segments as needed
            #
            # Source mappings are still done by each actual segment.
            # 
            # For 3.2 -> 3.x, push the copy target to the segs
            if type == 'source' or type == 'copy':
                self.CallSlaves('MAPPINGS', self.config['SEG_PREFIX'], type)
        else:
            seg_prefix = self.option
            type       = self.option2
            datadirs   = self.datadirs

        errors = 0
        seg_re  = re.compile('^(%s\d+|dummyseg)$' % seg_prefix)

        threads = []
        for d in datadirs:
            for seg in os.listdir(d):
                if seg_re.match(seg):
                    
                    # if this is a copy, exit early
                    if type == 'copy':
                        source = os.path.join(d, WORKDIR, '%s_source_mapping' % seg)
                        target = os.path.join(d, WORKDIR, '%s_target_mapping' % seg)
                        self.Log('DEBUG', 'd = %s' % d)
                        self.Log('DEBUG', "copying %s to %s" % (source, target))
                        self.RunCmd("cp -f %s %s" % ( source, target ))
                        continue

                    # The directory for this segment
                    # We keep both mapping files in the work directory
                    dir = os.path.join(d, seg)
                    if type == 'source':
                        logdir = os.path.join(d, WORKDIR)
                    else:
                        logdir = os.path.split(d)[0]   # back up one directory
                
                    # Open the mapping file
                    mapfilename = os.path.join(logdir, '%s_%s_mapping' % (seg, type))

                    # Find the last line in the conf file that matches our
                    # expression
                    conf = os.path.join(dir, 'postgresql.conf')
                    def getconf(x):
                        conf_re  = re.compile('^\s*%s\s*=\s*(\d+)' % x)
                        conf_str = self.RunCmd('grep %s %s' % (x, conf))
                        value = None
                        for line in conf_str.split('\n'):
                            match = conf_re.search(line)
                            if match:
                                value = int(match.group(1))
                        return value

                    # Find the port for this segment:
                    port = getconf('port')
                    if port == None:
                        raise UpgradeError('Could not determine port from ' +
                                           '%s/postgresql.conf' % dir)

                    # Get a list of databases
                    databases = self.Select(
                    '''
                       SELECT
                          datname        as dbname,
                          oid            as oid
                       FROM pg_database 
                       WHERE datname != 'template0'
                       ORDER BY dbname
                    ''', port=port)

                    self.CheckClusterReady(databases, port)


                    # Build up the list of mapping objects
                    rks = ['a', 'r', 't', 'i', 'S']
                    if self.method != "dumprestore":
                        rks.append('o')

                    rkstr = ', '.join(map(lambda x: "'%s'" % x, rks))

                    oidmap = {}
                    for db in databases:
                        oidmap[db['oid']] = [db['dbname']]
                        oids = self.Select(
                        '''
                           SELECT
                              case when parent.oid is not null
                                   then n.nspname || '.' || pn.nspname || '.' ||
                                        parent.relname || '_' || c.relkind
                                   else n.nspname || '.' || c.relname || '_' || c.relkind
                              end as name,
                              c.relfilenode as filenode,
                              c2.relfilenode as toast,
                              c3.relfilenode as toast_index
                           FROM 
                              pg_namespace n,
                    (SELECT oid, *, 
            substring(relname from '^(?:pg_bm_|pg_aoseg_)([0-9]+)') as parentoid
                               from pg_class) c 
                left outer join pg_class c2 on c.reltoastrelid=c2.oid
                left outer join pg_class c3 on c2.reltoastidxid=c3.oid
                left outer join pg_class parent on parent.oid = c.parentoid
                left outer join pg_namespace pn on parent.relnamespace = pn.oid
                           WHERE c.relkind in (%s)
                             AND c.relnamespace = n.oid 
                             AND n.nspname !~ 'pg_temp.*'
                             AND n.nspname != 'pg_toast'
                             AND n.nspname != 'pg_catalog'
                             AND n.nspname != 'information_schema'
                           ORDER BY name;
                        ''' % rkstr, db=db['dbname'], port=port)

                        oidmap[db['oid']].append(oids)

                    t = MappingsWorker(self, dir, mapfilename, oidmap)
                    t.start()
                    self.Log('DEBUG', 'started MappingsWorker thread: %s' % t.getName())
                    threads.append(t)
                    if len(threads) % PARALLELISM == 0:
                        for th in threads:
                            th.join()
                            if th.errors:
                                self.Log('FATAL', 'error encountered in mappings thread')
                        threads = []
                        
        # Wait for all threads to be done before proceding to next stage
        for th in threads:
            th.join()
            if th.errors:
                self.Log('FATAL', 'error encountered in mappings thread')
            threads = []

        if errors > 0:
            raise UpgradeError('You must drop or reindex malformed objects prior to upgrade')

    #------------------------------------------------------------
    def DumpStatistics(self):
        '''
        Executes queries and creates files in the upgrade directory 'pg_stat_*.csv'
        '''

        self.Log('INFO', 'Exporting Statistics')

        databases = self.Select('''
        SELECT datname from pg_database
        WHERE datname != 'template0' 
        ORDER BY datname''')

        # Since COPY doesn't have an append option we write out N files
        count = 1
        for db in databases:
            self.Update('''
            COPY (
              SELECT current_database(),        n.nspname,      c.relname,     
                 t.typname,      c.relpages,    c.reltuples, 
                 s.staattnum,    s.stanullfrac, s.stawidth,     s.stadistinct,
                 s.stakind1,     s.stakind2,    s.stakind3,     s.stakind4,
                 s.staop1::regoperator,         s.staop2::regoperator,
                 s.staop3::regoperator,         s.staop4::regoperator,
                 s.stanumbers1,  s.stanumbers2, s.stanumbers3,  s.stanumbers4,
                 s.stavalues1,   s.stavalues2,  s.stavalues3,   s.stavalues4
              FROM   pg_class c
                     join pg_namespace n on (c.relnamespace = n.oid) 
                     left outer join pg_attribute a on (c.oid = a.attrelid) 
                     left outer join pg_type t on (a.atttypid = t.oid)
                     left outer join pg_statistic s on (s.starelid = c.oid and s.staattnum = a .attnum)
              WHERE  n.nspname !~ '(pg_.*|information_schema)'
              ORDER BY n.nspname, c.relname, s.staattnum
              ) to '%s/pg_stat_%d.csv' with CSV ESCAPE E'\\\\' ''' % \
                            (self.workdir, count), db=db)
            count += 1


    #------------------------------------------------------------
    def CheckCatalog(self):
        '''
        Validate that the created catalog looks good
        '''
        self.Log('INFO', 'Checking Catalog')
        self.CheckUp()
        [env, utility] = self.dbup
        databases = self.Select(
            '''
               SELECT datname FROM pg_database
               WHERE datname != 'template0'
               ORDER by datname
            ''')

        locked = os.path.join(env['MASTER_DATA_DIRECTORY'],
                              'pg_hba.conf'+LOCKEXT)
        if os.path.exists(locked):
            user = MIGRATIONUSER
        else:
            user = env['USER']

        exec_cmd = libdir + '/gpcheckcat -p %d -U %s -B %i ' % \
            (self.masterport, user, PARALLELISM)

        for db in databases:
            cmd = exec_cmd + db
            self.Log('INFO', '...Checking ' + db)

            self.Log('DEBUG', "CMD: " + cmd)

            outfilename = os.path.join(self.workdir, 'gpcheckcat_%s.log' % db)
            outfilename = outfilename.replace(' ', '_')
            outfile = open(outfilename, 'w')

            pipe = subprocess.Popen(cmd, shell=True, stdout=outfile, stderr=outfile,close_fds=True)
            retcode = pipe.wait()

            if retcode < 0:
                raise UpgradeError('Catalog Check terminated by signal')
            if retcode > 0:
                raise UpgradeError('Catalog Check Failed - see %s for details' % outfilename)

    #------------------------------------------------------------
    def DumpSchema(self):
        '''
        Runs pgdump_all to dump the schema.
        Run on the master in utility mode.
        '''
        self.Log('INFO', 'Exporting schema')

        locked = os.path.join(self.oldenv['MASTER_DATA_DIRECTORY'], 
                              'pg_hba.conf'+LOCKEXT)
        if os.path.exists(locked):
            user = MIGRATIONUSER
        else:
            user = self.oldenv['USER']

        # We use the environment of the most recent instance so that
        # we always use the most recent version of pg_dumpall.
        if self.upgrade:
            env = self.newenv
        else:
            env = self.oldenv

        cmd  = 'pg_dumpall'
        cmd += ' -U %s' % user
        cmd += ' -p %d' % self.masterport
        cmd += ' -r -s --gp-syntax --gp-migrator > %s/pgdump.sql' % self.workdir
        self.Log('DEBUG', 'CMD: ' + cmd)
        r = subprocess.call(cmd, env=env, shell=True)

        if r:
            raise UpgradeError('pg_dumpall exited with status %d' % r)


    #------------------------------------------------------------
    def InitNewDB(self):
        '''
        Create and configure the upgrade instance
        '''
        self.Log('INFO', 'Initializing upgraded cluster')
        self.newenv['PGPORT'] = str(self.new_master_port)

        arrayname = self.config['ARRAY_NAME']
        mdir      = self.newmaster
        mport     = self.new_master_port
        segdir    = os.path.join(self.workdir, UPGRADEDIR, 'dummyseg')
        segport   = self.new_port_base + 1
        chkpoint  = self.config['CHECKPOINT_SEGMENTS']
        encoding  = self.config['CLIENT_ENCODING']
        locale    = self.config['LOCALE']
        maxconn   = self.config['MAX_CONNECTIONS']

        # Multiple layers of code (python/ssh/bash/python) combined with
        # different os/ssh/shell versions make string escaping a big pain.
        # If we detect that the array name contains anything that would make
        # quoteing necessary we just punt.  It can be fixed after upgrade
        # if needed.
        array_re = re.compile('^\w+$')
        if not array_re.match(arrayname):
            arrayname = 'Greenplum_Database'
        
        # We create the master and one segment on the master host as 
        # the initial configuration, then copy the segment to every
        # host once it is ready.
        self.Log('INFO', '...master')
        cmd = [os.path.join(libdir, 'gpinitsegment'),
               '-A', arrayname,
               '-D', mdir,
               '-p', str(mport),
               '-n', '1',
               '-K', chkpoint,
               '-E', encoding,
               '-L', locale,
               '-M', maxconn]
        self.RunCmd(cmd, env=self.newenv)

        self.Log('INFO', '...segment')
        cmd = [os.path.join(libdir, 'gpinitsegment'),
               '-A', arrayname,
               '-C', mdir,
               '-D', segdir,
               '-p', str(segport),
               '-c', '0', 
               '-i', '2', 
               '-n', '1']
        self.RunCmd(cmd, env=self.newenv)

        # Shutdown won't work correctly until gp_configuration is correctly
        # initialized, so we need some extra guards for cleanup.
        self.Log('INFO', '...adjusting configuration')
        try:
            # Write out an initial gp_configuration
            cmd = 'pg_ctl -D %s -o "-p%s" -l %s.log start' % \
                (mdir, mport, mdir)
            self.RunCmd(cmd, env=self.newenv)

            # Give it 20 seconds to startup, polling pg_controldata every second
            # to see if startup has completed
            count = 0
            state = None
            while state != 'in production':
                count += 1
                if (count > 20):
                    raise UpgradeError("New master startup timeout")
                sleep(1)
                ctl = self.RunCmd('pg_controldata %s' % mdir, env=self.newenv)
                for line in ctl.split('\n'):
                    (field, value) = line.split(':')
                    if field == 'Database cluster state':
                        state = value.strip()
                        break
            
            # Database is up
            self.dbup = [self.newenv, True]
            self.Update("INSERT INTO gp_configuration values (-1, 't', 1, 't', 't', '%s', %s, '%s')"
                        % (self.host, mport, mdir), port=mport)
            self.Update("INSERT INTO gp_configuration values ( 0, 't', 2, 't', 't', '%s', %s, '%s')"
                        % (self.host, segport, segdir), port=mport)

        except Exception, e:
            cmd = 'pg_ctl -D %s -o "-p%s" stop' % (mdir, mport)
            self.RunCmd(cmd, env=self.newenv)
            raise e

        # Startup the segment
        self.dbup = [self.newenv, False]

        cmd = 'pg_ctl -D %s -o "-p%s" -l %s.log start' % \
            (segdir, segport, segdir)
        self.RunCmd(cmd, env=self.newenv)

        # Give it 20 seconds to startup, polling pg_controldata every second
        # to see if startup has completed
        count = 0
        state = None
        while state != 'in production':
            count += 1
            if (count > 20):
                raise UpgradeError("New master startup timeout")
            sleep(1)
            ctl = self.RunCmd('pg_controldata %s' % segdir, env=self.newenv)
            for line in ctl.split('\n'):
                (field, value) = line.split(':')
                if field == 'Database cluster state':
                    state = value.strip()
                    break

    #------------------------------------------------------------
    def ExpandSystem(self):
        '''
        Copies the dummyseg from the master node to all segments.
        '''
        
        self.Log('INFO', 'Expanding cluster')
        self.Log('INFO', '...This may take a while')

        try:
            dummyseg = os.path.join(self.workdir, UPGRADEDIR, 'dummyseg')
            filename = os.path.join(self.workdir, 'gp_config')
            config = open(filename, 'r')
            for line in config:
                record = line.strip().split("\t")

                content = record[0]
                dbid    = record[2]
                hostname = record[5]
                port     = record[6]
                datadir  = record[7]

                (path, seg) = os.path.split(datadir)
                workdir = os.path.join(path, WORKDIR)
                datadir = os.path.join(workdir, UPGRADEDIR, seg)

                if int(content) < 0:  
                    continue   # skip master segments

                cmd  = os.path.join(libdir, 'gpinitsegment')
                cmd += ' -C %s:%s' % (self.host, dummyseg)
                cmd += ' -A "%s"' % self.config['ARRAY_NAME']
                cmd += ' -h %s' % hostname
                cmd += ' -p %s' % port
                cmd += ' -c %s' % content
                cmd += ' -i %s' % dbid
                cmd += ' -n %s' % len(self.segments)
                cmd += ' -D %s' % datadir
                cmd += ' -G %s' % self.newenv['GPHOME']

                if not self.threadpool:
                    self.threadpool = Harness(self, PARALLELISM)

                self.threadpool.localCommand(cmd)

                # And copy the target mapping file as well
                cmd = 'scp %s %s:%s' % (
                    os.path.join(self.workdir, 'dummyseg_target_mapping'),
                    hostname, 
                    os.path.join(workdir, seg+'_target_mapping')
                    )
                self.threadpool.localCommand(cmd)

            # All processes launched, wait for them to finish
            self.threadpool.wait()

        except:
            # Do something smart?
            raise


    #------------------------------------------------------------
    def InitNewDB_old(self):
        '''
        Create and configure the upgrade instance
        '''
        self.Log('INFO', 'Initializing upgraded cluster')
        self.Log('INFO', '...This may take a while')

        # with --prepare the down check is invalid
        # self.CheckDown()

        try:
            self.dbup = [self.newenv, False]
            cmd = 'gpinitsystem -a -I %s/gp_init_config' % self.workdir
            pid = subprocess.Popen(cmd, preexec_fn=os.setpgrp,
                                   env=self.newenv, shell=True,
                                   stdout=self.logfile, 
                                   stderr=self.logfile, close_fds=True)

            # Ignore interupt requests until startup is done
            error = None
            retcode = None
            while retcode == None:
                try: 
                    retcode = pid.wait();

                except KeyboardInterrupt, e:
                    if not self.interupted:
                        self.Log('FATAL', '***************************************')
                        self.Log('FATAL', 'SIGINT-: Upgrade Aborted')
                        self.Log('FATAL', '***************************************')
                        self.Log('INFO',  'Performing clean abort')
                        self.interupted = True
                        error = e
                    else:
                        self.Log('INFO',  'SIGINT-: Still processing shutdown')

            # If we recieved an interupt, resignal it now that the startup is done
            if error: 
                raise error

            if retcode < 0:
                raise UpgradeError("gpinitsystem terminated by signal");
            today = date.today().strftime('%Y%m%d')
            logname = os.path.join(self.logdir, 'gpinitsystem_%s.log' % today)
            if retcode == 1:
                self.Log('WARN', '***************************************')
                self.Log('WARN', 'Warnings generated initializing upgraded cluster')
                self.Log('WARN', 'Check %s for detailed warnings' % logname)
                self.Log('WARN', '***************************************')
            if retcode > 1:
                self.Log('FATAL', '***************************************')
                self.Log('FATAL', 'gpinitsystem failed with error code %d' % retcode)
                self.Log('FATAL', 'Check %s for detailed error' % logname)
                self.Log('FATAL', '***************************************')
                raise UpgradeError('gpinitsystem failed')
        except OSError, e:
            self.Log('FATAL', str(e))
            raise UpgradeError('gpinitsystem failed')

    #------------------------------------------------------------
    def ResetXLogs(self):
        '''
        Resets the xlog prior to recreating the schema
        '''
        if self.cmd == 'MASTER':
            self.Log('INFO', 'Syncing XLogs')
            seg_prefix = self.config['SEG_PREFIX'] + '-'
            datadirs = [self.root]
            self.CallSlaves('RESETXLOG', self.config['SEG_PREFIX'])
        else:
            seg_prefix = self.option
            datadirs   = self.datadirs

        # We should always have at least one data directory...
        if len(self.datadirs) < 1:
            return

        # Check the mapping in all data directories
        for d in datadirs:
            # Find the segments for this directory, we base this on 
            # directories under the upgrade directory that match
            # the naming convention of the segments.
            for file in os.listdir(d):
                if re.compile('^%s\d+$' % seg_prefix).match(file):
                    olddir  = os.path.join(d, file)
                    newdir  = os.path.join(d, WORKDIR, UPGRADEDIR, file)

                    # Links are in place, but data will not be visible until 
                    # we sync the pg_control info
                    oldsync = self.RunCmd('pg_resetxlog -n ' + olddir, 
                                          env=self.oldenv)
                    newsync = self.RunCmd('pg_resetxlog -n ' + newdir, 
                                          env=self.newenv)

                    self.Log('DEBUG', '*****************************')
                    self.Log('DEBUG', ' - old xlog -')
                    self.Log('DEBUG', oldsync)
                    self.Log('DEBUG', '*****************************')
                    self.Log('DEBUG', ' - new xlog -')
                    self.Log('DEBUG', newsync)
                    self.Log('DEBUG', '*****************************')
                    

                    # Nasty bit of code to turn the control data into a
                    # nice dict object
                    sync = {}
                    for line in oldsync.split('\n'):
                        if len(line) == 0: continue
                        (field, value) = line.split(':')
                        sync[field] = value.lstrip()

                    # Set the next transaction id in new control
                    x = sync["Latest checkpoint's NextXID"].find('/')
                    if x < 0:
                        nextxid = sync["Latest checkpoint's NextXID"]
                    else:
                        nextxid = sync["Latest checkpoint's NextXID"][x+1:]

                    self.RunCmd('pg_resetxlog -f -x %s %s' % (nextxid, newdir), 
                                env=self.newenv)

                    # Set the WAL archives
                    self.RunCmd('pg_resetxlog -l %s,%s,%s %s' % 
                                (sync["Latest checkpoint's TimeLineID"],
                                 sync["Current log file ID"],
                                 sync["Next log file segment"],
                                 newdir), env=self.newenv)

                    # Set next oid
                    self.RunCmd('pg_resetxlog -o %s %s' % 
                                (sync["Latest checkpoint's NextOID"],
                                 newdir), env=self.newenv)

                    # Set next multitransaction ID/offset
                    self.RunCmd('pg_resetxlog -m %s %s' %
                                (sync["Latest checkpoint's NextMultiXactId"],
                                 newdir), env=self.newenv)
                    self.RunCmd('pg_resetxlog -O %s %s' %
                                (sync["Latest checkpoint's NextMultiOffset"],
                                 newdir), env=self.newenv)

                    # Replace the transaction logs with the old ones
                    # since the old logs actually correspond to the data
                    for f in ['pg_clog', 
                              'pg_distributedlog', 
                              'pg_subtrans',
                              'pg_multixact']:
                        oldlogs = os.path.join(olddir, f)
                        newlogs = os.path.join(newdir, f)

                        # the only one that wouldn't exist is pg_distributedlog
                        # and only if we were upgrading/downgrading to/from a 
                        # version < 3.1.1.5
                        if (os.path.exists(newlogs)):
                            self.RunCmd('rm -rf %s' % newlogs)
                            if (os.path.exists(oldlogs)):
                                self.RunCmd('cp -rf %s %s' % (oldlogs, newlogs))

    #------------------------------------------------------------
    def ImportSchema(self):
        self.CheckUp()
        self.Log('INFO', 'Importing schema')
        self.Log('INFO', '...This may take a while')

        error   = False
        warning = False


        locked = os.path.join(self.newenv['MASTER_DATA_DIRECTORY'],
                              'pg_hba.conf'+LOCKEXT)
        if os.path.exists(locked):
            user = MIGRATIONUSER
        else:
            user = self.newenv['USER']

        pipe = subprocess.Popen('psql -q -U %s -f %s/pgdump.sql template1' % 
                                (user, self.workdir),
                                env=self.newenv, shell=True,
                                stdout=subprocess.PIPE, 
                                stderr=subprocess.PIPE,
                                close_fds=True)

        msg_re  = re.compile('(?:psql:%s/pgdump.sql:(\d+): *)?([^:]*): *(.*)' % self.workdir)
        user_re = re.compile('role ".*" already exists')
        schema_re = re.compile('schema ".*" does not exist')
        for line in pipe.stderr:
            match = msg_re.match(line)
            if match:
                if match.group(1):
                    line = '%s:  %s, at line %s' % (
                        match.group(2), match.group(3), match.group(1) )
                else:
                    line = '%s:  %s' % ( match.group(2), match.group(3) )

                # Check for expected safe errors
                if (user_re.match(match.group(3)) or
                    schema_re.match(match.group(3))):
                    continue

                # Handle unexpected errors
                if (match.group(2) == 'WARNING' or 
                    match.group(2) == 'DETAIL'  or
                    match.group(2) == 'NOTICE'):
                    warning = True
                    level = 'WARN'
                else:
                    error = True
                    level = 'FATAL'

            else:
                # should never happen
                error = True
                level = 'FATAL'

            # If we've disabled schema checking then all schema errors 
            # are converted to warnings
            if not self.checkschema:
                level = 'WARN'
                error = False

            self.Log(level, line)

        if error:
            self.Log('FATAL', "Errors encountered loading '%s/pgdump.sql'" % self.workdir);
            raise UpgradeError('Upgrade aborted due to Schema Import Failures')

        if warning:
            self.Log('WARN', '***************************************')
            self.Log('WARN', "Warnings encountered loading '%s/pgdump.sql'" % self.workdir);
            self.Log('WARN', '***************************************')


        self.Log('INFO', 'Vacuuming catalog tables')
        self.Log('INFO', '...This may take a while')
        databases = self.Select(
            '''
            SELECT datname FROM pg_database 
            WHERE datname != 'template0'
            ''')
        for db in databases:
            r = subprocess.call('psql -U %s -c "vacuum freeze" %s' % (user, db),
                                env=self.newenv, shell=True,
                                stdout=self.logfile, stderr=self.logfile,close_fds=True)
            if r:
                raise UpgradeError('Vacuum exited with status %d' % r)

    #------------------------------------------------------------
    def RestoreStatistics(self):
        '''
        Executes queries to rebuild the database statistics stored in 'pg_stat_*.csv'
        '''

        self.Log('INFO', 'Restoring statistics')
        self.Log('INFO', '...This may take a while')
        
        # Datatypes of the columns in pg_statistics, the last 4 columns,
        # not included here, are anyarray and will be cast based on the
        # datatype of the statisics column.
        types = [ 'smallint',    'real',        'integer',     'real',
                  'smallint',    'smallint',    'smallint',    'smallint',
                  'regoperator', 'regoperator', 'regoperator', 'regoperator',
                  'real[]',      'real[]',      'real[]',      'real[]' ]

        def escape(str):
            str = str.replace("\\", "\\\\")   # escape the escapes
            str = str.replace("'",  "\\'")    # escape single quotes
            return str

        def cast(str, typ):
            if len(str) == 0:
                return "NULL::%s" % typ
            else:
                return "E'%s'::%s" % (escape(str), typ)

        # The "vacuum freeze" we did after importing the schema did an analyze
        # on all the empty tables resulting in statisics being generated.  
        #
        # We'll overwrite this for all tables that we previously had statistics
        # on, but to preserve NOT having statistics on some tables we first have
        # to clear statistics.
        databases = self.Select("SELECT datname from pg_database WHERE datname != 'template0'")
        for db in databases:
            self.Update('''
               UPDATE pg_class set relpages=0, reltuples=0
               FROM pg_namespace n
               WHERE relnamespace = n.oid and nspname !~ '(pg.*|information_schema)'
               ''', db=db);
        
        # Now read the stat files and update statistics based on what was in previous
        # catalog.
        lastdb   = None
        lastname = None
        for file in os.listdir(self.workdir):
            if file[0:8] == 'pg_stat_':
                file = os.path.join(self.workdir, file)
                reader = csv.reader(open(file), delimiter=',', escapechar='\\')

                for row in reader:
                    if len(row) < 1:
                        continue

                    db       = row[0]
                    schema   = row[1]
                    table    = row[2]
                    kind     = row[3]
                    relpages = row[4]
                    reltups  = row[5]
                    name     = '"%s"."%s"' % (escape(schema), escape(table))

                    if db != lastdb:
                        lastdb = db
                        lastname = None

                    if name != lastname:
                        lastname = name
                        sql  = "UPDATE pg_class\n"
                        sql += "SET relpages = '%s'::int,\n" % relpages
                        sql += "    reltuples = '%s'::real\n" % reltups
                        sql += "WHERE oid = E'%s'::regclass;" % name
                        try:
                            self.Update(sql, db=db)
                        except Exception, e:
                            self.Log('WARN', str(e))

                    # Statistics where dumped with an outer join, if there are
                    # records in pg_statistics then columns 6-17 will all be
                    # non-null.  Row[6] is the column index (staattnum) if it
                    # is null the rest will be null too and we can skip the 
                    # insertion into pg_statistic
                    if row[6] == None or row[6] == '':
                        continue

                    # If the base datatype is an array then the array form is
                    # the same datatype, otherwise we need to use the array form
                    # (ie, add a leading underscore)
                    if kind[0] == "_":
                        kind = kind[1:] + "[]"
                    else:
                        kind = kind + "[]"

                    sql  = "INSERT INTO pg_statistic VALUES (\n"
                    sql += "  E'%s'::regclass, \n" % name
                    for i in range(16):
                        sql += "  %s, \n" % cast(row[i+6], types[i])
                    for i in range(3):
                        sql += "  %s, \n" % cast(row[i+22], kind)
                    sql += "  %s);" % cast(row[25], kind)
                    try:
                        self.Update(sql, db=db)
                    except Exception, e:
                        self.Log('WARN', str(e))

    #------------------------------------------------------------
    def RemapOID(self):
        '''
        Remaps OIDs for the NEW database
        '''

        if self.cmd == 'MASTER':

            self.Log('INFO', 'Remapping OIDs')

            datadirs    = [self.root]
            seg_prefix  = self.config['SEG_PREFIX'] + '-'

            # they believe the mapping is valid.
            self.CallSlaves('REMAPOID', self.config['SEG_PREFIX'])


        else:
            if self.cmd != 'REMAPOID': 
                raise Exception(self.cmd + ' != REMAPOID]')

            datadirs       = self.datadirs
            seg_prefix     = self.option


            # We should always have at least on data directory...
            if len(self.datadirs) < 1:
                return

        # Both master and slave processes need to do mappings.
        #   + On master this is just MASTER_DATA_DIR
        #   + On slaves its the DATA_DIRECTORY and MIRROR_DATA_DIRECTORY

        # Check the mapping in all data directories
        def wait_for_threads(threads):
            for t in threads:
                t.join()
                if t.errors:
                    raise UpgradeError('FATAL',
                        'error encountered in remap thread: %s' %
                            t.errstr)

        th = []
        for d in datadirs:
            # Find the segments for this directory, we base this on 
            # directories under the upgrade directory that match
            # the naming convention of the segments.
            for file in os.listdir(d):
                if re.compile('^%s\d+$' % seg_prefix).match(file):
                    olddir  = os.path.join(d, file)
                    newdir  = os.path.join(d, WORKDIR, UPGRADEDIR, file)
                    
                    # Read the mapping files to produce oid->oid pairs
                    mapspec = os.path.join(d, WORKDIR, file)
                    t = RemapOidWorker(mapspec, olddir, newdir, self.method)
                    t.start()
                    th.append(t)
                    if (len(th) % PARALLELISM) == 0:
                        wait_for_threads(th)
                        th = []

        wait_for_threads(th)

    #------------------------------------------------------------
    def DeepLink(self, style):
        '''
        Makes a deep hard link copy of one directory into another
        '''

        if style == 'CLEANUP':
            return

        if style not in ['BACKUP', 'INSTALL', 'REVERT']:
            raise UpgradeError('FATAL', ' DeepLink(%s)!?' % style)            
        
        if self.cmd == 'MASTER':
            seg_prefix   = self.config['SEG_PREFIX'] + '-'
            datadirs = [self.root]
            if style == 'BACKUP':
                self.Log('INFO', 'Linking backup')
            elif style == 'INSTALL':
                self.Log('INFO', 'Linking upgrade')
                self.Log('INFO', '...This may take a while')

            # Have all hosts perform the link first
            self.CallSlaves('DEEPLINK', style, self.config['SEG_PREFIX'])

        else:
            seg_prefix = self.option2
            datadirs   = self.datadirs

        # Look in each data directory, identify the segment directories,
        # walk each segment directory.
        segdir_re = re.compile(seg_prefix+'\d+$')
        for dir in filter(os.path.exists, datadirs):
            for content in os.listdir(dir):
                if segdir_re.match(content):

                    # For Backup datadirs is the source, for INSTALL it's the target
                    if style == 'BACKUP':
                        source      = os.path.join(dir, content)
                        destination = os.path.join(dir, WORKDIR, BACKUPDIR, content)
                    if style == 'INSTALL':
                        source      = os.path.join(dir, WORKDIR, UPGRADEDIR, content)
                        destination = os.path.join(dir, content)
                    if style == 'REVERT':
                        source      = os.path.join(dir, WORKDIR, BACKUPDIR, content)
                        destination = os.path.join(dir, content)

                        if not os.path.exists(source):
                            continue

                    # Link the log file
                    if os.path.isfile(source + '.log'):
                        oldfile = source + '.log'
                        newfile = destination + '.log'
                        if os.path.exists(newfile):
                            if style == 'BACKUP':
                                self.Log('WARN', 'File exists ' + newfile)
                            os.remove(newfile)
                        self.Log('DEBUG', 'Linking file %s => %s' % (oldfile, newfile))
                        os.link(oldfile, newfile)

                    # Remove any files from the destination location
                    # Not including the target directory itself
                    # Also not including the workdir and contents
                    if os.path.exists(destination):
                        for file in os.listdir(destination):
                            if file != WORKDIR:
                                self.RunCmd('rm -rf ' + os.path.join(destination, file))

                    for root, dirs, files in os.walk(source, topdown = True):
                        if WORKDIR in dirs:
                            dirs.remove(WORKDIR)   # don't visit the work directory

                        newroot = root.replace(source, destination, 1)
                        if not os.path.exists(newroot):
                            os.mkdir(newroot)
                            self.RunCmd('chmod 700 ' + newroot)

                        for name in files:
                            oldfile = os.path.join(root, name)
                            newfile = os.path.join(newroot, name)
                            if os.path.exists(newfile):
                                self.Log('WARN', 'File exists ' + newfile)
                                os.remove(newfile)
                            self.Log('DEBUG', 'Linking file %s => %s ' % (oldfile, newfile))
                            os.link(oldfile, newfile)

    #------------------------------------------------------------
    def FixConfig(self):
        '''
        After moving the upgraded db from DATA_DIR/upgrade to just DATA_DIR
        we need to go and fix the gp_configuration table to point to the
        correct location.
        '''

        # We can do this in utility mode since the master host is the only
        # host that contains gp_configuration information
        self.Startup(self.newenv, utility=True)
        self.Log('INFO', 'Adjusting gp_configuration')

        # gp_configuration needs to point back to the original directory locations.
        # All the information should be stored in gp_config
        self.Update("DELETE FROM gp_configuration")
        self.Update("COPY gp_configuration FROM '%s/gp_config'" % self.workdir) 
        self.Update("VACUUM FREEZE gp_configuration")
        self.Update("UPDATE gp_id SET numsegments = %d" % len(self.segments))
        self.Update("VACUUM FREEZE gp_id")
        self.Shutdown()
        self.newenv['MASTER_DATA_DIRECTORY'] = \
            self.oldenv['MASTER_DATA_DIRECTORY']

    def TouchupConfig(self):
        '''
        Touch up the config for a transform method upgrade/downgrade
        '''

        # We can do this in utility mode since the master host is the only
        # host that contains gp_configuration information
        self.Startup(self.newenv, utility=True)
        self.Log('INFO', 'Adjusting gp_configuration')

        # gp_configuration needs to point back to the original directory locations.
        # All the information should be stored in gp_config
        self.Update("""UPDATE gp_configuration SET
            datadir = regexp_replace(datadir, E'(%s-?\\\\d+)$',
            E'gpmigrator/upgrade/\\\\1');""" % self.config['SEG_PREFIX'])
        self.Update("VACUUM FREEZE gp_configuration")
        self.Shutdown()

    #------------------------------------------------------------
    def RemapPorts(self):
        '''
        '''

        # All the parameters we are interested in are integer values
        conf = os.path.join(self.newmaster, 'postgresql.conf')
        def getconf(x):
            conf_re  = re.compile('^\s*%s\s*=\s*(\d+)' % x)
            conf_str = self.RunCmd('grep %s %s' % (x, conf))
            value = None
            for line in conf_str.split('\n'):
                match = conf_re.search(line)
                if match:
                    value = int(match.group(1))
            return value

        # Find the port for this segment:
        port = getconf('port')

        self.Startup(self.newenv, utility=True)
        self.Log('INFO', 'Adjusting upgrade ports')
        self.Update('update gp_configuration set port=%s where content < 0'
                    % self.masterport, port=port)
        for s in self.segments:
            self.Update('update gp_configuration set port=%s where dbid=%s'
                        % (s['port'], s['dbid']), port=port)
        for s in self.mirrors:
            self.Update('update gp_configuration set port=%s where dbid=%s'
                        % (s['port'], s['dbid']), port=port)
        self.Shutdown()

    #------------------------------------------------------------
    def CopyConfig(self):
        '''
        '''

        # Also need to update the postgresql.conf files to match.  This is
        # best accomplished by copying from the source instance.
        self.RunCmd('cp -f %s %s' %
                    (os.path.join(self.masterdir, 'postgresql.conf'),
                     os.path.join(self.newmaster, 'postgresql.conf')))
        for s in self.segments:
            (datadir, seg) = os.path.split(s['datadir'])
            target = os.path.join(datadir, WORKDIR, UPGRADEDIR, seg)
            self.RunCmd('scp %s:%s/postgresql.conf %s:%s/.' %
                        (s['host'], s['datadir'],
                         s['host'], target))
        for s in self.mirrors:
            (datadir, seg) = os.path.split(s['datadir'])
            target = os.path.join(datadir, WORKDIR, UPGRADEDIR, seg)
            self.RunCmd('scp %s:%s/postgresql.conf %s:%s/.' %
                        (s['host'], s['datadir'],
                         s['host'], target))

    def ExtractCatFiles(self):
        '''
        Get the set of data files which are necessary to bring up a skeleton 
        system: just those necessary for bringing up the system in utility
        mode and querying the catalogs -- no user data.

        We write the set of files to the file system for later use.
        '''

        self.Log('INFO', 'Extracting list of catalog files')

        if self.cmd == 'MASTER':
            datadirs = [ self.root ]
            seg_prefix = self.config['SEG_PREFIX'] + '-'
            [env, utility] = self.dbup
            self.CallSlaves('EXTRACTCATFILES', self.config['SEG_PREFIX'])
        else:
            datadirs = self.datadirs
            seg_prefix = self.option

        seg_re  = re.compile('^(%s\d+|dummyseg)$' % seg_prefix)        
        # do it for all dirs on this node
        for d in datadirs:
            for seg in os.listdir(d):
                if seg_re.match(seg):
                    
                    # The directory for this segment
                    dir = os.path.join(d, seg)
                    logdir = os.path.join(d, WORKDIR)
                
                    # Open the mapping file
                    mapfilename = os.path.join(logdir, '%s_catfiles' % seg)
                    mapfile = open(mapfilename, 'w')

                    # Find the last line in the conf file that matches our expression
                    conf = os.path.join(dir, 'postgresql.conf')
                    def getconf(x):
                        conf_re  = re.compile('^\s*%s\s*=\s*(\d+)' % x)
                        conf_str = self.RunCmd('grep %s %s' % (x, conf))
                        value = None
                        for line in conf_str.split('\n'):
                            match = conf_re.search(line)
                            if match:
                                value = int(match.group(1))
                        return value

                    # Find the port for this segment:
                    port = getconf('port')
                    if port == None:
                        raise UpgradeError('Could not determine port from %s/postgresql.conf' % dir)

                    # Get a list of databases
                    databases = self.Select(
                    '''
                       SELECT 
                          datname 
                       FROM pg_database 
                       WHERE datname != 'template0'
                       ORDER BY datname
                    ''', port=port)

                    # Build up the list of catalog entries
                    files = {}
                    for db in databases:
                        first = True
                        l = self.Select(
                        '''
                           SELECT d.oid as datoid,
                                  c1.relname as rel1, c1.relfilenode as node1,
                                  c2.relname as rel2, c2.relfilenode as node2,
                                  c3.relname as rel3, c3.relfilenode as node3
                           FROM pg_class c1 
                              left outer join pg_namespace n
                                on (c1.relnamespace = n.oid)
                              left outer join pg_class c2
                                on (c1.reltoastrelid = c2.oid)
                              left outer join pg_class c3
                                on (c2.reltoastidxid = c3.oid),
                              pg_database d
                           WHERE d.datname = '%s' and 
                              (nspname = 'pg_catalog' or
                               nspname = 'information_schema') and
                              c1.relkind in ('r', 'i') and 
                              not c1.relisshared
                        ''' % db, port=port, db=db)
                
                        f = []
                        nlist = ["1", "2", "3"]
                        for row in l:
                            if first:
                                first = False
                                file = os.path.join('base', str(row['datoid']),
                                                    'PG_VERSION')
                                f.append(file)

                            for n in nlist:
                                if row.get("rel" + n):
                                    file = os.path.join('base',
                                                        str(row['datoid']),
                                                        str(row['node' + n]))
                                    dfile = os.path.join(dir, file)
                                    if not os.path.exists(dfile):
                                        raise UpgradeError(
'found path "%s" for table "%s" but file does not exist' % (dfile, row['rel'+n]))
                                    f.append(file)
                        files[db] = f
                
                    # add template0
                    r = self.Select("""select oid from pg_database where 
                                       datname = 'template0'""", port=port)
                    if len(r) > 0:
                        files['template0'] = [os.path.join('base', str(r[0]))]
                
                    # meta data directories, like commit log
                    meta = ['global', 'pg_clog', 'pg_distributedlog',
                            'pg_distributedxidmap', 'pg_multixact', 'pg_subtrans',
                            'pg_twophase', 'pg_utilitymodedtmredo', 'pg_xlog',
                            'postgresql.conf',
                            'pg_hba.conf', 'pg_ident.conf',
                            'PG_VERSION']

                    for name, fs in files.iteritems():
                        for f in fs:
                            # Prefix each name with the database it's in
                            mapfile.write('%s:%s\n' % (name, f))
                    for f in meta:
                        mapfile.write('meta:%s\n' % f)

                    mapfile.close()
                    
    def ExtractAosegs(self):
        '''
        Build AO seg upgrade/downgrade files for this node
        '''

        self.Log('INFO', 'Building append only segment upgrader')
        
        if self.cmd == 'MASTER':
            seg_prefix = self.config['SEG_PREFIX'] + '-'
            self.CallSlaves('EXTRACTAOSEGS', self.config['SEG_PREFIX'])
            datadirs = [ self.root ]
        else:
            datadirs = self.datadirs
            seg_prefix = self.option

        seg_re  = re.compile('^(%s\d+|dummyseg)$' % seg_prefix)        
        for d in datadirs:
            for seg in os.listdir(d):
                if seg_re.match(seg):
                    
                    # The directory for this segment
                    dir = os.path.join(d, seg)
                    logdir = os.path.join(d, WORKDIR)

                    conf = os.path.join(dir, 'postgresql.conf')
                    def getconf(x):
                        conf_re  = re.compile('^\s*%s\s*=\s*(\d+)' % x)
                        conf_str = self.RunCmd('grep %s %s' % (x, conf))
                        value = None
                        for line in conf_str.split('\n'):
                            match = conf_re.search(line)
                            if match:
                                value = int(match.group(1))
                        return value

                    # Find the port for this segment:
                    port = getconf('port')
                    if port == None:
                        raise UpgradeError('Could not determine port ' +
                                           'from %s/postgresql.conf' % dir)

                    dbs = self.Select('''select datname from pg_database
                                         where datname != 'template0';''',
                                      port=port)

                    # do it for every database
                    for db in dbs:
                        fname = os.path.join(logdir,
                            'aoseg_%s_rewrite.sql' % db)
                        self.Log('DEBUG', 'creating AO rewrite: %s' % fname)
                        f = open(fname, 'w')

                        # The user might have already upgraded the database
                        # once in which case some (but maybe not all) ao seg
                        # relations will have been upgraded
                        if self.upgrade:
                            aos = self.Select(
                                '''select 'alter table pg_aoseg.' || relname || 
                                   ' add column ' ||
                                   ' eofuncompressed double precision;'
                                   from pg_class where relnamespace = 6104 and 
                                   relkind = 'o' and relnatts = '4';''',
                                   db=db, port=port)
                        else:
                            aos = self.Select(
                                '''select 'update table pg_aoseg.' || relname
                                   || ' set eofuncompressed = NULL;'
                                   from pg_class
                                   where relnamespace = 6104
                                   and relkind = 'o' and relnatts = '5';''',
                                   db=db, port=port)

                        if aos:
                            # side step issue with AO: we can only work on
                            # 1,000 odd AO tables at once otherwise we run out
                            # of shared memory. No idea why, we just do.
                            i = 1
                            f.write('begin;\n')
                            for a in aos:
                                self.Log('DEBUG', a)
                                # need to add newline as postgres --single
                                # uses it as a delimiter
                                f.write(a + '\n')
                                i += 1
                                if i % 1000 == 0:
                                    i = 1
                                    f.write('commit;\nbegin;\n')
                            f.write('commit;\n')

                        f.close()
                    fname = os.path.join(logdir, 'aoseg_template0_rewrite.sql')
                    f = open(fname, 'w')
                    f.write('vacuum freeze;\n')
                    f.close()

                    # just once
                    break


    def BuildSkel(self):
        '''
        Copy data files to build a skeleton database.
        '''

        self.Log('INFO', 'Building skeleton cluster')
        if self.cmd == 'MASTER':
            seg_prefix = self.config['SEG_PREFIX'] + '-'
            self.CallSlaves('BUILDSKEL', self.config['SEG_PREFIX'],
                            self.highestoid)
            datadirs = [ self.root ]
        else:
            datadirs = self.datadirs
            seg_prefix = self.option
            self.highestoid = int(self.option2)


        def do_copy(src, dst, f):
            '''
            Copy a directory tree
            '''
            self.Log('DEBUG', "copying %s to %s" % (os.path.join(src, f),
                                                    os.path.join(dst, f)))
            if os.path.isdir(os.path.join(src, f)):
                shutil.copytree(os.path.join(src, f), os.path.join(dst, f))
            else:
                shutil.copy2(os.path.join(src, f), os.path.join(dst, f))
        
                # for this is a file, copy all segments
                if os.path.isfile(os.path.join(src, f)):
                    for i in range(1, 66000):
                        i = str(i)
                        if os.path.exists(os.path.join(src, f, i)):
                            shutil.copy2(os.path.join(src, f, i),
                                         os.path.join(dst, f, i))
                        else:
                            break

        seg_re  = re.compile('^(%s\d+|dummyseg)$' % seg_prefix)        
        # do it for all dirs on this node
        for d in datadirs:
            for seg in os.listdir(d):
                if seg_re.match(seg):
                    logdir = os.path.join(d, WORKDIR)
                
                    # Open the mapping file
                    mapfilename = os.path.join(logdir, '%s_catfiles' % seg)
                    mapfile = open(mapfilename, 'r')

                    src = os.path.join(d, seg)
                    dst = os.path.join(d, WORKDIR, UPGRADEDIR, seg) 
    
                    # build list for directories to create
                    dirs = []
                
                    for line in mapfile:
                        line = line[:-1]
                        (dbname, f) = line.split(':')
                        path = os.path.join(src, f)
                        self.Log('DEBUG', "testing " + path)
            
                        if os.path.isdir(path):
                            # will be created in do_copy()
                            continue
                        else:
                            dirname = os.path.dirname(f)
                            path = os.path.join(src, dirname)
                            if not os.path.isdir(path):
                                raise UpgradeError("%s should be a directory!" % path)
                
                        # only add this if the path != src
                        if not os.path.samefile(src, path):
                            self.Log('DEBUG', 'path = %s, src = %s, adding %s'
                                     % (path, src, f))
                            dirs.append(dirname)
                
                    dirs = list(set(dirs)) # make unique
                    self.Log('DEBUG', 'dirs = %s' % str(dirs))
                
                    # make sure dst exists
                    if not os.path.exists(dst):
                        os.mkdir(dst, 0700)
                
                    dirs.append('pg_log')
                    for dir in dirs:
                        self.Log('DEBUG', "making dir %s" % dir)
            
                        # equivalent of mkdir -p dst/dir
                        os.makedirs(os.path.join(dst, dir), 0700)
                
                    self.Log('DEBUG', "copying files")
                
                    # rewind
                    mapfile.seek(0)
                    for line in mapfile:
                        (dbname, f) = line.split(':')
                        f = f[:-1]
                        do_copy(src, dst, f)

                    def overwrite(frm, to):
                        if not os.path.exists(frm): return

                        f = open(frm, 'r')
                        t = open(to, 'w')
                        for line in f:
                            t.write(line)
                        f.close()
                        t.close()

                    ext = ''
                    # master needs locked pg_hba.conf
                    if self.cmd == 'MASTER':
                        ext = LOCKEXT
                    self.copy_rewrite_hba(os.path.join(src, 'pg_hba.conf'+ext),
                                          os.path.join(dst, 'pg_hba.conf'),
                                          self.upgrade)
                    overwrite(os.path.join(src, 'pg_ident.conf'+ext),
                              os.path.join(dst, 'pg_ident.conf'))

                    # set highest oid
                    # XXX: should check that this oid is higher!
                    self.RunCmd("pg_resetxlog -o %d %s" % \
                                (self.highestoid, dst), env=self.newenv)

    def TransformDbs(self, dbs):
        '''
        Transform the local databases. The temporary copy we've made of each
        segment is transformed by passing a set of transformation scripts
        (stored in share/postgresql/upgrade/). To do the transformation,
        we start the backend in --single (non postmaster) mode and send
        the scripts via stdin.
        '''
 
        self.Log('INFO', 'Performing multi-stage catalog transformation')
        def get_new_files(procfile, path, dbdir):
            out = []
            f = open(procfile, 'r')
            first = True
            for line in f:
                # OID is first col and is equal to the relfilenode at 
                # this stage skip header
                if first:
                    first = False
                    continue

                a = line.split('|')
                oid = int(a[0])
                # shared rel ?
                if a[15] == "t":
                    dir = "global"
                else:
                    dir = dbdir
                out.append(os.path.join(path, dir, str(oid)))

            f.close()
            return out
        
        def touch_files(files):
            '''
            We are creating new tables but since we do not call heap_create()
            we do not initialized the data file on disk. Creating an empty
            file is enough to ensure that the storage layer doesn't get
            confused.
            '''
            for f in files:
                self.Log('DEBUG', 'touching file %s' % f)
                fp = open(f, 'w')
                fp.close()
        
        def transform(path, dbs, tfile):
            for dboid, db in dbs.iteritems():
                self.Log('INFO', '... ' + db)
                transform_db(path, db, dboid, tfile)
        
        def transform_db(path, dbname, dboid, tfile):
            '''
            Transform the specified database for a single segment.
            '''
            self.Log('DEBUG', "transforming db = %s dboid = %s tfile = %s" % \
                     (str(dbname), str(dboid), tfile))

            load = open(tfile, 'r')
            # create files to back new relations
            if os.path.basename(tfile) == 'loadcat33.source':
                cl = os.path.join(os.path.dirname(tfile),
                                  'upg2_pg_class_toadd.data')
                dbdir = os.path.join('base', str(dboid))
                new_files = get_new_files(cl, path, dbdir)
                touch_files(new_files)
        
            # run postgres in single user mode, feed in scripts
            cmd = ' '.join(['postgres', '--single', '-O',
                            '-c', 'gp_session_role=utility',
                            '-c', 'exit_on_error=true',
                            '-E', '-D', path, dbname])
            self.Log('DEBUG', 'running ' + cmd)
            p = subprocess.Popen(cmd, shell = True,
                                  close_fds = True,
                                  stdin = load,
                                  stdout = subprocess.PIPE,
                                  stderr = subprocess.PIPE,
                                  env=self.newenv)
            result = p.communicate()
        
            if p.returncode == 0:
                self.Log('DEBUG', 'successfully transformed ' + dbname)
                self.Log('DEBUG', result[0].strip())
            else:
                raise CmdError(str(cmd), result[0], result[1])
        
        
        def make_files(files, datadir, user):
            """
            Take the set of .in files and apply translation to the local
            environment
            """
        
            out = []
            tmpdir = tempfile.mkdtemp()
            self.Log('DEBUG', "created temporary directory " + tmpdir)
            # strings to find and the data to replace those strings with
            transforms = [['@gpupgradeschemaname@', 'pg_catalog'],
                          ['@gpinfoschemaname@', 'information_schema'],
                          ['@gpupgradedatadir@', tmpdir],
                          ['@gpcurusername@', user]
                         ]

            for file in files:

                if file[-3:] == ".in":
                    outfilename = os.path.join(tmpdir, file[:-3])
                else:
                    outfilename = os.path.join(tmpdir, file)
        
                outf = open(outfilename, 'w')
                inf = open(os.path.join(datadir, file), 'r')
                # replace the strings
                for line in inf:
                    for t in transforms:
                        line = re.sub(t[0], t[1], line)
                    outf.write(line)
                outf.close()
                inf.close()
                out.append(outfilename)
                self.Log('DEBUG', "created %s" % outfilename)

            return out
        
        if self.cmd == 'MASTER':
            seg_prefix = self.config['SEG_PREFIX'] + '-'
            datadirs = [ self.root ]
            t = []
            for a, b in dbs.iteritems():
                t.append('%s:%s' % (a, b))

            t = ':'.join(t)
            self.Log('DEBUG', 'sending database string ' + t)
            self.CallSlaves('TRANSFORMCAT', self.config['SEG_PREFIX'], t)
        else:
            seg_prefix = self.option
            datadirs = self.datadirs

        if type(dbs) == str:
            # convert dbs to a dict
            a = dbs.split(':')
            dbs = {}
            a.reverse()
            while a:
                f = a.pop()
                g = a.pop()
                dbs[f] = g

        # files for upgrading from 3.2 to 3.3
        files = []
        if self.upgrade:
            files = ["loadcat33.source.in",
                     "upg2_pg_class_toadd.data.in",
                     "upg2_pg_attribute_toadd.data.in",
                     "upg2_pg_type_toadd.data.in",
                     "upg2_pg_index_toadd.data.in",
                     "upg2_pg_proc_toadd.data",
                     "upg2_pg_namespace_toadd.data",
                     "upg2_pg_description_toadd.data",
                     "upg2_pg_depend_toadd.data"]

            h = self.newhome
            conv = make_files(['upgrade_conversion.sql.in'],
                              '%s/share/postgresql/upgrade/' % self.newhome,
                              self.user)
        else:
            # need to use self.oldhome here as downgrade_conversion.sql.in
            # is only available for 3.3
            h = self.oldhome
            conv = make_files(['downgrade_conversion.sql.in'],
                              '%s/share/postgresql/upgrade/' % h,
                              self.user)
        fs = make_files(files,
                        '%s/share/postgresql/upgrade/' % h,
                        self.user)

        seg_re  = re.compile('^(%s\d+|dummyseg)$' % seg_prefix)        
        for d in datadirs:
            for seg in os.listdir(d):
                if seg_re.match(seg):
                    
                    # The directory for this segment
                    dir = os.path.join(d, WORKDIR, UPGRADEDIR, seg)
                    if self.upgrade:
                        # fs[0] is loadcat33
                        self.Log('INFO', 'Pass 1')
                        transform(dir, dbs, fs[0])

                    self.Log('INFO', 'Pass 2')
                    transform(dir, dbs, conv[0])

                    # ao file too -- must be last because we
                    # use this file to VACUUM FREEZE template databases
                    for dboid, dbname in dbs.iteritems():
                        # no need to rewrite AO in template0
                        if dbname == 'template0':
                            continue

                        file = 'aoseg_%s_rewrite.sql' % dbname
                        aofile = os.path.join(d, WORKDIR, file)
                        f = self.RunCmd('cat ' + aofile)
                        self.Log('DEBUG', "ao upgrade %s" % f)
                        transform_db(dir, dbname, dboid, aofile)
                        

    def SetCatVersion(self, frm, to):
        '''
        Set the catalog version to something different. Cluster should be down.
        '''

        self.Log('INFO', 'Modifying catalog version of skeleton cluster')
        releases = {"3.0": "200703112",
             "3.1": "200712072",
             "3.2": "200808253",
             "3.3": "200905011"}
        
        self.CheckDown()

        def release2catverno(rno):
             if not rno in releases.keys():
                  raise Exception("unknown version %s" % rno)
             return releases[rno]
        
        def get_control_data(datadir):
             '''
             Parse the output of pg_controldata run on data directory, returning
             catalog version and state
             '''
             cmd = ' '.join(['pg_controldata', datadir])
             p = subprocess.Popen(cmd, shell=True, close_fds=True,
                                  stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                  env=self.newenv)
             result = p.communicate()
        
             if p.returncode != 0:
                 raise CmdError(cmd, result[0], result[1])
        
             out = result[0].strip()
             ver = ""
             state = ""
             for line in out.split('\n'):
                  s = line.split(':')
                  if s[0] == 'Catalog version number':
                        ver = s[1].strip()
                  elif s[0] == 'Database cluster state':
                        state = s[1].strip()
        
             return [ver, state]
        
        def setcatversion(datadir, frm, to):
            '''
            Set catalog version to 'to' from 'frm'. Make sure the database
            is already set to frm.
            '''
            (ver, state) = get_control_data(datadir)
        
            frmcatverno = release2catverno(frm)
            if ver != frmcatverno:
                 raise Exception("Expected version %s but found %s" % (frmcatverno, ver))
        
            # gpmodcatversion is only in the 3.3 env so we must use that
            if self.upgrade:
                e = self.newenv
                h = self.newhome
            else:
                e = self.oldenv
                h = self.oldhome

            cmd = ['%s/bin/lib/gpmodcatversion' % h,
                   '--catversion', to, datadir]
            p = subprocess.Popen(cmd,
                                 shell=False,
                                 close_fds=True,
                                 env=e,
                                 stdout=subprocess.PIPE,
                                 stderr=subprocess.PIPE)
            result = p.communicate()
            if p.returncode != 0:
                raise Exception("could not update catalog to %s" % to)


        if self.cmd == 'MASTER':
            datadirs = [ self.root ]
            seg_prefix = self.config['SEG_PREFIX'] + '-'
            self.CallSlaves('SETCATVERSION', self.config['SEG_PREFIX'])
        else:
            datadirs = self.datadirs
            seg_prefix = self.option

        seg_re  = re.compile('^(%s\d+|dummyseg)$' % seg_prefix)
        for d in datadirs:
            for seg in os.listdir(d):
                if seg_re.match(seg):
                    dir = os.path.join(d, WORKDIR, UPGRADEDIR, seg)
                    setcatversion(dir, frm, to)

    def GetHighestOid(self):
        '''
        Get the highest OID declared on the node, according to the control
        file. We use this number to reset all the control files in the 
        new cluster we're building, so that all the new objects will be
        added with the same OID. Since we're not dispatching the SQL to create
        the objects, this is our only way to synchronise the OIDs.

        Database must be down.
        '''
        
        self.Log('INFO', 'Looking for highest OID')
        self.CheckDown()
        self.highestoid = 16384 # first normal OID
        oids = []
        if self.cmd == 'MASTER':
            seg_prefix = self.config['SEG_PREFIX'] + '-'
            datadirs = [ self.root ]
            out = self.CallSlaves('GETHIGHESTOID', self.config['SEG_PREFIX'])
            for l in out.splitlines():
                a = l.split()
                if a[1] == "highestoid":
                    oids.append(int(a[2]))
        else:
            datadirs = self.datadirs
            seg_prefix = self.option

        seg_re = re.compile('^(%s\d+|dummyseg)$' % seg_prefix)
        for d in datadirs:
            for seg in os.listdir(d):
                if seg_re.match(seg):
                    cmd = "pg_controldata %s" % os.path.join(d, seg)
                    out = self.RunCmd(cmd, env=self.oldenv)
                    for l in out.splitlines():
                        a = l.split(':')
                        if a[0] == "Latest checkpoint's NextOID":
                            oids.append(int(a[1]))

        self.Log('DEBUG', "oids: %s" % str(oids))
        for o in oids:
            # XXX: what about overflow ?
            if o > self.highestoid:
                self.highestoid = o

        if self.cmd != 'MASTER':
            print self.highestoid

        self.Log('DEBUG', "highest oid found: %d" % self.highestoid)

#============================================================
if __name__ == '__main__':
    # Create a new GPUpgrade - should never throw exception
    u = GPUpgrade()
    
    # parses and validates input
    try:
        u.Setup()
    except Exception, e:
        u.Log('FATAL', str(e))
        sys.exit(1)
    
    # GPUpgrade calls itself on individual hosts, we switch behavior based
    # on the way that it gets called.  These options are not listed in
    # the usage information because they are strictly an internal interface.
    try:
    
        # MASTER - the main case, run on master only
        if u.cmd == 'MASTER':
    
            u.Log('INFO', 'gpmigrator version ' + __version__)
            u.Log('INFO', 'Python version %d.%d.%d %s %d' % sys.version_info)
    
            # User requested a revert to previous version
            if u.revert:
                u.Revert()
                sys.exit(0)
    
            # Read the statefile if we are trying to restart (--execute)
            current_state = {}
            statefile = os.path.join(u.workdir, 'state')
            if os.path.exists(statefile):
                u.state = open(statefile, 'r')
                for line in u.state:
                    current_state[line.strip()] = True
                u.state = open(statefile, 'a')
    
            # Be careful if the last upgrade died in an unstable state
            if 'BACKUP_VALID' in current_state and u.prepare:
                u.Revert()
    
            # Check that we can do the upgrade between the versions
            u.CheckVersions()
    
            # if we aren't trying to restart an upgrade or if the previous
            # run was just from --prepare then ignore the contents of the
            # statefile.
            if u.prepare:
                current_state = {}
            
            # Test failure before we bring up the database
            if u.faultinjection == 1:
                raise UpgradeError("faultinjection=%d" % u.faultinjection)

            # Test failure due to a bad lockfile in /tmp
            # For this injection we are assuming that the segments are running
            # on the local machine and using port 50000, not necessarily true
            # but should be good enough for testing.
            if u.faultinjection == 2:    # XXX
                try:
                    env = u.CheckUp()
                    u.dbup = [env, False]
                    u.Shutdown()
                except:
                    pass
                u.Log("FATAL", "faultinjection=%d" % u.faultinjection)
                open('/tmp/.s.PGSQL.50001.lock', 'w')

            # We always pull the current configuration from the old instance.
            # (It may be nice to rewrite to allow caching state information)
            shutdown = None
            lockfile = os.path.join(u.oldenv['MASTER_DATA_DIRECTORY'],
                                    'pg_hba.conf'+LOCKEXT)
            if os.path.exists(lockfile):
                raise UpgradeError("migration lock file already exists at: %s"
                                    % lockfile)
            try:
                try:
                    env = u.CheckUp(True)
                    shutdown = False
                    u.dbup = [env, False]
                    if env == u.newenv:
                        u.Log('FATAL', 'Cannot prepare with running new db')
                except:
                    shutdown = True
                    u.Startup(u.oldenv)

                # Test failure after we bring up the database
                #   - we should stop it again
                #   - unless we are running --prepare and it wasn't running
                if u.faultinjection == 3:
                    raise UpgradeError("faultinjection=%d" % u.faultinjection)
    
                # The way things are structured we will only issue selects against
                # the database that's "up" so mark the oldenv as running.
                u.ExtractInfo()
    
                # Create working directories on all hosts
                # + Requires configuration info collected in ExtractInfo
                # + Requires Execution on all hosts
                if 'CREATE_DIRS' not in current_state and not u.noinit:
                    u.CreateDirectories()
                    u.SetState('BOOTSTRAP: ' + u.RunCmd('date +%Y%m%d:%H:%M:%S'))
                    u.SetState('CREATE_DIRS')
    
                # Check the catalog
                if 'CHECKCAT' not in current_state and u.checkcat:
                    u.CheckCatalog()
                    u.SetState('CHECKCAT')
    
            # Whe have an extra layer of interupt handling around the --prepare
            # logic because we don't want to errors to cause an automatic Shutdown
            # which would occur going through the regular Cleanup logic
            except KeyboardInterrupt:
                if shutdown:
                    u.Shutdown()
                u.Log('FATAL', '***************************************')
                u.Log('FATAL', '==  Upgrade interupted by user ==        <<<<< ')
                u.Log('FATAL', '***************************************')
                sys.exit(1)
    
            except Exception, e:
                if shutdown:
                    u.Shutdown()
                u.Log('FATAL', str(e))
                u.Log('FATAL', '***************************************')
                u.Log('FATAL', '==  Upgrade Failed ==                    <<<<< ')
                u.Log('FATAL', '***************************************')
    
                sys.exit(1)
    
            # Prepare done, anything done after this point may allow modifying
            # the olddb
            if u.noinit and not u.execute:
                u.Log('INFO', 'Preparation successfully completed')
                sys.exit(0)
            if u.noinit:
                u.Log('INFO', '--noinit is only supported with --prepare')
                sys.exit(1)
    
            # SetupLockdown:
            # + Requires the database to be up
            # + Creates the upgrade user
            # + Shuts the database down
            # + Adjusts hba_conf to only allow upgrade user access
            # + Database is left down
            if u.execute:
                u.SetupLockdown()
            
            # Test failure after we have locked the database
            #   - we should unlock it
            if u.faultinjection == 4:
                raise UpgradeError("faultinjection=%d" % u.faultinjection)

            # different path for 3.1 to 3.2
            if u.method == "dumprestore":
    
                if u.execute:
                    u.Shutdown()
                elif shutdown:
                    u.Shutdown()
    
                # Make sure error handling doesn't shutdown the database if anything
                # should fail.
                u.dbup = None
    
                # Write configuration files for new db
                # + Requires configuration info collected in ExtractInfo
                # + Requires working directory on master node
                if 'CONFIG_FILES' not in current_state:
                    u.GenerateConfigFiles()
                    u.SetState('CONFIG_FILES')
        
                # Initalize the new database
                # + Requires working directories on all nodes
                # + Requires generated configuration file
                if ('INITDB' not in current_state):
                    u.InitNewDB()
                    u.SetState('INITDB')
                    u.Shutdown()
        
                # Prepare done, anything done after this point may allow modifying
                # the olddb
                if not u.execute:
                    u.Log('INFO', 'Preparation successfully completed')
                    sys.exit(0)
        
                # Make sure that the database isn't running
                u.CheckDown()
        
                # Set the ports for the upgrade server to the correct values
                #  OLD METHOD - needs review
                # if 'REMAP_PORTS' not in current_state:
                #    u.RemapPorts()
                #    u.SetState('REMAP_PORTS')
        
                # Start the database back up on all hosts so that we can 
                # gather information from them.
                if ('MAPPINGS' not in current_state   or
                    'STATISTICS' not in current_state or
                    'DUMP_SCHEMA' not in current_state):
        
                    u.Startup(u.oldenv)
        
                    # Build up Source database OID/relfile mappings
                    # + Requires running old db on all hosts
                    # + Requires created directories so we can store the mapping file
                    # + Requires execution on all hosts
                    # + Requires Lockdown
                    if 'MAPPINGS' not in current_state:
                        u.BuildMappings()
                        u.SetState('MAPPINGS')
                    if 'STATISTICS' not in current_state:
                        u.DumpStatistics()
                        u.SetState('STATISTICS')
        
                    # Call pg_dumpall and put results in a file
                    # + Requires running old db
                    # + Requires working directory on master node
                    # + Requires Lockdown
                    if 'DUMP_SCHEMA' not in current_state:
                        u.DumpSchema()
                        u.SetState('DUMP_SCHEMA')
        
                    # All information collected, shutdown old database
                    u.Shutdown()
                    
                # Initalize the new database
                # + Requires working directories on all nodes
                # + Requires generated configuration file
                #u.InitNewDB()
        
                # Lockdown the newDB
                # + Requires the database to be up
                # + Shuts the database down
                if 'NEWDB_LOCKDOWN' not in current_state:
                    u.Startup(u.newenv)
                    u.SetupLockdown()
                    u.Shutdown()
                    u.SetState('NEWDB_LOCKDOWN')
        
                # Import schema and build the mappings
                if ('IMPORT_SCHEMA' not in current_state or
                    'MAPPINGS2' not in current_state):
                    u.Startup(u.newenv)
        
                    if 'IMPORT_SCHEMA' not in current_state:
                        u.ImportSchema()
                        u.SetState('IMPORT_SCHEMA')
        
                    if 'MAPPINGS2' not in current_state:
                        u.BuildMappings()
                        u.SetState('MAPPINGS2')
                    u.Shutdown()
        
        
        
                # Distribute the dummy seg to all the segments and re-adjust 
                # gp_configuration on the master node.
                if 'EXPAND_SYS' not in current_state:
                    u.ExpandSystem()
                    u.SetState('EXPAND_SYS')
        
                # Reset the Xlogs
                if 'RESET_XLOGS' not in current_state:
                    u.ResetXLogs()
                    u.SetState('RESET_XLOGS')
        
                # Remap oids for the new database
                # + Requires working directories on all hosts
                # + Requires new db initialized
                if 'REMAP_OID' not in current_state:
                    u.RemapOID()
                    u.SetState('REMAP_OID')
        
                # Confirm that the resync/remapping was successful
                # + Restore statistics must either be after resetXlogs or
                #   requires an additional vacuum step.
                if 'RESTORE_STATISTICS' not in current_state:
                    u.Startup(u.newenv, utility=True)
                    u.RestoreStatistics()
                    u.SetState('RESTORE_STATISTICS')
                    u.Shutdown()
    
            else:
                # transform case
                if not u.execute:
                    if shutdown:
                        u.Shutdown()
    
                    u.Log('INFO', 'Preparation successfully completed')
                    sys.exit(0)

                # Write configuration files 
                # + Required for Revert() to work correctly
                if 'CONFIG_FILES' not in current_state:
                    u.new_master_port = u.config['MASTER_PORT']
                    u.new_port_base   = u.config['PORT_BASE']
                    if len(u.mirrors) > 0:
                        u.new_mirror_port_base = u.config['MIRROR_PORT_BASE']
                    u.GenerateConfigFiles()
                    u.SetState('CONFIG_FILES')
    
                # get the set of databases
                db = u.Select('''select oid, datname from pg_database order by
                                 datname''')
                dbs = {}
                for d in db:
                    dbs[str(d['oid'])] = d['datname']
    
                # business end
                if 'MAPPINGS' not in current_state:
                    u.BuildMappings()
                    u.SetState('MAPPINGS')
    
                if 'EXTRACTCATFILES' not in current_state:
                    u.ExtractCatFiles()
                    u.SetState('EXTRACTCATFILES')
    
                if 'EXTRACTAOSEGS' not in current_state:
                    u.ExtractAosegs()
                    u.SetState('EXTRACTAOSEGS')
    
                # All information collected, shutdown old database
                u.Shutdown()

                # Test failure
                #  - unlock database
                if u.faultinjection == 5:
                    raise UpgradeError("faultinjection=%d" % u.faultinjection)
    
                if 'GETHIGHESTOID' not in current_state:
                    u.GetHighestOid()
                    u.SetState('GETHIGHESTOID')
    
                if 'BUILDSKEL' not in current_state:
                    u.BuildSkel()
                    u.SetState('BUILDSKEL')
    
                sov = u.oldversion[:3]
                snv = u.newversion[:3]
                if 'SETCATVERSION' not in current_state:
                    u.SetCatVersion(sov, snv)
                    u.SetState('SETCATVERSION')
    
                if 'TRANSFORMCAT' not in current_state:
                    u.TransformDbs(dbs)
                    u.SetState('TRANSFORMCAT')
    
                u.TouchupConfig()

                # Test failure
                #  - unlock database
                if u.faultinjection == 6:
                    raise UpgradeError("faultinjection=%d" % u.faultinjection)

                # Lockdown the newDB
                # + Requires the database to be up
                # + Shuts the database down
                if 'NEWDB_LOCKDOWN' not in current_state:
                    u.Startup(u.newenv)
                    u.SetupLockdown()
                    u.Shutdown()
                    u.SetState('NEWDB_LOCKDOWN')
    
                if 'MAPPINGS2' not in current_state:
                    u.Startup(u.newenv)
                    u.BuildMappings()
                    u.SetState('MAPPINGS2')
                    u.Shutdown()
        
                # Remap oids for the new database
                # + Requires working directories on all hosts
                # + Requires new db initialized
                if 'REMAP_OID' not in current_state:
                    u.RemapOID()
                    u.SetState('REMAP_OID')
    
                # Test failure
                #  - unlock database
                if u.faultinjection == 7:
                    raise UpgradeError("faultinjection=%d" % u.faultinjection)

            if 'NEWDB_VALID' not in current_state:
                u.SetState('NEWDB_VALID')
    
            # We haven't modified anything under the master directory yet.
            # If anything has gone wrong up to this point it is pretty much
            # safe to blow away everything under 'upgrade/' and 'backup/'
            # (The only thing to be careful about is that we shutdown the
            #  new db before we remove the storage from under it.)
                
            # To install the new db under the old master path we go through
            # pains to make it as robust as possible.  This is done via a
            # combination of redundancy and hard links.
    
            # --------
            # Stage 1:
            # -------- 
            # The current state of the world is as follows
            #    DATA_DIR/         = untouched original db
            #    DATA_DIR/upgrade  = fully upgraded new db
            #    DATA_DIR/backup   = empty except for the state and flag files.
            # => Make a deep hardlink copy of DATA_DIR -> DATA_DIR/backup
            if u.upgrade:
                u.ReleaseLockdown(u.oldenv)
            else:
                u.ReleaseLockdown(u.newenv)
                
            # Test failure after releasing the lockdown
            if u.faultinjection == 8:
                raise UpgradeError("faultinjection=%d" % u.faultinjection)
    
            if 'BACKUP_VALID' not in current_state:
                u.DeepLink('BACKUP')
                u.SetState('BACKUP_VALID')
    
            try:

                # Test failure after installing the backup
                #   - Revert is necessary
                if u.faultinjection == 9:
                    raise UpgradeError("faultinjection=%d" % u.faultinjection)

                # Test failure during Revert
                #   - See Revert()
                if u.faultinjection == -1:
                    raise UpgradeError("faultinjection=%d" % u.faultinjection)

                # --------
                # Stage 2:
                # -------- 
                # The current state of the world is as follows
                #    DATA_DIR/         = contents unreliable
                #    DATA_DIR/upgrade  = fully upgraded new db
                #    DATA_DIR/backup   = untouched original db
                # => Make a deep hard link copy of DATA_DIR/upgrade -> DATA_DIR
                # => Adjust new pg_configuration to point to DATA_DIR
                u.DeepLink('INSTALL')
                u.FixConfig()

                # Test failure after installing the newdb
                #   - Revert is necessary
                if u.faultinjection == 10:
                    raise UpgradeError("faultinjection=%d" % u.faultinjection)
    
                # Everything upgraded and validated
                # + Release the lockdown
                # + Mark install valid
                u.Startup(u.newenv)

                # VACUUM FREEZE template1, since we haven't already
                u.Update('VACUUM FREEZE;', db='template1')
            
                u.ReleaseLockdown(u.newenv)
    
                # Finally, drop the upgrade user:
                #  - The migrator user shouldn't own anything, but if the
                #    "dumprestore" method was ever used on this database
                #    then it might.
                u.Log('INFO', "Removing upgrade user");
                try:
                    u.Update('DROP USER ' + MIGRATIONUSER)
                except:
                    u.Log('WARN', 'Objects owned by gpmigrator reassigned to dba')
                    admin = u.Select('''select rolname from pg_authid 
                                        where oid = 10''')[0];
                    dbs = u.Select('''select datname from pg_database
                                      where datname != 'template0' ''')
                    for db in dbs:
                        u.Update('REASSIGN OWNED BY gpmigrator TO ' + admin, db)
                    u.Update('DROP USER ' + MIGRATIONUSER)

                # Test failure after installing the newdb
                #   - Revert is necessary
                #   - gpmigrator user no longer exists
                if u.faultinjection == 11:
                    raise UpgradeError("faultinjection=%d" % u.faultinjection)
        
                if u.warnings:
                    u.Log('WARN', '***************************************')
                    u.Log('WARN', 'Warnings encountered during upgrade.')
                    u.Log('WARN', '***************************************')
    
            except Exception, e:
                u.Log('FATAL', str(e))
                u.Revert()
                raise e
    
            # --------
            # Stage 3:
            # -------- 
            # The current state of the world is as follows
            #    DATA_DIR/         = fully upgraded new db
            #    DATA_DIR/upgrade  = fully upgraded new db
            #    DATA_DIR/backup   = untouched original db
            # => Remove redundant DATA_DIR/upgrade
            # => Remove historical DATA_DIR/backup
            u.RemoveDirectories(force=True)
    
            # -----------------
            # Upgrade Complete:
            # -----------------
            # The current state of the world is as follows
            #    DATA_DIR/         = fully upgraded new db
            u.Log('INFO', 
'''
---------------------------------------------------
Upgrade Successful
---------------------------------------------------
Please consult release notes for post-upgrade 
instructions to complete environment configuration
---------------------------------------------------
''')


    #---------------------------------------------------------
    # The rest of the options are executed on a per-host basis
        elif u.cmd == 'SETSTATE':
            u.SetState(u.option)
        elif u.cmd == 'CHKDIR':
            try:
                u.CheckDirectories()
            except UpgradeError, e:
                if str(e) == 'Directories exist':
                    sys.exit(1)
                raise e
        elif u.cmd == 'CHKDOWN':
            u.CheckDown()
        elif u.cmd == 'LOCKDOWN':
            u.SetupLockdown()
        elif u.cmd == 'UNLOCK':
            u.ReleaseLockdown(None)
        elif u.cmd == 'MKDIR':
            u.CreateDirectories()
        elif u.cmd == 'RMDIR':
            if u.option == 'False':
                u.RemoveDirectories(False)
            else:
                u.RemoveDirectories(True)
        elif u.cmd == 'RESETXLOG':
            u.ResetXLogs()
        elif u.cmd == 'MAPPINGS':
            u.BuildMappings()
        elif u.cmd == 'REMAPOID':
            u.RemapOID()
        elif u.cmd == 'DEEPLINK':
            u.DeepLink(u.option)
        elif u.cmd == 'EXTRACTCATFILES':
            u.ExtractCatFiles()
        elif u.cmd == 'BUILDSKEL':
            u.BuildSkel()
        elif u.cmd == 'SETCATVERSION':
            u.SetCatVersion(u.oldversion[:3], u.newversion[:3])
        elif u.cmd == 'TRANSFORMCAT':
            u.TransformDbs(u.option2)
        elif u.cmd == 'EXTRACTAOSEGS':
            u.ExtractAosegs()
        elif u.cmd == 'GETHIGHESTOID':
            u.GetHighestOid()
        else:
            raise Exception('Unknown cmd: ' + str(u.cmd))
    
        if u.threadpool:
            t = u.threadpool
            u.threadpool = None
            del t
    
    # Any error that can happen
    except KeyboardInterrupt:
        try:    u.Cleanup()
        except Exception, e2: 
            u.Log('FATAL', str(e2))
        u.Log('FATAL', '***************************************')
        u.Log('FATAL', '==  Upgrade interupted by user ==        <<<<< ')
        u.Log('FATAL', '***************************************')
        sys.exit(1)
    
    except ConnectionError, e:
        try:   u.Cleanup()
        except Exception, e2: 
            u.Log('FATAL', str(e2))
        u.Log('FATAL', '***************************************')
        u.Log('FATAL', str(e))
        u.Log('FATAL', '***************************************')
        sys.exit(1)
    
    except UpgradeError, e:
        try:   u.Cleanup()
        except Exception, e2: 
            u.Log('FATAL', str(e2))
        u.Log('FATAL', '***************************************')
        u.Log('FATAL', str(e))
        u.Log('FATAL', '***************************************')
        sys.exit(1)
    
    except CmdError, e:
        try:   u.Cleanup()
        except Exception, e2:
            u.Log('FATAL', str(e2))
        u.Log('FATAL', '***************************************')
        u.Log('FATAL', 'Error executing command:')
        u.Log('FATAL', '  ' + str(e.cmd))
        u.Log('FATAL', '  ' + str(e.stderr))
        u.Log('FATAL', '***************************************')
        sys.exit(1)
    
    # Shouldn't get any of these, if they occur it is probably a bug in
    # the upgrader.
    except Exception, e:
        try:   u.Cleanup()
        except Exception, e2: 
            u.Log('FATAL', str(e2))
        u.Log('FATAL', '***************************************')
        u.Log('FATAL', str(e))
        u.Log('FATAL', '***************************************')
        sys.stderr.write(traceback.format_exc())
        sys.exit(1)
    
    # This shouldn't need to be explicit, but if something goes wrong in
    # thread shutdown it forces the issue.
    sys.exit(0)
