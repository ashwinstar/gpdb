#!/usr/bin/env python
# -*- coding: utf-8 -*-
'''
Usage: gpmigrator [options] old-gphome new-gphome

Options:
  -h, --help            show this help message and exit
  -v, --version         show the program's version number and exit
  -q                    quiet mode
  -d DIRECTORY          the master host data directory
  -l DIRECTORY          log file directory
'''

#============================================================
import sys, os, signal, subprocess, types, csv
import optparse, tempfile, re, traceback
from datetime import date
from time import localtime, strftime
import urllib    # for passing strings across gpssh

EXECNAME = os.path.split(__file__)[-1]
libdir = sys.path[0] + '/lib'
sys.path.append(libdir)
try: 
    import pg8000
except ImportError, e:
    sys.exit('Error: unable to import module: ' + str(e))

MIGRATIONUSER = 'gpmigrator'
LOCKEXT       = '.gpmigrator_orig'


#============================================================
def pretty_version(v):
    '''
    Turns the RCS revision number into a prettier format
    '''
    m = re.compile('Revision: #(\d+)').search(v)
    if m: return str(2 + (float(m.group(1))/100))
    else: return str(v)
__version__ = pretty_version('$Revision: #5 $')

#============================================================
def cli_help():
    help_path = os.path.join(sys.path[0], '..', 'docs', 'cli_help', EXECNAME + '_help');
    f = None
    try:
        try:
            f = open(help_path);
            return f.read(-1)
        except:
            return ''
    finally:
        if f: f.close()

#============================================================
def usage():
    print cli_help() or __doc__

#============================================================
class ConnectionError(StandardError): pass
class UpgradeError(StandardError): pass
class CmdError(StandardError):
    def __init__(self, cmd, stdout, stderr):
        self.cmd = cmd
        self.stdout = stdout
        self.stderr = stderr
    def __str__(self):
        return self.stderr

#============================================================
class GPUpgrade:
    '''
    Greenplum Database Upgrade/Downgrade Utility
    '''

    # INTERNAL command:
    #   MASTER    - default, run on master, [not included in list]
    #   MKDIR     - Create directories, run on every host
    #   RMDIR     - Remove directories, run on every host
    #   CHKDIR    - Check directories, run on every host
    #   RESETXLOG - Syncronize xlogs
    #   REMAPOID  - Link newdb to old oids, run on every host
    #   DEEPLINK  - Recursive hardlink
    commands = ['SETSTATE', 'MKDIR', 'RMDIR', 'CHKDIR', 'RESETXLOG', 'MAPPINGS',
                'REMAPOID', 'DEEPLINK', 'CHKDOWN', 'LOCKDOWN', 'UNLOCK']

    #------------------------------------------------------------
    def __init__(self):
        '''
        The most basic of initialization
        '''
        self.cmd       = 'MASTER'      # Command being run
        self.pid       = os.getpid()   # Process ID of the master

        # Non-master variables
        self.option    = None     # Argument passed to cmd
        self.option2   = None     # Argument passed to cmd
        
    # Enviornment and system info
        self.masterdir = None     # Master Data Directory
        self.masterport = 5432    # Master Port
        self.datadirs  = None     # Set of all data and mirror directories
        self.oldhome   = None     # Old gphome/bin directory
        self.newhome   = None     # New gphome/bin directory
        self.oldenv    = None     # enviornment: old gp env
        self.newenv    = None     # enviornment: new gp env
        self.user      = None     # db admin user
        self.host      = None     # master hostname
        self.path      = None     # Default path
        self.upgrade   = None     # True for upgrade, False for downgrade
        self.logdir    = None
        self.logfile   = None

    # Upgrade information and state
        self.debug      = False
        self.quiet      = False
        self.revert     = False
        self.checkcat   = False
        self.checkschema = True
        self.validate   = False
        self.warnings   = False
        self.oldversion = None
        self.newversion = None
        self.root       = None     # directory: masterdir/..
        self.backup     = None     # directory: root/backup
        self.tmpdir     = None     # directory: root/upgrade
        self.newmaster  = None     # directory: upgrade/gp-1
        self.state      = None     # file:      backup/state
        self.config     = {}       # gp_init_config for new db
        self.mappings   = None     # Mappings of old oid to new oids
        self.hosts      = []       # list of hosts
        self.segments   = []       # list of segments
        self.mirrors    = []       # list of mirrors
        self.dbup       = None
        self.interupted = False    # SIGINT recieved

    #------------------------------------------------------------
    def Setup(self):
        '''
        Basic initialization, separate from __init__ for exception
        handling purposes.
        '''

        # This is the same path used by gpinitsystem
        self.path = '/usr/kerberos/bin:/usr/sfw/bin:/opt/sfw/bin'
        self.path += ':/usr/local/bin:/bin:/usr/bin:/sbin:/usr/sbin:/usr/ucb'
        self.path += ':/sw/bin'

        # Set defaults 
        self.user      = os.environ.get('USER') or os.environ.get('LOGNAME')
        self.host      = self.RunCmd('hostname')
        self.masterdir = os.environ.get('MASTER_DATA_DIRECTORY')

        self.ParseInput()

        # Extract path from input master directory
        if self.cmd == 'MASTER':
            u.Log('INFO', 'Beginning upgrade')
            u.Log('INFO', 'Checking configuration')

            if not self.masterdir:
                raise UpgradeError('MASTER_DATA_DIRECTORY is not defined')
            self.masterdir.rstrip('/')

            # The configuration file
            conf = os.path.join(self.masterdir, 'postgresql.conf')


            # All the parameters we are interested in are integer values
            def getconf(x):
                conf_re  = re.compile('^\s*%s\s*=\s*(\d+)' % x)
                conf_str = self.RunCmd('grep %s %s' % (x, conf))
                value = None
                for line in conf_str.split('\n'):
                    match = conf_re.search(line)
                    if match:
                        value = int(match.group(1))
                return value

            # Find the port for this segment:
            self.masterport = getconf('port')
            if self.masterport == None:
                raise UpgradeError('Could not determine master port from ' + conf)

            # Verify that (max_connections == superuser_reserved_connections)
            # max_conn = getconf('max_connections')
            # reserved = getconf('superuser_reserved_connections')

            masterpath, masterdir = os.path.split(self.masterdir)
            self.root   = masterpath
            self.tmpdir = os.path.join(masterpath, 'upgrade')
            self.backup = os.path.join(masterpath, 'backup')
            self.newmaster = os.path.join(masterpath, 'upgrade', masterdir)
            self.oldenv = self.SetupEnv(self.oldhome, self.masterdir)
            self.newenv = self.SetupEnv(self.newhome, self.newmaster)

            # Find the SEG_PREFIX (everything except the trailing "-1" on the masterdir)
            self.config['SEG_PREFIX'] = masterdir[:-2]

        else:
            self.oldenv = self.SetupEnv(self.oldhome, None)
            self.newenv = self.SetupEnv(self.newhome, None)

    #------------------------------------------------------------
    def ParseInput(self):
        '''
        Parses and validates input to the script
        '''

        try:
            parser = optparse.OptionParser(usage=(cli_help() or __doc__), add_help_option=False)
            parser.add_option('-v', '--version', action='store_true',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('-h', '--help', action='store_true',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('-d', dest='directory', 
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('-l', dest='logdir',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('-q', dest='quiet', action='store_true',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('-R', dest='revert', action='store_true',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--debug', action='store_true',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--internal-enable-checkcat',
                              dest='checkcat', action='store_true',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--internal-disable-checkschema',                              
                              dest='nocheckschema', action='store_true',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--internal-enable-validation',                              
                              dest='validate', action='store_true',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--internal-command', dest='command',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--internal-pid', dest='pid',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--internal-dirs', dest='datadirs',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--internal-option', dest='option',
                              help=optparse.SUPPRESS_HELP)
            parser.add_option('--internal-option2', dest='option2',
                              help=optparse.SUPPRESS_HELP)
            (options, args) = parser.parse_args()
            
            if options.version:
                print EXECNAME + ' ' + __version__
                sys.exit(0)

            if options.help:
                usage()
                sys.exit(0)

            if len(args) != 2:
                usage()
                parser.error("incorrect number of arguments: %s" % str(args))

        except Exception, e:
            usage()
            raise UpgradeError('Error parsing input: ' + str(e))

        if options.revert:
            self.revert = True

        if options.directory:
            self.masterdir = options.directory
        if options.command:
            if options.command not in self.commands:
                parser.error('INVALID INTERNAL COMMAND: ' + options.command)
            self.cmd = options.command
        if options.pid:
            if self.cmd == 'MASTER':
                parser.error('INVALID INTERNAL COMMAND: ' + self.cmd)
            self.pid = int(options.pid)
        self.oldhome   = args[0].rstrip('/')
        self.newhome   = args[1].rstrip('/')
        if options.datadirs:
            self.datadirs = urllib.unquote(options.datadirs).split();
        if options.option:
            self.option   = urllib.unquote(options.option)
        if options.option2:
            self.option2  = urllib.unquote(options.option2)
        if options.debug:
            self.debug = True
        if options.quiet:
            self.quiet = True
        if options.logdir and os.path.isdir(options.logdir):
            self.logdir = options.logdir
        else:
            self.logdir = os.path.join(os.environ['HOME'], 'gpAdminLogs')
        if options.checkcat:
            self.checkcat = True
        if options.nocheckschema:
            self.checkschema = False
        if options.validate:
            self.validate = True

        if self.cmd == 'MASTER':
            today = date.today().strftime('%Y%m%d')
            logname = os.path.join(self.logdir, '%s_%s.log' % (EXECNAME, today))
            self.logfile = open(logname, 'a')

            self.pid = os.getpid()
            if self.masterdir == None:
                self.Log('FATAL', 'MASTER_DATA_DIRECTORY parameter not set')
                raise UpgradeError('Initialization failed')
            if not os.path.exists(self.masterdir):
                self.Log('FATAL', 'MASTER_DATA_DIRECTORY: %s not found'
                         % self.masterdir)
                raise UpgradeError('Initialization failed')
            if not os.path.exists(self.oldhome):
                self.Log('FATAL', ' directory not found: ' + self.oldhome)
                raise UpgradeError('Initialization failed')
            if not os.path.exists(self.newhome):
                self.Log('FATAL', ' directory not found: ' + self.newhome)
                raise UpgradeError('Initialization failed')



    #------------------------------------------------------------
    def Cleanup(self):
        '''
        Cleanup open connections.
        Separate from __del__ because that caused weird issues with exit() 
        behavior.
        '''
        if self.cmd == 'MASTER':
            self.Log('FATAL', 'Fatal error occured - Recovering')
            try:
                self.Shutdown()
            except Exception, e:
                self.Log('FATAL', 'Cleanup failure: ' + str(e))

            try:
                self.ReleaseLockdown(self.oldenv)
            except Exception, e:
                self.Log('FATAL', 'Cleanup failure: ' + str(e))



    #------------------------------------------------------------
    def SetState(self, newstate):
        '''
        Sets the state in the upgrader state file
        '''

        # Set state across all hosts, if all hosts succeed then set the 
        # master state
        if self.cmd == 'MASTER':
            self.CallSlaves('SETSTATE', newstate)
            try:
                self.state.write(str(newstate) + "\n")
                self.state.flush()
            except Exception, e:
                raise UpgradeError('Error writing to statefile: (%s)' % str(e))
        else:
            for d in self.datadirs:
                statefile = os.path.join(d, 'backup', 'hoststate')
                file = open(statefile, 'a')
                file.write(str(newstate) + "\n")
                file.close()

    #------------------------------------------------------------
    def RunCmd(self, cmd, env=None, utility=False, supressDebug=False):
        '''
        Runs a single command on this machine
        '''

        if self.debug and not supressDebug: 
            self.Log('DEBUG', "CMD: " + cmd)

        # If utility mode has been specified add role to env
        if env == None:
            env = {'PATH': self.path}

        if utility:
            env['PGOPTIONS'] = '-c gp_session_role=utility'

        cmd = cmd.split(' ')
        try:
            pipe = subprocess.Popen(cmd, env=env, 
                                    stdout=subprocess.PIPE, 
                                    stderr=subprocess.PIPE)
            result  = pipe.communicate();
        except OSError, e:
            raise CmdError(' '.join(cmd), '', str(e))

        if self.debug and not supressDebug:
            self.Log('DEBUG', result[1])

        if pipe.returncode:
            raise CmdError(' '.join(cmd), result[0], result[1])
        else:
            return result[0].strip();

    #------------------------------------------------------------
    def CallSlaves(self, cmd, option='', option2=''):
        '''
        Calls every host to execute the given command with the given option 
        value
        '''
                    
        # Check for things that should never happen
        if self.cmd != 'MASTER':
            raise UpgradeError("Recursive communication error")
        if not self.datadirs:
            raise UpgradeError("Failure initializing data directories")

        # Construct a string of '-h hostname' for all hosts
        exec_cmd = 'gpssh'
        for h in self.hosts: 
            exec_cmd += ' -h %s' % h

        if self.upgrade:
            env = self.newenv
            exec_cmd += ' %s/bin/lib/gpenv.sh %s ' % (self.newhome, EXECNAME)
        else:
            env = self.oldenv
            exec_cmd += ' %s/bin/lib/gpenv.sh %s ' % (self.oldhome, EXECNAME)

        exec_cmd += self.oldhome + ' ' + self.newhome
        exec_cmd += ' --internal-command=' + str(cmd)
        exec_cmd += ' --internal-pid=' + str(self.pid)
        exec_cmd += ' --internal-dirs=%s' % urllib.quote(str(self.datadirs))
        exec_cmd += ' --internal-option=%s' % urllib.quote(str(option))
        exec_cmd += ' --internal-option2=%s' % urllib.quote(str(option2))
        if self.revert:
            exec_cmd += ' -R'

        try:
            result = self.RunCmd(exec_cmd, env=env)
            sys.stdout.write(result)
        except CmdError, e:
            if self.debug:
                print e.cmd
            sys.stdout.write(e.stdout)
            sys.stderr.write(e.stderr)
            raise UpgradeError('Fatal Segment Error')
        
        self.Log('GPSSH', result)

    #------------------------------------------------------------
    def CheckDirectories(self):
        err = False
        for d in self.datadirs:
            p = os.path.join(d, 'upgrade')
            if os.path.exists(p):
                self.Log('WARN', '%s : File exists' % p)
                err = True
            p = os.path.join(d, 'backup')
            if os.path.exists(p):
                self.Log('WARN', '%s : File exists' % p)
                err = True
        if err:
            raise UpgradeError('Directories exist')
            
    #------------------------------------------------------------
    def SetupEnv(self, gphome, masterdir):
        '''
        Sets up environment variables for Greenplum Administration
        '''
        home  = os.environ.get('HOME')
        lpath = os.environ.get('LD_LIBRARY_PATH')
        dypath = os.environ.get('DYLD_LIBRARY_PATH')

        # Add $GPHOME/bin to the path for this environment
        path = '%s/bin:%s/ext/python/bin:%s' % (gphome, gphome, self.path)

        if lpath:
            lpath = '%s/lib:%s/ext/python/lib:%s' % (gphome, gphome, lpath)
        else:
            lpath = '%s/lib:%s/ext/python/lib' % (gphome, gphome)
        if dypath:
            dypath = '%s/lib:%s/ext/python/lib:%s' % (gphome, gphome, dypath)
        else:
            dypath = '%s/lib:%s/ext/python/lib' % (gphome, gphome)

        env = {}
        env['HOME']    = home
        env['USER']    = self.user
        env['LOGNAME'] = self.user
        env['GPHOME']  = gphome
        env['PATH']    = path
        env['LD_LIBRARY_PATH'] = lpath
        env['DYLD_LIBRARY_PATH'] = dypath
        if masterdir:
            env['MASTER_DATA_DIRECTORY'] = masterdir
            env['PGPORT'] = str(self.masterport)
        return env

    #------------------------------------------------------------
    def Log(self, type, msg):

        if type not in ['NONE', 'INFO', 'WARN', 'FATAL', 'DEBUG', 'GPSSH']:
            print '[WARN] Odd log type: %s' % str(type)
        
        if type in ['DEBUG', 'GPSSH'] and not self.debug:
            return

        if type in ['WARN', 'ERROR']:
            self.warnings = True

        if type == 'NONE':
            prefix = ''
        else:
            prefix = ':'.join(
                [strftime('%Y%m%d:%H:%M:%S', localtime()), EXECNAME, 
                 self.host, self.user, '[%s]' % type, '-'])

        try:
            for m in msg.splitlines():
                if m.strip() == '': 
                    continue

                if (self.logfile):
                    self.logfile.write('%s%s\n' % (prefix, m))
                    self.logfile.flush()

                if type == 'FATAL' or type == 'WARN' or not self.quiet:
                    sys.stderr.write('%s%s\n' % (prefix, m))
        except:
            pass

    #------------------------------------------------------------
    def Select(self, qry, db='template1', port=None):
        '''
        Execute a SQL query and return an array of result rows
           + Single columns will be returned as an array of values
           + Multiple columns will be returned as an array of tuples
        '''

        #
        # This is a little gross!
        #
        #   If we are executing from one of the segments then we don't
        #   actually know where the data directory is for the segment
        #   is so we can't check if we are in lockdown mode
        #
        #   Fortunately we never actually lock the segments, so we can
        #   always run as current user.
        #
        if self.cmd == 'MASTER':
            if not self.dbup:
                raise UpgradeError('database is down')
            [env, utility] = self.dbup

            locked = os.path.join(env['MASTER_DATA_DIRECTORY'],
                                  'pg_hba.conf'+LOCKEXT)
            if os.path.exists(locked):
                user = MIGRATIONUSER
            else:
                user = env['USER']

        else:

            # If we lockdown on segments this needs to change, some method
            # would need to be made to determine if the segment in question
            # is locked
            user = self.user
            utility = True

        if port == None:
            port = self.masterport
        elif port != self.masterport:
            utility = True

        if utility:
            options = '-c gp_session_role=utility'
        else:
            options = ''

        conn = None
        try:
            conn = pg8000.Connection(user=user,
                                     host='localhost',
                                     database=db, 
                                     options=options,
                                     port=port,
                                     socket_timeout=5000)
        except Exception, e:
            self.Log('FATAL', 'Could not establish connection to database')
            raise ConnectionError(str(e))

        try:
            conn.execute(qry)
        except Exception, e:
            conn.close()
            self.Log('FATAL', 'Error executing SQL')
            raise ConnectionError('%s\nsql> %s' % (str(e), qry))

        rows = []
        for tuple in conn.iterate_dict():
            if len(tuple) == 1: 
                rows.append(tuple.values()[0])
            else: 
                rows.append(tuple)
        conn.close()
        return rows

    #------------------------------------------------------------
    def Update(self, qry, db='template1', port=None):
        '''
        Execute a SQL query expecting no output
        '''

        #
        # This is a little gross!
        #
        #   If we are executing from one of the segments then we don't
        #   have the current database state, so we have to know what to
        #   do via other means.
        #
        #   The assumption is:
        #      A) utility = true
        #      B) pguser = MIGRATIONUSER
        #
        #   If we ever need to run as the non-upgrade user from a segment
        #   this code will obviously need to change
        #
        if self.cmd == 'MASTER':
            if not self.dbup:
                raise UpgradeError('database is down')
            [env, utility] = self.dbup

            locked = os.path.join(env['MASTER_DATA_DIRECTORY'], 
                                  'pg_hba.conf'+LOCKEXT)
            if os.path.exists(locked):
                user = MIGRATIONUSER
            else:
                user = env['USER']
        else:

            # If we lockdown on segments this needs to change, some method
            # would need to be made to determine if the segment in question
            # is locked
            user = self.user
            utility = True

        if port == None:
            port = self.masterport
        
        if utility:  options = '-c gp_session_role=utility'
        else:        options = ''

        conn = None
        try:
            conn = pg8000.Connection(user=user, 
                                     host='localhost',
                                     database=db, 
                                     options=options,
                                     port=port,
                                     socket_timeout=5000)
        except Exception, e:
            self.Log('FATAL', 'Could not establish connection to database')
            raise ConnectionError(str(e))

        try:
            conn.execute(qry)
        except Exception, e:
            self.Log('FATAL', 'Error executing SQL')
            raise ConnectionError('%s\nsql> %s' % (str(e), qry))

        finally:
            conn.close()

    #------------------------------------------------------------
    def CheckDown(self):
        '''
        Checks that neither postmaster is running and that the database 
        was cleanly shutdown.
        '''
        if self.cmd == 'MASTER':
            dirs = [ self.root ]
            prefix = self.config['SEG_PREFIX'] + '-'
        else:
            dirs   = self.datadirs
            prefix = self.option

        segdir_re = re.compile(prefix+'\d+$')
        shutdown_re = re.compile('Database cluster state: *(.*)')
            
        for d in dirs:

            # look for segments in the directory
            for content in os.listdir(d):

                # ignore anything not matching the segment prefix
                if not segdir_re.match(content):
                    continue

                # construct full path to segment and upgrade segment
                oldseg = os.path.join(d, content)
                newseg = os.path.join(d, 'upgrade', content)

                # Only check the upgrade directory if its not legacy
                if self.datadirs:
                    dirs = [oldseg, newseg]
                else:
                    dirs = [oldseg]

                for dir in dirs:
                    if dir == oldseg:  env = self.oldenv
                    else:              env = self.newenv



                    # upgrade directory might not actually exist
                    if not os.path.isdir(dir):
                        continue

                    pid = os.path.join(dir, 'postmaster.pid')
                    if os.path.exists(pid):
                        raise UpgradeError("Greenplum process running: " + pid)

                    shutdown = self.RunCmd('pg_controldata ' + dir, env=env)
                    for line in shutdown.split('\n'):
                        m = shutdown_re.match(line)
                        if m:
                            if m.group(1) == 'shut down': 
                                break
                            msg  = 'pg_controldata: "Database cluster state: %s"\n' % m.group(1)
                            msg += 'Greenplum segment %s did not shutdown cleanly' % dir
                            if self.revert:
                                self.Log('WARN', msg)
                            else:
                                raise UpgradeError(msg)
            
        if self.cmd == 'MASTER' and self.datadirs:
            self.CallSlaves('CHKDOWN', self.config['SEG_PREFIX'])
            
        return True

    #------------------------------------------------------------
    def CheckUp(self):
        '''
        Checks if one of the postmasters is up and running.
        Return the environment of the running server
        '''
        olddir = self.oldenv['MASTER_DATA_DIRECTORY']
        newdir = self.newenv['MASTER_DATA_DIRECTORY']

        if olddir and os.path.exists('%s/postmaster.pid' % olddir):
            return self.oldenv
        if newdir and os.path.exists('%s/postmaster.pid' % newdir):
            return self.newenv
        raise UpgradeError("Postmaster failed to start")

    #------------------------------------------------------------
    def Startup(self, env, utility=False):
        '''
        Starts up the specified database
        '''

        if self.dbup:
            raise UpgradeError('database already started')
        self.dbup = [env, utility]

        if (env == self.oldenv):
            self.Log('INFO', 'Starting old Greenplum postmaster')
        else:
            self.Log('INFO', 'Starting new Greenplum postmaster')

        try:
            if utility:  cmd = 'gpstart -a -m'
            else:        cmd = 'gpstart -a'

            locked = os.path.join(env['MASTER_DATA_DIRECTORY'],
                                  'pg_hba.conf'+LOCKEXT)
            try:
                if os.path.exists(locked):
                    env['PGUSER'] = MIGRATIONUSER
                    self.Log('DEBUG', "lockfile: '%s' exists" % locked)
                else:
                    self.Log('DEBUG', "lockfile: '%s' does not exist" % locked)

                pid = subprocess.Popen(cmd, preexec_fn=os.setpgrp,
                                       env=env, shell=True,
                                       stdout=self.logfile, 
                                       stderr=self.logfile)
            finally:
                if os.path.exists(locked):
                    del env['PGUSER']

            # Ignore interupt requests until startup is done
            error = None
            retcode = None
            while retcode == None:
                try: 
                    retcode = pid.wait();

                except KeyboardInterrupt, e:
                    if not self.interupted:
                        self.Log('FATAL', '***************************************')
                        self.Log('FATAL', 'SIGINT-: Upgrade Aborted')
                        self.Log('FATAL', '***************************************')
                        self.Log('INFO',  'Performing clean abort')
                        self.interupted = True
                        error = e
                    else:
                        self.Log('INFO',  'SIGINT-: Still processing shutdown')

            if retcode < 0:
                raise UpgradeError("Startup terminated by signal");

            today = date.today().strftime('%Y%m%d')
            logname = os.path.join(self.logdir, 'gpstart_%s.log' % today)
            if retcode == 1:
                self.Log('WARN', '***************************************')
                self.Log('WARN', 'Warnings generated starting cluster')
                self.Log('WARN', 'Check %s for detailed warnings' % logname)
                self.Log('WARN', '***************************************')
            if retcode > 1:
                self.Log('FATAL', '***************************************')
                self.Log('FATAL', 'Startup failed with error code %d' % retcode)
                self.Log('FATAL', 'Check %s for detailed warnings' % logname)
                self.Log('FATAL', '***************************************')
                raise UpgradeError('Startup failed')

            # If we recieved an interupt, resignal it now that the startup is done
            if error: 
                raise error

        except OSError, e:
            self.Log('FATAL', str(e))
            raise UpgradeError('Startup failed')

        self.CheckUp();


    #------------------------------------------------------------
    def Shutdown(self):
        '''
        Stops the specified database
        '''
        if not self.dbup:
            return
        [env, utility] = self.dbup
        self.dbup = None

        dir = env['MASTER_DATA_DIRECTORY']
        if not os.path.exists('%s/postmaster.pid' % dir):
            self.Log('WARN', 
                     'Shutdown skipped - %s/postmaster.pid not found' % dir)
            return

        if (env == self.oldenv):
            self.Log('INFO', 'Shutting down old Greenplum postmaster')
        else:
            self.Log('INFO', 'Shutting down new Greenplum postmaster')

        locked = os.path.join(env['MASTER_DATA_DIRECTORY'],
                              'pg_hba.conf'+LOCKEXT)

        try:
            if utility:  cmd = 'gpstop -fzam'
            else:        cmd = 'gpstop -fza'

            locked = os.path.join(env['MASTER_DATA_DIRECTORY'],
                                  'pg_hba.conf'+LOCKEXT)
            try:
                if os.path.exists(locked):
                    env['PGUSER'] = MIGRATIONUSER

                pid = subprocess.Popen(cmd, preexec_fn=os.setpgrp,
                                       env=env, shell=True,
                                       stdout=self.logfile, 
                                       stderr=self.logfile)
            finally:
                if os.path.exists(locked):
                    del env['PGUSER']

            # Ignore interupt requests until startup is done
            error = None
            retcode = None
            while retcode == None:
                try: 
                    retcode = pid.wait();

                except KeyboardInterrupt, e:
                    if not self.interupted:
                        self.Log('FATAL', '***************************************')
                        self.Log('FATAL', 'SIGINT-: Upgrade Aborted')
                        self.Log('FATAL', '***************************************')
                        self.Log('INFO',  'Performing clean abort')
                        self.interupted = True
                        error = e
                    else:
                        self.Log('INFO',  'SIGINT-: Still processing shutdown')

            if retcode < 0:
                raise UpgradeError("Shutdown terminated by signal");
            today = date.today().strftime('%Y%m%d')
            logname = os.path.join(self.logdir, 'gpstop_%s.log' % today)
            if retcode == 1:
                self.Log('WARN', '***************************************')
                self.Log('WARN', 'Warnings generated starting cluster')
                self.Log('WARN', 'Check %s for detailed warnings' % logname)
                self.Log('WARN', '***************************************')
            if retcode > 1:
                self.Log('FATAL', '***************************************')
                self.Log('FATAL', 'Shutdown failed with error code %d' % retcode)
                self.Log('FATAL', 'Check %s for detailed error' % logname)
                self.Log('FATAL', '***************************************')
                raise UpgradeError('Shutdown failed')

            # If we recieved an interupt, resignal it now that the startup is done
            if error: 
                raise error

        except OSError, e:
            self.Log('FATAL', str(e))
            raise UpgradeError('Shutdown failed')

        self.CheckDown();

    #------------------------------------------------------------
    def Revert(self):
        '''
        Revert to backup
        '''

        self.Shutdown()
        self.CheckDown()
        self.Log('INFO', 'Reverting to Backup')

        statefile = os.path.join(self.backup, 'state')
        if not os.path.exists(statefile):
            self.Log('WARN', "  '%s' not found" % statefile)
            self.Log('INFO', 'Revert aborted')
            sys.exit(0)
        state = self.RunCmd('cat ' + statefile)

        needrevert = False
        for line in state.split('\n'):
            if line == 'BACKUP VALID':
                needrevert = True

        hba   = os.path.join(self.masterdir, 'pg_hba.conf'+LOCKEXT)
        ident = os.path.join(self.masterdir, 'pg_ident.conf'+LOCKEXT)
        if os.path.exists(hba) or os.path.exists(ident):
            needunlock = True
        else:
            needunlock = False

        if (needrevert or needunlock) and len(self.hosts) < 1:

            # grab configuration information from generated init file
            initfile = os.path.join(self.tmpdir, 'gp_init_config')
            if not os.path.exists(initfile):
                self.Log('FATAL', "  '%s' not found" % initfile)
                self.Log('INFO', 'Revert aborted')
                sys.exit(1)

            # Extract from gp_init_config
            declare_re = '^declare\s+-a\s+([^= \t]*)\s*=\s*\(\s*(.*)'
            config = self.RunCmd('cat ' + initfile)
            datadirs = set()
            gathering = False
            for line in config.split('\n'):
                line = line.strip()

                if not gathering:
                    m = declare_re.match(line)
                    if m:
                        field = m.group(1)
                        stuff = m.group(2).strip()
                        if stuff[-1] == ')':
                            value = stuff[:-1]
                        else:
                            value = stuff + ' '
                            gathering = True
                    else:
                        (field, value) = line.split('=')
                elif line[-1] == ')':
                    value = value.split()
                    gathering = False
                else:
                    value += line + ' '

                if field in ['DATA_DIRECTORY', 'MIRROR_DATA_DIRECTORY']:
                    value = value.split()
                    datadirs = datadirs | set(value)
                if field in ['PRIMARY_ARRAY', 'MIRROR_ARRAY']:
                    x_re = '[^:]+:\d+:([^:]+):\d+:\d+'
                    value = value.split()
                    dir = map(lambda x: x_re.match(x).group(1), value)
                    datadirs = datadirs | set(dir)

                self.config[field] = value

            # remove final "/upgrade" from all the paths and convert to a 
            # space delimited string
            datadirs.discard('')
            datadirs = map(lambda(x): os.path.split(x)[0], datadirs)
            self.datadirs = ' '.join(datadirs)

            # read the hosts file
            hostfile = os.path.join(self.tmpdir, 'hosts')
            if not os.path.exists(hostfile):
                self.Log('FATAL', "  '%s' not found" % hostfile)
                self.Log('INFO', 'Revert aborted')
                sys.exit(1)
            hosts = self.RunCmd('cat ' + hostfile)
            self.hosts = hosts.split('\n')

        # Attempt revert
        if needrevert:
            self.Log('INFO', 'Restoring directories')
            self.DeepLink('REVERT')

        if needunlock:
            self.ReleaseLockdown(self.oldenv)

        self.Startup(self.oldenv)
        self.Log('INFO', 'Removing upgrade user')
        self.Update('DROP USER IF EXISTS ' + MIGRATIONUSER)
        self.Shutdown()

        self.Log('INFO', 'Revert Successful')
        # self.RemoveDirectories(True)

    #------------------------------------------------------------
    def CheckVersions(self):
        '''
        Validates that the upgrade/downgrade from old->new is okay
        '''

        self.Log('INFO', 'Checking version compatability')

        # --gp-version added in 3.2, but that doesn't help us determine
        # version information from old versions.
        #
        # Instead we take the hacky aproach of getting the version from
        # pg_config.h
        def getversion(home,env):
            try:
                return self.RunCmd('pg_ctl --gp-version', env=env)
            except CmdError:
                pass
            try:
                cmd = 'grep PG_VERSION_STR %s/include/pg_config.h' % home
                return self.RunCmd(cmd, env=self.oldenv)
            except Exception, e:
                raise UpgradeError('Unable to determine version of %s: %s'
                                   % (home, str(e)))

        oldversion = getversion(self.oldhome, self.oldenv)
        newversion = getversion(self.newhome, self.newenv)

        # If we got a version, but it doesn't match our regex then it's probably
        # not a Greenplum database.
        version_re = re.compile('\(Greenplum Database\)? ([^\)]+) build ([^\)]+)')
        match = version_re.search(oldversion)
        if match: 
            oldversion = match.group(1)
            oldbuild = match.group(2)
            self.Log('INFO', 'Source Version: (Greenplum Database) %s build %s'
                     % (oldversion, oldbuild))
        else:
            raise UpgradeError('Source not a Greenplum Database: ' + oldversion)
        match = version_re.search(newversion)
        if match: 
            newversion = match.group(1)
            newbuild = match.group(2)
            self.Log('INFO', 'Target Version: (Greenplum Database) %s build %s'
                     % (newversion, newbuild))
        else:
            raise UpgradeError('Target not a Greenplum Database: ' + newversion)    

        self.oldversion = oldversion
        self.newversion = newversion

        # Versions supported by this version of the upgrader
        #  [3.1.0.0 - 3.2.0.0] + (main) by default
        def checkversion(v):
            if v == 'main': return
            if v < '3.1.0.0':
                raise UpgradeError(
"Greenplum Version '%s' not supported for upgrade/downgrade" % v)
            if v > '3.2.0.0':
                raise UpgradeError(
'''To upgrade/downgrade from Greenplum Version '%s' use the upgrade/downgrade
tool shipped with that release''')

        checkversion(oldversion)
        checkversion(newversion)
        if newversion == 'main' or newversion > oldversion:
            self.upgrade = True
        else:
            self.upgrade = False    # Downgrade

        # Compare old version catalog number with the catalog in MASTER_DATA_DIRECTORY
        catalog_re = re.compile('Catalog version number: *(.*)')
        oldcat = self.RunCmd('postgres --catalog-version', env=self.oldenv)
        self.Log('INFO', "Source %s" % oldcat)
        newcat = self.RunCmd('postgres --catalog-version', env=self.newenv)
        self.Log('INFO', "Target %s" % newcat)

        control = self.RunCmd('pg_controldata ' + self.masterdir, env=self.oldenv)
        for line in control.split('\n'):
            m = catalog_re.match(line)
            if m:
                self.Log('INFO', "Data   %s " % line)
                if ((not self.revert and line != oldcat) or
                    (self.revert and line != oldcat and line != newcat)):
                    msg = 'Catalog in %s does not match source binary' % self.masterdir
                    raise UpgradeError(msg)
                break

        # For the moment everything goes:
        #   - Additional checks will be made once the old database is up
        self.Log('INFO', 'Versions are compatable')        


    #------------------------------------------------------------
    def RemoveDirectories(self, force=False, silent=False):
        '''
        Removes upgrade/ and backup/ directories on all segments
        '''

        # If force is set then we remove the directories regardless of
        # whether we created them or they were created by another process.
        # If force is not set then we will throw an exception when we are
        # done if there were directories that we failed to remove.
        failures = False
        doerror = False
        if self.cmd == 'MASTER':
            self.Log('INFO', 'Removing temporary directories')
            self.CallSlaves('RMDIR', force)
            datadirs = [self.root]
        else:
            datadirs = self.datadirs

        for d in filter(os.path.exists, datadirs):
            for dir in ['upgrade', 'backup']:
                dir = os.path.join(d, dir)
                if not os.path.exists(dir):
                    continue
                flag = os.path.join(dir, 'flag')
                if (not force) and os.path.exists(flag):
                    try:
                        dpid = self.RunCmd('cat ' + flag)
                        dpid = int(dpid)
                    except Exception, e:
                        if not silent:
                            self.Log('WARN', 'Read error on file:  ' + str(e))
                            doerror = True
                        failures = True
                        continue
                    if dpid != self.pid:
                        if not silent:
                            self.Log('WARN', 'Directory %s owned by pid %s' 
                                     % (dir, dpid))
                            doerror = True
                        failures = True
                        continue
                
                # Regardless of the setting of force or silent, if there is
                # an active process running, we won't remove the directory.
                running = self.RunCmd('find %s -name postmaster.pid -print' % dir)
                if (running):
                    self.Log('INFO', running)
                    self.Log('FATAL', 'Active processes running')
                    failures = True
                    doerror = True
                else:
                    self.RunCmd('rm -rf ' + dir)

        # We hold off throwing the error until the end, because we want to make
        # sure we removed all of our own directories.
        if doerror:
            raise UpgradeError('Failed to remove old upgrade directories')

    #------------------------------------------------------------
    def CreateDirectories(self):
        '''
        Creates the upgrade/ and backup/ directories on all segments
        '''

        if self.cmd == 'MASTER':

            self.Log('INFO', 'Creating temporary directories')
            backup_exist = False
            dirs_exist = False

            # Before calling slaves check to see if self.tmpdir exists
            if os.path.exists(self.tmpdir) or os.path.exists(self.backup):
                dirs_exist = True
                if os.path.exists(self.tmpdir) and not os.path.exists(self.backup):
                    self.Log('WARN', ' %s: File exists' % self.tmpdir)
                if os.path.exists(self.backup):
                    self.Log('WARN', ' %s: File exists' % self.backup)
                    backup_exist = True
    
            try:
                self.CallSlaves('CHKDIR')
            except UpgradeError, e:
                dirs_exist = True

            if dirs_exist:
                if backup_exist:
                    print '  [R] Revert to Backup'
                print '  [D] Delete old files and continue'
                print '  [X] Cancel upgrade'
                value = ''
                while value.upper() not in ['R', 'D', 'X']:
                    try: value = raw_input('> ')
                    except EOFError: raise UpgradeError('Upgrade Cancelled')
                    value = value.upper()
                    if value == 'R' and not backup_exist:
                        value = ''
                    if value not in ['R', 'D', 'X']:
                        print 'Invalid input'
                if value == 'X':
                    raise UpgradeError('Upgrade Cancelled')
                if value == 'R':
                    self.Revert()
                    self.Startup(self.oldenv)
                self.RemoveDirectories(force=True)
                self.CreateDirectories()
                return

            # Have the slaves create their directories
            self.CallSlaves('MKDIR')
            
            # Additionally we need upgrade/ and backup/ under the masterdir
            # if the masterdir is located in a different location or on
            # another host.
            if (not os.path.exists(self.tmpdir)):
                try:
                    os.mkdir(self.tmpdir)
                    self.RunCmd('chmod 700 %s' % self.tmpdir)
                    flag = open('%s/flag' % self.tmpdir, 'w')
                    flag.write('%s\n' % str(self.pid))
                    flag.close()
                    os.mkdir(self.backup)
                    self.RunCmd('chmod 700 %s' % self.backup)
                    flag = open('%s/flag' % self.tmpdir, 'w')
                    flag.write('%s\n' % str(self.pid))
                    flag.close()
                except:
                    raise UpgradeError('Failed to create upgrade directories')
            else:
                # if it does exist then chances are very good that one of
                # the slaves just created it since we checked for it before
                # we called the slaves.  But there is a remote chance that
                # someone else created the directory in the meantime.  
                # -- check the flag to be safe (not foolproof).
                if (not os.path.exists(self.tmpdir + '/flag') or
                    not os.path.exists(self.backup + '/flag') or
                    self.RunCmd('cat %s/flag' % self.tmpdir) != str(self.pid) or
                    self.RunCmd('cat %s/flag' % self.backup) != str(self.pid)):
                    raise UpgradeError('Failed to create upgrade directories')

            # Finally now that we have those directories we'll make a state file
            self.state = open('%s/state' % self.backup, 'w')

        else:
            if self.cmd != 'MKDIR': 
                raise Exception(self.cmd + ' != MKDIR]')

            for d in self.datadirs:
                if d == '': continue

                # Creating directories is an atomic operation, if mkdir 
                # succeeds then it did not exist previously making it ours
                upgradepath = os.path.join(d, 'upgrade')                
                os.mkdir(upgradepath)
                self.RunCmd('chmod 700 %s' % upgradepath)

                # Claim it in the name of our parent process.  We make use of
                # this flag during tear down to confirm that we created it.
                flag = open('%s/upgrade/flag' % d, 'w')
                flag.write('%s\n' % str(self.pid))
                flag.close()

                # Repeat for the backup directory
                backuppath = os.path.join(d, 'backup')
                os.mkdir(backuppath)
                self.RunCmd('chmod 700 %s' % backuppath)
                flag = open('%s/backup/flag' % d, 'w')
                flag.write('%s\n' % str(self.pid))
                flag.close()
                        

    #------------------------------------------------------------
    def GenerateConfigFiles(self):
        '''
        Creates 'hosts' and 'gp_init_config' files
        '''

        # Write host list file
        host_file = '%s/hosts' % self.tmpdir
        o = open(host_file, 'w')
        for host in self.hosts:
            o.write(host + '\n')
        o.close()

        # Write our new gp_init_config file
        gp_init_config = '%s/gp_init_config' % self.tmpdir
        o = open(gp_init_config, 'w')
        o.write('ARRAY_NAME="%s"\n'          % self.config['ARRAY_NAME'])
        o.write('SEG_PREFIX=%s\n'            % self.config['SEG_PREFIX'])
        o.write('TRUSTED_SHELL=%s\n'         % self.config['TRUSTED_SHELL'])
        o.write('CHECK_POINT_SEGMENTS=%s\n'  % self.config['CHECK_POINT_SEGMENTS'])
        o.write('ENCODING=%s\n'              % self.config['ENCODING'])

        o.write('QD_PRIMARY_ARRAY=%s:%d:%s:1:-1\n' %
                (self.config['MASTER_HOSTNAME'],
                 self.config['MASTER_PORT'],
                 self.newmaster))

        o.write('declare -a PRIMARY_ARRAY=(\n')
        for s in self.segments:
            (a,b) = os.path.split(s['datadir'])
            dir = os.path.join(a, 'upgrade', b)
            o.write('%s:%d:%s:%d:%d\n' % 
                    (s['hostname'], s['port'], dir, s['dbid'], s['content']))
        o.write(')\n')

        if len(self.mirrors) > 0:
            o.write('declare -a MIRROR_ARRAY=(\n')
            for s in self.mirrors:
                (a,b) = os.path.split(s['datadir'])
                dir = os.path.join(a, 'upgrade', b)
                o.write('%s:%d:%s:%d:%d\n' % 
                        (s['hostname'], s['port'], dir, s['dbid'], s['content']))
            o.write(')\n')

        o.close()
        self.Log('INFO', 'Configuration files generated')


    #------------------------------------------------------------
    def ExtractInfo(self):
        '''
        Get all the information we need from the old instance
        '''

        # Determine if there are any invalid segments
        invalid = self.Select(
        '''
           SELECT hostname, datadir FROM gp_configuration
           WHERE not valid
        ''')
        if len(invalid) > 0:
            for item in invalid:
                self.Log('FATAL', 'INVALID SEGMENT: %s:/%s' % 
                         (item['hostname'], item['datadir']));
            raise UpgradeError('Cannot upgrade database with invalid segments')
        self.Log('INFO', 'All segments valid')

        # Look for an existing user named MIGRATIONUSER
        upgradeuser = self.Select(
            "SELECT count(*)::numeric FROM pg_user WHERE usename = '%s'" % MIGRATIONUSER)
        if upgradeuser[0] > 0:
            self.Log('WARN', "Database user '%s' already exists" % MIGRATIONUSER)
            self.Update('DROP USER ' + MIGRATIONUSER)
            #raise UpgradeError("Database user 'gpmigrator' already exists")

        # If this is a downgrade, verify that we have no objects that can not
        # be downgraded:
        #    - append only tables
        #    - new style partitions
        if (not self.upgrade and self.newversion < '3.2.0.0' and 
            (self.oldversion >= '3.2.0.0' or self.oldversion == 'main')):
            databases = self.Select(
                '''
                   SELECT datname from pg_database
                   WHERE datname != 'template0'
                ''')
            c = 0            
            for db in databases:
                c = self.Select('SELECT COUNT(*)::numeric FROM pg_partition', db=db)
                if c[0] > 0:
                    raise UpgradeError(
'''
-------------------------------------------------------
Cannot downgrade a database with 3.2 style partitioning     <<<<<
-------------------------------------------------------
''')
                c = self.Select("SELECT COUNT(*)::numeric FROM pg_appendonly", db=db)
                if c[0] > 0:
                    raise UpgradeError(
'''
---------------------------------------------------
Cannot downgrade a database with append only tables     <<<<<
---------------------------------------------------
''')


        # Extract the information needed to construct a gp_init_config file
        gp_config = self.Select(
        '''
           SELECT content::numeric, definedprimary, dbid::numeric, hostname, port::numeric, datadir 
           FROM gp_configuration 
           ORDER BY content
        ''')

        # check multi-home and get the hostname
        h = {}
        for x in gp_config:
            if x['content'] < 0: continue

            if x['hostname'] not in h:
                cmd = 'ssh %s hostname' % x['hostname']
                x['host'] = self.RunCmd(cmd)
                h[x['hostname']] = x['host']
            else:
                x['host'] = h[x['hostname']]
                
        master = filter(lambda(x): x['content'] < 0 and 
                                   x['definedprimary'], gp_config);
        standbymaster = filter(lambda(x): x['content'] < 0 and 
                                      not x['definedprimary'], gp_config);
        segments = filter(lambda(x): x['content'] >= 0 and 
                                     x['definedprimary'], gp_config);
        mirrors = filter(lambda(x): x['content'] >= 0 and 
                                 not x['definedprimary'], gp_config);
        self.segments = segments
        self.mirrors = mirrors
        
        # Internal sanity checking
        if len(master) != 1:
            raise UpgradeError('Too many master segments, aborting')
        if len(segments) == 0:
            raise UpgradeError('No segments found')

        master = master[0]

        # ARRAY_NAME
        arrayname = self.Select('SELECT gpname FROM gp_id')
        self.config['ARRAY_NAME'] = arrayname[0]

        # HOSTS can be used to build a MACHINE_LIST_FILE
        # In 3.2 and later gpinitsystem can gracefully handle multiple
        # hostnames per host, but in 3.1 we have to generate a config
        # file with a single hostname per host - which means that we
        # will lose any NIC information during downgrade.
        if self.upgrade:
            self.hosts = h.keys()
        else:
            self.hosts = list(set(h.values()))

        # Determine PORT_BASE, (min of segments - 1)
        port_base = min(map(lambda(x): x['port'], segments))-1
        self.config['PORT_BASE'] = port_base

        # Determine DATA_DIRECTORY, use any host
        # We also keep track of a SET() of data and mirror dirs without
        # the /upgrade suffix
        dirs = set();
        data_dir = ''
        for seg in segments:
            newdir = seg['datadir'][0:seg['datadir'].rindex('/')]
            dirs.add(newdir)
            if (seg['host'] != segments[0]['host']): 
                continue
            data_dir = data_dir + os.path.join(str(newdir), 'upgrade') + ' '
        self.config['DATA_DIRECTORY'] = data_dir

        # MASTER_HOSTNAME, super easy
        self.config['MASTER_HOSTNAME'] = master['hostname']

        # MASTER_DIRECTORY, also easy - we already set it up
        self.config['MASTER_DIRECTORY'] = self.tmpdir

        # MASTER_PORT, super easy
        self.config['MASTER_PORT'] = master['port']

        # TRUSTED_SHELL, set manually since there's only one supported value
        self.config['TRUSTED_SHELL'] = 'ssh'

        # CHECK_POINT_SEGMENTS 
        self.config['CHECK_POINT_SEGMENTS'] = \
            self.Select('show checkpoint_segments')[0]

        # ENCODING
        self.config['ENCODING'] = \
            self.Select('show client_encoding')[0]

        # Handle mirrors, if present
        mirror_dirs = set();
        if len(self.mirrors) > 0:

            # Determine PORT_BASE, (min of segments - 1)
            port_base = min(map(lambda(x): x['port'], mirrors))-1
            self.config['MIRROR_PORT_BASE'] = port_base

            # MIRROR_DATA_DIRECTORY, use any mirror
            mirror_data_dir = ''
            for seg in mirrors:
                newdir = seg['datadir'][0:seg['datadir'].rindex('/')]

                if newdir in dirs:
                    raise UpgradeError(
'''
Conflict between data directory and mirror data directory.
     (%s)
This issue must be resolved before upgrade can complete.
''' % newdir)
                mirror_dirs.add(newdir)

                if (seg['host'] != mirrors[0]['host']): 
                    continue
                mirror_data_dir = mirror_data_dir + os.path.join(str(newdir), 'upgrade') + ' '
            self.config['MIRROR_DATA_DIRECTORY'] = mirror_data_dir

        # standby masters
        #  - currently not upgraded - reinit them once upgrade is complete

        # We collected a set of data and mirror directories, convert it back
        # to a string.
        self.datadirs = ''
        for d in dirs | mirror_dirs:
            self.datadirs = '%s%s ' % (self.datadirs, d)
        self.datadirs = self.datadirs.strip()

        self.Log('INFO', 'Configuration acquired')


    #------------------------------------------------------------
    def SetupLockdown(self):
        '''
        Change pg_hba.conf to disallow access to everyone except the
        upgrade user.
        
        We assume that the MIGRATIONUSER user has already been created
        '''


        os_type = self.RunCmd('uname -s').lower()

        if self.cmd == 'MASTER':
            self.Log('INFO', 'Locking database')
            self.CheckUp()
            [env, utility] = self.dbup;
            if utility:
                raise UpgradeError("Cannot lock database in utility mode")

            self.Update('CREATE USER %s with superuser' % MIGRATIONUSER)
            self.Shutdown()
            
            datadirs   = [self.root]
            seg_prefix = self.config['SEG_PREFIX'] + '-'

            # To write out a new pg_hba.conf we need to know all the ip 
            # addresses that the master identifies with.
            #
            # If we re-enable segment locking then this will need to be
            # passed to the segments as well.
            if os_type == 'sunos':
                cmd = 'ifconfig -a inet'
            else:
                cmd = 'ifconfig'        
            ifconf = self.RunCmd(cmd)
            ip_re = re.compile('inet (?:addr:)?(\d+\.\d+\.\d+\.\d+)')
            ip = []
            for line in ifconf.split('\n'):
                m = ip_re.search(line)
                if m:
                    ip.append(m.group(1))

            if env == self.oldenv: suffix = ""
            else: suffix = 'upgrade'

            
            # locking down the segments requires having gpstart
            # pass the PGUSER to the segments otherwise the segments
            # don't have the permissions to startup.
            # 
            # Disabling this leaves a "hole" in the lockdown that
            # still allows utility connections to the segments.
            #
            # If this is re-enabled the corresponding call also needs
            # to be uncommented from ReleaseLockdown
            
            # The one case where we still call this is for "lockdown" of
            # the newly inited DB.  Lockdown in this case is just copying
            # the pg_hba.conf, pg_ident.conf, and postgresql.conf from 
            # the old database.
            if suffix:
                self.CallSlaves('LOCKDOWN', self.config['SEG_PREFIX'], suffix)

        else:
            datadirs   = self.datadirs
            seg_prefix = self.option
            suffix     = self.option2

        seg_re = re.compile('^%s\d+$' % seg_prefix)
        for d in datadirs:

            # Find the segments for this directory
            for seg in os.listdir(d):
                if seg_re.match(seg):
                    hba   = os.path.join(d, seg, 'pg_hba.conf')
                    ident = os.path.join(d, seg, 'pg_ident.conf')

                    if suffix:
                        dir = os.path.join(d, suffix, seg)

                        # upgrade database just copies all locking information 
                        # from the pre-upgrade database which should already be
                        # locked
                        self.RunCmd('cp -f %s %s' % (hba, dir))
                        self.RunCmd('cp -f %s %s' % (ident, dir))

                        # Grab the original versions to (if any)
                        if os.path.exists(hba + LOCKEXT):
                            self.RunCmd('cp -f %s %s' % (hba+LOCKEXT, dir))
                        if os.path.exists(ident + LOCKEXT):
                            self.RunCmd('cp -f %s %s' % (ident+LOCKEXT, dir))

                        # and we also copy postgresql.conf
                        postconf = os.path.join(d, seg, 'postgresql.conf')
                        self.RunCmd('cp -f %s %s' % (postconf, dir))

                    else:
                        # pre-upgrade database makes a backup of files and then
                        # writes a new one

                        # Solaris doesn't support ident authentication
                        if os_type != 'sunos':
                            self.RunCmd('mv -f %s %s' % (ident, ident+LOCKEXT))
                            file = open(ident, 'w')
                            file.write('%s %s %s\n' % 
                                       (MIGRATIONUSER, self.user, MIGRATIONUSER))
                            file.close()

                        self.RunCmd('mv -f %s %s' % (hba, hba+LOCKEXT))
                        file = open(hba, 'w')
                        if os_type == 'sunos':
                            file.write('local all %s trust\n' % MIGRATIONUSER)
                        else:
                            file.write('local all %s ident %s\n' 
                                       % (MIGRATIONUSER, MIGRATIONUSER))
                        for addr in ip:
                            file.write('host all %s %s/32 trust\n'
                                       % (MIGRATIONUSER, addr))
                        file.close()


    #------------------------------------------------------------
    def ReleaseLockdown(self, env):
        '''
        Revert pg_hba.conf to pre-lockdown state
        '''

        # Two main cases:
        #   1) Release lockdown on old environment
        #   2) Release lockdown on newly installed environment
        # Both cases have the database installed under MASTER_DATA_DIRECTORY
        # so we actually treat them exactly the same

        if self.cmd == 'MASTER':
            self.Log('INFO', 'Unlocking database')
            self.CheckDown()

            # See comment about disabling lockdown on segments in SetupLockdown()
            # self.CallSlaves('UNLOCK', self.config['SEG_PREFIX'])

            seg_prefix = self.config['SEG_PREFIX'] + '-'
            datadirs   = [self.root]
        else:
            seg_prefix = self.option
            datadirs   = self.datadirs

        seg_re = re.compile('^%s\d+$' % seg_prefix)
        for d in datadirs:

            # Find the segments for this directory
            for seg in os.listdir(d):
                if seg_re.match(seg):
                    hba   = os.path.join(d, seg, 'pg_hba.conf')
                    ident = os.path.join(d, seg, 'pg_ident.conf')
                    if os.path.exists(hba + LOCKEXT):
                        self.RunCmd('mv -f %s %s' % (hba+LOCKEXT, hba))
                    if os.path.exists(ident + LOCKEXT):
                        self.RunCmd('mv -f %s %s' % (ident+LOCKEXT, ident))


        # We would love to actually delete the user, but it's not actually
        # safe to do so here because we unlock the source database before we
        # are done with the upgrade.
        return
 

    #------------------------------------------------------------
    def BuildMappings(self):
        '''
        Constructs the mappings of user objects to data files.
        It is called twice over the course of the upgrade, the first time it
        extracts mappings from the olddb, the second time it extracts mappings
        from the new db and joins the two mappings together.
        '''
        if self.cmd == 'MASTER':
            prefix = self.config['SEG_PREFIX'] + '-'
            datadirs = [self.root]
            [env, utility] = self.dbup
            if (env == self.oldenv):
                self.Log('INFO', 'Building original oid Mappings')
                type = 'source'
            else:
                self.Log('INFO', 'Building upgraded oid Mappings')
                type = 'target'

            self.CallSlaves('MAPPINGS', self.config['SEG_PREFIX'], type)

        else:
            prefix = self.option
            type   = self.option2
            datadirs = self.datadirs

        errors = 0
        port_re = re.compile('^\s*port=(\d+)')
        for d in datadirs:
            for seg in os.listdir(d):
                if re.compile('^%s\d+$' % prefix).match(seg):
                    
                    # The directory for this segment
                    if type == 'source':
                        dir = os.path.join(d, seg)
                    else:
                        dir = os.path.join(d, 'upgrade', seg)

                    # We keep both mapping files in the upgrade directory
                    logdir = os.path.join(d, 'upgrade')
                
                    # Open the mapping file
                    mapfilename = os.path.join(logdir, '%s_%s_mapping' % (seg, type))
                    mapfile = open(mapfilename, 'w')

                    # Find the port for this segment:
                    port_str = self.RunCmd('grep port= %s/postgresql.conf' % dir)
                    match = port_re.search(port_str)
                    if match:
                        port = int(match.group(1))
                    else:
                        raise UpgradeError(
                            'Could not determine port from %s/postgresql.conf' % dir)

                    # Get a list of databases
                    databases = self.Select(
                    '''
                       SELECT
                          datname        as dbname,
                          oid            as oid,
                          datlastsysoid  as max_sysoid
                       FROM pg_database 
                       WHERE datname != 'template0'
                       ORDER BY dbname
                    ''', port=port)

                    # Check that there are no prepared transactions
                    #   - This doesn't really belong in BuildMappings, but in a different
                    #     check upgrade location.  However this the first handy location we have
                    #     where we are executing on all the segments and it is still relatively
                    #     early in the process.
                    #   - It will be run on the new database as well, which is neither helpful
                    #     nor harmful.
                    #   - Assuming we have sucessfully locked out all other users this should 
                    #     never be true because startup will have rollbacked the transaction.
                    for db in databases:
                        xact = self.Select("SELECT count(*)::numeric FROM pg_prepared_xacts",
                                           db=db['dbname'], port=port);
                        if xact[0] > 0:
                            raise UpgradeError("Database contains prepared transactions");

                    # Build up the list of mapping objects
                    for db in databases:
                        oids = self.Select(
                        '''
                           SELECT
                              case when parent.oid is not null
                                   then n.nspname || '.' || pn.nspname || '.' || parent.relname || '_' || c.relkind
                                   else n.nspname || '.' || c.relname || '_' || c.relkind
                              end as name,
                              c.relfilenode as filenode,
                              c2.relfilenode as toast,
                              c3.relfilenode as toast_index
                           FROM 
                              pg_namespace n,
                              (SELECT oid, *, substring(relname from '^(?:pg_bm_|pg_aoseg_)([0-9]+)') as parentoid
                               from pg_class) c 
                              left outer join pg_class c2 on c.reltoastrelid=c2.oid
                              left outer join pg_class c3 on c2.reltoastidxid=c3.oid
                              left outer join pg_class parent on parent.oid = c.parentoid
                              left outer join pg_namespace pn on parent.relnamespace = pn.oid
                           WHERE c.oid >= %s
                             AND c.relkind in ('a', 'r', 't', 'i', 'S')
                             AND c.relnamespace = n.oid 
                             AND n.nspname !~ 'pg_(toast|temp.*)'
                           ORDER BY name;
                        ''' % db['max_sysoid'], 
                        db=db['dbname'],
                        port=port)
                        
                        for o in oids:

                            # Check that the relfilenode actually exists! 
                            #   There is a bug that can cause diskfiles to go missing from
                            #   bitmap indices.  We want to generate a comprehensable error
                            #   message for these.
                            file = os.path.join(dir, 'base', str(db['oid']), str(o['filenode']))
                            if not os.path.exists(file):
                                # name is either "schema"."parentschema"."parent_name"_"kind"
                                #      or        "schema"."name"."kind"
                                # where the first form is used for objects that embed oids
                                # in their names (append only segments, bitmap indexes)

                                kind = o['name'][-1:]
                                name = o['name'][:-2]

                                if name[:14] == 'pg_bitmapindex':
                                    msg = "Bitmap index '%s'" % name[15:]
                                elif name[:8] == 'pg_aoseg':
                                    msg = "Append only segment for '%s'" % name[9:]
                                elif kind == 'a' or kind == 'r':
                                    msg = "Table '%s'" % name
                                elif kind == 'i':
                                    msg = "Index '%s'" % name
                                elif kind == 'S':
                                    msg = "Sequence '%s'" % name
                                else:
                                    msg = "Object '%s'" % name
                                msg += " missing relfile on segment '%s'\n" % seg
                                self.Log('FATAL', msg)
                                self.Log('FATAL', 'missing relfile: ' + file)
                                errors += 1

                            # Prefix each name with the database it's in
                            mapfile.write('%s.%s,%s,%s,%s,%s\n' %
                                          (db['dbname'], o['name'],
                                           db['oid'], 
                                           o['filenode'], 
                                           o['toast'], 
                                           o['toast_index']))


                    mapfile.close()
        
        if errors > 0:
            raise UpgradeError('You must drop or reindex malformed objects prior to upgrade')

    #------------------------------------------------------------
    def DumpStatistics(self):
        '''
        Executes queries and creates files in the upgrade directory 'pg_stat_*.csv'
        '''

        self.Log('INFO', 'Exporting Statistics')

        databases = self.Select('''
        SELECT datname from pg_database
        WHERE datname != 'template0' 
        ORDER BY datname''')

        # Since COPY doesn't have an append option we write out N files
        count = 1
        for db in databases:
            self.Update('''
            COPY (
              SELECT current_database(),        n.nspname,      c.relname,     
                 t.typname,      c.relpages,    c.reltuples, 
                 s.staattnum,    s.stanullfrac, s.stawidth,     s.stadistinct,
                 s.stakind1,     s.stakind2,    s.stakind3,     s.stakind4,
                 s.staop1::regoperator,         s.staop2::regoperator,
                 s.staop3::regoperator,         s.staop4::regoperator,		 
                 s.stanumbers1,  s.stanumbers2, s.stanumbers3,  s.stanumbers4,
                 s.stavalues1,   s.stavalues2,  s.stavalues3,   s.stavalues4
              FROM   pg_class c, pg_statistic s, pg_namespace n, pg_attribute a, pg_type t
              WHERE  c.relnamespace = n.oid
                and  n.nspname !~ '(pg_.*|information_schema)'
                and  c.oid = s.starelid
                and  a.attrelid = c.oid
                and  a.attnum = s.staattnum
                and  a.atttypid = t.oid
              ORDER BY c.relname, s.staattnum
              ) to '%s/pg_stat_%d.csv' with CSV ESCAPE E'\\\\' ''' % \
                            (self.tmpdir, count), db=db)
            count += 1

    #------------------------------------------------------------
    def CollectValidation(self):
        '''
        Executes queries to construct a view of how the data should
        look.  We validate that it still looks the same once the upgrade
        is complete.
        '''
        if not self.validate:
            return

        self.Log('INFO', 'Collecting validation information')
        self.CheckUp()
        [env, utility] = self.dbup

        # The upgrader already guarantees that there is a 1:1 mapping of
        # database objects that have disk files, but for object types 
        # that have no disk files (views, functions, etc) we have to 
        # add additional checks.
        sourcename = os.path.join(self.tmpdir, 'source_verify')
        targetname = os.path.join(self.tmpdir, 'target_verify')
        if env == self.oldenv:
            filename = sourcename
        else:
            filename = targetname
        file = open(filename, 'w')

        databases = self.Select(
            '''
               SELECT datname FROM pg_database
               WHERE datname != 'template0'
               ORDER by datname
            ''')

        # Check 1: generate a list of types and views.  
        file.write('-- Types and Views\n')
        for db in databases:
            qry = self.Select(
                '''
                   SELECT '"' || n.nspname || '"."' || c.relname || '"' as name, 
                          pg_get_userbyid(c.relowner) as owner,
                          array_out(c.relacl) as acl,
                          c.relkind as kind
                   FROM pg_class c JOIN pg_namespace n on (c.relnamespace = n.oid)
                   WHERE c.relkind in ('v', 'c')
                     AND n.nspname not in ('information_schema', 'pg_catalog')
                   ORDER BY n.nspname, c.relname
                ''', db=db)
        for row in qry:
            file.write('%s.%s,%s,%s,%s\n' %
                       (db, row['name'], row['owner'], row['acl'], row['kind']))
        file.write('\n')

        # Check 2: Validation for sequences
        file.write('-- Sequences\n')
        for db in databases:
            objs = self.Select(
                '''
                   SELECT '"' || n.nspname || '"."' || c.relname || '"' as name
                   FROM pg_class c JOIN pg_namespace n on (c.relnamespace = n.oid)
                   WHERE c.relkind in ('S')
                   ORDER BY name
                ''', db=db)

            for name in objs:
                qry = self.Select(
                    '''SELECT
                          last_value::numeric, increment_by::numeric, max_value::numeric, 
                          min_value::numeric, is_cycled, is_called
                       FROM %s
                    ''' % name, db=db)
                for row in qry:
                    file.write('%s.%s,%s,%s,%s,%s,%s,%s\n' %
                               (db, name,
                                row['last_value'],
                                row['increment_by'],
                                row['max_value'],
                                row['min_value'],
                                row['is_cycled'],
                                row['is_called']))
        file.write('\n')

        # Check 3: Validation for tables
        file.write('-- Tables\n')
        for db in databases:
            objs = self.Select(
                '''
                   SELECT '"' || n.nspname || '"."' || c.relname || '"' as name
                   FROM pg_class c JOIN pg_namespace n on (c.relnamespace = n.oid)
                   WHERE c.relkind in ('a', 'r')
                     AND n.nspname !~ '(information_schema|pg_.*)'
                   ORDER BY name
                ''', db=db)
            for name in objs:
                qry = self.Select("SELECT count(*)::numeric from " + name, db=db)
                for row in qry:
                    file.write('%s.%s,%s\n' % (db, name, row))
        
        # Compare validation information
        file.close()
        if env != self.oldenv:
            self.Log('INFO', 'Confirming Validation')
            cmd = 'diff %s %s' % (sourcename, targetname)
            try:
                self.RunCmd(cmd)
            except CmdError, e:
                self.Log('FATAL', 'Validation failed:')
                self.Log('FATAL', '  ' + cmd)
                raise UpgradeError('Data Validation Failed')
            self.Log('INFO', 'Data Validation Confirmed')


    #------------------------------------------------------------
    def CheckCatalog(self, env):
        '''
        Validate that the created catalog looks good
        '''
        if not self.checkcat:
            return

        self.Log('INFO', 'Checking Catalog')
        self.CheckUp()
        databases = self.Select(
            '''
               SELECT datname FROM pg_database
               WHERE datname != 'template0'
               ORDER by datname
            ''')

        try:
            locked = os.path.join(env['MASTER_DATA_DIRECTORY'],
                                  'pg_hba.conf'+LOCKEXT)
            if os.path.exists(locked):
                user = MIGRATIONUSER
            else:
                user = env['USER']

            exec_cmd = libdir + '/gpcheckcat -p %d -U %s ' % \
                (self.config['MASTER_PORT'], user)

            for db in databases:
                self.RunCmd(exec_cmd + db, env=env)

        except CmdError, e:
            self.Log('FATAL', '***************************************')
            self.Log('FATAL', e.stdout);
            self.Log('FATAL', '***************************************')
            raise UpgradeError('Catalog Check Failed');

    #------------------------------------------------------------
    def DumpSchema(self):
        '''
        Runs pgdump_all to dump the schema.
        Run on the master in utility mode.
        '''
        self.Log('INFO', 'Exporting schema')

        locked = os.path.join(self.oldenv['MASTER_DATA_DIRECTORY'], 
                              'pg_hba.conf'+LOCKEXT)
        if os.path.exists(locked):
            user = MIGRATIONUSER
        else:
            user = self.oldenv['USER']

        # We use the environment of the most recent instance so that
        # we always use the most recent version of pg_dumpall.
        if self.upgrade:
            env = self.newenv
        else:
            env = self.oldenv

        cmd  = 'pg_dumpall'
        cmd += ' -U %s' % user
        cmd += ' -p %d' % self.masterport
        cmd += ' -r -s --gp-syntax > %s/pgdump.sql' % self.tmpdir
        self.Log('DEBUG', 'CMD: ' + cmd)
        r = subprocess.call(cmd, env=env, shell=True)

        if r:
            raise UpgradeError('pg_dumpall exited with status %d' % r)


    #------------------------------------------------------------
    def InitNewDB(self):
        '''
        Create and configure the upgrade instance
        '''
        self.Log('INFO', 'Initializing upgraded cluster')
        self.CheckDown()
        try:
            self.dbup = [self.newenv, False]
            cmd = 'gpinitsystem -a -I %s/gp_init_config' % self.tmpdir
            pid = subprocess.Popen(cmd, preexec_fn=os.setpgrp,
                                   env=self.newenv, shell=True,
                                   stdout=self.logfile, 
                                   stderr=self.logfile)

            # Ignore interupt requests until startup is done
            error = None
            retcode = None
            while retcode == None:
                try: 
                    retcode = pid.wait();

                except KeyboardInterrupt, e:
                    if not self.interupted:
                        self.Log('FATAL', '***************************************')
                        self.Log('FATAL', 'SIGINT-: Upgrade Aborted')
                        self.Log('FATAL', '***************************************')
                        self.Log('INFO',  'Performing clean abort')
                        self.interupted = True
                        error = e
                    else:
                        self.Log('INFO',  'SIGINT-: Still processing shutdown')

            # If we recieved an interupt, resignal it now that the startup is done
            if error: 
                raise error

            if retcode < 0:
                raise UpgradeError("gpinitsystem terminated by signal");
            today = date.today().strftime('%Y%m%d')
            logname = os.path.join(self.logdir, 'gpinitsystem_%s.log' % today)
            if retcode == 1:
                self.Log('WARN', '***************************************')
                self.Log('WARN', 'Warnings generated initializing upgraded cluster')
                self.Log('WARN', 'Check %s for detailed warnings' % logname)
                self.Log('WARN', '***************************************')
            if retcode > 1:
                self.Log('FATAL', '***************************************')
                self.Log('FATAL', 'gpinitsystem failed with error code %d' % retcode)
                self.Log('FATAL', 'Check %s for detailed error' % logname)
                self.Log('FATAL', '***************************************')
                raise UpgradeError('gpinitsystem failed')
        except OSError, e:
            self.Log('FATAL', str(e))
            raise UpgradeError('gpinitsystem failed')

    #------------------------------------------------------------
    def ResetXLogs(self):
        '''
        Resets the xlog prior to recreating the schema
        '''
        if self.cmd == 'MASTER':
            self.Log('INFO', 'Syncing XLogs')
            seg_prefix = self.config['SEG_PREFIX'] + '-'
            datadirs = [self.root]
            self.CallSlaves('RESETXLOG', self.config['SEG_PREFIX'])
        else:
            seg_prefix = self.option
            datadirs   = self.datadirs

        # We should always have at least one data directory...
        if len(self.datadirs) < 1:
            return

        # Check the mapping in all data directories
        for d in datadirs:
            # Find the segments for this directory, we base this on 
            # directories under the upgrade directory that match
            # the naming convention of the segments.
            for file in os.listdir('%s/upgrade' % d):
                if re.compile('^%s\d+$' % seg_prefix).match(file):
                    olddir  = os.path.join(d, file)
                    newdir  = os.path.join(d, 'upgrade', file)

                    # Links are in place, but data will not be visible until 
                    # we sync the pg_control info
                    oldsync = self.RunCmd('pg_resetxlog -n ' + olddir, 
                                          env=self.oldenv)
                    newsync = self.RunCmd('pg_resetxlog -n ' + newdir, 
                                          env=self.newenv)

                    self.Log('DEBUG', '*****************************')
                    self.Log('DEBUG', ' - old xlog -')
                    self.Log('DEBUG', oldsync)
                    self.Log('DEBUG', '*****************************')
                    self.Log('DEBUG', ' - new xlog -')
                    self.Log('DEBUG', newsync)
                    self.Log('DEBUG', '*****************************')
                    

                    # Nasty bit of code to turn the control data into a
                    # nice dict object
                    sync = {}
                    for line in oldsync.split('\n'):
                        if len(line) == 0: continue
                        (field, value) = line.split(':')
                        sync[field] = value.lstrip()

                    # Set the next transaction id in new control
                    x = sync["Latest checkpoint's NextXID"].find('/')
                    if x < 0:
                        nextxid = sync["Latest checkpoint's NextXID"]
                    else:
                        nextxid = sync["Latest checkpoint's NextXID"][x+1:]

                    self.RunCmd('pg_resetxlog -f -x %s %s' % (nextxid, newdir), 
                                env=self.newenv)

                    # Set the WAL archives
                    self.RunCmd('pg_resetxlog -l %s,%s,%s %s' % 
                                (sync["Latest checkpoint's TimeLineID"],
                                 sync["Current log file ID"],
                                 sync["Next log file segment"],
                                 newdir), env=self.newenv)

                    # Set next oid
                    self.RunCmd('pg_resetxlog -o %s %s' % 
                                (sync["Latest checkpoint's NextOID"],
                                 newdir), env=self.newenv)

                    # Set next multitransaction ID/offset
                    self.RunCmd('pg_resetxlog -m %s %s' %
                                (sync["Latest checkpoint's NextMultiXactId"],
                                 newdir), env=self.newenv)
                    self.RunCmd('pg_resetxlog -O %s %s' %
                                (sync["Latest checkpoint's NextMultiOffset"],
                                 newdir), env=self.newenv)

                    # Replace the transaction logs with the old ones
                    # since the old logs actually correspond to the data
                    for f in ['pg_clog', 
                              'pg_distributedlog', 
                              'pg_subtrans',
                              'pg_multixact']:
                        oldlogs = os.path.join(olddir, f)
                        newlogs = os.path.join(newdir, f)

                        # the only one that wouldn't exist is pg_distributedlog
                        # and only if we were upgrading/downgrading to/from a 
                        # version < 3.1.1.5
                        if (os.path.exists(newlogs)):
                            self.RunCmd('rm -rf %s' % newlogs)
                            if (os.path.exists(oldlogs)):
                                self.RunCmd('cp -rf %s %s' % (oldlogs, newlogs))

    #------------------------------------------------------------
    def ImportSchema(self):
        self.CheckUp()
        self.Log('INFO', 'Importing schema')

        error   = False
        warning = False


        locked = os.path.join(self.newenv['MASTER_DATA_DIRECTORY'],
                              'pg_hba.conf'+LOCKEXT)
        if os.path.exists(locked):
            user = MIGRATIONUSER
        else:
            user = self.newenv['USER']

        pipe = subprocess.Popen('psql -q -U %s -f %s/pgdump.sql template1' % 
                                (user, self.tmpdir),
                                env=self.newenv, shell=True,
                                stdout=subprocess.PIPE, 
                                stderr=subprocess.PIPE)

        msg_re  = re.compile('psql:%s/pgdump.sql:(\d+): *([^:]*): *(.*)' % self.tmpdir)
        user_re = re.compile('role ".*" already exists')
        schema_re = re.compile('schema ".*" does not exist')
        for line in pipe.stderr:
            match = msg_re.match(line)
            if match:
                line = '%s:  %s, at line %s' % (
                    match.group(2), match.group(3), match.group(1))

                # Check for expected safe errors
                if (user_re.match(match.group(3)) or
                    schema_re.match(match.group(3))):
                    continue

                # Handle unexpected errors
                if (match.group(2) == 'WARNING' or 
                    match.group(2) == 'DETAIL'  or
                    match.group(2) == 'NOTICE'):
                    warning = True
                    level = 'WARN'
                else:
                    error = True
                    level = 'FATAL'

            else:
                # should never happen
                error = True
                level = 'FATAL'

            # If we've disabled schema checking then all schema errors 
            # are converted to warnings
            if not self.checkschema:
                level = 'WARN'
                error = False

            self.Log(level, line)

        if error:
            self.Log('FATAL', "Errors encountered loading '%s/pgdump.sql'" % self.tmpdir);
            raise UpgradeError('Upgrade aborted due to Schema Import Failures')

        if warning:
            self.Log('WARN', '***************************************')
            self.Log('WARN', "Warnings encountered loading '%s/pgdump.sql'" % self.tmpdir);
            self.Log('WARN', '***************************************')

        databases = self.Select(
            '''
            SELECT datname FROM pg_database 
            WHERE datname != 'template0'
            ''')
        for db in databases:
            r = subprocess.call('psql -U %s -c "vacuum freeze" %s' % (user, db),
                                env=self.newenv, shell=True,
                                stdout=self.logfile, stderr=self.logfile)
            if r:
                raise UpgradeError('Vacuum exited with status %d' % r)

    #------------------------------------------------------------
    def RestoreStatistics(self):
        '''
        Executes queries to rebuild the database statistics stored in 'pg_stat_*.csv'
        '''

        
        # Datatypes of the columns in pg_statistics, the last 4 columns,
        # not included here, are anyarray and will be cast based on the
        # datatype of the statisics column.
        types = [ 'smallint',    'real',        'integer',     'real',
                  'smallint',    'smallint',    'smallint',    'smallint',
                  'regoperator', 'regoperator', 'regoperator', 'regoperator',
                  'real[]',      'real[]',      'real[]',      'real[]' ]

        def escape(str):
            str = str.replace("\\", "\\\\")   # escape the escapes
            str = str.replace("'",  "\\'")    # escape single quotes
            return str

        def cast(str, typ):
            if len(str) == 0:
                return "NULL::%s" % typ
            else:
                return "E'%s'::%s" % (escape(str), typ)

        lastdb   = None
        lastname = None
        for file in os.listdir(self.tmpdir):
            if file[0:8] == 'pg_stat_':
                file = os.path.join(self.tmpdir, file)
                reader = csv.reader(open(file), delimiter=',', escapechar='\\')

                for row in reader:
                    if len(row) < 1:
                        continue

                    db       = row[0]
                    schema   = row[1]
                    table    = row[2]
                    kind     = row[3]
                    relpages = row[4]
                    reltups  = row[5]
                    name     = '"%s"."%s"' % (escape(schema), escape(table))

                    # If the base datatype is an array then the array form is
                    # the same datatype, otherwise we need to use the array form
                    # (ie, add a leading underscore)
                    if kind[0] == "_":
                        kind = kind[1:] + "[]"
                    else:
                        kind = kind + "[]"


                    if db != lastdb:
                        lastdb = db
                        lastname = None

                    if name != lastname:
                        lastname = name
                        sql  = "UPDATE pg_class\n"
                        sql += "SET relpages = '%s'::int,\n" % relpages
                        sql += "    reltuples = '%s'::real\n" % reltups
                        sql += "WHERE oid = E'%s'::regclass;" % name
                        try:
                            self.Update(sql, db=db)
                        except Exception, e:
                            self.Log('WARN', str(e))

                    sql  = "INSERT INTO pg_statistic VALUES (\n"
                    sql += "  E'%s'::regclass, \n" % name
                    for i in range(16):
                        sql += "  %s, \n" % cast(row[i+6], types[i])
                    for i in range(3):
                        sql += "  %s, \n" % cast(row[i+22], kind)
                    sql += "  %s);" % cast(row[25], kind)
                    try:
                        self.Update(sql, db=db)
                    except Exception, e:
                        self.Log('WARN', str(e))

    #------------------------------------------------------------
    def RemapOID(self):
        '''
        Remaps OIDs for the NEW database
        '''

        if self.cmd == 'MASTER':

            self.Log('INFO', 'Remapping OIDs')

            datadirs    = [self.root]
            mapfilename = '%s/mapping' % self.backup
            seg_prefix  = self.config['SEG_PREFIX'] + '-'

            # they believe the mapping is valid.
            self.CallSlaves('REMAPOID', self.config['SEG_PREFIX'])


        else:
            if self.cmd != 'REMAPOID': 
                raise Exception(self.cmd + ' != REMAPOID]')

            datadirs       = self.datadirs
            seg_prefix     = self.option


            # We should always have at least on data directory...
            if len(self.datadirs) < 1:
                return

        # Both master and slave processes need to do mappings.
        #   + On master this is just MASTER_DATA_DIR
        #   + On slaves its the DATA_DIRECTORY and MIRROR_DATA_DIRECTORY

        # Check the mapping in all data directories
        for d in datadirs:
            # Find the segments for this directory, we base this on 
            # directories under the upgrade directory that match
            # the naming convention of the segments.
            for file in os.listdir('%s/upgrade' % d):
                if re.compile('^%s\d+$' % seg_prefix).match(file):
                    olddir  = os.path.join(d, file)
                    newdir  = os.path.join(d, 'upgrade', file)
                    
                    # Read the mapping files to produce oid->oid pairs
                    oldmapfile = open(newdir+'_source_mapping', 'r')
                    newmapfile = open(newdir+'_target_mapping', 'r')
                    for oldline in oldmapfile:
                        newline = newmapfile.next()

                        # trim off the newlines
                        oldline = oldline[0:-1]
                        newline = newline[0:-1]

                        (oldname, olddb, oldoid, oldtoast, oldtidx) = \
                            oldline.split(',')
                        (newname, newdb, newoid, newtoast, newtidx) = \
                            newline.split(',')                        

                        if oldname != newname:
                            raise UpgradeError("Mapping failure on %s" % oldname)

                        def makemapping(name,olddb,oldoid,newdb,newoid,msg):
                            if oldoid == 'None' and newoid == 'None':
                                return
                            if oldoid == 'None' or newoid == 'None':
                                raise UpgradeError("Mapping failure on %s %s" % (name, msg))
                            mapping[os.path.join(olddb,oldoid)] = os.path.join(newdb, newoid)

                        mapping = {}
                        makemapping(oldname, olddb, oldoid, newdb, newoid, '')
                        makemapping(oldname, olddb, oldtoast, newdb, newtoast, 'toast')
                        makemapping(oldname, olddb, oldtidx, newdb, newtidx, 'toast index')

                        for oldoid in mapping:
                            newoid = mapping[oldoid]
                            oldfile = os.path.join(olddir, 'base', oldoid)
                            newfile = os.path.join(newdir, 'base', newoid)

                            # Both old and new file should exist
                            if not os.path.exists(oldfile):
                                raise UpgradeError(oldfile + ' not found')
                            if not os.path.exists(newfile):
                                raise UpgradeError(newfile + ' not found')

                            # Remove the new file, hard link to the old file
                            #self.Log('DEBUG', 'Linking %s => %s' % (oldfile, newfile))

                            os.remove(newfile)
                            os.link(oldfile, newfile)

                            # Large tables will have additional extensions, these
                            # are named 'relfilenode.extension#'.
                            ext = 1
                            while (os.path.exists(oldfile + '.' + str(ext))):
                                os.link('%s.%s' % (oldfile, str(ext)),
                                        '%s.%s' % (newfile, str(ext)))
                                ext = ext + 1



    #------------------------------------------------------------
    def DeepLink(self, style):
        '''
        Makes a deep hard link copy of one directory into another
        '''

        if style == 'CLEANUP':   # Is this really a DeepLink?
            return

        if style not in ['BACKUP', 'INSTALL', 'REVERT']:
            raise UpgradeError('FATAL', ' DeepLink(%s)!?' % style)            
        
        if self.cmd == 'MASTER':
            prefix   = self.config['SEG_PREFIX'] + '-'
            datadirs = [self.root]
            if style == 'BACKUP':
                self.Log('INFO', 'Linking backup')
            elif style == 'INSTALL':
                self.Log('INFO', 'Linking upgrade')

            # Have all hosts perform the link first
            self.CallSlaves('DEEPLINK', style, self.config['SEG_PREFIX'])

        else:
            prefix   = self.option2
            datadirs = self.datadirs

        # Look in each data directory, identify the segment directories,
        # walk each segment directory.
        segdir_re = re.compile(prefix+'\d+(.log)?$')
        for dir in datadirs:

            # For Backup datadirs is the source, for INSTALL it's the target
            if style == 'BACKUP':
                destination = os.path.join(dir,'backup')
            if style == 'INSTALL':
                destination = dir
                dir = os.path.join(dir,'upgrade')
            if style == 'REVERT':
                destination = dir
                dir = os.path.join(dir,'backup')
                if not os.path.exists(dir):
                    continue

            for content in os.listdir(dir):
                if segdir_re.match(content):
                    content = os.path.join(dir, content)
                    if os.path.isfile(content):
                        oldfile = content
                        newfile = content.replace(dir, destination,1)
                        if os.path.exists(newfile):
                            if style == 'BACKUP':
                                self.Log('WARN', 'File exists ' + newfile)
                            os.remove(newfile)
                        #self.Log('DEBUG', 'Linking file ' + newfile)
                        os.link(oldfile, newfile)

                    for root, dirs, files in os.walk(content, topdown = True):
                        newroot = root.replace(dir,destination,1)
                        if not os.path.exists(newroot):
                            os.mkdir(newroot)
                            self.RunCmd('chmod 700 ' + newroot)
                        elif style in ['INSTALL', 'REVERT']:
                            self.RunCmd('rm -rf ' + newroot)
                            os.mkdir(newroot)
                            self.RunCmd('chmod 700 ' + newroot)
                        for name in files:
                            oldfile = os.path.join(root, name)
                            newfile = os.path.join(newroot, name)
                            if os.path.exists(newfile):
                                self.Log('WARN', 'File exists ' + newfile)
                                os.remove(newfile)
                            #self.Log('DEBUG', 'Linking file ' + newfile)
                            os.link(oldfile, newfile)

    #------------------------------------------------------------
    def FixConfig(self):
        '''
        After moving the upgraded db from DATA_DIR/upgrade to just DATA_DIR
        we need to go and fix the gp_configuration table to point to the
        correct location.
        '''

        # We can do this in utility mode since the master host is the only
        # host that contains gp_configuration information
        self.Log('INFO', 'Adjusting gp_configuration')
        self.Startup(self.newenv, utility=True)
        self.Update(
         '''
            UPDATE gp_configuration 
              SET datadir=regexp_replace(datadir, 'upgrade/([^/]*)$', E'\\\\1')
         ''')
        self.Shutdown()
        self.newenv['MASTER_DATA_DIRECTORY'] = \
            self.oldenv['MASTER_DATA_DIRECTORY']

#============================================================

# Create a new GPUpgrade - should never throw exception
u = GPUpgrade()

# GPUpgrade calls itself on individual hosts, we switch behavior based
# on the way that it gets called.  These options are not listed in
# the usage information because they are strictly an internal interface.
try:
    # parses and validates input
    u.Setup()

    # MASTER - the main case, run on master only
    if u.cmd == 'MASTER':

        u.Log('INFO', 'Python version %d.%d.%d %s %d' % sys.version_info)

        # Make sure that the database isn't running
        try:
            u.CheckDown()
        except Exception, e:
            u.Log('FATAL', str(e))
            sys.exit(1)

        # Check that we can do the upgrade between the versions
        u.CheckVersions()

        # User requested a revert to previous version
        if u.revert:
            u.Revert()
            sys.exit(0)

        # Startup the old database
        u.Startup(u.oldenv)

        # Get configuration and catalog information
        # + Requires running old db on master host
        u.ExtractInfo()

        # SetupLockdown:
        # + Requires the database to be up
        # + Creates the upgrade user
        # + Shuts the database down
        # + Adjusts hba_conf to only allow upgrade user access
        # + Database is left down
        u.SetupLockdown()

        # Create working directories on all hosts
        # + Requires configuration info collected in ExtractInfo
        # + Requires Execution on all hosts
        u.CreateDirectories()
        u.SetState('BOOTSTRAP: ' + u.RunCmd('date +%Y%m%d:%H:%M:%S'))

        # Write configuration files for new db
        # + Requires configuration info collected in ExtractInfo
        # + Requires working directory on master node
        u.GenerateConfigFiles()

        # Start the database back up on all hosts so that we can 
        # gather information from them.
        u.Startup(u.oldenv)

        # Check the catalog
        # + Requires running db on all hosts
        # + Requires configuration info collected in ExtractInfo
        # + Requires Lockdown
        u.CheckCatalog(u.oldenv)

        # Build up Source database OID/relfile mappings
        # + Requires running old db on all hosts
        # + Requires created directories so we can store the mapping file
        # + Requires execution on all hosts
        # + Requires Lockdown
        u.BuildMappings()
        u.DumpStatistics()

        # Collect validation info so that we can verify that at the end
        # of the upgrade the data still has the right visibility
        # + Requires running old db on all hosts
        # + Requires created directories so we can store the validation file
        # + Requires execution on all hosts
        # + Requires Lockdown
        u.CollectValidation()

        # Call pg_dumpall and put results in a file
        # + Requires running old db
        # + Requires working directory on master node
        # + Requires Lockdown
        u.DumpSchema()

        # All information collected, shutdown old database
        u.Shutdown()
            
        # Initalize the new database
        # + Requires working directories on all nodes
        # + Requires generated configuration file
        u.InitNewDB()

        # Lockdown the newDB
        # + Requires the database to be up
        # + Shuts the database down
        u.SetupLockdown()

        # Import schema and build the mappings
        u.Startup(u.newenv)
        u.ImportSchema()
        u.BuildMappings()

        # Reset the Xlogs
        u.Shutdown()
        u.ResetXLogs()

        # Remap oids for the new database
        # + Requires working directories on all hosts
        # + Requires new db initialized
        u.RemapOID()

        # Confirm that the resync/remapping was successful
        # + Restore statistics must either be after resetXlogs or
        #   requires an additional vacuum step.
        u.Startup(u.newenv, utility=True)
        u.RestoreStatistics()
        u.Shutdown()
        u.SetState('NEWDB VALID')

        # We haven't modified anything under the master directory yet.
        # If anything has gone wrong up to this point it is pretty much
        # Safe to blow away everything under 'upgrade/' and 'backup/'
        # (The only thing to be careful about is that we shutdown the
        #  new db before we remove the storage from under it.)
            
        # To install the new db under the old master path we go through
        # pains to make it as robust as possible.  This is done via a
        # combination of redundancy and hard links.

        # --------
        # Stage 1:
        # -------- 
        # The current state of the world is as follows
        #    DATA_DIR/         = untouched original db
        #    DATA_DIR/upgrade  = fully upgraded new db
        #    DATA_DIR/backup   = empty except for the state and flag files.
        # => Make a deep hardlink copy of DATA_DIR -> DATA_DIR/backup
        u.ReleaseLockdown(u.oldenv)
        u.DeepLink('BACKUP')
        u.SetState('BACKUP VALID')

        try:
            # --------
            # Stage 2:
            # -------- 
            # The current state of the world is as follows
            #    DATA_DIR/         = contents unreliable
            #    DATA_DIR/upgrade  = fully upgraded new db
            #    DATA_DIR/backup   = untouched original db
            # => Make a deep hard link copy of DATA_DIR/upgrade -> DATA_DIR
            # => Adjust new pg_configuration to point to DATA_DIR
            u.DeepLink('INSTALL')
            u.FixConfig()

            # Validate upgraded instance
            u.Startup(u.newenv)
            if u.validate:
                u.Log('INFO', 'Validating upgraded instance')
                u.CheckCatalog(u.newenv)
                u.CollectValidation()
            u.Shutdown()

            # Everything upgraded and validated
            # + Release the lockdown
            # + Mark install valid
            u.ReleaseLockdown(u.newenv)

            # Finally, drop the upgrade user (temporarily disabled)
            #u.Startup(u.newenv)
            #u.Log('INFO', "Removing user '%s'" % MIGRATIONUSER)
            #u.Update('DROP USER IF EXISTS ' + MIGRATIONUSER)
            #u.Shutdown()

            # Done, validated, user dropped
            u.SetState('INSTALL VALID')

            if u.warnings:
                u.Log('WARN', '***************************************')
                u.Log('WARN', 'Warnings encountered during upgrade.')
                value = ''
                while value.upper() not in ['Y', 'N']:
                    try:
                        value = raw_input('Finish Upgrade (Y/N)> ').upper()
                    except EOFError: 
                        value = 'N'
                    if value not in ['Y', 'N']:
                        print 'Invalid input'
                if value == 'N':
                    raise UpgradeError('Upgrade Cancelled')
                u.Log('WARN', '***************************************')

        except Exception, e:
            u.Log('FATAL', str(e))
            u.Revert()
            raise e

        # --------
        # Stage 3:
        # -------- 
        # The current state of the world is as follows
        #    DATA_DIR/         = fully upgraded new db
        #    DATA_DIR/upgrade  = fully upgraded new db
        #    DATA_DIR/backup   = untouched original db
        # => Remove redundant DATA_DIR/upgrade
        # => Remove historical DATA_DIR/backup      (???)
        u.RemoveDirectories()

        # -----------------
        # Upgrade Complete:
        # -----------------
        # The current state of the world is as follows
        #    DATA_DIR/         = fully upgraded new db
        u.Log('INFO', 
'''
--------------------------------------------
Upgrade Successful
--------------------------------------------
To complete the environment configuration
1. Update %s .bashrc to source the file:
   %s/greenplum_path.sh
2. Re-initialize standby master
--------------------------------------------
''' 
              % (u.user, u.newhome))


#---------------------------------------------------------
# The rest of the options are executed on a per-host basis
    elif u.cmd == 'SETSTATE':
        u.SetState(u.option)
    elif u.cmd == 'CHKDIR':
        try:
            u.CheckDirectories()
        except UpgradeError, e:
            if str(e) == 'Directories exist':
                sys.exit(1)
            raise e
    elif u.cmd == 'CHKDOWN':
        u.CheckDown()
    elif u.cmd == 'LOCKDOWN':
        u.SetupLockdown()
    elif u.cmd == 'UNLOCK':
        u.ReleaseLockdown(None)
    elif u.cmd == 'MKDIR':
        u.CreateDirectories()
    elif u.cmd == 'RMDIR':
        if u.option == 'False':
            u.RemoveDirectories(False)
        else:
            u.RemoveDirectories(True)
    elif u.cmd == 'RESETXLOG':
        u.ResetXLogs()
    elif u.cmd == 'MAPPINGS':
        u.BuildMappings()
    elif u.cmd == 'REMAPOID':
        u.RemapOID()
    elif u.cmd == 'DEEPLINK':
        u.DeepLink(u.option)
    else:
        raise Exception('Unknown cmd: ' + str(u.cmd))

# Any error that can happen
except KeyboardInterrupt:
    try:    u.Cleanup()
    except Exception, e2: 
        u.Log('FATAL', str(e2))
    u.Log('FATAL', '***************************************')
    u.Log('FATAL', '==  Upgrade interupted by user ==        <<<<< ')
    u.Log('FATAL', '***************************************')
    sys.exit(1)

except ConnectionError, e:
    try:   u.Cleanup()
    except Exception, e2: 
        u.Log('FATAL', str(e2))
    u.Log('FATAL', '***************************************')
    u.Log('FATAL', str(e))
    u.Log('FATAL', '***************************************')
    sys.exit(1)

except UpgradeError, e:
    try:   u.Cleanup()
    except Exception, e2: 
        u.Log('FATAL', str(e2))
    u.Log('FATAL', '***************************************')
    u.Log('FATAL', str(e))
    u.Log('FATAL', '***************************************')
    sys.exit(1)

except CmdError, e:
    try:   u.Cleanup()
    except Exception, e2:
        u.Log('FATAL', str(e2))
    u.Log('FATAL', '***************************************')
    u.Log('FATAL', 'Error executing command:')
    u.Log('FATAL', '  ' + str(e.cmd))
    u.Log('FATAL', '  ' + str(e.stderr))
    u.Log('FATAL', '***************************************')
    sys.exit(1)

# Shouldn't get any of these, if they occur it is probably a bug in
# the upgrader.
except Exception, e:
    try:   u.Cleanup()
    except Exception, e2: 
        u.Log('FATAL', str(e2))
    u.Log('FATAL', '***************************************')
    u.Log('FATAL', str(e))
    u.Log('FATAL', '***************************************')
    sys.stderr.write(traceback.format_exc())
    sys.exit(1)
