#!/usr/bin/env python

'''
gpscp -- scp to multiple hosts at once

Usage: gpscp [--version] [-?v] [-p port] [-u user]
             [-h host] [-f hostfile] local_file remote_file

	     --version : print version information
             -?        : print this help screen
	     -v	       : verbose mode
	     -p port   : ssh port to use 
	     -u user   : ssh user to run command
	     -h host   : ssh host to connect to (multiple -h is okay)
	     -f file   : a file listing all hosts to connect to
'''

import sys, getopt, popen2, os

sys.path.append(sys.path[0] + '/lib')
try:
    import gplib
except ImportError, e:
    sys.exit('Error: unable to import module: ' + str(e))

#
# all the command line options
#
script_name = os.path.split(__file__)[-1]
opt = {}
opt['-v'] = False
opt['-p'] = None
opt['-u'] = os.environ.get('LOGNAME') or os.environ.get('USER')
opt['-h'] = []
opt['-f'] = None
localPath = None
remotePath = None
cmd = []
session = []

################
def usage(exitarg):
    print gplib.cli_help() or __doc__
    sys.exit(exitarg)

#############
def print_version():
    print '%s version $Revision$' % script_name
    sys.exit(0)

#############
def parseCommandLine():
    global opt, cmd, localPath, remotePath
    try:
	(options, args) = getopt.getopt(sys.argv[1:], '?vp:u:h:f:', ['version'])
    except Exception, e:
	usage('Error: ' + str(e))

    for (switch, val) in options:
	if (switch == '-?'): 	      usage(0)
	elif (switch == '-v'):        opt[switch] = True
	elif (switch[1] in 'uf'):     opt[switch] = val
	elif (switch == '-h'):        opt[switch].append(val)
	elif (switch == '-p'):        opt[switch] = gplib.parse_port(val)
        elif (switch == '--version'): print_version()

    if opt['-p'] != None:
        if not opt['-p'] > 0: usage('Error: please specify port number for -p switch')

    hf = (len(opt['-h']) and 1 or 0) + (opt['-f'] and 1 or 0)
    if hf != 1:
	usage('Error: please specify at least one of -h or -f args, but not both')

    if (len(args) < 2):
	usage('Error: please specify local and remote file paths')

    if (len(args) > 2):
        usage('Error: too many arguments')

    localPath = args[0]
    remotePath = args[1]



#############
try:
    parseCommandLine()
    opt['-h'] = gplib.parse_hostlines_hostfile(opt['-h'],
                                               opt['-f'],
                                               opt['-u'],
                                               opt['-p'])
    if len(opt['-h']) == 0:
        usage('Error: missing hosts in -h and/or -f arguments')

    proc = []
    for (user, host, port) in opt['-h']:
        peer = user and ('%s@%s' % (user, host)) or host
	cmd = gplib.scp_prefix(port) + ' %s %s:%s' % (localPath, peer, remotePath)
	if opt['-v']: print '[INFO]', cmd
	p = popen2.Popen4(cmd)
	p.x_cmd = cmd
	p.x_user = user
	p.x_host = host
	p.x_peer = peer
	p.tochild.close()
	proc.append(p)

    errmsg = None
    for p in proc:
	for out in p.fromchild: 
	    print '[OUT %s] %s' % (p.x_peer, out)
	status = p.wait()
	if status:
	    errmsg = '[ERROR %s] failed %d' % (p.x_peer, status)
	    print errmsg

    if errmsg: sys.exit(1)
    if opt['-v']: print '[INFO] completed successfully'

except KeyboardInterrupt:
    sys.exit('\nInterrupted...')
