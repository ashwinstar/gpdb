#!/usr/bin/env python

'''
gpssh -- ssh access to multiple hosts at once

Usage: gpssh [--version] [-?v] [-p port] [-u user] [-h host] [-f hostfile] [cmd]

          --version : print version information
          -?        : print this help screen
          -v        : verbose mode
          -e        : echo commands as they are executed
          -p port   : ssh port to use 
          -u user   : the user to run command
          -h host   : the host to connect to (multiple -h is okay)
          -f file   : a file listing all hosts to connect to
          cmd       : the command to execute. If not present, 
                      go into interactive mode
'''

import os, sys, getopt, popen2, cmd, signal, time, atexit, threading

sys.path.append(sys.path[0] + '/lib')
try:
    import gplib
    import pxssh, pexpect
except ImportError, e:
    sys.exit('Error: unable to import module: ' + str(e))


#
# all the command line options
#
script_name = os.path.split(__file__)[-1]
USER = os.environ.get('LOGNAME') or os.environ.get('USER')
opt = {}
opt['-v'] = False
opt['-e'] = False
opt['-p'] = None
opt['-u'] = USER
opt['-h'] = []
opt['-f'] = False
argcmd = None
session = []

################
def usage(exitarg):
    print gplib.cli_help() or __doc__
    sys.exit(exitarg)


#############
def print_version():
    print '%s version $Revision$' % script_name
    sys.exit(0)

#############
def parseCommandLine():
    global opt, argcmd
    try:
	(options, args) = getopt.getopt(sys.argv[1:], '?evp:u:h:f:', ['version'])
    except Exception, e:
	usage('Error: ' + str(e))

    for (switch, val) in options:
	if (switch == '-?'):	      usage(0)
	elif (switch[1] in 'ev'):     opt[switch] = True
	elif (switch[1] in 'uf'):     opt[switch] = val
	elif (switch == '-h'):        opt[switch].append(val)
	elif (switch == '-p'):        opt[switch] = gplib.parse_port(val)
        elif (switch == '--version'): print_version()

    if opt['-p'] != None:
        if not opt['-p'] > 0: usage('Error: please specify port number for -p switch')

    hf = (len(opt['-h']) and 1 or 0) + (opt['-f'] and 1 or 0)
    if hf != 1:
	usage('Error: please specify at least one of -h or -f args, but not both')

    if (len(args) >= 1):
	argcmd = " ".join(args)




#############
def createOneTimeSession(cmd):
    session = []
    
    for (user, host, port) in opt['-h']:
        peer = user != USER and ('%s@%s' % (user, host)) or host
	ssh = gplib.ssh_prefix(user, host, port) + ' "%s" ' % cmd
	if opt['-v']: print '[INFO %s] %s' % (peer, cmd)
	elif opt['-e']: print cmd
	p = popen2.Popen4(ssh)
	p.x_user = user or ''; p.x_host = host
	p.x_cmd = cmd;   p.x_ssh = ssh
	p.x_peer = peer
	p.tochild.close()
	session.append(p)
    
    return session

def waitOneTimeSession(session):
    errmsg = None
    permissionDenied = False
    for p in session:
	for out in p.fromchild:
	    if len(out) > 1: 
		print '[%s] %s' % (p.x_peer, out[:-1])
		if not permissionDenied:
		    permissionDenied = (out.find('Permission denied') >= 0)
	status = p.wait()
	if status:
	    errmsg = '[ERROR %s] Command failed. Exit status = %s' % (p.x_peer, status)
	    print errmsg
		
    if permissionDenied:
	print
	print 'hint: check if the host is alive'
	print 'hint: use gpssh-exkeys to setup public-key authentication between hosts'
	print
    if errmsg: sys.exit(1)


def closePxsshOne(p):
    p.close(force = True)

def closePxsshList(list):
    th = []
    for p in list:
	t = threading.Thread(target=closePxsshOne, args=(p,))
	t.start()
	th.append(t)
    for t in th:
	t.join()


#############
class Session(cmd.Cmd):
    def __init__(self):
	cmd.Cmd.__init__(self)
	self.pxssh = []
	self.prompt = '=> '
	self.peerStringFormatRaw = None

    def peerStringFormat(self):
	if self.peerStringFormatRaw: return self.peerStringFormatRaw
	cnt = 0
	for p in self.pxssh:
	    if cnt < len(p.x_peer): cnt = len(p.x_peer)
	self.peerStringFormatRaw = "[%%%ds]" % cnt
	return self.peerStringFormatRaw
	

    def login(self, hostList):
	print '\n[Reset ...]'
	self.clean()
	for (user, host, port) in hostList:
	    p = pxssh.pxssh()
	    p.loginAsync(host, user, port=port)
            peer = user != USER and ('%s@%s' % (user, host)) or host
	    p.x_user = user or ''; p.x_host = host
	    p.x_peer = peer
	    p.x_pid = p.pid
	    self.pxssh.append(p)
	for p in self.pxssh:
	    print '[INFO] login %s' % p.x_peer
	    if not p.loginWait():
		print '[ERROR] unable to login to %s' % p.x_peer
		print
		print 'hint: use gpssh-exkeys to setup public-key authentication between hosts'
		print
		sys.exit(1)


    def clean(self):
	t = None
	try:
	    try:
		t = threading.Thread(target=closePxsshList, args=(self.pxssh,))
	    finally:
		if t: t.start()
	finally:
	    if t: t.join()
	self.pxssh = []

    def emptyline(self):
	pass


    def default(self, line):
	line = line.strip();
	if line == 'EOF' or line == 'exit':
	    sys.exit(0)
	line = line.split('\\');
	line = '\\\\'.join(line);
	line = line.split('"');
	line = '\\"'.join(line);
        line = line.split('$')
        line = '\\$'.join(line)
	line = 'eval "' + line + '" < /dev/null';
	if opt['-e']: print line
	for s in self.pxssh:
	    s.sendline(line)
	    s.flush()
	for s in self.pxssh:
	    while not s.prompt(120) and s.isalive() and not s.eof(): pass
	    out = s.before.split('\n')
	    out = out[1:-1]
	    if len(out) == 0:
		print (self.peerStringFormat() % s.x_peer)
	    else:
		for line in out:
		    print (self.peerStringFormat() % s.x_peer), line
    

session = None
def cleanup():
    while True:
	try:
	    if session: session.clean()
	    break
	except KeyboardInterrupt:
	    pass


sigint_time = 0
def sigint_handle(signum, frame):
    global sigint_time
    now = time.time()
    if now - sigint_time >= 3: 
	sigint_time = now
	raise KeyboardInterrupt
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    print '\n[Exiting...]'
    sys.exit(1)


def interactive():
    global session
    try:
	import readline
        #Read in the saved command history, if any
	histfile = os.path.join(os.environ["HOME"], ".gshist")
	# Set the maximum number of commands to 100
	readline.set_history_length(500)
	try:
	    readline.read_history_file(histfile)
	except IOError:
	    pass
	atexit.register(readline.write_history_file, histfile)
    except Exception, e:
	print "Note: command history unsupported on this machine ..."

    atexit.register(cleanup)
    signal.signal(signal.SIGINT, sigint_handle)
    while True:
	try:
	    if session: 
		print '\n[Cleanup...]'; 
		session.clean()
		session = None
	    session = Session()
	    session.login(opt['-h'])
	    session.cmdloop()
	except pexpect.EOF:
	    print '\n[Unexpected EOF from some hosts...]'
	    pass
	except KeyboardInterrupt:
	    print '\n[Interrupt...]'
	    pass



#############
try:
    parseCommandLine()
    opt['-h'] = gplib.parse_hostlines_hostfile(opt['-h'],
                                               opt['-f'],
                                               opt['-u'],
                                               opt['-p'])
    if len(opt['-h']) == 0:
        usage('Error: missing hosts in -h and/or -f arguments')

    if argcmd:
	s = createOneTimeSession(argcmd)
	waitOneTimeSession(s)
	if opt['-v']: print '[INFO] completed successfully'
	sys.exit(0)

    interactive()

except KeyboardInterrupt:
    sys.exit('\nInterrupted...')
