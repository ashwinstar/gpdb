EXECNAME = os.path.split(__file__)[-1]



#----------------------- Command line option parser ----------------------

def parseargs():
    parser = OptParser(option_class=OptChecker,
                description=' '.join(description.split()),
                version='%prog version $Revision: #12 $')
    parser.setHelp(_help)
    parser.set_usage('%prog [--help] [options] ')
    parser.remove_option('-h')
    
    parser.add_option('-c','--clean', action='store_true',
                        help='remove the expansion schema.')
    parser.add_option('-V', '--novacuum', action='store_true', 
                      help='Vacuum catalog tables before creating schema copy')                        
    parser.add_option('-d','--duration', type='duration', metavar='[h][:m[:s]]',
                      help='duration from beginning to end')
    parser.add_option('-e','--end', type='datetime', metavar='datetime',
                       help="ending date and time")
    parser.add_option('-h', '-?', '--help', action='help',
                        help='show this help message and exit')
    parser.add_option('-i','--input', dest="filename",
                        help="input expansion configuration file", metavar="FILE")        
    parser.add_option('-q', '--quiet', action='store_true',
                        help='suppress status messages')
    parser.add_option('-n', '--parallel', type="int", default=1, metavar="<parallel_processes>",
                        help='number of tables to expand at a time. Valid values are 1-127')
    parser.add_option('-v','--verbose', action='store_true',
                        help='debug output.')
  
        
    parser.set_defaults(verbose=False,filters=[], slice=(None, None))
    
    
    # Parse the command line arguments
    (options, args) = parser.parse_args()
    
    #-n sanity check
    if options.parallel > 128 or options.parallel < 1:
        logger.error('Invalid argument.  parallel value must be >= 1 and <= 128')
        parser.print_help()
        parser.exit()
        
    options.master_data_directory = os.getenv('MASTER_DATA_DIRECTORY', None)
    if not options.master_data_directory:
        logger.error('MASTER_DATA_DIRECTORY environment variable not set')
        parser.exit()
    return options, args


#states
UNINITIALIZED,SETUP,INPROGRESS,FINISHED=range(4)

#expansion schema
gpexpand_schema='gpexpand'
create_schema_sql = "CREATE SCHEMA " + gpexpand_schema 
drop_schema_sql = "DROP schema %s CASCADE" % gpexpand_schema

status_table='status'
status_table_sql="""CREATE TABLE %s.%s
                        ( status text,
                          updated timestamp ) """ % (gpexpand_schema,status_table)

status_detail_table='status_detail'
status_detail_table_sql="""CREATE TABLE %s.%s
                        ( dbname text,
                          fq_name text,
                          schema_oid oid,
                          table_oid oid,
                          distribution_policy smallint[],
                          distribution_policy_names varchar,
                          rank int,
                          status text,
                          expansion_started timestamp,
                          expansion_finished timestamp,
                          source_bytes numeric ) """ % (gpexpand_schema, status_detail_table)

class InvalidStatusError(Exception): pass

class GpExpandStatus():
    """Class that manages gpexpand status file."""
    def __init__(self, master_data_directory, master_mirror_hostname=None):
        self._status_values = { 'UNINITIALIZED': 1,
                                'EXPANSION_PREPARE_STARTED': 2,
                                'SETUP_EXPANSION_SCHEMA_STARTED': 3,
                                'SETUP_EXPANSION_SCHEMA_DONE': 4,
                                'BUILD_SEGMENT_TEMPLATE_STARTED': 5,
                                'BUILD_SEGMENT_TEMPLATE_DONE': 6,
                                'BUILD_SEGMENTS_STARTED': 7,
                                'BUILD_SEGMENTS_DONE': 8,
                                'UPDATE_OLD_SEGMENTS_STARTED': 9,
                                'UPDATE_OLD_SEGMENTS_DONE': 10,
                                'UPDATE_MASTER_STARTED': 11,
                                'UPDATE_MASTER_DONE': 12,
                                'PREPARE_EXPANSION_SCHEMA_STARTED': 13,
                                'PREPARE_EXPANSION_SCHEMA_DONE': 14,
                                'EXPANSION_PREPARE_DONE': 15 }
        self._status = None
        self._status_info = None
        self._master_data_directory = master_data_directory
        self._master_mirror_hostname = master_mirror_hostname
        self._status_filename = master_data_directory + '/gpexpand.status'
        self._fp = None
        
        if os.path.exists(self._status_filename):
            self._read_status_file()
        else:
            self._create_status_file()
            self._sync_status_file()
            
    def _read_status_file(self):
        """Reads in an existing gpexpand status file"""
        try:
            self._fp = open(self._status_filename, 'a+')
            self._fp.seek(0)
            
            for line in self._fp:
                (self._status, self._status_info) = line.rstrip().split(':')
        except IOError:
            raise
        
        if not self._status_values.has_key(self._status):
            raise InvalidStatusError('Invalid status file.  Unknown status %s' % self._status)
    
    def _create_status_file(self):
        """Creates a new gpexpand status file"""
        try:
            self._fp = open(self._status_filename, 'w')
            self._fp.write('UNINITIALIZED:None\n')
            self._fp.flush()
            self._sync_status_file()
            self._status = 'UNINITIALIZED'
        except IOError:
            raise
    
    def _sync_status_file(self):
        """Syncs the gpexpand status file with the master mirror"""
        # self,name,srcDirectory,dstHost,dstDirectory,ctxt=LOCAL,remoteHost=None):
        if self._master_mirror_hostname:
            cpCmd = RemoteCopy('copying gpexpand status file to master mirror', 
                               self._status_filename, self._master_mirror_hostname,
                               self._status_filename, ctxt=REMOTE, 
                               remoteHost=self._master_mirror_hostname)
            cpCmd.run(validateAfter=True)
    
    def set_status(self, status, status_info=None):
        """Sets the current status.  gpexpand status must be set in
           proper order.  Any out of order status result in an
           InvalidStatusError exception"""
        if not self._fp:
            raise InvalidStatusError('The status file is invalid and cannot be written to')
        if not self._status_values.has_key(status):
            raise InvalidStatusError('%s is an invalid gpexpand status' % status)
        # Only allow state transitions forward or backward 1
        if self._status and \
           self._status_values[status] != self._status_values[self._status] + 1:
                raise InvalidStatusError('Invalid status transition from %s to %s' % (self._status, status))
        self._fp.write('%s:%s\n' % (status, status_info))
        self._fp.flush()
        self._sync_status_file()
        self._status = status
        self._status_info = status_info
    
    def get_current_status(self):
        """Gets the current status that has been written to the gpexpand
           status file"""
        return (self._status, self._status_info)
    
    def remove_status_file(self):
        """Closes and removes the gpexand status file"""
        if self._fp:
            self._fp.close()
            self._fp = None
        if os.path.exists(self._status_filename):
            os.unlink(self._status_filename)


class ExpansionError(Exception): pass
class SegmentTemplateError(Exception): pass

class SegmentTemplate:
    
    # SQL
    update_new_seg_gpid_sql = """UPDATE pg_catalog.gp_id 
                                 SET numsegments=%d, dbid=%d, content=%d"""
    
    
    def __init__(self, logger, statusLogger, pool, 
                 gparray, newSegments, masterDataDirectory, 
                 dbURL, noVacuumCatalog, tempDir, 
                 schemaTarFile='gpexpand_schema.tar'):
        self.logger = logger
        self.statusLogger = statusLogger
        if pool:
            self.pool = pool
        else:
            self.pool = WorkerPool()
        self.gparray = gparray
        self.newSegments = newSegments
        self.noVacuumCatalog = noVacuumCatalog
        self.tempDir = tempDir
        self.dbURL = dbURL
        self.conn=dbconn.connect(self.dbURL)
        self.gparray = gparray
        self.masterDataDirectory = masterDataDirectory
        self.schema_tar_file = schemaTarFile
        
        # Reduce multiple interfaces to common hostname
        self.hosts = []
        for seg in self.newSegments:
            hostnameCmd = Hostname('gpexpand', ctxt=REMOTE, remoteHost=seg['hostname'])
            hostnameCmd.run(validateAfter=True)
            res = hostnameCmd.get_results()
            if not res.wasSuccessful():
                self.logger.warn('Failed to execute \'hostname %s\': %s' % (seg['hostname'], res.printResults()))
            elif not hostnameCmd.get_hostname() in self.hosts:
                self.logger.debug('Adding %s to host list' % hostnameCmd.get_hostname())
                self.hosts.append(hostnameCmd.get_hostname())
    
    
    def build_segment_template(self):
        """Builds segment template tar file"""
        # Check if we need to roll back or if we are past this stage
        status = self.statusLogger.get_current_status()
        if status[0] == 'BUILD_SEGMENT_TEMPLATE_STARTED':
            # resuming 
            pass
        elif status[0] != 'SETUP_EXPANSION_SCHEMA_DONE':
            self.logger.debug('Current status is past BUILD_SEGMENT_TEMPLATE_DONE')
            return
        else:
            self.statusLogger.set_status('BUILD_SEGMENT_TEMPLATE_STARTED', self.tempDir)
        
        self._create_template()
        self._fixup_template()
        self._tar_template()
        self.statusLogger.set_status('BUILD_SEGMENT_TEMPLATE_DONE')

        
    def build_new_segments(self):
        """Deploys the template tar file and configures the new segments"""
        # Check if we need to roll back or if we are past this stage
        status = self.statusLogger.get_current_status()
        if status[0] == 'BUILD_SEGMENTS_STARTED':
            # resuming
            pass
        elif status[0] != 'BUILD_SEGMENT_TEMPLATE_DONE':
            self.logger.debug('Current status is past BUILD_SEGMENTS_DONE')
            return
        else:        
            self.statusLogger.set_status('BUILD_SEGMENTS_STARTED', self.schema_tar_file)
        
        self._distribute_template()
        self._configure_new_segments()
        self.statusLogger.set_status('BUILD_SEGMENTS_DONE')
        

    def _create_template(self):
        """Creates the schema template that is used by new segments"""
        self.logger.info('Creating segment template')
        
        if not self.noVacuumCatalog:
            self.logger.info('VACUUM FULL on the catalog tables')
            catalog.vacuum_catalog(self.dbURL,self.conn,full=True)
        
        MakeDirectory.local('gpexpand temp dir',self.tempDir)    
                
        self._select_src_segment()

        self.maxDbId = self.gparray.get_max_dbid()        
        self.oldSegCount = self.gparray.get_segment_count()
             
        GpStop.local('stop GPDB')

        try:    
            gp_segcopy = GpSegCopy(self.logger, '127.0.0.1', self.masterDataDirectory,
                                   '127.0.0.1', self.tempDir, True, True, 'sync')
            gp_segcopy.copy()
        except SegcopyError, msg:
            raise SegmentTemplateError(msg)

    
    def _select_src_segment(self):            
        seg = self.gparray.segments[0]
        if seg.primaryDB.valid:            
            self.srcSegHostname = seg.primaryDB.hostname
            self.srcSegDataDir = seg.primaryDB.datadir
        elif seg.mirrorDBs[0] is not None and seg.mirrorDBs[0].valid:
            self.srcSegHostname = seg.mirrorDBs[0].hostname
            self.srcSegDataDir = seg.mirrorDBs[0].datadir
        else:
            raise SegmentTemplateError("no valid segdb for content=0 to use as a template")
        
        
    def _distribute_template(self):
        """Distributes the template tar file to the new segments and expands it"""
        self.logger.info('Distributing template tar file to new hosts')
      
        self._distribute_tarfile()
        self._extract_tarfile()
        
    
    def _distribute_tarfile(self):  
        for host in self.hosts:
            cpCmd = RemoteCopy('distribute tar file to all new hosts', self.schema_tar_file, host, '.')
            self.pool.addCommand(cpCmd)
            
        self.pool.join()
        self.pool.check_results()
        
        
    def _extract_tarfile(self):
        self.logger.info('Extracting template tar file to new segment data directories')
        for seg in self.newSegments:
            extractTarCmd = ExtractTar('extract tar file to all new hosts', self.schema_tar_file,
                                       seg['dataDir'], ctxt=REMOTE, 
                                       remoteHost=seg['hostname'])
            self.pool.addCommand(extractTarCmd)
            
        self.pool.join()
        self.pool.check_results()        
        
        
        
    def _configure_new_segments(self):
        """Configures new segments.  This includes modifying the postgresql.conf file
        and setting up the gp_id table"""
        
        self.logger.info('Configuring new segments')
        
        newPrimaryCount = 0;
        for seg in self.newSegments:
            if seg['definedprimary'] == 't' and seg['contentId'] != -1: 
                newPrimaryCount += 1
         
        newPrimaryCount += self.gparray.get_primary_count()
        newDbId = self.maxDbId + 1
        for seg in self.newSegments:
            seg['dbId'] = newDbId
            #self, name, dataDir, port, numSegs, ctxt=LOCAL, remoteHost=None):
            segCfgCmd = ConfigExpansionSeg('configure new segment', seg['dataDir'], 
                                              seg['port'], newPrimaryCount, 
                                              seg['contentId'], seg['dbId'], True,
                                              ctxt=REMOTE, remoteHost=seg['hostname']) 
            self.pool.addCommand(segCfgCmd)
            newDbId += 1

        
    def _fixup_template(self):
        """Copies postgresql.conf and pg_hba.conf files from a valid segment on the system.
        Then modifies the template copy of pg_hba.conf"""
        
        self.logger.info('Copying postgresql.conf from existing segment into template')
        cpCmd = RemoteCopy('copying postgresql.conf to %s:%s/postgresql.conf' % (self.srcSegHostname, self.srcSegDataDir), 
                           self.srcSegDataDir + '/postgresql.conf', '127.0.0.1', 
                           self.tempDir, ctxt=REMOTE, remoteHost=self.srcSegHostname)
        cpCmd.run(validateAfter=True)
       
        
        self.logger.info('Copying pg_hba.conf from existing segment into template')
        cpCmd = RemoteCopy('copy pg_hba.conf to %s:%s/pg_hba.conf' % (self.srcSegHostname, self.srcSegDataDir), 
                           self.srcSegDataDir + '/pg_hba.conf', '127.0.0.1', 
                           self.tempDir, ctxt=REMOTE, remoteHost=self.srcSegHostname)
        cpCmd.run(validateAfter=True)
        
        
        rmCmd = RemoveFiles('gpexpand', self.tempDir + '/gpperfmon/data')
        rmCmd.run(validateAfter=True)
        
        self.logger.info('Adding new segments into template pg_hba.conf')
        try:
            fp = open(self.tempDir + '/pg_hba.conf', 'a')
            try:
                for newSeg in self.newSegments:
                    (hostname, aliaslist, ipaddrlist) = socket.gethostbyname_ex(newSeg['hostname'])
                    fp.write('# %s\n' % newSeg['hostname'])
                    for addr in ipaddrlist:
                        fp.write('host\tall\tall\t%s/32\ttrust\n' % addr)
            finally:
                fp.close()
        except IOError, msg:
            raise SegmentTemplateError('Failed to open %s/pg_hba.conf' % self.tempDir)
        except Exception, msg:
            raise SegmentTemplateError('Failed to add new segments to template pg_hba.conf: %' % msg)
    
    
    def _tar_template(self):
        """Tars up the template files"""        
        tarCmd = CreateTar('tar segment template', self.tempDir, self.schema_tar_file)
        tarCmd.run(validateAfter=True)


    def cleanup_build_segment_template(self, tarFile=None, tempDir=None):
        """Reverts the work done by build_segment_template.  Deletes the temp
        directory and local tar file"""
        if not tempDir:
            tempDir = self.tempDir
        if not tarFile:
            tarFile = self.schema_tar_file
        rmCmd = RemoveFiles('remove temp dir: %s' % tempDir, tempDir)
        rmCmd.run(validateAfter=True)
        rmCmd = RemoveFiles('remove segment template file', tarFile)
        rmCmd.run(validateAfter=True)

    
        
    def cleanup_build_new_segments(self, tarFile=None, removeDataDirs=False):
        """Cleans up the work done by build_new_segments.  Deletes remote tar files and
        and optionally removes remote data directories"""
        if not tarFile:
            tarFile = self.schema_tar_file

        for host in self.hosts:
            rmCmd = RemoveFiles('remove segment template file on host: %s' % host, 
                                tarFile, ctxt=REMOTE, remoteHost=host)
            self.pool.addCommand(rmCmd)
            
        if removeDataDirs:
            for seg in self.newSegments:
                rmCmd = RemoveFiles('remove segment data directory: %s:%s' % (seg['hostname'], seg['dataDir']), 
                                    seg['dataDir'], ctxt=REMOTE, remoteHost=seg['hostname'])
                self.pool.addCommand(rmCmd)
            
        self.pool.join()
        self.pool.check_results()
          
    
    def cleanup(self):
        """Cleans up temporary files from the local system and new segment hosts"""

        self.logger.info('Cleaning up temporary template files')
        self.cleanup_build_segment_template()
        self.cleanup_build_new_segments()


class gpexpand:
    
    def __init__(self,logger,statusLogger,dburl,parallel=1):
        self.logger = logger
        self.statusLogger = statusLogger
        self.dburl = dburl
        self.numworkers=parallel   
        try:      
            self.conn = dbconn.connect(self.dburl)
            self.gparray = createGPDBFromDB(self.dburl)
        except Exception:
            pass

        #TODO: we want more threads most likely for segment addition
        self.pool = WorkerPool()
        self.tempDir = '%s/gpexpand_%s_%d' % (os.getcwd(), 
                                              datetime.datetime.now().strftime('%m%d%Y'), 
                                              os.getpid()) 
        self.queue = None
        pass
    
    
