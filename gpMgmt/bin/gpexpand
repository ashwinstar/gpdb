import copy
import datetime
import os
import sys
import socket

from optparse import Option, OptionGroup, OptionParser, OptionValueError, SUPPRESS_USAGE

from gppylib.commands.unix import *
from gppylib.commands.gp import Psql, ModifyPostgresqlConfSetting, SegmentStart, SegmentStop
from gppylib.gpparseopts import OptParser, OptChecker
from gppylib.gplog import *
from gppylib.db import dbconn
from gppylib.db import catalog
from gppylib.segcopy import GpSegCopy, SegcopyError

description = (""" 
Adds additional segments to a pre-existing GPDB Array.
""")

_help = ["""
TODO: add txt for gpexpand!
"""]

EXECNAME = os.path.split(__file__)[-1]



#----------------------- Command line option parser ----------------------

def parseargs():
    parser = OptParser(option_class=OptChecker,
                description=' '.join(description.split()),
                version='%prog version $Revision: #12 $')
    parser.setHelp(_help)
    parser.set_usage('%prog [--help] [options] ')
    parser.remove_option('-h')
    
    parser.add_option('-c','--clean', action='store_true',
                        help='remove the expansion schema.')
    parser.add_option('-V', '--vacuum', action='store_true',
                      help='Vacuum catalog tables before creating schema copy')                        
    parser.add_option('-d','--duration', type='duration', metavar='[h][:m[:s]]',
                      help='duration from beginning to end')
    parser.add_option('-e','--end', type='datetime', metavar='datetime',
                       help="ending date and time")
    parser.add_option('-h', '-?', '--help', action='help',
                        help='show this help message and exit')
    parser.add_option('-i','--input', dest="filename",
                        help="input expansion configuration file", metavar="FILE")        
    parser.add_option('-q', '--quiet', action='store_true',
                        help='suppress status messages')
    parser.add_option('-n', '--parallel', type="int", default=1, metavar="<parallel_processes>",
                        help='number of tables to expand at a time. Valid values are 1-127')
    parser.add_option('-v','--verbose', action='store_true',
                        help='debug output.')
    parser.add_option('-m', '--master_data_directory', action='store_true',
                        default=os.getenv("MASTER_DATA_DIRECTORY"),
                        help='master data directory used for schema only copy')
    
    
        
    parser.set_defaults(verbose=True, filters=[], slice=(None, None))
    
    
    # Parse the command line arguments
    (options, args) = parser.parse_args()
    
    #-n sanity check
    if options.parallel > 128 or options.parallel < 1:
        parser.print_help()
        parser.exit()
        
    if not options.master_data_directory:
        parser.print_help()
        parser.exit()
    return options, args


#states
UNINITIALIZED,SETUP,INPROGRESS,FINISHED=range(4)

#expansion schema
gpexpand_schema='gpexpand'
create_schema_sql = "CREATE SCHEMA " + gpexpand_schema 
drop_schema_sql = "drop schema %s cascade" % gpexpand_schema

status_table='status'
status_table_sql="""CREATE TABLE %s.%s
                        ( status text,
                          updated timestamp ) """ % (gpexpand_schema,status_table)

status_detail_table='status_detail'
status_detail_table_sql="""CREATE TABLE %s.%s
                        ( dbname text,
                          fq_name text,
                          schema_oid oid,
                          table_oid oid,
                          distribution_policy smallint[],
                          distribution_policy_names varchar,
                          rank int,
                          status text,
                          expansion_started timestamp,
                          expansion_finished timestamp,
                          source_bytes numeric ) """ % (gpexpand_schema, status_detail_table)


class ExpansionError(Exception): pass
class SegmentTemplateError(Exception): pass

class SegmentTemplate:
    
    # SQL
    segment_src_sql = """
        SELECT hostname, datadir FROM pg_catalog.gp_configuration
        WHERE content > -1 AND definedprimary='t' AND valid = 't'
        LIMIT 1
    """
    max_dbid_sql = """ SELECT max(dbid) FROM gp_configuration """
    num_segments_sql = """SELECT numsegments FROM pg_catalog.gp_id"""
    get_catalog_tables_sql = """
                             SELECT schemaname || '.' ||  tablename 
                             FROM pg_tables 
                             WHERE schemaname = 'pg_catalog'
                             """
    vacuum_full_sql = 'VACUUM FULL %s'
    update_new_seg_gpid_sql = """UPDATE pg_catalog.gp_id 
                                 SET numsegments=%d, dbid=%d, content=%d"""
    
    
    def __init__(self, logger, newSegments, masterDataDirectory, 
                 dbUrl, vacuumCatalog, tempDir, schemaTarFile='gpexpand_schema.tar'):
        self.logger = logger
        self.newSegments = newSegments
        self.vacuumCatalog = vacuumCatalog
        self.tempDir = tempDir
        self.dbUrl = dbUrl
        self.masterDataDirectory = masterDataDirectory
        self.schema_tar_file = schemaTarFile
    
        
    def create_new_segments(self):
        """Creates, cleans up and deploys new segments"""
        self._create_template()
        self._fixup_template()
        self._tar_template()
        self._distribute_template()
        self._configure_new_segments()
        pass
    
        
    def _create_template(self):
        """Creates the schema template that is used by new segments"""
        self.logger.info('Creating segment template')
        if self.vacuumCatalog:
            self._vacuum_catalog()

        os.mkdir(self.tempDir)

        conn = dbconn.connect(dburl)
        srcSeg = dbconn.execSQL(conn, self.segment_src_sql).fetchall()
        if len(srcSeg) != 1:
            raise SegmentTemplateError, "Unable to find a valid segment to use as a source"
        
        self.srcSegHostname = srcSeg[0][0]
        self.srcSegDataDir = srcSeg[0][1]

        maxDbId = dbconn.execSQL(conn, self.max_dbid_sql).fetchall()
        if len(maxDbId) != 1:
            raise SegmentTemplateError, 'Failed to retrieve maximum dbid from catalog'
        self.maxDbId = maxDbId[0][0]

        oldSegCount = dbconn.execSQL(conn, self.num_segments_sql).fetchall()
        if len(oldSegCount) != 1:
            raise SegmentTemplateError, 'Failed to retrieve current segment count'
        self.oldSegCount = oldSegCount[0][0]

        conn.commit()
        conn.close()
        
        rv = os.system('gpstop -fa')
        if rv != 0:
            raise SegmentTemplateError, "Failed to stop gpdb"

        try:    
            gp_segcopy = GpSegCopy(self.logger, '127.0.0.1', self.masterDataDirectory,
                                   '127.0.0.1', self.tempDir, True, True, 'sync')
            gp_segcopy.copy()
        except SegcopyError, msg:
            raise SegmentTemplateError, msg
                
    
    def _vacuum_catalog(self):
        """Vacuums all catalog tables"""
        
        self.logger.info('Vacuuming catalog tables')
        # Need to use pg, not pgdb, so we don't auto wrap in transaction
        vac_conn = dbconn.connect(self.dbUrl, usePg=True)
        conn = dbconn.connect(self.dbUrl)
        catalog_tables = dbconn.execSQL(conn, self.get_catalog_tables_sql).fetchall()
        conn.commit()
        conn.close()
            
        for table in catalog_tables:
                self.logger.info('Vacuuming %s' % table[0])
                vac_conn.query(self.vacuum_full_sql % table[0])
                
        vac_conn.close()

    
    def _distribute_template(self):
        """Distributes the template tar file to the new segments and expands it"""
        self.logger.info('Distributing template tar file to new hosts')
        # Reduce multiple interfaces to common hostname
        self.hosts = []
        for seg in self.newSegments:
            hostnameCmd = Hostname('gpexpand', ctxt=REMOTE, remoteHost=seg['hostname'])
            hostnameCmd.run(validateAfter=True)
            res = hostnameCmd.get_results()
            if not res.wasSuccessful():
                self.logger.warn('Failed to execute \'hostname %s\': %s' % (seg['hostname'], res.printResults()))
            elif not hostnameCmd.get_hostname() in self.hosts:
                self.logger.info('Adding %s to host list' % hostnameCmd.get_hostname())
                self.hosts.append(hostnameCmd.get_hostname())
        
        pool = WorkerPool()
        for host in self.hosts:
            cpCmd = RemoteCopy('gpexpand', self.schema_tar_file, host, '.')
            pool.addCommand(cpCmd)
            
        pool.join()
        try:
            pool.check_results()
        except ExecutionError:
            raise SegmentTemplateError, 'Failed to distribute tar file to all new hosts'
        
        self.logger.info('Extracting template tar file to new segment data directories')
        for seg in self.newSegments:
            extractTarCmd = ExtractTar('gpexpand', self.schema_tar_file,
                                       seg['dataDir'], ctxt=REMOTE, 
                                       remoteHost=seg['hostname'])
            pool.addCommand(extractTarCmd)
            
        pool.join()
        try:
            pool.check_results()
        except ExecutionError:
            raise SegmentTemplateError, 'Failed to extract tar file to all new hosts'
        pool.haltWork()
    
    
    def _configure_new_segments(self):
        """Configures new segments.  This includes modifying the postgresql.conf file
        and setting up the gp_id table"""
        
        self.logger.info('Configuring new segments')
        pool = WorkerPool()
        
        for seg in self.newSegments:
            modifyPostgresqlConfCmd = ModifyPostgresqlConfSetting('gpexpand',
                                                                  seg['dataDir'] + '/postgresql.conf',
                                                                  'port',
                                                                  seg['port'],
                                                                  optType='number',
                                                                  ctxt=REMOTE,
                                                                  remoteHost=seg['hostname'])
            chmodCmd = Chmod('gpexpand', seg['dataDir'], '0700', 
                             ctxt=REMOTE, remoteHost=seg['hostname'])
            self.logger.info('Updating %s:%s/postgresql.conf' % (seg['hostname'], seg['dataDir']))
            pool.addCommand(modifyPostgresqlConfCmd)
            self.logger.info('Changing permissions on %s:%s' % (seg['hostname'], seg['dataDir']))
            pool.addCommand(chmodCmd)

        pool.join()
        try:
            pool.check_results()
        except ExecutionError:
            raise SegmentTemplateError, 'Failed to modify new segments'


        for seg in self.newSegments:
            startCmd = SegmentStart('gpexpand', seg['dataDir'], seg['port'], utilityMode=True,
                                    ctxt=REMOTE, remoteHost=seg['hostname'])
            pool.addCommand(startCmd)
            
        pool.join()
        try:
            pool.check_results()
        except ExecutionError:
            raise SegmentTemplateError, 'Failed to start new segment in utility mode'

        newSegCount = len(self.newSegments) + self.oldSegCount
        newDbId = self.maxDbId + 1
        for seg in self.newSegments:
            dbUrl = dbconn.DbURL(hostname=seg['hostname'], port=seg['port'])
            conn = dbconn.connect(dbUrl, utility=True)
            seg['dbId'] = newDbId
            query =  self.update_new_seg_gpid_sql % (newSegCount, seg['dbId'], seg['contentId'])
            dbconn.execSQL(conn, query)
            newDbId += 1
            conn.commit()
            conn.close()

        self.logger.info('Stopping new segments')
        for seg in self.newSegments:
            stopCmd = SegmentStop('gpexpand', seg['dataDir'], ctxt=REMOTE, remoteHost=seg['hostname'])
            pool.addCommand(stopCmd)
            
        pool.join()
        try:
            pool.check_results()
        except ExecutionError:
            raise SegmentTemplateError, 'Failed to stop new segments'

        pool.haltWork()
    
    
    def _fixup_template(self):
        """Copies postgresql.conf and pg_hba.conf files from a valid segment on the system.
        Then modifies the template copy of pg_hba.conf"""
        
        self.logger.info('Copying postgresql.conf from existing segment into template')
        cpCmd = RemoteCopy('gpexpand', self.srcSegDataDir + '/postgresql.conf', '127.0.0.1', 
                           self.tempDir, ctxt=REMOTE, remoteHost=self.srcSegHostname)
        cpCmd.run(validateAfter=True)
        res = cpCmd.get_results()
        if not res.wasSuccessful():
            raise SegmentTemplateError, 'Failed to copy %s:%s/postgresql.conf: %s' % (self.srcSegHostname, self.srcSegDataDir, res.printResults())
        
        self.logger.info('Copying pg_hba.conf from existing segment into template')
        cpCmd = RemoteCopy('gpexpand', self.srcSegDataDir + '/pg_hba.conf', '127.0.0.1', 
                           self.tempDir, ctxt=REMOTE, remoteHost=self.srcSegHostname)
        cpCmd.run(validateAfter=True)
        res = cpCmd.get_results()
        if not res.wasSuccessful():
            raise SegmentTemplateError, 'Failed to copy %s:%s/pg_hba.conf: %s' % (self.srcSegHostname, self.srcSegDataDir, res.printResults())
        
        rmCmd = RemoveFiles('gpexpand', self.tempDir + '/gpperfmon/data')
        rmCmd.run(validateAfter=True)
        res = rmCmd.get_results()
        if not res.wasSuccessful():
            # Can ignore this, gpperfmon probably not installed
            pass
        
        self.logger.info('Adding new segments into template pg_hba.conf')
        try:
            fp = open(self.tempDir + '/pg_hba.conf', 'a')
            try:
                for newSeg in self.newSegments:
                    (hostname, aliaslist, ipaddrlist) = socket.gethostbyname_ex(newSeg['hostname'])
                    fp.write('# %s\n' % newSeg['hostname'])
                    for addr in ipaddrlist:
                        fp.write('host\tall\tall\t%s/32\ttrust\n' % addr)
            finally:
                fp.close()
        except IOError, msg:
            raise SegmentTemplateError, 'Failed to open %s/pg_hba.conf' % self.tempDir
        except Exception, msg:
            raise SegmentTemplateError, 'Failed to add new segments to template pg_hba.conf: %' % msg
    
    def _tar_template(self):
        """Tars up the template files"""
        
        self.logger.info('Creating template tar file')
        tarCmd = CreateTar('gpexpand', self.tempDir, self.schema_tar_file)
        tarCmd.run(validateAfter=True)
        res = tarCmd.get_results()
        if not res.wasSuccessful():
            raise SegmentTemplateError, 'Failed to tar segment template: %s' % res.printResult()

    
    def cleanup(self):
        """Cleans up temporary files from the local system and new segment hosts"""
        self.logger.info('Cleaning up temporary template files')
        pool = WorkerPool()
        
        rmCmd = RemoveFiles('gpexpand', self.tempDir)
        pool.addCommand(rmCmd)
        
        rmCmd = RemoveFiles('gpexpand', self.schema_tar_file)
        pool.addCommand(rmCmd)

        for host in self.hosts:
            rmCmd = RemoveFiles('gpexpand', self.schema_tar_file, ctxt=REMOTE, remoteHost=host)
            pool.addCommand(rmCmd)
            
        pool.join()
        try:
            pool.check_results()
        except ExecutionError:
            raise SegmentTemplateError, 'Failed to delete template tar file on segments'
        pool.haltWork()
       

class gpexpand:
    
    def __init__(self,logger,dburl,parallel=1):
        self.logger = logger
        self.dburl = dburl
        self.numworkers=parallel
         
        self.conn = dbconn.connect(self.dburl)
        pass
    
    
    def gather_state(self):
        """Used to probe the system to determine which stage of expansion we are in. 
        
        get a list of databases for us to check.  There should only exist a single gpexpand
        schema amongst any of them.  more than one is an error. zero means we haven't started yet.
        
        """         
        db_list = catalog.getDatabaseList(self.conn)
        test_url = copy.deepcopy(self.dburl)
        expand_dbs=[]
        for db in db_list:
            dbname = db[0]
            if dbname == 'template0':
                continue
            self.logger.debug("Probing database: '%s'" % dbname)
            test_url.pgdb = dbname
            c = dbconn.connect(test_url)
            if catalog.doesSchemaExist(c,gpexpand_schema):
                expand_dbs.append(db)
            c.close()    
        
        if len(expand_dbs) == 0:
            self.logger.debug("Could not find an expansion schema '%s' in this array.  State = UNINITIALIZED" \
                               % gpexpand_schema )
            return UNINITIALIZED
        elif len(expand_dbs) == 1:
            self.logger.debug("Found an expansion schema '%s' present in database %s" % (gpexpand_schema,expand_dbs[0]))                
        else:
            str="Found more than one expansion schema '%s' present in this array"\
                " in the following databases: %s " % (gpexpand_schema,expand_dbs)
            self.logger.error(str)
            raise ExpansionError(str)
        
        #read in the global status table        
        #raise ExpansionError("TODO:  need to impl")
        
        #read in table entries
        return SETUP
    
    def read_input_file(self):
        if not options.filename:
            raise ExpansionError, 'Missing input file'
        
        self.new_segments = []
        
        try:
            f = open(options.filename, 'r')
            line = 1
            try:
                while 1:
                    l = f.readline()
                    if not l:
                        break
                    hostname, dataDir, port, contentId = l.split(':')
                    seg = dict(zip(['hostname', 'dataDir', 'port', 'contentId'], [hostname, dataDir, int(port), int(contentId)]))
                    self.new_segments.append(seg)
                    line += 1
            except ValueError:
                raise ExpansionError, "Invalid input file on line %d" % line
            finally:
                f.close()
        except IOError:
            raise ExpansionError, "Input file %s not found" % options.filename
        
        
    def add_segments(self):
        tempDir = '%s/gpexpand_%d_%s' % (os.getcwd(), os.getpid(), 
                                         datetime.datetime.now().strftime('%m%d%Y'))
        self.old_segments = []
        
        # We need to get the current segment information before we start shutting
        # down the array. 
        rows = dbconn.execSQL(self.conn, 'SELECT hostname, datadir, port, content FROM pg_catalog.gp_configuration')
        for row in rows:
            seg = dict(zip(['hostname', 'dataDir', 'port', 'contentId'], row))
            seg['port'] = int(seg['port'])
            seg['contentId'] = int(seg['contentId'])
            self.old_segments.append(seg)
        
        self.conn.commit()
        self.conn.close()

        pool = WorkerPool()
        
        # Create, distribute and configure the new segments.
        try:
            segTemplate = SegmentTemplate(self.logger, self.new_segments, 
                                          options.master_data_directory, 
                                          self.dburl, False, tempDir)
            segTemplate.create_new_segments()

            self.logger.info('Copying new pg_hba.conf file to original segments')
            for seg in self.old_segments:
                if seg['contentId'] == -1:
                    continue
                cpCmd = RemoteCopy('gpexpand', tempDir + '/pg_hba.conf', seg['hostname'], 
                                   seg['dataDir'])
                pool.addCommand(cpCmd)
            pool.join()
        
            try:
                pool.check_results()
            except ExecutionError:
                raise ExpansionError, 'Failed to copy new pg_hba.conf file to original segments.'
            
            segTemplate.cleanup()
        except SegmentTemplateError, msg:
            # Expansion failed, but the array can still start up without the
            # new segments.
            raise ExpansionError, msg


        for seg in self.old_segments:
            startCmd = SegmentStart('gpexpand', seg['dataDir'], seg['port'], utilityMode=True,
                                    ctxt=REMOTE, remoteHost=seg['hostname'])
            pool.addCommand(startCmd)
            
        pool.join()
        try:
            pool.check_results()
        except ExecutionError:
            raise ExpansionError, 'Failed to start original segments in utility mode'
        
        # THIS IS THE POINT OF NO RETURN.  AFTER WE START CHANGING THE OLD SEGMENTS
        # THE ARRAY WILL ONLY START IF WE COMPLETE EVERYTHING SUCCESSFULLY
        # TODO: We need to be able to roll back on error beyond this point.
        
        # Update the number of segments in each QE's gp_id table
        query = 'UPDATE pg_catalog.gp_id SET numsegments=%d' % (len(self.new_segments) + len(self.old_segments) - 1)
        for seg in self.old_segments:
            dbUrl = dbconn.DbURL(hostname=seg['hostname'], port=seg['port'])
            conn = dbconn.connect(dbUrl, utility=True)
            dbconn.execSQL(conn, query)
            conn.commit()
            conn.close()
            
        # Update gp_configuration on the master
        self.conn = dbconn.connect(self.dburl, utility=True)
        for seg in self.new_segments:
            # TODO: mirrors.  Right now sets everything primary.
            query = 'INSERT INTO pg_catalog.gp_configuration(content, definedprimary, dbid, isprimary, valid, hostname, port, datadir) VALUES (%d, \'t\', %d, \'t\', \'t\', \'%s\', %d, \'%s\')' % (seg['contentId'], seg['dbId'], seg['hostname'], seg['port'], seg['dataDir'])
            dbconn.execSQL(self.conn, query)
            
        self.conn.commit()
        self.conn.close()
        
        # Stop all the segments, we are ready to start up in normal mode
        for seg in self.old_segments:
            stopCmd = SegmentStop('gpexpand', seg['dataDir'], ctxt=REMOTE, remoteHost=seg['hostname'])
            pool.addCommand(stopCmd)
            
        pool.join()
        try:
            pool.check_results()
        except ExecutionError:
            # We had some problems stopping the segments.  We should be able to start up
            # properly if they are shut down.  All the catalog updates were successful 
            # by this point.  For now, throw the exception.
            # TODO: what do we do on failure here?
            raise ExpansionError, 'Failed to stop original segments'
        
        pool.haltWork()
        
        rv = os.system('gpstart -a')
        if rv != 0:
            raise ExpansionError, 'Failed to restart the array'
        
        # Need to restore the connection used by the expansion
        self.conn = dbconn.connect(self.dburl)
        
    
    def setup_schema(self):
        """Used to setup the gpexpand schema"""
        
        #TODO: make sure this is all in a single txn
        dbconn.execSQL(self.conn,create_schema_sql)
        dbconn.execSQL(self.conn,status_table_sql)
        dbconn.execSQL(self.conn,status_detail_table_sql)
        
        nowStr = datetime.datetime.now()
        statusSQL = "INSERT INTO %s.%s VALUES ( 'SETUP', '%s' ) " % (gpexpand_schema,status_table,nowStr)
        
        dbconn.execSQL(self.conn,statusSQL)
        
        db_list = catalog.getDatabaseList(self.conn)
        
        for db in db_list:
            dbname=db[0]
            if dbname == 'template0':
                continue
            c = self.connect_database(dbname)
          
            sql="""SELECT 
                      n.nspname || '.' || c.relname as fq_name,
                      n.oid as schemaoid,
                      c.oid as tableoid,                      
                      p.attrnums as distribution_policy,
                      now() as last_updated                       
                   FROM       pg_class c
                         JOIN pg_namespace n ON (c.relnamespace=n.oid)
                         JOIN pg_catalog.gp_distribution_policy p on (c.oid = p.localoid)
            
                  """ 
            self.logger.info(sql)
            curs = dbconn.execSQL(c,sql)
            rows = curs.fetchall()            
            for row in rows:
                fqname=row[0]
                schema_oid=row[1]
                table_oid=row[2]             
                logger.warning("dist policy raw: %s " % row[3])   
                dist_policy = row[3]
                dist_policy_name = self.form_dist_policy_name(c,row[3],table_oid)
                ts = datetime.datetime.now()
                
                logger.info("dist_policy: %s" % dist_policy)
                logger.info("dist_policy_name: %s" % dist_policy_name)
                
                if dist_policy is None:
                    dist_policy = 'NULL'
                else:
                    dist_policy = "'" + dist_policy + "'"
                
                insertSQL = """INSERT INTO %s.%s 
                                    VALUES ('%s','%s',%s,%s,
                                            %s,'%s' , %d, '%s', NULL, NULL, %d)                
                            """ % (gpexpand_schema,status_detail_table,
                                   dbname,fqname,schema_oid,table_oid, 
                                   dist_policy,dist_policy_name, 1, 'NOT STARTED', 
                                   1234 )
                            
                self.logger.info(insertSQL)
                dbconn.execSQL(self.conn,insertSQL)
            
            #null out distrib policies
            #TODO:  badness... we aren't quite transactional anymore. 
            sql = """UPDATE pg_catalog.gp_distribution_policy SET attrnums = NULL"""
            self.logger.debug(sql)
            dbconn.execSQL(c,sql)
            c.commit()
            c.close()
             
        self.conn.commit()
        return SETUP
    
    
    def form_dist_policy_name(self,conn,rs_val,table_oid):        
        if rs_val is None:
            return ""
        rs_val=rs_val.lstrip('{').rstrip('}').strip()
        
        dict={}
        sql = "select attnum, attname from pg_attribute where attrelid =  %s and attnum > 0" % table_oid
        cursor = dbconn.execSQL(conn,sql)
        for row in cursor:            
            dict[row[0]] = row[1]
        
        list=[]
        
        if rs_val != "":
            rs_list=rs_val.split(',')            

            for colnum in rs_list:                
                list.append(dict[int(colnum)])
        
        return ' , '.join(list)
        
        
        
        
        
        
        
                        
    def perform_expansion(self):
        """Performs the actual table re-organiations"""
        
        #setup a threadpool
        self.queue=WorkerPool(numWorkers=self.numworkers)
        
        #read schema and queue up commands
        sql="SELECT * FROM %s.%s ORDER BY rank" % (gpexpand_schema,status_detail_table)
        cursor = dbconn.execSQL(self.conn,sql)
        
        for row in cursor:
            self.logger.info(row)
            name = "name"            
            tbl = ExpandTable(row)            
            cmd = ExpandCommand(name,self.dburl,tbl)
            self.queue.addCommand(cmd)
         
        #wait till done.
        while not self.queue.isDone():
            logger.info("woke up.  queue: %d finished %d  " % (self.queue.num_assigned,self.queue.completed_queue.qsize()))            
            time.sleep(5)
            
        logger.info("EXPANSION COMPLETE")
        self.queue.haltWork()    
        
    
    
    def cleanup_schema(self):
        """Removes the gpexpand schema"""
        
        #we should have an option to dump the contents out to a backup before we
        # blow things away.
        
        #drop schema
        self.logger.info("Removing gpexpand schema")
        dbconn.execSQL(self.conn,drop_schema_sql) 
        self.conn.commit()
        pass

    
    def connect_database(self,dbname):
        test_url = copy.deepcopy(self.dburl)
        test_url.pgdb = dbname
        c = dbconn.connect(test_url)
        return c


undone_status = "NOT STARTED"
start_status = "IN PROGRESS"
done_statue = "COMPLETED"

#-----------------------------------------------
class ExpandTable():
    
    def __init__(self,row=None):
        if row is not None:
            self.dbname=row[0]
            self.fq_name=row[1]
            self.schema_oid=row[2]
            self.table_oid=row[3]
            self.distrib_policy=row[4]
            self.distrib_policy_names=row[5]
            self.rank=row[6]
            self.status=row[7]
            self.expansion_started=row[8]
            self.expansion_finished=row[9]
            self.source_bytes=row[10]
    
    
    def add_table(self,conn):
        insertSQL = """INSERT INTO %s.%s 
                            VALUES ('%s','%s',%s,%s,
                                    '%s','%s',%d,'%s','%s','%s',%d)                
                    """ % (gpexpand_schema,status_detail_table,
                           self.dbname,self.fq_name,self.schema_oid,self.table_oid, 
                           self.dist_policy,self.dist_policy_names,self.rank,
                           self.status,
                           self.expansion_started,self.expansion_finished,
                           self.source_bytes )
        logger.info(insertSQL)
        dbconn.execSQL(conn,insertSQL)
               
               
               
    def mark_started(self,status_conn,table_conn):
        
        sql = "SELECT pg_relation_size('%s')" % self.fq_name         
        cursor = dbconn.execSQL(table_conn,sql)
        row = cursor.fetchone()
        src_bytes = int(row[0])
        logger.info(" Table: %s has %d bytes" % (self.fq_name, src_bytes))
         

        
        time_str = datetime.datetime.now()       
        sql = """UPDATE %s.%s 
                  SET status = '%s', expansion_started='%s',
                      source_bytes = %d
                  WHERE dbname = '%s' AND schema_oid = %s 
                        AND table_oid = %s """ % (gpexpand_schema,status_detail_table,
                  start_status,time_str,
                  src_bytes, self.dbname,
                  self.schema_oid,self.table_oid) 
         

        logger.info("Mark Started: " + sql)
        dbconn.execSQL(status_conn,sql) 
        status_conn.commit()
        
        
    def expand(self,table_conn):
        foo = self.distrib_policy_names.strip()
        logger.info("foo '%s'" % foo)
        if foo == "":
            sql = "ALTER TABLE %s SET DISTRIBUTED RANDOMLY" % (self.fq_name)
            logger.warning("FOR NOW WE CANT SUPPORT THESE")
            return
        else:
            sql = " ALTER TABLE %s SET DISTRIBUTED BY (%s) " % (self.fq_name,foo.lstrip())
        logger.info("Expand SQL: %s" % sql)    
        dbconn.execSQL(table_conn,sql)
        table_conn.commit()
    
    
    def mark_finished(self,status_conn,table_conn,finish_time):
        sql = """UPDATE %s.%s
                  SET status = '%s', expansion_finished='%s'
                  WHERE dbname = '%s' AND schema_oid = %s 
                  AND table_oid = %s """ % (gpexpand_schema,status_detail_table,
                                            done_statue,finish_time,
                                            self.dbname,self.schema_oid,self.table_oid) 
        logger.info(sql)
        dbconn.execSQL(status_conn,sql)
        status_conn.commit()
        
                
#-----------------------------------------------
class ExpandCommand(SQLCommand):
    
    def __init__(self,name,status_url,table):        
        self.status_url=status_url
        self.table=table
        self.cmdStr="Expand %s.%s" % (table.dbname,table.fq_name)
        self.table_url = copy.deepcopy(status_url)
        self.table_url.pgdb = table.dbname
        
        SQLCommand.__init__(self,name)        
        pass        
    
     
    def run(self,validateAfter=False):
        #connect.
        status_conn=dbconn.connect(self.status_url)
        table_conn=dbconn.connect(self.table_url)        
        
        #mark start of expansion
        logger.info("Starting Expansion")
        self.table.mark_started(status_conn,table_conn)
        
        #expand
        logger.info("Expanding...")
        self.table.expand(table_conn)
        end_time = datetime.datetime.now()
        
        
        #update metadata        
        logger.info("Finished Expanding...updating metadata")
        self.table.mark_finished(status_conn,table_conn,end_time)
        
        #disconnect
        status_conn.close()
        table_conn.close()
        
        
    
    def set_results(self,results):
        raise ExecutionError("TODO:  must implement")
    
    def get_results(self):
        raise ExecutionError("TODO:  must implement")
    
    def cancel(self):
        raise ExecutionError("TODO:  must implement")
    
    def was_successful(self):
        raise ExecutionError("TODO:  must implement")
    
    def validate(self):
        raise ExecutionError("TODO:  must implement")        
        
        
        
#------------------------------- Mainline --------------------------------

try:
    logger = get_default_logger()
    setup_tool_logging(EXECNAME,getLocalHostname(),getUserName())

    
    
    options, args = parseargs()
    
    if options.verbose:
        enable_verbose_logging()
    
    if options.quiet:
        quiet_stdout_logging()
    
    
    dburl = dbconn.DbURL() 
    gp_expand = gpexpand(logger,dburl,parallel=options.parallel)   
    
    if options.clean:
        gp_expand.cleanup_schema()
        logger.info('Cleanup Finished.  exiting...')
        sys.exit(0)
        
    state = gp_expand.gather_state()
    
    if state == UNINITIALIZED:
        state = gp_expand.setup_schema()
        gp_expand.read_input_file()
        gp_expand.add_segments()
        # We should probably stop here and give the user a chance
        # to modify tables in the gpexpand schema
        logger.info('Initialization of the system expansion complete.')
        logger.info('To begin table expansion onto the new segments')
        logger.info('rerun gpexpand')
        sys.exit(0)
        
    if state == SETUP:
        gp_expand.perform_expansion()
    
    
except Exception, e:
    logger.exception("gpexpand failed. exiting...")
    sys.exit(3)
except KeyboardInterrupt:
    sys.exit('\nUser Interrupted')
