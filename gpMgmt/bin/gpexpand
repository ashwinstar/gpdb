import copy
import datetime
import os
import sys

from optparse import Option, OptionGroup, OptionParser, OptionValueError, SUPPRESS_USAGE

from gppylib.commands.unix import *
from gppylib.gpparseopts import OptParser, OptChecker
from gppylib.gplog import *
from gppylib.db import dbconn
from gppylib.db import catalog

description = (""" 
Adds additional segments to a pre-existing GPDB Array.
""")

_help = ["""
TODO: add txt for gpexpand!
"""]

EXECNAME = os.path.split(__file__)[-1]



#----------------------- Command line option parser ----------------------

def parseargs():
    parser = OptParser(option_class=OptChecker,
                description=' '.join(description.split()),
                version='%prog version $Revision: #12 $')
    parser.setHelp(_help)
    parser.set_usage('%prog [--help] [options] ')
    parser.remove_option('-h')
    
    parser.add_option('-c','--clean', action='store_true',
                        help='remove the expansion schema.')                        
    parser.add_option('-d','--duration', type='duration', metavar='[h][:m[:s]]',
                      help='duration from beginning to end')
    parser.add_option('-e','--end', type='datetime', metavar='datetime',
                       help="ending date and time")
    parser.add_option('-h', '-?', '--help', action='help',
                        help='show this help message and exit')
    parser.add_option('-i','--input', dest="filename",
                        help="input expansion configuration file", metavar="FILE")        
    parser.add_option('-q', '--quiet', action='store_true',
                        help='suppress status messages')
    parser.add_option('-n', '--parallel', type="int", default=1, metavar="<parallel_processes>",
                        help='number of tables to expand at a time. Valid values are 1-127')
    parser.add_option('-v','--verbose', action='store_true',
                        help='debug output.')
    
    
        
    parser.set_defaults(verbose=True, filters=[], slice=(None, None))
    
    
    # Parse the command line arguments
    (options, args) = parser.parse_args()
    
    #-n sanity check
    if options.parallel > 128 or options.parallel < 1:
        parser.print_help()
        parser.exit()
        
        
    return options, args


#states
UNINITIALIZED,SETUP,INPROGRESS,FINISHED=range(4)

#expansion schema
gpexpand_schema='gpexpand'
create_schema_sql = "CREATE SCHEMA " + gpexpand_schema 
drop_schema_sql = "drop schema %s cascade" % gpexpand_schema

status_table='status'
status_table_sql="""CREATE TABLE %s.%s
                        ( status text,
                          updated timestamp ) """ % (gpexpand_schema,status_table)

status_detail_table='status_detail'
status_detail_table_sql="""CREATE TABLE %s.%s
                        ( dbname text,
                          fq_name text,
                          schema_oid oid,
                          table_oid oid,
                          distribution_policy smallint[],
                          distribution_policy_names varchar,
                          rank int,
                          status text,
                          expansion_started timestamp,
                          expansion_finished timestamp,
                          source_bytes int ) """ % (gpexpand_schema, status_detail_table)


class ExpansionError(Exception): pass

class gpexpand:
    
    def __init__(self,logger,dburl,parallel=1):
        self.logger = logger
        self.dburl = dburl
        self.numworkers=parallel
         
        self.conn = dbconn.connect(self.dburl)
        pass
    
    
    def gather_state(self):
        """Used to probe the system to determine which stage of expansion we are in. 
        
        get a list of databases for us to check.  There should only exist a single gpexpand
        schema amongst any of them.  more than one is an error. zero means we haven't started yet.
        
        """         
        db_list = catalog.getDatabaseList(self.conn)
        test_url = copy.deepcopy(self.dburl)
        expand_dbs=[]
        for db in db_list:
            dbname = db[0]
            if dbname == 'template0':
                continue
            self.logger.debug("Probing database: '%s'" % dbname)
            test_url.pgdb = dbname
            c = dbconn.connect(test_url)
            if catalog.doesSchemaExist(c,gpexpand_schema):
                expand_dbs.append(db)
            c.close()    
        
        if len(expand_dbs) == 0:
            self.logger.debug("Could not find an expansion schema '%s' in this array.  State = UNINITIALIZED" \
                               % gpexpand_schema )
            return UNINITIALIZED
        elif len(expand_dbs) == 1:
            self.logger.debug("Found an expansion schema '%s' present in database %s" % (gpexpand_schema,expand_dbs[0]))                
        else:
            str="Found more than one expansion schema '%s' present in this array"\
                " in the following databases: %s " % (gpexpand_schema,expand_dbs)
            self.logger.error(str)
            raise ExpansionError(str)
        
        #read in the global status table        
        #raise ExpansionError("TODO:  need to impl")
        
        #read in table entries
        return SETUP
    
    
    def add_segments(self):
        """Adds a specified set of empty segments to the system"""
        pass
    
    
    def setup_schema(self):
        """Used to setup the gpexpand schema"""
        
        #TODO: make sure this is all in a single txn
        dbconn.execSQL(self.conn,create_schema_sql)
        dbconn.execSQL(self.conn,status_table_sql)
        dbconn.execSQL(self.conn,status_detail_table_sql)
        
        nowStr = datetime.datetime.now()
        statusSQL = "INSERT INTO %s.%s VALUES ( 'SETUP', '%s' ) " % (gpexpand_schema,status_table,nowStr)
        
        dbconn.execSQL(self.conn,statusSQL)
        
        db_list = catalog.getDatabaseList(self.conn)
        
        for db in db_list:
            dbname=db[0]
            if dbname == 'template0':
                continue
            c = self.connect_database(dbname)
          
            sql="""SELECT 
                      n.nspname || '.' || c.relname as fq_name,
                      n.oid as schemaoid,
                      c.oid as tableoid,                      
                      p.attrnums as distribution_policy,
                      now() as last_updated                       
                   FROM       pg_class c
                         JOIN pg_namespace n ON (c.relnamespace=n.oid)
                         JOIN pg_catalog.gp_distribution_policy p on (c.oid = p.localoid)
            
                  """ 
            self.logger.info(sql)
            curs = dbconn.execSQL(c,sql)
            rows = curs.fetchall()            
            for row in rows:
                fqname=row[0]
                schema_oid=row[1]
                table_oid=row[2]             
                logger.warning("dist policy raw: %s " % row[3])   
                dist_policy = row[3]
                dist_policy_name = self.form_dist_policy_name(c,row[3],table_oid)
                ts = datetime.datetime.now()
                
                logger.info("dist_policy: %s" % dist_policy)
                logger.info("dist_policy_name: %s" % dist_policy_name)
                
                if dist_policy is None:
                    dist_policy = 'NULL'
                else:
                    dist_policy = "'" + dist_policy + "'"
                
                insertSQL = """INSERT INTO %s.%s 
                                    VALUES ('%s','%s',%s,%s,
                                            %s,'%s' , %d, '%s', NULL, NULL, %d)                
                            """ % (gpexpand_schema,status_detail_table,
                                   dbname,fqname,schema_oid,table_oid, 
                                   dist_policy,dist_policy_name, 1, 'NOT STARTED', 
                                   1234 )
                            
                self.logger.info(insertSQL)
                dbconn.execSQL(self.conn,insertSQL)
            
            #null out distrib policies
            #TODO:  badness... we aren't quite transactional anymore. 
            sql = """UPDATE pg_catalog.gp_distribution_policy SET attrnums = NULL"""
            self.logger.debug(sql)
            dbconn.execSQL(c,sql)
            c.commit()
            c.close()
             
        self.conn.commit()
        return SETUP
    
    
    def form_dist_policy_name(self,conn,rs_val,table_oid):        
        if rs_val is None:
            return ""
        rs_val=rs_val.lstrip('{').rstrip('}').strip()
        
        dict={}
        sql = "select attnum, attname from pg_attribute where attrelid =  %s and attnum > 0" % table_oid
        cursor = dbconn.execSQL(conn,sql)
        for row in cursor:            
            dict[row[0]] = row[1]
        
        list=[]
        
        if rs_val != "":
            rs_list=rs_val.split(',')            

            for colnum in rs_list:                
                list.append(dict[int(colnum)])
        
        return ' , '.join(list)
        
        
        
        
        
        
        
                        
    def perform_expansion(self):
        """Performs the actual table re-organiations"""
        
        #setup a threadpool
        self.queue=WorkerPool(numWorkers=self.numworkers)
        
        #read schema and queue up commands
        sql="SELECT * FROM %s.%s ORDER BY rank" % (gpexpand_schema,status_detail_table)
        cursor = dbconn.execSQL(self.conn,sql)
        
        for row in cursor:
            self.logger.info(row)
            name = "name"            
            tbl = ExpandTable(row)            
            cmd = ExpandCommand(name,self.dburl,tbl)
            self.queue.addCommand(cmd)
            
        #wait till done.
        while not self.queue.isDone():
            logger.info("woke up.  queue: %d finished %d  " % (self.queue.num_assigned,self.queue.completed_queue.qsize()))            
            time.sleep(5)
            
        logger.info("EXPANSION COMPLETE")
        self.queue.haltWork()    
        
    
    
    def cleanup_schema(self):
        """Removes the gpexpand schema"""
        
        #we should have an option to dump the contents out to a backup before we
        # blow things away.
        
        #drop schema
        self.logger.info("Removing gpexpand schema")
        dbconn.execSQL(self.conn,drop_schema_sql) 
        self.conn.commit()
        pass

    
    def connect_database(self,dbname):
        test_url = copy.deepcopy(self.dburl)
        test_url.pgdb = dbname
        c = dbconn.connect(test_url)
        return c


undone_status = "NOT STARTED"
start_status = "IN PROGRESS"
done_statue = "COMPLETED"

#-----------------------------------------------
class ExpandTable():
    
    def __init__(self,row=None):
        if row is not None:
            self.dbname=row[0]
            self.fq_name=row[1]
            self.schema_oid=row[2]
            self.table_oid=row[3]
            self.distrib_policy=row[4]
            self.distrib_policy_names=row[5]
            self.rank=row[6]
            self.status=row[7]
            self.expansion_started=row[8]
            self.expansion_finished=row[9]
            self.source_bytes=row[10]
    
    
    def add_table(self,conn):
        insertSQL = """INSERT INTO %s.%s 
                            VALUES ('%s','%s',%s,%s,
                                    '%s','%s',%d,'%s','%s','%s',%d)                
                    """ % (gpexpand_schema,status_detail_table,
                           self.dbname,self.fq_name,self.schema_oid,self.table_oid, 
                           self.dist_policy,self.dist_policy_names,self.rank,
                           self.status,
                           self.expansion_started,self.expansion_finished,
                           self.source_bytes )
        logger.info(insertSQL)
        dbconn.execSQL(conn,insertSQL)
               
               
               
    def mark_started(self,status_conn,table_conn):
        
        sql = "SELECT pg_relation_size('%s')" % self.fq_name         
        cursor = dbconn.execSQL(table_conn,sql)
        row = cursor.fetchone()
        src_bytes = int(row[0])
        logger.info(" Table: %s has %d bytes" % (self.fq_name, src_bytes))
         

        
        time_str = datetime.datetime.now()       
        sql = """UPDATE %s.%s 
                  SET status = '%s', expansion_started='%s',
                      source_bytes = %d
                  WHERE dbname = '%s' AND schema_oid = %s 
                        AND table_oid = %s """ % (gpexpand_schema,status_detail_table,
                  start_status,time_str,
                  src_bytes, self.dbname,
                  self.schema_oid,self.table_oid) 
         

        logger.info("Mark Started: " + sql)
        dbconn.execSQL(status_conn,sql) 
        status_conn.commit()
        
        
    def expand(self,table_conn):
        foo = self.distrib_policy_names.strip()
        logger.info("foo '%s'" % foo)
        if foo == "":
            sql = "ALTER TABLE %s SET DISTRIBUTED RANDOMLY" % (self.fq_name)
            logger.warning("FOR NOW WE CANT SUPPORT THESE")
            return
        else:
            sql = " ALTER TABLE %s SET DISTRIBUTED BY (%s) " % (self.fq_name,foo.lstrip())
        logger.info("Expand SQL: %s" % sql)    
        dbconn.execSQL(table_conn,sql)
    
    
    def mark_finished(self,status_conn,table_conn,finish_time):
        sql = """UPDATE %s.%s
                  SET status = '%s', expansion_finished='%s'
                  WHERE dbname = '%s' AND schema_oid = %s 
                  AND table_oid = %s """ % (gpexpand_schema,status_detail_table,
                                            done_statue,finish_time,
                                            self.dbname,self.schema_oid,self.table_oid) 
        logger.info(sql)
        dbconn.execSQL(status_conn,sql)
        status_conn.commit()
        
                
#-----------------------------------------------
class ExpandCommand(SQLCommand):
    
    def __init__(self,name,status_url,table):        
        self.status_url=status_url
        self.table=table
        self.cmdStr="Expand %s.%s" % (table.dbname,table.fq_name)
        self.table_url = copy.deepcopy(status_url)
        self.table_url.pgdb = table.dbname
        
        SQLCommand.__init__(self,name)        
        pass        
    
     
    def run(self,validateAfter=False):
        #connect.
        status_conn=dbconn.connect(self.status_url)
        table_conn=dbconn.connect(self.table_url)        
        
        #mark start of expansion
        logger.info("Starting Expansion")
        self.table.mark_started(status_conn,table_conn)
        
        #expand
        logger.info("Expanding...")
        self.table.expand(table_conn)
        end_time = datetime.datetime.now()
        
        
        #update metadata        
        logger.info("Finished Expanding...updating metadata")
        self.table.mark_finished(status_conn,table_conn,end_time)
        
        #disconnect
        status_conn.close()
        table_conn.close()
        
        
    
    def set_results(self,results):
        raise ExecutionError("TODO:  must implement")
    
    def get_results(self):
        raise ExecutionError("TODO:  must implement")
    
    def cancel(self):
        raise ExecutionError("TODO:  must implement")
    
    def was_successful(self):
        raise ExecutionError("TODO:  must implement")
    
    def validate(self):
        raise ExecutionError("TODO:  must implement")        
        
        
        
#------------------------------- Mainline --------------------------------

try:
    logger = get_default_logger()
    setup_tool_logging(EXECNAME,getLocalHostname(),getUserName())

    
    
    options, args = parseargs()
    
    if options.verbose:
        enable_verbose_logging()
    
    if options.quiet:
        quiet_stdout_logging()
    
    
    dburl = dbconn.DbURL() 
    gp_expand = gpexpand(logger,dburl,parallel=options.parallel)   
    
    if options.clean:
        gp_expand.cleanup_schema()
        logger.info('Cleanup Finished.  exiting...')
        sys.exit(0)
        
    state = gp_expand.gather_state()
    
    if state == UNINITIALIZED:
        state = gp_expand.setup_schema()
        
    if state == SETUP:
        gp_expand.perform_expansion()
    
    
except Exception, e:
    logger.exception("gpexpand failed. exiting...")
    sys.exit(3)
except KeyboardInterrupt:
    sys.exit('\nUser Interrupted')