    def generate_inputfile(self,hostlist,primary_list,primary_portbase,mirror_type,mirror_list,mirror_portbase):
        """        
        File format is:
        dbid:content:definedprimary:hostname:port:datadir
        
        """
        maxDbId = self.gparray.get_max_dbid()        
        oldSegCount = self.gparray.get_segment_count()
        outputfile = 'gpexpand_inputfile_' + strftime("%Y%m%d_%H%M%S")
        outfile = open(outputfile, 'w')
        
        logger.info("Generating input file...")
        rows=createSegmentRows(hostlist,primary_list,primary_portbase,mirror_type,mirror_list,mirror_portbase)
        
        
        for r in rows:              
            (content,defprim,dbid,isprim,valid,hostname,port,datadir)=r
            new_dbid = maxDbId + dbid
            new_content = oldSegCount + content
            outfile.write("%d:%d:%s:%s:%d:%s\n" % (new_dbid,new_content,isprim,hostname,port,datadir) )           
        
        
        outfile.close()
        
        return outputfile

    def read_input_file(self):
        if not options.filename:
            raise ExpansionError('Missing input file')
        
        self.new_segments = []
        
        try:
            f = open(options.filename, 'r')
            line = 1
            try:
                while 1:
                    l = f.readline()
                    if not l:
                        break                    
                    dbid,contentId,definedprimary,hostname,port,datadir = l.split(':')
                    
                    seg = dict(zip(['dbid','contentId','definedprimary','hostname', 'port', 'dataDir'], 
                                   [int(dbid),int(contentId),definedprimary,hostname, int(port), datadir.strip()]))
                    self.new_segments.append(seg)
                    line += 1
            except ValueError:
                raise ExpansionError('Invalid input file on line %d' % line)
            finally:
                f.close()
        except IOError:
            raise ExpansionError('Input file %s not found' % options.filename)
        
        
    def add_segments(self):
        # Check if we are beyond this point
        if self.statusLogger.get_current_status()[0] not in ['SETUP_EXPANSION_SCHEMA_DONE',
                                                             'BUILD_SEGMENT_TEMPLATE_STARTED',
                                                             'BUILD_SEGMENT_TEMPLATE_DONE',
                                                             'BUILD_SEGMENTS_STARTED']:
            return
        
        self.old_segments = []
        
        # We need to get the current segment information before we start shutting
        # down the array. 
        rows = dbconn.execSQL(self.conn, 'SELECT dbid,content,definedprimary,valid,hostname,port, datadir FROM pg_catalog.gp_configuration')
        for row in rows:
            seg = dict(zip(['dbId','contentId','definedprimary', 'valid', 'hostname', 'port', 'dataDir'],row))            
            seg['port'] = int(seg['port'])
            seg['contentId'] = int(seg['contentId'])
            if seg['definedprimary']:
                seg['definedprimary'] = 't'
            else:
                seg['definedprimary'] = 'f'
            if seg['valid']:
                seg['valid'] = 't'
            else:
                seg['valid'] = 'f'
            self.old_segments.append(seg)
        
        self.conn.commit()
        self.conn.close()
        
        # Create, distribute and configure the new segments.
        self.segTemplate = SegmentTemplate(self.logger, self.statusLogger, self.pool,
                                           self.gparray, self.new_segments, 
                                           options.master_data_directory, 
                                           self.dburl, options.novacuum, self.tempDir)
        try:
            self.segTemplate.build_segment_template()
        except SegmentTemplateError, msg:
            self.segTemplate.cleanup_build_segment_template(self.statusLogger.get_current_status()[1])
            raise ExpansionError(msg)
            
        try:
            self.segTemplate.build_new_segments()
        except SegmentTemplateError, msg:
            self.segTemplate.cleanup_build_new_segments(self.statusLogger.get_current_status()[1], True)
            raise ExpansionError(msg)

        
        
    def update_original_segments(self):
        status = self.statusLogger.get_current_status()
        if status[0] == 'UPDATE_OLD_SEGMENTS_STARTED':
#            self.logger.info('Cleaning up last segment build attempt')
            pass
        elif status[0] != 'BUILD_SEGMENTS_DONE':
            self.logger.debug('Current status is past UPDATE_OLD_SEGMENTS_DONE')
            return
        else:
            self.statusLogger.set_status('UPDATE_OLD_SEGMENTS_STARTED')

        self.logger.info('Backing up pg_hba.conf file on original segments')
        for seg in self.old_segments:
            if seg['contentId'] == -1 or seg['valid'] == 'f':
                continue
            cpCmd = RemoteCopy('Back up pg_hba.conf file on original segments', seg['dataDir'] + '/pg_hba.conf', seg['hostname'], 
                                seg['dataDir'] + '/pg_hba.gpexpand.bak', ctxt=REMOTE, remoteHost=seg['hostname'])
            self.pool.addCommand(cpCmd)
        
        self.pool.join()
        try:
            self.pool.check_results()
        except Exception:
            self.restore_original_segments()
            raise ExpansionError('Failed to configure original segments')
            

        self.logger.info('Copying new pg_hba.conf file to original segments')
        for seg in self.old_segments:
            if seg['contentId'] == -1:
                continue
            cpCmd = RemoteCopy('copy new pg_hba.conf file to original segments', 
                               self.tempDir + '/pg_hba.conf', seg['hostname'], 
                               seg['dataDir'])
            self.pool.addCommand(cpCmd)
            
        self.pool.join()
        
        try:
            self.pool.check_results()
        except Exception:
            self.restore_original_segments()
            raise ExpansionError('Failed to configure original segments')

        self.newPrimaryCount = 0;
        for seg in self.new_segments:
            if seg['definedprimary'] == 't' and seg['contentId'] != -1: 
                self.newPrimaryCount += 1
        self.newPrimaryCount += self.gparray.get_primary_count()

        self.logger.info('Configuring original segments')
        for seg in self.old_segments:
            if seg['contentId'] != -1:
                segCfgCmd = ConfigExpansionSeg('configure original segment', seg['dataDir'], 
                                               seg['port'], self.newPrimaryCount, 
                                               seg['contentId'], seg['dbId'],
                                               ctxt=REMOTE, remoteHost=seg['hostname']) 
                self.pool.addCommand(segCfgCmd)
            
        self.pool.join()

        try:
            self.pool.check_results()
        except Exeception:
            self.restore_original_segments()
            raise ExpansionError('Failed to configure original segments')   
        
        self.segTemplate.cleanup()

        self.statusLogger.set_status('UPDATE_OLD_SEGMENTS_DONE')
            

    def restore_original_segments(self):
        self.logger.info('Restoring pg_hba.conf file on original segments')
        for seg in self.old_segments:
            if seg['contentId'] == -1:
                continue
            cpCmd = RemoteCopy('Restore of pg_hba.conf file on original segments', seg['dataDir'] + '/pg_hba.gpexpand.bak', seg['hostname'], 
                                seg['dataDir'] + '/pg_hba.conf', ctxt=REMOTE, remoteHost=seg['hostname'])
            self.pool.addCommand(cpCmd)
        
        self.pool.join()
        self.pool.check_results()

        originalPrimaryCount += self.gparray.get_primary_count()

        self.logger.info('Restoring original segment configurations')
        for seg in self.old_segments:
            if seg['contentId'] != -1:
                segCfgCmd = ConfigExpansionSeg('Restore original segment', seg['dataDir'], 
                                               seg['port'], originalPrimaryCount, 
                                               seg['contentId'], seg['dbId'],
                                               ctxt=REMOTE, remoteHost=seg['hostname']) 
                self.pool.addCommand(segCfgCmd)
            
        self.pool.join()
        
        try:
            self.pool.check_results()
        except ExecutionError:
            raise ExpansionError('Failed to restore original segments')   

    

    def update_master(self):
        status = self.statusLogger.get_current_status()
        if status[0] == 'UPDATE_OLD_SEGMENTS_DONE':
            self.statusLogger.set_status('UPDATE_MASTER_STARTED')
        elif status[0] != 'UPDATE_MASTER_STARTED':
            self.logger.debug('Current status is past UPDATE_MASTER_DONE')
            return
        # Update gp_configuration on the master
        self.logger.info('Starting master in utility mode')

        startCmd = GpStart('gpexpand', masterOnly=True)
        startCmd.run(validateAfter=True)
        
        self.conn = dbconn.connect(self.dburl, utility=True)
        for seg in self.new_segments:          
            query = "INSERT INTO pg_catalog.gp_configuration(content, definedprimary, dbid, isprimary, valid, hostname, port, datadir)"\
                        "VALUES (%d, \'%s\', %d, \'%s\', \'t\', \'%s\', %d, \'%s\')"\
                        % (seg['contentId'], seg['definedprimary'], seg['dbId'], seg['definedprimary'], 
                           seg['hostname'], seg['port'], seg['dataDir'])
                        
            dbconn.execSQL(self.conn, query)

        query = 'UPDATE pg_catalog.gp_id SET numsegments=%d' % (self.newPrimaryCount)
        dbconn.execSQL(self.conn, query)
        
        self.conn.commit()
        self.conn.close()
        
        stopCmd = GpStop('gpexpand', masterOnly=True)
        stopCmd.run(validateAfter=True)
        
        self.statusLogger.set_status('UPDATE_MASTER_DONE')
        
        startCmd = GpStart('gpexpand')
        startCmd.run(validateAfter=True)
        
        # Need to restore the connection used by the expansion
        self.conn = dbconn.connect(self.dburl)
        
    
    def setup_schema(self):
        """Used to setup the gpexpand schema"""
        status = self.statusLogger.get_current_status()
        if status[0] == 'SETUP_EXPANSION_SCHEMA_STARTED':
            # restoring
            pass
        elif status[0] != 'EXPANSION_PREPARE_STARTED':
            self.logger.debug('Current status is past EXPANSION_PREPARE_DONE')
            return
            
        self.logger.info('Creating expansion schema')
        self.statusLogger.set_status('SETUP_EXPANSION_SCHEMA_STARTED')
        #TODO: make sure this is all in a single txn
        dbconn.execSQL(self.conn,create_schema_sql)
        dbconn.execSQL(self.conn,status_table_sql)
        dbconn.execSQL(self.conn,status_detail_table_sql)
        self.conn.commit()
        
        self.statusLogger.set_status('SETUP_EXPANSION_SCHEMA_DONE')
        
    def prepare_schema(self):
        status = self.statusLogger.get_current_status()
        if status[0] != 'PREPARE_EXPANSION_SCHEMA_STARTED':
            self.logger.info('Populating expansion schema')
            self.statusLogger.set_status('PREPARE_EXPANSION_SCHEMA_STARTED')
        else:
            self.logger.debug('Current status is past PREPARE_EXPANSION_SCHEMA_DONE')
            return
        
        if not self.conn:
            self.conn = dbconn.connect(self.dburl)
            self.gparray = createGPDBFromDB(self.dburl)
        
        nowStr = datetime.datetime.now()
        statusSQL = "INSERT INTO %s.%s VALUES ( 'SETUP', '%s' ) " % (gpexpand_schema,status_table,nowStr)
        
        dbconn.execSQL(self.conn,statusSQL)
        
        db_list = catalog.getDatabaseList(self.conn)
        
        for db in db_list:
            dbname=db[0]
            if dbname == 'template0':
                continue
            c = self.connect_database(dbname)
          
            sql="""SELECT 
    n.nspname || '.' || c.relname as fq_name,
    n.oid as schemaoid,
    c.oid as tableoid,                      
    p.attrnums as distribution_policy,
    now() as last_updated,
    pg_relation_size(n.nspname || '.' || c.relname)
FROM 
            pg_class c
    JOIN pg_namespace n ON (c.relnamespace=n.oid)
    JOIN pg_catalog.gp_distribution_policy p on (c.oid = p.localoid);

                  """ 
            self.logger.info(sql)
            curs = dbconn.execSQL(c,sql)
            rows = curs.fetchall()            
            for row in rows:
                fqname=row[0]
                schema_oid=row[1]
                table_oid=row[2]             
                logger.warning("dist policy raw: %s " % row[3])   
                dist_policy = row[3]
                dist_policy_name = self.form_dist_policy_name(c,row[3],table_oid)
                ts = datetime.datetime.now()
                rel_bytes = row[5]
                
                if dist_policy is None:
                    dist_policy = 'NULL'
                else:
                    dist_policy = "'" + dist_policy + "'"
                
                insertSQL = """INSERT INTO %s.%s 
                                    VALUES ('%s','%s',%s,%s,
                                            %s,'%s' , %d, '%s', NULL, NULL, %d)                
                            """ % (gpexpand_schema,status_detail_table,
                                   dbname,fqname,schema_oid,table_oid, 
                                   dist_policy,dist_policy_name, 1, 'NOT STARTED', 
                                   rel_bytes )
                            
                self.logger.info(insertSQL)
                dbconn.execSQL(self.conn,insertSQL)
            
            #null out distrib policies
            #TODO:  badness... we aren't quite transactional anymore. 
            sql = """UPDATE pg_catalog.gp_distribution_policy SET attrnums = NULL"""
            self.logger.debug(sql)
            dbconn.execSQL(c,sql)
            c.commit()
            c.close()
             
        self.conn.commit()
        
        self.statusLogger.set_status('PREPARE_EXPANSION_SCHEMA_DONE')
        
        return SETUP
    
    
    def form_dist_policy_name(self,conn,rs_val,table_oid):        
        if rs_val is None:
            return ""
        rs_val=rs_val.lstrip('{').rstrip('}').strip()
        
        dict={}
        sql = "select attnum, attname from pg_attribute where attrelid =  %s and attnum > 0" % table_oid
        cursor = dbconn.execSQL(conn,sql)
        for row in cursor:            
            dict[row[0]] = row[1]
        
        list=[]
        
        if rs_val != "":
            rs_list=rs_val.split(',')            

            for colnum in rs_list:                
                list.append(dict[int(colnum)])
        
        return ' , '.join(list)
        
        
        
        
        
        
        
                        
    def perform_expansion(self):
        """Performs the actual table re-organiations"""
        
        expansionStart = datetime.datetime.now()
        
        #setup a threadpool
        self.queue=WorkerPool(numWorkers=self.numworkers)
        
        #read schema and queue up commands
        sql="SELECT * FROM %s.%s WHERE status = 'NOT STARTED' ORDER BY rank" % (gpexpand_schema,status_detail_table)
        cursor = dbconn.execSQL(self.conn,sql)
        
        for row in cursor:
            self.logger.info(row)
            name = "name"            
            tbl = ExpandTable(row)            
            cmd = ExpandCommand(name,self.dburl,tbl)
            self.queue.addCommand(cmd)
        
        self.conn.close()
        
        stopTime = None
        stoppedEarly = False
        if options.end:
            stopTime = options.end
        elif options.duration:
            stopTime = expansionStart + options.duration
        
        #wait till done.
        while not self.queue.isDone():
            logger.debug("woke up.  queue: %d finished %d  " % (self.queue.num_assigned,self.queue.completed_queue.qsize()))            
            time.sleep(5)
            if stopTime and datetime.datetime.now() >= stopTime:
                stoppedEarly = True
                break

        if stoppedEarly:
            logger.info('End time reached.  Stopping expansion.')
        else:
            logger.info("EXPANSION COMPLETE")

        self.queue.haltWork()                
        self.pool.haltWork()
    
    def cleanup(self):
        """used if the script is closed abrubtly"""
        if self.queue is not None:
            self.queue.haltWork()
        if self.conn is not None:
            self.conn.close()    
        if self.pool:
            self.pool.haltWork()      
    
    
    def cleanup_schema(self):
        """Removes the gpexpand schema"""
        
        #we should have an option to dump the contents out to a backup before we
        # blow things away.
        
        #drop schema
        self.logger.info("Removing gpexpand schema")
        dbconn.execSQL(self.conn,drop_schema_sql) 
        self.conn.commit()
        pass

    
    def connect_database(self,dbname):
        test_url = copy.deepcopy(self.dburl)
        test_url.pgdb = dbname
        c = dbconn.connect(test_url)
        return c


undone_status = "NOT STARTED"
start_status = "IN PROGRESS"
done_statue = "COMPLETED"

#-----------------------------------------------
class ExpandTable():
    
    def __init__(self,row=None):
        if row is not None:
            (self.dbname,self.fq_name,self.schema_oid,self.table_oid,
             self.distrib_policy,self.distrib_policy_names,self.rank,
             self.status,self.expansion_started,
             self.expansion_finished,self.source_bytes) = row
    
    
    def add_table(self,conn):
        insertSQL = """INSERT INTO %s.%s 
                            VALUES ('%s','%s',%s,%s,
                                    '%s','%s',%d,'%s','%s','%s',%d)                
                    """ % (gpexpand_schema,status_detail_table,
                           self.dbname,self.fq_name,self.schema_oid,self.table_oid, 
                           self.dist_policy,self.dist_policy_names,self.rank,
                           self.status,
                           self.expansion_started,self.expansion_finished,
                           self.source_bytes )
        logger.info(insertSQL)
        dbconn.execSQL(conn,insertSQL)
               
               
               
    def mark_started(self,status_conn,table_conn):
        
        sql = "SELECT pg_relation_size('%s')" % self.fq_name         
        cursor = dbconn.execSQL(table_conn,sql)
        row = cursor.fetchone()
        src_bytes = int(row[0])
        logger.info(" Table: %s has %d bytes" % (self.fq_name, src_bytes))
         

        
        time_str = datetime.datetime.now()       
        sql = """UPDATE %s.%s 
                  SET status = '%s', expansion_started='%s',
                      source_bytes = %d
                  WHERE dbname = '%s' AND schema_oid = %s 
                        AND table_oid = %s """ % (gpexpand_schema,status_detail_table,
                  start_status,time_str,
                  src_bytes, self.dbname,
                  self.schema_oid,self.table_oid) 
         

        logger.info("Mark Started: " + sql)
        dbconn.execSQL(status_conn,sql) 
        status_conn.commit()
        
        
    def reset_started(self, status_conn):        
        sql = """UPDATE %s.%s 
                 SET status = 'NOT STARTED', expansion_started=NULL
                 WHERE dbname = '%s' AND schema_oid = %s 
                 AND table_oid = %s """ % (gpexpand_schema,status_detail_table,
                                           self.dbname, self.schema_oid,self.table_oid) 
         

        logger.info("Undo started: " + sql)
        dbconn.execSQL(status_conn,sql) 
        status_conn.commit()
        
        
        
    def expand(self,table_conn):
        foo = self.distrib_policy_names.strip()
        
        if foo == "":
            sql = "ALTER TABLE %s SET DISTRIBUTED RANDOMLY" % (self.fq_name)
            logger.warning("FOR NOW WE CANT SUPPORT THESE")
            return
        else:
            sql = " ALTER TABLE %s SET DISTRIBUTED BY (%s) " % (self.fq_name,foo.lstrip())
        logger.info("Expand SQL: %s" % sql)    
        dbconn.execSQL(table_conn,sql)
        table_conn.commit()
    
    
    def mark_finished(self,status_conn,table_conn,finish_time):
        sql = """UPDATE %s.%s
                  SET status = '%s', expansion_finished='%s'
                  WHERE dbname = '%s' AND schema_oid = %s 
                  AND table_oid = %s """ % (gpexpand_schema,status_detail_table,
                                            done_statue,finish_time,
                                            self.dbname,self.schema_oid,self.table_oid) 
        logger.info(sql)
        dbconn.execSQL(status_conn,sql)
        status_conn.commit()
        
                
#-----------------------------------------------
class ExpandCommand(SQLCommand):
    
    def __init__(self,name,status_url,table):        
        self.status_url=status_url
        self.table=table
        self.cmdStr="Expand %s.%s" % (table.dbname,table.fq_name)
        self.table_url = copy.deepcopy(status_url)
        self.table_url.pgdb = table.dbname
        
        SQLCommand.__init__(self,name)        
        pass        
    
     
    def run(self,validateAfter=False):
        #connect.
        status_conn=dbconn.connect(self.status_url)
        table_conn=dbconn.connect(self.table_url)
        
        # Set conn for  cancel
        self.conn = table_conn     
        
        logger.info("Starting Expansion")
        self.table.mark_started(status_conn,table_conn)
        
        logger.info("Expanding...")
        canceled = False
        try:
            self.table.expand(table_conn)
        except DatabaseError, ex:
            if ex.__str__().find('canceling statement due to user request') == -1:
                raise
            else:
                canceled = True
                
        if not canceled:
            end_time = datetime.datetime.now()
            #update metadata        
            logger.info("Finished Expanding...updating metadata")
            self.table.mark_finished(status_conn,table_conn,end_time)
        else:
            self.table.reset_started(status_conn)
        
        #disconnect
        status_conn.close()
        table_conn.close()
        
        
    
    def set_results(self,results):
        raise ExecutionError("TODO:  must implement")
    
    def get_results(self):
        raise ExecutionError("TODO:  must implement")
    
    def was_successful(self):
        raise ExecutionError("TODO:  must implement")
    
    def validate(self):
        raise ExecutionError("TODO:  must implement")        
        
        

#------------------------------- UI Help --------------------------------
def interview_setup(default_primary_port_est,default_mirror_port_est):
    help="""
System Expansion is used to add segments to an existing GPDB array.
gpexpand did not detect a System Expansion that is in progress.  
            
Before initiating a System Expansion, you need to provision and burn-in 
the new hardware.  Please be sure to run gpcheckperf/gpcheckos to make
sure the new hardware is working properly.
                        
Please refer to the Admin Guide <TODO: chapter?> for more information."""
            
    if not ask_yesno(help,"Would you like to initiate a new System Expansion",'N'):                            
        logger.info("User Aborted. Exiting...")
        sys.exit(0)
         
    help="""
This utility can handle some expansion scenarios by asking a few questions.
More complex expansions can be done by providing an input file with 
the --input <file>.  Please see the docs for the format of this file.  
            
We'll now ask you a few questions to try and build this file for you.  
You'll have the opportunity to save this file and inspect it/modify it 
before continuing by re-running this utility and providing the input file. """
            
    hostlist=ask_list(help,"Please enter a comma separated list of hostnames that you'd like to add\n" \
                      "or press Enter if you are not adding any hosts",'')    
            
    primary_datadirs=ask_list(None,"\nPlease enter a comma separated list of data directories to put new\n"\
                              "primary segment databases on",None)
            
    primary_portbase=ask_int(None,"\nPlease provide a base port number to use for the new\n"\
                             " primary segdbs?",
                             None,5500,1024,65536)

            
    mirror_datadirs=None
    mirror_portbase=None
    mirror_type=ask_string("\nYou must now specify a mirroring strategy for the new hosts.  Spread mirroring places\n"\
                           "a given hosts mirrored segments each on a separate host.  You must be \n"\
                           "adding more hosts than the number of segments per host to use this. \n"\
                           "Grouped mirroring places all of a given hosts segments on a single \n"\
                           "mirrored host.  You must be adding at least 2 hosts in order to use this.\n\n",
                           "What type of mirroring strategy would you like?",
                           'grouped', ['spread','grouped','none'])
            
    if mirror_type.lower().strip() != 'none':                
        mirror_datadirs=ask_list(None,
                                 "\nPlease enter a comma separated list of data directories to put new\n"\
                                 "mirror segment databases on ",None) 
        mirror_portbase=ask_int(None,"Please provide a base port number to use for the new \n"\
                                "mirror segdbs?",
                                None,5600,1024,65536)
            
            
    print "\nGenerating configuration file...\n"
            
            
    outfile=gp_expand.generate_inputfile(hostlist,primary_datadirs,primary_portbase,mirror_type,mirror_datadirs,mirror_portbase)
    print """\nInput configuration file was written to:
'%s'.  Please review the file and make sure that its correct then re-run 
with: gpexpand -i %s
                """ % (outfile,outfile)
    
            
#------------------------------- Mainline --------------------------------


try:
    logger = get_default_logger()
    setup_tool_logging(EXECNAME,getLocalHostname(),getUserName())
    
    options, args = parseargs()
    
    if options.verbose:
        enable_verbose_logging()
    
    if options.quiet:
        quiet_stdout_logging()
    
    dburl = dbconn.DbURL()
    
    # This will validate the dburl as well as get the master 
    # mirror for the status file
    try:
        gparray = createGPDBFromDB(dburl)
    except DatabaseError, ex:
        logger.error('Failed to connect to database.  Make sure the')
        logger.error('Greenplum instance you wish to expand is running')
        logger.error('and that your environment is correct, then rerun')
        logger.error('gexpand ' + ' '.join(sys.argv[1:]))
        sys.exit(1)
        
    statusLogger = GpExpandStatus(options.master_data_directory, gparray.standbyMaster)
    
    gp_expand = gpexpand(logger,statusLogger,dburl,parallel=options.parallel)   
    
    if options.clean:
        gp_expand.cleanup_schema()
        statusLogger.remove_status_file()
        logger.info('Cleanup Finished.  exiting...')
        sys.exit(0)
        
    if statusLogger.get_current_status()[0] == 'EXPANSION_PREPARE_DONE':
        gp_expand.perform_expansion()
    else:
        if options.filename is None: 
            #TODO: add func to gpexpand to try and guess a default set of portbases
            #      for primaries and mirrors.
            default_primary_port_est=5500
            default_mirror_port_est=5600
            interview_setup(default_primary_port_est,default_mirror_port_est)            
            logger.info("Exiting...")           
            sys.exit(0)
        
        if statusLogger.get_current_status()[0] == 'UNINITIALIZED':
            statusLogger.set_status('EXPANSION_PREPARE_STARTED')
        
        gp_expand.setup_schema()
        gp_expand.read_input_file()
        gp_expand.add_segments()
        gp_expand.update_original_segments()
        gp_expand.update_master()
        gp_expand.prepare_schema()

        logger.info('Initialization of the system expansion complete.')
        logger.info('To begin table expansion onto the new segments')
        logger.info('rerun gpexpand')
        statusLogger.set_status('EXPANSION_PREPARE_DONE')
        sys.exit(0)
    
    
    
except Exception, e:
    logger.exception("gpexpand failed. exiting...")
    if gp_expand is not None:
        gp_expand.cleanup()
    sys.exit(3)
except KeyboardInterrupt:
    if gp_expand is not None:
        gp_expand.cleanup()
    #TODO: sys.exit is pretty harsh on the work threads and is
    # currently preventing cleanup.
    sys.exit('\nUser Interrupted')
