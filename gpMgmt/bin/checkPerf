        self.gSession=gSession
        self.pool=gSession.pool
        self.hostObjs=None

        # Files Needed.

        self.options['LogFile'] =""
        self.options['ResFile'] =""

        # test Optoions
        self.options['rptCount'] = 5
        self.options['elpTime']= 0
        self.options['baseDir']=""

        # dd Options
        self.ddOptions=None
        self.ddResults=None
        self.results=None

        # Logger
        if logger:
            self.logger=logger
        else :
            gpLogger.initLogger(lName='checkPerf', debug=debug, \
                verbose=verboseOpt)
            self.logger=logging.getLogger('checkPerf')
                
        self.logger.info(" Initializing checkPerf Object.. \n")

    def killHandler(self, signo, frame):
        print "Received Singal ", signo
        print ""
        print "Exiting..."
        raise SystemExit, 1


    def termHandler(self, signo, frame):
        print "Received Singal ", signo
        print ""
        if self.gSession:
            for th in self.gSession.sessions:
                th.killCMD(signal.SIGKILL)
                th.shutdown()
        #
        # TBD: Remove any direcotories or files created on each Node.
        #
        print "Exiting..."
        raise SystemExit, 1
    
    def obtainConfig(self, configFile="", specFile="", configFd=None, specFd=None):
        """ 
            parse configuration file for config valuesJ
        """
        logger=self.logger
        if specFile and not specFd:
            logger.info("Coniguration spec file %s" % specFile)
            try:
                specFd = open(specFile, 'r')
                specFd.close()
            except IOError, e:
                logger.error("*** Received IO Error (%s)" % str(e))
                return None
        if configFile and not configFd:
            logger.info("Configuration File = %s" % configFile)
            try:
                specFd = open(configFile, 'r')
                specFd.close()
            except IOError, e:
                logger.error("*** Received IO Error (%s)" % str(e))
                return None
        try: 
            configspec = ConfigObj(specFd, encoding='UTF8', list_values=False)
            config = ConfigObj(configFd, configspec=configspec)
        except SyntaxError, e:
            logger.error("*** Received Syntax Error (%s)" % str(e))
            return None
        except SystemExit:
            raise
        except KeyboardInterrupt:
            raise
        except Exception, e:
            logger.error("*** Caught exception(obtainConfig) (%s) message: (%s )" \
                % (str(e.__class__), str(e)))
            traceback.print_exc()
            return None
        #
        # Create a validator
        #
        val = Validator()
        valResult = config.validate(val, preserve_errors=True)
        if valResult == True:
            return config
        else :
            logger.error("*** Encountered config parsing errors. ***")
            for entry in flatten_errors(config, valResult):
                # each entry is a tuple
                section_list, key, error = entry
                if key is not None:
                    section_list.append(key)
                else:
                    section_list.append('[missing section]')
                section_string = ', '.join(section_list)
                if error == False:
                    error = 'Missing value or section.'
                errStr="%s = %s" %(section_string, error)
                logger.error(errStr)
            return None

    def getIntVal(self, intString):
        """ 
            Return integer value
        """
        if not intString or not len(intString):
            return (0, "")
        factor=1
        intWord=intString.strip()
        intVal=intWord
        if intWord.endswith("GB") or intWord.endswith("gB")\
            or intWord.endswith("Gb") or intWord.endswith("gb") :
            factor = 1024 * 1000000
            intVal=intWord[0:len(intWord)-2]
        elif intWord.endswith("G") or  intWord.endswith("g"):
            factor = 1024 * 1000000
            intVal=intWord[0:len(intWord)-1]
        elif intWord.endswith("MB") or intWord.endswith("mB") \
            or intWord.endswith("Mb") or intWord.endswith("mb") :
            factor = 1024 * 1000
            intVal=intWord[0:len(intWord)-2]
        elif intWord.endswith("M") or  intWord.endswith("m"):
            factor = 1024 * 1000
            intVal=intWord[0:len(intWord)-1]
        elif intWord.endswith("KB") or intWord.endswith("kB") \
            or intWord.endswith("Kb") or intWord.endswith("kb") :
            factor = 1024 
            intVal=intWord[0:len(intWord)-2]
        elif intWord.endswith("K") or  intWord.endswith("k"):
            factor = 1024 
            intVal=intWord[0:len(intWord)-1]
        else :
            intVal=intWord

        if not len(intVal):
            return (factor, "")
        try:
            floatVal=float(intVal)
        except ValueError:
            return (None, "Unable to parse, Invalid interger string(%s)." %\
                intWord)
        return (floatVal *  factor, "")


    def populateConfig(self, configObj):
        """ Populate Configuration from configObj """
        logger=self.logger
        if not configObj:
            return False
        self.options['LogFile']   =""
        self.options['ResFile']   =""
        try :
            self.options['RptCount']  =configObj['CheckPerf']['RptCount']
            self.options['Tolerance'] =configObj['CheckPerf']['Tolerance']
            self.options['ElapseTime']=configObj['CheckPerf']['ElapseTime']
            self.options['baseDir']=configObj['CheckPerf']['baseDir']
            # Range : Stringr']
            #
            # DD Options
            #
            if not self.ddOptions:
                self.ddOptions={}
            if (isinstance(configObj['Disk Performance'], dict)):
                ddConfig=configObj['Disk Performance']
                ddKeys=ddConfig.keys()
                if ('DirectoryList' in ddKeys and \
                    isinstance(ddConfig['DirectoryList'], list)):
                    self.ddOptions['DirectoryList']=ddConfig['DirectoryList']
                if 'FileSize' in  ddKeys:
                    self.ddOptions['FileSize']=  ddConfig['FileSize']
                if 'BlockSize' in  ddKeys:
                    (intBlkSize, errStr)= \
                        self.getIntVal(ddConfig['BlockSize'])
                    if errStr:
                        logger.error(errStr)
                        return False
                    self.ddOptions['BlockSize']=  intBlkSize
                if 'Count' in  ddKeys:
                    self.ddOptions['Count']=  ddConfig['Count']
                try:
                    if 'FileSize' in  self.ddOptions.keys():
                        (intFileSize, errStr)=\
                            self.getIntVal(self.ddOptions['FileSize'])
                        if errStr:
                            logger.error(errStr)
                            return False
                        blockSize=int(self.ddOptions['BlockSize'])
                        if intFileSize:
                            count = intFileSize/blockSize
                            self.ddOptions['Count']= count
                except SystemExit:
                    raise
                except KeyboardInterrupt:
                    raise
                except Exception, e:
                    logger.error("*** Caught exception (obtainCount) (%s) message: "\
                        "(%s )" % (str(e.__class__), str(e)))
                    traceback.print_exc()
                    return False
        except KeyError, e:
            logger.error("Missing configuration %s  ", str(e))
            return False
        except SystemExit: 
            raise
        except KeyboardInterrupt:
            raise
        except Exception, e:
            logger.error("*** Caught exception (populateConfig) (%s) message: (%s )" \
                % (str(e.__class__), str(e)))
            traceback.print_exc()
            return False
        return True

    def printOptions(self):
        """ Print the options to screen """
        print "CheckPerf Options.. \n"
        print "\t", "LogFile : %s " % self.options['LogFile']
        print "\t", "ResFile : %s " % self.options['ResFile']

        print "\t", "RptCount : %d " % self.options['RptCount']
        print "\t", "Tolerance: %f " % self.options['Tolerance']
        print "\t", "ElapseTime: %d " % self.options['ElapseTime']

        print "DD OPTIONS \n"
        print "\t", self.ddOptions['DirectoryList']
        print "\t", "Block Size : %d " % self.ddOptions['BlockSize']
        print "\t", "Count : %d " % self.ddOptions['Count']

    def getTimes(self, stdout, stderr=None):
        """ Return various time intervals from the output 
    
            Return (real, user, sys) floats
        """
        logger=self.logger
        realTime=userTime=sysTime=0.0
        if not stdout and not stderr:
            return (realTime, userTime, sysTime)
        if stderr and stdout:
            outPut="%s\n%s" % (stderr, stdout)
        elif stdout:
            outPut="%s" % (stdout)
        for eachLine in outPut.split('\n'):
            try:
                if eachLine.strip().startswith('real '):
                    lineWords=eachLine.split()
                    realTime=float(lineWords[1])
                    continue
                if eachLine.strip().startswith('user '):
                    lineWords=eachLine.split()
                    userTime=float(lineWords[1])
                    continue
                if eachLine.strip().startswith('sys '):
                    lineWords=eachLine.split()
                    sysTime=float(lineWords[1])
                    continue
            except ValueError:
                logger.error("Received value Error : %s " % eachLine)
                break
        return (realTime, userTime, sysTime)

    def rptCmd(self, cmd, cmdTitle, resObj, sshSession=None, host="", postCmd=""):
        """
            Execute a command repeatedly
            cmd : Command to be executed
            cmdTitle : Store the results using this string
            sshSession: Execute using sshSession, if None execute on local host.
            host : on which the test is performed
            postCmd: Any command that needs to be executed after each execution.
            Return : None
             None on Fatal Erorr
        """
        logger=self.logger
        runTime=0
        runCntr=1
        tInterval=self.options['ElapseTime']
        rptTimes=self.options['RptCount']
        tmInterval=100*tInterval
        hostID='localhost'
        if sshSession: hostID=sshSession.host
        try:
            logger.debug("rptCmd: %s: %s   "%  (hostID, cmd))
            while True:
                # Obtain time in milliSeconds
                befTime=time.time()*100
                # Prepend time command
                if not cmd.strip().startswith('time '):
                    cmd="time -p %s" % cmd
                exitStatus=-1
                if sshSession:
                    stdout=""
                    stderr=""
                    try:
                        logger.info("%s Executing %s (%d time) ", hostID, cmd, runCntr)
                        (exitStatus, stdout, stderr)=sshSession.runCommand(cmd)
                    except sshParamikoModule.runCommandException, err:
                        errStr= "%s Iteration :%d Error Executing" \
                        "%s: %s" % (hostID, runCntr, cmd, err)
                        sshSession.rptError=errStr
                        return False
                    except SystemExit: 
                        raise
                    except KeyboardInterrupt:
                        raise
                    except Exception, e:
                        errStr= "%s Iteration: %d Caught exception (rptCmd1)%s:"\
                        "%s executing %s " % \
                            (hostID, runCntr, str(e.__class__), str(e), cmd)
                        sshSession.rptError=errStr
                        logger.error(errStr)
                        traceback.print_exc()
                        return False
                else :
                    (exitStatus, stdout)=commands.getstatusoutput(cmd) 
                outText = stdout+stderr
                aftTime = time.time()*100
                execTime=int(aftTime-befTime)
                runTime += execTime
                if (not exitStatus):
                    (rTime, uTime, sTime) = self.getTimes(outText)
                    logger.info("%s Iteration :%d Results: %.2f %.2f %.2f" \
                        % (hostID, runCntr, rTime, uTime, sTime))
                    # Add only if rTime is not zero
                    if resObj:
                        sshSession.lock.acquire()
                        resObj.addResults(hostID, runCntr, rTime, uTime, sTime)
                        sshSession.lock.release()
                else:
                    if outText:
                        if sshSession:
                            sshSession.rptError=outText
                    else:
                        if sshSession:
                            sshSession.rptError="Failed : %d" % exitStatus
                    return False
                # postCmd
                if postCmd:
                    if sshSession:
                        opt=sshSession.execCmd(postCmd)
                    else :
                        opt=commands.getoutput(postCmd) 
                if tmInterval and runTime>=tmInterval:
                    break;
                if runCntr>=rptTimes:
                    break
                runCntr+=1
        except SystemExit: 
            raise
        except KeyboardInterrupt:
            raise
        except Exception, e:
            hostStr="%s : %s " % (cmd, hostID)
            errStr="*** Caught exception(rptCmd2): %s  (%s) message: (%s )" \
                % (hostStr, str(e.__class__), str(e))
            logger.error(errStr)
            if sshSession:
                sshSession.rptError= errStr
            traceback.print_exc()
            return False


    def obtainHostObj(self, sshSession):
        """ Obtain Host information for each SSH Session"""
        th=sshSession
        hostObj=host.Host.getHostObject(th.host, th.user, th.port, th)
        # Attach the host Object to the session.
        th.hostObj=hostObj
        # Do we have to lock here ?
        self.hostObjs.append(hostObj)

    def getHostInfo(self, verbose=False):
        """ Obtain information regarding each Host """ 
        # Initialze hostObjs
        logger=self.logger
        if not self.hostObjs:
            self.hostObjs=[]
        # Obtain Host information for every SESSION
        for i in range(0, len(self.gSession.sessions)):
            th = self.gSession.sessions[i]
            self.pool.putRequest(threadpool.WorkRequest(self.obtainHostObj, \
            [th],None,None))
        if not self.pollResponse():
            logger.error("Error Obtaining host information.")
            return False
        if verbose:
            for i in range(len(self.hostObjs)):
                hObj= self.hostObjs[i]
                print
                hObj.printHostinfo()
                print

    def pollResponse(self, waitingFor=""):
        #
        # Wait for results, in a thread pool
        #
        logger=self.logger
        while True:
            try:
                self.pool.poll(block=True)
            except (threadpool.NoResultsPending):
                interrupted=False
                break
            except (KeyboardInterrupt):
                logger.error ("Received KeyBoard Interrupt %s", waitingFor)
                for i in range(0,len(self.gSession.sessions)):
                    th=self.gSession.sessions[i]
                    th.killCMD(signal.SIGKILL)
                #self.pool.wait()
                interrupted=True
                break
        if interrupted:
            print "Command Interrupted"
            return False
        return True
    
    def createRmtDir(self, dirName, sshSession, create=True, clear=True):
        """ 
            If the directory is present remove it.
            If create is true, create a new one.
            update sshSession.dirTest with error string, in case of failure.
            create=False, Create the directory if not present
            clear= True, Clear the directory if present.
        """
        logger=self.logger
        sftpClnt=sshSession.sftpClnt
        sshSession.dirTest=""
        host=sshSession.host
        try :
            rStat=sftpClnt.stat(dirName)
            if S_ISDIR(rStat.st_mode) and clear:
                logger.info("%s: Removing directory : %s " % (host, dirName))
                stdout=sshSession.execCmd("rm -rf %s " % dirName)
                if stdout:
                    errStr= "Unable to remove %s on %s :%s  " % (dirName, \
                        sshSession.host, stdout)
                    sshSession.dirTest=errStr
                    return
        except IOError:
            pass
        except SystemExit:
            raise
        except KeyboardInterrupt:
            raise
        except Exception, e:
            errStr="Caught Exception (createRmtDir)(%s) : %s, %s " % (sshSession.host,
                str(e.__class__), str(e))
            traceback.print_exc()
            sshSession.dirTest=errStr
            return
        if not create:
            return
        try:
            stdout=sshSession.execCmd("mkdir -p %s " % dirName)
            logger.info("%s Making Directory : %s " % (host, dirName))
            if stdout:
                errStr= "Unable to mkdir %s on %s :%s  " % (dirName, \
                    sshSession.host, stdout)
                sshSession.dirTest=errStr
                return
        except SystemExit: 
            raise
        except KeyboardInterrupt:
            raise
        except Exception, e:
            errStr="Caught Exception createRmtDir2(%s) : %s, %s " % (sshSession.host,
                str(e.__class__), str(e))
            logger.error(errStr)
            traceback.print_exc()
            sshSession.dirTest=errStr

    def checkDirPerms(self, dirName, createFlag=True, clearFlag=True):
        """
            Check if the directory is OK across all the hosts
            Return True or False
        """
        logger=self.logger
        for i in range(0,len(self.gSession.sessions)):
            th = self.gSession.sessions[i]
            th.dirTest=""
            self.pool.putRequest(threadpool.WorkRequest(self.createRmtDir, \
            [dirName, th, createFlag],None,None))
        if not self.pollResponse():
            logger.error("Error Obtaining directory permissions\n")
            return False
        retVal=True
        for i in range(0,len(self.gSession.sessions)):
            th = self.gSession.sessions[i]
            if th.dirTest:
                logger.error("%s: %s" ,th.host, th.dirTest)
                retVal=False
        return retVal

    def cmdParallel(self, cmd, cmdTitle, postCmd="", useSessionCmd=False,\
        tSize=0):
        #
        # Execute command in parallel on all the sessions
        #
        logger=self.logger
        cmdRes =checkPerfResults.checkPerfResults(cmdTitle, cmd)
        for i in range(0,len(self.gSession.sessions)):
            th = self.gSession.sessions[i]
            th.rptError=""
            if useSessionCmd:
                cmdRes.addHost(th.host, th.tSize)
                runCmd=th.runCmd
            else :
                cmdRes.addHost(th.host, tSize)
                runCmd=cmd
            self.pool.putRequest(threadpool.WorkRequest(self.rptCmd, \
            [runCmd, cmdTitle, cmdRes, th, th.host, postCmd],None,None))
        if not self.pollResponse():
            return None
        for i in range(0,len(self.gSession.sessions)):
            th = self.gSession.sessions[i]
            if th.rptError:
                logger.error("Error %s : %s "% (th.host, th.rptError))
                cmdRes=None
        return cmdRes

    def execSSHCmd(self, cmd, sshSession=None):
        """ Execute  cmd on sshSession """
        # Intialize
        logger=self.logger
        exitStatus=0
        stdout=""
        stderr=""
        if sshSession:
            try:
                (exitStatus, stdout, stderr)=sshSession.runCommand(cmd)
            except sshParamikoModule.runCommandException, err:
                exitStatus=-1
                outText="%s" % str(err)
            except SystemExit: 
                raise
            except KeyboardInterrupt:
                raise
            except Exception, e:
                outText= "***Caught exception (execSSHCmd)%s: %s executing "\
                "%s on %s." %\
                    (str(e.__class__), str(e), cmd, sshSession.host)
                exitStatus=-1
                logger.error(outTxt)
                traceback.print_exc()
            outText=stdout+stderr
        else :
            (exitStatus, outText)=commands.getstatusoutput(cmd) 
        sshSession.exitStatus=exitStatus
        sshSession.outText = outText

    def createFile(self, fileName, blkCount, blockSize, useRAM=False):
        """ Create a file of  size using DD command """
        logger=self.logger
        retVal=True
        # Write command
        for i in range(0,len(self.gSession.sessions)):
            th = self.gSession.sessions[i]
            th.exitStatus=0
            th.outText=""
            thBlkCount = blkCount
            if useRAM:
                if th.hostObj and th.hostObj.totalRam:
                    thBlkCount= (th.hostObj.totalRam/blockSize)*2
                else:
                    logger.warning("Host information missing %s" % \
                        (th.host))
            wrCmd= "dd if=/dev/zero of=%s  count=%u bs=%u" %  \
                    (fileName, thBlkCount, blockSize)
            self.pool.putRequest(threadpool.WorkRequest(self.execSSHCmd,\
                [wrCmd, th], None,None))
        #
        # Poll for the results
        # 
        if not self.pollResponse():
            logger.error("Error creating a readFile %s" % fileName)
            return False
        for i in range(0,len(self.gSession.sessions)):
            th = self.gSession.sessions[i]
            if th.exitStatus:
                logger.error("Error creating file(%s) on (%s): %d/%s " % 
                    (fileName, th.host, th.exitStatus, th.outText))
                retVal=False
        return retVal



    def ddReadTest(self, eachDir, blkCount, blockSize, useRAM=False):
        """ Perform  Read test on the the directory 

            return Results Structure
        """
        logger=self.logger
        dirName=eachDir+'/checkPerf'
        logger.info("Checking permisions\n")
        if not self.checkDirPerms(dirName):
            print "Permissions check on %s Failed \n" % eachDir
            return None
        logger.info("Checking permisions successful.\n")
        # Create a file for reading
        fileName="%s/%s" % (dirName, "ddFile")
        logger.info("Creating file(%s) to read from. \n" % fileName)
        if not self.createFile(fileName, blkCount, blockSize, useRAM):
            print "Unable to create file (%s)"
            return None
        # Proceed with reading
        logger.info("Creating file(%s) to read from. Succesfull.\n" % fileName)
        cmdTitle="Directory Read I/O Test : %s " % eachDir
        if useRAM:
            rdCmd="dd if=%s of=/dev/null count=(2 * TotalRAM)/%d bs=%d" %  \
                (fileName, blockSize, blockSize)
            for i in range(0,len(self.gSession.sessions)):
                th = self.gSession.sessions[i]
                if th.hostObj and th.hostObj.totalRam:
                    blkCount= (th.hostObj.totalRam/blockSize)*2
                else:
                    logger.warning("Host information missing %s" % \
                        (th.host))
                th.runCmd= "dd if=%s of=/dev/null count=%d bs=%d" %  \
                    (fileName, blkCount, blockSize)
                th.tSize=int(blkCount * blockSize)
                print "Performing Read Test(%s) on %s, reading %u bytes from"\
                    "%s \n" % (eachDir, th.host, th.tSize, fileName)
                logger.info("Read I/O Command %s:%s" % (th.host, th.runCmd))
            readRes=self.cmdParallel(rdCmd, cmdTitle, useSessionCmd=True)
        else :
            print "Performing Read Test(%s), reading %u bytes from %s \n" % \
                (eachDir, blkCount *blockSize, fileName)
            rdCmd="dd if=%s of=/dev/null count=%d bs=%d" %  \
                (fileName, blkCount, blockSize)
            logger.info("Read I/O Command: %s" % rdCmd)
            readRes=self.cmdParallel(rdCmd, cmdTitle, tSize=blkCount*blockSize) 
        if readRes:
            if not self.checkDirPerms(dirName, False):
                return False
            self.ddResults[eachDir]['Read']=readRes
            return True
        return False
                

    def ddWriteTest(self, eachDir, blkCount, blockSize, useRAM=False):
        """ Perform  write test on the the directory """
        logger=self.logger
        dirName=eachDir+'/checkPerf'
        if not self.checkDirPerms(dirName):
            logger.error("Permissions check on %s Failed \n" % eachDir)
            return False
        cmdTitle="Directory Write I/O Test : %s " % eachDir
        if useRAM:
            wrCmd="dd if=/dev/zero of=%s/ddFile count=(2*TotalRAM)/%d bs=%d" % \
                (dirName, blockSize, blockSize)
            for i in range(0,len(self.gSession.sessions)):
                th = self.gSession.sessions[i]
                if th.hostObj and th.hostObj.totalRam:
                    blkCount= (th.hostObj.totalRam/blockSize)*2
                else:
                    logger.warning("Host information missing %s" % \
                        (th.host))
                th.runCmd="dd if=/dev/zero of=%s/ddFile count=%u bs=%u" % \
                    (dirName, blkCount, blockSize)
                th.tSize=int(blkCount * blockSize)
                print "Performing Write Test(%s) on %s, writing %u bytes to"\
                    "%s/ddFile \n" % (eachDir, th.host, th.tSize, eachDir)
                logger.info("Write I/O Command %s:%s" % \
                    (th.host, th.runCmd))
            writeRes=self.cmdParallel(wrCmd, cmdTitle, useSessionCmd=True)
        else:
            print "Performing Write Test(%s), writing %d bytes to %s/ddFile \n" % \
                (eachDir, blkCount *blockSize, dirName)
            wrCmd="dd if=/dev/zero of=%s/ddFile count=%u bs=%u" % \
                (dirName, blkCount, blockSize)
            logger.info("Write Command : %s " % wrCmd)
            writeRes=self.cmdParallel(wrCmd, cmdTitle, \
                tSize=blkCount * blockSize)
        if writeRes:
            if not (self.checkDirPerms(dirName, False)):
                return False
            self.ddResults[eachDir]['Write']=writeRes
            return True
        return False

    def printRAMWarning(self):
        """ Print RAM Warning if they are different """
        ramDict={}
        for i in range(0, len(self.gSession.sessions)):
            th = self.gSession.sessions[i]
            tRam=th.hostObj.totalRam
            if tRam in ramDict.keys():
                tRamDict=ramDict[tRam]
                tRamDict.append(th.host)
            else:
                ramDict[tRam]=[]
                ramDict[tRam].append(th.host)
        if len(ramDict) !=1:
            print
            print (" RAM Sizes of the all hosts doesn't seem to be equal. ");
            print
            for eKey in ramDict.keys():
                print eKey, ramDict[eKey]
            print 


    def ddTest(self, useRAMFlag=False):
        """ Perform dd Test """
        logger=self.logger
        dirList=self.ddOptions['DirectoryList']
        if not dirList:
            logger.error("Directory list is empty\n"\
                "Provide directory list in the configuration file.")
            return False
        if not self.ddResults:
            self.ddResults={}
        blkCount=self.ddOptions['Count']
        blockSize=self.ddOptions['BlockSize']
        if not blkCount:
            self.printRAMWarning()
            useRAMFlag=True
        for eachDir in dirList:
            self.ddResults[eachDir]={}
            self.ddResults[eachDir]['Write']=None
            self.ddResults[eachDir]['Read']=None
            print
            if not self.ddWriteTest(eachDir, blkCount, blockSize,\
                useRAM=useRAMFlag):
                return False
            if not self.ddReadTest(eachDir, blkCount, blockSize, \
                useRAM=useRAMFlag):
                return False
        return True

    def printDirResults(self, detailed=False):
        """ Print Directory I/O Results """
        tRence=0
        try:
            tRence=float(self.options['Tolerance'])
        except KeyError:
            pass

        blkCount=self.ddOptions['Count']
        blockSize=self.ddOptions['BlockSize']
        dirList=self.ddOptions['DirectoryList']
        if not dirList:
            print "Directory list is empty\n"\
                "Provide directory list in the configuration file."
        try:
            print "Printing Results SUMMMARY"
            tSize= blkCount * blockSize
            for eachDir in dirList:
                print "Directory : %s "% eachDir
                wrRes=self.ddResults[eachDir]['Write']
                rdRes=self.ddResults[eachDir]['Read']
                print "\t Write I/O Results"
                if wrRes:
                    wrRes.printIOResults(tSize, tRence, detailed)
                else :
                    print " **** WRITE IO RESULTS NOT PRESENT ****"
                print "\t Read I/O Results"
                if rdRes:
                    rdRes.printIOResults(tSize, tRence, detailed)
                else :
                    print " **** READ IO RESULTS NOT PRESENT ****"
        except SystemExit: 
            raise
        except KeyboardInterrupt:
            raise
        except Exception, e:
            print "*** Caught exception (%s) message: (%s )" \
                % (str(e.__class__), str(e))
            traceback.print_exc()

    def createBaseDir(self):    
        """ Create base directory on all the hosts """
        baseDir=self.options['baseDir']
        if not baseDir:
            self.rmtDir='~/checkPerf'
        else :
            self.rmtDir=baseDir+'/checkPerf'
        retVal=self.checkDirPerms(self.rmtDir, createFlag=True, clearFlag=False)
        return retVal

def parseHostFile(hostFile, defaultPort=22, defaultUser=None, verbose=False,\
    logger=None):
    """ Parse the host file """
    hostuserport = []
    hostList=[]
    if not defaultUser:
        defaultUser = os.environ.get('LOGNAME') or os.environ.get('USER')
    for h in hostFile:
        #Strip out the hostname and user, if there is a user present in the 
        # record (e.g. user@host)
        host = h.strip()
        if host != '':
            if verbose:
                logger.info("Working on host: " + host )
            if '@' in host:
                (user, host) = string.split(host, '@')
            else:
                user = defaultUser

            if ':' in host:
                (host,port) = string.split(host, ':')
            else:
                port = defaultPort
            if host not in hostList:
                hostuserport.append((host,user,port))
                hostList.append(host)
            else:
                print
                logger.warning("Host %s is repeated, ignoring %s" % (host, h.strip()))

    return (hostuserport, hostList)

def checkPerfMain(argv):
    # Process options
    try :
        (options, arguments) = getopt.getopt(argv[1:], "?uvdo:l:c:m:h:-p:sxn:t:",
            ['help', 'usage', 'verbose', 'debug', 'output_file=',\
            'log_file=', 'config_file', 'spec_file=', 'host_file=',
            'port=', 'no_trusted_key_setup', 'exchange_trusted_keys',
            'repeat_count=', 'elapse_time=', 'detailed', 'no-dd-test',
            'no-stream-test'])
    except getopt.GetoptError, e:
        # print help information and exit:
        print __doc__
        print str(e)
        sys.exit(2)
    #
    # Initialize 
    #
    defaultPort=22
    logFile=optFile=hostFile=configFile=""
    exKeys=False
    setupKeys=True
    repeatCount=elpTime=-1
    Tolerance=0
    verbose=False
    debug=False
    detFlag=False
    ddTestFlag=streamTestFlag=True
    specFile=sys.path[0]+'/lib/checkPerf.spec'
    try :
        for (switch, val) in options:
            if (switch == '-o' or switch == '--output_file'):
                optFile = val;
            elif (switch == '-l' or switch == '--log_file'):
                logFile = val;
            elif (switch == '-c' or switch == '--config_file'):
                configFile = val;
            elif (switch == '-m' or switch == '--spec_file'):
                specFile = val;
            elif (switch == '-h' or switch == '--host_file'):
                hostFile= val; 
            elif (switch == '-p' or switch == '--port'):
                defaultPort = int(val);
            elif (switch == '-x' or switch == '--exchange_trusted_keys'):
                exKeys = True 
            elif (switch == '-s' or switch == '--no_trusted_key_setup'):
                setupKeys = False 
            elif (switch == '-d' or switch == '--debug'):
                debug = True
                verbose = True
            elif (switch == '-v' or switch == '-verbose'):
                verbose = True
            elif (switch == '-n' or switch == '--repeat_count'):
                repeatCount = int(val);
            elif (switch == '-e' or switch == '--elapse_time'):
                elpTime = int(val);
            elif (switch == '-t' or switch == '--tolerance'):
                Tolerance = float(val);
            elif (switch == '--detailed'):
                detFlag= True
            elif (switch == '--no-dd-test'):
                ddTestFlag= False 
            elif (switch == '--no-stream-test'):
                streamTestFlag=False
            elif (switch == '-u' or switch == '-?' or switch=='--help' or \
                switch=='--usage'):
                print __doc__
                raise SystemExit, 0
    except ValueError, e:
        print __doc__
        print "\nReceived Value Error : %s \n" % str(e)
        sys.exit(1)
    except SystemExit:
        raise
    except KeyboardInterrupt:
        raise
    except Exception, e:
        print "*** Caught exception (%s) message: (%s )" \
            % (str(e.__class__), str(e))
        traceback.print_exc()
        raise SystemExit, 1
    # 
    # Now, check if we have enough configuration to proceed.
    #
    if not hostFile:
        print __doc__
        print "\n Provide hostFile. \n"
        raise SystemExit, 1

    if not configFile:
        print __doc__
        print "\n Provide configuration file.\n"
        raise SystemExit, 1
    
    fileError=False
    configFd=None
    try:
        configFd=open(configFile, 'r')
    except IOError, e:
        print "*** Received IO error(%s) %s " % (configFile, str(e))
        fileError=True
    try:
        specFd=open(specFile, 'r')
    except IOError, e:
        print "*** Received IO error(%s) %s " % (specFile, str(e))
        fileError=True
    if fileError:
        raise SystemExit, 1

    try:
        execUser = os.environ.get('LOGNAME') or os.environ.get('USER')
        paramiko.util.log_to_file('/tmp/paramiko'+'_'+execUser+'.log') 
    except :
        print "Unexpected error: +'-'+execUser", sys.exc_info()[0]
        raise SystemExit, 1
    lName='checkPerf'
    gpLogger.initLogger(lName=lName, lfName=logFile, verbose=verbose, \
        debug=debug)
    Logger=logging.getLogger(lName)

    try:
        hostFd=open(hostFile, 'r')
        (hostuserport, hostList)=parseHostFile(hostFd,defaultPort=defaultPort, logger=Logger)
    except IOError:
        print 'Error opening file named: ' + hostFile 
        raise SystemExit, 1
    except SystemExit:
        raise
    except  KeyboardInterrupt:
        raise
    except Exception, e:
        print "*** Caught exception (%s) message: (%s )" \
            % (str(e.__class__), str(e))
        traceback.print_exc()
        raise
    hostFd.close()
    gsObj=groupSession.groupSession(hostuserport, setupKeys, 
        verboseOpt=verbose, gLogger=Logger)
    if (exKeys):
        gsObj.exchangeKeys()
    #
    # Create checkPerf Object.
    #
    chkPerf=CheckPerf(gSession=gsObj, logger=Logger)
    signal.signal(signal.SIGTERM,chkPerf.termHandler)
    confObj=chkPerf.obtainConfig(configFile, specFile, configFd, specFd)
    #print confObj
    configFd.close()
    specFd.close()
    if not confObj:
        print "*** Configuration parsing errors "
        raise SystemExit, 1
    chkPerf.ddTestFlag=ddTestFlag
    chkPerf.streamTestFlag=streamTestFlag
    #
    # Command Line Options take precedence
    #
    if optFile:
        confObj['CheckPerf']['ResFile']=optFile
    if logFile:
        confObj['CheckPerf']['LogFile']=logFile
    if repeatCount >= 0:
        confObj['CheckPerf']['RptCount']=int(repeatCount)
    if elpTime >= 0:
        confObj['CheckPerf']['ElapseTime']=int(elpTime)
    if Tolerance >= 0:
        confObj['CheckPerf']['ElapseTime']=int(Tolerance)
    if not chkPerf.populateConfig(confObj):
        raise SystemExit, 1

    if verbose:
        chkPerf.printOptions()
    #
    # Obtain Host Objects
    #
    chkPerf.getHostInfo(verbose)

    try:
        if chkPerf.ddTestFlag:
            if(chkPerf.ddTest()):
                chkPerf.printDirResults(detailed=detFlag)
            else :
                raise SystemExit, 1
        chkPerf.streamTestFlag=True
        if chkPerf.streamTestFlag:
            if not chkPerf.options['baseDir']:
                chkPerf.options['baseDir']='tmpDir'
            if not chkPerf.createBaseDir():
                return False
            strmLPath=sys.path[0]+'/lib/stream'
            strmRPath= chkPerf.options['baseDir']+'/'+ 'stream'
            strmObj=checkPerfStream.StreamTest(chkPerf.gSession, strmLPath, \
                strmRPath, chkPerf.logger)
            if not strmObj.execStream():
                Logger.error("Stream Test failed\n")
            else :
                tRence=0
                try:
                    tRence=chkPerf.options['Tolerance']
                except KeyError:
                    pass
                strmObj.printStrmSummary(tRence=tRence, detailed=detFlag,\
                    hostList=hostList)
    except KeyboardInterrupt:
        print "Received KeyBoard Interrupt"
        raise SystemExit, 1
        
if __name__ == '__main__': 
    #print sys.argv
    checkPerfMain(sys.argv)
    exit 
