#!/usr/bin/env python
'''
Usage: gpcheckcat <option> [dbname]

	-? 
	-g dir     : generate SQL to rectify catalog corruption, put it in dir
	-h host	   : DB host name
	-p port    : DB port number
	-P passwd  : DB password
	-U uname   : DB User Name
	-v         : verbose

'''
import sys, os

sys.path.append(sys.path[0] + '/lib')
try:
    import getopt
    import pg8000
except ImportError, e:
    sys.exit('Error: unable to import module: ' + str(e))

################
def parse_int(val):
    try: val = int(val)
    except ValueError: val = 0
    return val


###############################
class Global():
    opt = {}
    opt['-h'] = None
    opt['-p'] = None
    opt['-P'] = None
    opt['-U'] = None
    opt['-v'] = False
    opt['-V'] = False
    opt['-g'] = None
    cfg = None
    dbname = None
    db = {}

GV = Global()
# array of SQL statements. Key is dbid
Remove = {}

###############################
def usage(exitarg = None):
    print __doc__
    sys.exit(exitarg)


###############################
def verbose(x):
    if GV.opt['-v']: print x


###############################
def veryverbose(x):
    if GV.opt['-V']: print x

###############################
def parseCommandLine():
    try:
        (options, args) = getopt.getopt(sys.argv[1:], '?h:p:P:U:B:vVg:')
    except Exception, e:
        usage('Error: ' + str(e))

    for (switch, val) in options:
        if switch == '-?':	  usage(0)
        elif switch[1] in 'hpBPUg': GV.opt[switch] = val
        elif switch[1] in 'vV':    GV.opt[switch] = True

    def setdef(x, v):
        if not GV.opt[x]:
            t = os.environ.get(v)
            GV.opt[x] = t
            if t:
                verbose('[INFO] %s not specified; default to %s (from %s)' % 
                        (x, t, v))

    setdef('-h', 'PGHOST')
    setdef('-P', 'PGPASSWORD')
    setdef('-U', 'PGUSER')
    setdef('-U', 'USER')
    setdef('-p', 'PGPORT')
    GV.opt['-p'] = parse_int(GV.opt['-p'])
    if not GV.opt['-p']:
        usage('Please specify -p port')

    if not GV.opt['-h']:
        GV.opt['-h'] = 'localhost'
        verbose('[INFO] -h not specified; default to %s' % GV.opt['-h'])
    
    if (len(args) != 0 and len(args) != 1):
        usage('Too many arguments')

    if len(args) == 0:
        GV.dbname = os.environ.get('PGDATABASE') or GV.opt['-U']
        verbose('[INFO] database is %s' % GV.dbname)
    else:
        GV.dbname = args[0]
    
    print ('[INFO] master at host %s, port %s, user %s, database %s' % 
           (GV.opt['-h'], GV.opt['-p'], GV.opt['-U'], GV.dbname))
    

#############
def connect(user=None, password=None, host=None, port=None, 
            database=None, utilityMode=False):
    '''Connect to DB using parameters in GV'''
    options = utilityMode and '-c gp_session_role=utility' or None
    if not user: user = GV.opt['-U']
    if not password: password = GV.opt['-P']
    if not host: host = GV.opt['-h']
    if not port: port = GV.opt['-p']
    if not database: database = GV.dbname
    try:
        db = pg8000.Connection(user=user, password=password, host=host,
                                port=port, database=database, options=options)
    except pg8000.errors.ProgrammingError, p:
        print "Exception: ", p[0]
        print "SQL code: ", p[1]
        print p[2]
        sys.exit(1)
         
    return db

#############
def connect2(cfgrec, user=None, password=None, database=None):
    host = cfgrec['hostname']
    port = cfgrec['port']
    datadir = cfgrec['datadir']
    veryverbose('[INFO] connect %s:%s:%s' % (host, port, datadir))
    key = "%s.%s.%s.%s.%s.%s" % (host, port, datadir, user, password, database)
    conn = GV.db.get(key)
    if conn:
        return conn

    conn = connect(host=host, port=port, user=user, password=password, 
                   database=database, utilityMode=True)
    if conn:
        conn.x_cfgrec = cfgrec
        GV.db[key] = conn
    
    return conn



#############
def connect2run(qry, col):
    verbose('[INFO] %s' % qry)
        
    batch = []
    for dbid in GV.cfg:
        c = GV.cfg[dbid]
        db = connect2(c)
        db.execute(qry)
        batch.append( db )

    err = []
    for db in batch:
        for row in db.iterate_dict():
            c = db.x_cfgrec
            err.append([c, col, row])
        db.commit()

    return err

def formatErr(c, col, row):
    s = ('%s:%s:%s, content %s, dbid %s' % 
        (c['hostname'], c['port'], c['datadir'],
         c['content'], c['dbid']))
    for i in col:
        s = '%s, %s %s' % (s, i, row[i])
    return s

#############
def getGPConfiguration():
    cfg = {}
    db = connect()
    db.execute("select * from gp_configuration")
    for row in db.iterate_dict():
	if row['content'] == -1 and not row['isprimary']:
	    continue	# skip standby master
        cfg[row['dbid']] = row
    db.close()
    return cfg



