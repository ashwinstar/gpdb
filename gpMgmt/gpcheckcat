def checkPGClass():
    print '-----------------------------------'
    print 'Checking pg_class ...'
    qry = '''SELECT relname, relkind, tc.oid as oid,
              reltoastrelid, reltoastidxid 
         FROM pg_class tc left outer join 
              pg_attribute ta on (tc.oid = ta.attrelid)
        WHERE ta.attrelid is NULL'''
    err = connect2run(qry, ('relname', 'relkind', 'oid'))
    if not err:
        print '[OK] pg_class'
    else:
        print '[ERROR] pg_class has %d issue(s)' % len(err)
        print '[ERROR] %s' % qry
        for e in err: print '[ERROR]', formatErr(e[0], e[1], e[2])
        relids = {}
        for e in err:
            seg = e[0]['dbid'] 
            if not relids.has_key(seg):
                relids[seg] = []
            
            relids[seg].append(e[2]['oid'])    

        for seg in relids:
            rels = relids[seg] 
            for relid in rels:
                c = GV.cfg[seg]
                removeTable(seg, connect2(c), relid)


