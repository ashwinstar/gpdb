# remove all remnants of a schema
def removeSchema(seg, db, schemaid):
    # see if table has a toast table and if so, remove that
    # must do it like this so we can get toast tables
    qry = 'select oid from pg_class where relnamespace = %i' % schemaid
    db.execute(qry)
    for row in db.iterate_dict():
        removeTable(seg, db, row['oid'])


    buildRemove(seg, 'schema operators', 'pg_operator',
                dict([('oprnamespace', schemaid)]))

    buildRemove(seg, 'schema types', 'pg_type',
                dict([('typnamespace', schemaid)]))

    buildRemove(seg, 'schema procedures', 'pg_proc',
                dict([('pronamespace', schemaid)]))

    removeDepend(seg, db, schemaid)
    

#############
def removeTable(seg, db, reloid):
    # see if table has a toast table and if so, remove that
    db.execute('select oid, reltoastrelid, reltoastidxid from pg_class ' + 
			   'where oid = %i' % reloid)
    for row in db.iterate_dict():
        addRemove(seg, '-- Checking for toast relation for %i' % reloid) 
        if row['reltoastrelid'] != 0:
            removeTable(seg, db, row['reltoastrelid'])
        addRemove(seg, '-- Checking for toast relation index for %i' % reloid) 
    
    removeInheritance(seg, db, reloid)
    removeStats(seg, db, reloid)
    removeAttributes(seg, db, reloid)
    removeRelTuple(seg, db, reloid)
    removeIndexes(seg, db, reloid)
    removeRelType(seg, db, reloid)
    removeExtTable(seg, db, reloid)
    if seg == -1:
        removePolicy(seg, db, reloid)

def removeInheritance(seg, db, reloid):
    buildRemove(seg, 'inheritance', 'pg_inherits',
                dict([('inhrelid', reloid),('inhparent', reloid)]))

def removeStats(seg, db, reloid):
    buildRemove(seg, 'statistics', 'pg_statistic',
                dict([('starelid', reloid)]))

def removeRelTuple(seg, db, reloid):
    buildRemove(seg, 'relation tuple', 'pg_class',
                dict([('oid', reloid)]))

def removeExtTable(seg, db, reloid):
    buildRemove(seg, 'external table definition', 'pg_exttable',
                dict([('reloid', reloid)]))

def removePolicy(seg, db, reloid):
    buildRemove(seg, 'Distribution policy', 'gp_distribution_policy',
                dict([('localoid', reloid)]))

def removeAttributes(seg, db, reloid):
    buildRemove(seg, 'attributes', 'pg_attribute',
                dict([('attrelid', reloid)]))
    removeAttrDefs(seg, db, reloid)
    removeConstraints(seg, db, reloid)

def removeAttrDefs(seg, db, reloid):
    buildRemove(seg, 'attribute defaults', 'pg_attrdef',
                dict([('adrelid', reloid)]))

def removeConstraints(seg, db, reloid):
    buildRemove(seg, 'constraints', 'pg_constraint',
                dict([('conrelid', reloid)]))

def removeRelType(seg, db, reloid):
    buildRemove(seg, 'relation type tuple', 'pg_type',
                dict([('typrelid', reloid)]))

def removeIndexes(seg, db, reloid):
    buildRemove(seg, 'indexes', 'pg_index', dict([('indrelid', reloid)]))

def removeDepend(seg, db, reloid):
    buildRemove(seg, 'dependencies', 'pg_depend',
                dict([('objid', reloid), ('refobjid', reloid)]))
    buildRemove(seg, 'shared dependencies', 'pg_shdepend',
                dict([('objid', reloid), ('refobjid', reloid)]))

def buildRemove(seg, name, table, cols):
    first = False
    fullstr = ''
    str = ''
    for col in cols:
        if not first:
            fullstr = '--Remove %s for %i\n' % (name, cols[col])
        if len(str) > 0:
            str += ' or '
        str += '%s = \'%s\'' % (col, cols[col])
    fullstr += 'DELETE FROM %s WHERE %s;' % (table, str)
    addRemove(seg, fullstr)

def addRemove(seg, line):
    if not Remove.has_key(seg):
        Remove[seg] = []
    Remove[seg].append(line)


#############
if __name__ == '__main__':
    parseCommandLine()
    GV.cfg = getGPConfiguration()

    checkPGClass()
    checkPGAttribute()
    checkPGType()
    checkPGExtTable()
    checkPGClassToast()
    checkPGNamespace()
    
    if GV.opt['-g'] != None:
        try:
            if not os.path.exists(GV.opt['-g']):
                os.mkdir(GV.opt['-g'])
        except Exception, e:
            print '[FATAL] unable to create directory "%s": %s' % (GV.opt['-g'],
                  str(e))
            sys.exit(1)
                        
        for seg in Remove:
            # dbid.host.port.dbname.sql
            c = GV.cfg[seg]
            filename = '%s/%i.%s.%i.%s.sql' % (GV.opt['-g'], seg, c['hostname'],
                        c['port'], GV.dbname)
            try:
                file = open(filename, 'w')
            except Exception, e:
                print '[FATAL] unable to create file "%s": %s' % (filename, str(e))
                sys.exit(1)

            lines = set(Remove[seg])
            for line in lines:
                file.write(line + '\n')

            file.close()

