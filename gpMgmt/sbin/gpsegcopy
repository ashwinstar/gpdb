import os, sys
from optparse import Option, OptionGroup, OptionParser, OptionValueError, SUPPRESS_USAGE

from gppylib.gpparseopts import OptParser, OptChecker
from gppylib.gplog import *
from gppylib.segcopy import *

description = (""" 
This utility is NOT SUPPORTED and is for internal-use only.

Creates a copy of a GPDB segment.
""")

_help = ["""
"""]


EXECNAME = os.path.split(__file__)[-1]


#----------------------- Command line option parser ----------------------

def parseargs():
    #TODO:  integrate with the real product version
    parser = OptParser(option_class=OptChecker,
                description=' '.join(description.split()),
                version="%prog 1.0")
    parser.setHelp(_help)
    parser.set_usage('%prog [--help] [options] srchost:srcdir dsthost:dstdir')
    parser.remove_option('-h')
    
        
    parser.add_option('-c','--clean', action='store_true',
                        help='remove all files under the remote directory before performing the copy.')
    parser.add_option('-d','--debug', action='store_true',
                        help='debug output.')
                        
    parser.add_option('-h', '-?', '--help', action='help',
                        help='show this help message and exit')
    parser.add_option('-q', '--quiet', action='store_true',
                        help='suppress status messages')
    parser.add_option('-s', '--schema_only', action='store_true',
                        help='copy only the schema (no data)')
    parser.add_option('-m', '--method', type='choice', choices=['c', 'copy', 's', 'sync'],
                      metavar='c[opy]|s[ync]', action='store', default='sync', 
                      help=('set the method of segment copy'))

    
    parser.set_defaults(verbose=True, filters=[], slice=(None, None))
    
    
    # Parse the command line arguments
    (options, args) = parser.parse_args()
    
    #parse positional arguments
    if len(args) != 2:
        parser.print_help()
        parser.exit()
       
    return options, args


def parsePositionalArgs(args,logger):
        
    srcInfo=args[0].split(':')
    dstInfo=args[1].split(':')

    if len(srcInfo) != 2:
        raise SegcopyError, "Invalid srcHost:srcDir specificed: '%s'" % args[0]
    if len(dstInfo) != 2:
        raise SegcopyError, "Invalid dstHost:dstDir specificed: '%s'" % args[1]

    srcHost=srcInfo[0]
    srcDir=srcInfo[1]
    dstHost=dstInfo[0]
    dstDir=dstInfo[1]
    
    return (srcHost,srcDir,dstHost,dstDir)


#------------------------------- Mainline --------------------------------

try:
    logger = get_default_logger()
    setup_tool_logging(EXECNAME,getLocalHostname(),getUserName())  
    
    options, args = parseargs()
    (srcHost,srcDir,dstHost,dstDir)=parsePositionalArgs(args,logger)  
    
    if options.debug:
        enable_verbose_logging()
    
    if options.quiet:
        quiet_stdout_logging()

    logger.info("Starting: %s"  % ' '.join(sys.argv))
        
    if options.clean:
        logger.debug("clean remote directory first specified.")
    
    if options.schema_only:
        logger.debug("schema_only specified.")
        logger.info("schema_only option not yet implemented.")
        sys.exit()  
    
    logger.debug("creating GpSegCopy object")    
    segcopy = GpSegCopy(logger,srcHost,srcDir,dstHost,dstDir,options.clean,options.schema_only,options.method, verbose=options.debug)
    segcopy.pre_check()
    segcopy.copy()


except ExecutionError, e:
    logger.exception("Segment copy failed. exiting...")
    sys.exit(3)
except SegcopyError, e:
    logger.exception("Segment copy failed. exiting...")
    sys.exit(2)
except KeyboardInterrupt:
    sys.exit('\nUser Interrupted')