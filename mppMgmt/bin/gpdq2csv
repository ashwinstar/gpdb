#!/usr/bin/env python
'''
gpdq2csv -- generate csv file from gpdq output

Usage: gpdq2csv file 
'''

import os, sys

if sys.version_info < (2, 3):
    sys.exit("Error: gpdq2csv is supported on Python versions 2.3 or greater\n"
	     + "Please upgrade python installed on this machine.")

sys.path.append(sys.path[0] + '/lib')
try:
    pass
except ImportError, e:
    sys.exit('Error: unable to import module: ' + str(e))


def usage(exitarg): print __doc__; sys.exit(exitarg)

if len(sys.argv) != 2: usage(1)

out = {}
hosttab = {}
disktab = {}

f = open(sys.argv[1])
try:
    for line in f:
	t = line.split()
	if len(t) == 0 or t[0] != '!': continue
	if len(t) == 7: t = t[:6]
	(mark, host, disk, min, max, avg) = t
	if not out.has_key(disk): out[disk] = {}
	out[disk][host] = avg
	hosttab[host] = 1
	disktab[disk] = 1
finally:
    f.close()

hosttab = hosttab.keys()
hosttab.sort()
disktab = disktab.keys()
disktab.sort()

#print title
print '""',
for h in hosttab:
    print (',%s' % h),
print

#print data
for d in disktab:
    print d,
    for h in hosttab:
	print (',%s' % out[d][h]),
    print
