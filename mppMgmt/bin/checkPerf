    import checkPerfResults
    import gpLogger
    import logging
except ImportError, e:
    print
    print "Error Importing necessary modules: %s " % str(e)
    print
    raise SystemExit, -1


class CheckPerf:
    """ 
        CheckPerf class
        Reads given a groupSesssion and configDetails.
        Performs tests on different nodes.
    """
