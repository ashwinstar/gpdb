#!/usr/bin/env python
"""
checkPerf -- Check the hardware for MPP software


Usage: checkPerf -c config-file -h hostfile  <options>

-h hostfile - a list of remote hosts, each entry of the form:
   username@host
   username@host2
or just:
   host1
   host2

-c configfile file that contains configuration for checkPerf.
-l logFile , where all the info and debug messages go.
-o outPutFile, File to write the results of each test.
-m configSpecFile, Location of configSpec file.


-v  Enable verbose
-d  Enable debug

ssh options.
-p <port> Port Number to use for ssh connections.
-s Disable set up of trusted host key access.
-x Establish trusted key across all sessions, using ssh-keys.


-n :  No of times each test is repeated.
-e :  Repeat the tests untile 't' seconds is elapsed.
-t :  Tolerance, (0.1, 0.99) Tolerance of results.


"""

import os, sys, threading, time, string, getpass, getopt, signal, commands
import traceback
from stat import *

if sys.version_info < (2, 3):
    print "Error checkPerf is supported on Python versions 2.3 or greater."
    print "Please upgrade python installed on this machine."
    raise SystemExit, -1


sys.path.append(sys.path[0]+'/lib')
try :
    import sshParamikoModule as sshParamikoModule, threadpool as threadpool
    import host
