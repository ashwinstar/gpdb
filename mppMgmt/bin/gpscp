#!/usr/bin/env python

'''
gpscp -- scp to multiple hosts at once

Usage: gpscp [-?v] [-p port] [-u user] 
             [-h host] [-f hostfile] local_file remote_file

             -?      : print this help screen
	     -v	     : verbose mode
	     -p port : ssh port to use 
	     -u user : ssh user to run command
	     -h host : ssh host to connect to (multiple -h is okay)
	     -f file : a file listing all hosts to connect to

Author: cktan@greenplum.com
'''

import sys, getopt, popen2, os

if sys.version_info < (2, 3):
    sys.exit("Error: gpscp is supported on Python versions 2.3 or greater\n"
	     + "Please upgrade python installed on this machine.")

#
# all the command line options
#
opt = {}
opt['-v'] = False
opt['-p'] = 22
opt['-u'] = os.environ.get('LOGNAME') or os.environ.get('USER')
opt['-h'] = []
opt['-f'] = None
localPath = None
remotePath = None
cmd = []
session = []

################
def usage(exitarg):
    print __doc__
    sys.exit(exitarg)

def parsePort(val): 
    try: return int(val)
    except ValueError: return 0

#############
def parseCommandLine():
    global opt, cmd, localPath, remotePath
    try:
	(options, args) = getopt.getopt(sys.argv[1:], '?vp:u:h:f:')
    except Exception, e:
	usage('Error: invalid option')

    for (switch, val) in options:
	if (switch == '-?'): 	    usage(0)
	elif (switch == '-v'):      opt[switch] = True
	elif (switch[1] in 'uf'):   opt[switch] = val
	elif (switch == '-h'):      opt[switch].append(val)
	elif (switch == '-p'):      opt[switch] = parsePort(val)

    if not (opt['-p'] > 0): usage('Error: please specify port number for -p switch')

    if (len(args) != 2):
	usage('Error: please specify local and remote file paths')

    if (len(opt['-h']) and opt['-f']):
	usage('Error: please specify either -h or -f args, but not both')

    localPath = args[0]
    remotePath = args[1]


################
def parseHostLine(line):
    '''Parse line into (user, host, port) tuple'''
    try:
	t = line.strip().split('@')
	cnt = len(t)
	if t[0][0] == '#': return None
        if cnt == 1: return (opt['-u'], t[0], opt['-p'])
	if cnt == 2: 
	    tt = t[1].split(':')
	    cnt = len(tt)
	    if cnt == 1: return (t[0], tt[0], opt['-p'])
	    elif cnt == 2: return (t[0], tt[0], int(tt[1]))
    except ValueError: pass
    except IndexError: pass
    return None


#############
def readHostFile(fname, retList):
    if not fname: return
    f = None; lno = 0; host = {}
    try:
	try:
	    f = open(fname, 'r')
	    for line in f:
		lno = lno + 1
		h = parseHostLine(line)
		if not h: continue
		key = '%s@%s' % (h[0], h[1])
		host[key] = h
	    for n in host: retList.append(host[n])
	except IOError:
	    sys.exit('[ERROR] cannot read host file ' + fname 
		     + (lno > 0 and (' (line %d)' % lno) or ''))
    finally:
	if f: f.close()





#############
try:
    parseCommandLine()
    tab = []
    for h in opt['-h']:
	h = parseHostLine(h)
	if h: tab.append(h)
	else: usage('Error: invalid -h argument')

    readHostFile(opt['-f'], tab)
    tab.sort(lambda x, y: cmp(x[0], y[0]) or cmp(x[1], y[1]))
    opt['-h'] = tab

    scp = 'scp -o "BatchMode yes" -o "StrictHostKeyChecking no"'
    proc = []
    for (user, host, port) in opt['-h']:
	cmd = scp + ' -P %d %s %s@%s:%s' % (port, localPath, user, host, remotePath)
	if opt['-v']: print '[INFO]', cmd
	p = popen2.Popen4(cmd)
	p.x_cmd = cmd
	p.x_user = user
	p.x_host = host
	p.x_peer = '%s@%s' % (user, host)
	p.tochild.close()
	proc.append(p)

    errmsg = None
    for p in proc:
	for out in p.fromchild: 
	    print '[OUT %s] %s' % (p.x_peer, out)
	status = p.wait()
	if status:
	    errmsg = '[ERROR %s] failed %d' % (p.x_peer, status)
	    print errmsg

    if errmsg: sys.exit(1)
    if opt['-v']: print '[INFO] completed successfully'

except KeyboardInterrupt:
    sys.exit('\nInterrupted...')
