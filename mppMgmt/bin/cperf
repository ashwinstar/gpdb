def runDiskWriteTest():
    if opt['-v']:
	print '--------------------'
	print '  DISK WRITE TEST'
	print '--------------------'
    B = opt['-B']
    C = math.ceil(opt['-S'] / B)
    cmd = ''
    cnt = 0
    for d in opt['-d']:
	cmd = cmd + 'dd if=/dev/zero of=%s/checkPerf/ddfile%d count=%d bs=%d & ' % (d, cnt, C, B)
	cnt = cnt + 1
    cmd = cmd + 'wait'
    cmd = GPSSH + 'time -p ' + cmd
    (ok, out) = run(cmd)
    if not ok: 
	print '[Error] command failed: ', cmd
	raise SystemExit, 1
    return parseTimeResult(out, C * B * cnt)


def runDiskReadTest():
    if opt['-v']:
	print '--------------------'
	print '  DISK READ TEST'
	print '--------------------'
    B = opt['-B']
    C = math.ceil(opt['-S'] / B)
    cmd = ''
    cnt = 0
    for d in opt['-d']:
	cmd = cmd + 'dd of=/dev/null if=%s/checkPerf/ddfile%d count=%d bs=%d & ' % (d, cnt, C, B)
	cnt = cnt + 1
    cmd = cmd + 'wait'
    cmd = GPSSH + 'time -p ' + cmd
    (ok, out) = run(cmd)
    if not ok: 
	print '[Error] command failed: ', cmd
	raise SystemExit, 1
    return parseTimeResult(out, C * B * cnt)



def parseStreamResult(out):
    out = StringIO.StringIO(out)
    result = {}
    for line in out:
	i = line.index(']')
	o = line[i+2:]
	if o.startswith('Copy:'): 
	    h = line[1:i]
	    o = o.split()
	    result[h] = (float(o[1]), 0, 0)
    return result


def runStreamTest():
    if opt['-v']:
	print '--------------------'
	print '  STREAM TEST'
	print '--------------------'
    spath = sys.path[0] + '/lib/stream'
    try:
	spathStat = os.stat(spath)
    except:
	print '[Error] cannot stat stream binaries', spath
	raise SystemExit, 1
    if not stat.S_ISREG(spathStat.st_mode):
	print '[Error] invalid stream binaries', spath
	raise SystemExit, 1
    if not spathStat.st_mode & os.X_OK:
	print '[Error] not executable binaries', spath
	raise SystemExit, 1
    
    d = opt['-d'][0]

    cmd = GPSCP + ('%s %s/checkPerf/stream' % (spath, d))
    (ok, out) = run(cmd)
    if not ok:
	print '[Error] command failed:', cmd
	raise SystemExit, 1

    cmd = GPSSH + ('chmod +x %s/checkPerf/stream' % d)
    (ok, out) = run(cmd)
    if not ok:
	print '[Error] command failed:', cmd
	raise SystemExit, 1

    cmd = GPSSH + ('%s/checkPerf/stream' % d)
    (ok, out) = run(cmd)
    if not ok:
	print '[Error] command failed:', cmd
	raise SystemExit, 1

    return parseStreamResult(out)

################
def printResult(title, result):
    totTime = 0
    totBytes = 0
    min = 99999999
    max = 0
    minHost = maxHost = None
    for h in result:
	(mbs, time, bytes) = result[h]
	totTime += time
	totBytes += bytes
	if min > mbs: 
	    min = mbs
	    minHost = h
	if max < mbs: 
	    max = mbs
	    maxHost = h

    avgTime = totTime / len(result)

    if (totTime > 0):
	print '%s avg time      : %3.2f sec' % (title, avgTime)
    if (totBytes > 0):
	print '%s tot bytes     : %d' % (title, totBytes)
    print '%s min bandwidth : %3.2f MB/s [%s]' % (title, min, minHost)
    print '%s max bandwidth : %3.2f MB/s [%s]' % (title, max, maxHost)
    print

################
parseCommandLine()
runSetup()
diskWriteResult = diskReadResult = StreamResult = None
tornDown = False
try:
    if opt['-r'].find('d') >= 0:
	diskWriteResult = runDiskWriteTest()
	diskReadResult = runDiskReadTest()

    if opt['-r'].find('s') >= 0:
	streamResult = runStreamTest()

    tornDown = True
    runTeardown()

finally:
    if diskWriteResult:
	printResult('disk write', diskWriteResult)

    if diskReadResult:
	printResult('disk read', diskReadResult)

    if streamResult:
	printResult('stream', streamResult)

    if not tornDown: runTeardown()

