#!/usr/bin/env python
"""
checkPerf -- Check the hardware for MPP software

Usage: checkPerf <options> hostfile 

    -d <segdir>   where segdir is a directory on which to test I/O performance. 
    		  Multiple -d flags may be specified for multiple directories
		  on each host. These will typically be your Greenplum primary
		  (and/or mirror) data directories. 
                  e.g. -d /dbfast1 -d /dbfast2
    [-?]          print this help text
    [-v]          enable verbose
    [-V]	  enable very verbose
    [-r <flags>]  where flags specifies the tests to run [default=ds]. 
                  Supported test flags are:
                     d: runs only disk tests
                     s: runs only stream benchmark
    [-B <size>]   where size specifies the block size for disk performance tests
                  [default=8KB] e.g. 1KB, 4MB
    [-S <size>]   where size specifies the file size for disk performance tests
    	 	  [default=2X Memory] e.g. 500MB, 16GB
    [-p <port>]   where port is the ssh port number [default=22]

"""
import os, sys, getopt, math, StringIO, stat

if sys.version_info < (2, 3):
    sys.exit("Error: groupSession is supported on Python versions 2.3 or greater\n"
	     + "Please upgrade python installed on this machine.")

def usage(exitarg):
    print __doc__
    sys.exit(exitarg)

opt = {}
opt['-d'] = []
opt['-v'] = False
opt['-V'] = False
opt['-r'] = 'ds'
opt['-B'] = 1024 * 8
opt['-S'] = 0
opt['-p'] = 22
hostfile = ''
GPSSH = ''
GPSCP = ''


################
def parseMemorySize(line):
    factor = 1
    try:
	line = line.strip().upper()
	if line.endswith('B'): line = line[:-1]
	if line.endswith('G'):
	    factor = 1024 * 1024 * 1024
	    line = line[:-1]
	elif line.endswith('M'):
	    factor = 1024 * 1024
	    line = line[:-1]
	elif line.endswith('K'):
	    factor = 1024
	    line = line[:-1]
	return int(line) * factor
    except:
	return 0


#############
def parseCommandLine():
    global opt, hostfile, GPSSH, GPSCP
    try:
	(options, args) = getopt.getopt(sys.argv[1:], '?vVd:r:B:S:p:')
    except Exception, e:
	usage('Error: ' + e)

    for (switch, val) in options:
	if (switch == '-?'): usage(0)
	elif (switch[1] in 'vV'): opt[switch] = True
	elif (switch == '-d'): opt[switch].append(val)
	elif (switch == '-r'): opt[switch] = val
	elif (switch == '-p'):
	    try: opt[switch] = int(val)
	    except: sys.exit('Error: please specify a number for %s switch' % switch)
	elif (switch[1] in 'BS'): opt[switch] = parseMemorySize(val)

    if (len(opt['-d']) == 0): 
	usage('Error: please specify at least one segdir (-d switch)')

    if not (0 <= opt['-B'] and 0 <= opt['-S']):
	usage('Error: please enter valid memory sizes for -B or -S switches')

    if (len(args) < 1):	usage('Error: please specify hostfile')

    hostfile = args[0]
    if opt['-V']: opt['-v'] = True
    GPSSH = 'gpssh -p %d -f %s %s ' % (opt['-p'], hostfile, opt['-V'] and '-v' or '')
    GPSCP = 'gpscp -p %d -f %s ' % (opt['-p'], hostfile)

#############
def run(cmd):
    f = out = None
    ok = False
    try:
	if opt['-v']: print '[Info]', cmd
	f = os.popen(cmd)
	out = f.read()
	ok = not f.close()
	f = None
    except:
	if f: f.close()
	ok = False
	out = None

    if opt['-v'] and out and out != '': print out
    return (ok, out)

#############
def runTeardown():
    if opt['-v']:
	print '--------------------'
	print '  TEARDOWN'
	print '--------------------'
    for d in opt['-d']:
	try:
	    cmd = GPSSH + ('rm -rf %s/checkPerf' % d)
	    (ok, out) = run(cmd)
	except:
	    pass

#############
def runSetup():
    if opt['-v']:
	print '--------------------'
	print '  SETUP'
	print '--------------------'
    okCount = 0
    try:
	for d in opt['-d']:
	    cmd = GPSSH + ('mkdir -p %s/checkPerf' % d);
	    (ok, out) = run(cmd)
	    if not ok: 
		sys.exit('[Error] command failed: ' + cmd)
	    okCount = okCount + 1
    except:
	if (okCount > 1): runTeardown()
	raise

################
def copyExecOver(fname):
    path = '%s/lib/%s' % (sys.path[0], fname)
    try: pathStat = os.stat(path)
    except: sys.exit('[Error] cannot stat file ' + path)
    if not stat.S_ISREG(pathStat.st_mode): sys.exit('[Error] invalid file ' + path)
    if not pathStat.st_mode & os.X_OK: sys.exit('[Exit] file not executable: ' + path)

    #copy to this dir
    d = opt['-d'][0]
    target = '%s/checkPerf/%s' % (d, fname)
    cmd = GPSCP + ('%s %s' % (path, target))
    (ok, out) = run(cmd)
    if not ok: sys.exit('[Error] command failed: ' + cmd)
    
    #chmod +x file
    cmd = GPSSH + ('chmod +x %s' % target)
    (ok, out) = run(cmd)
    if not ok: sys.exit('[Error] command failed: ' + cmd)
    
    return target


#############
def parseMultiDDResult(out):
    # parse output of "time -p"
    out = StringIO.StringIO(out)
    result = {}
    bytes = 0
    for line in out:
	i = line.find(']')
	if i == -1: continue
	o = line[i+2:]

	if o.startswith('multidd total bytes '):
	    h = line[1:i]
	    o = o.split()
	    bytes = int(o[-1])
	    continue
	    
	if o.startswith('real'):
	    h = line[1:i]
	    o = o.split()
	    time = float(o[1])
	    if time < 0.1: time = 0.1 		# avoid division by zero
	    mbps = bytes / time / 1024 / 1024
	    result[h] = (mbps, time, bytes)
	    continue

    return result



#############
def runDiskWriteTest():
    if opt['-v']:
	print '--------------------'
	print '  DISK WRITE TEST'
	print '--------------------'
    
    rmtPath = copyExecOver('multidd')
    cmd = 'time -p ' + rmtPath
    for d in opt['-d']:
	cmd = cmd + (' -i /dev/zero -o %s/checkPerf/ddfile' % d)
    if opt['-B']: cmd = cmd + (' -B %d' % opt['-B'])
    if opt['-S']: cmd = cmd + (' -S %d' % opt['-S'])
    cmd = GPSSH + cmd
    (ok, out) = run(cmd)
    if not ok:
	sys.exit('[Error] command failed: ' + cmd)
    return parseMultiDDResult(out)


#############
def runDiskReadTest():
    if opt['-v']:
	print '--------------------'
	print '  DISK READ TEST'
	print '--------------------'

    rmtPath = copyExecOver('multidd')
    cmd = 'time -p ' + rmtPath
    for d in opt['-d']:
	cmd = cmd + (' -o /dev/null -i %s/checkPerf/ddfile' % d)
    if opt['-B']: cmd = cmd + (' -B %d' % opt['-B'])
    if opt['-S']: cmd = cmd + (' -S %d' % opt['-S'])
    cmd = GPSSH + cmd
    (ok, out) = run(cmd)
    if not ok:
	sys.exit('[Error] command failed: ' + cmd)
    return parseMultiDDResult(out)


#############
def parseStreamResult(out):
    out = StringIO.StringIO(out)
    result = {}
    for line in out:
	i = line.find(']')
	o = line[i+2:]
	if o.startswith('Copy:'): 
	    h = line[1:i]
	    o = o.split()
	    result[h] = (float(o[1]), 0, 0)
    return result


#############
def runStreamTest():
    if opt['-v']:
	print '--------------------'
	print '  STREAM TEST'
	print '--------------------'

    rmtPath = copyExecOver('stream')
    cmd = GPSSH + rmtPath
    (ok, out) = run(cmd)
    if not ok: sys.exit('[Error] command failed: ' + cmd)

    return parseStreamResult(out)

################
def printResult(title, result):
    totTime = 0
    totBytes = 0
    min = 99999999
    max = 0
    minHost = maxHost = None
    for h in result:
	(mbps, time, bytes) = result[h]
	totTime += time
	totBytes += bytes
	if min > mbps: 
	    min = mbps
	    minHost = h
	if max < mbps: 
	    max = mbps
	    maxHost = h

    avgTime = totTime / len(result)

    if (totTime > 0):
	print '%s avg time      : %3.2f sec' % (title, avgTime)
    if (totBytes > 0):
	print '%s tot bytes     : %d' % (title, totBytes)
    print '%s min bandwidth : %3.2f MB/s [%s]' % (title, min, minHost)
    print '%s max bandwidth : %3.2f MB/s [%s]' % (title, max, maxHost)
    print

################
parseCommandLine()
runSetup()
diskWriteResult = diskReadResult = streamResult = None
tornDown = False
try:
    if opt['-r'].find('d') >= 0:
	diskWriteResult = runDiskWriteTest()
	diskReadResult = runDiskReadTest()

    if opt['-r'].find('s') >= 0:
	streamResult = runStreamTest()

    tornDown = True
    runTeardown()

finally:
    if diskWriteResult:
	printResult('disk write', diskWriteResult)

    if diskReadResult:
	printResult('disk read', diskReadResult)

    if streamResult:
	printResult('stream', streamResult)

    if not tornDown: runTeardown()

