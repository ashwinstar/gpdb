#!/usr/bin/env python
"""
checkPerf -- Check the hardware for MPP software

Usage: checkPerf <options> hostfile 

    -d <segdir>   where segdir is a directory on which to test I/O performance. 
    		  Multiple -d flags may be specified for multiple directories
		  on each host. These will typically be your Greenplum primary
		  (and/or mirror) data directories. 
                  e.g. -d /dbfast1 -d /dbfast2
    [-?]          print this help text
    [-v]          enable verbose
    [-t <float>]  where float is the tolerance of results 
                  [default=0.1, range 0.00 ... 0.50]
    [-r <flags>]  where flags specifies the tests to run [default=ds]. 
                  supported test flags are:
                     d: runs only dd tests
                     s: runs only stream benchmark
    [-B <size>]   where size specifies the block size for disk performance tests
                  [default=8KB] e.g. 1KB, 4MB
    [-S <size>]   where size specifies the file size for disk performance tests
    	 	  [default=1GB] e.g. 500MB, 16GB
    [-p <port>]   where port is the ssh port number [default=22]

"""
import os, sys, getopt, math, StringIO, stat

if sys.version_info < (2, 3):
    print "Error: groupSession is supported on Python versions 2.3 or greater."
    print "Please upgrade python installed on this machine."
    raise SystemExit, -1

opt = {}
opt['-d'] = []
opt['-v'] = False
opt['-t'] = 0.1
opt['-r'] = 'ds'
opt['-B'] = 1024*8
opt['-S'] = 1024*1024*1024
opt['-p'] = 22
hostfile = ''
GPSSH = ''
GPSCP = ''


################
def parseMemorySize(line):
    factor = 1
    try:
	line = line.strip().upper()
	if line.endswith('GB'):
	    factor = 1024 * 1024 * 1024
	    line = line[:-2]
	elif line.endswith('G'):
	    factor = 1024 * 1024 * 1024
	    line = line[:-1]
	elif line.endswith('MB'):
	    factor = 1024 * 1024
	    line = line[:-2]
	elif line.endswith('M'):
	    factor = 1024 * 1024
	    line = line[:-1]
	elif line.endswith('KB'):
	    factor = 1024
	    line = line[:-2]
	elif line.endswith('K'):
	    factor = 1024
	    line = line[:-1]

	return int(line) * factor
    except:
	return 0


#############
def parseCommandLine():
    global opt, hostfile, GPSSH, GPSCP
    try:
	(options, args) = getopt.getopt(sys.argv[1:], '?vl:d:t:r:B:S:p:')
    except Exception, e:
	print __doc__
	print 'Error:', e
	raise SystemExit, 1

    for (switch, val) in options:
	if (switch == '-?'):
	    print __doc__
	    sys.exit(0)
	elif (switch == '-v'):
	    opt[switch] = True
	elif (switch == '-d'):
	    opt[switch].append(val)
	elif (switch == '-r'):
	    opt[switch] = val
	elif (switch == '-p'):
	    try:
		opt[switch] = int(val)
	    except:
		print 'Error: please specify a number for %s switch' % switch
		raise SystemExit, 1
	elif (switch[1] in 'BS'):
	    try:
		opt[switch] = parseMemorySize(val)
	    except:
		print 'Error: please specify byte size for %s switch' % switch
		raise SystemExit, 1
	elif (switch == '-t'):
	    try:
		opt[switch] = float(val)
	    except:
		print 'Error: please specify a number for %s switch' % switch
		raise SystemExit, 1

    if not (0 < opt['-t'] and opt['-t'] < 1):
	print 'Error: please specify number between 0 and 1 for -t switch'
	raise SystemExit, 1

    if (len(opt['-d']) == 0):
	print 'Error: please specify at least one segdir (-d switch)'
	raise SystemExit, 1

    if not (0 < opt['-B'] and 0 < opt['-S']):
	print 'Error: please enter valid memory sizes for -B or -S switches'
	raise SystemExit, 1

    if (len(args) < 1):
	print __doc__
	print 'Error: please specify hostfile' 
	raise SystemExit, 1

    hostfile = args[0]
    GPSSH = 'gpssh -p %d -f %s ' % (opt['-p'], hostfile)
    GPSCP = 'gpscp -p %d -f %s ' % (opt['-p'], hostfile)

def run(cmd):
    f = out = None
    ok = False
    try:
	if opt['-v']: print '[Info]', cmd
	f = os.popen(cmd)
	out = f.read()
	ok = not f.close()
    except:
	if f: f.close()
	ok = False
	out = None

    if opt['-v'] and out and out != '': print out
    return (ok, out)

def runTeardown():
    if opt['-v']:
	print '--------------------'
	print '  TEARDOWN'
	print '--------------------'
    for d in opt['-d']:
	try:
	    cmd = GPSSH + ('rm -rf %s/checkPerf' % d)
	    (ok, out) = run(cmd)
	except:
	    pass

def runSetup():
    if opt['-v']:
	print '--------------------'
	print '  SETUP'
	print '--------------------'
    okCount = 0
    try:
	for d in opt['-d']:
	    cmd = GPSSH + ('mkdir -p %s/checkPerf' % d);
	    (ok, out) = run(cmd)
	    if not ok: 
		print '[Error] command failed:', cmd
		raise SystemExit, 1
	    else:
		okCount = okCount + 1
    except:
	if (okCount > 1): runTeardown()
	raise


def parseTimeResult(out, bytes):
    # parse output of "time -p"
    out = StringIO.StringIO(out)
    result = {}
    for line in out:
	i = line.index(']')
	o = line[i+2:]
	if o.startswith('real'):
	    h = line[1:i]
	    o = o.split()
	    time = float(o[1])
	    if time < 0.1: time = 0.1 		# avoid division by zero
	    mbs = bytes / time / 1024 / 1024
	    result[h] = (mbs, time, bytes)
    return result

