#!/usr/bin/env python

'''
gpssh -- ssh access to multiple hosts at once

Usage: gpssh [-?vb] [-d dir] [-p port] [-u user] [-h host] [-f hostfile] cmd

             -?      : print this help screen
	     -v	     : verbose mode
	     -p port : ssh port to use 
	     -u user : the user to run command
	     -h host : the host to connect to (multiple -h is okay)
	     -f file : a file listing all hosts to connect to

Author: cktan@greenplum.com
'''

import os, sys, getopt, popen2

if sys.version_info < (2, 3):
    sys.exit("Error: gpssh is supported on Python versions 2.3 or greater\n"
	     + "Please upgrade python installed on this machine.")

sys.path.append(sys.path[0] + '/lib')
try:
    pass
    #    import paramiko
except ImportError, e:
    sys.exit('Error: unable to import module: ' + str(e))

#
# all the command line options
#
opt = {}
opt['-v'] = False
opt['-p'] = 22
opt['-u'] = os.environ.get('LOGNAME') or os.environ.get('USER')
opt['-h'] = []
opt['-f'] = False
cmd = []
session = []

################
def usage(exitarg):
    print __doc__
    sys.exit(exitarg)

def parsePort(val): 
    try: return int(val)
    except ValueError: return 0


#############
def parseCommandLine():
    global opt, cmd
    try:
	(options, args) = getopt.getopt(sys.argv[1:], '?vp:u:h:f:')
    except Exception, e:
	usage('Error: ' + str(e))

    for (switch, val) in options:
	if (switch == '-?'):	     usage(0)
	elif (switch == '-v'):       opt[switch] = True
	elif (switch[1] in 'uf'):    opt[switch] = val
	elif (switch == '-h'):       opt[switch].append(val)
	elif (switch == '-p'):       opt[switch] = parsePort(val)

    if (len(args) < 1): usage('Error: please specify command')
    if not opt['-p'] > 0: usage('Error: please specify port number for -p switch')

    hf = (len(opt['-h']) and 1) + (opt['-f'] and 1)
    if hf != 1:
	usage('Error: please specify at least one of -h or -f args, but not both')

    cmd = " ".join(args)


################
def parseHostLine(line):
    '''Parse line into (user, host, port) tuple'''
    try:
	t = line.strip().split('@')
	cnt = len(t)
	if t[0][0] == '#': return None
        if cnt == 1: return (opt['-u'], t[0], opt['-p'])
	if cnt == 2: 
	    tt = t[1].split(':')
	    cnt = len(tt)
	    if cnt == 1: return (t[0], tt[0], opt['-p'])
	    elif cnt == 2: return (t[0], tt[0], int(tt[1]))
    except ValueError: pass
    except IndexError: pass
    return None

#############
def readHostFile(fname, retList):
    if not fname: return
    f = None; lno = 0; host = {}
    try:
	try:
	    f = open(fname, 'r')
	    for line in f:
		lno = lno + 1
		h = parseHostLine(line)
		if not h: continue
		key = '%s@%s' % (h[0], h[1])
		host[key] = h
	    for n in host: retList.append(host[n])
	except IOError:
	    sys.exit('[ERROR] cannot read host file ' + fname 
		     + (lno > 0 and (' (line %d)' % lno) or ''))
    finally:
	if f: f.close()


#############
def createSession(cmd):
    session = []
    user = {}
    for h in opt['-h']: user[h[0]] = h
    sameUser = (len(user) == 1)
    
    for h in opt['-h']:
	ssh = 'ssh -p %d -o "BatchMode yes" -o "StrictHostKeyChecking no" %s@%s' % (h[2], h[0], h[1])
	ssh = ssh + ' "%s" ' % cmd
	if opt['-v']: print '[INFO %s@%s] %s' % (h[0], h[1], cmd)
	p = popen2.Popen4(ssh)
	p.x_user = h[0]; p.x_host = h[1]
	p.x_cmd = cmd;   p.x_ssh = ssh
	p.x_peer = sameUser and h[1] or ('%s@%s' % (h[0], h[1]))
	p.tochild.close()
	session.append(p)
    
    return session

def waitSession(session):
    errmsg = None
    for p in session:
	for out in p.fromchild:
	    if len(out) > 1: 
		print '[%s] %s' % (p.x_peer, out[:-1])
	status = p.wait()
	if status:
	    errmsg = '[ERROR %s] failed %d' % (p.x_peer, status)
	    print errmsg

    if errmsg: sys.exit(1)


#############
try:
    parseCommandLine()
    tab = []
    for h in opt['-h']: 
	h = parseHostLine(h)
	if h: tab.append(h)
        else: usage('Error: invalid -h argument')

    readHostFile(opt['-f'], tab)
    tab.sort(lambda x, y: cmp(x[0], y[0]) or cmp(x[1], y[1]))
    opt['-h'] = tab

    session = createSession(cmd)
    waitSession(session)
    if opt['-v']: print '[INFO] completed successfully'

except KeyboardInterrupt:
    sys.exit('\nInterrupted...')
