#!/usr/bin/env python

'''
gpssh -- ssh access to multiple hosts at once

Usage: gpssh [-?v] [-p port] [-u user] [-h host] [-f hostfile] [cmd]

             -?      : print this help screen
	     -v	     : verbose mode
	     -p port : ssh port to use 
	     -u user : the user to run command
	     -h host : the host to connect to (multiple -h is okay)
	     -f file : a file listing all hosts to connect to
	     cmd     : the command to execute. If not present, go into interactive mode

Author: cktan@greenplum.com
'''

import os, sys, getopt, popen2, cmd, signal, time, atexit, threading

if sys.version_info < (2, 3):
    sys.exit("Error: gpssh is supported on Python versions 2.3 or greater\n"
	     + "Please upgrade python installed on this machine.")

sys.path.append(sys.path[0] + '/lib')
try:
    import pxssh, pexpect
except ImportError, e:
    sys.exit('Error: unable to import module: ' + str(e))


#
# all the command line options
#
opt = {}
opt['-v'] = False
opt['-p'] = 22
opt['-u'] = os.environ.get('LOGNAME') or os.environ.get('USER')
opt['-h'] = []
opt['-f'] = False
argcmd = None
session = []

################
def usage(exitarg):
    print __doc__
    sys.exit(exitarg)

def parsePort(val): 
    try: return int(val)
    except ValueError: return 0


#############
def parseCommandLine():
    global opt, argcmd
    try:
	(options, args) = getopt.getopt(sys.argv[1:], '?vp:u:h:f:')
    except Exception, e:
	usage('Error: ' + str(e))

    for (switch, val) in options:
	if (switch == '-?'):	     usage(0)
	elif (switch == '-v'):       opt[switch] = True
	elif (switch[1] in 'uf'):    opt[switch] = val
	elif (switch == '-h'):       opt[switch].append(val)
	elif (switch == '-p'):       opt[switch] = parsePort(val)

    if not opt['-p'] > 0: usage('Error: please specify port number for -p switch')

    hf = (len(opt['-h']) and 1) + (opt['-f'] and 1)
    if hf != 1:
	usage('Error: please specify at least one of -h or -f args, but not both')

    if (len(args) >= 1):
	argcmd = " ".join(args)


################
def parseHostLine(line):
    '''Parse line into (user, host, port) tuple'''
    try:
	t = line.strip().split('@')
	cnt = len(t)
	if t[0][0] == '#': return None
        if cnt == 1: return (opt['-u'], t[0], opt['-p'])
	if cnt == 2: 
	    tt = t[1].split(':')
	    cnt = len(tt)
	    if cnt == 1: return (t[0], tt[0], opt['-p'])
	    elif cnt == 2: return (t[0], tt[0], int(tt[1]))
    except ValueError: pass
    except IndexError: pass
    return None

#############
def readHostFile(fname, retList):
    if not fname: return
    f = None; lno = 0; host = {}
    try:
	try:
	    f = open(fname, 'r')
	    for line in f:
		lno = lno + 1
		h = parseHostLine(line)
		if not h: continue
		key = '%s@%s' % (h[0], h[1])
		host[key] = h
	    for n in host: retList.append(host[n])
	except IOError:
	    sys.exit('[ERROR] cannot read host file ' + fname 
		     + (lno > 0 and (' (line %d)' % lno) or ''))
    finally:
	if f: f.close()


#############
def createOneTimeSession(cmd):
    session = []
    user = {}
    for h in opt['-h']: user[h[0]] = h
    sameUser = (len(user) == 1)
    
    for h in opt['-h']:
	ssh = 'ssh -p %d -o "BatchMode yes" -o "StrictHostKeyChecking no" %s@%s' % (h[2], h[0], h[1])
	ssh = ssh + ' "%s" ' % cmd
	if opt['-v']: print '[INFO %s@%s] %s' % (h[0], h[1], cmd)
	p = popen2.Popen4(ssh)
	p.x_user = h[0]; p.x_host = h[1]
	p.x_cmd = cmd;   p.x_ssh = ssh
	p.x_peer = sameUser and h[1] or ('%s@%s' % (h[0], h[1]))
	p.tochild.close()
	session.append(p)
    
    return session

def waitOneTimeSession(session):
    errmsg = None
    permissionDenied = False
    for p in session:
	for out in p.fromchild:
	    if len(out) > 1: 
		print '[%s] %s' % (p.x_peer, out[:-1])
		if not permissionDenied:
		    permissionDenied = (out.find('Permission denied') >= 0)
	status = p.wait()
	if status:
	    errmsg = '[ERROR %s] Command failed. Exit status = %s' % (p.x_peer, status)
	    print errmsg
		
    if permissionDenied:
	print
	print 'hint: check if the host is alive'
	print 'hint: use gpssh-exkeys to setup public-key authentication between hosts'
	print
    if errmsg: sys.exit(1)


def closePxsshPid(pxssh, pid):
    pxssh.close(force = True)
    try:
	os.kill(pid, 9)
	(pid, status) = os.waitpid(pid, 0)
    except OSError: 
	pass


#############
class Session(cmd.Cmd):
    def __init__(self):
	cmd.Cmd.__init__(self)
	self.pxssh = []
	self.pid = []
	self.prompt = '=> '

    def login(self, hostList):
	print '\n[Reset ...]'
	self.clean()
	user = {}
	for h in hostList: user[h[0]] = h
	sameUser = (len(user) == 1)
	for h in hostList:
	    p = pxssh.pxssh()
	    p.loginAsync(h[1], h[0], port=h[2])
	    p.x_user = h[0]; p.x_host = h[1]
	    p.x_peer = sameUser and h[1] or ('%s@%s' % (h[0], h[1]))
	    self.pxssh.append(p)
	    self.pid.append(p.pid)
	for p in self.pxssh:
	    print '[INFO] login %s' % p.x_peer
	    if not p.loginWait():
		print '[ERROR] unable to login to %s' % p.x_peer
		print
		print 'hint: use gpssh-exkeys to setup public-key authentication between hosts'
		print
		sys.exit(1)


    def clean(self):
	while True:
	    try:
		for i in xrange(len(self.pxssh)):
		    t = threading.Thread(target=closePxsshPid, args=(self.pxssh[i], self.pid[i]))
		    t.start()
		    self.pxssh[i].x_thread = t
		for i in xrange(len(self.pxssh)):
		    self.pxssh[i].x_thread.join()
		break
	    except KeyboardInterrupt:
		pass
	self.pxssh = []
	self.pid = []

    def emptyline(self):
	pass


    def default(self, line):
	if line == 'EOF': 
	    sys.exit(0)
	line = line.split('\\');
	line = '\\\\'.join(line);
	line = line.split('"');
	line = '\\"'.join(line);
	line = 'bash -c "' + line + '" < /dev/null';
	for s in self.pxssh:
	    s.sendline(line)
	    s.flush()
	for s in self.pxssh:
	    s.prompt()
	    out = s.before.split('\n')
	    out = out[1:-1]
	    if len(out) == 0:
		print '[%s]' % s.x_peer
	    else:
		for line in out:
		    print '[%s] %s' % (s.x_peer, line)
    

session = None
def cleanup():
    while True:
	try:
	    if session: session.clean()
	    break
	except KeyboardInterrupt:
	    pass


sigint_time = 0
def sigint_handle(signum, frame):
    global sigint_time
    now = time.time()
    if now - sigint_time >= 3: 
	sigint_time = now
	raise KeyboardInterrupt
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    print '\n[Exiting...]'
    sys.exit(1)


def interactive():
    global session
    try:
	import readline
        #Read in the saved command history, if any
	histfile = os.path.join(os.environ["HOME"], ".gshist")
	# Set the maximum number of commands to 100
	readline.set_history_length(500)
	try:
	    readline.read_history_file(histfile)
	except IOError:
	    pass
	atexit.register(readline.write_history_file, histfile)
    except Exception, e:
	print "Note: command history unsupported on this machine ..."

    atexit.register(cleanup)
    signal.signal(signal.SIGINT, sigint_handle)
    while True:
	try:
	    if session: 
		print '\n[Cleanup...]'; 
		session.clean()
		session = None
	    session = Session()
	    session.login(opt['-h'])
	    session.cmdloop()
	except pexpect.EOF:
	    print '\n[Unexpected EOF from some hosts...]'
	    pass
	except KeyboardInterrupt:
	    print '\n[Interrupt...]'
	    pass



#############
try:
    parseCommandLine()
    tab = []
    for h in opt['-h']: 
	h = parseHostLine(h)
	if h: tab.append(h)
        else: usage('Error: invalid -h argument')

    readHostFile(opt['-f'], tab)
    tab.sort(lambda x, y: cmp(x[0], y[0]) or cmp(x[1], y[1]))
    opt['-h'] = tab

    if argcmd:
	s = createOneTimeSession(argcmd)
	waitOneTimeSession(s)
	if opt['-v']: print '[INFO] completed successfully'
	sys.exit(0)

    interactive()

except KeyboardInterrupt:
    sys.exit('\nInterrupted...')
