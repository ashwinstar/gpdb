#!/usr/bin/env python

'''
gpssh -- ssh access to multiple hosts at once

Usage: gpssh [-?vb] [-d dir] [-p port] [-u user] [-h host] [-f hostfile] cmd

             -?      : print this help screen
	     -v	     : verbose mode
       	     -b	     : cmd should be run in the background
	     -d	dir  : cmd should be run in the directory dir
	     -p port : ssh port to use 
	     -u user : the user to run command
	     -h host : the host to connect to (multiple -h is okay)
	     -f file : a file listing all hosts to connect to

Author: cktan@greenplum.com
'''

import os, sys, getopt, logging

if sys.version_info < (2, 3):
    sys.exit("Error: gpssh is supported on Python versions 2.3 or greater\n"
	     + "Please upgrade python installed on this machine.")

sys.path.append(sys.path[0] + '/lib')
try:
    import paramiko
except ImportError, e:
    sys.exit('Error: unable to import module: ' + str(e))

#
# all the command line options
#
opt = {}
opt['-b'] = False
opt['-v'] = False
opt['-d'] = '~/'
opt['-p'] = 22
opt['-u'] = os.environ.get('LOGNAME') or os.environ.get('USER')
opt['-h'] = []
opt['-f'] = False
cmd = []
session = []

################
def usage(exitarg):
    print __doc__
    sys.exit(exitarg)

def parsePort(val): 
    try: return int(val)
    except ValueError: return 0


#############
def parseCommandLine():
    global opt, cmd
    try:
	(options, args) = getopt.getopt(sys.argv[1:], '?bvtd:p:u:h:f:')
    except Exception, e:
	usage('Error: invalid option')

    for (switch, val) in options:
	if (switch == '-?'):	     usage(0)
	elif (switch[1] in 'bv'):    opt[switch] = True
	elif (switch[1] in 'duf'):   opt[switch] = val
	elif (switch == '-h'):       opt[switch].append(val)
	elif (switch == '-p'):       opt[switch] = parsePort(val)

    if (len(args) < 1): usage('Error: please specify command')
    if not opt['-p'] > 0: usage('Error: please specify port number for -p switch')

    hf = (len(opt['-h']) and 1) + (opt['-f'] and 1)
    if hf != 1:
	usage('Error: please specify at least one of -h or -f args, but not both')

    cmd = args


################
def parseHostLine(line):
    '''Parse line into (user, host, port) tuple'''
    try:
	t = line.strip().split('@')
	cnt = len(t)
	if t[0][0] == '#': return None
        if cnt == 1: return (opt['-u'], t[0], opt['-p'])
	if cnt == 2: 
	    tt = t[1].split(':')
	    cnt = len(tt)
	    if cnt == 1: return (t[0], tt[0], opt['-p'])
	    elif cnt == 2: return (t[0], tt[0], int(tt[1]))
    except ValueError: pass
    except IndexError: pass
    return None

#############
def readHostFile(fname, retList):
    if not fname: return
    f = None; lno = 0; host = {}
    try:
	try:
	    f = open(fname, 'r')
	    for line in f:
		lno = lno + 1
		h = parseHostLine(line)
		if not h: continue
		key = '%s@%s' % (h[0], h[1])
		host[key] = h
	    for n in host: retList.append(host[n])
	except IOError:
	    sys.exit('[ERROR] cannot read host file ' + fname 
		     + (lno > 0 and (' (line %d)' % lno) or ''))
    finally:
	if f: f.close()


#############
def createSession():
    global opt, session
    user = {}
    port = {}
    for h in opt['-h']: user[h[0]] = port[h[2]] = h
    sameUser = len(user) == 1
    samePort = len(port) == 1
    for h in opt['-h']:
	try:
	    s = paramiko.SSHClient()
	    s.load_system_host_keys()
	    s.connect(h[1], h[2], h[0])
	    s.name = ''
	    if not sameUser: s.name = h[0] + '@'
	    s.name = s.name + h[1]
	    if not samePort: s.name = s.name + ':' + h[2]
	    if opt['-v']: print 'Info: connected to', s.name
	    session.append(s)
	except paramiko.SSHException, e:
	    print 'SSH Connect Failed: %s@%s:%d' % h,
	    print ' -', e
	    sys.exit(100)
	except KeyboardInterrupt:
	    raise
	except:
	    print ('Error: while connecting to %s@%s:%d' % h)
	    raise


#############
def buildCommand():
    shcmd = 'cd ' + opt['-d']
    shcmd = shcmd + ' && ' + ' '.join(cmd)
    shcmd = shcmd.encode('string_escape')
    t = shcmd.split('"')
    shcmd = '\\"'.join(t)
    shcmd = 'bash -c "%s" 2>&1' % shcmd
    if (opt['-b']): shcmd = shcmd + ' &'
    return shcmd



#############
try:
    nullFile = logging.FileHandler('/dev/null')
    logging.getLogger('paramiko.transport').addHandler(nullFile)
    
    parseCommandLine()
    tab = []
    for h in opt['-h']: 
	h = parseHostLine(h)
	if h: tab.append(h)
        else: usage('Error: invalid -h argument')

    opt['-h'] = tab
    readHostFile(opt['-f'], opt['-h'])

    createSession()
    shcmd = buildCommand()
    for s in session:
	if (opt['-v']): print ('Info: exec %s on %s' % (shcmd, s.name))
	stdin, stdout, stderr = s.exec_command(shcmd)
	s.mystdout = stdout

    for s in session:
	for line in s.mystdout: 
	    print '[%s] %s' % (s.name, line),

except KeyboardInterrupt:
    sys.exit('\nInterrupted...')
