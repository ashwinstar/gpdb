#!/usr/bin/env python
'''
gpssh-exkeys -- exchange keys

Usage: gpssh-exkeys [-?v] [-u user] [-h host] [-f hostfile]

Author: cktan@greenplum.com
'''

import os, sys, getopt, time, getpass

if sys.version_info < (2, 3): 
    sys.exit("[ERROR] gpssh-exkeys is supported on Python versions 2.3 or greater\n"
             + "Please upgrade python installed on this machine.")

sys.path.append(sys.path[0] + '/lib')
try:
    import pexpect, pxssh
except ImportError, e:
    sys.exit('[ERROR] unable to import module: ' + str(e))


def usage(exitarg):
    print __doc__
    sys.exit(exitarg)

opt = {}
opt['-v'] = False
opt['-p'] = 22
opt['-u'] = os.environ.get('LOGNAME') or os.environ.get('USER')
opt['-h'] = []
opt['-f'] = False
passwd = []
authorized_keys_fname = '%s/.ssh/authorized_keys' % os.environ['HOME']
known_hosts_fname = '%s/.ssh/known_hosts' % os.environ['HOME']
hostList = []


class Host: 
    def __init__(self, user, host):
	self.m_user = user
	self.m_host = host
	self.m_name = '%s@%s' % (user, host)
	self.m_popen = None
	self.m_popen_cmd = ''
	self.m_pxssh = None
	self.m_remoteID = None

    def name(self): return self.m_name
    def user(self): return self.m_user
    def host(self): return self.m_host
    def remoteID(self): return self.m_remoteID
    def popen_cmd(self): return self.m_popen_cmd;

    def login(self, passwd):
	if self.m_pxssh: return self.m_pxssh
	p = pxssh.pxssh()
	ok = False
	try:
	    ok = p.login(self.m_host, self.m_user)
	    if not ok:
		for pwd in passwd:
		    ok = p.login(self.m_host, self.m_user, pwd)
		    if ok: break
		while not ok:
		    print '  ***'
		    pwd = getpass.getpass('  *** Enter password for %s@%s: ' % (self.m_user, self.m_host))
		    if pwd: ok = p.login(self.m_host, self.m_user, pwd)
		    if ok: passwd.append(pwd)
	except:
	    if p.before and p.before.find('Connection refused') >= 0:
		# sshd not running or not acccepting connection
		errmsg = '[ERROR %s] connection refused.' % self.m_name
	    else:
		errmsg = '[ERROR %s] unable to connect ... is it up and running? ' % self.m_name

	    print errmsg
	    p = None

	self.m_pxssh = ok and p or None
	return self.m_pxssh 

    def logout(self):
	if self.m_pxssh: self.m_pxssh.logout()
	self.m_pxssh = None

    def sendLocalID(self, ID):
	if not self.m_pxssh: return False
	p = self.m_pxssh
	cmd = 'mkdir .ssh; chmod 0700 .ssh; cd .ssh'
	if opt['-v']: print '[INFO %s]: %s' % (self.m_name, cmd)
	p.sendline(cmd); p.prompt()
	p.sendline('pwd'); p.prompt()
	dir = p.before.strip()
	if dir and len(dir) > 5 and dir[-5:] == '/.ssh':
	    pass
	else:
	    return False
	    
	cmd = 'echo %s >> authorized_keys && echo done done done' % ID
	if opt['-v']: print '[INFO %s]: %s' % (self.m_name, cmd)
	p.sendline(cmd); 
	if 0 == p.expect(['done done done']):
	    if 0 == p.expect(['done done done']):
		p.prompt()
		return True

	p.prompt()
	return False

    def startRemoteKeygen(self):
	if not self.m_pxssh: return False
	p = self.m_pxssh
	cmd = 'ssh-keygen -t rsa -N \"\" -f id_rsa; echo done done done'
	if opt['-v']: print '[INFO %s]: %s' % (self.m_name, cmd)
	p.sendline(cmd); 
	return 0 == p.expect(['done done done'])

    def waitRemoteKeygen(self):
	if not self.m_pxssh: return False
	p = self.m_pxssh
	i = p.expect(['done done done', 'Overwrite'])
	if (i == 1):
	    time.sleep(0.1)
	    p.sendline('y')
	    i = p.expect(['done done done'])
	return i == 0

    def popen(self, cmd):
	if self.m_popen: self.m_popen.close()
	if opt['-v']: print '[INFO %s]: %s' % (self.m_name, cmd)
	self.m_popen = os.popen(cmd)
	self.m_popen_cmd = cmd
	return self.m_popen

    def pclose(self):
	if not self.m_popen: return (False, None)
	content = self.m_popen.read()
	ok = not self.m_popen.close()
	return (ok, content)

    def setRemoteID(self, ID):
	self.m_remoteID = ID


def parseCommandLine():
    global opt
    try:
	(options, args) = getopt.getopt(sys.argv[1:], '?vp:u:h:f:')
    except Exception, e:
	usage('[ERROR] invalid option')

    for (switch, val) in options:
	if (switch == '-?'): 
	    usage(0)
	elif (switch == '-v'):
	    opt[switch] = True
	elif (switch[1] in 'uf'):
	    opt[switch] = val
	elif (switch == '-h'):
	    opt[switch].append(val)
#	elif (switch == '-p'):
#	    try:
#		opt[switch] = int(val)
#	    except:
#		usage('[ERROR] please specify port number for -p switch')

    hf = (len(opt['-h']) and 1) + (opt['-f'] and 1)
    if hf != 1:
        usage('[ERROR] please specify at least one of -h or -f args, but not both')


def parseHostLine(line):
    '''Parse line into (user, host, port) tuple'''
    res = None
    t = line.strip().split('@')
    cnt = len(t)
    if len(line) and line[0] == '#': pass
    elif cnt == 1: res = [opt['-u'], t[0], opt['-p']]
    elif cnt == 2: 
	tt = t[1].split(':')
	cnt = len(tt)
	if cnt == 1: res = [t[0], tt[0], opt['-p']]
	elif cnt == 2:
	    try: res = [t[0], tt[0], int(tt[1])]
	    except: pass
    return res

def readHostFile():
    global opt
    hostlines = []
    if opt['-f']:
        try:
            fd = open(opt['-f'], 'r')
            hostlines = fd.readlines()
            fd.close()
        except IOError, e:
            sys.exit('[ERROR] cannot read host file' + opt['-f'])
    
    host = {}
    line = 0 
    try:
	for h in hostlines:
            line = line + 1
            h = parseHostLine(h)
            if not h: continue
	    key = '%s@%s' % (h[0], h[1])
            if host.has_key(key): continue     # ignore duplicate hosts
            host[key] = h
            opt['-h'].append(h)
    except KeyboardInterrupt:
	raise
    except:
	sys.exit('[ERROR] while parsing line %d of host file %s' % (line, opt['-f']))


###  create local id_rsa
def createLocalID():
    file = '%s/.ssh/id_rsa' % os.environ.get('HOME')
    cmd = 'ssh-keygen -t rsa -N \"\" -f %s' % file
    if opt['-v']: print '[INFO] executing', cmd
    p = pexpect.spawn(cmd)
    if not p: 
	sys.exit('[ERROR] unable to run ssh-keygen')

    ok = False
    i = p.expect([pexpect.EOF, 'Overwrite'])
    if i == 0: 
	p.close()
	ok = (p.exitstatus == 0)
    if i == 1:
	time.sleep(0.1)
	p.sendline('n')
	i = p.expect(pexpect.EOF)
	p.close()
	ok = True

    if not ok:
	sys.exit('[ERROR] ssh-keygen failed')

    file = file + '.pub'
    f = open(file, 'r')
    if not f: 
	sys.exit('[ERROR] ssh-keygen failed - unable to find the generated file ' + file)

    line = f.readline()
    f.close()
    return line.strip()

def authorizeLocalID(localID):
    cmd = 'cd ~/.ssh && echo %s >> authorized_keys' % localID
    f = os.popen(cmd)
    i = f.read();
    ok = not f.close()
    if not ok: 
	sys.exit('[ERROR] while in authorizeLocalID() -  %s' % cmd)

    tt = localID.split()
    h = parseHostLine(tt[2])
    h = Host(h[0], h[1])
    if h.login({}):
	h.logout()
    else:
	sys.exit('[ERROR] while in authorizeLocalID() -  %s' % cmd)


def addRemoteID(tab, line):
    if not line: return False
    line = line.strip()
    if len(line) == 0 or line[0] == '#': return False
    IDKey = line.split()
    IDKey = len(IDKey) == 3 and IDKey[2] or None
    if not IDKey: return False
    tab[IDKey] = line
    return tab

def readAuthorizedKeys():
    tab = {}
    f = None
    try:
	f = open(authorized_keys_fname, 'w+')
	for line in f: addRemoteID(tab, line)
    finally:
	if f: f.close()
    return tab


def writeAuthorizedKeys(tab):
    f = None
    try: 
	f = open(authorized_keys_fname, 'w')
	for IDKey in tab: f.write(tab[IDKey] + '\n')
	return tab
    finally:
	if f: f.close()


def addKnownHosts(tab, host):
    cmd = 'cd ~/.ssh && grep -v %s known_hosts > known_hosts.tmp' % host
    f = os.popen(cmd)
    i = f.read();
    ok = not f.close()
    if ok: 
	cmd = 'cd ~/.ssh && ssh-keyscan -t rsa %s >> known_hosts.tmp && mv -f known_hosts.tmp known_hosts' % host
	f = os.popen(cmd)
	i = f.read()
	ok = not f.close()
    return ok


try:
    parseCommandLine()
    tab = []
    for h in opt['-h']: 
	h = parseHostLine(h)
	if h: 
	    tab.append(h)
	else:
	    usage('[ERROR] invalid -h parameter')

    opt['-h'] = tab
    readHostFile()

    for h in opt['-h']: hostList.append(Host(h[0], h[1]))

    print '[STEP 1 of 6] create local ID'
    errmsg = None
    localID = createLocalID()
    authorizeLocalID(localID)

    print; print '[STEP 2 of 6] copy to remote host and generate remote host ID'  # serial
    for h in hostList:
	print '  ... login to', h.name()
	if not h.login(passwd): 
	    errmsg = '[ERROR %s] unable to login' % h.name()
	elif not h.sendLocalID(localID): 
	    errmsg = '[ERROR %s] unable to send local ID' % h.name()
	if errmsg: print errmsg

    if not errmsg: 
	for h in hostList:
	    print '  ... remote key-gen at', h.name()
	    if not h.startRemoteKeygen(): 
		errmsg = '[ERROR %s] unable to ssh-keygen' % h.name()
		print errmsg

    if not errmsg: 
	for h in hostList:
	    if not h.waitRemoteKeygen(): 
		errmsg = '[ERROR %s] unable to ssh-keygen' % h.name()
		print errmsg

    for h in hostList: h.logout()
    if errmsg: 
	sys.exit(1)

    print; print '[STEP 3 of 6] obtain remote ID'  # parallel

    # now, include local ID in hostList so we also obtain our own key
    tt = localID.split()
    h = parseHostLine(tt[2])
    hostList.append(Host(h[0], h[1]))

    for h in hostList: 
	print '  ... ssh to %s for id_rsa.pub' % h.name()
	cmd = 'ssh -o \"NumberOfPasswordPrompts 0\" %s@%s cat ~%s/.ssh/id_rsa.pub' % (h.user(), h.host(), h.user())
	h.popen(cmd)

    for h in hostList:
	(ok, content) = h.pclose()
	if ok: 
	    h.setRemoteID(content)
	else:
	    errmsg = '[ERROR %s] command failed: %s\n%s' % (h.name(), h.popen_cmd(), content)
	    print errmsg

    if errmsg: 
	sys.exit(1)

    print; print '[STEP 4 of 6] merge authorized keys locally'
    try:
	tab = readAuthorizedKeys()
    except IOError: 
	sys.exit('[ERROR] cannot read authorized_keys file')

    errmsg = None
    addRemoteID(tab, localID)
    for h in hostList:
	if not addRemoteID(tab, h.remoteID()):
	    errmsg = "[ERROR] missing remote id_rsa.pub from %s" % h.name()
	    print errmsg
    
    try:
	if not errmsg: writeAuthorizedKeys(tab)
    except IOError:
	errmsg = "[ERROR] unable to write authroized_keys file"
	print errmsg

    if errmsg:
	sys.exit(1)

    print; print '[STEP 5 of 6] merge known_hosts locally'
    for h in hostList:
	if not addKnownHosts(tab, h.host()): 
	    errmsg = "[WARNING] unable to add %s to known_hosts file" % h.host()
	    print errmsg

    print; print '[STEP 6 of 6] copy authorized_keys and known_hosts to all remote hosts'
    errmsg = None
    for h in hostList:
	cmd = 'scp -q %s %s %s@%s:.ssh/' % (authorized_keys_fname, known_hosts_fname, h.user(), h.host())
	h.popen(cmd)

    for h in hostList:
	(ok, content) = h.pclose()
	if ok: 
	    print '[INFO] finished key exchange with', h.name()
	else:
	    errmsg = "[ERROR] unable to copy authorized_keys to %s" % h.name()
	    print errmsg
    
    if errmsg:
	sys.exit(1)

    print; print '[INFO] Key exchange completed successfully.'
except KeyboardInterrupt:
    sys.exit('\n\nInterrupted...')
