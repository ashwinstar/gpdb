#
# This is a configuration file for the checkPerf utility.
# syntax for this file is based on python module configobj-4.3.2.
#
#############################################################
# GENERAL CHECKPERF CONFIGURATION SECTION
#############################################################
# This section contains configuration parameters applicable to the
# entire checkPerf utility
#
[ "CheckPerf" ]
#
# Tolerance is the acceptable percentage of variance allowed between
# the average results of all hosts and the results of an individual
# hosts. All hosts with performance lower than the allowed tolerance
# will be listed in the output report. 
# For example, all hosts that are 5% below the maximum I/O for dd tests
# Type    : Float
# Range   : 0.01 - 0.99
# Default : 0.05
#
Tolerance=0.05
#
# The number of times each test should be performed. In most
# cases one time is sufficient, however you may want to run 
# a test several times and see the average performance results
# of multiple tests.
# Type    : Integer
# Range  : 1, 20
# Default : 5
#
RptCount=1
#
# A base directory that exists on each host that will be used
# to install and run the checkPerf software. The user who runs
# checkPerf must have read/write access to this directory.
#
baseDir="/home/bgadmin"
#
#
#############################################################
# DISK I/O CONFIGURATION SECTION
#############################################################
# This section contains configuration parameters applicable to the
# disk I/O performance test (dd)
#
[ "Disk Performance"]
#
# The directory path (or list of directory paths) on which to
# test I/O performance. These would typically be your Greenplum primary
# segment data directories, and perhaps your mirror data directories
# as well. Note that the extra comma is required at the end of the 
# list and each directory is in quotes.
# EXAMPLE: Directory_List= "/dbfast1", "/dbfast2", 
# EXAMPLE: Directory_List= "/gpdatadir", 
#
DirectoryList="/dbfast1", "/dbfast2", 
#
# Block size to be used for dd test. 8K is the same as the
# PostgreSQL/Greenplum Database page size.
# Range : String (int Followed by String [kK][Mm][gG][bB])
# Example : 1024, 1KB, 1MB, 10MB
# Default : 1K
#
BlockSize=8K
#
# NOTE: Leaving FileSize and Count set to 0 will cause
# the dd test to use 2 * total_RAM of the host machine, 
# giving you the best measure of true disk I/O performance
# rather than using memory for caching.
#
# File size to use for dd test. If set to 0, value will be
# calculated as 2 * total_RAM of the host machine. 
# Range : String (int Followed by String [kK][Mm][gG][bB])
# Example : 1024, 1KB, 1MB, 10MB
# Default : 0MB
#
FileSize=0
#
#
# Number of blocks to use for dd test. If FileSize is not 0, 
# Count is obtained from FileSize and BlockSize
# Range : Integer
# Default : 0
#
Count=0
#
#############################################################
# NETWORK TEST CONFIGURATION SECTION - NOT IMPLEMENTED YET
#############################################################
#
["Network Bandwidth"]
#
# Size of each Packet
# Type    : Integer
# Range   :  1k - 100k
# Default : 1K
#
PacketSize=1024
#
# No of packets to be send
# Type    : Integer
# Range   : 100-10000
# Default : 100
#
PacketNumber=100
