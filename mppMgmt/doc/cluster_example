# Set this to anything you like
ARRAY_NAME="LAL Laptop Cluster"

# This file must exist in the same directory that you execute mppcreatecluster.sh in
# and contains a list of hostnames that will form the cluster.
# If the QD hostname is in this file, QE's will also be created on the QD host.
MACHINE_LIST_FILE=hostlist

# This names the data directories for the Segment Instances and the Entry Postmaster
# The QD will be the fist segment to be created as the segment name will end with a 0
# (zero), all other segments will be incremented from zero.
SEG_PREFIX=lal

# This is the port range for the primary QE's, the QD can be assigned its own specific port number
# via the MASTER_PORT variable. 
PORT_BASE=60000

# Name for script created database, if commented out, will not create any database within cluster.
DATABASE_NAME=zlal

# Array of data locations for each hosts Segment Instances, the number of directories in this array will
# set the number of segment instances per host
declare -a DATA_DIRECTORY=(/Users/lukelonergan/datadirs/dbfast1 /Users/lukelonergan/datadirs/dbfast2 /Users/lukelonergan/datadirs/dbfast3)

# Name of host on which to setup the QD
MASTER_HOSTNAME=Luke-Lonergans-Computer.local

# Name of directory on that host in which to setup the QD
MASTER_DIRECTORY=/Users/lukelonergan/datadirs/dbfast1

# Specific port number for the QD instance
MASTER_PORT=50000

# Hosts to allow to connect to the QD (and Segment Instances)
# By default, allow everyone to connect (0.0.0.0/0)
IP_ALLOW="0.0.0.0/0"

# Shell to use to execute commands on all hosts
TRUSTED_SHELL="ssh"

CHECK_POINT_SEGMENTS=8
ENCODING=UNICODE

#Mirror parameters, comment out if mirroring not required

# Set the mirror port base to a different range from that of the primary port base.
#MIRROR_PORT_BASE=45000

# These are the directories where the mirror segments will be created on each host, make sure
# that the number of directories here match the number of primary directories, or the script
# will exit with an error
#declare -a MIRROR_DATA_DIRECTORY=(/dbfast3)

