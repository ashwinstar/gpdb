# FILE NAME: mpp_config

# A configuration file is needed by the mppcreatecluster.sh
# script to tell it how to configure the master and segment 
# instances in your Bizgres MPP system. This file can be named 
# whatever you like, and is referenced when you run mppcreatecluster.sh. 

################################################
# REQUIRED PARAMETERS
################################################

# A name for the array you are configuring. You can use any name you 
# like. Enclose the name in quotes if the name contains spaces.

ARRAY_NAME="MPP Test"


# This specifies the file that contains the list of segment host names 
# that comprise the Bizgres MPP system  the master host is assumed to 
# be the host from which you are running the script. If the host list 
# file does not reside in the same directory where the mppcreatecluster.sh 
# script is executed, specify the absolute path to the file.

MACHINE_LIST_FILE=/home/bgadmin/host_file


# Prefix used to name the data directories on the master and segment
# instances. The naming convention for data directories in a 
# Bizgres MPP system is SEG_PREFIXnumber where number starts with 0 
# (zero) for the MPP master and is incremented by one for each segment 
# instance created. So for example, if you choose the prefix mpp, your 
# master instance data directory would be named mpp0, and the segment 
# instances would be named mpp1, mpp2, mpp3, mpp4, and so on.


SEG_PREFIX=mpp


# Base port number on which primary segment instances will be 
# started on a segment host. If a host has multiple primary segment 
# instances, the base port number will be incremented by one for each 
# additional segment instance started on that host. 


PORT_BASE=50000


# This specifies the data storage location(s) where the script will 
# create the primary segment data directories. The script creates a 
# unique data directory for each segment instance. If you want multiple 
# segment instances per host, list a data storage area for each primary 
# segment you want created. The recommended number is one primary segment
# per CPU. It is OK to list the same data storage area multiple times 
# if you want your data directories created in the same location. The 
# number of data directory locations specified will determine the number 
# of primary segment instances per host.
 
# You must make sure that the user who runs mppcreatecluster.sh (for example, 
# the bgadmin user) has permissions to write to these directories. You 
# may want to create these directories on the segment hosts before running 
# mppcreatecluster.sh and chown them to the appropriate user.


declare -a DATA_DIRECTORY=(/mppdata/dbfast1 /mppdata/dbfast2)
# declare -a DATA_DIRECTORY=(/mpp_primary /mpp_primary)


# The host name of the MPP master instance.

MASTER_HOSTNAME=host01

# The location where the data directory will be created on the MPP 
# master host. 

# You must make sure that the user who runs mppcreatecluster.sh
# has permissions to write to this directory. You may want to 
# create this directory on the master host before running 
# mppcreatecluster.sh and chown it to the appropriate user.

MASTER_DIRECTORY=/mppdata/dbfast1


# The port number for the MPP master instance. This is the port number 
# that users and client connections will use when accessing the 
# Bizgres MPP system.

MASTER_PORT=5432

# The IP address(es) of the hosts allowed to connect to a MPP 
# master or segment instance. This adds an entry in the PostgreSQL 
# pg_hba.conf file on each master and segment instance created. 
# By default local host connections are already allowed. The following 
# setting will allow connections from all hosts.


IP_ALLOW=0.0.0.0/0

# The shell used the mppcreatecluster.sh script uses to execute 
# commands on remote hosts. Allowed value is ssh. You must set up 
# your trusted host environment before running the mppcreatecluster.sh 
# script. You can use groupSession to do this.


TRUSTED_SHELL=ssh

# Maximum distance between automatic write ahead log (WAL) 
# checkpoints, in log file segments (each segment is normally 16 
# megabytes). This will set the checkpoint_segments parameter 
# in the postgresql.conf file for each segment instance in the 
# Bizgres MPP system.

CHECK_POINT_SEGMENTS=8

# The character set encoding to use. Bizgres MPP supports the 
# same character sets as PostgreSQL. See 'Character Set Support'
# in the PostgreSQL documentation for allowed character sets. 

ENCODING=UNICODE


################################################
# OPTIONAL PARAMETERS
################################################

# Optional. Uncomment to create a database of this name after the
# system is initialized. You can always create a database later using 
# the CREATE DATABASE command or the createdb script.

#DATABASE_NAME=warehouse


################################################
# OPTIONAL PARAMETERS FOR SEGMENT MIRRORING
################################################

# Data mirroring is optional. Mirroring must be configured
# at system initialization time. You can not set up mirrors
# after Bizgres MPP has been set up. Uncomment these
# parameters to set up mirroring.

# The base port number on which mirror segment instances will be 
# started on a segment host. If a host has multiple mirror segment 
# instances, the base port number will be incremented by one for 
# each additional mirror segment instance started on that host. 
# Be sure to use a different number than the primary PORT_BASE.

#MIRROR_PORT_BASE=60000

# The data directory where mirror segment instances will be
# created on a host. There must be the same number of data directories 
# declared for mirror segment instances as for primary segment instances 
# (see the DATA_DIRECTORY parameter for more information).

# You must make sure that the user who runs mppcreatecluster.sh
# has permissions to write to these directories. You may want to 
# create these directories on the segment hosts before running 
# mppcreatecluster.sh and chown them to the appropriate user.


#declare -a MIRROR_DATA_DIRECTORY=(/mppdata/dbfast3 /mppdata/dbfast4)
#declare -a MIRROR_DATA_DIRECTORY=(/mpp_mirror /mpp_mirror)

################################################
# OPTIONAL PARAMETERS FOR A BACKUP MASTER HOST
################################################

# A backup master host is optional. A backup master must be configured
# at system initialization time. You can not set up a backup master
# after Bizgres MPP has been set up. Uncomment these parameters to 
# set up a backup master host. MPP keeps the primary and backup
# master hosts in synch. The master host has the global system catalog
# for Bizgres MPP, but not any user data.


