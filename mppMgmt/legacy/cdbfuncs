function getPort
{
    local port

    case $OSTYPE in

        # These systems only support Basic Regular Expressions (BREs)
        solaris|darwin*)
            local space=$(echo -en " \t\f\\\n\r\v")
            port=$(sed -n 's/^['"$space"']*port['"$space"']*=\{0,1\}['"$space"']*\([0-9]\{1,5\}\)['"$space"'#]\{0,1\}.*$/\1/p' $PGDATA/postgresql.conf)
            ;;
            
        # Everything else is presumed to support Extended Regular Expressions (EREs)
        *)
            port=$(sed -nr 's/^[[:space:]]*port[[:space:]]*=?[[:space:]]*([[:digit:]]{1,5})[[:space:]#]?$/\1/p' $PGDATA/postgresql.conf)
            ;;
    esac
    
    if [ ! $port ]; then
        echo "Error extracting port number from $PGDATA/postgresql.conf" >&2
        exit 1
    fi

    echo $port
}
