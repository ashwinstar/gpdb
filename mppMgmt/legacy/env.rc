#
# This file contains the set of environment variables that are needed to
# execute the cdb utility functions correctly. To include this in your path
# just source the file. E.g. source ./env.rc
#
# $Id$
#

# The root data directory. This is where all of the data files will be created
# during the createdb phase.
PGROOT=$HOME/cdb-data

# The base port for the first segDB instance. This will be used for the first
# PG instance that is created, and then all other instances will be on
# incrementally ascending ports.
PGPORT=10000

# The set of options to be exported
PGOPTIONS='-c cdb_session_role=utility'

# The base path for where cdb-pg has been compiled to, or installed
PGPATH=$HOME/cdb/devo/pgsql
PATH=$PGPATH/bin:$PATH

export PGROOT PGPORT PGPATH PATH PGOPTIONS
