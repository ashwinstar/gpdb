#---------------------------------------------------------------------
# Makefile for Greenplum Database
#
#             $Id$
#         $Change$
#       $DateTime$
#         $Author$
#---------------------------------------------------------------------

# keep the default target above any targets from included makefiles
all : devel

#---------------------------------------------------------------------
# Declare the targets
#---------------------------------------------------------------------

# Targets for building GPDB with various options
# (development builds)
.PHONY : devel devel_faultinj 

# (release builds)
.PHONY : dist dist_prof 

# Targets which refresh files via rsync before building
.PHONY : dbg opt both

# Targets recognized by the PostgreSQL makefile (cdb-pg/GNUmakefile)
.PHONY : all install installdirs uninstall distprep
.PHONY : clean distclean maintainer-clean
.PHONY : check installcheck installcheck-parallel

# Targets for running regression tests
.PHONY : installcheck-good installcheck-olaptest

# The pvk target builds a subset of the GPDB package that includes just the
# tools used to verify the configuration of a set of GPDB servers.
.PHONY : pvk

# Targets for running autoconf and autoheader
.PHONY : autoconf

# Miscellaneous special purpose targets
.PHONY : test2 test3

# Internal functions which are invoked by other rules within this makefile
.PHONY : groupSession mkgpcc mkgpperfmon copydocs mgmtcopy pkgplr copylibs
.PHONY : greenplum_path RECONFIG HOMEDEP GPROOTDEP GPROOTDEP GPROOTFAIL
.PHONY : version gccVersionCheck pygres authlibs

#---------------------------------------------------------------------
# Make 3rd-party libraries and tools
#---------------------------------------------------------------------

# tell included makefiles where to find build-top-level resources
BLD_TOP:=$(shell sh -c pwd)
include Makefile.global
include Makefile.thirdparty

#---------------------------------------------------------------------
# Directory paths and file names
#---------------------------------------------------------------------

BLD_ARCH_HOST=$(shell $(CURDIR)/releng/set_bld_arch.sh)
GPPGDIR=cdb-pg
GPMGMT=gpMgmt
GPCC=gpcc
GPPERFMON=gpperfmon

RELEASE=$(shell $(CURDIR)/releasetag)
GPDIR=greenplum-db$(RELEASE)
PLRDIR=greenplum-db$(RELEASE)-plr
GPDOCDIR=$(CURDIR)/docs/release

DISTPATH=$(GPROOT)/$(GPDIR)
GPPERFMONDISTPATH=$(GPROOT)

ifeq "$(DEVPATH)" ""
DEVPATH=$(HOME)/$(GPDIR)
GPPERFMONDEVPATH=$(HOME)
else
# DEVPATH has been passed in as by the build scripts
GPROOT_DEV=$(dir $(DEVPATH))
GPPERFMONDEVPATH=$(GPROOT_DEV)
endif

# files generated by 'configure'
ISCONFIG=$(GPPGDIR)/GNUmakefile

#---------------------------------------------------------------------
# Compiler options
#---------------------------------------------------------------------

INLINE_FLAGS=-finline-limit=1800

ifeq (sol10_x86_64, ${BLD_ARCH_HOST})
	TRACE_CFG_FLAG=--enable-dtrace DTRACEFLAGS=-64
	TRACE_GCC_FLAG=-m64
else
	TRACE_CFG_FLAG=--enable-ltrace
	TRACE_GCC_FALG=
endif

OPTFLAGS="-O3 -funroll-loops -fargument-noalias-global $(COPTX) -g $(INLINE_FLAGS) $(TRACE_GCC_FLAG)"
PROFFLAGS="-O3 -funroll-loops -fargument-noalias-global -fno-omit-frame-pointer $(COPTX) -g $(INLINE_FLAGS) $(TRACE_GCC_FLAG)"

ifeq (on, ${GPDBGINLINE})
CFLAGS_INLINE=$(INLINE_FLAGS)
else
CFLAGS_INLINE=-fno-inline
endif

ifeq (on, ${GPDBGOPT})
CFLAGS_OPT=-O1
else
CFLAGS_OPT=-O0
endif

DEBUGFLAGS="$(CFLAGS_INLINE) $(CFLAGS_OPT) -g3 $(TRACE_GCC_FLAG)"

#---------------------------------------------------------------------
# configure
#---------------------------------------------------------------------

DEFPORT=5432
CONFIGFLAGS=--enable-thread-safety --enable-integer-datetimes --with-pgport=$(DEFPORT) --with-libedit-preferred $(TRACE_CFG_FLAG)

ifneq (false, ${PG_LANG})
CONFIGFLAGS+= --with-perl --with-python
ifdef TCL_CFG
CONFIGFLAGS+= --with-tcl-config=${TCL_CFG}
endif
ifdef R_HOME
CONFIGFLAGS+= --with-r
endif
endif

CONFIG_INCLUDES=$(BLD_THIRDPARTY_INCLUDE_DIR)
CONFIG_LIBRARIES=$(BLD_THIRDPARTY_LIB_DIR)

ifneq (false, ${AUTH})
ifeq "no-match$(findstring $(BLD_ARCH),suse10_x86_64)" "no-match"
CONFIGFLAGS+= --with-openssl --with-pam --with-krb5 --with-ldap CURL_CONFIG=$(CURDIR)/curl/bin/curl-config
CONFIG_INCLUDES+= $(CURDIR)/curl/include $(CURDIR)/openldap/include $(CURDIR)/openssl/include $(CURDIR)/krb5/include
CONFIG_LIBRARIES+= $(CURDIR)/curl/lib $(CURDIR)/openldap/lib $(CURDIR)/openssl/lib $(CURDIR)/krb5/lib
else
CONFIGFLAGS+= --with-openssl --with-pam --with-krb5 --with-ldap CURL_CONFIG=$(BLD_THIRDPARTY_BIN_DIR)/curl-config
endif
endif

CONFIGFLAGS+= --with-includes="$(CONFIG_INCLUDES)" --with-libraries="$(CONFIG_LIBRARIES)"

RECONFIG :
	rm -f $(ISCONFIG)

$(ISCONFIG) : $(GPPGDIR)/configure $(ISCONFIG).in
	cd $(GPPGDIR) && CFLAGS=$(INSTCFLAGS) ./configure $(CONFIGFLAGS) --prefix=$(INSTLOC) --with-docdir=$(INSTLOC)/doc --mandir=$(INSTLOC)/man

#---------------------------------------------------------------------
# autoconf
#---------------------------------------------------------------------
# Whenever there is a change to the cdb-pg/configure.in file, autoconf and
# autoheader should be run to regenerate the files cdb-pg/configure and
# cdb-pg/src/include/pg_config.h.in.  Note that autoconf and autoheader
# don't update the timestamps of their output files unless there is an
# actual change in the contents; thus 'make' rules don't work well for
# rebuilding those files automatically.  Developers should rebuild them
# manually when needed, which can be done by invoking 'make autoconf'.

autoconf : RECONFIG
	cd $(GPPGDIR) && autoconf && autoheader

#---------------------------------------------------------------------
# Miscellaneous special purpose targets
#---------------------------------------------------------------------
test2 :
	echo "CWD ="$(CURDIR)
	echo "RELEASE="$(RELEASE)

test3: INSTLOC=$(DEVPATH)
test3: HOMEDEP
	@rm -rf $(INSTLOC)/lib/*
	@$(MAKE) copylibs INSTLOC=$(INSTLOC)

#---------------------------------------------------------------------
# rsync + build
#---------------------------------------------------------------------

both : dbg opt ;

dbg:
	rsync -rlvt --exclude=devel*/ --exclude=dist*/ --exclude=LOG.* ./ devel/
	cd devel/ && if [ ! -f authlib_libpath_setup.sh ]; then $(MAKE) HOME=`pwd` authlibs; fi
	cd devel/ && . authlib_libpath_setup.sh && $(MAKE) HOME=`pwd` AUTH=true PG_LANG=true devel

opt:
	rsync -rlvt --exclude=devel*/ --exclude=dist*/ --exclude=LOG.* ./ dist/
	cd dist/ && if [ ! -f authlib_libpath_setup.sh ]; then $(MAKE) GPROOT=`pwd` authlibs; fi
	cd dist/ && . authlib_libpath_setup.sh && $(MAKE) GPROOT=`pwd` AUTH=true PG_LANG=true dist

#---------------------------------------------------------------------
# Development builds
#---------------------------------------------------------------------

devel : INSTCFLAGS=$(DEBUGFLAGS)
devel : INSTLOC=$(DEVPATH)
devel : GPPERFMONINSTLOC=$(GPPERFMONDEVPATH)
devel : CONFIGFLAGS+= --enable-cassert --enable-debug --enable-faultinjection
devel : gccVersionCheck version HOMEDEP $(ISCONFIG)
	@rm -rf $(INSTLOC)
	@cd $(GPPGDIR) && $(MAKE) install
	@$(MAKE) greenplum_path INSTLOC=$(INSTLOC)
	@$(MAKE) groupSession INSTLOC=$(INSTLOC)
	@$(MAKE) mkgpcc
	@$(MAKE) mkgpperfmon INSTLOC=$(GPPERFMONINSTLOC)
	@$(MAKE) mgmtcopy INSTLOC=$(INSTLOC)
	@$(MAKE) copylibs INSTLOC=$(INSTLOC)
	@$(MAKE) pkgplr INSTLOC=$(INSTLOC)

#---------------------------------------------------------------------
# Release builds
#---------------------------------------------------------------------

dist : INSTCFLAGS=$(OPTFLAGS)
dist : INSTLOC=$(DISTPATH)
dist : GPPERFMONINSTLOC=$(GPPERFMONDISTPATH)
dist : gccVersionCheck version GPROOTDEP RECONFIG $(ISCONFIG)
	@rm -rf $(INSTLOC)
	@cd $(GPPGDIR) && $(MAKE) install
	@$(MAKE) greenplum_path INSTLOC=$(INSTLOC)
	@$(MAKE) groupSession INSTLOC=$(INSTLOC)
	@$(MAKE) mkgpcc
	@$(MAKE) mkgpperfmon INSTLOC=$(GPPERFMONINSTLOC)
	@$(MAKE) mgmtcopy INSTLOC=$(INSTLOC)
	@$(MAKE) copydocs INSTLOC=$(INSTLOC)
	@$(MAKE) copylibs INSTLOC=$(INSTLOC)
	@$(MAKE) pkgplr INSTLOC=$(INSTLOC)

dist_prof : INSTCFLAGS=$(PROFFLAGS)
dist_prof : INSTLOC=$(DISTPATH)
dist_prof : GPPERFMONINSTLOC=$(GPPERFMONDISTPATH)
dist_prof : CONFIGFLAGS+= --enable-faultinjection 
dist_prof : gccVersionCheck version GPROOTDEP RECONFIG $(ISCONFIG)
	@rm -rf $(INSTLOC)
	@cd $(GPPGDIR) && $(MAKE) install
	@$(MAKE) greenplum_path INSTLOC=$(INSTLOC)
	@$(MAKE) groupSession INSTLOC=$(INSTLOC)
	@$(MAKE) mkgpcc
	@$(MAKE) mkgpperfmon INSTLOC=$(GPPERFMONINSTLOC)
	@$(MAKE) mgmtcopy INSTLOC=$(INSTLOC)
	@$(MAKE) copydocs INSTLOC=$(INSTLOC)
	@$(MAKE) copylibs INSTLOC=$(INSTLOC)
	@$(MAKE) pkgplr INSTLOC=$(INSTLOC)

#---------------------------------------------------------------------
#---------------------------------------------------------------------

# ship python on Linux, OSX, and Solaris
#osx104_x86_PYTHON=/opt/python-2.5.1
rhel4_x86_32_PYTHON=/opt/python-2.5.1
rhel4_x86_64_PYTHON=/opt/python-2.5.1
rhel5_x86_64_PYTHON=/opt/python-2.5.1
sol10_x86_64_PYTHON=/opt/python-2.5.1
sol10_x86_32_PYTHON=/opt/python32-2.5.1
sol10_sparc_64_PYTHON=/opt/python-2.5.1
sol10_sparc_32_PYTHON=/opt/python32-2.5.1
sol9_sparc_32_PYTHON=/opt/python32-2.5.1
sol8_sparc_32_PYTHON=/opt/python32-2.5.1
suse10_x86_64_PYTHON=/opt/python-2.5.1
BLD_PYTHON=$($(BLD_ARCH)_PYTHON)


#---------------------------------------------------------------------
# Platform Verification Kit (PVK)
#   formerly checkTools
#
# The pvk target builds a subset of the GPDB package that includes
# just the tools used to verify the configuration of a set of GPDB servers.
#---------------------------------------------------------------------

PVK_SCRIPTS = \
	bin/diskqual.ksh	\
	bin/generate_load_tpch.pl	\
	bin/gpscp			\
	bin/gpssh			\
	bin/gpcheckos			\
	bin/gpcheckperf			\
	bin/run_operator_tests.pl	\
	$(NULL)

PVK_FILESET = \
	$(CHECKTOOLS_SCRIPTS)	\
	bin/lib/gplib.py	\
	bin/lib/pxssh.py	\
	bin/lib/pexpect.py	\
	bin/lib/gpsys.py	\
	bin/lib/multidd		\
	bin/lib/netperf		\
	bin/lib/netserver	\
	bin/lib/stream		\
	$(NULL)

pvk : INSTCFLAGS=$(OPTFLAGS)
pvk : INSTLOC=$(DISTPATH)
pvk : gccVersionCheck version GPROOTDEP
	cd $(GPMGMT)/bin && $(MAKE) netperf stream
	mkdir -p $(INSTLOC)/bin/lib
	@for file in $(PVK_FILESET); do \
	    echo "cp -p $(GPMGMT)/$${file} $(INSTLOC)/$${file}"; \
	    cp -p $(GPMGMT)/$${file} $(INSTLOC)/$${file}; \
	done
	perl putversion $(foreach script,$(PVK_SCRIPTS),$(INSTLOC)/$(script))

#---------------------------------------------------------------------
# Internal functions
#---------------------------------------------------------------------

groupSession:
	@cd $(GPMGMT)/bin && $(MAKE)

mkgpcc:
	@cd $(GPCC) && $(MAKE)

mkgpperfmon:
	@cd $(GPPERFMON) && $(MAKE)
	rm -f $(INSTLOC)/greenplum-perfmon-*.zip
	ln gpperfmon/installer/greenplum-perfmon-*.zip $(INSTLOC)/

copydocs :
	@if [ ! -d $($INSTLOC)/docs ] ; then mkdir -p $(INSTLOC)/docs; fi
	@if [ ! -d $(GPDOCDIR) ] ; then \
	    echo "Error Copying Documentation: $(GPDOCDIR) is not present"; \
	else  echo "Copying Documentation" ;  \
	    echo "Copying $(GPDOCDIR)/pdf/GP*.pdf" ; \
	    cp $(GPDOCDIR)/pdf/GP*.pdf $(INSTLOC)/docs/; \
	    if [ -d $(INSTLOC)/doc/postgresql/contrib ] ; then \
	        mkdir -p $(INSTLOC)/docs/contrib ; \
	        echo "Copying postgresql contrib documentation" ; \
		cp -r $(INSTLOC)/doc/postgresql/contrib/* $(INSTLOC)/docs/contrib ; \
	    fi \
	fi
	@if [ -d $(INSTLOC)/doc ] ; then \
	    echo "Removing $(INSTLOC)/doc" ; \
	    rm -rf $(INSTLOC)/doc ; \
	fi

mgmtcopy :
	#Copy the management utilities
	mkdir -p $(INSTLOC)/bin
	mkdir -p $(INSTLOC)/lib
	mkdir -p $(INSTLOC)/lib/python	
	mkdir -p $(INSTLOC)/sbin
	#Setup /lib/python contents
	cp -rp $(GPMGMT)/bin/gppylib $(INSTLOC)/lib/python
	cp -rp $(GPMGMT)/bin/ext/* $(INSTLOC)/lib/python
	cp -rp $(GPMGMT)/bin $(INSTLOC)
	cp -rp $(GPMGMT)/sbin/* $(INSTLOC)/sbin/.
	cp -rp $(GPCC)/build/bin $(INSTLOC)
	cp $(GPPGDIR)/src/test/regress/*.pl $(INSTLOC)/bin
	if [ ! -d ${INSTLOC}/docs ] ; then mkdir ${INSTLOC}/docs ; fi
	if [ -d $(GPMGMT)/doc ]; then cp -rp $(GPMGMT)/doc $(INSTLOC)/docs/cli_help; fi
	if [ -d $(GPMGMT)/demo/gpdemo ]; then mkdir $(INSTLOC)/demo; gtar --exclude \*CVS\* -C $(GPMGMT)/demo -czf $(INSTLOC)/demo/gpdemo.tar.gz gpdemo; fi
	if [ -d $(GPMGMT)/demo/gpmapreduce ]; then \
	  mkdir -p $(INSTLOC)/demo; \
	  gtar -C $(GPMGMT)/demo -czf $(INSTLOC)/demo/gpmapreduce.tar.gz gpmapreduce; \
	fi
	# Set version
	perl putversion \
		$(INSTLOC)/bin/gpactivatestandby \
		$(INSTLOC)/bin/gpaddmirrors \
		$(INSTLOC)/bin/gpcheckos \
		$(INSTLOC)/bin/gpcheckperf \
		$(INSTLOC)/bin/gpcrondump \
		$(INSTLOC)/bin/gpdbrestore \
		$(INSTLOC)/bin/gpdeletesystem \
		$(INSTLOC)/bin/gpexpand \
		$(INSTLOC)/bin/gpinitstandby \
		$(INSTLOC)/bin/gpinitsystem \
		$(INSTLOC)/bin/gplogfilter \
		$(INSTLOC)/bin/gprebuildsystem \
		$(INSTLOC)/bin/gprecoverseg \
		$(INSTLOC)/bin/gpscp \
		$(INSTLOC)/bin/gpsizecalc \
		$(INSTLOC)/bin/gpskew \
		$(INSTLOC)/bin/gpssh \
		$(INSTLOC)/bin/gpssh-exkeys \
		$(INSTLOC)/bin/gpstart \
		$(INSTLOC)/bin/gpstart.py \
		$(INSTLOC)/bin/gpstate \
		$(INSTLOC)/bin/gpstop \
		$(INSTLOC)/bin/gpsys1
	# Remove unwanted files.
	rm -rf $(INSTLOC)/bin/CVS
	rm -rf $(INSTLOC)/doc/CVS
	rm -rf $(INSTLOC)/bin/ext
	rm -rf $(INSTLOC)/bin/pythonSrc
	rm -rf $(INSTLOC)/bin/Makefile
	rm -rf $(INSTLOC)/bin/lib/CVS
	rm -rf $(INSTLOC)/bin/lib/.p4ignore
	rm -rf $(INSTLOC)/bin/src
	rm -rf $(INSTLOC)/bin/gppylib

pkgplr:
	@if [ ! -z "$(PLRDIR)" ]; then \
	    echo "`date` -- INFO: Found a previous PL/R package, removing it"; \
	    rm -rf $(PLRDIR); \
	fi
	@if [ -f $(INSTLOC)/lib/postgresql/plr.so ] ; then \
	    echo "" ; \
	    echo "`date` -- INFO: Found plr.so, creating PL/R package" ; \
	    mkdir $(PLRDIR) ; \
	    cp -p $(INSTLOC)/lib/postgresql/plr.so $(PLRDIR)/ ; \
	    cp -p $(BLD_TOP)/languages/PLR/PLR_README $(PLRDIR)/ ; \
	    echo "" ; \
	    echo "`date` -- INFO: Cleaning up $(INSTLOC) of plr components" ; \
	    rm -f $(INSTLOC)/share/postgresql/contrib/plr.sql ; \
	    rm -f $(INSTLOC)/lib/postgresql/plr.so ; \
	    echo "" ; \
	    echo "`date` -- INFO: Creating .zip" ; \
	    zip -q -r $(PLRDIR).zip $(PLRDIR) ; \
	    echo "" ; \
	fi


BLD_LDD=ldd
osx104_x86_LDD=otool -L
ifneq "$($(BLD_ARCH)_LDD)" ""
BLD_LDD=$($(BLD_ARCH)_LDD)
endif

BLD_LDD_FILTER=|awk '{print $$3}' | sort -u | perl -p -i -e 's,^(.*\.so.*),\1\*,'
osx104_x86_LDD_FILTER=|awk '{print $$1}' | perl -p -i -e 's,^(.*)\.dylib,\1\*\.dylib,'
ifneq "$($(BLD_ARCH)_LDD_FILTER)" ""
BLD_LDD_FILTER=$($(BLD_ARCH)_LDD_FILTER)
endif

libcopy=(cd $(1) && gtar cf - $(2)) | (cd $(3) && gtar xvf -)

copylibs : thirdparty-dist
	if [ `uname -s` = 'SunOS' ]; then cp `ldd $(INSTLOC)/bin/psql | grep gcc | head -1 | awk '{print $$3}'` $(INSTLOC)/lib; fi	
ifeq "no-match$(findstring $(BLD_ARCH),suse10_x86_64)" "no-match"
	if [ -f $(CURDIR)/krb5/lib/libk5crypto.so.3 ] ; then $(call libcopy,$(CURDIR)/krb5/lib,libk5crypto.so*,$(INSTLOC)/lib) ; fi
	if [ -f $(CURDIR)/krb5/lib/libk5crypto.so.3 ] ; then $(call libcopy,$(CURDIR)/krb5/lib,libkrb5.so*,$(INSTLOC)/lib) ; fi
	if [ -f $(CURDIR)/krb5/lib/libk5crypto.so.3 ] ; then $(call libcopy,$(CURDIR)/krb5/lib,libkrb5support.so*,$(INSTLOC)/lib) ; fi
	if [ -f $(CURDIR)/krb5/lib/libgssapi_krb5.so.2 ] ; then $(call libcopy,$(CURDIR)/krb5/lib,libgssapi_krb5.so*,$(INSTLOC)/lib) ; fi
	if [ -f $(CURDIR)/openldap/lib/libldap_r-2.3.so.0 ] ; then cp -p $(CURDIR)/openldap/lib/libldap_r-2.3.so.0 $(INSTLOC)/lib ; fi
	if [ -f $(CURDIR)/openldap/lib/libldap-2.3.so.0 ] ; then cp -p $(CURDIR)/openldap/lib/libldap-2.3.so.0 $(INSTLOC)/lib ; fi
	if [ -f $(CURDIR)/openldap/lib/liblber-2.3.so.0 ] ; then cp -p $(CURDIR)/openldap/lib/liblber-2.3.so.0 $(INSTLOC)/lib ; fi
	if [ -f $(CURDIR)/openssl/lib/libssl.so.0.9.8 ] ; then $(call libcopy,$(CURDIR)/openssl/lib,libssl.so*,$(INSTLOC)/lib) ; fi
	if [ -f $(CURDIR)/krb5/lib/libk5crypto.3.1.dylib ] ; then cp -p $(CURDIR)/krb5/lib/libk5crypto.3.1.dylib $(INSTLOC)/lib ; fi
	if [ -f $(CURDIR)/krb5/lib/libkrb5support.1.1.dylib ] ; then cp -p $(CURDIR)/krb5/lib/libkrb5support.1.1.dylib $(INSTLOC)/lib ; fi
	if [ -f $(CURDIR)/openldap/lib/libldap_r-2.3.0.dylib ] ; then cp -p $(CURDIR)/openldap/lib/libldap_r-2.3.0.dylib $(INSTLOC)/lib ; fi
	if [ -f $(CURDIR)/openldap/lib/libldap-2.3.0.dylib ] ; then cp -p $(CURDIR)/openldap/lib/libldap-2.3.0.dylib $(INSTLOC)/lib ; fi
	if [ -f $(CURDIR)/openldap/lib/liblber-2.3.0.dylib ] ; then cp -p $(CURDIR)/openldap/lib/liblber-2.3.0.dylib $(INSTLOC)/lib ; fi
endif
	@if [ `uname -s` = 'Darwin' ] ; then \
	    for lib in `otool -L $(INSTLOC)/bin/psql | egrep 'libssl|libcrypto|libcom_err|libkrb5|curl|readline|numa' | awk '{print $$1}'`; do \
	        if [ x"`dirname $$lib`" = x"$(INSTLOC)/lib" ]; then continue; fi; \
	        if [ -f $(INSTLOC)/lib/`basename $$lib` -a ! -w $(INSTLOC)/lib/`basename $$lib` ]; then chmod u+w $(INSTLOC)/lib/`basename $$lib`; fi; \
	        echo "cp -p $$lib $(INSTLOC)/lib" ; \
	        cp -p $$lib $(INSTLOC)/lib ; \
	    done ; \
	fi
	@if [ `uname -s` != 'Darwin' ] ; then \
	    for lib in `ldd $(INSTLOC)/bin/psql | egrep 'libssl|libcrypto|libcom_err|curl|readline|numa' | awk '{print $$3}' | sort -u`; do \
	        if [ x"`dirname $$lib`" = x"$(INSTLOC)/lib" ]; then continue; fi; \
	        if [ -f $(INSTLOC)/lib/`basename $$lib` -a ! -w $(INSTLOC)/lib/`basename $$lib` ]; then chmod u+w $(INSTLOC)/lib/`basename $$lib`; fi; \
	        echo "cp -p $$lib $(INSTLOC)/lib" ; \
	        cp -p $$lib $(INSTLOC)/lib ; \
	    done ; \
	fi
	@lib_wildcards=`$(BLD_LDD) $(INSTLOC)/bin/lib/gpcheckdb | egrep 'libstdc\+\+' $(BLD_LDD_FILTER)` export lib_wildcards; \
	if [ -z "$${lib_wildcards}" ]; then exit 0; fi; \
	lib_list=`ls $${lib_wildcards}` export lib_list; \
	for lib in $${lib_list}; do \
	  echo "Copying $$lib to $(subst $(CURDIR)/,,$(INSTLOC)/lib)..."; \
	    if [ x"`dirname $$lib`" = x"$(INSTLOC)/lib" ]; then echo "...already there."; continue; fi; \
	    if [ -f $(INSTLOC)/lib/`basename $$lib` -a ! -w $(INSTLOC)/lib/`basename $$lib` ]; then chmod u+w $(INSTLOC)/lib/`basename $$lib`; fi; \
	    $(call libcopy,`dirname $$lib`,`basename $$lib`,$(INSTLOC)/lib); \
	done
	# Create the python directory to flag to build scripts that python has been handled even
	# on OS X Leopard where we no longer ship Python
	mkdir -p $(INSTLOC)/ext/python
	@if [ ! -z "$(BLD_PYTHON)" ]; then \
	    echo "Copying python from $(BLD_PYTHON) into $(INSTLOC)/ext/python..."; \
	    (cd $(BLD_PYTHON) && $(TAR) cf - .) | (cd $(INSTLOC)/ext/python/ && $(TAR) xpf -); \
	    echo "...DONE"; \
	else \
	    echo "INFO: Python not found on this platform, $(BLD_ARCH), not copying it into the GPDB package."; \
	fi
ifneq (false, ${AUTH})
	cp -rp $(BLD_THIRDPARTY_BIN_DIR)/openssl $(INSTLOC)/bin/
	mkdir -p $(INSTLOC)/include
	cp -rp $(BLD_THIRDPARTY_INCLUDE_DIR)/openssl $(INSTLOC)/include/
	mkdir -p $(INSTLOC)/etc
	cp -rp $(BLD_THIRDPARTY_DIR)/ssl/openssl.cnf $(INSTLOC)/etc/
endif

greenplum_path:
	releng/generate-greenplum-path.sh $(INSTLOC) > $(INSTLOC)/greenplum_path.sh

HOMEDEP :
	@#If the HOME variable isn't set, then execute the usage() path
	@if [ x"$(HOME)" = x ]; then $(MAKE) HOMEFAIL; fi

GPROOTDEP :
	@#If the GPROOT variable isn't set, then execute the usage() path
	@if [ x"$(GPROOT)" = x ]; then $(MAKE) GPROOTFAIL; fi

GPROOTFAIL :
	@echo
	@echo "	The GPROOT path variable is not set."
	@echo
	@echo "	You must decide where you will install to, and set GPROOT to that location, prior to"
	@echo "	installing the GP module with this Makefile."
	@echo
	@exit 1

HOMEFAIL :
	@echo
	@echo "	The HOME environment variable is not set. Please set it to continue."
	@echo
	@exit 1

#---------------------------------------------------------------------
# Cleanup
#---------------------------------------------------------------------

clean :
	@if [ ! -f $(ISCONFIG) ]; then echo "not configured, no need to clean"; exit 1; fi
	@if [ -d $(GPPGDIR) ]; then cd $(GPPGDIR); $(MAKE) clean; fi
	@if [ -d $(GPMGMT)/bin ]; then cd $(GPMGMT)/bin; $(MAKE) clean; fi
	@if [ -d $(GPCC) ]; then cd $(GPCC); $(MAKE) clean; fi
	@if [ -d $(GPPERFMON) ]; then cd $(GPPERFMON); $(MAKE) clean; fi

distclean :
	@if [ ! -f $(ISCONFIG) ]; then echo "not configured, no need to clean"; exit 1; fi
	@if [ -d $(GPPGDIR) ]; then cd $(GPPGDIR); $(MAKE) distclean; fi
	@if [ -d $(GPMGMT)/bin ]; then cd $(GPMGMT)/bin; $(MAKE) distclean; fi
	@if [ -d $(GPCC) ]; then cd $(GPCC); $(MAKE) clean; fi
	@if [ -d $(GPPERFMON) ]; then cd $(GPPERFMON); $(MAKE) clean; fi
	
distprep : $(ISCONFIG)
	@cd $(GPPGDIR) && $(MAKE) distprep
	
#---------------------------------------------------------------------
# Regression tests
#---------------------------------------------------------------------

installcheck-good :
	@if [ ! -f $(ISCONFIG) ]; then echo "not configured, cannot check"; exit 1; fi
	@cd $(GPPGDIR)/src/test/regress && $(MAKE) installcheck-good

installcheck-parallel :
	@if [ ! -f $(ISCONFIG) ]; then echo "not configured, cannot check"; exit 1; fi
	@cd $(GPPGDIR)/src/test/regress && $(MAKE) installcheck-parallel

installcheck-olaptest :
	@if [ ! -f $(ISCONFIG) ]; then echo "not configured, cannot check"; exit 1; fi
	@cd $(GPPGDIR)/src/test/regress && $(MAKE) installcheck-olaptest

#---------------------------------------------------------------------
# More internal functions
#---------------------------------------------------------------------

version :
	@if [ ! -f getversion ] ; then echo "getversion is not present, cannot create VERSION file"; exit 1; fi
	@echo "Creating VERSION file"
	@bash getversion > VERSION

gccVersionCheck :
	@echo "Checking GCC version" ; \
	gcc --version > /dev/null 2>&1 ; \
	if [ $$? -ne 0 ] ; then \
 	    echo "Error running gcc --version" ; \
	    gcc --version ; \
	    exit 1 ; \
	fi
	@gcc --version | head -n 1 | cut -d' ' -f3 | egrep '[0-3]\.[0-4]\.[0-1]' > /dev/null 2>&1 ; \
	if [ $$? -eq 0 ] ; then \
	    echo "Error: GPDB must be compiled with GCC 3.4.2 or later." ; \
	    echo "Current GCC version:" ; \
	    gcc --version ; \
	    exit 1 ; \
	fi

