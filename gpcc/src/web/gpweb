        mytemplate = self._lookup.get_template(path)
        print mytemplate.render(**kwargs)

render = mako_render('templates/')


urls = (
  '/(.*)', 'gpcc')

sctx = {}

opt = {}
opt['-p'] = '8080'

def usage(exitarg):
    print __doc__
    sys.exit(exitarg)

def print_version():
    print '%s version $Revision$' % script_name
    sys.exit(0)

def parseCommandLine():
    global opt, sctx
    try:
        (options, args) = getopt.getopt(sys.argv[1:], '?p:', ['version'])
    except Exception, e:
        usage('Error: ' + str(e))
    
    for (switch, val) in options:
        if (switch == '?'):              usage(0)
        elif (switch == '-p'):           opt[switch] = val
        elif (switch == '--version'):    print_version()

    if len(args) == 0:
        usage('Error: please specify at least one MA address')
    
    sctx['ma_list'] = args
    sctx['ma'] = args[0]

    sys.argv = [sys.argv[0], opt['-p']]


class gpcc:
    def _url_filter(self, name):
        if name == '':
            return 'index.psp'
        return name

    def _session_filter(self):
        web.config.session_parameters.handler = 'file'
        web.config.session_parameters.cookie_name = 'gpsessionid'
        web.config.session_parameters.regenerate_id = False
        s = web.ctx.session
        s.start()
        s.cleanup()
        return s

    def _session_check(self, s):
#        if 'X-GPCC-USER' not in s._data:
#            return False
        return True

    def GET(self, name):
        name = self._url_filter(name)
        sess = self._session_filter()
        page = {}
	param = web.input()

        if self._session_check(sess):
            render.serve_template(path=name, web=web, param=param, session=sess, sctx=sctx, page=page)
        else:
            render.serve_template(path='index.psp', web=web, param=param, session=sess, sctx=sctx, page=page)

    def POST(self, name):
        name = self._url_filter(name)
        sess = self._session_filter()
        page = {}
        param = web.input()

        if self._session_check(sess):
            render.serve_template(path=name, web=web, param=param, session=sess, sctx=sctx, page=page)
        else:
            render.serve_template(path='index.psp', web=web, param=param, session=sess, sctx=sctx, page=page)
        

if __name__ == "__main__": 

    parseCommandLine()
    web.run(urls, globals())

