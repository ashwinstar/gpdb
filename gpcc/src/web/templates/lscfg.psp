<%!
import os, sys, urllib, httplib, socket
%>

<%
def hitMA(cmd, params):
    params = urllib.urlencode(params)
    f = None
    try:
        f = httplib.HTTPConnection('%s:%d' % (sctx['ma.host'], sctx['ma.port']))
        f.request('GET', '%s?%s' % (cmd, params))
        response = f.getresponse()
	return response
    except socket.error, msg:
    	sys.stderr.write('requesting http://%s:%d%s failed. %s\n' % (sctx['ma.host'], sctx['ma.port'], cmd, msg))
        return None
    except httplib.HTTPException, msg:
    	sys.stderr.write('requesting http://%s:%d%s failed. %s\n' % (sctx['ma.host'], sctx['ma.port'], cmd, msg))
        return None
    except Exception, msg:
    	sys.stderr.write('requesting http://%s:%d%s failed. %s\n' % (sctx['ma.host'], sctx['ma.port'], cmd, msg))
        return None
    finally:
        if f: f.close()
    return None
  
%>

<%
web.header('Content-Type', 'text/html;charset=utf-8')

params = { }
response = hitMA('/gpcc/lscfg', params)
if response is None:
    web.output('{ status: "failure",  rset : {  total: 1, offset: 0, errmsg : { "_" : "server error" }'}}')
    break
elif response.status == 200:
    web.output(response.read())
else:
    web.output(response.read())
%>



