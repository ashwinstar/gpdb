<%!

import sys

sys.path.append(sys.path[0] + '/lib')
try:
    import gpcc
    import simplejson
except ImportError, e:
    sys.exit('Error: unable to import module: ' + str(e))

%>

<%

cfg = None
redirect = 0
deadma = []
while redirect < 5:
    response = gpcc.hitMA(sctx['ma'], '/gpcc/lscfg', {})
    if response is None:
        deadma.append(sctx['ma'])
        ma = gpcc.getMA(sctx['ma_list'], deadma)
        if ma is not None:
       	    sctx['ma'] = ma
        else:
	    cfg = None
	    break
    elif response.status == 200:
        cfgjson = simplejson.loads(response.read())
        x = cfgjson.get('rset', {})
        cfg = x.get('result', [])
	break
    elif response.status == 301:
    	json = simplejson.loads(response.read())
	sctx['ma'] = json.get('location')
	redirect += 1 	 

%>

<%
    web.header('Content-Type', 'text/html;charset=utf-8')

%>


<!-- base href="http://www.greenplum.com/" -->
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<script type="text/javascript" src="/static/js/jquery-1.2.1.min.js"></script>


</head><body>
<div id="pagewrapper">
   <div id="content">
         <div id="leftNav">
          
<ul id="leftMenu">
<li><a href="/index.psp"> Database Management </a></li>
<li><a href="/initialize.psp"> Database Initialization </a></li>
<li><a href="/configure.psp" id="current"> Database Configuration </a></li>
<li><a href="/control.psp"> Database Control </a></li>
</ul>



         </div>
	 <div id="rightNav">

            <p style="margin-top: 0pt;">
% if cfg is None:
     Internal server error.  Please try later.
% else:
	    <table cellspacing="2" cellpadding="4" border="0">
               <tr style="background: #7DC019"><th>Key</th><th>Value</th></tr>
<% i = 0 %>
% for (key, value) in cfg:
<%    
      i += 1
      tbl_style = ''
      if i % 2 == 0: 
          tbl_style = 'style="background: #C2DBA2"' 
%>
	       <tr ${tbl_style}><td>${key}</td><td>${value}</td></tr>

% endfor
	    </table>
% endif

         </div>
   </div>
</div>
</body></html>
