<%!

import sys, urllib, httplib

sys.path.append(sys.path[0] + '/lib')
try:
    import simplejson
except ImportError, e:
    sys.exit('Error: unable to import module: ' + str(e))

%>

<%
def hitMA(cmd, params):
    params = urllib.urlencode(params)
    f = None
    json = ''
    try:
        f = httplib.HTTPConnection("%s:%d" % (sctx['ma.host'], sctx['ma.port']))
        f.request("GET", "%s?%s" % (cmd, params))
        response = f.getresponse();
        if response.status == 200:
            s = response.read()
            # print s
            json = simplejson.loads(s)
    finally:
        if f: f.close()
    return json

cfgjson = hitMA('/gpcc/lscfg', {})
x = cfgjson.get('rset', {})
cfg = x.get('result', [])

%>

<%
    web.header('Content-Type', 'text/html;charset=utf-8')

%>


