<%
   web.header('Content-Type', 'text/html;charset=utf-8')
%>

<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML//EN">
<html> <head>
<title>Greenplum Database Management</title>

<script type="text/javascript" src="/static/js/jquery-1.2.1.min.js"></script>

<script type="text/javascript">

  var state = "stopped";

$(function() {

  function switch_label() {
      if (state == "stopped") {
          $("#switch").text("Start");
      } else if (state == "running") {
          $("#switch").text("Stop");
      } else if (state == "stopping") {
          $("#switch").text("Stopping");          
      } else if (state == "starting") {
          $("#switch").text("Starting");          
      } else if (state == "pending") {
          $("#switch").text("Pending");
      }
  }

  function status_response(json) {
      state = json.rset.result[0];
      if (json.status == "ok") {
          if (json.rset.result[0] == "stopping" ||
              json.rset.result[0] == "starting") {

              setTimeout(function() {
                 $.getJSON("/status.psp?a=${sctx['gpdb.name']}", function(json) {
                     status_response(json);
                 })
              }, 1000);
              
              $("#switch").unbind('click', switch_click);           
          } else {
              $("#switch").bind('click', switch_click);           
          }
          switch_label();
      }
  }

  $.getJSON("/status.psp?a=${sctx['gpdb.name']}", function(json) {
       status_response(json);
  });


  function command_response(json) {
      if (json.status == "ok") {
           $("#switch").bind('click', switch_click);
      } else if (json.status == "pending") {
           $("#switch").unbind('click', switch_click);
      } else if (json.status == "failure") {
           ;
      }

      setTimeout(function() {
           $.getJSON("/status.psp?a=${sctx['gpdb.name']}", function(json) {
                status_response(json);
           })
      }, 1000);
  }

  function switch_click() {
     url = '';
     if (state == "stopped") {
        url = "/start.psp?a=${sctx['gpdb.name']}";
     } else {
        url = "/stop.psp?a=${sctx['gpdb.name']}";
     }

     $(this).unbind('click', switch_click);
      $.getJSON(url, function(json) {
          command_response(json);
      })
  }

  $("#switch").click(switch_click);


})

</script>
</head>


<body>
<h1></h1>
<div id="control_bar">
<a id="switch" href="#">Start up now!</a>
please click the button to start/stop the database.
</div>
<hr>
<address></address>
