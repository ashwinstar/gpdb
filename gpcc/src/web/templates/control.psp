<script type="text/javascript" src="/static/js/jquery-1.2.1.min.js"></script>

<script type="text/javascript">

  var state = "stopped";
  var array = "";

$(function() {

  function switch_label() {
      if (state == "stopped") {
          $("#status").text("Database stopped.");
          $("#switch").text("start");
	  $("#switch_click_msg").show();
      } else if (state == "running") {
          $("#status").text("Database is running.");
          $("#switch").text("stop");
	  $("#switch_click_msg").show();
      } else if (state == "stopping") {
          $("#status").text("Database is stopping.  Please wait.");
          $("#switch").text("stop");          
	  $("#switch_click_msg").hide();
      } else if (state == "starting") {
          $("#status").text("Database is starting.  Please wait.");
          $("#switch").text("start");          
	  $("#switch_click_msg").hide();
      } else if (state == "pending") {
          $("#switch").text("pending");
      }
  }

  function status_response(json) {
      state = json.rset.result[0];
      if (json.status == "ok") {
          if (typeof(json.array) == "undefined") {
	       $("#status").html("Database is not initialized.  Please do the <a href='/initialize.psp'>initialization</a>.");
	       $("#switch_click_msg").hide();
          } else {
            array = json.array;
            if (json.rset.result[0] == "stopping" ||
                json.rset.result[0] == "starting") {

                setTimeout(function() {
                   $.getJSON("/status.psp", function(json) {
                       status_response(json);
                   })
                }, 1000);
              
                $("#switch").unbind('click', switch_click);           
            } else {
                $("#switch").bind('click', switch_click);           
            }
            switch_label();
         }
      }
  }

  $.getJSON("/status.psp", function(json) {
       status_response(json);
  });


  function command_response(json) {
      if (json.status == "ok") {
           $("#switch").bind('click', switch_click);
      } else if (json.status == "pending") {
           $("#switch").unbind('click', switch_click);
      } else if (json.status == "failure") {
           ;
      }

      setTimeout(function() {
           $.getJSON("/status.psp?a=" + array, function(json) {
                status_response(json);
           })
      }, 1000);
  }

  function switch_click() {
     url = '';
     if (state == "stopped") {
        url = "/start.psp?a=" + array;
     } else {
        url = "/stop.psp?a=" + array;
     }

     $(this).unbind('click', switch_click);
      $.getJSON(url, function(json) {
          command_response(json);
      })
  }

  $("#switch").click(switch_click);


})

</script>

