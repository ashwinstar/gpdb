
<%
    error = {}
%>

% if 'submit' not in param:
<!--  METHOD GET -->

<div>
<a href="logout.psp">logout</a><p>
<form method='POST' name='login' action='control.psp'>

Username: <input name="user" type="text" value="${param.user}"><p>
Password: <input name="password" type="password"><p>
<input type="submit" name="submit" value="Submit"><p>
</form>
</div>



% else:
<!-- METHOD POST -->

Control Control...<p>

<div>
<a href="logout.psp">logout</a><p>
<form method='POST' name='control' action='control.psp'>

Username: <input name="user" type="text" value="${param.user}"><p>
Password: <input name="password" type="password"><p>
<input type="submit" name="submit" value="Submit"><p>
</form>
</div>

% endif

