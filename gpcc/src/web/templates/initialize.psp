<%!


import sys, urllib, httplib, socket

sys.path.append(sys.path[0] + '/lib')
try:
    import simplejson
except ImportError, e:
    sys.exit('Error: unable to import module: ' + str(e))

%>

<%
def hitMA(cmd, params):
    params = urllib.urlencode(params)
    f = None
    json = ''
    try:
        f = httplib.HTTPConnection("%s:%d" % (sctx['ma.host'], sctx['ma.port']))
        f.request("GET", "%s?%s" % (cmd, params))
        response = f.getresponse();
	return response
    except socket.error, msg:
        return None
    except httplib.HTTPException, msg:
        return None
    except Exception, msg:
        return None
    finally:
        if f: f.close()
    return None

%>

<%
    cfg = None
    response = hitMA('/gpcc/lscfg', {})
    if response is None:
       cfg = None
    else:
       cfgjson = simplejson.loads(response.read())
       x = cfgjson.get('rset', {})
       cfg = x.get('result', [])

    max_node = 0
    if cfg is not None:
       i = 0
       for (key, value) in cfg:
           if key.startswith('node.'):
       	       i += 1
       max_node = i

    web.header('Content-Type', 'text/html;charset=utf-8')
%>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en"><head><title>Greenplum Database Initialization</title>



<!-- base href="http://www.greenplum.com/" -->
<meta name="Generator" content="CMS Made Simple - Copyright (C) 2004-6 Ted Kulp. All rights reserved.">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta name="description" content="Overview of Greenplum's Database Products">
 
<link rel="stylesheet" type="text/css" media="screen" href="http://www.greenplum.com/stylesheet.php?templateid=23&amp;mediatype=screen">

<script type="text/javascript" src="/static/js/jquery-1.2.1.min.js"></script>
<script type="text/javascript" src="/static/js/ajaxfileupload.js"></script>
<script type="text/javascript" src="/static/js/gpcc.js"></script>


<script type="text/javascript">

var state = "stopped";

$(function() {

  function status_response(json) {
      state = json.rset.result[0];
      if (json.status == "ok") {
          if (typeof(json.array) == 'undefined') {
	    $("#initdb").show();
	    $("#msg").text("Greenplum database initialization failed.");
	  } else {
	    $("#initdb").hide();
            if (json.rset.result[0] == "initializing") {
	        $("#msg").html("Greenplum database is initializing.  Please wait.");
                setTimeout(function() {
                   $.getJSON("/status.psp", function(json) {
                       status_response(json);
                   })
                }, 1000);
            } else { 
		$("#msg").html("Greenplum database '" + json.array + "' was initialized.");
				 		
            }
	  }
      } else {
          $("#msg").html("Internal server error. Please try later.");
      }
  }


  function BEGIN_status_response(json) {
      state = json.rset.result[0];
      if (json.status == "ok") {
          if (typeof(json.array) == 'undefined') {
	    $("#initdb").show();
	  } else {
	    $("#initdb").hide();
            if (json.rset.result[0] == "initializing") {
	        $("#msg").text("Greenplum database is initializing.  Please wait.");
                setTimeout(function() {
                   $.getJSON("/status.psp", function(json) {
                       status_response(json);
                   })
                }, 1000);
            } else { 
		$("#msg").html("Greenplum database '" + json.array + "' was initialized.");
				 		
            }
	  }
      } else {
          $("#msg").html("Internal server error. Please try later.");
      }
  }
/*
  $("#msg").ajaxError(function(request, settings) {
       $(this).html("Error requesting page " + settings.url);
  });
*/
  $.getJSON("/status.psp", function(json) {
       BEGIN_status_response(json);
  });


  function initdb_response(msg, textstatus) {
      var json = eval('(' + msg + ')');
      if (json.status == "ok") {
           $("#initdb").hide();
           $("#msg").text('Greenplum database was initialized.');
      } else if (json.status == "pending") {
      	   ;
      } else if (json.status == "failure") {
      	   ;
      }

      setTimeout(function() {
           $.getJSON("/status.psp", function(json) {
                status_response(json);
           })
      }, 1000);
  }

  function ajaxConfig() {

  	var i = 0;
  	var err = []
        var myform = $("#initdb_form").getForm();

	for (i = 0 ; i < myform.vars.length ; i++) {
	    a = myform.vars[i];
	    if (a.name == 'array_name' && isBlank(a.value))
	       err.push(a.name);
	    if (a.name == 'base_directory' && ! isPath(a.value))
	       err.push(a.name);
	    if (a.name == 'qd_port' && ! isPort(a.value))
	       err.push(a.name);
	    if (a.name == 'qe_base_port' && ! isPort(a.value))
	       err.push(a.name);
	    if (a.name == 'qe_mirror_base_port' && ! isPort(a.value))
	       err.push(a.name);
	}

	if (err.length == 0) {
  	    $(this).unbind('click', ajaxConfig);
	    $("#msg")
	    .ajaxStart(function() {
	  	$(this).text('Greenplum database is initializing.');
	    });
	
	    $.post('/initdb.psp', myform.vars, initdb_response);
	} else {
	    var item = "#initdb_form ";
	    for (i = 0 ; i < err.length ; i++) {
	       item += 'td[@name=' + err[i] + '],';
	    }
	    $("#initdb_form td[@name]").css('color', 'black');
	    $(item).css('color', 'red');

	}

	return false;
  }

  $("#submit").click(ajaxConfig);


})

</script>

</head><body>
<div id="pagewrapper">
   <div id="header">
           <a href="http://www.greenplum.com/index.php"><img src="http://www.greenplum.com/images/greenplum_logo.gif" alt="Greenplum - World's Best Database for BI" id="siteLogo"></a>
          
   </div>
   <div id="content">
      <div id="submain">
      <table>
        <tbody><tr>
          <td colspan="3"></td>
          <td><h1>Database Initialization</h1></td>
