<%!
import sys

sys.path.append(sys.path[0] + '/lib')
try:
    import gpcc
    import simplejson
except ImportError, e:
    sys.exit('Error: unable to import module: ' + str(e))

%>

<%
    NNODE=4
    web.header('Content-Type', 'text/html;charset=utf-8')
%>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en"><head><title>Greenplum Database Initialization</title>



<!-- base href="http://www.greenplum.com/" -->
<meta name="Generator" content="CMS Made Simple - Copyright (C) 2004-6 Ted Kulp. All rights reserved.">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta name="description" content="Overview of Greenplum's Database Products">
 
<link rel="stylesheet" type="text/css" media="screen" href="http://www.greenplum.com/stylesheet.php?templateid=23&amp;mediatype=screen">

<script type="text/javascript" src="/static/js/jquery-1.2.1.min.js"></script>
<script type="text/javascript" src="/static/js/ajaxfileupload.js"></script>
<script type="text/javascript" src="/static/js/gpcc.js"></script>


<script type="text/javascript">

var state = "stopped";

$(function() {

  function status_response(json) {
      state = json.rset.result[0];
      if (json.status == "ok") {
          if (typeof(json.array) == 'undefined') {
	    $("#initdb").show();
	    $("#msg").text("Greenplum database initialization failed.");
	  } else {
	    $("#initdb").hide();
            if (json.rset.result[0] == "initializing") {
	        $("#msg").html("Greenplum database is initializing.  Please wait.");
                setTimeout(function() {
                   $.getJSON("/status.psp", function(json) {
                       status_response(json);
                   })
                }, 1000);
            } else { 
		$("#msg").html("Greenplum database '" + json.array + "' was initialized.");
				 		
            }
	  }
      } else {
          $("#msg").html("Internal server error. Please try later.");
      }
  }


  function BEGIN_status_response(json) {
      state = json.rset.result[0];
      if (json.status == "ok") {
          if (typeof(json.array) == 'undefined') {
	    $("#initdb").show();
	  } else {
	    $("#initdb").hide();
            if (json.rset.result[0] == "initializing") {
	        $("#msg").text("Greenplum database is initializing.  Please wait.");
                setTimeout(function() {
                   $.getJSON("/status.psp", function(json) {
                       status_response(json);
                   })
                }, 1000);
            } else { 
		$("#msg").html("Greenplum database '" + json.array + "' was initialized.");
				 		
            }
	  }
      } else {
          $("#msg").html("Internal server error. Please try later.");
      }
  }

  $.getJSON("/status.psp", function(json) {
       BEGIN_status_response(json);
  });


  function initdb_response(json) {
      if (json.status == "ok") {
           $("#initdb").hide();
           $("#msg").text('Greenplum database was initialized.');
      } else if (json.status == "pending") {
      	   ;
      } else if (json.status == "failure") {
      	   ;
      }

      setTimeout(function() {
           $.getJSON("/status.psp", function(json) {
                status_response(json);
           })
      }, 1000);
  }

  /* multiple form input form */
  function initdb_response_plain_text(msg, textstatus) {
      var json = eval('(' + msg + ')');
      initdb_response(json);
  }

  function ajaxConfig() {

  	var i = 0;
  	var err = []
        var myform = $("#initdb_input_form").getForm();
	var n = 0;

	for (i = 0 ; i < myform.vars.length ; i++) {
	    a = myform.vars[i];
	    if (a.name == 'array_name' && isBlank(a.value))
	       err.push(a.name);
	    if (a.name == 'base_directory' && ! isPath(a.value))
	       err.push(a.name);
	    if (a.name == 'qd_port' && ! isPort(a.value))
	       err.push(a.name);
	    if (a.name == 'qe_base_port' && ! isPort(a.value))
	       err.push(a.name);
	    if (a.name == 'qe_mirror_base_port' && ! isPort(a.value))
	       err.push(a.name);
	    if (a.name == 'node') {
	       if (n == 0) {
	          if (isBlank(a.value) || ! isValidNode(a.value))
		     err.push(a.name + '.' + n);
	       } else {
	          if (! isBlank(a.value) && ! isValidNode(a.value))
		     err.push(a.name + '.' + n);
	       }
	       n++;
	    }
	}
	
	if (err.length == 0) {
  	    //$(this).unbind('click', ajaxConfig);
	    $("#initdb_input_form td[@name]").css('color', 'black');
	    $("#msg")
	    .ajaxStart(function() {
	        $("#initdb").hide();
	  	$(this).text('Greenplum database is initializing.');
	    });
	
	    $.post('/initdb.psp', myform.vars, initdb_response_plain_text);
	} else {
	    var item = "#initdb_input_form ";
	    for (i = 0 ; i < err.length ; i++) {
	       item += 'td[@name=' + err[i] + '],';
	    }
	    $("#initdb_input_form td[@name]").css('color', 'black');
	    $(item).css('color', 'red');
	}

	return false;
  }

  $("#multi_input_submit").click(ajaxConfig);


  /* file upload form */
  function ajaxFileUpload() {
      //$(this).unbind('click', ajaxFileUpload);
      $("#msg")
	.ajaxStart(function(){
  	    $(this).text('Greenplum database is initializing.');
 	})
 	.ajaxComplete(function(){
 	    ;
 	});
 
 	$.ajaxFileUpload
 	(
 		{
 			url:'/initdb.psp',
 			secureuri:false,
 			fileElementId:'fileToUpload',
 			dataType: 'json',
 			success: function (data, status) {
 				initdb_response(data);
 			},
 			error: function (data, status, e) {
 				initdb_response(data);
 			}
 		}
 	)

	return false; 		
  }


  $("#file_upload_submit").click(ajaxFileUpload);



  /* big text area form */

  function ajaxText() {

  	var i = 0;
  	var err = []
        var myform = $("#initdb_textarea_form").getForm();

	for (i = 0 ; i < myform.vars.length ; i++) {
	    a = myform.vars[i];
	    if (a.name == 'text_config' && isBlank(a.value))
	       err.push(a.name);
	}

	if (err.length == 0) {
  	    //$(this).unbind('click', ajaxText);
	    $("#msg")
	    .ajaxStart(function() {
	        $("#initdb").hide();
	  	$(this).text('Greenplum database is initializing.');
	    });
	
	    $.post('/initdb.psp', myform.vars, initdb_response_plain_text);
	} else {
	    var item = "#initdb_textarea_form ";
	    for (i = 0 ; i < err.length ; i++) {
	       item += 'td[@name=' + err[i] + '],';
	    }
	    $("#initdb_form td[@name]").css('color', 'black');
	    $(item).css('color', 'red');
	}

	return false;
  }

  $("#textarea_submit").click(ajaxText);

  var g_nnode = ${NNODE};

  function addNode() {
	$("#initdb_input_form td[@name='node." + (g_nnode-1) + "']")
  	.parent("tr")
  	.after("<tr><td name=\"node."+g_nnode+"\">Node."+ g_nnode +" (hostN IP1 IP2 IP3 IP4):</td><td><input name=\"node\" type=\"text\"></td></tr>");
	$("#initdb_input_form select[@name='qd_resides']").append("<option value='" + g_nnode + "'>node." + g_nnode + "</option>");
	$("#initdb_input_form select[@name='standby_qd_resides']").append("<option value='" + g_nnode + "'>node." + g_nnode + "</option>");
	g_nnode++;
	return false;
  }

  $("#add_node").click(addNode);

})

</script>

</head><body>
<div id="pagewrapper">
   <div id="header">
           <a href="http://www.greenplum.com/index.php"><img src="http://www.greenplum.com/images/greenplum_logo.gif" alt="Greenplum - World's Best Database for BI" id="siteLogo"></a>
          
   </div>
   <div id="content">
      <div id="submain">
      <table>
        <tbody><tr>
          <td colspan="3"></td>
          <td><h1>Database Initialization</h1></td>
        </tr>
        <tr>
         <td width="25"></td>
         <td><img src="http://www.greenplum.com/images/menu_top.gif"></td>
         <td width="15"></td>
         <td><img src="http://www.greenplum.com/images/content_top.gif"></td>
       </tr>
       <tr>
         <td width="25"></td>
         <td valign="top" width="200">
         <div id="leftNav">
          
<ul id="leftMenu">
<li><a href="/index.psp"> Database Management
 </a></li>
</ul>

          
<ul id="leftMenu">
<li><a href="/initialize.psp" id="current"> Database Initialization </a></li>
<li><a href="/configure.psp"> Database Configuration </a></li>
<li><a href="/control.psp"> Database Control </a></li>
</ul>



         </div></td>
         <td width="15"></td>
         <td valign="top" width="720">

         <table cellspacing="0" cellpadding="4" border="0">
    <tbody>
        <tr valign="top">
            <td width="435">

<div id="clear">&nbsp;</div>


            <p style="margin-top: 0pt;">

	    <span id="msg"></span>

<!-- initdb forms -->

         <div id="initdb" style="display:none">

<!-- initdb form input -->

	    <div id="initdb_input_form_div">
	    <form id="initdb_input_form" method="POST" enctype="multipart/form-data">
	       <table cellpadding="0" cellspacing="3">
	         <thead> <tr> <th>Fill in the configuration</th></tr>
		 </thead>
		 <tbody>
		 <tr>
		     <td><a href="#" id="add_node">Add node</a></td>
		 </tr>
% for i in range(NNODE):
                  <tr>
		      <td name="node.${i}">Node.${i} (host${i} IP1 IP2 IP3 IP4):</td>
		      <td><input name="node" type="text"></td>
                  </tr>
% endfor

		   <tr>
		      <td name="array_name">Array name:</td>
		      <td><input name="array_name" type="text"></td>
		   </tr>
		   <tr>
		      <td name="base_directory">Base directory:</td>
		      <td><input name="base_directory" type="text"></td>
		   </tr>
		   <tr>
		      <td name="qd_port">Query dispatcher port:</td>
		      <td><input name="qd_port" type="text"></td>
		   </tr>
		   <tr>
		      <td name="qe_base_port">Query executor base port:</td>
		      <td><input name="qe_base_port" type="text"></td>
		   </tr>
		   <tr>
		      <td name="qe_mirror_base_port">Mirror query executor base port:</td>
		      <td><input name="qe_mirror_base_port" type="text"></td>
		   </tr>

		   <tr>
		      <td name="qd_resides">Query dispatcher resides on:</td>
		      <td><select name="qd_resides">
% for i in range(NNODE):
		             <option value="${i}">node.${i}</option>
% endfor
			  </select>
		      </td>
		  </tr>
		  <tr>
		      <td name="standby_qd_resides">Standby QD resides on:</td>
		      <td><select name="standby_qd_resides">
		      	     <option value="-1" selected>No standby QD</option>
% for i in range(NNODE):
		             <option value="${i}">node.${i}</option>
% endfor		  </select>
                      </td>
		  </tr>			    
		  <tr>
		      <td>Query executor resides on:</td>
		      <td><select name="qe_resides_opt">
		             <option value="0">All nodes</option>
			     <option value="1">All nodes except QD</option>
			  </select>
	              </td>
		   </tr>
		   <tr>
		      <td>Number of segments per machine:</td>
		      <td><select name="nseg_per_node">
% for i in range(1, 9):
		              <option value="${i}">${i}</option>	
% endfor
			  </select>
		      </td>
		   </tr>
		   <tr>
		      <td>Has Mirror Segment:</td>
		      <td><input type="checkbox" name="mirror" checked></td>
		   </tr>
		   <tr>
		       <td><button id="multi_input_submit">Submit</button></td>
		   </tr>
		 </tbody>
	       </table>
            </form>
	    </div>
<!-- END of initdb form input -->
            <hr/>
<!-- initdb file upload input -->
            <div id="initdb_file_upload_div">
	    <form id="initdb_file_upload_form" method="POST" enctype="multipart/form-data">
	       <table cellpadding="0" cellspacing="0">
	          <thead><tr><th>Upload the configuration file</th></tr>
		  </thead>
		  <tbody>
		  <tr>
		     <td><input id="fileToUpload" type="file" size="35" name="fileToUpload"></td>
 		  </tr>
		  <tr>
		     <td><button id="file_upload_submit">Submit</button></td>
		  </tr>
		  </tbody>
	       </table>
	    </form>
            </div>

<!-- END of file upload input -->

            <hr/>
<!-- initdb big textarea input -->
            <div id="initdb_textarea_div">
	    <form id="initdb_textarea_form" method="POST" enctype="multipart/form-data">
	       <table cellpadding="0" cellspacing="0">
	          <thead><tr><th>Please type in your database configuration</th></tr>
		  </thead>
		  <tbody>
		  <tr>
		     <td name="text_config"><textarea name="text_config" rows="20" cols="50"></textarea></td>
		  </tr>
		  <tr>
		     <td><button id="textarea_submit">Submit</button></td>
		  </tr>
		  </tbody>
	       </table>
	    </form>
	    </div>

<!-- END of big textarea input -->

         </div>

<!-- END of initdb forms -->
	    </p>


            <p>&nbsp;</p>
            </td>
        </tr>
    </tbody>
</table>
         </td>
       </tr>
       <tr>
         <td colspan="3"></td>
         <td><img src="http://www.greenplum.com/images/submain_footer.gif"></td>
       </tr>
       <tr>
         <td colspan="4">
        <div id="footer"><table>
    <tbody>
        <tr>
            <td width="25">&nbsp;</td>
            <td width="450">&copy; 2007 Greenplum</td>
            <td width="225">Phone: 650.286.8012</td>
            <td width="220">Email: <a href="mailto:info@greenplum.com">info@greenplum.com</a></td>
        </tr>
    </tbody>
</table></div>
        </td>
     </tr></tbody></table>
   </div>
</div>
</div></body></html>
