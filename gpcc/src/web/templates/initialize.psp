         <td width="15"></td>
         <td><img src="http://www.greenplum.com/images/content_top.gif"></td>
       </tr>
       <tr>
         <td width="25"></td>
         <td valign="top" width="200">
         <div id="leftNav">
          
<ul id="leftMenu">
<li><a href="/index.psp"> Database Management
 </a></li>
</ul>

          
<ul id="leftMenu">
<li><a href="/initialize.psp" id="current"> Database Initialization </a></li>
