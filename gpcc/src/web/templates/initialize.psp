         <table cellspacing="0" cellpadding="4" border="0">
    <tbody>
        <tr valign="top">
            <td width="435">

<div id="clear">&nbsp;</div>


            <p style="margin-top: 0pt;">

	    <span id="msg"></span>
	    <div id="initdb" style="display:none">
	    <form id="initdb_form" method="POST" enctype="multipart/form-data">
	       <table cellpadding="0" cellspacing="0">
	         <thead> <tr> <th>Upload the configuration file</th></tr>
		 </thead>
		 <tbody>
		   <tr>
	               <td><input id="fileToUpload" type="file" size="35" name="fileToUpload"></td>
		   </tr>
		   <tr>
		       <td><button id="submit">Upload</button></td>
		   </tr>
		 </tbody>
