<%!
import os, sys, urllib, httplib
%>

<%
def hitMA(cmd, params, data):
    params = urllib.urlencode(params)
    f = None
    res = ''
    try:
        f = httplib.HTTPConnection('%s:%d' % (sctx['ma.host'], sctx['ma.port']))
        f.request('POST', '%s?%s' % (cmd, params), data)
        response = f.getresponse()
        if response.status == 200:
            res = response.read()
    finally:
        if f: f.close()
    return res
  
%>

<%
web.header('Content-Type', 'text/html;charset=utf-8')

%>

<% 
data = param['fileToUpload']
response = hitMA('/gpcc/init', {}, data)
