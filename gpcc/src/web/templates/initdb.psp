<%!
import os, sys, urllib, httplib
try:
    import simplejson
except ImportError, e:
    sys.exit('Error: unable to import module: ' + str(e))
%>

<%
def hitMA(cmd, params, data):
    params = urllib.urlencode(params)
    f = None
    res = ''
    try:
        f = httplib.HTTPConnection('%s:%d' % (sctx['ma.host'], sctx['ma.port']))
        f.request('POST', '%s?%s' % (cmd, params), data)
        response = f.getresponse()
    finally:
        if f: f.close()
    return response
  
%>

<%
web.header('Content-Type', 'text/html;charset=utf-8')

data = param['fileToUpload']

redirect=0
while redirect < 5:
    response = hitMA('/gpcc/init', {}, data)
    if response.status == 200:
        web.output(response.read())
	break
    elif response.status == 301:
    	json = simplejson.loads(response.read())
	location = json.get('location')
	addr = location.split(':')
	sctx['ma.host'] = addr[0]
	sctx['ma.port'] = int(addr[1])
        sys.stderr.write('redirect to %s' % location);
	redirect += 1        

%>

