class HelpCmd(Command):
    '''Usage: gp [gp-options] command [command-options-and-arguments]

  Specify 'gp help' to get this message.
  Specify 'gp help commands' to see a list of commands
  Specify 'gp help options' to see gp-options
  Specify 'gp help' followed by a command name for command-specific help.
'''

    __helpCommands = '''
gp commands are:
	init     Initialize the array
	delete	 Delete the array
	start    Start the array and/or segments
	stop     Stop the array and/or segments
	status   Get the current status of the array
	lscfg    List the configuration
'''
    
    def __init__(self, gopt, argv):
        Command.__init__(self, gopt, argv, '', self.__doc__)
        if len(self.args) > 0:
            c = self.args[0]
            if (False or
                c == 'delete' or 
                c == 'init' or
                c == 'lscfg' or
                c == 'start' or 
                c == 'status' or
                c == 'stop' or 
                c == 'commands' or
                True):
                self.args = [c]

    def run(self):
        if not self.args:
            print self.__doc__
            return

        c = self.args[0]
        if False:		pass
        elif c == 'commands':	print self.__helpCommands
        elif c == 'delete': 	print DeleteCmd.__doc__
        elif c == 'init':       print InitCmd.__doc__
        elif c == 'lscfg':	print LsCfgCmd.__doc__
        elif c == 'start': 	print StartCmd.__doc__
        elif c == 'status': 	print StatusCmd.__doc__
        elif c == 'stop': 	print StopCmd.__doc__
        else:
            usage('Error: unknown command "%s"' % c)


####################
class CmdLine():
    
    def __init__(self):
        self.gopt = {}
        self.gopt['-a'] = os.environ.get('GP_ARRAY_NAME')
        self.gopt['-m'] = os.environ.get('GP_MA_ADDR')
        if self.gopt['-m']: self.gopt['-m'] = self.gopt['-m'].split()
        self.gopt['-v'] = False
        self.cmd = None

    def parse(self):
        try:
            (options, args) = getopt.getopt(sys.argv[1:], 'va:m:')
        except Exception, e:
            usage('Error: ' + str(e))

        m = []
        for (switch, val) in options:
            if switch == '-v':  self.gopt[switch] = True
            elif switch == '-a': self.gopt[switch] = val
            elif switch == '-m': m.append(val)
        if (m): self.gopt['-m'] = m

        # map command text to command class
        if not args: usage('Error: missing command')
        c = args[0]
        if False:	     pass
        elif c == 'delete':  self.cmd = DeleteCmd(self.gopt, args)
        elif c == 'help':    self.cmd = HelpCmd(self.gopt, args)
        elif c == 'init':    self.cmd = InitCmd(self.gopt, args)
        elif c == 'lscfg':   self.cmd = LsCfgCmd(self.gopt, args)
        elif c == 'start':   self.cmd = StartCmd(self.gopt, args)
        elif c == 'status':  self.cmd = StatusCmd(self.gopt, args)
        elif c == 'stop':    self.cmd = StopCmd(self.gopt, args)
        else: usage('Error: unknown command "%s"' % c)

        # if help, we are done; don't need to check -m, -a param
        if c == 'help': 
            return self.cmd

        # check -a
        if not self.gopt['-a']: usage('Error: -a param not set.')

        # check -m
        if not self.gopt['-m']: usage('Error: -m param not set.')
        for m in self.gopt['-m']:
            try: x = int(m.split(':')[1])
            except ValueError: x = 0
            except IndexError: x = 0

            if not (0 < x and x < 65536): 
                usage('Error: -m %s is invalid. Bad port number.' % m)

        return self.cmd


####################
def main():
    cmdline = CmdLine()
    cmd = cmdline.parse()
    if cmd: 
        cmd.run()

