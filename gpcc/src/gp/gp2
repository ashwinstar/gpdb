#!/usr/bin/env python
"""gp -- Greenplum Terminal Control

Usage: gp [gp_options] command [command_options] [command_args]

	gp_options:
	    -v verbose
	    -a array_name
            -m node_ip:port    (accepts multiple -m)

	command:
	    help
	    start 
	    stop
            init config_file
            delete
            segment segidx [start|stop|status]

"""
import os, sys

if sys.version_info < (2, 5, 0):
    sys.exit("Error: gp is supported on Python versions 2.5.0 or greater\n"
             + "Please upgrade python installed on this machine.")

sys.path.append(sys.path[0] + '/lib')
try:
    import getopt, types, time, urllib, httplib, socket, StringIO
    import simplejson
except ImportError, e:
    sys.exit('Error: unable to import module: ' + str(e))


####################
def usage(exitarg):
    help_path = os.path.join(sys.path[0], '..', 'doc', 'gp_help')
    try:
        f = open(help_path)
        for line in f:
            print line,
    except:
        print __doc__
    sys.exit(exitarg)


####################
class Command():
    '''Base class for all commands'''
    TIMEOUT = 30
    
    def __init__(self, gopt, cmd):
        self.cmd = cmd
        self.gopt = gopt
        self.opt = {}
        self.args = []

    def __makeError(self, msg):
        r = {'status': 'error', 'action': self.cmd, 'a': self.gopt['-a'], 
             'msg': msg}
        return r

    def __httpRequest(self, method, path, params, data=None):
        addr = self.gopt['-m'][0]
        p = params and urllib.urlencode(params) or ''
        query = '/%s?%s' % (self.cmd, p)
        f = None
        try:
            if self.gopt['-v']: print '[INFO] http://%s/%s' % (addr, query)
            f = httplib.HTTPConnection(addr)
            f.request('POST', query, data)
            response = f.getresponse()
            if response.status == 200 or response.status == 301:
                s = response.read()
                content = simplejson.loads(s)
                return (response.status, content)
            else:
                s = response.read()
                return (response.status, self.__makeError(s))
        except socket.error, msg:
            return (-1, self.__makeError(msg))
        except httplib.HTTPException, msg:
            return (-1, self.__makeError(msg))
        except Exception, msg:
            return (-1, self.__makeError(msg))
        finally:
            if f: f.close()
        return (-1, self.__makeError('Unknown Error'))

    def __checkMA(self, rc, content):
        '''Check the RC for failure or 301 Moved messages, and handle it.'''
        if (rc == -1):
            # try the next MA
            location = self.gopt['-m'].pop()
            self.gopt['-m'].insert(0, location)
            return False
        if (rc == 301): 
            # put new location into MA array
            location = content['location']
            try: self.gopt['-m'].remove(location)
            except ValueError: pass
            finally: self.gopt['-m'].insert(0, location)
            return False
        return True

    def _httpGet(self, path, params):
        for i in xrange(len(self.gopt['-m']) + 1):
            (rc, content) = self.__httpRequest('GET', path, params)
            if not self.__checkMA(rc, content):
                continue
            return (rc, content)
        return (-1, self.__makeError('Unable to contact MA'))

    def _httpPost(self, params, data):
        for i in xrange(len(self.gopt['-m']) + 1):
            (rc, content) = self.__httpRequest('POST', path, params, data)
            if not self.__checkMA(rc, content):
                continue
            return (rc, content)
        return (-1, self.__makeError('Unable to contact MA'))

    def _getStatus(params):
        (rc, content) = self._httpGet(self, '/gpcc/status', params)
        if 'ok' != content['status']:
            print '[ERROR] unable to get status'
            print '        details:', content
            sys.exit(1)
        return (rc, content)

    def run(self):
        pass

####################
class StartCmd(Command):
    '''Usage: gp start [-s seg]'''
    def __init__(self, gopt, argv):
        Command.__init__(self, gopt, 'start')
        self.opt['-s'] = None
        try:
            (options, args) = getopt.getopt(argv[1:], 's:')
        except Exception, e:
            usage('Error: start command: ' + str(e))

        for (switch, val) in options:
            if switch == '-s': self.opt[switch] = val
        
    def run(self):
        param = {}
        if (self.opt['-s']): param['s'] = self.opt['-s']
        (rc, content) = self._httpGet('/gpcc/start', param)
        if "ok" != content['status']:
            print '[ERROR] unable to start'
            print '        details:', content
            sys.exit(1)

        in_progress = param['s'] and 'segment start in progress' or 'array start in progress'
        succeed = param ['s'] and 'segment started' or 'array started'
        for j in xrange(Command.TIMEOUT):
            print '.', 
            time.sleep(1)
            (rc, content) = self._getStatus(param)
            msg = (content['rset'])[0]
            if in_progress == msg:
                continue
            if succeed == msg: 
                print '[INFO] succeed'
                return

            print '[ERROR] unknown reply message'
            print '        details:', content
            sys.exit(1)
        
        print '[ERROR] timeout'
        sys.exit(1)

            


