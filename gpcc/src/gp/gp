        doSegmentStart(args)
    elif cmd == 'stop':
        doSegmentStop(args)
    elif cmd == 'status':
        doSegmentStatus(args)
    else:
        usage('Invalid command')

    
    

def main():
    resetCommandOptions()
    readRCFile()
    parseCommandLine(sys.argv)
    checkCommandLine()
    if gp_cmd == 'start':
        doStart(gp_args)
    elif gp_cmd == 'stop':
        doStop(gp_args)
    elif gp_cmd == 'delete':
        if yesorno('Are you sure to delete gpdb permanently? [yY|nN]', 'User aborted delete operation'):
            doDelete(gp_args)
    elif gp_cmd == 'status':
        doStatus(gp_args)
    elif gp_cmd == 'lscfg':
        doListConfig(gp_args)
    elif gp_cmd == 'init':
        doInit(gp_args)
    elif gp_cmd == 'segment':
        doSegment(gp_args)
    else:
        usage('Invalid command')


if __name__ == '__main__':
    main()
    
        
