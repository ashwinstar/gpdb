#!/usr/bin/env python
"""
gp -- Greenplum Terminal Control

Usage: gp [gp_options] command [command_options] [command_args]

	gp_options:
	    -v verbose
	    -a array_name
	    -h host_name
	    -p port

	command:
	    start 
	    stop
            init config_file
            delete
            segment segidx [start|stop|status]

"""
import os, sys, getopt, types, time, popen2, urllib, httplib, socket, StringIO


if sys.version_info < (2, 5, 0):
    sys.exit("Error: gp is supported on Python versions 2.5.0 or greater\n"
             + "Please upgrade python installed on this machine.")

sys.path.append(sys.path[0] + '/lib')
try:
    import simplejson
except ImportError, e:
    sys.exit('Error: unable to import module: ' + str(e))


def usage(exitarg):
    help_path = os.path.join(sys.path[0], '..', 'doc', 'gp_help');
    try:
        f = open(help_path)
        for line in f:
            print line,
    except:
        print __doc__
    sys.exit(exitarg)

gp_opt = {}
gp_cmd = None
gp_args = []

def resetCommandOptions():
    global gp_opt, gp_cmd, gp_args
    gp_opt = { 
        '-v': False,
        '-?': False,
        '-a': os.environ.get('GPARRAY', None),
        '-h': os.environ.get('GPHOST', None),
        '-p': os.environ.get('GPPORT', None),
        }
    gp_cmd = None
    gp_args = []
    

def parseCommandLine(argv):
    global gp_opt, gp_cmd, gp_args
    (options, args) = getopt.getopt(argv[1:], '?va:h:p:')
    for (switch, val) in options:
        if switch == '-?': gp_opt[switch] = True
        elif switch == '-v': gp_opt[switch] = True
        elif switch[1] in ('a', 'h', 'p'): gp_opt[switch] = val
    if args:
        gp_cmd = args[0]
        gp_args = args[1:]


def readRCFile():
    global gp_opt, gp_cmd, gp_args
    f = None
    try:
        fname = os.environ.get('HOME', '/') + '/.gprc'
        try:
            f = open(fname)
        except IOError:
            return
        for line in f:
            if line.startswith('gp '):
                argv = line.split()
                try:
                    parseCommandLine(argv)
                    if gp_cmd or gp_args:
                        raise SystemExit
                    gp_opt['-?'] = False
                except (SystemExit, getopt.GetoptError):
                    print "Warning: error in '%s'. Ignored." % fname
                    resetCommandOptions()
                    return
    finally:
        if f: f.close()

def yesorno(msg, abortmsg):
    print msg
    line = sys.stdin.readline()
    line = line.strip().lower()
    if line == 'y':
        return True
    print abortmsg
    return False

def checkCommandLine():
    if gp_opt['-?']: usage(0)
    if not gp_opt['-a']: usage('Error: please specify -a array_name')
    if not gp_opt['-h']: usage('Error: please specify -h host_name')
    if not gp_opt['-p']: usage('Error: please specify -p port')
    if not gp_cmd: usage('Error: please specify command')
    try:
        gp_opt['-p'] = int(gp_opt['-p'])
    except ValueError:
        usage('Error: bad -p port parameter')


def getErrorJson(msg):
    return simplejson.loads('{ "status": "failure", "errmsg" : { "_" : "%s"}}' % msg)

def hitMA(cmd, params):
    params = urllib.urlencode(params)
    f = None
    json = ''
    try:
        f = httplib.HTTPConnection("%s:%d" % (gp_opt['-h'], gp_opt['-p']))
        f.request("GET", "%s?%s" % (cmd, params))
        response = f.getresponse();
        if response.status == 200 or response.status == 301:
            s = response.read()
            #print s
            json = simplejson.loads(s)
            return (response.status, json)
        else:
            s = response.read()
            return (response.status, getErrorJson(s))
    except socket.error, msg:
        return (-1, getErrorJson(msg))
    except httplib.HTTPException, msg:
        return (-1, getErrorJson(msg))
    except Exception, msg:
        return (-1, getErrorJson(msg))
    finally:
        if f: f.close()
    return (-1, json)
    

def hitMAbyPost(cmd, params, data):
    params = urllib.urlencode(params)
    f = None
    json = ''
    try:
        f = httplib.HTTPConnection("%s:%d" % (gp_opt['-h'], gp_opt['-p']))
        f.request("POST", "%s?%s" % (cmd, params), data)
        response = f.getresponse();
        if response.status == 200 or response.status == 301:
            s = response.read()
            # print s
            json = simplejson.loads(s)
            return (response.status, json)
        else:
            s = response.read()
            return (response.status, getErrorJson(s))
    except socket.error, msg:
        return (-1, getErrorJson(msg))
    except httplib.HTTPException, msg:
        return (-1, getErrorJson(msg))
    except Exception, msg:
        return (-1, getErrorJson(msg))
    finally:
        if f: f.close()
    return (-1, json)

def printError(json):
    output = StringIO.StringIO()
    output.write('CRITICAL: ')
    errmsg = json.get('errmsg')
    if not errmsg:
        output.write('unknown error')
    elif errmsg.get('_', None):
        output.write(errmsg.get('_'))
        output.write('\n')
    for key in errmsg:
        if key != '_':
            output.write('%s: %s\n' % (key, errmsg.get(key)))
    print output.getvalue()
    output.close()


def getStatus():
    params = { 'a': gp_opt['-a'] }
    redirect = 0
    while redirect < 5:
        (retcode, json) = hitMA('/gpcc/status', params)
    # print '/gpcc/status:', json
        if retcode == 200:
            status = json.get('status', '')
            x = json.get('rset', {})
            x = x.get('result', [])
            if len(x): 
                x = x[0] 
            else:
                x = ''
            break
        elif retcode == 301:
            location = json.get('location')
            addr = location.split(':')
            gp_opt['-h'] = addr[0]
            gp_opt['-p'] = int(addr[1])
            redirect += 1
            print 'redirect to %s:%d' % (gp_opt['-h'], gp_opt['-p'])
        else:
            return (json, 'failure', '')
    return (json, status, x)


def printDotSleep():
    sys.stdout.write('.')
    sys.stdout.flush()
    time.sleep(1)


def doStart(args):
    params = {'a': gp_opt['-a']}
    redirect = 0
    while redirect < 5:
        (retcode, json) = hitMA('/gpcc/start', params)
        if retcode == 200:
            if not json.get('status') in ('ok', 'pending'):
                printError(json)
                return
            cur = 'starting'
            for i in xrange(30):
                printDotSleep()
                (json, status, array_status) = getStatus()
                if status != 'ok':
                    print
                    printError(json)
                    return
                if array_status != cur:
                    cur = array_status
                    break
            print
            if cur == 'starting':
                print 'error: timeout'
            elif cur == 'running':
                print 'ok:', cur
            elif cur == 'stopping' or cur == 'stopped':
                print 'error:', cur
            else:
                print 'error: unknown; not started.'
            return
        elif retcode == 301:
            location = json.get('location')
            addr = location.split(':')
            gp_opt['-h'] = addr[0]
            gp_opt['-p'] = int(addr[1])
            redirect += 1
            print 'redirect to %s:%d' % (gp_opt['-h'], gp_opt['-p'])
        else:
            printError(json)
            return




