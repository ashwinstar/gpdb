#!/usr/bin/env python
"""gp -- Greenplum Terminal Control
   
  Usage: gp [gp-options] command [command-options-and-arguments]

    gp_options:
        -v            : verbose mode.
        -a array_name : specifies array name. If not provided explicitly,
                        take the value of GP_ARRAY_NAME environment variable.
        -m ma_addr    : specifies MA addr in format host:port. Multiple -m
                        options are acceptable.
                        If not provided explicity, take the value of 
                        GP_MA_ADDR environment variable, assuming the format 
                        'host1:port host2:port'.
        -R            : raw mode. 

  Run 'gp help' for details.

"""
import os, sys

if sys.version_info < (2, 5, 0):
    sys.exit("Error: gp is supported on Python versions 2.5.0 or greater\n"
             + "Please upgrade python installed on this machine.")

sys.path.append(sys.path[0] + '/lib')
try:
    import getopt, types, time, urllib, httplib, socket, StringIO
    import simplejson
except ImportError, e:
    sys.exit('Error: unable to import module: ' + str(e))


####################
def usage(exitarg):
    help_path = os.path.join(sys.path[0], '..', 'doc', 'gp_help')
    try:
        f = open(help_path)
        for line in f:
            print line,
    except:
        print __doc__
    sys.exit(exitarg)

####################
def confirm(prompt):
    line = raw_input(prompt + ' (y/n) ')
    line = line.strip().lower()
    return line and line[0] == 'y'

####################
def printPacket(packet, indent = ''):
    keys = packet.keys()
    keys.sort()
    for k in keys:
        print '%s%s: %s' % (indent, k, packet[k])

####################
def printDot(sleeptime=1):
    sys.stdout.write('.')
    sys.stdout.flush()
    time.sleep(sleeptime)


####################
class Command():
    '''Base class for all commands'''
    TIMEOUT = 30
    
    def __init__(self, gopt, argv, optstr, usagestr):
        self.cmd = argv[0]
        self.gopt = gopt
        self.opt = {}
        try:
            (self.options, self.args) = getopt.getopt(argv[1:], optstr)
        except Exception, e:
            print usagestr
            sys.exit('[ERROR]: %s: %s' % (self.cmd, str(e)))


    def verbose(self, msg):
        if self.gopt['-v']: print '[INFO]', msg

    def __makeError(self, param, errmsg):
        '''Make an error packet with msg'''
        r = {'status': 'error', 'action': self.cmd, 'errmsg': errmsg}
        r.update(param)
        return r

    def __httpRequest(self, addr, method, path, params, data=None):
        '''Make a http request to the first MA.'''
        p = params and urllib.urlencode(params) or ''
        query = '%s?%s' % (path, p)
        f = None
        try:
            self.verbose('http://%s%s' % (addr, query))
            f = httplib.HTTPConnection(addr)
            f.request('POST', query, data)
            response = f.getresponse()
            if response.status == 200 or response.status == 301:
                str = response.read()
                packet = simplejson.loads(str)
                return (response.status, packet)
            else:
                str = response.read()
                return (response.status, self.__makeError(params, str))
        except socket.error, msg:
            return (-1, self.__makeError(params, msg))
        except httplib.HTTPException, msg:
            return (-1, self.__makeError(params, msg))
        except Exception, msg:
            return (-1, self.__makeError(params, msg))
        finally:
            if f: f.close()
        return (-1, self.__makeError(params, 'Unknown Error'))

    def __checkMA(self, rc, packet):
        '''Check the RC for failure or 301 Moved messages, and handle it.'''
        if (rc == -1):
            # try the next MA
            location = self.gopt['-m'].pop()
            self.gopt['-m'].insert(0, location)
            return False
        if (rc == 301): 
            # put new location into MA array
            location = packet['location']
            try: self.gopt['-m'].remove(location)
            except ValueError: pass
            finally: self.gopt['-m'].insert(0, location)
            return False
        return True

    def _httpGetOrPost(self, method, path, params, data = None):
        failedList = []
        for i in xrange(len(self.gopt['-m']) + 1):
            addr = self.gopt['-m'][0]
            if addr in failedList: continue
            failedList.append(addr)
            (rc, packet) = self.__httpRequest(addr, method, path, params, data)
            if not self.__checkMA(rc, packet):
                continue
            return packet
        return self.__makeError(params, 'Unable to contact MA')
        

    def _httpGet(self, path, params):
        '''Locate the Lead MA and do a GET'''
        return self._httpGetOrPost('GET', path, params)

    def _httpPost(self, path, params, data):
        '''Locate the Lead MA and do a POST'''
        return self._httpGetOrPost('POST', path, params, data)

    def _getStatus(self, params):
        '''GET the status of GPDB'''
        packet = self._httpGet('/gpcc/status', params)
        return packet

    def _waitStatus(self, param, contMsg, timeout=-1):
        '''Wait while status returned matches contMsg. 
           When a mismatch occurs, return the packet. 
           If timeout, return None.'''
        if timeout <= 0: timeout = Command.TIMEOUT
        for i in xrange(timeout):
            printDot()
            packet = self._getStatus(param)
            if 'ok' != packet.get('status'):
                print '[ERROR] unable to get status. details:'
                printPacket(packet, '      ')
                sys.exit(2)
            msg = (packet['rset'])[0]
            if msg == contMsg:
                continue
            print
            return packet
        print
        return None

    def raw(self, packet):
        '''If raw mode, print packet and exit(0)'''
        if self.gopt['-R']:
            simplejson.dump(packet, sys.stdout)
            sys.exit(0)


    def run(self):
        '''Run the command. To be overridden by subclass.'''
        pass


####################
class StartCmd(Command):
    '''Usage: gp start [-s seg] [-y] [-R] [-r] [-a]
          -s seg     :  start the named segment
          -y         :  start the array without starting the standby master
          -R         :  rolls over the master log file
          -r         :  rolls over the segment log files
          -a         :  non-interactive mode'''
    def __init__(self, gopt, argv):
        Command.__init__(self, gopt, argv, 'yRras:', self.__doc__)
        self.opt['-s'] = None
        self.opt['-y'] = False
        self.opt['-R'] = False
        self.opt['-r'] = False
        self.opt['-a'] = False
        for (switch, val) in self.options:
            if switch == '-s': self.opt[switch] = val
            if switch == '-y': self.opt[switch] = True
            if switch == '-R': self.opt[switch] = True
            if switch == '-r': self.opt[switch] = True
            if switch == '-a': self.opt[switch] = True

    def run(self):
        param = {}
        if (self.opt['-s']): param['s'] = self.opt['-s']
        if (self.gopt['-a']): param['a'] = self.gopt['-a']
        if (self.opt['-y']): param['y'] = 't'
        if (self.opt['-R']): param['R'] = 't'
        if (self.opt['-r']): param['r'] = 't'

        packet = self._httpGet('/gpcc/start', param)
        self.raw(packet)

        if "ok" != packet.get('status'):
            print '[ERROR] unable to start, details:'
            printPacket(packet, '      ')
            sys.exit(2)

        in_progress = ('s' in param) and 'segment starting' or 'array starting'
        succeed = ('s' in param) and 'segment running' or 'array running'
        packet = self._waitStatus(param, in_progress)
        if not packet:
            sys.exit('[ERROR] timeout')

        if succeed == (packet['rset'])[0]:
            print '[INFO] ok'
            return

        print '[ERROR] unknown status, details:'
        printPacket(packet, '      ')
        sys.exit(2)


####################
class StopCmd(Command):
    '''Usage: gp stop [-s seg] [-f] [-i]
          -s seg  : stop the named segment only.
          -f      : fast-shutdown mode.  All transaction in progress are interrupted and rolled back. [default: smart-shutdown mode]
          -i      : immediate-shutdown mode [default: smart-shutdown mode]'''
    def __init__(self, gopt, argv):
        Command.__init__(self, gopt, argv, 'ifs:', self.__doc__)
        self.opt['-s'] = None
        self.opt['-i'] = False
        self.opt['-f'] = False
        for (switch, val) in self.options:
            if switch == '-s': self.opt[switch] = val
            if switch == '-i': self.opt[switch] = True
            if switch == '-f': self.opt[switch] = True
        
        if self.opt['-i'] and self.opt['-f']:
            print '[ERROR] flag -i and -f cannot appear at the same time'
            sys.exit(2)

    def run(self):
        param = {}
        if (self.opt['-s']): param['s'] = self.opt['-s']
        if (self.gopt['-a']): param['a'] = self.gopt['-a']
        if (self.opt['-i']): 
            param['mode'] = 'immediate'
        elif (self.opt['-f']): 
            param['mode'] = 'fast'
        else:
            param['mode'] = 'smart'

        packet = self._httpGet('/gpcc/stop', param)
        self.raw(packet)

        if 'ok' != packet.get('status'):
            print '[ERROR] unable to stop, details:'
            printPacket(packet, '      ')
            sys.exit(2)

        in_progress = ('s' in param) and 'segment stopping' or 'array stopping'
        succeed = ('s' in param) and 'segment stopped' or 'array stopped'
        packet = self._waitStatus(param, in_progress)
        if not packet:
            sys.exit('[ERROR] timeout')

        if succeed == (packet['rset'])[0]:
            print '[INFO] ok'
            return

        print '[ERROR] unknown status, details:'
        printPacket(packet, '      ')
        sys.exit(2)


