class DeleteCmd(Command):
    '''Usage: gp delete '''
    def __init__(self, gopt, argv):
        Command.__init__(self, gopt, argv, '', self.__doc__)
        
    def run(self):
        proceed = confirm('This will erase the array "%s"!' % self.gopt['-a'])
        if proceed:
            proceed = confirm('FINALLY WARNING... PROCEED WITH DELETE?')
        if not proceed: 
            print '[INFO] aborted'
            return

        param = {}
        if (self.gopt['-a']): param['a'] = self.gopt['-a']
        packet = self._httpGet('/gpcc/delete', param)
        if 'ok' != packet.get('status'):
            print '[ERROR] unable to delete, details:'
            printPacket(packet, '      ')
            sys.exit(2)

        in_progress = 'array deleting'
        succeed = 'array not initialized'
        packet = self._waitStatus(param, in_progress)
        if not packet:
            sys.exit('[ERROR] timeout')
        
        if succeed == (packet['rset'])[0]:
            print '[INFO] succeed'
            return

        print '[ERROR] unknown status, details:'
        printPacket(packet, '      ')
        sys.exit(2)


