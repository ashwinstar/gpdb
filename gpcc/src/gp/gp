def parseConfigFile(f):
    fp = (type(f) == types.FileType and f or open(f))
    cfg={}
    prop = None
    lno = 0
    for line in fp:
	lno = lno + 1
	line = line.split('#', 1)[0]
	line = line.strip()
	if len(line) == 0: continue
	nv = line.split('=', 1)
	if len(nv) != 2:
	    raise GPError, 'syntax error at line %d' % lno
	(name, value) = (nv[0].strip(), nv[1].strip())
	if not nv[1]:
	    raise GPError, 'syntax error at line %d' % lno
	cfg[name] = value
    if not cfg.has_key('sys.name'):
	raise GPError, 'missing sys.name in config'
    return cfg


def parseConfigMA(cfg):
    try:
	ma = (cfg['ma.0'].split(':', 1), cfg['ma.1'].split(':', 1), cfg['ma.2'].split(':', 1))
	if len(ma[0]) != 2: 
	    raise GPError, 'invalid ma.0 value... expected host:dir'
	if len(ma[1]) != 2:
	    raise GPError, 'invalid ma.1 value... expected host:dir'
	if len(ma[2]) != 2:
	    raise GPError, 'invalid ma.2 value... expected host:dir'
    except KeyError:
	raise GPError, 'missing ma.0, ma.1, or ma.2 values in config'
    return ma

def parseConfigMAPort(cfg):
    try:
	print cfg['sys.ma.port']
	port = int(cfg['sys.ma.port'])
	if not (0 < port and port <= 65535): 
	    raise GPError, 'sys.ma.port must be positive number less than 65535'
    except KeyError:
	raise GPError, 'missing sys.ma.port value in config'
    except ValueError:
	raise GPError, 'invalid sys.ma.port value in config'
    return port


def ma_start(ma, guid, cfg = None):
    for i in xrange(3):
	(host, dir) = ma[i]
	ssh = 'ssh -o "BatchMode yes" -o "StrictHostKeyChecking no"'
	ssh = '%s %s gpma' % (ssh, host)
	if cfg: ssh = ssh + ' -b'
	ssh = '%s %s %d' % (ssh, guid, i)
	if gp_opt['-v']: print '[INFO] exec', ssh
	p = popen2.Popen4(ssh)
	if cfg:
	    for key in cfg:
		if p.poll() != -1:
		    p.tochild.write('%s=%s\n' % (key, cfg[key]))
	p.tochild.close()
	out = []
	permissionDenied = False
	for line in p.fromchild:
	    out.append(line)
	    if gp_opt['-v']: print '[INFO %s] %s' % (host, line)
	    permissionDenied = permissionDenied or (line.find('Permission denied') >= 0)
	status = p.wait()
	if permissionDenied:
	    print
	    print 'Error: unable to ssh to', host
	    print '     - check if host is alive'
	    print '     - use gpssh-exkeys to setup public-key authentication between hosts'
	    print
	    sys.exit(1)
	if status:
	    print
	    print 'Error: problem starting gpma on', host
	    if not gp_opt['-v']: print '\n'.join(out)
	    sys.exit(1)
	

def ma_get(host, port, guid, obj, cmd, params):
    params = urllib.urlencode(params)
    url = 'http://%s:%d/%s/%s/%s?%s' % (host, port, guid, obj, cmd, params)
    if gp_opt['-v']: print '[INFO] GET', url
    try:
	try:
	    f = None
	    f = urllib.urlopen(url)
	    res = ''
	    while 1:
		r = f.read()
		if not r: break
		res = res + r
	    res = json.read(res)
	finally:
	    if f: f.close()
    except IOError:
	return False    # return False so caller will try another host
    except json.ReadException:
	raise GPError, 'bad result from MA'
    return res

def gpArrayInit():
    import commands
    try:
	cfg = parseConfigFile(gp_cmdopt['-c'] == '-' and sys.stdin or gp_cmdopt['-c'])
	gp_opt['-a'] = cfg['sys.name']
	if not cfg.has_key('sys.guid'):
	    lsout = commands.getoutput('ls -la /')
	    seed = cfg['sys.name'] + time.ctime() + lsout
	    cfg['sys.guid'] = '%04d%04d-%04d%04d' % (urandom(seed), 
						     urandom(time.ctime()), 
						     urandom(cfg['sys.name'] + str(urandom())),
						     urandom(lsout + str(time.time())))
	ma = parseConfigMA(cfg)
	ma_port = parseConfigMAPort(cfg)
	ma_start(ma, cfg['sys.guid'], cfg)
	ma_get(ma[0][0], ma_port, cfg['sys.guid'], 'array', 'init', {})
    except GPError, e:
	sys.exit('Error(GP): ' + str(e))
    except IOError, e:
	sys.exit('Error(I/O): %s while reading config file "%s"' % (e[1], gp_cmdopt['-c']))

    sys.exit(0)

    
