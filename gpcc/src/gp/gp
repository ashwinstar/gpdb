#!/usr/bin/env python
"""
gp -- Greenplum Terminal Control

Usage: gp [gp_options] command [command_options] [command_args]

	gp_options:
	    -v verbose
	    -a array_name
	    -h host_name
	    -p port

	command:
	    start 
	    stop

"""

import os, sys, getopt, types, time, popen2, urllib, httplib

if sys.version_info < (2, 3):
    sys.exit("Error: gp is supported on Python versions 2.3 or greater\n"
             + "Please upgrade python installed on this machine.")

sys.path.append(sys.path[0] + '/lib')
try:
    import simplejson
except ImportError, e:
    sys.exit('Error: unable to import module: ' + str(e))


def usage(exitarg):
    help_path = os.path.join(sys.path[0], '..', 'doc', 'gp_help');
    try:
        f = open(help_path)
        for line in f:
            print line,
    except:
        print __doc__
    sys.exit(exitarg)

gp_opt = {}
gp_cmd = None
gp_args = []

def resetCommandOptions():
    global gp_opt, gp_cmd, gp_args
    gp_opt = { 
        '-v': False,
        '-?': False,
        '-a': os.environ.get('GPARRAY', None),
        '-h': os.environ.get('GPHOST', None),
        '-p': os.environ.get('GPPORT', None),
        }
    gp_cmd = None
    gp_args = []
    

def parseCommandLine(argv):
    global gp_opt, gp_cmd, gp_args
    (options, args) = getopt.getopt(argv[1:], '?va:h:p:')
    for (switch, val) in options:
        if switch == '-?': gp_opt[switch] = True
        elif switch == '-v': gp_opt[switch] = True
        elif switch[1] in ('a', 'h', 'p'): gp_opt[switch] = val
    if args:
        gp_cmd = args[0]
        gp_args = args[1:]


def readRCFile():
    global gp_opt, gp_cmd, gp_args
    f = None
    try:
        fname = os.environ.get('HOME', '/') + '/.gprc'
        try:
            f = open(fname)
        except IOError:
            return
        for line in f:
            if line.startswith('gp '):
                argv = line.split()
                try:
                    parseCommandLine(argv)
                    if gp_cmd or gp_args:
                        raise SystemExit
                    gp_opt['-?'] = False
                except (SystemExit, getopt.GetoptError):
                    print "Warning: error in '%s'. Ignored." % fname
                    resetCommandOptions()
                    return
    finally:
        if f: f.close()


def checkCommandLine():
    if gp_opt['-?']: usage(0)
    if not gp_opt['-a']: usage('Error: please specify -a array_name')
    if not gp_opt['-h']: usage('Error: please specify -h host_name')
    if not gp_opt['-p']: usage('Error: please specify -p port')
    if not gp_cmd: usage('Error: please specify command')
    try:
        gp_opt['-p'] = int(gp_opt['-p'])
    except ValueError:
        usage('Error: bad -p port parameter')



def hitMA(cmd, params):
    params = urllib.urlencode(params)
    f = None
    json = ''
    try:
        f = httplib.HTTPConnection("%s:%d" % (gp_opt['-h'], gp_opt['-p']))
        f.request("GET", "%s?%s" % (cmd, params))
        response = f.getresponse();
        if response.status == 200:
            s = response.read()
            # print s
            json = simplejson.loads(s)
    finally:
        if f: f.close()
    return json
    
def printError(json):
    status = json.get('status')
    if status:
        print 'status:', status
    errmsg = json.get('errmsg')
    if not errmsg:
        print '%s: %s' % ('Error', 'unknown error')
        return
    if errmsg.get('_', None):
        print '%s: %s' % ('Error', errmsg.get('_'))
    for key in errmsg: 
        if key != '_': 
            print '%s: %s' % (key, errmsg.get(key))


def getStatus():
    params = { 'a': gp_opt['-a'] }
    json = hitMA('/gpcc/status', params)
    print '/gpcc/status:', json
    status = json.get('status', '')
    x = json.get('rset', {})
    x = x.get('result', [])
    if len(x): 
        x = x[0] 
    else:
        x = ''
    return (json, status, x)


def doStart(args):
    params = {'a': gp_opt['-a']}
    json = hitMA('/gpcc/start', params)
    if not json.get('status') in ('ok', 'pending'):
        printError(json)
        return
    cur = 'starting'
    for i in xrange(30):
        print '.',
        time.sleep(1)
        (json, status, array_status) = getStatus()
        if status != 'ok':
            print
            printError(json)
            return
        if array_status != cur:
            cur = array_status
            break
    print
    if cur == 'starting':
        print 'error: timeout'
    elif cur == 'running':
        print 'ok:', cur
    elif cur == 'stopping' or cur == 'stopped':
        print 'error:', cur
    else:
        print 'error: unknown; not started.'
    return


def doStop(args):
    params = {'a': gp_opt['-a']}
    json = hitMA('/gpcc/stop', params)
    if not json.get('status') in ('ok', 'pending'):
        printError(json)
        return
    cur = 'stopping'
    for i in xrange(30):
        print '.',
        time.sleep(1)
        (json, status, array_status) = getStatus()
        if status != 'ok':
            print
            printError(json)
            return
        if array_status != cur:
            cur = array_status
            break
    print
    if cur == 'stopping':
        print 'error: timeout'
    elif cur == 'stopped':
        print 'ok:', cur
    elif cur == 'starting' or cur == 'running':
        print 'error:', cur
    else:
        print 'error: unknown; not stopped.'
    return


def doStatus(args):
    params = { 'a': gp_opt['-a'] }
    (json, status, array_status) = getStatus()
    if status != 'ok':
        printError(json)
        return
    print array_status


def main():
    resetCommandOptions()
    readRCFile()
    parseCommandLine(sys.argv)
    checkCommandLine()
    if gp_cmd == 'start':
        doStart(gp_args)
    elif gp_cmd == 'stop':
        doStop(gp_args)
    elif gp_cmd == 'status':
        doStatus(gp_args)
    else:
        usage('Invalid command')


if __name__ == '__main__':
    main()
    
        
