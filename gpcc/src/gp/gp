def doListConfig(args):
    params = { 'a': gp_opt['-a'] }
    (retcode, json) = hitMA('/gpcc/lscfg', params)
    if retcode == 200:
        if json.get('status') != 'ok':
            printError(json)
            return
        cfg = json.get('rset', {})
        cfg = cfg.get('result', [])
        if not len(cfg):
            print 'error: unknown; cannot get configuration'
            return
        for i in cfg:
            print i[0], ':', i[1]
        print
    else:
        printError(json)
        return


def doInit(args):
    if len(args) == 0:
        usage(1)
    if not os.path.exists(args[0]):
        print 'error: config file not found'
        return
    content = ''
    try:
        f = open(args[0], "r")
        content = f.read()
        f.close()
    except IOError:
        print 'error: open config file failed'
        return

    redirect = 0
    while redirect < 5:
        (retcode, json) = hitMAbyPost('/gpcc/init', {}, content)
        if retcode == 200:
            if not json.get('status') in ('ok', 'pending'):
                printError(json)
                return
            cur = 'initializing'
            for i in xrange(3600):
                printDotSleep()
                (json, status, array_status) = getStatus()
                if status != 'ok':
                    print
                    printError(json)
                    return
                if array_status != cur:
                    cur = array_status
                    break
            print
            if cur == 'initializing':
                print 'error: timeout'
            elif cur == 'stopped':
                print 'ok: initialized.'
            elif cur == 'none':
                print 'error: not initialized.'
            else:
                print 'error: unknown; not initialized.'
            return
        elif retcode == 301:
            location = json.get('location')
            addr = location.split(':')
            gp_opt['-h'] = addr[0]
            gp_opt['-p'] = int(addr[1])
            redirect += 1
            print 'redirect to %s:%d' % (gp_opt['-h'], gp_opt['-p'])
        else:
            printError(json)
            return
            
