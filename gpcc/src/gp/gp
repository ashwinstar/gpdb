class LoginCmd(Command):
    '''Usage: gp login [username]'''
    def __init__(self, gopt, argv):
        Command.__init__(self, gopt, argv, '', self.__doc__)
        self.opt['-u'] = None
        if len(self.args) == 1:
            self.opt['-u'] = self.args[0]
        if self.opt['-u'] is None:
            self.opt['-u'] = os.getenv('USER') or os.getenv('LOGNAME')

    def run(self):
        if self.opt['-u'] is None:
            sys.stdout.write('username: ')
            user = sys.stdin.readline()
            user = user.strip()
            if user == '':
                sys.exit('please specify user.')
            self.opt['-u'] = user
        for i in xrange(3):
            passwd = getpass('password:')
            param = {}
            content = {}
            if (self.gopt['-a']): param['a'] = self.gopt['-a']
            content['user'] = self.opt['-u']
            content['password'] = passwd
            data = urllib.urlencode(content)
            packet = self._httpPost('/gpcc/login', param, data, 'application/x-www-form-urlencoded')
            self.raw(packet)         
            if 'ok' != packet.get('status'):
                print '[ERROR] unable to login. details:'
                printPacket(packet, '     ')
                sys.exit(2)
            else:
                try:
                    f = open('%s/.gpcc' % os.getenv('HOME'), 'w')
                    rset = packet['rset']
                    if len(rset) > 0:
                        f.write(rset[0])
                    f.close()
                except IOError, e:
                    print '[ERROR] unable to write file to %s/.gpcc. (%s)' % (os.getenv('HOME'), e)
                    sys.exit(2)
                print '%s logged on' % self.opt['-u']
                sys.exit(0)

        print '[ERROR] login failed.'
        sys.exit(2)

