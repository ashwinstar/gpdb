class InitCmd(Command):
    '''Usage: gp init -c {- | conf_file}'''
    def __init__(self, gopt, argv):
        Command.__init__(self, gopt, argv, 'c:', self.__doc__)
        self.opt['-c'] = None
        for (switch, val) in self.options:
            if switch == '-c': self.opt[switch] = val
        if not self.opt['-c']:
            print self.__doc__
            sys.exit('[ERROR] Please specify -c param')
        
        if self.sid is None:
            print '''[ERROR] you are not logged on.  Please do 'gp login' to log on.'''
            sys.exit(1)

    def run(self):
        fname = self.opt['-c']
        try:
            fp = None; cfg = {}
            fp = fname == '-' and sys.stdin or open(fname)
            lineno = 0
            for line in fp:
                lineno = lineno + 1
                line = line.strip().split('#')[0].strip()
                if line: 
                    line = line.split('=')
                    if len(line) != 2: 
                        print '[ERROR] syntax error at line %d in config file' % lineno
                        sys.exit(2)
                    #print '%d %s' % (lineno, line)
                    if line[0] == 'array_name' and line[1] != self.gopt['-a']:
                        print '[ERROR] array name mismatch at line %d in config file' % lineno
                        sys.exit(2)
                    cfg[line[0].strip()] = line[1].strip()
        except IOError:
            print ('[ERROR] unable to read file "%s"' % 
                   (fname == '-' and 'stdin' or fname))
            sys.exit(2)
        finally:
            if fp: fp.close()

        if not cfg:
            print '[ERROR] config file is empty'
            sys.exit(2)
        
        if not cfg.get('array_name'): 
            print '[ERROR] array_name not specified in config file'
            sys.exit(2)

        param = {}
        if (self.gopt['-a']): param['a'] = self.gopt['-a']
        content = '\n'.join('='.join([x, cfg[x]]) for x in cfg.keys())
        packet = self._httpPost('/gpcc/init', param, content)
        self.raw(packet)
        
        if 'ok' != packet.get('status'):
            print '[ERROR] unable to init, details:'
            printPacket(packet, '      ')
            sys.exit(2)

        in_progress = 'array initializing'
        succeed = 'array stopped'
        packet = self._waitStatus(param, in_progress, 60*5)
        if not packet:
            sys.exit('[ERROR] timeout')

        if succeed == (packet['rset'])[0]:
            print '[INFO] ok'
            return

        print '[ERROR] unknown status, details:'
        printPacket(packet, '      ')
        sys.exit(2)

            

