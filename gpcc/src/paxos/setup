#!/bin/sh
rm -rf data
mkdir data
cd data
priests=
host=`hostname`
for a in {0..4}
do
    mkdir Priest-$a
    port=$[2000+$a]
    address="$host:$port"
    if test "x$priests" = "x"
    then
	priests="$address"
    else
	priests="$priests,$address"
    fi
    echo>Priest-$a/configuration -e "host=$host\nport=$port\n"
done
for a in Priest-*
do
    echo>>$a/configuration -e "priests=$priests\n"
    mkdir $a/data
    echo>$a/run -e "#!/bin/sh\npython ../../bin/main.pyc Priest&"
    echo>$a/kill -e '#!/bin/sh\ntest -f pid&&kill `cat pid`'
done
>Priest-0/data/start
for a in Tester-{0..0}
do
    mkdir $a
    echo>$a/run -e "#!/bin/sh\npython ../../bin/main.pyc Tester $priests&"
    echo>$a/kill -e '#!/bin/sh\ntest -f pid&&kill `cat pid`'
done
echo>runAll -e '#!/bin/sh\nfor a in *-*;do (cd $a&&sh run);done'
echo>killAll -e '#!/bin/sh\nfor a in *-*;do (cd $a&&sh kill);done'
