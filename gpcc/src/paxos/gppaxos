#!/usr/bin/env python
import os
import sys

def usage():
    sys.stderr.write("usage:\n")
    sys.stderr.write("    python "+sys.argv[0]+" -d data_directory [-p port]\n")
    sys.exit(1)


def main():
    datadir = None
    argv = sys.argv[1:]
    port = 2000
    while argv:
	a = argv.pop(0)
	if a=='-d':
	    datadir = argv.pop(0)
	elif a=='-p':
	    port = int(argv.pop(0))
	else:
	    usage()
    if datadir==None:
	usage()
    os.chdir(datadir)
    try:
	os.makedirs("Priest-0/data")
    except OSError:
	pass
    open("Priest-0/data/start","wb").close()
    os.execl("/bin/sh","/bin/sh","-c","exec python -u $GPHOME/bin/lib/paxos/main.pyc test -port %d"%port)

main()
