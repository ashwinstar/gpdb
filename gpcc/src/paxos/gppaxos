#!/usr/bin/env python
import os
import socket
import sys

def usage():
    sys.stderr.write("usage:\n")
    sys.stderr.write("    python "+sys.argv[0]+" -d data_directory [-v] [-p port] [-P host1:port1] [-P host2:port2] ...\n")
    sys.exit(1)

def normalize(address):
    hostandport = address.split(':')
    if len(hostandport)!=2:
	sys.stderr.write("You must specify computer as host:port.\n")
	sys.exit(1)
    try:
	a = socket.gethostbyname(hostandport[0])
    except:
	sys.stderr.write("gethostbyname(%s) failed.\n"%hostandport[0])
	sys.exit(1)
    return "%s:%d"%(a,int(hostandport[1]))

def main():
    datadir = None
    argv = sys.argv[1:]
    minusP = []
    port = 2000
    extraStuff = ""
    while argv:
	a = argv.pop(0)
	if a=='-d':
	    datadir = argv.pop(0)
	elif a=='-v':
	    extraStuff += " -verbose"
	elif a=='-p':
	    port = int(argv.pop(0))
	elif a=='-P':
	    minusP.append(argv.pop(0))
	else:
	    usage()
    if datadir==None:
	usage()
    os.chdir(datadir)
    try:
	os.makedirs("Priest-0/data")
    except OSError:
	pass
    if not minusP:
	minusP = ["%s:%d"%(socket.gethostname(),port)]
    minusP = sorted(map(normalize,minusP))
    if normalize("%s:%d"%(socket.gethostname(),port))==minusP[0]:
	open("Priest-0/data/start","wb").close()
    os.execl("/bin/sh","/bin/sh","-c","exec python -u $GPHOME/bin/lib/paxos/main.pyc test -port %d -computers '%s' %s"%(port,','.join(minusP),extraStuff))

main()
