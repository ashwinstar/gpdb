$def with (stime, etime, tkeys, hkeys, ckeys, tab)
<?xml version="1.0"?>
<system start="$stime" end="$etime">
$for h in hkeys:
    <host name="$h">
    $for c in ckeys:
        <$c>
        $for t in tkeys:
	    $ v = tab[(h, t)]
	    $if not v: v = {}
	    $ v = v.get(c, '#')
	    ${v}:
        </$c>
    </host>
</system>
