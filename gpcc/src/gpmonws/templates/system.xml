$def with (ctime, hosts)
<?xml version="1.0"?>
<system start="$ctime" end="$ctime">
$ keys = None
$for row in hosts:
    <host name='$row['hostname']'>
            $if not keys:
            $    keys = row.keys()
	    $    keys.sort()
            $for k in keys: <${k}>${row[k]}</${k}>
    </host>
</system>
