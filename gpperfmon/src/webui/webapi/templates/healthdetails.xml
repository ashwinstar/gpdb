$def with (hostname, rows)
<?xml version="1.0"?>
<HealthDetails>
<Host Name='$hostname'>
$for r in rows:
    <Line>    
        <ComponentName>$r[2]</ComponentName>
        <ObjectID>$r[1]</ObjectID>
        <Status>$r[3]</Status>
        <Message>$r[4]</Message>
    </Line>
</Host>
</HealthDetails>
