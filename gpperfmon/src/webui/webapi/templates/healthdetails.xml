$def with (hostname, rows)
<?xml version="1.0"?>
<HealthDetails>
<Host Name='$hostname'>
$for r in rows:
    <Line>    
        <Component Name>$r[2]</Component Name>
        <Object ID>$r[1]</Object ID>
        <Status>$r[3]</Status>
        <Message>$r[4]</Message>
    </Line>
</Host Name>
</HealthDetails>
