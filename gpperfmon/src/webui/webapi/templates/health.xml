$def with (updatetime, table)
<?xml version="1.0"?>
<Health>
<LastUpdateTime>$updatetime</LastUpdateTime>
<CategoryView>
$for k in table.keys():
    <Category Name="$k">
    $for r in table[k]:
        <Line>
            <HostName>$r[0]</HostName>
            <Status>$r[1]</Status>
        </Line>
    </Category>
</CategoryView>
</Health>
