$def with (stime, etime, interval, tkeys, hkeys, ckeys, tab)
<?xml version="1.0"?>
<system start="$stime" end="$etime" interval="$interval" aggregated="N">
$for h in hkeys:
    <host name="$h">
    $for c in ckeys:
        <$c> \
        $for t in tkeys:
	    $ v = tab[(h, t)]
	    $if not v: v = {}
	    $ v = v.get(c, '#')
	    ${loop.index != 1 and '|' or ''} ${v} \
        </$c>
    </host>
</system>
