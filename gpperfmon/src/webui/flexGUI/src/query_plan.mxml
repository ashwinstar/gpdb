<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" width="100%" height="100%" show="onShow()">
	<mx:HTTPService id="getQueryPlan" url="{mx.core.Application.application.urlPrefix + 'queryplan'}" useProxy="false" method="GET" showBusyCursor="true" fault="faultHandler(event,'getQueryPlan')" result="getQueryPlanResultHandler(event)">
		<mx:request xmlns="">
			<sid>{mx.core.Application.application.sid}</sid>
			<tmid>{mx.core.Application.application.queryMetricsView.dgQueries.selectedItem.tmid}</tmid>
			<ssid>{mx.core.Application.application.queryMetricsView.dgQueries.selectedItem.ssid}</ssid>
			<ccnt>{mx.core.Application.application.queryMetricsView.dgQueries.selectedItem.ccnt}</ccnt>
		</mx:request>
	</mx:HTTPService>

	<mx:VBox height="100%" width="100%">
		<mx:HBox height="10%" width="100%" paddingLeft="5">
			<mx:Label text="Query Text: " width="10%"/>
			<mx:Label id="queryString" text="{mx.core.Application.application.queryMetricsView.dgQueries.selectedItem.query_text}" width="90%"/>
		</mx:HBox>
		<mx:HBox height="90%" width="100%">
			<mx:Tree id="queryPlanTree" dropEnabled="false" render="treeRenderer()" dragEnabled="false" dragMoveEnabled="false" x="10" y="10" width="50%" height="100%" labelField="@label" dataProvider="{tree}" showRoot="false" top="0" bottom="0" iconField="@icon" itemClick="treeClickHandler(event)" borderThickness="0"/>
			<mx:DataGrid dataProvider="{dataNode}" height="100%" width="50%">
				<mx:columns>
					<mx:DataGridColumn headerText="Name" dataField="name"/>
					<mx:DataGridColumn headerText="Value" dataField="value"/>
				</mx:columns>
			</mx:DataGrid>
		</mx:HBox>
	</mx:VBox>
	<!-- iconFunction="setIcons"  -->
	
	<mx:Style source="styles.css" />	
	<mx:Script>
	<![CDATA[
		include "include/defines.as";
		include "include/common.as";
		include "include/images.as";
		import mx.core.Application
		import flash.events.*;
        import mx.events.*;
        import mx.controls.*;
		import mx.controls.Alert;
        import mx.managers.PopUpManager;
        import mx.collections.ArrayCollection;
 
 		[Bindable] private var tree:XML;
 		
        private var dataNodes:Object;
        [Bindable] private var dataNode:ArrayCollection;
        
                  
 		private function onShow():void
		{
			mx.core.Application.application.checkboxRealTime.visible=false;
			mx.core.Application.application.hostname.visible=false;
		}

		[Bindable]
		public var treeReopen:Boolean = false;
		[Bindable]
		public var treeOpenItems:Array;
		public var treeVerticalPosition:Number = 0;
		
		public function treeRenderer():void
		{
			if(treeReopen)
			{
				treeReopen = false;
				
				// avoid blinking in and out
				queryPlanTree.invalidateList();
				// always expand root
				queryPlanTree.expandItem(tree, true);
				if(treeOpenItems != null)
				{
					for(var i:int=0; i<treeOpenItems.length; i++)
					{
						for each(var project:XML in tree.children())
						{
							// if the current openItem is a project and we match then just open it.
							if(treeOpenItems[i].name() == "project" && project.@label == treeOpenItems[i].@label)
							{
								queryPlanTree.expandItem(project, true);
								break;
							}
							// if we have a cube or log we have to go down one level.
							else if(treeOpenItems[i].name() != "blade" && treeOpenItems[i].name() != "project" && treeOpenItems[i].@project == project.@label)
							{
								for each(var child:XML in project.children())
								{
									if(child.name() == treeOpenItems[i].name())
									{
										queryPlanTree.expandItem(child, true);
										break;
									}	
								}
							}
						}
					}
				}
				queryPlanTree.validateNow();
				queryPlanTree.verticalScrollPosition = treeVerticalPosition;
			}
		}

		public function reloadTree():void
		{
			treeVerticalPosition = queryPlanTree.verticalScrollPosition;
			treeReopen = true;
			treeOpenItems = queryPlanTree.openItems as Array;
			getQueryPlan.send();
		}

		private function treeClickHandler(event:Event):void
		{
			var node:XML=event.target.selectedItem;
			
			if(node.name() == "iterator")
			{
				selectDataNode(node.@id);
			}
		}

		private function getQueryPlanResultHandler(event:ResultEvent):void
		{
			if(checkHttpServiceResultsForFailure("getQueryPlanResultHandler()", event, (event.result.queryplan == null)))
				return;

			//Alert.show("host=" + mx.core.Application.application.hostname.selectedItem + "&tmid=" + mx.core.Application.application.queryMetricsView.dgQueries.selectedItem.tmid + "&ssid=" + mx.core.Application.application.queryMetricsView.dgQueries.selectedItem.ssid + "&ccnt=" + mx.core.Application.application.queryMetricsView.dgQueries.selectedItem.ccnt);

			treeReopen = true;

			// K-L-U-D-G-E
			tree = new XML(event.message.body);
			dataNodes = new Object();
			pruneData(tree.children());
		}
		
		private function pruneData(list:XMLList):void
		{
			for (var i:int = list.length() - 1; i >= 0; i--)
			{
				if(list[i].name() == "data")
				{
					var attributes:XMLList = list[i].parent().attributes();
					var id:String = null;
					for(var j:int = 0; j<attributes.length(); j++)
					{
						if(attributes[j].name() == "id")
						{
							id = attributes[j].valueOf();
							break;
						}
					}

					if(id == null)
					{
						Alert.show("Couldn't find an id for this data node");
						continue;
					}
								
					buildDataNode(id, list[i].children());
					delete(list[i]);
				}
				else
				{
					pruneData(list[i].children());
				}
			}
		}
		
		private function buildDataNode(id:String, list:XMLList):void
		{
			var array:ArrayCollection = new ArrayCollection();
			
			for (var i:int=0; i<list.length(); i++)
			{
				var object:Object = new Object();
				object["name"] = list[i].name();
				object["value"] = list[i].valueOf().toString();
				array.addItem(object);
			}
			
			dataNodes[id] = array;
		}
		
		private function selectDataNode(id:String):void
		{
			dataNode = dataNodes[id];
		}

 	 ]]>
	 </mx:Script>
</mx:Canvas>
