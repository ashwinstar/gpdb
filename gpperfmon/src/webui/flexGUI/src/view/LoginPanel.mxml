<?xml version="1.0" encoding="utf-8"?>
<mx:HBox xmlns:mx="http://www.adobe.com/2006/mxml" width="100%" height="100%">

<mx:Script>
<![CDATA[
	import mx.controls.Text;
	import mx.controls.TabBar;
    import model.GPPerfMonModelLocator;
  	import mx.managers.CursorManager;
  	import model.Resources;
  	
  	[Bindable]
	public var mdl : GPPerfMonModelLocator = GPPerfMonModelLocator.getInstance();	
		
	// Resets the form
	public function reset():void
	{
		loginTI.text = "";
		passwordTI.text = "";
		loginError.text = "";
		loginTI.setFocus();
	}
	
	private function tryLogin():void 
	{
		loginForm.enabled = false;
		CursorManager.setBusyCursor();
		mdl.session.login(loginTI.text, passwordTI.text, uiLoginResult);
    }
    
    // Called with success or failure
    public function uiLoginResult(success:Boolean, message:String):void
    {
 	    reset();
 
    	if (!success)
			loginError.text = message;

		CursorManager.removeBusyCursor();
		loginForm.enabled = true;
    }
   ]]>
</mx:Script>

	<mx:VBox width="50%" height="100%" horizontalAlign="center" >
		<mx:Image source="{Resources.gp_logo_med}" scaleContent="false"/>
		<mx:Spacer height="20"/>
		<mx:Label styleName="mainTitle" text="Greenplum Performance Monitor"/>
		<mx:Label text="{Resources.instance.versionString}"/>
		<mx:Label styleName="footerText" text="{Resources.copyright}"/>
		<mx:Spacer height="100"/>
	</mx:VBox>
	
	<mx:VBox width="50%" height="100%" horizontalAlign="center" verticalAlign="middle">

		<mx:Panel title="Please enter your login details">
			<mx:Form id="loginForm" verticalGap="10" defaultButton="{submitLoginBtn}">
		        <mx:FormItem label="Server:">
		            <mx:Label fontWeight="bold" text="{mdl.session.databaseName}"/>
		        </mx:FormItem>
		        <mx:FormItem label="Username:">
		            <mx:TextInput id="loginTI" width="150"/>
		        </mx:FormItem>
		        <mx:FormItem label="Password:">
		            <mx:TextInput id="passwordTI" width="150" displayAsPassword="true"/>
		        </mx:FormItem>
		        <mx:FormItem direction="horizontal" paddingTop="10">
		            <mx:Button id="submitLoginBtn" label="Login"
		                click="tryLogin()"/>
		            <mx:Button id="resetBtn" label="Reset"
		                click="reset()"/>
		        </mx:FormItem>
	        	<mx:Label color="0xFF0000" id="loginError"/>
		    </mx:Form>			 
		</mx:Panel>

	</mx:VBox>
	
	<mx:Spacer width="10"/>

</mx:HBox>
