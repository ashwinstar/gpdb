	</mx:VBox>

	<mx:VBox width="40%" height="100%">
		<mx:Form>
			<mx:FormItem label="Node type" fontWeight="bold">
				<mx:Label text="{selectedXML.@ntype}" fontWeight="normal"/>
			</mx:FormItem>
			<mx:FormItem label="Last updated" fontWeight="bold">
				<mx:Label text="{selectedXML.@sample_time}" fontWeight="normal"/>
			</mx:FormItem>
			<mx:FormItem label="Node status" fontWeight="bold">
				<mx:Label text="{selectedXML.@nstatus}" fontWeight="normal"/>
