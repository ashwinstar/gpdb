		    labelFunction="labelFunction" iconFunction="iconFunction"
		    borderThickness="0" itemClose="itemClose(event)" itemOpen="itemOpen(event)"
		    rollOverColor="0xDFFCB2" selectionColor="0xBFDC92"
		    creationComplete="BindingUtils.bindSetter(treeDataChange, mdl.queries, 'queryPlanCurrent')"/>-->
		    
			<control:AutoSizeTree id="queryPlanTree" dropEnabled="false" 
			dragEnabled="false" dragMoveEnabled="false" 
			render="saveScrollPositions()"
