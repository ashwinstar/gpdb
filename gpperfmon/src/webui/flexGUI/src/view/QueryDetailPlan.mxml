				<mx:Label text="{selectedXML.@tstart}" fontWeight="normal"/>
			</mx:FormItem>					
			<mx:FormItem label="Duration" fontWeight="bold">
				<mx:Label text="{nformat2.format(selectedXML.@tduration) + ' (avg)'}" fontWeight="normal"/>
			</mx:FormItem>						
			<mx:FormItem label="PMem Size" fontWeight="bold">
				<mx:Label text="{nformat0.format(selectedXML.@pmemsize) + ' (avg)'}" fontWeight="normal"/>
			</mx:FormItem>		
			<mx:FormItem label="PMem Max" fontWeight="bold">
				<mx:Label text="{nformat0.format(selectedXML.@pmemmax) + ' (avg)'}" fontWeight="normal"/>
			</mx:FormItem>	
			<mx:FormItem label="Mem Size" fontWeight="bold">
				<mx:Label text="{nformat0.format(selectedXML.@memsize) + ' (avg)'}" fontWeight="normal"/>
			</mx:FormItem>		
			<mx:FormItem label="Mem Resident" fontWeight="bold">
				<mx:Label text="{nformat0.format(selectedXML.@memresid) + ' (avg)'}" fontWeight="normal"/>
			</mx:FormItem>	
			<mx:FormItem label="Shared mem" fontWeight="bold">
				<mx:Label text="{nformat0.format(selectedXML.@memshare) + ' (avg)'}" fontWeight="normal"/>
			</mx:FormItem>	
			<mx:FormItem label="Rows out" fontWeight="bold">
				<mx:Label text="{nformat0.format(selectedXML.@rows_out) + ' (sum)'}" fontWeight="normal"/>
			</mx:FormItem>				
			<mx:FormItem label="Rows estimate" fontWeight="bold">
				<mx:Label text="{nformat0.format(selectedXML.@rows_out_est) + ' (sum)'}" fontWeight="normal"/>
			</mx:FormItem>	
		</mx:Form>	
		
		<mx:Label text="Additonal attributes:" fontWeight="bold"/>
		<mx:Text htmlText="{extraAttributes}" width="100%"/>
	</mx:VBox>
	
	
	

</mx:HDividedBox>
