<?xml version="1.0" encoding="utf-8"?>
<mx:HBox xmlns:mx="http://www.adobe.com/2006/mxml" width="75" height="14" horizontalGap="2" 
	creationComplete="initComp()" verticalAlign="middle">
	<mx:Script>
		<![CDATA[
		
			/**
			 * @author vasu@divami.com
			 * <p>The StatusIndicatorLED component is used by the Tree nodes in QueryDetailPlan to display the CPU total, CPU Skew and Row Skew</p>
			 * <p> The component is extended from the HBox class.  
			 * The color of the LED changes based on the value being set. The value ranges for each color are:<br>
			 * value less than 25 - Green <br>
			 * value between 25 and 50 - Yellow <br>
			 * value between 50 and 75 - Orange <br>
			 * Value above 75 - Red
			 * </p>
			 *  <p>
			 *  Usage
			 *  <pre>
			 *  &StatusIndicatorLED
			 *    <strong>Properties</strong>
			 *    value="0"
			 *    &gt;
			 *    ...
			 *      <i>child tags</i>
			 *    ...
			 *  &lt;/StatusIndicatorLED&gt;
			 *  </pre>
			 *  </p>* 
			 */		
			
			[Embed(source="../assets/img/led_green.png")]
			private var ledGreenCls:Class;
			
			[Embed(source="../assets/img/led_red.png")]
			private var ledRedCls:Class;
			
			[Embed(source="../assets/img/led_yellow.png")]
			private var ledYellowCls:Class;
			
			[Embed(source="../assets/img/led_orange.png")]
			private var ledOrangeCls:Class;	
			
			private var __value:Number = 0;
			
			//gets triggered once the component's Visual creation is complete
			private function initComp():void{
				setLED();
			}
			
			/**
			 * @private
			 * Fills the background color of the box and positions the separator accordingly
			 */
			private function setLED():void{
					if (__value <= 25){
						statusImg.source = ledGreenCls;
					}else if (__value > 25 && __value <= 50){
						statusImg.source = ledYellowCls;
					}else if(__value > 50 && __value <= 75){
						statusImg.source = ledOrangeCls;
					}else if(__value > 75){
						statusImg.source = ledRedCls;
					}
				
				valueLbl.text = nformat2.format(__value);
			}//end of setLED					
			
			/**
			 * Sets/Gets the value of the control 
			 */
			[Inspectable]
			public function set value(val:Number):void{
				__value = val;
				
				if(valueLbl){
					setLED();
				}
			}
			
			public function get value():Number{
				return __value;
			}			
		]]>
	</mx:Script>
	<mx:NumberFormatter id="nformat2" precision="2"/>
	<mx:Image id="statusImg" width="14" height="14"/>
	<mx:Label id="valueLbl" height="14" width="100%" paddingTop="-1"/>
</mx:HBox>
