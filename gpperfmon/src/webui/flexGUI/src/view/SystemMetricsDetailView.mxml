<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml"
	width="100%" height="100%" xmlns:panel="panel.*" xmlns:chart="chart.*"
	creationPolicy="queued" creationComplete="canvasInit(event)">
<mx:VBox width="{this.width}" height="{this.height}">

<mx:Script>
    <![CDATA[
      import model.GPPerfMonModelLocator;
      import mx.charts.events.ChartItemEvent;
        			
  	  [Bindable]
	  public var mdl : GPPerfMonModelLocator = GPPerfMonModelLocator.getInstance();	
	  
	private function canvasInit(event:Event): void 
	{ 
		event.target.addEventListener(ChartItemEvent.CHANGE, chartItemEventChange, true, 0, true); 
	} 

	private function chartItemEventChange(event: Event): void 
	{ 
		var evt:ChartItemEvent = event as ChartItemEvent;
		if (evt)
			evt.stopImmediatePropagation(); 
	}
    ]]>
</mx:Script>	

	 <mx:HBox width="100%" styleName="largeMetricGraphTitleBackground" 
	 		verticalAlign="middle" dropShadowEnabled="true"
	   		borderThickness="0" borderStyle="solid" cornerRadius="6">
    	<mx:ComboBox id="metric" dataProvider="{mdl.nav.metricsList}" height="30" 
		 rowCount="10" styleName="largeMetricGraphCombo"
		 selectedIndex="{mdl.nav.metricSelected}"
		 change="{mdl.nav.metricSelected = metric.selectedIndex}"/>
	 </mx:HBox>

	 <mx:Panel width="100%" height="50%" styleName="titlelessPanel">	
		<mx:ViewStack id="systemMetricDetailGraph" width="100%" height="100%"
	    	selectedIndex="{mdl.nav.metricSelected}">
			<chart:ActiveQueriesChart width="100%" height="100%"/>
			<chart:MemoryChart width="100%" height="100%"/> 
			<chart:CPUChart width="100%" height="100%"/>
			<chart:LoadChart width="100%" height="100%"/> 
			<chart:SwapInUseChart width="100%" height="100%"/> 
			<chart:SwapPagingChart width="100%" height="100%"/> 
			<chart:DiskIOPSChart width="100%" height="100%"/>
			<chart:DiskIOBytesChart width="100%" height="100%"/>
			<chart:NetworkPacketsChart width="100%" height="100%"/> 
			<chart:NetworkBytesChart width="100%" height="100%"/> 		
		</mx:ViewStack>			
	 </mx:Panel> 

	<mx:Panel width="100%" height="50%" 
		title="{'Detailed data (' + 
			(mdl.nav.selectedSystemItem?
			    (mdl.nav.selectedSystemItem.sample_time.toString() + 
			       (mdl.system.selectedDataDetails?'':'    [ Loading... ]')):
				'no selection')
			 +')'}">
		<mx:ViewStack id="systemMetricDetailData" width="100%" height="100%"
	    	selectedIndex="{mdl.nav.metricSelected}">
			<chart:ActiveQueriesDetailPane/>
			<chart:Memory_DetailPane/>
			<chart:CPU_Load_DetailPane/>
			<chart:CPU_Load_DetailPane/>
			<chart:Swap_DetailPane/>
			<chart:Swap_DetailPane/> 
			<chart:Disk_DetailPane/>
			<chart:Disk_DetailPane/>
			<chart:Network_DetailPane/> 
			<chart:Network_DetailPane/>  		
		</mx:ViewStack>	
	</mx:Panel>
		
</mx:VBox>
</mx:Canvas>

