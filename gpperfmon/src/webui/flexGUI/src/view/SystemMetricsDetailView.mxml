<?xml version="1.0" encoding="utf-8"?>
<mx:VBox xmlns:mx="http://www.adobe.com/2006/mxml" width="100%" height="100%"
	xmlns:panel="panel.*" xmlns:chart="chart.*"
	creationPolicy="queued">
	
<mx:Script>
    <![CDATA[
      import model.GPPerfMonModelLocator;
  			
  	  [Bindable]
	  public var mdl : GPPerfMonModelLocator = GPPerfMonModelLocator.getInstance();	
    ]]>
</mx:Script>	

	<mx:Panel title="{mdl.nav.metricsList[mdl.nav.metricSelected]}" 
		width="100%" height="60%" styleName="largeMetricGraph">	
		<mx:ViewStack id="systemMetricDetailGraph" width="100%" height="100%"
        	selectedIndex="{mdl.nav.metricSelected-1}">
    		<chart:ActiveQueriesChart width="100%" height="100%"/>
    		<chart:MemoryChart width="100%" height="100%"/> 
    		<chart:CPUChart width="100%" height="100%"/>
    		<chart:LoadChart width="100%" height="100%"/> 
    		<chart:SwapInUseChart width="100%" height="100%"/> 
    		<chart:SwapPagingChart width="100%" height="100%"/> 
    		<chart:DiskIOPSChart width="100%" height="100%"/>
    		<chart:DiskIOBytesChart width="100%" height="100%"/>
    		<chart:NetworkPacketsChart width="100%" height="100%"/> 
    		<chart:NetworkBytesChart width="100%" height="100%"/> 		
		</mx:ViewStack>			
	</mx:Panel>
	
	<mx:Panel title="Details of last selected datapoint" width="100%" height="40%">	
		<mx:Text width="50%" text="{'TODO: This panel shows the value of all ' + 
				'data series at the x location of the last data point clicked. ' +
				'It also shows a histogram across machines for the point clicked.'}"/>							
	</mx:Panel>
		
</mx:VBox>

