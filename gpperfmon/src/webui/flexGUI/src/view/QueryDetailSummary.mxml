<?xml version="1.0" encoding="utf-8"?>
<mx:VBox xmlns:mx="http://www.adobe.com/2006/mxml" width="100%" height="100%">
		
<mx:Script>
    <![CDATA[
      import model.GPPerfMonModelLocator;
      import value.Query;		
	         	  
  	  [Bindable]
	  public var mdl : GPPerfMonModelLocator = GPPerfMonModelLocator.getInstance();
	  
    ]]>
</mx:Script>	

	<mx:NumberFormatter id="nformat0" precision="0"/>
	<mx:NumberFormatter id="nformat2" precision="2"/>
	
	<mx:VDividedBox width="100%" height="100%">
		<mx:HBox width="100%">
			
			<mx:Form>
				<mx:FormItem label="Query ID" fontWeight="bold">
					<mx:Label text="{mdl.nav.detailQuery.id}" fontWeight="normal"/>
				</mx:FormItem>
				<mx:FormItem label="Last updated" fontWeight="bold">
					<mx:Label text="{mdl.nav.detailQuery.sample_time}" fontWeight="normal"/>
				</mx:FormItem>
				<mx:FormItem label="Submit time" fontWeight="bold">
					<mx:Label text="{mdl.nav.detailQuery.tsubmit}" fontWeight="normal"/>
				</mx:FormItem>
				<mx:FormItem label="Username" fontWeight="bold">
					<mx:Label text="{mdl.nav.detailQuery.username}" fontWeight="normal"/>
				</mx:FormItem>
				<mx:FormItem label="Database" fontWeight="bold">
					<mx:Label text="{mdl.nav.detailQuery.db}" fontWeight="normal"/>
				</mx:FormItem>
				<mx:FormItem label="Status" fontWeight="bold">
					<mx:Label text="{mdl.nav.detailQuery.status}" fontWeight="normal"/>
				</mx:FormItem>
				<mx:FormItem label="Rows out" fontWeight="bold">
					<mx:Label text="{nformat0.format(mdl.nav.detailQuery.rows_out)}" fontWeight="normal"/>
				</mx:FormItem>	

			</mx:Form>			
			<mx:Form>
				<mx:FormItem label="Wait time" fontWeight="bold">
					<mx:Label text="{nformat2.format(mdl.nav.detailQuery.time_queued)}" fontWeight="normal"/>
				</mx:FormItem>	
				<mx:FormItem label="Run time" fontWeight="bold">
					<mx:Label text="{nformat2.format(mdl.nav.detailQuery.time_run)}" fontWeight="normal"/>
				</mx:FormItem>	
				<mx:FormItem label="CPU %" fontWeight="bold">
					<mx:Label text="{nformat2.format(mdl.nav.detailQuery.cpu_currpct)}" fontWeight="normal"/>
				</mx:FormItem>	
				<mx:FormItem label="CPU total" fontWeight="bold">
					<mx:Label text="{nformat2.format(mdl.nav.detailQuery.cpu_elapsed)}" fontWeight="normal"/>
				</mx:FormItem>	
				<mx:FormItem label="CPU skew" fontWeight="bold">
					<mx:Label text="{nformat2.format(mdl.nav.detailQuery.skew_cpu)}" fontWeight="normal"/>
				</mx:FormItem>				
				<mx:FormItem label="Row skew" fontWeight="bold">
					<mx:Label text="{nformat2.format(mdl.nav.detailQuery.skew_rows)}" fontWeight="normal"/>
				</mx:FormItem>		
						
			</mx:Form>
		</mx:HBox>
		
			
		<mx:Panel title="{'Query Text'}"
			width="100%" styleName="smallMetricGraph" layout="horizontal">
				<mx:TextArea editable="false" width="100%" height="100%"
				    text="{mdl.nav.detailQuery.query_text}"/>
		</mx:Panel>	

	</mx:VDividedBox>

	
</mx:VBox>

