<?xml version="1.0" encoding="utf-8"?>
<mx:TitleWindow xmlns:mx="http://www.adobe.com/2006/mxml"
	xmlns:control="control.*" layout="horizontal"
	title="Query search"
	paddingLeft="10" paddingRight="10" paddingTop="10" paddingBottom="10" 
	verticalGap="10" borderAlpha="0.9" >

<mx:Script>
    <![CDATA[
      import command.QuerySearchCommand;
      import model.GPPerfMonModelLocator;
  	  import mx.managers.PopUpManager;
  	  import util.MiscUtils;
		
  	  [Bindable]
	  public var mdl : GPPerfMonModelLocator = GPPerfMonModelLocator.getInstance();
	  
	  private function submitData():void
	  {
	  	var searchSummary:String = "<b>Query filters</b>: ";

		if (queryID.text)
		{
			searchSummary += "[ Query ID: "+queryID.text+" ] ";
		
			// Issue the search
			var querySearchCommand:QuerySearchCommand = new QuerySearchCommand();
			
			querySearchCommand.setParameters(queryID.text);
			querySearchCommand.execute();  	
		}  
		else
		{ 
			if (startTime.getSelectedDateTime >= 0)
			{
				  searchSummary += "[ Start_time: "+
	  	  			 MiscUtils.formatDateToString(startTime.getSelectedDateTime)+" ] ";
			}
			else
			{
				errorMsg.text = "Search must include either ID or start time";
				return;
			}

			if (endTime.getSelectedDateTime >= 0)
			  searchSummary += "[ End_time: "+
			  			MiscUtils.formatDateToString(endTime.getSelectedDateTime)+" ] ";		
			
			if (username.text)
	  		   searchSummary += "[ Username: "+username.text+" ] ";
		
			if (database.text)
			   searchSummary += "[ Database: "+database.text+" ] ";
			  
			  
			var mintime:int = parseInt(minRuntime.text);
			if (mintime > 0)
			  searchSummary += "[ Min_query_time: "+
			  	mintime.toString()+" ] ";
			  		
			var status:String = '';
			if (!finished.selected || !aborted.selected)
			{
				if (finished.selected) 
					status = "done";
				else 
					status = "abort";
			
				searchSummary += "[ Status: "+status+" ] ";
			}
			
			if (searchSummary == "<b>Query filters</b>: ")
				searchSummary += "none";

			// Issue the search
			var qrySrchCmd:QuerySearchCommand = new QuerySearchCommand();
			
			qrySrchCmd.setParameters(null, startTime.getSelectedDateTime,
			                                 endTime.getSelectedDateTime,
			                                 status, mintime, 
			                                 username.text, database.text);
			qrySrchCmd.execute();                             
		}
		
		// Set the result summary string
		mdl.nav.qsearchSummary = searchSummary; 
		
		removeMe();
	}
	  	
    // Cancel button click event listener.
    private function removeMe():void {
    	PopUpManager.removePopUp(this);
    }
      	
    ]]>
</mx:Script>	

	<mx:Grid> 
		<mx:GridRow>
			<mx:GridItem horizontalAlign="left">
				<mx:Label fontWeight="bold" text="Search by query ID"/>
			</mx:GridItem>			
		</mx:GridRow>
		<mx:GridRow>
			<mx:GridItem horizontalAlign="right">
				<mx:Label text="Query ID:"/>
			</mx:GridItem>
			<mx:GridItem horizontalAlign="left">
				<mx:TextInput id="queryID" width="200"/>		
			</mx:GridItem>									
		</mx:GridRow>
		<mx:GridRow>
			<mx:GridItem horizontalAlign="left" paddingTop="10">
				<mx:Label fontWeight="bold" text="OR search by other criteria"/>
			</mx:GridItem>			
		</mx:GridRow>
		<mx:GridRow>
			<mx:GridItem horizontalAlign="right">
				<mx:Label text="Start time:"/>
			</mx:GridItem>
			<mx:GridItem horizontalAlign="left">
				<control:gpDatePicker id="startTime"/>
			</mx:GridItem>
		</mx:GridRow>	
		<mx:GridRow>
			<mx:GridItem horizontalAlign="right">
				<mx:Label text="End time:"/>
			</mx:GridItem>
			<mx:GridItem horizontalAlign="left">
				<control:gpDatePicker id="endTime"/>		
			</mx:GridItem>					
		</mx:GridRow>	
		<mx:GridRow>
			<mx:GridItem horizontalAlign="right">
				<mx:Label text="Username:"/>
			</mx:GridItem>
			<mx:GridItem horizontalAlign="left">
				<mx:TextInput id="username" width="200"
					visible="{mdl.session.isSuperuser}" 
					includeInLayout="{mdl.session.isSuperuser}"/>
				<mx:TextInput width="200" editable="false"
					text="{mdl.session.username}"
					visible="{!mdl.session.isSuperuser}" 
					includeInLayout="{!mdl.session.isSuperuser}"/>
			</mx:GridItem>
		</mx:GridRow>
		<mx:GridRow>
			<mx:GridItem horizontalAlign="right">
				<mx:Label text="Database:"/>
			</mx:GridItem>
			<mx:GridItem horizontalAlign="left">
				<mx:TextInput id="database" width="200"/>
			</mx:GridItem>
		</mx:GridRow>		
		<mx:GridRow>
			<mx:GridItem horizontalAlign="right">
				<mx:Label text="Query status:"/>
			</mx:GridItem>
			<mx:GridItem horizontalAlign="left">
				<mx:HBox>		
					<mx:CheckBox id="finished" label="finished" selected="true" 
						change="{if (!finished.selected) aborted.selected=true;}"/>		
					<mx:CheckBox id="aborted" label="aborted" selected="true"
						change="{if (!aborted.selected) finished.selected=true;}"/>
				</mx:HBox>			
			</mx:GridItem>				
		</mx:GridRow>	
		<mx:GridRow>
			<mx:GridItem horizontalAlign="right">
				<mx:Label text="Min. runtime (sec):"/>
			</mx:GridItem>
			<mx:GridItem horizontalAlign="left">
				<mx:TextInput id="minRuntime" width="200"/>
			</mx:GridItem>	
		</mx:GridRow>	
		<mx:GridRow>		
			<mx:GridItem colSpan="2" horizontalAlign="center" paddingTop="10">
				<mx:Button label="Cancel" click="removeMe();"/>	
				<mx:Button label="Search" click="submitData();"/>		
			</mx:GridItem>
		</mx:GridRow>	
		<mx:GridRow>		
			<mx:GridItem colSpan="2" horizontalAlign="center" paddingTop="10">
				<mx:Label fontWeight="bold" color="0xFF0000" id="errorMsg"/>		
			</mx:GridItem>
		</mx:GridRow>	
	</mx:Grid>
	
</mx:TitleWindow>
