<?xml version="1.0" encoding="utf-8"?>
<mx:TitleWindow xmlns:mx="http://www.adobe.com/2006/mxml"
	xmlns:control="control.*" layout="horizontal"
	title="Query search"
	paddingLeft="10" paddingRight="10" paddingTop="10" paddingBottom="10" 
	verticalGap="10" borderAlpha="0.9" >

<mx:Script>
    <![CDATA[
      import model.GPPerfMonModelLocator;
  	  import mx.managers.PopUpManager;
  	  import util.MiscUtils;
		
  	  [Bindable]
	  public var mdl : GPPerfMonModelLocator = GPPerfMonModelLocator.getInstance();
	  
	  private function submitData():void
	  {
		mdl.ql.qsearchSummary = "<b>Query filters</b>: ";
		
		mdl.ql.qsearchUsername = username.text;
		if (mdl.ql.qsearchUsername)
		  mdl.ql.qsearchSummary += "[ Username: "+mdl.ql.qsearchUsername+" ] ";
		  
		mdl.ql.qsearchDatabase = database.text;
		if (mdl.ql.qsearchDatabase)
		  mdl.ql.qsearchSummary += "[ Database: "+mdl.ql.qsearchDatabase+" ] ";
		  
		mdl.ql.qsearchStartTime = startTime.getSelectedDateTime;
		if (mdl.ql.qsearchStartTime >= 0)
		  mdl.ql.qsearchSummary += "[ Start_time: "+
		  			MiscUtils.formatDateToString(mdl.ql.qsearchStartTime)+" ] ";
		  
		mdl.ql.qsearchEndTime = endTime.getSelectedDateTime;
		if (mdl.ql.qsearchEndTime >= 0)
		  mdl.ql.qsearchSummary += "[ End_time: "+
		  			MiscUtils.formatDateToString(mdl.ql.qsearchEndTime)+" ] ";
		  					
		mdl.ql.qsearchMinTime = parseInt(minRuntime.text);
		if (mdl.ql.qsearchMinTime > 0)
		  mdl.ql.qsearchSummary += "[ Min_query_time: "+
		  	mdl.ql.qsearchMinTime.toString()+" ] ";
		
		mdl.ql.qsearchQueryID = queryID.text;
		if (mdl.ql.qsearchQueryID)
		  mdl.ql.qsearchSummary += "[ Query ID: "+mdl.ql.qsearchQueryID+" ] ";
		  		
		mdl.ql.qsearchStatus = "";
		if (!running.selected || !queued.selected || 
			!finished.selected || !aborted.selected)
		{
			if (running.selected)
				mdl.ql.qsearchStatus = "running";
			if (queued.selected) {
				if (mdl.ql.qsearchStatus == "")
					mdl.ql.qsearchStatus = "queued";
				else
					mdl.ql.qsearchStatus += " OR queued";
			}
			if (finished.selected) {
				if (mdl.ql.qsearchStatus == "")
					mdl.ql.qsearchStatus = "finished";
				else
					mdl.ql.qsearchStatus += " OR finished";
			}
			if (aborted.selected) {
				if (mdl.ql.qsearchStatus == "")
					mdl.ql.qsearchStatus = "aborted";
				else
					mdl.ql.qsearchStatus += " OR aborted";
			}			
			mdl.ql.qsearchSummary += "[ Status: "+mdl.ql.qsearchStatus+" ] ";
		}
	
		if (mdl.ql.qsearchSummary == "<b>Query filters</b>: ")
			mdl.ql.qsearchSummary += "none";
		
		// Set the result summary string
		
		mdl.ql.qsearchActive = 1;  
		
		removeMe();
	}
	  	
    // Cancel button click event listener.
    private function removeMe():void {
    	PopUpManager.removePopUp(this);
    }
      	
    ]]>
</mx:Script>	

	<mx:Grid> 
		<mx:GridRow>
			<mx:GridItem horizontalAlign="right">
				<mx:Label text="Username:"/>
			</mx:GridItem>
			<mx:GridItem horizontalAlign="left">
				<mx:TextInput id="username" width="200"/>
			</mx:GridItem>
		</mx:GridRow>
		<mx:GridRow>
			<mx:GridItem horizontalAlign="right">
				<mx:Label text="Database:"/>
			</mx:GridItem>
			<mx:GridItem horizontalAlign="left">
				<mx:TextInput id="database" width="200"/>
			</mx:GridItem>
		</mx:GridRow>		
		<mx:GridRow>
			<mx:GridItem horizontalAlign="right">
				<mx:Label text="Query status:"/>
			</mx:GridItem>
			<mx:GridItem horizontalAlign="left">
				<mx:HBox>
					<mx:CheckBox id="running" label="running" selected="true"/>	
					<mx:CheckBox id="queued" label="queued" selected="true"/>		
					<mx:CheckBox id="finished" label="finished" selected="true"/>		
					<mx:CheckBox id="aborted" label="aborted" selected="true"/>
				</mx:HBox>			
			</mx:GridItem>				
		</mx:GridRow>	
		<mx:GridRow>
			<mx:GridItem horizontalAlign="right">
				<mx:Label text="Start time:"/>
			</mx:GridItem>
			<mx:GridItem horizontalAlign="left">
				<control:gpDatePicker id="startTime"/>
			</mx:GridItem>
		</mx:GridRow>	
		<mx:GridRow>
			<mx:GridItem horizontalAlign="right">
				<mx:Label text="End time:"/>
			</mx:GridItem>
			<mx:GridItem horizontalAlign="left">
				<control:gpDatePicker id="endTime"/>		
			</mx:GridItem>					
		</mx:GridRow>	
		<mx:GridRow>
			<mx:GridItem horizontalAlign="right">
				<mx:Label text="Min. runtime (sec):"/>
			</mx:GridItem>
			<mx:GridItem horizontalAlign="left">
				<mx:TextInput id="minRuntime" width="200"/>
			</mx:GridItem>	
		</mx:GridRow>	
		<mx:GridRow>
			<mx:GridItem horizontalAlign="right">
				<mx:Label text="Query ID:"/>
			</mx:GridItem>
			<mx:GridItem horizontalAlign="left">
				<mx:TextInput id="queryID" width="200"/>		
			</mx:GridItem>									
		</mx:GridRow>
		<mx:GridRow>		
			<mx:GridItem colSpan="2" horizontalAlign="center" paddingTop="10">
				<mx:Button label="Cancel" click="removeMe();"/>	
				<mx:Button label="Search" click="submitData();"/>		
			</mx:GridItem>
		</mx:GridRow>	
	</mx:Grid>
	
</mx:TitleWindow>
