<?xml version="1.0" encoding="utf-8"?>
<mx:VBox xmlns:mx="http://www.adobe.com/2006/mxml"
	width="100%" height="100%" xmlns:panel="panel.*" xmlns:chart="chart.*"
	creationPolicy="queued">

<mx:Script>
    <![CDATA[
      import mx.collections.Sort;
      import mx.collections.SortField;
      import model.GPPerfMonModelLocator;
      import mx.collections.XMLListCollection;
   	  import mx.charts.HitData;
      import mx.charts.chartClasses.DataTransform; 
      import mx.charts.chartClasses.CartesianTransform;
      import mx.charts.series.items.BarSeriesItem;	
      	   		 			
  	  [Bindable]
	  public var mdl : GPPerfMonModelLocator = GPPerfMonModelLocator.getInstance();
	  
	  private function sortComboChange(event:Event):void
	  {
	  	if (combo.selectedItem)
	  	{
	  		var val:String = combo.selectedItem.val;
	  		var s:Sort = mdl.system.systemNowXML.sort;
	  		
	  		if (val == '@name')
	  		   s.fields = [new SortField(val, true, true)];	
	  		else
	  		   s.fields = [new SortField(val, false, false, true)];	
	  	
			mdl.system.systemNowXML.refresh();
	  	}	  	 
	  }	
	  
	  	private function formatDataTip(hd:HitData):String
		{
			 var dt:String = "";
	         var this_series:BarSeries = BarSeries(hd.element);
	         var dataTransform:DataTransform = this_series.dataTransform;
	         var vertical_axis:CategoryAxis = CategoryAxis(dataTransform.getAxis(CartesianTransform.VERTICAL_AXIS));
	         var horizontal_axis:LinearAxis = LinearAxis(dataTransform.getAxis(CartesianTransform.HORIZONTAL_AXIS));        
	         
	         var n:String = this_series.displayName;
	         if (n && n != "")
	         dt += "<b>" + n + "</b><BR/>";
	        
	         dt += vertical_axis.formatForScreen(BarSeriesItem(hd.chartItem).yValue) + "\n";
	                  
	         var xValue:Object = horizontal_axis.formatForScreen(
	         			((BarSeriesItem(hd.chartItem).xValue as Number) -
	         			(BarSeriesItem(hd.chartItem).minValue as Number)).toFixed(2));
	         			
	         dt += xValue + "\n";
	         
	         return dt;
		}
    ]]>
</mx:Script>	
   
  <mx:SolidColor id="user_clr" color="0x4ABF84" alpha="1.0"/>
  <mx:SolidColor id="sys_clr" color="0x374CE3" alpha="1.0"/>
  <mx:SolidColor id="idle_clr" color="0xD8D8D8" alpha="1.0"/>
 
 <mx:HBox width="100%">
 	<mx:VBox width="180" horizontalAlign="left">
 		<mx:Label text="Sort by:"/>
 		<mx:ComboBox id="combo" labelField="label" change="sortComboChange(event)" rowCount="10" >
 			<mx:dataProvider>
				<mx:Object label="Name" val="@name"/>
				<mx:Object label="CPU User" val="cpu_user"/>
				<mx:Object label="CPU System" val="cpu_sys"/>
				<mx:Object label="CPU Idle" val="cpu_idle"/> 			
				<mx:Object label="Used memory" val="mem_actual_used"/>
				<mx:Object label="Free memory" val="mem_actual_free"/>
				<mx:Object label="Disk read rate" val="disk_rb_rate"/> 
				<mx:Object label="Disk write rate" val="disk_wb_rate"/> 
				<mx:Object label="Net read rate" val="net_rb_rate"/> 
				<mx:Object label="Net write rate" val="net_rb_rate"/> 
 			</mx:dataProvider>
 		</mx:ComboBox>
 	</mx:VBox>	
 	<mx:Legend width="100%" verticalAlign="top" horizontalAlign="right" dataProvider="{myChart}"/>
 	<mx:Legend width="100%" verticalAlign="top" horizontalAlign="right" dataProvider="{myChart2}"/>
 	<mx:Legend width="100%" verticalAlign="top" horizontalAlign="right" dataProvider="{myChart3}"/>
 	<mx:Legend width="100%" verticalAlign="top" horizontalAlign="right" dataProvider="{myChart4}"/>
 </mx:HBox>    	
 
 <mx:Canvas id="canvas" width="100%" height="100%">
   <mx:HBox width="{canvas.width}" height="{canvas.height}">
  	 <mx:BarChart showDataTips="true" id="myChart0"
  				dataProvider="{mdl.system.systemNowXML}" 
  				width="180" height="{((mdl.system.systemNowXML.length)*25)+100}" gutterLeft="180"
  				gutterBottom="100">		
  		<mx:seriesFilters>
           <mx:Array/>
        </mx:seriesFilters>
        <mx:verticalAxis>
            <mx:CategoryAxis id='cataxis0' dataProvider="{mdl.system.systemNowXML}" 
            	categoryField="@name"/>
        </mx:verticalAxis>
        <mx:horizontalAxis>
            <mx:LinearAxis  id='haxis0'/>
        </mx:horizontalAxis>
		<mx:verticalAxisRenderers>
        	<mx:AxisRenderer axis="{cataxis0}" showLabels="true" showLine="false"/>
        </mx:verticalAxisRenderers>
 		<mx:horizontalAxisRenderers>
        	<mx:AxisRenderer axis="{haxis0}" visible="false" includeInLayout="false"/>
        </mx:horizontalAxisRenderers>       
		<mx:backgroundElements>
			<mx:Array/>
		</mx:backgroundElements>
  	</mx:BarChart>	

  	 <mx:BarChart showDataTips="true" id="myChart" width="100%" height="{((mdl.system.systemNowXML.length)*25)+100}"
  				dataProvider="{mdl.system.systemNowXML}" gutterBottom="100" dataTipFunction="formatDataTip">
  		<mx:series>	 
  			<mx:BarSet type="100%">
	  			<mx:BarSeries xField="cpu_user"  
	 						  displayName="CPU User" fill="{user_clr}">
	 			</mx:BarSeries>  
	  			<mx:BarSeries xField="cpu_sys" 
	  						  displayName="CPU System" fill="{sys_clr}">
	  			</mx:BarSeries>	   
	  			<mx:BarSeries xField="cpu_idle" 
	  						   displayName="CPU Idle" fill="{idle_clr}">
	  		  	</mx:BarSeries>	      				
  			</mx:BarSet>     
  		</mx:series>
  		
  		<mx:seriesFilters>
           <mx:Array/>
        </mx:seriesFilters>
  		
        <mx:verticalAxis>
            <mx:CategoryAxis id='cataxis1' dataProvider="{mdl.system.systemNowXML}" 
            	categoryField="@name"/>
        </mx:verticalAxis>
        <mx:horizontalAxis>
            <mx:LinearAxis id="vaxis1" baseAtZero="true" maximum="100" title="CPU %"/>
        </mx:horizontalAxis>
		<mx:verticalAxisRenderers>
        	<mx:AxisRenderer axis="{cataxis1}" showLabels="false"/>
        </mx:verticalAxisRenderers>
        
  	</mx:BarChart>	
	
  	 <mx:BarChart showDataTips="true" id="myChart2" width="100%" height="{((mdl.system.systemNowXML.length)*25)+100}"
  				dataProvider="{mdl.system.systemNowXML}" gutterBottom="100" dataTipFunction="formatDataTip"> 
  		<mx:series>	 
  			<mx:BarSet type="stacked">
	  			<mx:BarSeries xField="mem_actual_used"  
	 						  displayName="Used memory" fill="{user_clr}">
	 			</mx:BarSeries>  
	  			<mx:BarSeries xField="mem_actual_free" 
	  						  displayName="Free memory" fill="{idle_clr}">
	  			</mx:BarSeries>	        				
  			</mx:BarSet>     
  		</mx:series>
  		
  		<mx:seriesFilters>
           <mx:Array/>
        </mx:seriesFilters>
  		
        <mx:verticalAxis>
            <mx:CategoryAxis id='cataxis2' dataProvider="{mdl.system.systemNowXML}" 
            	categoryField="@name"/>
        </mx:verticalAxis>
        <mx:horizontalAxis>
            <mx:LinearAxis id="vaxis2" baseAtZero="true" title="MBytes"/>
        </mx:horizontalAxis>
		<mx:verticalAxisRenderers>
        	<mx:AxisRenderer axis="{cataxis2}" showLabels="false"/>
        </mx:verticalAxisRenderers>
        
  	</mx:BarChart>

  	<mx:BarChart showDataTips="true" id="myChart3" width="100%" height="{((mdl.system.systemNowXML.length)*25)+100}"
  				dataProvider="{mdl.system.systemNowXML}" gutterBottom="100">
  		<mx:series>	 
  			<mx:BarSet type="clustered">
	  			<mx:BarSeries xField="disk_rb_rate"  
	 						  displayName="Disk read rate">
	 			</mx:BarSeries>  
	  			<mx:BarSeries xField="disk_wb_rate" 
	  						  displayName="Disk write rate">
	  			</mx:BarSeries>	         				
  			</mx:BarSet>     
  		</mx:series>
  		
  		<mx:seriesFilters>
           <mx:Array/>
        </mx:seriesFilters>
  		
        <mx:verticalAxis>
            <mx:CategoryAxis id='cataxis3' dataProvider="{mdl.system.systemNowXML}" 
            	categoryField="@name"/>
        </mx:verticalAxis>
        <mx:horizontalAxis>
            <mx:LinearAxis id="vaxis3" baseAtZero="true" title="MBytes/s"/>
        </mx:horizontalAxis>
        <mx:verticalAxisRenderers>
        	<mx:AxisRenderer axis="{cataxis3}" showLabels="false"/>
        </mx:verticalAxisRenderers>
        
  	</mx:BarChart>

  	<mx:BarChart showDataTips="true" id="myChart4" width="100%" height="{((mdl.system.systemNowXML.length)*25)+100}"
  				dataProvider="{mdl.system.systemNowXML}" gutterBottom="100">
  		<mx:series>	 
  			<mx:BarSet type="clustered">
	  			<mx:BarSeries xField="net_rb_rate"  
	 						  displayName="Net read rate">
	 			</mx:BarSeries>  
	  			<mx:BarSeries xField="net_wb_rate" 
	  						  displayName="Net write rate">
	  			</mx:BarSeries>	         				
  			</mx:BarSet>     
  		</mx:series>
  		
  		<mx:seriesFilters>
           <mx:Array/>
        </mx:seriesFilters>
  		
        <mx:verticalAxis>
            <mx:CategoryAxis id='cataxis4' dataProvider="{mdl.system.systemNowXML}" 
            	categoryField="@name"/>
        </mx:verticalAxis>
        <mx:horizontalAxis>
            <mx:LinearAxis id="vaxis4" baseAtZero="true" title="MBytes/s"/>
        </mx:horizontalAxis>
        <mx:verticalAxisRenderers>
        	<mx:AxisRenderer axis="{cataxis4}" showLabels="false"/>
        </mx:verticalAxisRenderers>
        
  	</mx:BarChart>

  </mx:HBox>  
 </mx:Canvas>	
</mx:VBox>
