<?xml version="1.0" encoding="utf-8"?>
<mx:HBox xmlns:mx="http://www.adobe.com/2006/mxml" width="100%" height="100%" paddingLeft="10" 
	paddingRight="10" horizontalScrollPolicy="off" verticalScrollPolicy="off"
	doubleClickEnabled="true" doubleClick="handleDoubleClick()" xmlns:healthTab="view.healthTab.*">
	<mx:Script>
		<![CDATA[
			import view.healthTab.events.HostSubItemSelectEvent;
			import mx.formatters.SwitchSymbolFormatter;
			import mx.controls.Alert;
			import model.Health;
			
	 		private var rowData:Object
	 		
			override public function set data(value:Object):void {
				super.data = value;
				rowData = value;
				var str:String = value.Status
					if (value != null){
						lblStatus.text = Health.statusLabel(value.Status);
						statusImg.status = value.Status;
					}
			 }
			 
	         private function handleDoubleClick():void{
				var rowXML:XML = XML(rowData);
				dispatchHostSubItemSelect(rowXML)
		     }//end of handleDoubleClick
		     
		     private function dispatchHostSubItemSelect(rowXML:XML):void{
		  		//switch to the details view, retreive the related data from the server and show it in the details view
				//to do this, dispatch an event to the parent with the details of the selected row
				// HealthDetails.
				var eObj:HostSubItemSelectEvent = new HostSubItemSelectEvent(HostSubItemSelectEvent.HOSTSUBITEM_CLICK);
				eObj.itemXML = rowXML;
				this.dispatchEvent(eObj);
	  	    }//end of dispatchHostSubItemSelect
	  	  
		]]>
	</mx:Script>
	<mx:Label id="lblStatus" textAlign="left"/>
	<mx:Spacer width="100%"/>
	<healthTab:StatusLED id="statusImg" textAlign="right"/>
</mx:HBox>
