<?xml version="1.0" encoding="utf-8"?>
<mx:VBox xmlns:mx="http://www.adobe.com/2006/mxml">
	<mx:Script>
		<![CDATA[
		  	import model.Health;

			[Embed (source="../../assets/img/LED_Error.png")]
	 		private var errorCls:Class;
	 		
			[Embed (source="../../assets/img/questionmark.png")]
	 		private var unreachableCls:Class;
	 		
	 		[Embed (source="../../assets/img/LED_Normal.png")]
	 		private var normalCls:Class;
	 		
			[Embed (source="../../assets/img/LED_Unknown.png")]
	 		private var unknownCls:Class;
	 		
	 		[Embed (source="../../assets/img/LED_Warning.png")]
	 		private var warningCls:Class;
	 		
			[Embed (source="../../assets/img/white_bg_led.png")]
	 		private var bgCls:Class;
	 		
	 		[Bindable]
	 		private var iconSrc:Class;
	 		
			public function set status(val:String):void {
				switch (val) {
	 				case Health.STATUS_ERROR:
	 					iconSrc = errorCls;
	 					break;
	 				case Health.STATUS_NORMAL:
	 					iconSrc = normalCls;
	 					break;
	 				case Health.STATUS_NORESPONSE:
	 					iconSrc = unreachableCls;
	 					break;
	 				case Health.STATUS_UNKNOWN:
	 					iconSrc = unknownCls;
	 					break;
	 				case Health.STATUS_WARNING:
	 					iconSrc = warningCls;
	 					break;	
	 				default:
	 					iconSrc = null;
	 					break; 	
	 			}
			}
		]]>
	</mx:Script>
	
	<mx:Image id="statusLED" width="18" height="18" source="{iconSrc}"/>
</mx:VBox>
