<?xml version="1.0" encoding="utf-8"?>
<mx:HDividedBox xmlns:mx="http://www.adobe.com/2006/mxml" width="100%" height="536" verticalGap="0" creationComplete="initComp()" xmlns:healthTab="view.healthTab.*">
<mx:Script>
	<![CDATA[
		import view.healthTab.events.HostSubItemClickEvent;
		import view.healthTab.events.HostSubItemSelectEvent;
		import mx.events.ListEvent;
		import mx.controls.Alert;
		import view.healthTab.events.HostItemClickEvent;
		import model.GPPerfMonModelLocator;
		import model.Health;
		import command.HealthCommand;
		
		//private var __currentHostItem:HostItem;
		private var selectedCategoryName:String = "";
		private var selectedStatusFilter:String = "";
		
		[Bindable]
		public var mdl : GPPerfMonModelLocator = GPPerfMonModelLocator.getInstance();	

		//Placing an image in header of the details coloumn.
		[Bindable]
		[Embed (source="../../assets/img/Magnifying-Glass-16x16.png")]
		public var logo_cls:Class;
		
		private function initComp():void{
			//fetchServiceData();
			
			detailsDG.doubleClickEnabled = true;
			detailsDG.addEventListener(ListEvent.ITEM_DOUBLE_CLICK, handleDataGridDblClick);
			
			mdl.health.addEventListener(Health.HOSTXMLRECEIVED, showHostItems);
		}//end of initComp
		
		/**
		 * Based on the XML retrieved from the server, the function displays the host item list
		 */
		private function showHostItems(eventObj:Event):void{
			hostsContainer.removeAllChildren();
			for (var i:int = 0; i < mdl.health.summary.CategoryView.Category.length(); i++) {
				var hostItem:HostItem = new HostItem();
				hostItem.category = mdl.health.summary.CategoryView.Category[i];
				hostsContainer.addChild(hostItem);
				
				hostItem.addEventListener(HostItemClickEvent.HOSTITEM_CLICK, handleHostItemClick);
				hostItem.addEventListener(HostSubItemClickEvent.HOSTSUBITEM_CLICK, handleHostSubItemClick);
				
				if (selectedCategoryName == hostItem.categoryName) {
					selectHost(hostItem);
					if (selectedStatusFilter != "") {
						hostItem.selectStatus(selectedStatusFilter);
						viewHostDetails(hostItem.category.Line.(Status == selectedStatusFilter));
					} else {
						viewHostDetails(hostItem.category.Line);
					}
				}
			}
			
			
		}//end of showHostItems
		
		/**
		 * When user selects a host item or status of a host item we need to show the details on the right
		 * pane. Also, on the other hand, we need to manage the highlughts of each host item
		 */
		private function handleHostItemClick(eventObj:HostItemClickEvent):void {
			var curStatusSelection:String = selectedStatusFilter;
			selectedStatusFilter = "";
			
			if (selectedCategoryName != eventObj.hostItemRef.categoryName || curStatusSelection != "") {
				selectHost(eventObj.hostItemRef);
				viewHostDetails(eventObj.hostItemRef.category.Line);
			}
		}//end of handleHostItemClick
		
		private function handleHostSubItemClick(eventObj:HostSubItemClickEvent):void{
			var hostSubItem:HostStatusItem = eventObj.hostItemRef;
			var hostItem:HostItem = hostSubItem.parentRef;
			var curStatus:String = hostSubItem.status;
			
			if (selectedCategoryName != hostItem.categoryName) {
				selectHost(hostItem);
			}
			
			selectedStatusFilter = curStatus;

			//show the details in the datagrid
			viewHostDetails(hostItem.category.Line.(Status == curStatus));
		}//end of hostsubitem clicked.
		
		
		private function selectHost(hostItem:HostItem):void {
			selectedCategoryName = hostItem.categoryName;
			deselectAllHostItems();
			hostItem.toggleHostItemSelection(true);
			detailsSectionHeaderLbl.text = selectedCategoryName;
		}
		
		/**
		 * Deselects all the Host items
		 */
		private function deselectAllHostItems():void{
			for(var i:int = 0; i < hostsContainer.numChildren; i++) {
				var hostItem:HostItem = HostItem(hostsContainer.getChildAt(i));
				
				hostItem.toggleHostItemSelection(false);
			}
		}
			
		
		/**
		 * Function takes the host details XML as a parameter and displays them in the datagrid
		 */
		private function viewHostDetails(details:XMLList):void{
			detailsDG.dataProvider = details;
		}//end of viewHostDetails
		 
		/**
		 * Gets triggered when the user double-clicks on a row
		 */
		private function handleDataGridDblClick(eventObj:ListEvent):void{
			var rowXML:XML = XML(eventObj.itemRenderer.data);
			dispatchHostSubItemSelect(rowXML)
		}//end of handleDataGridDblClick
		 
	  	private function dispatchHostSubItemSelect(rowXML:XML):void{
	  		//switch to the details view, retreive the related data from the server and show it in the details view
			//to do this, dispatch an event to the parent with the details of the selected row
			// HealthDetails.
			var eObj:HostSubItemSelectEvent = new HostSubItemSelectEvent(HostSubItemSelectEvent.HOSTSUBITEM_CLICK);
			eObj.itemXML = rowXML;
			this.dispatchEvent(eObj);
	  	}//end of dispatchHostSubItemSelect
	  	  
		public function handleSwitchToDetailsImageClick(data:Object):void{
	  	    var rowXML:XML = XML(data);
			dispatchHostSubItemSelect(rowXML)
		}//end of handleSwitchToDetailsImageClick.
		
	]]>
</mx:Script>
   
	<mx:VBox width="35%" height="100%" id="hostsSection" styleName="hostsSectionStyle">
		<mx:Label text="Hosts" styleName="consolidatedViewSectionHeaderStyle" height="26"/>
		<mx:HBox width="100%" horizontalGap="0" styleName="hostsSectionHeaderStyle" height="23" paddingTop="2">
			<mx:Label text="Host Name" width="100%" styleName="consolidatedViewDGHeaderStyle"/>
			<mx:Label text="Count" width="60" styleName="consolidatedViewDGHeaderStyle"/>
		</mx:HBox>
		<mx:VBox id="hostsContainer" width="100%" height="100%" styleName="hostsContainerStyle" verticalGap="0">
			
		</mx:VBox>
	</mx:VBox>
	
	<mx:VBox width="65%" height="100%" id="detailsSection" styleName="detailsSectionStyle">
		<mx:Label id="detailsSectionHeaderLbl" text="" styleName="consolidatedViewSectionHeaderStyle" height="26"/>
		<mx:DataGrid id="detailsDG" width="100%" height="100%" styleName="hostItemStatusLbl">
			<mx:columns>
				<mx:DataGridColumn headerText="Status" dataField="Status"
					width="100" headerStyleName="consolidatedViewDGHeaderStyle" sortable="true" 
					itemRenderer="view.healthTab.StatusItemRender"/>
				<mx:DataGridColumn headerText="Host Name" dataField="HostName" headerStyleName="consolidatedViewDGHeaderStyle" sortable="true"/>
				<mx:DataGridColumn headerText="Details" id="detailsColoumn" width="80" headerStyleName="consolidatedViewDGHeaderStyle">
					<mx:itemRenderer>
	         		<mx:Component>
	         			<mx:HBox horizontalAlign="center" verticalAlign="middle">
	         			    
	         				<mx:Image id="img" source="{outerDocument.logo_cls}"  click="outerDocument.handleSwitchToDetailsImageClick(data)"/>
	         			</mx:HBox>
	         		</mx:Component>
	         	</mx:itemRenderer>
         	  </mx:DataGridColumn>
			</mx:columns>
		</mx:DataGrid>
	</mx:VBox>
</mx:HDividedBox>
