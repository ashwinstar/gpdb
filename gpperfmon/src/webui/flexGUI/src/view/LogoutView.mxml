<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml"
	width="100%" height="100%"
	xmlns:view="view.*">
	
<mx:Script>
<![CDATA[
  	import model.Resources;	
   ]]>
</mx:Script>

	<mx:Panel styleName="titlelessPanel" 
		width="874" height="600" horizontalCenter="0" 
		verticalCenter="0" layout="vertical">

		<mx:Image source="{Resources.top_graphic}" scaleContent="false"/>

		<mx:Spacer height="100%"/>
		
		<mx:HBox width="100%" height="100%">

			<mx:VBox width="50%" height="100%" horizontalAlign="center" >
				<mx:Image source="{Resources.gp_logo_med}" scaleContent="false"/>
				<mx:Spacer height="20"/>
				<mx:Label styleName="mainTitle" text="Greenplum Performance Monitor"/>
				<mx:Label text="{Resources.instance.versionString}"/>
				<mx:Label styleName="footerText" text="{Resources.copyright}"/>
				<mx:Spacer height="100"/>
			</mx:VBox>
			
			<mx:VBox width="50%" height="100%" horizontalAlign="center" verticalAlign="middle">
		
				<mx:Panel title="Logout" paddingTop="40" paddingBottom="40" paddingLeft="50" paddingRight="50">
				    <mx:Label fontWeight="bold" text="You have logged out of the application."/>
					<mx:Label fontWeight="bold" text="Reload your browser to login again."/>
				</mx:Panel>
		
			</mx:VBox>
			
			<mx:Spacer width="10"/>
			
		</mx:HBox>
		
		<mx:Spacer height="100%"/>
				
		<mx:Image source="{Resources.bot_graphic}" scaleContent="false"/>

	</mx:Panel>

</mx:Canvas>
