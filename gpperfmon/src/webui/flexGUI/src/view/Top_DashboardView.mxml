<mx:Script>
<![CDATA[
	import mx.events.FlexEvent;
	import mx.controls.dataGridClasses.DataGridItemRenderer;
	import value.Query;
    import model.GPPerfMonModelLocator;
  	import mx.events.CloseEvent;
  	import mx.controls.Alert;	
  	import model.Resources;
  	import model.Health;
  	import util.MiscUtils;
  	import mx.events.ListEvent;
  	import util.Debug;
  	  			
  	[Bindable]
	public var mdl : GPPerfMonModelLocator = GPPerfMonModelLocator.getInstance();

	[Bindable] [Embed (source="/assets/img/white_bg_led.png")]
	 private var bgCls:Class;

    public var magGlass:Class = Resources.magGlass;
    
    private function initComp():void {
    	systemHealthPanel.visible = Resources.instance.appliance;
    	systemHealthPanel.includeInLayout = Resources.instance.appliance;
    }
	
	// Handle a dblclick by jumping to the query
	public function dblClickQuery(evt:Event):void {
		// Clear any active query plan requests
		mdl.queries.doQueryPlan(null);

		var renderer:DataGridItemRenderer = evt.target as DataGridItemRenderer;
		if (renderer)
			mdl.nav.jumpToQueryDetails(renderer.data as Query, true);
	}

	// Handle a click by jumping to the query
	public function clickQuery(obj:Object):void {
		// Clear any active query plan requests
		mdl.queries.doQueryPlan(null);

		mdl.nav.jumpToQueryDetails(obj as Query, true);
	}


]]>   	
</mx:Script>	
	
