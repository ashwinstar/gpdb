<?xml version="1.0" encoding="utf-8"?>
<mx:Application 
	xmlns:mx="http://www.adobe.com/2006/mxml" 
	xmlns:view="view.*"
	pageTitle="Greenplum Performance Monitor"
    historyManagementEnabled="false"
    applicationComplete="initApp()">
	
	<mx:Style source="assets/css/styles.css"/>
	
<mx:Script>
    <![CDATA[
      import model.GPPerfMonModelLocator;
  			
  	  [Bindable]
	  public var mdl : GPPerfMonModelLocator = GPPerfMonModelLocator.getInstance();
	  
	  function initApp():void{
	  	var test:Boolean = false;
	  	if (test)
	  	{
	    	mdl.session.setDatabaseConnection("http","192.168.0.184","8080",
	    		"testServer");	  		  		
	  	}
	  	else
	  	{
			mdl.session.setDatabaseConnection( 
			    Application.application.parameters.serverProtocol,
				Application.application.parameters.serverHost,
				Application.application.parameters.serverPort,
			    Application.application.parameters.serverName);
	  	}
	  }	
    ]]>
</mx:Script>	
		
	<mx:ViewStack id="loginStack" width="100%" height="100%"
        selectedIndex="{mdl.session.loggedIn}">
    	<view:LoginView id="loginView"/>
		<view:MainAppView id="mainAppView"/>
		<view:LogoutView id="logoutView"/>
	</mx:ViewStack>
	
</mx:Application>
