<?xml version="1.0" encoding="utf-8"?>
<mx:HBox xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:control="control.*">
    <mx:Script>
        <![CDATA[
        import mx.collections.ArrayCollection;
		import model.GPPerfMonModelLocator;
		import util.MiscUtils;
		import model.Session;
  		import model.Resources;
  		import mx.charts.HitData;
    	import mx.charts.chartClasses.DataTransform; 
    	import mx.charts.chartClasses.CartesianTransform;
      	import mx.charts.series.items.ColumnSeriesItem;	
	
		[Bindable]
		public var mdl : GPPerfMonModelLocator = GPPerfMonModelLocator.getInstance();

		private function formatDataTip(hd:HitData):String
		{
			 var dt:String = "";
	         var this_series:ColumnSeries = ColumnSeries(hd.element);
	         var dataTransform:DataTransform = this_series.dataTransform;
	         var vertical_axis:LinearAxis = LinearAxis(dataTransform.getAxis(CartesianTransform.VERTICAL_AXIS));
	         var horizontal_axis:DateTimeAxis = DateTimeAxis(dataTransform.getAxis(CartesianTransform.HORIZONTAL_AXIS));        
	         
	         var n:String = this_series.displayName;
	         if (n && n != "")
	         dt += "<b>" + n + "</b><BR/>";
	         
	         dt += horizontal_axis.formatForScreen(ColumnSeriesItem(hd.chartItem).xValue) + "\n";
	         
	         var yValue:Object = vertical_axis.formatForScreen(
	         			((ColumnSeriesItem(hd.chartItem).yValue as Number) -
	         			(ColumnSeriesItem(hd.chartItem).minValue as Number)).toFixed(2));
	         			
	         dt += yValue + "\n";
	         
	         return dt;
		}
		
        ]]>
    </mx:Script>

  <mx:SolidColor id="used_clr" color="0x4ABF84" alpha="1.0"/>
  <mx:SolidColor id="free_clr" color="0xD8D8D8" alpha="1.0"/>
 
  <!-- naveen(divami): Changing the way dataProvider is bound to the recommended
       ArrayCollection style; this eliminates compiler warnings as well as binds correctly -->
  <mx:ColumnChart showDataTips="true" id="myChart" width="100%" height="100%"
  				dataProvider="{mdl.system.activeAggLookup.getItemAt(mdl.nav.durationSelected)}"
  				type="stacked" updateComplete="{dataSelector.invalidateDisplayList()}"
  				dataTipFunction="formatDataTip">
  		<mx:series>	 
 			<mx:ColumnSeries yField="mem_actual_used" sortOnXField="false"
  			               xField="sample_time" displayName="Used (MBytes)"
  			               fill="{used_clr}">
  			</mx:ColumnSeries>	   
  			<mx:ColumnSeries yField="mem_actual_free" sortOnXField="false"
  						   xField="sample_time" displayName="Free (MBytes)"
  						   fill="{free_clr}">
  		  	</mx:ColumnSeries>	       
  		</mx:series>

 	    <mx:annotationElements>
	        <control:HorizontalAxisDataSelector id="dataSelector"
				selectorColor="0x000000" enabled="{mdl.nav.systemTabPage==1}"
								         visible="{mdl.nav.systemTabPage==1}"/>
		</mx:annotationElements>	
  		
  		<mx:seriesFilters>
           <mx:Array/>
        </mx:seriesFilters>
  		
  		 <mx:backgroundElements>
  			<mx:VBox verticalAlign="middle" horizontalAlign="center"
  				visible="{!(mdl.system.dataLoaded.getItemAt(mdl.nav.durationSelected) as Boolean)}">
  				<mx:Label text="Loading..."/>  				
  			</mx:VBox>
  		</mx:backgroundElements>
  		
        <mx:horizontalAxis>
            <mx:DateTimeAxis id="haxis" displayLocalTime="true" 
            	minimum="{mdl.session.timeArray.getItemAt(mdl.nav.durationSelected) as Date}"
            	maximum="{mdl.session.timeArray.getItemAt(Session.LATEST_TICK) as Date}"
  				dataInterval="{mdl.system.dataIntervalNumber.getItemAt(mdl.nav.durationSelected) as Number}"
  				dataUnits="{mdl.system.dataIntervalUnit.getItemAt(mdl.nav.durationSelected) as String}"
  				/>
        </mx:horizontalAxis>
        <mx:verticalAxis>
            <mx:LinearAxis id="vaxis" baseAtZero="true"/>
        </mx:verticalAxis>
        
		<mx:horizontalAxisRenderers>
		    <mx:AxisRenderer axis="{haxis}">
		        <mx:axisStroke>
		            <mx:Stroke color="#999999" weight="1"/>
		        </mx:axisStroke>
		    </mx:AxisRenderer>
		</mx:horizontalAxisRenderers>
		 
		<mx:verticalAxisRenderers>
		    <mx:AxisRenderer axis="{vaxis}">
		        <mx:axisStroke>
		            <mx:Stroke color="#999999" weight="1" />
		        </mx:axisStroke>
		    </mx:AxisRenderer>
		</mx:verticalAxisRenderers>
  </mx:ColumnChart>
  
  <mx:Legend dataProvider="{myChart}"/>
  
</mx:HBox>

