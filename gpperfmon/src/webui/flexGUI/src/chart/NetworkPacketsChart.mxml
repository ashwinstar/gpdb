<?xml version="1.0" encoding="utf-8"?>
<mx:HBox xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:control="control.*">
    <mx:Script>
        <![CDATA[
		import model.GPPerfMonModelLocator;
		import mx.charts.HitData;
		import mx.charts.series.items.LineSeriesItem;
		import model.Session;
			
		[Bindable]
		public var mdl : GPPerfMonModelLocator = GPPerfMonModelLocator.getInstance();

        ]]>
    </mx:Script>

<!--
Comment#1
Vasu (Divami) [28 July, 2010] - Databinding doesn't happen when square brackets are used inside MXML value declarations involving '{}'
So, in order to avoid compiler warning, the declaration is done after component initialization. Databinding still doesn't happen,
but compiler warning is avoided.

I am presuming that the actual intent here was not to databind but just an assignment of value.
--> 
  <mx:LineChart showDataTips="true" id="myChart" width="100%" height="100%"
  				initialize="myChart.dataProvider=mdl.system.activeAggLookup[mdl.nav.durationSelected]"
  			    updateComplete="{dataSelector.invalidateDisplayList()}">
  		<mx:series>
  			<mx:LineSeries yField="net_rp_rate" sortOnXField="false"
  						   xField="sample_time" displayName="Pkts read">
  				<mx:lineStroke>
                	<mx:Stroke weight="2" color="0xff0000" alpha="0.8"/>
            	</mx:lineStroke> 
  			</mx:LineSeries>			 
  			<mx:LineSeries yField="net_wp_rate" sortOnXField="false"
  				           xField="sample_time" displayName="Pkts written">
  				<mx:lineStroke>
                	<mx:Stroke weight="2" color="0x00ff00" alpha="0.8"/>
            	</mx:lineStroke> 
  			</mx:LineSeries>	  				          
  		</mx:series>
 
 	    <mx:annotationElements>
	        <control:HorizontalAxisDataSelector id="dataSelector"
				selectorColor="0x000000" enabled="{mdl.nav.systemTabPage==1}"
								         visible="{mdl.nav.systemTabPage==1}"/>
		</mx:annotationElements>	

		<mx:seriesFilters>
           <mx:Array/>
        </mx:seriesFilters>

  		 <mx:backgroundElements>
  			<mx:VBox verticalAlign="middle" horizontalAlign="center"
  				visible="{!(mdl.system.dataLoaded.getItemAt(mdl.nav.durationSelected) as Boolean)}">
  				<mx:Label text="Loading..."/>  				
  			</mx:VBox>
  		</mx:backgroundElements>
  		
        <mx:horizontalAxis>
            <mx:DateTimeAxis id="haxis" displayLocalTime="true" 
            	minimum="{mdl.session.timeArray.getItemAt(mdl.nav.durationSelected) as Date}"
            	maximum="{mdl.session.timeArray.getItemAt(Session.LATEST_TICK) as Date}"/>
        </mx:horizontalAxis>
        <mx:verticalAxis>
            <mx:LinearAxis id="vaxis" baseAtZero="true"/>
        </mx:verticalAxis>
        
		<mx:horizontalAxisRenderers>
		    <mx:AxisRenderer axis="{haxis}">
		        <mx:axisStroke>
		            <mx:Stroke color="#999999" weight="1"/>
		        </mx:axisStroke>
		    </mx:AxisRenderer>
		</mx:horizontalAxisRenderers>
		 
		<mx:verticalAxisRenderers>
		    <mx:AxisRenderer axis="{vaxis}">
		        <mx:axisStroke>
		            <mx:Stroke color="#999999" weight="1" />
		        </mx:axisStroke>
		    </mx:AxisRenderer>
		</mx:verticalAxisRenderers>

  </mx:LineChart>
  
  <mx:Legend dataProvider="{myChart}"/>
  
</mx:HBox>
