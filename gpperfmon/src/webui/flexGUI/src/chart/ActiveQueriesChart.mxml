<?xml version="1.0" encoding="utf-8"?>
<mx:HBox xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:control="control.*">
    <mx:Script>
        <![CDATA[
		import model.GPPerfMonModelLocator;
		import mx.charts.HitData;
		import mx.charts.series.items.LineSeriesItem;
		import model.Session;
			
		[Bindable]
		public var mdl : GPPerfMonModelLocator = GPPerfMonModelLocator.getInstance();

        ]]>
    </mx:Script>

  <mx:LineChart showDataTips="true" id="myChart" width="100%" height="100%"
  				dataProvider="{mdl.db.activeAggLookup.getItemAt(mdl.nav.durationSelected)}"
  				updateComplete="{dataSelector.invalidateDisplayList()}">
  		<mx:series>
  			<mx:LineSeries yField="queries_running" sortOnXField="false" 
  						   xField="sample_time" displayName="Running (avg)">
  				<mx:lineStroke>
                	<mx:Stroke weight="2" color="0x00ff00" alpha="0.8"/>
            	</mx:lineStroke> 
  			</mx:LineSeries>			 
  			<mx:LineSeries yField="queries_running_max" sortOnXField="false" 
  				           xField="sample_time" displayName="Running (max)">
  				<mx:lineStroke>
                	<mx:Stroke weight="1" color="0x008000" alpha="0.8"/>
            	</mx:lineStroke> 
  			</mx:LineSeries>	  				          		 
  			<mx:LineSeries yField="queries_queued" sortOnXField="false"
  				           xField="sample_time" displayName="Queued (avg)">
  				<mx:lineStroke>
                	<mx:Stroke weight="2" color="0x0000ff" alpha="0.8"/>
            	</mx:lineStroke> 
  			</mx:LineSeries>
  			<mx:LineSeries yField="queries_queued_max" sortOnXField="false"
  						   xField="sample_time" displayName="Queued (max)">
  				<mx:lineStroke>
                	<mx:Stroke weight="1" color="0x000080" alpha="0.8"/>
            	</mx:lineStroke> 
  			</mx:LineSeries>			 
  		</mx:series>

 	    <mx:annotationElements>
	        <control:HorizontalAxisDataSelector id="dataSelector"
				selectorColor="0x000000" enabled="{mdl.nav.systemTabPage==1}"
								         visible="{mdl.nav.systemTabPage==1}"/>
		</mx:annotationElements>	
		
		<mx:seriesFilters>
           <mx:Array/>
        </mx:seriesFilters>

  		 <mx:backgroundElements>
  			<mx:VBox verticalAlign="middle" horizontalAlign="center"
  				visible="{!(mdl.db.dataLoaded.getItemAt(mdl.nav.durationSelected) as Boolean)}">
  				<mx:Label text="Loading..."/>  				
  			</mx:VBox>
  		</mx:backgroundElements>
  		
        <mx:horizontalAxis>
            <mx:DateTimeAxis id="haxis" displayLocalTime="true" 
            	minimum="{mdl.session.timeArray.getItemAt(mdl.nav.durationSelected) as Date}"
            	maximum="{mdl.session.timeArray.getItemAt(Session.LATEST_TICK) as Date}"/>
        </mx:horizontalAxis>
        <mx:verticalAxis>
            <mx:LinearAxis id="vaxis" baseAtZero="true"/>
        </mx:verticalAxis>
        
		<mx:horizontalAxisRenderers>
		    <mx:AxisRenderer axis="{haxis}">
		        <mx:axisStroke>
		            <mx:Stroke color="#999999" weight="1"/>
		        </mx:axisStroke>
		    </mx:AxisRenderer>
		</mx:horizontalAxisRenderers>
		 
		<mx:verticalAxisRenderers>
		    <mx:AxisRenderer axis="{vaxis}">
		        <mx:axisStroke>
		            <mx:Stroke color="#999999" weight="1" />
		        </mx:axisStroke>
		    </mx:AxisRenderer>
		</mx:verticalAxisRenderers>

  </mx:LineChart>
  
  <mx:Legend dataProvider="{myChart}"/>
  
</mx:HBox>
