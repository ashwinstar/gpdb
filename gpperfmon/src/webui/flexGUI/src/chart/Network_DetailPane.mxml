<?xml version="1.0" encoding="utf-8"?>
<mx:VBox xmlns:mx="http://www.adobe.com/2006/mxml" width="100%" height="100%">
  <mx:DataGrid width="100%" height="100%" selectable="false"
	dataProvider="{mdl.system.selectedDataDetails.host}">
    <mx:Script>
        <![CDATA[
		import model.GPPerfMonModelLocator;
			
		[Bindable]
		public var mdl : GPPerfMonModelLocator = GPPerfMonModelLocator.getInstance();

        ]]>
    </mx:Script>

	<mx:columns>
	  <mx:DataGridColumn headerText="Server" dataField="@name" width="250"/>
	  <mx:DataGridColumn headerText="Net Read (MBytes/s)" dataField="net_rb_rate"/>
	  <mx:DataGridColumn headerText="Net Write (MBytes/s)" dataField="net_wb_rate"/>
	  <mx:DataGridColumn headerText="Net Read (pkts/s)" dataField="net_rp_rate"/>	
	  <mx:DataGridColumn headerText="Net Write (pkts/s)" dataField="net_wp_rate"/>			
	</mx:columns>	
  </mx:DataGrid>
</mx:VBox>
	
