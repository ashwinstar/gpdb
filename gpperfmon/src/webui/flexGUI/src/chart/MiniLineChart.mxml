<?xml version="1.0" encoding="utf-8"?>
<mx:LineChart xmlns:mx="http://www.adobe.com/2006/mxml"
	 showDataTips="true" width="100" height="32"
	 paddingLeft="0" paddingRight="0" paddingTop="0" paddingBottom="0"
  	 gutterLeft="1" gutterRight="1" gutterTop="1" gutterBottom="1"
  	 dataProvider="{mdl.system.oneMinAggData}">
  	  
<mx:Script>
    <![CDATA[
      import model.GPPerfMonModelLocator;
      import model.Session;
   	  import model.Resources;
   		 			
  	  [Bindable]
	  public var mdl : GPPerfMonModelLocator = GPPerfMonModelLocator.getInstance();	
    ]]>
</mx:Script>

		<mx:seriesFilters>
           <mx:Array/>
        </mx:seriesFilters>
         		
        <mx:horizontalAxis>
            <mx:DateTimeAxis id="haxis" displayLocalTime="true" 
            	minimum="{mdl.session.timeArray.getItemAt(Session.FIFTEEN_MINS_AGO) as Date}"
            	maximum="{mdl.session.timeArray.getItemAt(Session.LATEST_TICK) as Date}"/>
        </mx:horizontalAxis>
        <mx:verticalAxis>
            <mx:LinearAxis id="vaxis" baseAtZero="true" padding="0"/>
        </mx:verticalAxis>
        
		<mx:horizontalAxisRenderers>
		    <mx:AxisRenderer axis="{haxis}" showLabels="false" showLine="false"
		    	         includeInLayout="false" visible="false"/>
		</mx:horizontalAxisRenderers>
		 
		<mx:verticalAxisRenderers>
		    <mx:AxisRenderer axis="{vaxis}" showLabels="false" showLine="false" 
		    	         includeInLayout="false" visible="false"/>
		</mx:verticalAxisRenderers>

  		<mx:backgroundElements>
  			<mx:VBox verticalAlign="middle" horizontalAlign="center"
  				visible="{mdl.system.oneMinAggData.length == 0}">
  				<mx:Label text="Loading..."/>  				
  			</mx:VBox>
  		</mx:backgroundElements>
	
		<mx:fill>
			<mx:SolidColor color="0xBFDC92" alpha="1.0"/>
		</mx:fill>
		
</mx:LineChart>





