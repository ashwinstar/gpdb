<?xml version="1.0" encoding="utf-8"?>
<mx:VBox xmlns:mx="http://www.adobe.com/2006/mxml" width="100%" height="100%">
  <mx:DataGrid width="100%" height="100%" selectable="false"
	dataProvider="{mdl.system.selectedDataDetails.host}">
    <mx:Script>
        <![CDATA[
		import model.GPPerfMonModelLocator;
			
		[Bindable]
		public var mdl : GPPerfMonModelLocator = GPPerfMonModelLocator.getInstance();

        ]]>
    </mx:Script>

	<mx:columns>
	  <mx:DataGridColumn headerText="Server" dataField="@name" width="250"/>
	  <mx:DataGridColumn headerText="Page in (per/s)" dataField="swap_page_in"/>
	  <mx:DataGridColumn headerText="Page out (per/s)" dataField="swap_page_out"/>
	  <mx:DataGridColumn headerText="Swap total (MBytes)" dataField="swap_total"/>	
	  <mx:DataGridColumn headerText="Swap used (MBytes)" dataField="swap_used"/>			
	</mx:columns>	
  </mx:DataGrid>
</mx:VBox>
