<?xml version="1.0" encoding="utf-8"?>
<mx:VBox xmlns:mx="http://www.adobe.com/2006/mxml" width="100%" height="100%">
  <mx:DataGrid width="100%" height="100%" selectable="false"
	dataProvider="{mdl.system.selectedDataDetails.host}">
    <mx:Script>
        <![CDATA[
		import model.GPPerfMonModelLocator;
			
		[Bindable]
		public var mdl : GPPerfMonModelLocator = GPPerfMonModelLocator.getInstance();

        ]]>
    </mx:Script>

	<mx:columns>
	  <mx:DataGridColumn headerText="Server" dataField="@name" width="250"/>
	  <mx:DataGridColumn headerText="Actual Used (MBytes)" dataField="mem_actual_used"/>
	  <mx:DataGridColumn headerText="Actual Free (MBytes)" dataField="mem_actual_free"/>
	  <mx:DataGridColumn headerText="Used (MBytes)" dataField="mem_used"/>	
	  <mx:DataGridColumn headerText="Total (MBytes)" dataField="mem_total"/>			
	</mx:columns>	
  </mx:DataGrid>
</mx:VBox> 
	
