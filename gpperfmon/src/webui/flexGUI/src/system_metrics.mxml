<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" xmlns:ns1="components.*" width="100%" height="100%" creationComplete="onCreate()" show="onShow()">

	<mx:HTTPService id="getMetrics" url="{mx.core.Application.application.urlPrefix + 'system'}" useProxy="false" method="GET" showBusyCursor="true" fault="faultHandler(event,this.id)" result="getMetricsResultHandler(event)">
		<mx:request xmlns="">
			<sid>{mx.core.Application.application.sid}</sid>
			<start></start>
			<end></end>
		</mx:request>
	</mx:HTTPService>

	<mx:VBox width="100%" height="100%">
		<mx:HBox width="100%">
			<ns1:gpDatePicker id="dateRangeMinPicker" width="200" gpCalAlpha="1" visible="{!mx.core.Application.application.checkboxRealTime.selected}"/>
			<mx:HSlider id="dateRangeSlider" thumbCount="2" snapInterval="3600000" tickInterval="86400000" mouseDown="sliderMouseDown()" mouseUp="sliderMouseUp()" liveDragging="true" change="changeDateRange()" showDataTip="false" width="80%" visible="{!mx.core.Application.application.checkboxRealTime.selected}" />
			<ns1:gpDatePicker id="dateRangeMaxPicker" width="200" gpCalAlpha="1" iconSide="left" visible="{!mx.core.Application.application.checkboxRealTime.selected}"/>
		</mx:HBox>
		<mx:HBox width="100%" height="25%">
			<mx:LineChart id="load" dataProvider="{metricsArray}" left="10" width="100%" height="100%" >
				<mx:horizontalAxis>
					<mx:CategoryAxis categoryField="ctime"/>
				</mx:horizontalAxis>
		        <mx:verticalAxis>
					<mx:LinearAxis baseAtZero="true" minimum="0" maximum="1" title="Load" interval="0.25" />
		        </mx:verticalAxis>
				<mx:series>
					<mx:LineSeries displayName="Load" yField="load0"/>
					<mx:LineSeries displayName="Load" yField="load1"/>
					<mx:LineSeries displayName="Load" yField="load2"/>
				</mx:series>
			</mx:LineChart>
		</mx:HBox>
		<mx:HBox width="100%" height="25%">
			<mx:AreaChart id="cpu" type="stacked" dataProvider="{metricsArray}" left="10" width="100%" height="100%" >
				<mx:horizontalAxis>
					<mx:CategoryAxis categoryField="ctime"/>
				</mx:horizontalAxis>
		        <mx:verticalAxis>
					<mx:LinearAxis baseAtZero="true" minimum="0" maximum="100" title="CPU" interval="25" />
		        </mx:verticalAxis>
				<mx:series>
					<mx:AreaSeries displayName="User" yField="cpu_user"/>
					<mx:AreaSeries displayName="Sys" yField="cpu_sys"/>
					<mx:AreaSeries displayName="Idle" yField="cpu_idle"/>
				</mx:series>
			</mx:AreaChart>
		</mx:HBox>
		<mx:HBox width="100%" height="25%">
			<mx:ColumnChart id="memory" dataProvider="{metricsArray}" left="10" width="100%" height="100%">
				<mx:horizontalAxis>
					<mx:CategoryAxis categoryField="ctime"/>
				</mx:horizontalAxis>
		        <mx:verticalAxis>
					<mx:LinearAxis baseAtZero="true" minimum="0" maximum="100" title="Memory/Swap" interval="25"/>
		        </mx:verticalAxis>
				<mx:series>
					<mx:ColumnSeries displayName="Memory" yField="{normalize('mem_actual_used', 'mem_total')}"/>
					<mx:ColumnSeries displayName="Swap" yField="{normalize('swap_used', 'swap_total')}"/>
				</mx:series>
			</mx:ColumnChart>
		</mx:HBox>
		<mx:HBox width="100%" height="25%">
			<mx:LineChart id="network" dataProvider="{metricsArray}" left="10" width="100%" height="100%">
				<mx:horizontalAxis>
					<mx:CategoryAxis categoryField="ctime"/>
				</mx:horizontalAxis>
		        <mx:verticalAxis>
					<mx:LinearAxis baseAtZero="true" minimum="0" maximum="100" title="Network R/W Rate" interval="25"/>
		        </mx:verticalAxis>
				<mx:series>
					<mx:LineSeries displayName="Network Reads" yField="net_rp_rate"/>
					<mx:LineSeries displayName="Network Writes" yField="net_wp_rate"/>

				</mx:series>
			</mx:LineChart>
		</mx:HBox>
		<mx:HBox width="100%" height="25%">
			<mx:ColumnChart id="disk" dataProvider="{metricsArray}" left="10" width="100%" height="100%">
				<mx:horizontalAxis>
					<mx:CategoryAxis categoryField="ctime"/>
				</mx:horizontalAxis>
		        <mx:verticalAxis>
					<mx:LinearAxis baseAtZero="true" minimum="0" maximum="100" title="Disk R/W" interval="25"/>
		        </mx:verticalAxis>
				<mx:series>
					<mx:ColumnSeries displayName="Read Operations" yField="disk_ro_rate"/>
					<mx:ColumnSeries displayName="Write Operations" yField="disk_wo_rate"/>
				</mx:series>
			</mx:ColumnChart>
		</mx:HBox>
	</mx:VBox>
		
	<mx:Style source="styles.css" />	
	<mx:Script>
	<![CDATA[
		include "include/defines.as";
		include "include/common.as";
		import mx.core.Application
		import flash.events.*;
        import mx.events.*;
        import mx.controls.*;
		import mx.controls.Alert;
        import mx.managers.PopUpManager;
        import mx.collections.ArrayCollection;
          
        private var hostsObject:Object = null;
		
		[Bindable] private var metricsArray:ArrayCollection = new ArrayCollection();

		private function onCreate():void
		{
			dateRangeSlider.maximum = (new Date()).getTime();
			dateRangeSlider.minimum = dateRangeSlider.maximum - (31 * 24 * 60 * 60 * 1000);
			dateRangeSlider.values[1] = dateRangeSlider.maximum;
			dateRangeSlider.values[0] = dateRangeSlider.minimum;
			//dateRangeSlider.values[0] = dateRangeSlider.maximum - (5 * 60 * 1000);
			
			dateRangeMinPicker.gpDateTime = (new Date(dateRangeSlider.values[0])).toLocaleString();
			dateRangeMaxPicker.gpDateTime = (new Date(dateRangeSlider.values[1])).toLocaleString();
		}

		private function onShow():void
		{
			mx.core.Application.application.checkboxRealTime.visible=true;
			mx.core.Application.application.hostname.visible=true;

			dateRangeMinPicker.addEventListener("changeDate", minDateChangeListener);
 			dateRangeMaxPicker.addEventListener("changeDate", maxDateChangeListener);
 			
 			if(mx.core.Application.application.checkboxRealTime.selected)
 			{
 				getMetrics.request.start = "LAST";
				getMetrics.request.end = "";	
 			}
 			
 			getMetrics.send();
		}
		
		public function selectRealtime():void
		{
			if(mx.core.Application.application.checkboxRealTime.selected)
 			{
 				metricsArray = new ArrayCollection();
 				getMetrics.request.start = "LAST";
				getMetrics.request.end = "";
				getMetrics.request.host = mx.core.Application.application.hostname.selectedItem;
 			}
 			else
 			{
 				getMetrics.request.start = formatDateFromEpoch(dateRangeSlider.values[0]);
				getMetrics.request.end = formatDateFromEpoch(dateRangeSlider.values[1]);
				getMetrics.request.host = "";
 			}
 			
 			if(this.visible)
	 			getMetrics.send();
		}
		        
		public function changeDateRange():void
		{
			dateRangeMinPicker.gpDateTime = (new Date(dateRangeSlider.values[0])).toLocaleString();
			dateRangeMaxPicker.gpDateTime = (new Date(dateRangeSlider.values[1])).toLocaleString();
		}

 		private function minDateChangeListener(event:Event):void
		{
			event.stopImmediatePropagation();
			dateRangeSlider.setThumbValueAt(0, dateRangeMinPicker.gpDate.getTime());
		}
 		
 		private function maxDateChangeListener(event:Event):void
		{
			event.stopImmediatePropagation();
			dateRangeSlider.setThumbValueAt(1, dateRangeMaxPicker.gpDate.getTime());
		}

		private var start_date:int;
		private var end_date:int;

		private function sliderMouseDown():void
		{
			start_date = dateRangeSlider.values[0];
			end_date = dateRangeSlider.values[1];
		}
		
		public function sliderMouseUp():void
		{
			if(dateRangeSlider.values[0] == start_date && dateRangeSlider.values[1] == end_date)
				return;

			changeDateRange();
				
			// can't bind directly to these as {dateRange.values[0]} oddly enough
			getMetrics.request.start = formatDateFromEpoch(dateRangeSlider.values[0]);
			getMetrics.request.end = formatDateFromEpoch(dateRangeSlider.values[1]);

			getMetrics.send();
		}
		
		public function selectSystemMetricHost(hostname:String):void
		{
			if(hostsObject == null)
				return;
				
			if(hostname == "All" && hostsObject["All"] == null)
				computeAggregatedData();
			
			metricsArray = hostsObject[hostname];
			if(metricsArray == null)
			{
				Alert.show(hostname + " not found");
				return;
			}
		}
		
		private function computeAggregatedData():void
		{
			// object to store values for each element for the aggregated view
			var allObj:Object = new Object();
			var allSystemMetricsArray:ArrayCollection = new ArrayCollection();
			
			// create an object for each time slice for the aggregated view
			for(var host:String in hostsObject)
			{
				for(var timeSlice:int=0; timeSlice<hostsObject[host].length; timeSlice++)
				{
					allSystemMetricsArray.addItem(new Object());
				}
				
				// iterate throught this loop only once
				break;
			}

			var hostCount:int = 0;
			// iterate through all hosts		
			for(var host:String in hostsObject)
			{
				hostCount++;
				
				// iterate through each time slice
				for(var timeSlice:int=0; timeSlice<hostsObject[host].length; timeSlice++)
				{
					// iterate through each element
					for(var column:String in hostsObject[host][timeSlice])
					{
						if(column == "ctime" || column == "name")
						{
							allSystemMetricsArray[timeSlice][column] = hostsObject[host][timeSlice][column];
						}
						else
						{
							// aggregate values over all hosts per element for each time slice
							if(allSystemMetricsArray[timeSlice][column] == null)
								allSystemMetricsArray[timeSlice][column] = parseFloat(hostsObject[host][timeSlice][column]);
							else
								allSystemMetricsArray[timeSlice][column] += parseFloat(hostsObject[host][timeSlice][column]);
						}
					}
				}
			}

			// compute the average
			for(var timeSlice:int=0; timeSlice<allSystemMetricsArray.length; timeSlice++)
			{
				// iterate through each element
				for(var column:String in allSystemMetricsArray[timeSlice])
				{
					if(column != "ctime" && column != "name")
						allSystemMetricsArray[timeSlice][column] /= hostCount;
				}
			}

			hostsObject['All'] = allSystemMetricsArray;
		}
		
		private function getMetricsResultHandler(event:ResultEvent):void
		{
			if(checkHttpServiceResultsForFailure("getMetricsResultHandler()", event, (event.result.system == null)))
				return;
	
			if(event.result.system.host == null)
			{
				Alert.show("Query returned no results");
				return;
			}

			if(mx.core.Application.application.checkboxRealTime.selected)
			{
				// append new real-time data to existing 			
				metricsArray.addItem(event.result.system.host);
				
				// we submit & update the metrics iff we're visible.
				if(this.visible)
				{
					var sleep:int = 0;
					
					function goToSleep():void
					{
						clearInterval(sleep);
						getMetrics.send();
					}
	
					sleep = setInterval(goToSleep, resubmitDelay * 1000);
				}
				
				return;
			}
			
			hostsObject = new Object();
			// This object stores the aggregated view of the GP DB sytem computed from all nodes
			var allSystemMetricsArray:ArrayCollection = new ArrayCollection();
			
			if(typeof event.result.system.host == "object")
			{
				try
				{
					// Checking to see if host is an array or an object
					if(event.result.system.host.cpu_idle)
					{
						// When host comes in, if there is only one, it comes in as an object
						// not an array.  So we need to convert host to an array for the rest of this
						// function to use.
						// Capture the host information
						var hObj:Object = event.result.system.host;
						// Convert host to an array
						event.result.system.host = new Array();
						// Reload the host array at position 0 with the retrieved host information
						event.result.system.host[0] = hObj;
					}
				} 
				catch(e:Error) {} // throw away error, host is already an array
				
				// iterate through all the hosts
				for(var i:int=0; i<event.result.system.host.length; i++)
				{
					var elementArray:Array = new Array();
					var localSystemMetricsArray:ArrayCollection = new ArrayCollection();
					
					var maxLength:int = 0;
					
					// iterate through all elements in the parent hostname node.
					for (var column:String in event.result.system.host[i])
					{
						// split the '|' delimited XML element into an array of time value
						var valueArray:Array = event.result.system.host[i][column].split('|');
						if (valueArray.length > maxLength)
						{
							maxLength = valueArray.length;
						}
						
						elementArray[column] = valueArray;
					}
			
					// create object to store all elements for a single slice in time.
					// iterate through each slice of time interval
					for (var j:int=0; j<maxLength; j++)
					{
						// object to store system metrics for a single slice in time
						var obj:Object = new Object();
						// iterate through each element in a host node
						for (var column:String in event.result.system.host[i])
						{
							obj[column] = elementArray[column][j];					
						}
						localSystemMetricsArray.addItem(obj);
					}
					
					// store system metrics for host in an array of hostnames
					hostsObject[event.result.system.host[i].name] = localSystemMetricsArray;
				}		
			}
			else
			{
				Alert.show("type came back " + typeof(event.result.system.host));
			}
			
			selectSystemMetricHost(mx.core.Application.application.hostname.selectedItem);
		}
	 ]]>
	 </mx:Script>
</mx:Canvas>
