def lighty_version():
    ver_string = 'Unknown'
    try:
        FILE = os.popen('lighttpd -v')
        if FILE:
            ver_string = FILE.readline().split(' ')[0]
            FILE.close()
    except:
        pass
    return ver_string


#################
def lighty_start():
    res = 0
    if lighty_status() == 0:
        if avail_cmds['lighttpd']:
            start_application('lighttpd -f ' + LIGHTY_CONF_FILE)
        else:
            print 'lighttpd not found in PATH.  Please configure your PATH correctly and try again.'
            return STOPPED
        time.sleep(1)
    return lighty_status()


#################
def lighty_stop():
    if lighty_status() == 1:
        if avail_cmds['lighttpd']:
            try:
                FILE = open(LIGHTY_PID_FILE, 'r')
                pid = FILE.readline()
                FILE.close()
                os.kill(int(pid), signal.SIGTERM)
                time.sleep(1)
            except:
                return lighty_status()
        else:
            print 'lighttd-angel not found in PATH.  Please configure your PATH correctly and try again.'
    return lighty_status()

#################
def lighty_restart():
    lighty_stop()
    lighty_start()


#################
def lighty_status():
    running = STOPPED
    try:
        FILE = open(LIGHTY_PID_FILE, 'r')
        pid = FILE.readline()
        FILE.close()
        FILE = os.popen('ps -p %s 2>/dev/null' % pid)
        FILE.readline()
        status = FILE.readline()
        FILE.close()
        if status.find('lighttpd') != -1:
            running = RUNNING
    except:
        pass

    return running


