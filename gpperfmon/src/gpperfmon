#!/usr/bin/env python

'''
Start, stops, interogates or configures the GPPerfMon system.

Usage: gpperfmon -D <MASTER DATA DIRECTORY> --start|--stop|--restart|--status|--setup [--noweb]

\t-D <MASTER_DATA_DIRECTORY>  - master data directory of instance to monitor

\t--start    - start the gpperfmon system
\t--stop     - stop the gpperfmon system
\t--restart  - restart the gpperfmon system
\t--status   - check the status of the gpperfmon system
\t--setup    - configure the gpperfmon system
\t--version  - display gpperfmon version

\t--noweb    do not control or setup the gpperfmon web server 

'''

import os, sys, getopt, signal, time, socket, ConfigParser

script_name = os.path.split(__file__)[-1]
script_version = '2.0.0'

# valid options
valid_opts = "?D:"
valid_lopts = ["restart", "start", "stop", "status", "setup", "noweb", "version"]

# consts
STOPPED = 0
RUNNING = 1

# options
opt = {}

avail_cmds = {}

GPPERFMON_CONF_FILE = ''
LIGHTY_CONF_FILE = ''
GPMMON_PID_FILE = ''
LIGHTY_PID_FILE = ''
WEBAPI_DOCROOT = ''
GPPERFMONHOME = ''
GPHOME = ''

#################
def usage(exitarg, errmsg=''):
    if not errmsg == '':
        print "Error: %s" % errmsg
    print __doc__
    sys.exit(exitarg)


#################
def version():
    print '%s version %s' % (script_name, script_version)
    print 'lighttpd version: %s' % lighty_version()
    print 'gpmmon version: %s' % gpmmon_version()
    print 'gpsmon version: %s' % gpsmon_version()


#################
def parse_command_line():
    global opt
    try:
        (options, args) = getopt.getopt(sys.argv[1:], valid_opts, valid_lopts)
    except getopt.GetoptError, err:
        print str(err)
        usage(0)

    for (switch, val) in options:
        if switch == '-?':               
            usage(0)
        elif switch == '--version':
            version()
            sys.exit(0)
        elif switch == '-D':             
            opt['MASTER_DATA_DIRECTORY'] = val
        elif switch == '--noweb':
            opt['noweb'] = True
        elif switch == '--start' or '--stop' or '--restart' or '--status' or '--setup':
            if not opt.has_key('ACTION'):
                    opt['ACTION'] = switch[2:]
            else:
                    usage(1, 'The action \'%s\' was already specified' % opt['ACTION'])


#################
def validate_options():
    global opt, GPPERFMON_CONF_FILE, GPMMON_PID_FILE, LIGHTY_CONF_FILE, LIGHTY_PID_FILE, WEBAPI_DOCROOT

    if not opt.has_key('MASTER_DATA_DIRECTORY'):
        opt['MASTER_DATA_DIRECTORY'] = os.getenv('MASTER_DATA_DIRECTORY')
        if opt['MASTER_DATA_DIRECTORY'] == None:
            print "Error: MASTER_DATA_DIRECTORY not defined and -D option not specified"
            usage(1)

    # check that we have an action
    if not opt.has_key('ACTION'):
        usage(1, 'Missing action.')

    GPPERFMON_CONF_FILE = opt['MASTER_DATA_DIRECTORY'] + '/gpperfmon/conf/gpperfmon.conf'
    GPMMON_PID_FILE = opt['MASTER_DATA_DIRECTORY'] + '/gpperfmon/gpmmon.pid'
    LIGHTY_CONF_FILE = opt['MASTER_DATA_DIRECTORY'] + '/gpperfmon/conf/lighttpd.conf'
    LIGHTY_PID_FILE = opt['MASTER_DATA_DIRECTORY'] + '/gpperfmon/lighttpd.pid'
    WEBAPI_DOCROOT = opt['MASTER_DATA_DIRECTORY'] + '/gpperfmon/web/'


#################
def check_env():
    global GPPERFMONHOME, GPHOME
    GPPERFMONHOME = os.getenv('GPPERFMONHOME')
    GPHOME = os.getenv('GPHOME')
    if GPPERFMONHOME == None:
        usage(1, 'GPPERFMONHOME environment variable not set')
    if GPHOME == None:
        usage(1, 'GPHOME environment variable not set')

#################
def check_commands():
    avail_cmds['gpmmon'] = command_in_path('gpmmon')
    avail_cmds['openssl'] = command_in_path('openssl') 
    avail_cmds['lighttpd'] = command_in_path('lighttpd')
    avail_cmds['psql'] = command_in_path('psql')


#################
def gpperfmon_start():
    if not opt.has_key('noweb'):
        print 'Starting web server...'
        ret = lighty_start()
        if ret == STOPPED:
            print 'Failed to start web server.'
        else:
            print 'Web server started.'

    print 'Starting gpmmon...'
    ret = gpmmon_start()
    if ret == STOPPED:
        print 'Failed to start gpmmon.'
    else:
        print 'gpmmon server started.'


#################
def gpperfmon_stop():
    if not opt.has_key('noweb'):
        print 'Stopping web server...'
        ret = lighty_stop()
        if ret == RUNNING:
            print 'Failed to stop web server.'
        else:
            print 'Web server stopped.'

    print 'Stopping gpmmon...'
    ret = gpmmon_stop()
    if ret == RUNNING:
        print 'Failed to stop gpmmon.'
    else:
        print 'gpmmon stopped.'


#################
def gpperfmon_restart():
    if not opt.has_key('noweb'):
        print 'Restarting web server...'
        lighty_restart()
        print 'Done.'

    print 'Restarting gpmmon...'
    gpmmon_restart()
    print 'Done'


#################
def gpperfmon_status():
    if lighty_status() == 1:
        print 'gpperfmon Web API [Running]'
    else:
        print 'gpperfmon Web API [Stopped]'

    if gpmmon_status() == 1:
        print 'gpmmon [Running]'
    else:
        print 'gpmmon [Stopped]'


#################
def get_int(msg, default, min, max = 0):
    val = None
    while val == None:
        val = raw_input('%s:' % msg)
        if not val: 
            val = default
        else:
            try:
                val = int(val)
            except:
                print "Invalid value"
                val = None
                continue
        if val < min:
            print 'Value must be greater than or equal to %d' % min
            val = None
            continue
        elif max != 0 and val > max:
            print 'Value must be less than or equal to %d' % max
            val = None
            continue

    return val


#################
def get_string(msg, default):
    val = None
    val = raw_input('%s:' % msg)
    if not val:
        val = default
    return val


#################
def get_yesno(msg, default):
    val = None
    while val == None:
        val = raw_input('%s:' % msg)
        if not val:
            val = default
        else:
            if val.upper().rstrip() in ('Y', 'YES'):
                val = 'Y'
            elif val.upper().rstrip() in ('N', 'YES'):
                val = 'N'
            else:
                print 'Invalid input'
                val = None

    return val


