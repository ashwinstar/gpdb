def gpperfmon_setup():
    # gpmmon defaults
    quantum_default=15
    minqt_default=60
    mindqt_default=60
    verbose_default=0
    logloc_default=opt['MASTER_DATA_DIRECTORY'] + '/gpperfmon/logs'

    # defaults for webapi
    max_datapoints_default = 600
    load2_threshold_default = 2.00
    cpu_threshold_default = 80
    memory_threshold_default = 80
    cpu_skew_threshold_default = 100

    config = ConfigParser.ConfigParser()
    config.add_section('GPMMON')
    config.add_section('WS')
    config.add_section('SYSTEM METRICS')
    config.add_section('QUERY METRICS')
    config.set('GPMMON', 'quantum', quantum_default)
    config.set('GPMMON', 'min_query_time', minqt_default)
    config.set('GPMMON', 'min_detailed_query_time', mindqt_default)
    config.set('GPMMON', 'verbose', verbose_default)
    config.set('GPMMON', 'log_location', logloc_default)
    config.set('WS', 'max_data_points', max_datapoints_default)
    config.set('SYSTEM METRICS', 'load2_threshold', load2_threshold_default)
    config.set('SYSTEM METRICS', 'cpu_threshold', cpu_threshold_default)
    config.set('SYSTEM METRICS', 'memory_threshold', memory_threshold_default)
    config.set('QUERY METRICS', 'cpu_skew_threshold', cpu_skew_threshold_default) 

    if os.path.isfile(GPPERFMON_CONF_FILE):
        yn = get_yesno('gpperfmon.conf already exists for this database instance.\nDo you want to reconfigure gpperfmon? [N]', 'N')
        if yn == 'N':
            sys.exit(0)
        # Read in the existing file
        try:
            print 'Reading in existing configuration file'
            config.read(GPPERFMON_CONF_FILE)
            quantum_default = config.getint('GPMMON', 'quantum')
            minqt_default = config.getint('GPMMON', 'min_query_time')
            mindqt_default = config.getint('GPMMON', 'min_detailed_query_time')
            logloc_default = config.get('GPMMON', 'log_location')
            print 'Done'
        except:
            # invalid conf file
            pass

    # check that master data directory is correct...
    if not os.path.isfile(opt['MASTER_DATA_DIRECTORY'] + '/pg_hba.conf'):
        usage('Failed to find pg_hba.conf file in ' + opt['MASTER_DATA_DIRECTORY'])

    try:
        os.mkdir(opt['MASTER_DATA_DIRECTORY'] + '/gpperfmon/')
    except OSError:
        pass #dir exists
    try:
        os.mkdir(opt['MASTER_DATA_DIRECTORY'] + '/gpperfmon/conf')
    except OSError:
        pass #dir exists

    try:
        os.mkdir(opt['MASTER_DATA_DIRECTORY'] + '/gpperfmon/web')
    except OSError:
        pass #dir exists

    try:
        if os.path.islink(opt['MASTER_DATA_DIRECTORY'] + '/gpperfmon/web/lib'):
            os.unlink(opt['MASTER_DATA_DIRECTORY'] + '/gpperfmon/web/lib')
        os.symlink(GPPERFMONHOME + '/www/lib', opt['MASTER_DATA_DIRECTORY'] + '/gpperfmon/web/lib')
    except OSError, detail:
        print 'Error linking www/lib directory: %s' % detail
        sys.exit(1)

    try:
        if os.path.islink(opt['MASTER_DATA_DIRECTORY'] + '/gpperfmon/web/static'):
            os.unlink(opt['MASTER_DATA_DIRECTORY'] + '/gpperfmon/web/static')
        os.symlink(GPPERFMONHOME + '/www/static', opt['MASTER_DATA_DIRECTORY'] + '/gpperfmon/web/static')
    except OSError, detail:
        print 'Error linking www/static directory: %s' % detail
        sys.exit(1)

    try:
        if os.path.islink(opt['MASTER_DATA_DIRECTORY'] + '/gpperfmon/web/templates'):
            os.unlink(opt['MASTER_DATA_DIRECTORY'] + '/gpperfmon/web/templates')
        os.symlink(GPPERFMONHOME + '/www/templates', opt['MASTER_DATA_DIRECTORY'] + '/gpperfmon/web/templates')
    except OSError, detail:
        print 'Error linking www/templates directory: %s' % detail
        sys.exit(1)

    try:
        if os.path.islink(opt['MASTER_DATA_DIRECTORY'] + '/gpperfmon/web/gpmonws.py'):
            os.unlink(opt['MASTER_DATA_DIRECTORY'] + '/gpperfmon/web/gpmonws.py')
        os.symlink(GPPERFMONHOME + '/www/gpmonws.py', opt['MASTER_DATA_DIRECTORY'] + '/gpperfmon/web/gpmonws.py')
    except OSError, detail:
        print 'Error linking www/gpmonws.py: %s' % detail
        sys.exit(1)

    try:
        if os.path.islink(GPHOME + '/bin/lib/gpmon_catqrynow.py'):
            os.unlink(GPHOME + '/bin/lib/gpmon_catqrynow.py')
        os.symlink(GPPERFMONHOME + '/lib/gpmon_catqrynow.py', GPHOME + '/bin/lib/gpmon_catqrynow.py')
    except OSError, detail:
        print 'Error linking gpmon_catqrynow.py: %s' % detail
        sys.exit(1)

    # gpmmon configuration
    print '---------------------'
    print 'Monitor Configuration'
    print '---------------------'
    print '\nThe Greenplum Performance Monitor requires a database within the Greenplum'
    print 'instance it is monitoring.  This configuration can create this database for'
    print 'you now.  If you choose to create this database now, it will replace any'
    print 'existing gpperfmon database, causing loss of any monitoring data previously' 
    print 'collected and stored in that database.'
    create_db = get_yesno('Do you want to create the gpperfmon database [N]', 'N')
    if create_db == 'Y':
        create_db = get_yesno('Are you sure?  All previous monitoring data for this instance will be lost. [Y]', 'Y')
        if create_db == 'Y':
            if os.system('psql -d template1 -f %s' % (GPPERFMONHOME + '/gpperfmon.sql')) != 0:
                print 'There was an error creating the database.  Configuration cannot continue at this time.'
                sys.exit(1)
            print 'The gpperfmon database was created successfully.' 


    print '\nThe quantum value specifies the time in seconds between updates from'
    print 'performance monitor agents on all segments.'
    quantum = get_int('Quantum (between 10 and 120 seconds). [%d]' % (quantum_default), quantum_default, 10, 120)
    config.set('GPMMON', 'quantum', quantum)

    print '\nThe minimum query run time specifies the cutoff time for queries to log.'
    print 'Only queries with a run time greater than this value will be logged in '
    print 'the queries_history table.'
    minqt = get_int('Minimum query run time (seconds) [%d]' % (minqt_default), minqt_default, 0) 
    config.set('GPMMON', 'min_query_time', minqt)

    print '\nThe minimum detailed query run time specifies the cutoff time for queries'
    print 'to log detailed iterator metrics.  Only queries with a run time greater'
    print 'than this value will have their detailed metrics logged in the'
    print 'iterators_history table.'    
    mindqt = get_int('Minimum detailed query run time (seconds) [%d]' % (minqt), minqt, minqt)
    config.set('GPMMON', 'min_detailed_query_time', mindqt)

    logloc = get_string('\nLog file location [%s]' % (logloc_default), logloc_default)
    config.set('GPMMON', 'log_location', logloc)

    try:
        os.mkdir(logloc)
    except OSError:
        pass #dir exists

    # Web Server configuration
    enable_ssl = 'disable'
    lighty_port = 8080
    if not opt.has_key('noweb'):
        print '------------------------'
        print 'Web Server Configuration'
        print '------------------------'
    
        #lighty conf
        lighty_access_log = logloc + '/lighttpd-access.log'
        lighty_error_log = logloc + '/lighttpd-error.log'

        print '\ngpperfmon runs a small web server for the UI and web API.  This web'
        print 'server by default runs on port 8080, but you may specify any available port.'
        lighty_port = get_int('Web server port [28080]', 28080, 1, 65534)
    
        ssl_cert = ''

        if avail_cmds['openssl']:
            yn = get_yesno('\nDo you want to enable SSL for the Web API (Y/N) [Y]', 'Y')
            if yn == 'Y':
                ret = generate_cert(opt['MASTER_DATA_DIRECTORY'] + '/gpperfmon/conf/cert.pem')
                if ret:
                    enable_ssl = 'enable'
                    ssl_cert = opt['MASTER_DATA_DIRECTORY'] + '/gpperfmon/conf/cert.pem'
                else:
                    print 'Failed to generate SSL cert.  SSL will be disabled.'
        else:
            print 'openssl not found.  If you want to enable SSL, make sure openssl is in your'
            print 'path and rerun gpperfmon.py --setup'

        lighty_conf = generate_lighty_conf(WEBAPI_DOCROOT, lighty_error_log, 
                                           lighty_access_log, lighty_port, WEBAPI_DOCROOT + '/gpmonws.py', 
                                           enable_ssl, ssl_cert)

        try:
            FILE = open(LIGHTY_CONF_FILE, 'w')
            FILE.writelines(lighty_conf)
            FILE.close()
            print '\nDone writing lighttpd configuration to %s' % LIGHTY_CONF_FILE
        except (errno, errstr):
            print 'Error: Failed to write lighttpd configuration file to %s' % LIGHTY_CONF_FILE
            print errstr
            sys.exit(1)

    try:
        FILE = open(GPPERFMON_CONF_FILE, 'w')
        config.write(FILE)
        FILE.close()
        print 'Done writing gpperfmon configuration to %s' % GPPERFMON_CONF_FILE
    except (errno, errstr):
        print 'Error: Failed to write gpperfmon configuration to %s' % GPPERFMON_CONF_FILE
        print errstr
        sys.exit(1)

    webui_url = ''
    if enable_ssl == 'enable':
        webui_url = 'https://'
    else:
        webui_url = 'http://'
    webui_url = webui_url + socket.gethostname() + ':' + str(lighty_port) + '/'
    print '\nGreenplum Performance Monitor configuration is now complete.  If'
    print 'at a later date you want to change certain parameters, you can '
    print 'either re-run \'gpperfmon --setup\' or edit the configuration file'
    print 'located at ' + GPPERFMON_CONF_FILE + '.'
    print '\nYou can start monitoring this Greenplum Database instance by running'
    print '\'gpperfmon --start\'.'
    if not opt.has_key('noweb'):
        print 'The web based UI is available at %s' % webui_url

