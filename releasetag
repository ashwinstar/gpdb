#!/bin/sh

ECHOCMD=echo
# make certain we get the desired echo on Solaris
if [ `uname` = 'SunOS' ]; then
  ECHOCMD=/usr/ucb/echo
fi

TMP=`$ECHOCMD '$Name:  $' | awk 'BEGIN {FS = ":"} {print $2}' | awk '{print $1}'`
$ECHOCMD -n '-'
if [ x"$TMP" != x"$" ]; then
  $ECHOCMD -n $TMP
else
  $ECHOCMD -n devel
fi

